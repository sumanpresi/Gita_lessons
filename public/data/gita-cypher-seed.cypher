// GitaViswa (गीताविश्व) — Neo4j seed · generated 2026-10-29T16:53:19.046Z
// 857 nodes, 5350 relationships. Run in Neo4j Browser or: cypher-shell -f gita-cypher-seed.cypher

CREATE CONSTRAINT chapter_id IF NOT EXISTS FOR (n:Chapter) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT verse_id IF NOT EXISTS FOR (n:Verse) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT character_id IF NOT EXISTS FOR (n:Character) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT sanskritconcept_id IF NOT EXISTS FOR (n:SanskritConcept) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT emotion_id IF NOT EXISTS FOR (n:Emotion) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT lifedilemma_id IF NOT EXISTS FOR (n:LifeDilemma) REQUIRE n.id IS UNIQUE;

UNWIND [
  {id: "CH_1", label: "Chapter 1", number: 1, name: "अर्जुनविषादयोग", iast: "arjunaviṣādayoga", title: "Arjuna Visada Yoga", meaning: "Arjuna's Dilemma", verseCount: 47, summary: "The first chapter of the Bhagavad Gita - \"Arjuna Vishada Yoga\" introduces the setup, the setting, the characters and the circumstances that led to the epic battle of Mahabharata, fought between the Pandavas and the Kauravas. It outlines the reasons that led to the revelation of the of Bhagavad Gita."},
  {id: "CH_2", label: "Chapter 2", number: 2, name: "सांख्ययोग", iast: "sāṃkhyayoga", title: "Sankhya Yoga", meaning: "Transcendental Knowledge", verseCount: 72, summary: "The second chapter of the Bhagavad Gita is \"Sankhya Yoga\". This is the most important chapter of the Bhagavad Gita as Lord Krishna condenses the teachings of the entire Gita in this chapter. This chapter is the essence of the entire Gita. "},
  {id: "CH_3", label: "Chapter 3", number: 3, name: "कर्मयोग", iast: "karmayoga", title: "Karma Yoga", meaning: "Path of Selfless Service", verseCount: 43, summary: "The third chapter of the Bhagavad Gita is \"Karma Yoga\" or the \"Path of Selfless Service\". Here Lord Krishna emphasizes the importance of karma in life. He reveals that it is important for every human being to engage in some sort of activity in this material world. Further, he describes the kinds of actions that lead to bondage and the kinds that lead to liberation. Those persons who continue to perform their respecti"},
  {id: "CH_4", label: "Chapter 4", number: 4, name: "ज्ञानकर्मसंन्यासयोग", iast: "jñānakarmasaṃnyāsayoga", title: "Jnana Karma Sanyasa Yoga", meaning: "Path of Knowledge and the Disciplines of Action", verseCount: 42, summary: "The fourth chapter of the Bhagavad Gita is \"Jnana Karma Sanyasa Yoga\". In this chapter, Krishna glorifies the Karma Yoga and imparts the Transcendental Knowledge (the knowledge of the soul and the Ultimate Truth) to Arjuna. He reveals the reason behind his appearance in this material world. He reveals that even though he is eternal, he reincarnates time after time to re-establish dharma and peace on this Earth. His b"},
  {id: "CH_5", label: "Chapter 5", number: 5, name: "कर्मसंन्यासयोग", iast: "karmasaṃnyāsayoga", title: "Karma Sanyasa Yoga", meaning: "Path of Renunciation", verseCount: 29, summary: "The fifth chapter of the Bhagavad Gita is \"Karma Sanyasa Yoga\". In this chapter, Krishna compares the paths of renunciation in actions (Karma Sanyas) and actions with detachment (Karma Yoga) and explains that both are means to reach the same goal and we can choose either. A wise person should perform his/her worldly duties without attachment to the fruits of his/her actions and dedicate them to God. This way they rem"},
  {id: "CH_6", label: "Chapter 6", number: 6, name: "ध्यानयोग", iast: "dhyānayoga", title: "Dhyana Yoga", meaning: "Path of Meditation", verseCount: 47, summary: "The sixth chapter of the Bhagavad Gita is \"Dhyana Yoga\". In this chapter, Krishna reveals the \"Yoga of Meditation\" and how to practise this Yoga. He discusses the role of action in preparing for Meditation, how performing duties in devotion purifies one's mind and heightens one's spiritual consciousness. He explains in detail the obstacles that one faces when trying to control their mind and the exact methods by whic"},
  {id: "CH_7", label: "Chapter 7", number: 7, name: "ज्ञानविज्ञानयोग", iast: "jñānavijñānayoga", title: "Gyaan Vigyana Yoga", meaning: "Self-Knowledge and Enlightenment", verseCount: 30, summary: "The seventh chapter of the Bhagavad Gita is \"Gyaan Vigyana Yoga \". In this chapter, Krishna reveals that he is the Supreme Truth, the principal cause and the sustaining force of everything. He reveals his illusionary energy in this material world called Maya, which is very difficult to overcome but those who surrender their minds unto Him attain Him easily. He also describes the four types of people who surrender to "},
  {id: "CH_8", label: "Chapter 8", number: 8, name: "अक्षरब्रह्मयोग", iast: "akṣarabrahmayoga", title: "Akshara Brahma Yoga", meaning: "Path of the Eternal God", verseCount: 28, summary: "The eighth chapter of the Bhagavad Gita is \"Akshara Brahma Yoga\". In this chapter, Krishna reveals the importance of the last thought before death. If we can remember Krishna at the time of death, we will certainly attain him. Thus, it is very important to be in constant awareness of the Lord at all times, thinking of Him and chanting His names at all times. By perfectly absorbing their mind in Him through constant d"},
  {id: "CH_9", label: "Chapter 9", number: 9, name: "राजविद्याराजगुह्ययोग", iast: "rājavidyārājaguhyayoga", title: "Raja Vidya Yoga", meaning: "Yoga through the King of Sciences", verseCount: 34, summary: "The ninth chapter of the Bhagavad Gita is \"Raja Vidya Yoga\". In this chapter, Krishna explains that He is Supreme and how this material existence is created, maintained and destroyed by His Yogmaya and all beings come and go under his supervision. He reveals the Role and the Importance of Bhakti (transcendental devotional service) towards our Spiritual Awakening. In such devotion, one must live for the God, offer eve"},
  {id: "CH_10", label: "Chapter 10", number: 10, name: "विभूतियोग", iast: "vibhūtiyoga", title: "Vibhooti Yoga", meaning: "Yoga through Appreciating the Infinite Opulences of God", verseCount: 42, summary: "The tenth chapter of the Bhagavad Gita is \"Vibhooti Yoga\". In this chapter, Krishna reveals Himself as the cause of all causes. He describes His various manifestations and opulences in order to increase Arjuna's Bhakti. Arjuna is fully convinced of Lord's paramount position and proclaims him to be the Supreme Personality. He prays to Krishna to describe more of His divine glories which are like nectar to hear."},
  {id: "CH_11", label: "Chapter 11", number: 11, name: "विश्वरूपदर्शनयोग", iast: "viśvarūpadarśanayoga", title: "Vishwaroopa Darshana Yoga", meaning: "Yoga through Beholding the Cosmic Form of God", verseCount: 55, summary: "The eleventh chapter of the Bhagavad Gita is \"Vishwaroopa Darshana Yoga\". In this chapter, Arjuna requests Krishna to reveal His Universal Cosmic Form that encompasses all the universes, the entire existence. Arjuna is granted divine vision to be able to see the entirety of creation in the body of the Supreme Lord Krishna."},
  {id: "CH_12", label: "Chapter 12", number: 12, name: "भक्तियोग", iast: "bhaktiyoga", title: "Bhakti Yoga", meaning: "The Yoga of Devotion", verseCount: 20, summary: "The twelfth chapter of the Bhagavad Gita is \"Bhakti Yoga\". In this chapter, Krishna emphasizes the superiority of Bhakti Yoga (the path of devotion) over all other types of spiritual disciplines and reveals various aspects of devotion. He further explains that the devotees who perform pure devotional service to Him, with their consciousness, merged in Him and all their actions dedicated to Him, are quickly liberated "},
  {id: "CH_13", label: "Chapter 13", number: 13, name: "क्षेत्र-क्षेत्रज्ञविभागयोग", iast: "kṣetra-kṣetrajñavibhāgayoga", title: "Ksetra Ksetrajna Vibhaaga Yoga", meaning: "Yoga through Distinguishing the Field and the Knower of the Field", verseCount: 35, summary: "The thirteenth chapter of the Bhagavad Gita is \"Ksetra Ksetrajna Vibhaaga Yoga\". The word \"kshetra\" means \"the field\", and the \"kshetrajna\" means \"the knower of the field\". We can think of our material body as the field and our immortal soul as the knower of the field. In this chapter, Krishna discriminates between the physical body and the immortal soul. He explains that the physical body is temporary and perishable"},
  {id: "CH_14", label: "Chapter 14", number: 14, name: "गुणत्रयविभागयोग", iast: "guṇatrayavibhāgayoga", title: "Gunatraya Vibhaga Yoga", meaning: "Yoga through Understanding the Three Modes of Material Nature", verseCount: 27, summary: "The fourteenth chapter of the Bhagavad Gita is \"Gunatraya Vibhaga Yoga\". In this chapter, Krishna reveals the three gunas (modes) of the material nature - goodness, passion and ignorance which everything in the material existence is influenced by. He further explains the essential characteristics of each of these modes, their cause and how they influence a living entity affected by them. He then reveals the various c"},
  {id: "CH_15", label: "Chapter 15", number: 15, name: "पुरुषोत्तमयोग", iast: "puruṣottamayoga", title: "Purushottama Yoga", meaning: "The Yoga of the Supreme Divine Personality", verseCount: 20, summary: "The fifteenth chapter of the Bhagavad Gita is \"Purushottama Yoga\". In Sanskrit, Purusha means the \"All-pervading God\", and Purushottam means the timeless & transcendental aspect of God.        Krishna reveals that the purpose of this Transcendental knowledge of the God is to detach ourselves from the bondage of the material world and to understand Krishna as the Supreme Divine Personality, who is the eternal controll"},
  {id: "CH_16", label: "Chapter 16", number: 16, name: "दैवासुरसम्पद्विभागयोग", iast: "daivāsurasampadvibhāgayoga", title: "Daivasura Sampad Vibhaga Yoga", meaning: "Yoga through Discerning the Divine and Demoniac Natures", verseCount: 24, summary: "The sixteenth chapter of the Bhagavad Gita is \"Daivasura Sampad Vibhaga Yoga\". In this chapter, Krishna describes explicitly the two kinds of natures among human beings - divine and demoniac. Those who possess demonaic qualities associate themselves with the modes of passion and ignorance do not follow the regulations of the scriptures and embrace materialistic views. These people attain lower births and further mate"},
  {id: "CH_17", label: "Chapter 17", number: 17, name: "श्रद्धात्रयविभागयोग", iast: "śraddhātrayavibhāgayoga", title: "Sraddhatraya Vibhaga Yoga", meaning: "Yoga through Discerning the Three Divisions of Faith", verseCount: 28, summary: "The seventeenth chapter of the Bhagavad Gita is \"Sraddhatraya Vibhaga Yoga\". In this chapter, Krishna describes the three types of faith corresponding to the three modes of the material nature. Lord Krishna further reveals that it is the nature of faith that determines the quality of life and the character of living entities. Those who have faith in passion and ignorance perform actions that yield temporary, material"},
  {id: "CH_18", label: "Chapter 18", number: 18, name: "मोक्षसंन्यासयोग", iast: "mokṣasaṃnyāsayoga", title: "Moksha Sanyaas Yoga", meaning: "Yoga through the Perfection of Renunciation and Surrender", verseCount: 78, summary: "The eighteenth chapter of the Bhagavad Gita is \"Moksha Sanyas Yoga\". Arjuna requests the Lord to explain the difference between the two types of renunciations - sanyaas(renunciation of actions) and tyaag(renunciation of desires). Krishna explains that a sanyaasi is one who abandons family and society in order to practise spiritual discipline whereas a tyaagi is one who performs their duties without attachment to the "}
] AS row
MERGE (n:Chapter {id: row.id}) SET n += row;

UNWIND [
  {id: "character:krishna", label: "Sri Krishna", sa: "श्रीकृष्ण", iast: "śrīkṛṣṇa", role: "The Divine Teacher, charioteer of Arjuna", desc: "Speaker of the Gita — 'Śrī Bhagavān' — revealed as the Supreme Person (15.18) and as the cosmic form (Ch. 11).", side: "pandava", versesSpoken: 574},
  {id: "character:arjuna", label: "Arjuna", sa: "अर्जुन", iast: "arjuna", role: "The Seeker, Pandava warrior-prince", desc: "Third Pandava, the archer of the Gāṇḍīva. His collapse (Ch. 1) and questions frame the whole dialogue; his last words are 'my delusion is gone' (18.73).", side: "pandava", versesSpoken: 86},
  {id: "character:sanjaya", label: "Sanjaya", sa: "सञ्जय", iast: "sañjaya", role: "The Narrator, seer by Vyasa's grace", desc: "Dhritarashtra's charioteer, granted divine sight by Vyasa to narrate the battle; he closes the Gita in rapture (18.74–78).", side: "neutral", versesSpoken: 31},
  {id: "character:dhritarashtra", label: "Dhritarashtra", sa: "धृतराष्ट्र", iast: "dhṛtarāṣṭra", role: "The Blind King", desc: "The blind Kuru king whose single question — 'what did my sons and the sons of Pandu do?' (1.1) — opens the Gita.", side: "kaurava", versesSpoken: 1},
  {id: "character:duryodhana", label: "Duryodhana", sa: "दुर्योधन", iast: "duryodhana", role: "Kaurava crown prince", desc: "Eldest son of Dhritarashtra. Surveying the armies, he addresses Drona with anxious bravado (1.3–11).", side: "kaurava", versesSpoken: 9},
  {id: "character:bhishma", label: "Bhishma", sa: "भीष्म", iast: "bhīṣma", role: "Grandsire, Kaurava commander", desc: "The grand old man of the Kurus, bound by his vow; his lion-roar and conch begin the battle (1.12).", side: "kaurava", versesSpoken: 0},
  {id: "character:drona", label: "Dronacharya", sa: "द्रोण", iast: "droṇa", role: "Preceptor of both armies", desc: "Arjuna's own teacher in arms, now on the opposing side — whom Arjuna asks how he can strike (2.4).", side: "kaurava", versesSpoken: 0},
  {id: "character:karna", label: "Karna", sa: "कर्ण", iast: "karṇa", role: "Kaurava champion, son of the charioteer", desc: "The great archer, unknowingly Arjuna's elder brother; seen entering the cosmic mouths in 11.26.", side: "kaurava", versesSpoken: 0},
  {id: "character:bhima", label: "Bhima", sa: "भीम", iast: "bhīma", role: "Second Pandava", desc: "The mighty Vṛkodara, who blows the great conch Pauṇḍra (1.15).", side: "pandava", versesSpoken: 0},
  {id: "character:yudhishthira", label: "Yudhishthira", sa: "युधिष्ठिर", iast: "yudhiṣṭhira", role: "Eldest Pandava, the Dharma-king", desc: "Son of Kunti, who blows the conch Anantavijaya (1.16).", side: "pandava", versesSpoken: 0},
  {id: "character:vyasa", label: "Ved Vyasa", sa: "व्यास", iast: "vyāsa", role: "Composer of the Mahabharata", desc: "The sage-poet by whose grace Sanjaya heard this supreme yoga (18.75); Krishna names himself 'Vyāsa among sages' (10.37).", side: "neutral", versesSpoken: 0},
  {id: "character:vivasvan", label: "Vivasvan (Sun)", sa: "विवस्वान्", iast: "vivasvān", role: "First recipient of the yoga", desc: "'I taught this imperishable yoga to Vivasvān; Vivasvān told it to Manu; Manu to Ikṣvāku' (4.1) — the lineage of the teaching.", side: "lineage", versesSpoken: 0},
  {id: "character:manu", label: "Manu", sa: "मनु", iast: "manu", role: "Progenitor of humankind", desc: "Second link in the lineage of the yoga (4.1); the Manus are born of Krishna's mind (10.6).", side: "lineage", versesSpoken: 0},
  {id: "character:ikshvaku", label: "Ikshvaku", sa: "इक्ष्वाकु", iast: "ikṣvāku", role: "First king of the Solar dynasty", desc: "Third link in the lineage — 'thus handed down in succession, the royal sages knew it' (4.1–2).", side: "lineage", versesSpoken: 0},
  {id: "character:drupada", label: "Drupada & Dhrishtadyumna", sa: "द्रुपद", iast: "drupada", role: "Panchala king and his son, the Pandava commander", desc: "Duryodhana points out 'the son of Drupada, your wise disciple' who arrayed the Pandava host (1.3).", side: "pandava", versesSpoken: 0},
  {id: "character:abhimanyu", label: "Abhimanyu (Saubhadra)", sa: "अभिमन्यु", iast: "abhimanyu", role: "Son of Arjuna and Subhadra", desc: "The mighty-armed son of Subhadra who blows his conch with the Pandava heroes (1.6, 1.18).", side: "pandava", versesSpoken: 0}
] AS row
MERGE (n:Character {id: row.id}) SET n += row;

UNWIND [
  {id: "BG_1.1", label: "BG 1.1", ref: "1.1", chapter: 1, verse: 1, speaker: "dhritarashtra", canonical: true, meter: "anustubh", sa: "धर्मक्षेत्रे कुरुक्षेत्रे समवेता युयुत्सवः", snippet: "Dhritarashtra said, \"What did my people and the sons of Pandu do when they had assembled together, eager for battle, on the holy plain of Kurukshetra, O Sanjaya?\"", sanskrit: "धर्मक्षेत्रे कुरुक्षेत्रे समवेता युयुत्सवः ।\nमामकाः पाण्डवाश्चैव किमकुर्वत सञ्जय ॥", iast: "dharmakṣetre kurukṣetre samavetā yuyutsavaḥ |\nmāmakāḥ pāṇḍavāścaiva kimakurvata sañjaya ||", transliteration: "dharma-kṣhetre kuru-kṣhetre samavetā yuyutsavaḥ\nmāmakāḥ pāṇḍavāśhchaiva kimakurvata sañjaya", translation_en: "Dhritarashtra said, \"What did my people and the sons of Pandu do when they had assembled together, eager for battle, on the holy plain of Kurukshetra, O Sanjaya?\"", translation_hi: "धृतराष्ट्र ने कहा -- हे संजय ! धर्मभूमि कुरुक्षेत्र में एकत्र हुए युद्ध के इच्छुक (युयुत्सव:) मेरे और पाण्डु के पुत्रों ने क्या किया?", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_001.mp3"},
  {id: "BG_1.2", label: "BG 1.2", ref: "1.2", chapter: 1, verse: 2, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "दृष्ट्वा तु पाण्डवानीकं व्यूढं दुर्योधनस्तदा", snippet: "Sanjaya said: Having seen the army of the Pandavas drawn up in battle array, King Duryodhana approached his teacher, Drona, and spoke these words.", sanskrit: "दृष्ट्वा तु पाण्डवानीकं व्यूढं दुर्योधनस्तदा ।\nआचार्यमुपसङ्गम्य राजा वचनमब्रवीत् ॥", iast: "dṛṣṭvā tu pāṇḍavānīkaṃ vyūḍhaṃ duryodhanastadā |\nācāryamupasaṅgamya rājā vacanamabravīt ||", transliteration: "dṛiṣhṭvā tu pāṇḍavānīkaṁ vyūḍhaṁ duryodhanastadā\nāchāryamupasaṅgamya rājā vachanamabravīt", translation_en: "Sanjaya said: Having seen the army of the Pandavas drawn up in battle array, King Duryodhana approached his teacher, Drona, and spoke these words.", translation_hi: "संजय ने कहा -- पाण्डव-सैन्य की व्यूह रचना देखकर राजा दुर्योधन ने आचार्य द्रोण के पास जाकर ये वचन कहे।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_002.mp3"},
  {id: "BG_1.3", label: "BG 1.3", ref: "1.3", chapter: 1, verse: 3, speaker: "duryodhana", canonical: true, meter: "anustubh", sa: "पश्यैतां पाण्डुपुत्राणामाचार्य महतीं चमूम्", snippet: "Behold, O Teacher! This mighty army of the sons of Pandu, arrayed by the son of Drupada, thy wise disciple.", sanskrit: "पश्यैतां पाण्डुपुत्राणामाचार्य महतीं चमूम् ।\nव्यूढां द्रुपदपुत्रेण तव शिष्येण धीमता ॥", iast: "paśyaitāṃ pāṇḍuputrāṇāmācārya mahatīṃ camūm |\nvyūḍhāṃ drupadaputreṇa tava śiṣyeṇa dhīmatā ||", transliteration: "paśhyaitāṁ pāṇḍu-putrāṇām āchārya mahatīṁ chamūm\nvyūḍhāṁ drupada-putreṇa tava śhiṣhyeṇa dhīmatā", translation_en: "Behold, O Teacher! This mighty army of the sons of Pandu, arrayed by the son of Drupada, thy wise disciple.", translation_hi: "हे आचार्य ! आपके बुद्धिमान शिष्य द्रुपदपुत्र (धृष्टद्द्युम्न) द्वारा व्यूहाकार खड़ी की गयी पाण्डु पुत्रों की इस महती सेना को देखिये।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_003.mp3"},
  {id: "BG_1.4", label: "BG 1.4", ref: "1.4", chapter: 1, verse: 4, speaker: "duryodhana", canonical: true, meter: "anustubh", sa: "अत्र शूरा महेष्वासा भीमार्जुनसमा युधि", snippet: "Here are heroes, mighty archers, equal in battle to Bhima and Arjuna, Yuyudhana (Satyaki), Virata, and Drupada—all mighty warriors.", sanskrit: "अत्र शूरा महेष्वासा भीमार्जुनसमा युधि ।\nयुयुधानो विराटश्च द्रुपदश्च महारथः ॥", iast: "atra śūrā maheṣvāsā bhīmārjunasamā yudhi |\nyuyudhāno virāṭaśca drupadaśca mahārathaḥ ||", transliteration: "atra śhūrā maheṣhvāsā bhīmārjuna-samā yudhi\nyuyudhāno virāṭaśhcha drupadaśhcha mahā-rathaḥ", translation_en: "Here are heroes, mighty archers, equal in battle to Bhima and Arjuna, Yuyudhana (Satyaki), Virata, and Drupada—all mighty warriors.", translation_hi: "इस सेना में महान् धनुर्धारी शूर योद्धा है ,  जो युद्ध में भीम और अर्जुन के समान हैं , जैसे --  युयुधान, विराट तथा महारथी राजा द्रुपद।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_004.mp3"},
  {id: "BG_1.5", label: "BG 1.5", ref: "1.5", chapter: 1, verse: 5, speaker: "duryodhana", canonical: true, meter: "anustubh", sa: "धृष्टकेतुश्चेकितानः काशिराजश्च वीर्यवान्", snippet: "Dhrishtaketu, Chekitana, the valiant king of Kasi, Purujit, Kuntibhoja, and Saibya—the best of men.", sanskrit: "धृष्टकेतुश्चेकितानः काशिराजश्च वीर्यवान् ।\nपुरुजित्कुन्तिभोजश्च शैब्यश्च नरपुङ्गवः ॥", iast: "dhṛṣṭaketuścekitānaḥ kāśirājaśca vīryavān |\npurujitkuntibhojaśca śaibyaśca narapuṅgavaḥ ||", transliteration: "dhṛiṣhṭaketuśhchekitānaḥ kāśhirājaśhcha vīryavān\npurujit kuntibhojaśhcha śhaibyaśhcha nara-puṅgavaḥ\nyudhāmanyuśhcha vikrānta uttamaujāśhcha vīryavān", translation_en: "Dhrishtaketu, Chekitana, the valiant king of Kasi, Purujit, Kuntibhoja, and Saibya—the best of men.", translation_hi: "धृष्टकेतु, चेकितान, बलवान काशिराज,  पुरुजित्, कुन्तिभोज और मनुष्यों में श्रेष्ठ शैब्य।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_005.mp3"},
  {id: "BG_1.6", label: "BG 1.6", ref: "1.6", chapter: 1, verse: 6, speaker: "duryodhana", canonical: true, meter: "anustubh", sa: "युधामन्युश्च विक्रान्त उत्तमौजाश्च वीर्यवान्", snippet: "The strong Yudhamanyu and the brave Uttamaujas, the son of Subhadra (Abhimanyu, the son of Subhadra and Arjuna), and the sons of Draupadi, all of them great charioteers (great…", sanskrit: "युधामन्युश्च विक्रान्त उत्तमौजाश्च वीर्यवान् ।\nसौभद्रो द्रौपदेयाश्च सर्व एव महारथाः ॥", iast: "yudhāmanyuśca vikrānta uttamaujāśca vīryavān |\nsaubhadro draupadeyāśca sarva eva mahārathāḥ ||", transliteration: "saubhadro draupadeyāśhcha sarva eva mahā-rathāḥ", translation_en: "The strong Yudhamanyu and the brave Uttamaujas, the son of Subhadra (Abhimanyu, the son of Subhadra and Arjuna), and the sons of Draupadi, all of them great charioteers (great heroes).\"", translation_hi: "पराक्रमी युधामन्यु,  बलवान् उत्तमौजा,  सुभद्रापुत्र (अभिमन्यु) और द्रोपदी के पुत्र -- ये सब महारथी हैं।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_006.mp3"},
  {id: "BG_1.7", label: "BG 1.7", ref: "1.7", chapter: 1, verse: 7, speaker: "duryodhana", canonical: true, meter: "anustubh", sa: "अस्माकं तु विशिष्टा ये तान्निबोध द्विजोत्तम", snippet: "Know also, O best among the twice-born! the names of those who are the most distinguished amongst ourselves, the leaders of my army; these I name to you for your information.", sanskrit: "अस्माकं तु विशिष्टा ये तान्निबोध द्विजोत्तम ।\nनायका मम सैन्यस्य संज्ञार्थं तान्ब्रवीमि ते ॥", iast: "asmākaṃ tu viśiṣṭā ye tānnibodha dvijottama |\nnāyakā mama sainyasya saṃjñārthaṃ tānbravīmi te ||", transliteration: "asmākaṁ tu viśhiṣhṭā ye tānnibodha dwijottama\nnāyakā mama sainyasya sanjñārthaṁ tānbravīmi te", translation_en: "Know also, O best among the twice-born! the names of those who are the most distinguished amongst ourselves, the leaders of my army; these I name to you for your information.", translation_hi: "हे द्विजोत्तम ! हमारे पक्ष में भी जो विशिष्ट योद्धागण हैं , उनको आप जान लीजिये; आपकी जानकारी के लिये अपनी सेना के नायकों के नाम मैं आपको बताता हूँ।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_007.mp3"},
  {id: "BG_1.8", label: "BG 1.8", ref: "1.8", chapter: 1, verse: 8, speaker: "duryodhana", canonical: true, meter: "anustubh", sa: "भवान्भीष्मश्च कर्णश्च कृपश्च समितिञ्जयः", snippet: "\"Thou thyself, Bhishma, Karna, Kripa, the victorious in war, Asvatthama, Vikarna, and Bhurisrava, the son of Somadatta—all these are ready for battle.\"", sanskrit: "भवान्भीष्मश्च कर्णश्च कृपश्च समितिञ्जयः ।\nअश्वत्थामा विकर्णश्च सौमदत्तिस्तथैव च ॥", iast: "bhavānbhīṣmaśca karṇaśca kṛpaśca samitiñjayaḥ |\naśvatthāmā vikarṇaśca saumadattistathaiva ca ||", transliteration: "bhavānbhīṣhmaśhcha karṇaśhcha kṛipaśhcha samitiñjayaḥ\naśhvatthāmā vikarṇaśhcha saumadattis tathaiva cha", translation_en: "\"Thou thyself, Bhishma, Karna, Kripa, the victorious in war, Asvatthama, Vikarna, and Bhurisrava, the son of Somadatta—all these are ready for battle.\"", translation_hi: "एक तो स्वयं आप, भीष्म, कर्ण, और युद्ध विजयी कृपाचार्य तथा अश्वत्थामा, विकर्ण और सोमदत्त का पुत्र है।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_008.mp3"},
  {id: "BG_1.9", label: "BG 1.9", ref: "1.9", chapter: 1, verse: 9, speaker: "duryodhana", canonical: true, meter: "anustubh", sa: "अन्ये च बहवः शूरा मदर्थे त्यक्तजीविताः", snippet: "And also many other heroes, ready to give up their lives for my sake, armed with various weapons and missiles, all well-skilled in battle.", sanskrit: "अन्ये च बहवः शूरा मदर्थे त्यक्तजीविताः ।\nनानाशस्त्रप्रहरणाः सर्वे युद्धविशारदाः ॥", iast: "anye ca bahavaḥ śūrā madarthe tyaktajīvitāḥ |\nnānāśastrapraharaṇāḥ sarve yuddhaviśāradāḥ ||", transliteration: "anye cha bahavaḥ śhūrā madarthe tyaktajīvitāḥ\nnānā-śhastra-praharaṇāḥ sarve yuddha-viśhāradāḥ", translation_en: "And also many other heroes, ready to give up their lives for my sake, armed with various weapons and missiles, all well-skilled in battle.", translation_hi: "मेरे लिए प्राण त्याग करने के लिए तैयार, अनेक प्रकार के शस्त्रास्त्रों से सुसज्जित तथा युद्ध में कुशल और भी अनेक शूर वीर हैं।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_009.mp3"},
  {id: "BG_1.10", label: "BG 1.10", ref: "1.10", chapter: 1, verse: 10, speaker: "duryodhana", canonical: true, meter: "anustubh", sa: "अपर्याप्तं तदस्माकं बलं भीष्माभिरक्षितम्", snippet: "Our army, marshalled by Bhishma, is insufficient, whereas theirs, marshalled by Bhima, is sufficient.", sanskrit: "अपर्याप्तं तदस्माकं बलं भीष्माभिरक्षितम् ।\nपर्याप्तं त्विदमेतेषां बलं भीमाभिरक्षितम् ॥", iast: "aparyāptaṃ tadasmākaṃ balaṃ bhīṣmābhirakṣitam |\nparyāptaṃ tvidameteṣāṃ balaṃ bhīmābhirakṣitam ||", transliteration: "aparyāptaṁ tadasmākaṁ balaṁ bhīṣhmābhirakṣhitam\nparyāptaṁ tvidameteṣhāṁ balaṁ bhīmābhirakṣhitam", translation_en: "Our army, marshalled by Bhishma, is insufficient, whereas theirs, marshalled by Bhima, is sufficient.", translation_hi: "भीष्म के द्वारा हमारी रक्षित सेना अपर्याप्त है; किन्तु भीम द्वारा रक्षित उनकी सेना पर्याप्त है अथवा, भीष्म के द्वारा रक्षित हमारी सेना अपरिमित है किन्तु भीम के द्वारा रक्षित उनकी सेना परिमित ही है।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_010.mp3"},
  {id: "BG_1.11", label: "BG 1.11", ref: "1.11", chapter: 1, verse: 11, speaker: "duryodhana", canonical: true, meter: "anustubh", sa: "अयनेषु च सर्वेषु यथाभागमवस्थिताः", snippet: "Therefore, do all of you, stationed in your respective positions in the several divisions of the army, protect Bhishma alone.", sanskrit: "अयनेषु च सर्वेषु यथाभागमवस्थिताः ।\nभीष्ममेवाभिरक्षन्तु भवन्तः सर्व एव हि ॥", iast: "ayaneṣu ca sarveṣu yathābhāgamavasthitāḥ |\nbhīṣmamevābhirakṣantu bhavantaḥ sarva eva hi ||", transliteration: "ayaneṣhu cha sarveṣhu yathā-bhāgamavasthitāḥ\nbhīṣhmamevābhirakṣhantu bhavantaḥ sarva eva hi", translation_en: "Therefore, do all of you, stationed in your respective positions in the several divisions of the army, protect Bhishma alone.", translation_hi: "विभिन्न मोर्चों पर अपने-अपने स्थान पर स्थित रहते हुए आप सब लोग भीष्म पितामह की ही सब ओर से रक्षा करें।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_011.mp3"},
  {id: "BG_1.12", label: "BG 1.12", ref: "1.12", chapter: 1, verse: 12, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "तस्य संजनयन्हर्षं कुरुवृद्धः पितामहः", snippet: "His glorious grandsire, the oldest of the Kauravas, roared like a lion to cheer Duryodhana and blew his conch.", sanskrit: "तस्य संजनयन्हर्षं कुरुवृद्धः पितामहः ।\nसिंहनादं विनद्योच्चैः शङ्खं दध्मौ प्रतापवान् ॥", iast: "tasya saṃjanayanharṣaṃ kuruvṛddhaḥ pitāmahaḥ |\nsiṃhanādaṃ vinadyoccaiḥ śaṅkhaṃ dadhmau pratāpavān ||", transliteration: "tasya sañjanayan harṣhaṁ kuru-vṛiddhaḥ pitāmahaḥ\nsiṁha-nādaṁ vinadyochchaiḥ śhaṅkhaṁ dadhmau pratāpavān", translation_en: "His glorious grandsire, the oldest of the Kauravas, roared like a lion to cheer Duryodhana and blew his conch.", translation_hi: "उस समय कौरवों में वृद्ध, प्रतापी पितामह भीष्म ने उस (दुर्योधन) के हृदय में हर्ष उत्पन्न करते हुये उच्च स्वर में गरज कर शंखध्वनि की।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_012.mp3"},
  {id: "BG_1.13", label: "BG 1.13", ref: "1.13", chapter: 1, verse: 13, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "ततः शङ्खाश्च भेर्यश्च पणवानकगोमुखाः", snippet: "Then, suddenly, conches, kettledrums, tabors, drums, and cow horns blared forth from the Kaurava side, and the sound was tremendous.", sanskrit: "ततः शङ्खाश्च भेर्यश्च पणवानकगोमुखाः ।\nसहसैवाभ्यहन्यन्त स शब्दस्तुमुलोऽभवत् ॥", iast: "tataḥ śaṅkhāśca bheryaśca paṇavānakagomukhāḥ |\nsahasaivābhyahanyanta sa śabdastumulo’bhavat ||", transliteration: "tataḥ śhaṅkhāśhcha bheryaśhcha paṇavānaka-gomukhāḥ\nsahasaivābhyahanyanta sa śhabdastumulo ’bhavat", translation_en: "Then, suddenly, conches, kettledrums, tabors, drums, and cow horns blared forth from the Kaurava side, and the sound was tremendous.", translation_hi: "तत्पश्चात् शंख, नगारे, ढोल व शृंगी आदि वाद्य एक साथ ही बज उठे, जिनका बड़ा भयंकर शब्द हुआ।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_013.mp3"},
  {id: "BG_1.14", label: "BG 1.14", ref: "1.14", chapter: 1, verse: 14, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "ततः श्वेतैर्हयैर्युक्ते महति स्यन्दने स्थितौ", snippet: "Then, Madhava (Krishna) and the son of Pandu (Arjuna), seated in the magnificent chariot yoked with white horses, blew divine conches.", sanskrit: "ततः श्वेतैर्हयैर्युक्ते महति स्यन्दने स्थितौ ।\nमाधवः पाण्डवश्चैव दिव्यौ शङ्खौ प्रदध्मतुः ॥", iast: "tataḥ śvetairhayairyukte mahati syandane sthitau |\nmādhavaḥ pāṇḍavaścaiva divyau śaṅkhau pradadhmatuḥ ||", transliteration: "tataḥ śhvetairhayairyukte mahati syandane sthitau\nmādhavaḥ pāṇḍavaśhchaiva divyau śhaṅkhau pradadhmatuḥ", translation_en: "Then, Madhava (Krishna) and the son of Pandu (Arjuna), seated in the magnificent chariot yoked with white horses, blew divine conches.", translation_hi: "इसके उपरान्त श्वेत अश्वों से युक्त भव्य रथ में बैठे हुये माधव (श्रीकृष्ण) और पाण्डुपुत्र अर्जुन ने भी अपने दिव्य शंख बजाये।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_014.mp3"},
  {id: "BG_1.15", label: "BG 1.15", ref: "1.15", chapter: 1, verse: 15, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "पाञ्चजन्यं हृषीकेशो देवदत्तं धनंजयः", snippet: "Hrishikesha blew the Panchajanya, Arjuna blew the Devadatta, and Bhima, the wolf-bellied doer of terrible deeds, blew the great conch Paundra.", sanskrit: "पाञ्चजन्यं हृषीकेशो देवदत्तं धनंजयः ।\nपौण्ड्रं दध्मौ महाशङ्खं भीमकर्मा वृकोदरः ॥", iast: "pāñcajanyaṃ hṛṣīkeśo devadattaṃ dhanaṃjayaḥ |\npauṇḍraṃ dadhmau mahāśaṅkhaṃ bhīmakarmā vṛkodaraḥ ||", transliteration: "pāñchajanyaṁ hṛiṣhīkeśho devadattaṁ dhanañjayaḥ\npauṇḍraṁ dadhmau mahā-śhaṅkhaṁ bhīma-karmā vṛikodaraḥ", translation_en: "Hrishikesha blew the Panchajanya, Arjuna blew the Devadatta, and Bhima, the wolf-bellied doer of terrible deeds, blew the great conch Paundra.", translation_hi: "भगवान् हृषीकेश ने पांचजन्य, धनंजय (अर्जुन) ने देवदत्त तथा भयंकर कर्म करने वाले भीम ने पौण्डू नामक महाशंख बजाया।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_015.mp3"},
  {id: "BG_1.16", label: "BG 1.16", ref: "1.16", chapter: 1, verse: 16, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "अनन्तविजयं राजा कुन्तीपुत्रो युधिष्ठिरः", snippet: "King Yudhishthira, the son of Kunti, blew the Anantavijaya; Nakula and Sahadeva blew the Sughosha and the Manipushpaka.", sanskrit: "अनन्तविजयं राजा कुन्तीपुत्रो युधिष्ठिरः ।\nनकुलः सहदेवश्च सुघोषमणिपुष्पकौ ॥", iast: "anantavijayaṃ rājā kuntīputro yudhiṣṭhiraḥ |\nnakulaḥ sahadevaśca sughoṣamaṇipuṣpakau ||", transliteration: "anantavijayaṁ rājā kuntī-putro yudhiṣhṭhiraḥ\nnakulaḥ sahadevaśhcha sughoṣha-maṇipuṣhpakau", translation_en: "King Yudhishthira, the son of Kunti, blew the Anantavijaya; Nakula and Sahadeva blew the Sughosha and the Manipushpaka.", translation_hi: "कुन्तीपुत्र राजा युधिष्ठिर ने अनन्त विजय नामक शंख और नकुल व सहदेव ने क्रमश:  सुघोष और मणिपुष्पक नामक शंख बजाये।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_016.mp3"},
  {id: "BG_1.17", label: "BG 1.17", ref: "1.17", chapter: 1, verse: 17, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "काश्यश्च परमेष्वासः शिखण्डी च महारथः", snippet: "The king of Kasi, an excellent archer, Sikhandi, the mighty car-warrior, Dhrishtadyumna, Virata, and Satyaki, the unconquered.", sanskrit: "काश्यश्च परमेष्वासः शिखण्डी च महारथः ।\nधृष्टद्युम्नो विराटश्च सात्यकिश्चापराजितः ॥", iast: "kāśyaśca parameṣvāsaḥ śikhaṇḍī ca mahārathaḥ |\ndhṛṣṭadyumno virāṭaśca sātyakiścāparājitaḥ ||", transliteration: "kāśhyaśhcha parameṣhvāsaḥ śhikhaṇḍī cha mahā-rathaḥ\ndhṛiṣhṭadyumno virāṭaśhcha sātyakiśh chāparājitaḥ", translation_en: "The king of Kasi, an excellent archer, Sikhandi, the mighty car-warrior, Dhrishtadyumna, Virata, and Satyaki, the unconquered.", translation_hi: "श्रेष्ठ धनुषवाले काशिराज, महारथी शिखण्डी, धृष्टद्युम्न,  राजा विराट और अजेय सात्यकि।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_017.mp3"},
  {id: "BG_1.18", label: "BG 1.18", ref: "1.18", chapter: 1, verse: 18, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "द्रुपदो द्रौपदेयाश्च सर्वशः पृथिवीपते", snippet: "Drupada and the sons of Draupadi, O Lord of the Earth, and the son of Subhadra, the mighty-armed, blew their conches each separately.", sanskrit: "द्रुपदो द्रौपदेयाश्च सर्वशः पृथिवीपते ।\nसौभद्रश्च महाबाहुः शङ्खान्दध्मुः पृथक्पृथक् ॥", iast: "drupado draupadeyāśca sarvaśaḥ pṛthivīpate |\nsaubhadraśca mahābāhuḥ śaṅkhāndadhmuḥ pṛthakpṛthak ||", transliteration: "drupado draupadeyāśhcha sarvaśhaḥ pṛithivī-pate\nsaubhadraśhcha mahā-bāhuḥ śhaṅkhāndadhmuḥ pṛithak pṛithak", translation_en: "Drupada and the sons of Draupadi, O Lord of the Earth, and the son of Subhadra, the mighty-armed, blew their conches each separately.", translation_hi: "हे राजन् ! राजा द्रुपद,  द्रौपदी के पुत्र और महाबाहु सौभद्र (अभिमन्यु) इन सब ने अलग-अलग शंख बजाये।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_018.mp3"},
  {id: "BG_1.19", label: "BG 1.19", ref: "1.19", chapter: 1, verse: 19, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "स घोषो धार्तराष्ट्राणां हृदयानि व्यदारयत्", snippet: "The tumultuous sound rent the hearts of Dhritarashtra's party, reverberating through both heaven and earth.", sanskrit: "स घोषो धार्तराष्ट्राणां हृदयानि व्यदारयत् ।\nनभश्च पृथिवीं चैव तुमुलो व्यनुनादयन् ॥", iast: "sa ghoṣo dhārtarāṣṭrāṇāṃ hṛdayāni vyadārayat |\nnabhaśca pṛthivīṃ caiva tumulo vyanunādayan ||", transliteration: "sa ghoṣho dhārtarāṣhṭrāṇāṁ hṛidayāni vyadārayat\nnabhaśhcha pṛithivīṁ chaiva tumulo nunādayan", translation_en: "The tumultuous sound rent the hearts of Dhritarashtra's party, reverberating through both heaven and earth.", translation_hi: "वह भयंकर घोष आकाश और पृथ्वी पर गूँजने लगा और उसने धृतराष्ट्र के पुत्रों के हृदय विदीर्ण कर दिये।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_019.mp3"},
  {id: "BG_1.20", label: "BG 1.20", ref: "1.20", chapter: 1, verse: 20, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "अथ व्यवस्थितान् दृष्ट्वा धार्तराष्ट्रान्कपिध्वजः", snippet: "Then, seeing the people of Dhritarashtra's party standing arrayed and the discharge of weapons about to begin, Arjuna, the son of Pandu whose ensign was a monkey, took up his…", sanskrit: "अथ व्यवस्थितान् दृष्ट्वा धार्तराष्ट्रान्कपिध्वजः ।\nप्रवृत्ते शस्त्रसंपाते धनुरुद्यम्य पाण्डवः ॥", iast: "atha vyavasthitān dṛṣṭvā dhārtarāṣṭrānkapidhvajaḥ |\npravṛtte śastrasaṃpāte dhanurudyamya pāṇḍavaḥ ||", transliteration: "atha vyavasthitān dṛiṣhṭvā dhārtarāṣhṭrān kapi-dhwajaḥ\npravṛitte śhastra-sampāte dhanurudyamya pāṇḍavaḥ\nhṛiṣhīkeśhaṁ tadā vākyam idam āha mahī-pate", translation_en: "Then, seeing the people of Dhritarashtra's party standing arrayed and the discharge of weapons about to begin, Arjuna, the son of Pandu whose ensign was a monkey, took up his bow and said the following to Krishna, O Lord of the Earth.", translation_hi: "हे महीपते ! इस प्रकार जब युद्ध प्रारम्भ होने वाला ही था कि कपिध्वज अर्जुन ने धृतराष्ट्र के पुत्रों को स्थित देखकर धनुष उठाकर भगवान् हृषीकेश से ये शब्द कहे।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_020.mp3"},
  {id: "BG_1.21", label: "BG 1.21", ref: "1.21", chapter: 1, verse: 21, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "हृषीकेशं तदा वाक्यमिदमाह महीपते", snippet: "Arjuna said, \"O Krishna, place my chariot in the middle between the two armies, so that I may behold those who stand here, desirous to fight, and know with whom I must fight…", sanskrit: "हृषीकेशं तदा वाक्यमिदमाह महीपते ।\nसेनयोरुभयोर्मध्ये रथं स्थापय मेऽच्युत ॥", iast: "hṛṣīkeśaṃ tadā vākyamidamāha mahīpate |\nsenayorubhayormadhye rathaṃ sthāpaya me’cyuta ||", transliteration: "senayor ubhayor madhye rathaṁ sthāpaya me ’chyuta", translation_en: "Arjuna said, \"O Krishna, place my chariot in the middle between the two armies, so that I may behold those who stand here, desirous to fight, and know with whom I must fight when the battle is about to commence.\"", translation_hi: "अर्जुन ने कहा -- हे! अच्युत मेरे रथ को दोनों सेनाओं के मध्य खड़ा कीजिये।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_021.mp3"},
  {id: "BG_1.22", label: "BG 1.22", ref: "1.22", chapter: 1, verse: 22, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "यावदेतान्निरीक्षेऽहं योद्धुकामानवस्थितान्", snippet: "Arjuna said, \"O Krishna, place my chariot in the middle between the two armies, so that I may behold those who stand here, desirous to fight, and know with whom I must fight…", sanskrit: "यावदेतान्निरीक्षेऽहं योद्धुकामानवस्थितान् ।\nकैर्मया सह योद्धव्यमस्मिन्रणसमुद्यमे ॥", iast: "yāvadetānnirīkṣe’haṃ yoddhukāmānavasthitān |\nkairmayā saha yoddhavyamasminraṇasamudyame ||", transliteration: "yāvadetān nirīkṣhe ’haṁ yoddhu-kāmān avasthitān\nkairmayā saha yoddhavyam asmin raṇa-samudyame", translation_en: "Arjuna said, \"O Krishna, place my chariot in the middle between the two armies, so that I may behold those who stand here, desirous to fight, and know with whom I must fight when the battle is about to commence.\"", translation_hi: "जिससे मैं युद्ध की इच्छा से खड़े इन लोगों का निरीक्षण कर सकूँ कि इस युद्ध में मुझे किनके साथ युद्ध करना है।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_022.mp3"},
  {id: "BG_1.23", label: "BG 1.23", ref: "1.23", chapter: 1, verse: 23, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "योत्स्यमानानवेक्षेऽहं य एतेऽत्र समागताः", snippet: "For I desire to observe those who are assembled here to fight, wishing to please in battle the evil-minded Duryodhana—the son of Dhritarashtra.", sanskrit: "योत्स्यमानानवेक्षेऽहं य एतेऽत्र समागताः ।\nधार्तराष्ट्रस्य दुर्बुद्धेर्युद्धे प्रियचिकीर्षवः ॥", iast: "yotsyamānānavekṣe’haṃ ya ete’tra samāgatāḥ |\ndhārtarāṣṭrasya durbuddheryuddhe priyacikīrṣavaḥ ||", transliteration: "yotsyamānān avekṣhe ’haṁ ya ete ’tra samāgatāḥ\ndhārtarāṣhṭrasya durbuddher yuddhe priya-chikīrṣhavaḥ", translation_en: "For I desire to observe those who are assembled here to fight, wishing to please in battle the evil-minded Duryodhana—the son of Dhritarashtra.", translation_hi: "दुर्बुद्धि धार्तराष्ट्र (दुर्योधन) का युद्ध में प्रिय चाहने वाले जो ये राजा लोग यहाँ एकत्र हुए हैं, उन युद्ध करने वालों को मैं देखूँगा।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_023.mp3"},
  {id: "BG_1.24", label: "BG 1.24", ref: "1.24", chapter: 1, verse: 24, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "एवमुक्तो हृषीकेशो गुडाकेशेन भारत", snippet: "Sanjaya said, Thus addressed by Arjuna, Krishna stationed the best of chariots, O Dhritarashtra, in the midst of the two armies.", sanskrit: "एवमुक्तो हृषीकेशो गुडाकेशेन भारत ।\nसेनयोरुभयोर्मध्ये स्थापयित्वा रथोत्तमम् ॥", iast: "evamukto hṛṣīkeśo guḍākeśena bhārata |\nsenayorubhayormadhye sthāpayitvā rathottamam ||", transliteration: "evam ukto hṛiṣhīkeśho guḍākeśhena bhārata\nsenayor ubhayor madhye sthāpayitvā rathottamam", translation_en: "Sanjaya said, Thus addressed by Arjuna, Krishna stationed the best of chariots, O Dhritarashtra, in the midst of the two armies.", translation_hi: "संजय ने कहा -- हे भारत (धृतराष्ट्र) ! अर्जुन के इस प्रकार कहने पर भगवान् हृषीकेश ने दोनों सेनाओं के मध्य उत्तम रथ को खड़ा करके।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_024.mp3"},
  {id: "BG_1.25", label: "BG 1.25", ref: "1.25", chapter: 1, verse: 25, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "भीष्मद्रोणप्रमुखतः सर्वेषां च महीक्षिताम्", snippet: "In front of Bhishma and Drona, and all the rulers of the earth, he said: \"O Arjuna, son of Pritha, behold these Kurus gathered together.\"", sanskrit: "भीष्मद्रोणप्रमुखतः सर्वेषां च महीक्षिताम् ।\nउवाच पार्थ पश्यैतान्समवेतान्कुरूनिति ॥", iast: "bhīṣmadroṇapramukhataḥ sarveṣāṃ ca mahīkṣitām |\nuvāca pārtha paśyaitānsamavetānkurūniti ||", transliteration: "bhīṣhma-droṇa-pramukhataḥ sarveṣhāṁ cha mahī-kṣhitām\nuvācha pārtha paśhyaitān samavetān kurūn iti", translation_en: "In front of Bhishma and Drona, and all the rulers of the earth, he said: \"O Arjuna, son of Pritha, behold these Kurus gathered together.\"", translation_hi: "भीष्म, द्रोण तथा पृथ्वी के समस्त शासकों के समक्ष उन्होंने कहा, \"हे पार्थ यहाँ एकत्र हुये कौरवों को देखो\"।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_025.mp3"},
  {id: "BG_1.26", label: "BG 1.26", ref: "1.26", chapter: 1, verse: 26, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "तत्रापश्यत्स्थितान्पार्थः पितृ़नथ पितामहान्", snippet: "Then, Arjuna (son of Pritha) saw there (in the armies) stationed fathers, grandfathers, teachers, maternal uncles, brothers, sons, grandsons, and friends.", sanskrit: "तत्रापश्यत्स्थितान्पार्थः पितृ़नथ पितामहान् ।\nआचार्यान्मातुलान्भ्रातृ़न्पुत्रान्पौत्रान्सखींस्तथा ॥", iast: "tatrāpaśyatsthitānpārthaḥ pitṛnatha pitāmahān |\nācāryānmātulānbhrātṛnputrānpautrānsakhīṃstathā ||", transliteration: "tatrāpaśhyat sthitān pārthaḥ pitṝīn atha pitāmahān\nāchāryān mātulān bhrātṝīn putrān pautrān sakhīṁs tathā\nśhvaśhurān suhṛidaśh chaiva senayor ubhayor api", translation_en: "Then, Arjuna (son of Pritha) saw there (in the armies) stationed fathers, grandfathers, teachers, maternal uncles, brothers, sons, grandsons, and friends.", translation_hi: "वहाँ अर्जुन ने उन दोनों सेनाओं में खड़े पिता के भाइयों,  पितामहों,  आचार्यों,  मामों, भाइयों, पुत्रों,  पौत्रों,  मित्रों,  श्वसुरों और सुहृदों को भी देखा।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_026.mp3"},
  {id: "BG_1.27", label: "BG 1.27", ref: "1.27", chapter: 1, verse: 27, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "श्वशुरान्सुहृदश्चैव सेनयोरुभयोरपि", snippet: "He saw fathers-in-law and friends in both the armies. The son of Kunti, Arjuna, seeing all those kinsmen thus standing arrayed, spoke sorrowfully, deeply filled with pity.", sanskrit: "श्वशुरान्सुहृदश्चैव सेनयोरुभयोरपि ।\nतान्समीक्ष्य स कौन्तेयः सर्वान्बन्धूनवस्थितान् ॥", iast: "śvaśurānsuhṛdaścaiva senayorubhayorapi |\ntānsamīkṣya sa kaunteyaḥ sarvānbandhūnavasthitān ||", transliteration: "tān samīkṣhya sa kaunteyaḥ sarvān bandhūn avasthitān\nkṛipayā parayāviṣhṭo viṣhīdann idam abravīt", translation_en: "He saw fathers-in-law and friends in both the armies. The son of Kunti, Arjuna, seeing all those kinsmen thus standing arrayed, spoke sorrowfully, deeply filled with pity.", translation_hi: "इस प्रकार उन सब बन्धु-बान्धवों को खड़े देखकर कुन्ती पुत्र अर्जुन का मन करुणा से भर गया और विषादयुक्त होकर उसने यह कहा।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_027.mp3"},
  {id: "BG_1.28", label: "BG 1.28", ref: "1.28", chapter: 1, verse: 28, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "कृपया परयाऽऽविष्टो विषीदन्निदमब्रवीत्", snippet: "Arjuna said, \"O Krishna, seeing my kinsmen arrayed here, eager to fight,", sanskrit: "कृपया परयाऽऽविष्टो विषीदन्निदमब्रवीत् ।\nदृष्ट्वेमं स्वजनं कृष्ण युयुत्सुं समुपस्थितम् ॥", iast: "kṛpayā parayā’’viṣṭo viṣīdannidamabravīt |\ndṛṣṭvemaṃ svajanaṃ kṛṣṇa yuyutsuṃ samupasthitam ||", transliteration: "dṛiṣhṭvemaṁ sva-janaṁ kṛiṣhṇa yuyutsuṁ samupasthitam", translation_en: "Arjuna said, \"O Krishna, seeing my kinsmen arrayed here, eager to fight,", translation_hi: "1.29।।अर्जुन ने कहा -- हे कृष्ण ! युद्ध की इच्छा रखकर उपस्थित हुए इन स्वजनों को देखकर मेरे अंग शिथिल हुये जाते हैं, मुख भी सूख रहा है और मेरे शरीर में कम्प तथा रोमांच हो रहा है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_028.mp3"},
  {id: "BG_1.29", label: "BG 1.29", ref: "1.29", chapter: 1, verse: 29, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "सीदन्ति मम गात्राणि मुखं च परिशुष्यति", snippet: "My limbs fail, my mouth is parched, my body quivers, and my hair stands on end.", sanskrit: "सीदन्ति मम गात्राणि मुखं च परिशुष्यति ।\nवेपथुश्च शरीरे मे रोमहर्षश्च जायते ॥", iast: "sīdanti mama gātrāṇi mukhaṃ ca pariśuṣyati |\nvepathuśca śarīre me romaharṣaśca jāyate ||", transliteration: "sīdanti mama gātrāṇi mukhaṁ cha pariśhuṣhyati\nvepathuśh cha śharīre me roma-harṣhaśh cha jāyate", translation_en: "My limbs fail, my mouth is parched, my body quivers, and my hair stands on end.", translation_hi: "1.29।।अर्जुन ने कहा -- हे कृष्ण !  युद्ध की इच्छा रखकर उपस्थित हुए इन स्वजनों को देखकर मेरे अंग शिथिल हुये जाते हैं,  मुख भी सूख रहा है और मेरे शरीर में कम्प तथा रोमांच हो रहा है।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_029.mp3"},
  {id: "BG_1.30", label: "BG 1.30", ref: "1.30", chapter: 1, verse: 30, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "गाण्डीवं स्रंसते हस्तात्त्वक्चैव परिदह्यते", snippet: "The Gandiva slips from my hand, and my skin burns all over; I am unable to stand, and my mind is reeling, as it were.", sanskrit: "गाण्डीवं स्रंसते हस्तात्त्वक्चैव परिदह्यते ।\nन च शक्नोम्यवस्थातुं भ्रमतीव च मे मनः ॥", iast: "gāṇḍīvaṃ sraṃsate hastāttvakcaiva paridahyate |\nna ca śaknomyavasthātuṃ bhramatīva ca me manaḥ ||", transliteration: "gāṇḍīvaṁ sraṁsate hastāt tvak chaiva paridahyate\nna cha śhaknomy avasthātuṁ bhramatīva cha me manaḥ", translation_en: "The Gandiva slips from my hand, and my skin burns all over; I am unable to stand, and my mind is reeling, as it were.", translation_hi: "मेरे हाथ से गाण्डीव (धनुष) गिर रहा है और त्वचा जल रही है। मेरा मन भ्रमित सा हो रहा है,  और मैं खड़े रहने में असमर्थ हूँ।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_030.mp3"},
  {id: "BG_1.31", label: "BG 1.31", ref: "1.31", chapter: 1, verse: 31, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "निमित्तानि च पश्यामि विपरीतानि केशव", snippet: "And I see ill omens, O Kesava. I do not see any good in slaying my kinsmen in battle.", sanskrit: "निमित्तानि च पश्यामि विपरीतानि केशव ।\nन च श्रेयोऽनुपश्यामि हत्वा स्वजनमाहवे ॥", iast: "nimittāni ca paśyāmi viparītāni keśava |\nna ca śreyo’nupaśyāmi hatvā svajanamāhave ||", transliteration: "nimittāni cha paśhyāmi viparītāni keśhava\nna cha śhreyo ’nupaśhyāmi hatvā sva-janam āhave", translation_en: "And I see ill omens, O Kesava. I do not see any good in slaying my kinsmen in battle.", translation_hi: "हे केशव ! मैं शकुनों को भी विपरीत ही देख रहा हूँ और युद्ध में (आहवे) अपने स्वजनों को मारकर कोई कल्याण भी नहीं देखता हूँ।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_031.mp3"},
  {id: "BG_1.32", label: "BG 1.32", ref: "1.32", chapter: 1, verse: 32, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "न काङ्क्षे विजयं कृष्ण न च राज्यं सुखानि च", snippet: "I desire not victory, O Krishna, nor kingdom, nor pleasures.\nWhat use is dominion to us, O Krishna, or pleasures or even life?", sanskrit: "न काङ्क्षे विजयं कृष्ण न च राज्यं सुखानि च ।\nकिं नो राज्येन गोविन्द किं भोगैर्जीवितेन वा ॥", iast: "na kāṅkṣe vijayaṃ kṛṣṇa na ca rājyaṃ sukhāni ca |\nkiṃ no rājyena govinda kiṃ bhogairjīvitena vā ||", transliteration: "na kāṅkṣhe vijayaṁ kṛiṣhṇa na cha rājyaṁ sukhāni cha\nkiṁ no rājyena govinda kiṁ bhogair jīvitena vā", translation_en: "I desire not victory, O Krishna, nor kingdom, nor pleasures.\nWhat use is dominion to us, O Krishna, or pleasures or even life?", translation_hi: "हे कृष्ण ! मैं न विजय चाहता हूँ, न राज्य और न सुखों को ही चाहता हूँ। हे गोविन्द ! हमें राज्य से अथवा भोगों से और जीने से भी क्या प्रयोजन है?।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_032.mp3"},
  {id: "BG_1.33", label: "BG 1.33", ref: "1.33", chapter: 1, verse: 33, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "येषामर्थे काङ्क्षितं नो राज्यं भोगाः सुखानि च", snippet: "Those for whose sake we desire kingdom, enjoyments, and pleasures stand here in battle, having renounced life and wealth.", sanskrit: "येषामर्थे काङ्क्षितं नो राज्यं भोगाः सुखानि च ।\nत इमेऽवस्थिता युद्धे प्राणांस्त्यक्त्वा धनानि च ॥", iast: "yeṣāmarthe kāṅkṣitaṃ no rājyaṃ bhogāḥ sukhāni ca |\nta ime’vasthitā yuddhe prāṇāṃstyaktvā dhanāni ca ||", transliteration: "yeṣhām arthe kāṅkṣhitaṁ no rājyaṁ bhogāḥ sukhāni cha\nta ime ’vasthitā yuddhe prāṇāṁs tyaktvā dhanāni cha", translation_en: "Those for whose sake we desire kingdom, enjoyments, and pleasures stand here in battle, having renounced life and wealth.", translation_hi: "हमें जिनके लिये राज्य,  भोग और सुखादि की इच्छा है,  वे ही लोग धन और जीवन की आशा को त्यागकर युद्ध में खड़े हैं।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_033.mp3"},
  {id: "BG_1.34", label: "BG 1.34", ref: "1.34", chapter: 1, verse: 34, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "आचार्याः पितरः पुत्रास्तथैव च पितामहाः", snippet: "Teachers, fathers, sons, and grandfathers, maternal uncles, fathers-in-law, grandsons, brothers-in-law, and other relatives—", sanskrit: "आचार्याः पितरः पुत्रास्तथैव च पितामहाः ।\nमातुलाः श्चशुराः पौत्राः श्यालाः सम्बन्धिनस्तथा ॥", iast: "ācāryāḥ pitaraḥ putrāstathaiva ca pitāmahāḥ |\nmātulāḥ ścaśurāḥ pautrāḥ śyālāḥ sambandhinastathā ||", transliteration: "āchāryāḥ pitaraḥ putrās tathaiva cha pitāmahāḥ\nmātulāḥ śhvaśhurāḥ pautrāḥ śhyālāḥ sambandhinas tathā", translation_en: "Teachers, fathers, sons, and grandfathers, maternal uncles, fathers-in-law, grandsons, brothers-in-law, and other relatives—", translation_hi: "वे लोग गुरुजन,  ताऊ,  चाचा,  पुत्र,  पितामह,   श्वसुर,  पोते,  श्यालक तथा अन्य सम्बन्धी हैं।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_034.mp3"},
  {id: "BG_1.35", label: "BG 1.35", ref: "1.35", chapter: 1, verse: 35, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "एतान्न हन्तुमिच्छामि घ्नतोऽपि मधुसूदन", snippet: "These I do not wish to kill, O Krishna, even though they kill me, for the sake of dominion over the three worlds; leave alone killing them for the sake of the earth.\"", sanskrit: "एतान्न हन्तुमिच्छामि घ्नतोऽपि मधुसूदन ।\nअपि त्रैलोक्यराज्यस्य हेतोः किं नु महीकृते ॥", iast: "etānna hantumicchāmi ghnato’pi madhusūdana |\napi trailokyarājyasya hetoḥ kiṃ nu mahīkṛte ||", transliteration: "etān na hantum ichchhāmi ghnato ’pi madhusūdana\napi trailokya-rājyasya hetoḥ kiṁ nu mahī-kṛite", translation_en: "These I do not wish to kill, O Krishna, even though they kill me, for the sake of dominion over the three worlds; leave alone killing them for the sake of the earth.\"", translation_hi: "हे मधुसूदन !  इनके मुझे मारने पर अथवा त्रैलोक्य के राज्य के लिये भी मैं इनको मारना नहीं चाहता,  फिर पृथ्वी के लिए कहना ही क्या है।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_035.mp3"},
  {id: "BG_1.36", label: "BG 1.36", ref: "1.36", chapter: 1, verse: 36, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "निहत्य धार्तराष्ट्रान्नः का प्रीतिः स्याज्जनार्दन", snippet: "By killing these sons of Dhritarashtra, what pleasure could be ours, O Janardana? Only sin would accrue to us from killing these felons.", sanskrit: "निहत्य धार्तराष्ट्रान्नः का प्रीतिः स्याज्जनार्दन ।\nपापमेवाश्रयेदस्मान्हत्वैतानाततायिनः ॥", iast: "nihatya dhārtarāṣṭrānnaḥ kā prītiḥ syājjanārdana |\npāpamevāśrayedasmānhatvaitānātatāyinaḥ ||", transliteration: "nihatya dhārtarāṣhṭrān naḥ kā prītiḥ syāj janārdana\npāpam evāśhrayed asmān hatvaitān ātatāyinaḥ", translation_en: "By killing these sons of Dhritarashtra, what pleasure could be ours, O Janardana? Only sin would accrue to us from killing these felons.", translation_hi: "हे जनार्दन ! धृतराष्ट्र के पुत्रों की हत्या करके हमें क्या प्रसन्नता होगी?  इन आततायियों को मारकर तो हमें केवल पाप ही लगेगा।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_036.mp3"},
  {id: "BG_1.37", label: "BG 1.37", ref: "1.37", chapter: 1, verse: 37, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "तस्मान्नार्हा वयं हन्तुं धार्तराष्ट्रान्स्वबान्धवान्", snippet: "Therefore, we should not kill the sons of Dhritarashtra, our relatives; for how can we be happy by killing our own kin, O Madhava (Krishna)?", sanskrit: "तस्मान्नार्हा वयं हन्तुं धार्तराष्ट्रान्स्वबान्धवान् ।\nस्वजनं हि कथं हत्वा सुखिनः स्याम माधव ॥", iast: "tasmānnārhā vayaṃ hantuṃ dhārtarāṣṭrānsvabāndhavān |\nsvajanaṃ hi kathaṃ hatvā sukhinaḥ syāma mādhava ||", transliteration: "tasmān nārhā vayaṁ hantuṁ dhārtarāṣhṭrān sa-bāndhavān\nsva-janaṁ hi kathaṁ hatvā sukhinaḥ syāma mādhava", translation_en: "Therefore, we should not kill the sons of Dhritarashtra, our relatives; for how can we be happy by killing our own kin, O Madhava (Krishna)?", translation_hi: "हे माधव  !  इसलिये अपने बान्धव धृतराष्ट्र के पुत्रों को मारना हमारे लिए योग्य नहीं है,  क्योंकि स्वजनों को मारकर हम कैसे सुखी होंगे।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_037.mp3"},
  {id: "BG_1.38", label: "BG 1.38", ref: "1.38", chapter: 1, verse: 38, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "यद्यप्येते न पश्यन्ति लोभोपहतचेतसः", snippet: "Though they, with intelligence overpowered by greed, see no evil in the destruction of families and no sin in hostility to friends,", sanskrit: "यद्यप्येते न पश्यन्ति लोभोपहतचेतसः ।\nकुलक्षयकृतं दोषं मित्रद्रोहे च पातकम् ॥", iast: "yadyapyete na paśyanti lobhopahatacetasaḥ |\nkulakṣayakṛtaṃ doṣaṃ mitradrohe ca pātakam ||", transliteration: "yady apy ete na paśhyanti lobhopahata-chetasaḥ\nkula-kṣhaya-kṛitaṁ doṣhaṁ mitra-drohe cha pātakam", translation_en: "Though they, with intelligence overpowered by greed, see no evil in the destruction of families and no sin in hostility to friends,", translation_hi: "यद्यपि लोभ से भ्रष्टचित्त हुये ये लोग कुलनाशकृत दोष और मित्र द्रोह में पाप नहीं देखते हैं।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_038.mp3"},
  {id: "BG_1.39", label: "BG 1.39", ref: "1.39", chapter: 1, verse: 39, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "कथं न ज्ञेयमस्माभिः पापादस्मान्निवर्तितुम्", snippet: "Why should we not, who clearly see the evil in the destruction of families, learn to turn away from this sin, O Janardana (Krishna)?", sanskrit: "कथं न ज्ञेयमस्माभिः पापादस्मान्निवर्तितुम् ।\nकुलक्षयकृतं दोषं प्रपश्यद्भिर्जनार्दन ॥", iast: "kathaṃ na jñeyamasmābhiḥ pāpādasmānnivartitum |\nkulakṣayakṛtaṃ doṣaṃ prapaśyadbhirjanārdana ||", transliteration: "kathaṁ na jñeyam asmābhiḥ pāpād asmān nivartitum\nkula-kṣhaya-kṛitaṁ doṣhaṁ prapaśhyadbhir janārdana", translation_en: "Why should we not, who clearly see the evil in the destruction of families, learn to turn away from this sin, O Janardana (Krishna)?", translation_hi: "परन्तु,  हेे जनार्दन !  कुलक्षय से होने वाले दोष को जानने वाले हम लोगों को इस पाप से विरत होने के लिए क्यों नहीं सोचना चाहिये।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_039.mp3"},
  {id: "BG_1.40", label: "BG 1.40", ref: "1.40", chapter: 1, verse: 40, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "कुलक्षये प्रणश्यन्ति कुलधर्माः सनातनाः", snippet: "In the destruction of a family, the immemorial religious rites of that family perish; on the destruction of spirituality, impiety indeed, overwhelms the whole family.", sanskrit: "कुलक्षये प्रणश्यन्ति कुलधर्माः सनातनाः ।\nधर्मे नष्टे कुलं कृत्स्नमधर्मोऽभिभवत्युत ॥", iast: "kulakṣaye praṇaśyanti kuladharmāḥ sanātanāḥ |\ndharme naṣṭe kulaṃ kṛtsnamadharmo’bhibhavatyuta ||", transliteration: "kula-kṣhaye praṇaśhyanti kula-dharmāḥ sanātanāḥ\ndharme naṣhṭe kulaṁ kṛitsnam adharmo ’bhibhavaty uta", translation_en: "In the destruction of a family, the immemorial religious rites of that family perish; on the destruction of spirituality, impiety indeed, overwhelms the whole family.", translation_hi: "कुल के नष्ट होने से सनातन धर्म नष्ट हो जाते हैं। धर्म नष्ट होने पर सम्पूर्ण कुल को अधर्म (पाप) दबा लेता है।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_040.mp3"},
  {id: "BG_1.41", label: "BG 1.41", ref: "1.41", chapter: 1, verse: 41, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "अधर्माभिभवात्कृष्ण प्रदुष्यन्ति कुलस्त्रियः", snippet: "O Krishna, by the prevalence of impiety, the women of the family become corrupt; and, when women are corrupted, O Varshenya (descendant of Vrishni), intermingling of castes arises.", sanskrit: "अधर्माभिभवात्कृष्ण प्रदुष्यन्ति कुलस्त्रियः ।\nस्त्रीषु दुष्टासु वार्ष्णेय जायते वर्णसङ्करः ॥", iast: "adharmābhibhavātkṛṣṇa praduṣyanti kulastriyaḥ |\nstrīṣu duṣṭāsu vārṣṇeya jāyate varṇasaṅkaraḥ ||", transliteration: "adharmābhibhavāt kṛiṣhṇa praduṣhyanti kula-striyaḥ\nstrīṣhu duṣhṭāsu vārṣhṇeya jāyate varṇa-saṅkaraḥ", translation_en: "O Krishna, by the prevalence of impiety, the women of the family become corrupt; and, when women are corrupted, O Varshenya (descendant of Vrishni), intermingling of castes arises.", translation_hi: "हे कृष्ण ! पाप के अधिक बढ़ जाने से कुल की स्त्रियां दूषित हो जाती हैं,  और हे वार्ष्णेय ! स्त्रियों के दूषित होने पर वर्णसंकर उत्पन्न होता है।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_041.mp3"},
  {id: "BG_1.42", label: "BG 1.42", ref: "1.42", chapter: 1, verse: 42, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "सङ्करो नरकायैव कुलघ्नानां कुलस्य च", snippet: "Confusion of castes leads to hell for the slayers of the family, for their forebears fall, deprived of the offerings of rice-balls and libations of water.", sanskrit: "सङ्करो नरकायैव कुलघ्नानां कुलस्य च ।\nपतन्ति पितरो ह्येषां लुप्तपिण्डोदकक्रियाः ॥", iast: "saṅkaro narakāyaiva kulaghnānāṃ kulasya ca |\npatanti pitaro hyeṣāṃ luptapiṇḍodakakriyāḥ ||", transliteration: "saṅkaro narakāyaiva kula-ghnānāṁ kulasya cha\npatanti pitaro hy eṣhāṁ lupta-piṇḍodaka-kriyāḥ", translation_en: "Confusion of castes leads to hell for the slayers of the family, for their forebears fall, deprived of the offerings of rice-balls and libations of water.", translation_hi: "वह वर्णसंकर कुलघातियों को और कुल को नरक में ले जाने का कारण बनता है। पिण्ड और जलदान की क्रिया से वंचित इनके पितर भी नरक में गिर जाते हैं।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_042.mp3"},
  {id: "BG_1.43", label: "BG 1.43", ref: "1.43", chapter: 1, verse: 43, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "दोषैरेतैः कुलघ्नानां वर्णसङ्करकारकैः", snippet: "By these evil deeds of the destroyers of the family, which cause confusion of castes, the eternal religious rites of the caste and the family are destroyed.", sanskrit: "दोषैरेतैः कुलघ्नानां वर्णसङ्करकारकैः ।\nउत्साद्यन्ते जातिधर्माः कुलधर्माश्च शाश्वताः ॥", iast: "doṣairetaiḥ kulaghnānāṃ varṇasaṅkarakārakaiḥ |\nutsādyante jātidharmāḥ kuladharmāśca śāśvatāḥ ||", transliteration: "doṣhair etaiḥ kula-ghnānāṁ varṇa-saṅkara-kārakaiḥ\nutsādyante jāti-dharmāḥ kula-dharmāśh cha śhāśhvatāḥ", translation_en: "By these evil deeds of the destroyers of the family, which cause confusion of castes, the eternal religious rites of the caste and the family are destroyed.", translation_hi: "इन वर्णसंकर कारक दोषों से कुलघाती दोषों से सनातन कुलधर्म और जातिधर्म नष्ट हो जाते हैं।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_043.mp3"},
  {id: "BG_1.44", label: "BG 1.44", ref: "1.44", chapter: 1, verse: 44, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "उत्सन्नकुलधर्माणां मनुष्याणां जनार्दन", snippet: "We have heard, O Janardana, that those men in whose families the religious practices have been destroyed are inevitably destined to dwell in hell for an unknown period.", sanskrit: "उत्सन्नकुलधर्माणां मनुष्याणां जनार्दन ।\nनरकेऽनियतं वासो भवतीत्यनुशुश्रुम ॥", iast: "utsannakuladharmāṇāṃ manuṣyāṇāṃ janārdana |\nnarake’niyataṃ vāso bhavatītyanuśuśruma ||", transliteration: "utsanna-kula-dharmāṇāṁ manuṣhyāṇāṁ janārdana\nnarake ‘niyataṁ vāso bhavatītyanuśhuśhruma", translation_en: "We have heard, O Janardana, that those men in whose families the religious practices have been destroyed are inevitably destined to dwell in hell for an unknown period.", translation_hi: "हे जनार्दन !  हमने सुना है कि जिनके यहां कुल धर्म नष्ट हो जाता है,  उन मनुष्यों का अनियत काल तक नरक में वास होता है।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_044.mp3"},
  {id: "BG_1.45", label: "BG 1.45", ref: "1.45", chapter: 1, verse: 45, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "अहो बत महत्पापं कर्तुं व्यवसिता वयम्", snippet: "Alas! We are involved in a great sin, for we are prepared to kill our kinsmen, out of greed for the pleasures of a kingdom.", sanskrit: "अहो बत महत्पापं कर्तुं व्यवसिता वयम् ।\nयद्राज्यसुखलोभेन हन्तुं स्वजनमुद्यताः ॥", iast: "aho bata mahatpāpaṃ kartuṃ vyavasitā vayam |\nyadrājyasukhalobhena hantuṃ svajanamudyatāḥ ||", transliteration: "aho bata mahat pāpaṁ kartuṁ vyavasitā vayam\nyad rājya-sukha-lobhena hantuṁ sva-janam udyatāḥ", translation_en: "Alas! We are involved in a great sin, for we are prepared to kill our kinsmen, out of greed for the pleasures of a kingdom.", translation_hi: "अहो  !  शोक है कि हम लोग बड़ा भारी पाप करने का निश्चय कर बैठे हैं,  जो कि इस राज्यसुख के लोभ से अपने कुटुम्ब का नाश करने के लिये तैयार हो गये हैं।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_045.mp3"},
  {id: "BG_1.46", label: "BG 1.46", ref: "1.46", chapter: 1, verse: 46, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "यदि मामप्रतीकारमशस्त्रं शस्त्रपाणयः", snippet: "If the sons of Dhritarashtra, with weapons in hand, should slay me in battle, unresisting and unarmed, that would be better for me.", sanskrit: "यदि मामप्रतीकारमशस्त्रं शस्त्रपाणयः ।\nधार्तराष्ट्रा रणे हन्युस्तन्मे क्षेमतरं भवेत् ॥", iast: "yadi māmapratīkāramaśastraṃ śastrapāṇayaḥ |\ndhārtarāṣṭrā raṇe hanyustanme kṣemataraṃ bhavet ||", transliteration: "yadi mām apratīkāram aśhastraṁ śhastra-pāṇayaḥ\ndhārtarāṣhṭrā raṇe hanyus tan me kṣhemataraṁ bhavet", translation_en: "If the sons of Dhritarashtra, with weapons in hand, should slay me in battle, unresisting and unarmed, that would be better for me.", translation_hi: "यदि मुझ शस्त्ररहित और प्रतिकार न करने वाले को ये शस्त्रधारी कौरव रण में मारें,  तो भी वह मेरे लिये कल्याणकारक होगा।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_046.mp3"},
  {id: "BG_1.47", label: "BG 1.47", ref: "1.47", chapter: 1, verse: 47, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "एवमुक्त्वाऽर्जुनः संख्ये रथोपस्थ उपाविशत्", snippet: "Sanjaya said, Having thus spoken in the midst of the battlefield, Arjuna cast away his bow and arrow and, his mind overwhelmed with sorrow, sat down on the seat of the chariot.", sanskrit: "एवमुक्त्वाऽर्जुनः संख्ये रथोपस्थ उपाविशत् ।\nविसृज्य सशरं चापं शोकसंविग्नमानसः ॥", iast: "evamuktvā’rjunaḥ saṃkhye rathopastha upāviśat |\nvisṛjya saśaraṃ cāpaṃ śokasaṃvignamānasaḥ ||", transliteration: "evam uktvārjunaḥ saṅkhye rathopastha upāviśhat\nvisṛijya sa-śharaṁ chāpaṁ śhoka-saṁvigna-mānasaḥ", translation_en: "Sanjaya said, Having thus spoken in the midst of the battlefield, Arjuna cast away his bow and arrow and, his mind overwhelmed with sorrow, sat down on the seat of the chariot.", translation_hi: "संजय ने कहा  --  रणभूमि (संख्ये) में शोक से उद्विग्न मनवाला अर्जुन इस प्रकार कहकर बाणसहित धनुष को त्याग कर रथ के पिछले भाग में बैठ गया।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/001_047.mp3"},
  {id: "BG_2.1", label: "BG 2.1", ref: "2.1", chapter: 2, verse: 1, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "तं तथा कृपयाऽविष्टमश्रुपूर्णाकुलेक्षणम्", snippet: "Sanjaya said: To him, who was thus overcome with pity, despondent, with eyes full of tears and agitated, Madhusudana (the destroyer of Madhu) or Krishna spoke these words.", sanskrit: "तं तथा कृपयाऽविष्टमश्रुपूर्णाकुलेक्षणम् ।\nविषीदन्तमिदं वाक्यमुवाच मधुसूदनः ॥", iast: "taṃ tathā kṛpayā’viṣṭamaśrupūrṇākulekṣaṇam |\nviṣīdantamidaṃ vākyamuvāca madhusūdanaḥ ||", transliteration: "taṁ tathā kṛipayāviṣhṭamaśhru pūrṇākulekṣhaṇam\nviṣhīdantamidaṁ vākyam uvācha madhusūdanaḥ", translation_en: "Sanjaya said: To him, who was thus overcome with pity, despondent, with eyes full of tears and agitated, Madhusudana (the destroyer of Madhu) or Krishna spoke these words.", translation_hi: "संजय ने कहा -- इस प्रकार करुणा और विषाद से अभिभूत,  अश्रुपूरित नेत्रों वाले आकुल अर्जुन से मधुसूदन ने यह वाक्य कहा।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_001.mp3"},
  {id: "BG_2.2", label: "BG 2.2", ref: "2.2", chapter: 2, verse: 2, speaker: "krishna", canonical: true, meter: "anustubh", sa: "कुतस्त्वा कश्मलमिदं विषमे समुपस्थितम्", snippet: "The Blessed Lord said, \"From whence has this perilous strait come upon you, this dejection which is unworthy of you, disgraceful, and which will close the gates of heaven upon…", sanskrit: "कुतस्त्वा कश्मलमिदं विषमे समुपस्थितम् ।\nअनार्यजुष्टमस्वर्ग्यमकीर्तिकरमर्जुन ॥", iast: "kutastvā kaśmalamidaṃ viṣame samupasthitam |\nanāryajuṣṭamasvargyamakīrtikaramarjuna ||", transliteration: "kutastvā kaśhmalamidaṁ viṣhame samupasthitam\nanārya-juṣhṭamaswargyam akīrti-karam arjuna", translation_en: "The Blessed Lord said, \"From whence has this perilous strait come upon you, this dejection which is unworthy of you, disgraceful, and which will close the gates of heaven upon you, O Arjuna?\"", translation_hi: "श्री भगवान् ने कहा -- हे अर्जुन ! तुमको इस विषम स्थल में यह मोह कहाँ से उत्पन्न हुआ?  यह आर्य आचरण के विपरीत न तो स्वर्ग प्राप्ति का साधन ही है और न कीर्ति कराने वाला ही है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_002.mp3"},
  {id: "BG_2.3", label: "BG 2.3", ref: "2.3", chapter: 2, verse: 3, speaker: "krishna", canonical: true, meter: "anustubh", sa: "क्लैब्यं मा स्म गमः पार्थ नैतत्त्वय्युपपद्यते", snippet: "Do not yield to impotence, O Arjuna, son of Pritha. It does not befit you. Cast off this mean weakness of the heart! Stand up, O conqueror of foes!", sanskrit: "क्लैब्यं मा स्म गमः पार्थ नैतत्त्वय्युपपद्यते ।\nक्षुद्रं हृदयदौर्बल्यं त्यक्त्वोत्तिष्ठ परन्तप ॥", iast: "klaibyaṃ mā sma gamaḥ pārtha naitattvayyupapadyate |\nkṣudraṃ hṛdayadaurbalyaṃ tyaktvottiṣṭha parantapa ||", transliteration: "klaibyaṁ mā sma gamaḥ pārtha naitat tvayyupapadyate\nkṣhudraṁ hṛidaya-daurbalyaṁ tyaktvottiṣhṭha parantapa", translation_en: "Do not yield to impotence, O Arjuna, son of Pritha. It does not befit you. Cast off this mean weakness of the heart! Stand up, O conqueror of foes!", translation_hi: "हे पार्थ क्लीव (कायर) मत बनो। यह तुम्हारे लिये अशोभनीय है, हे ! परंतप हृदय की क्षुद्र दुर्बलता को त्यागकर खड़े हो जाओ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_003.mp3"},
  {id: "BG_2.4", label: "BG 2.4", ref: "2.4", chapter: 2, verse: 4, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "कथं भीष्ममहं संख्ये द्रोणं च मधुसूदन", snippet: "Arjuna said, \"O Madhusudana, how can I fight in battle with arrows against Bhishma and Drona, who are worthy of being worshipped, O destroyer of enemies?\"", sanskrit: "कथं भीष्ममहं संख्ये द्रोणं च मधुसूदन ।\nइषुभिः प्रतियोत्स्यामि पूजार्हावरिसूदन ॥", iast: "kathaṃ bhīṣmamahaṃ saṃkhye droṇaṃ ca madhusūdana |\niṣubhiḥ pratiyotsyāmi pūjārhāvarisūdana ||", transliteration: "kathaṁ bhīṣhmam ahaṁ sankhye droṇaṁ cha madhusūdana\niṣhubhiḥ pratiyotsyāmi pūjārhāvari-sūdana", translation_en: "Arjuna said, \"O Madhusudana, how can I fight in battle with arrows against Bhishma and Drona, who are worthy of being worshipped, O destroyer of enemies?\"", translation_hi: "अर्जुन ने कहा -- हे मधुसूदन ! मैं रणभूमि में किस प्रकार भीष्म और द्रोण के साथ बाणों से युद्ध करूँगा। हे अरिसूदन, वे दोनों ही पूजनीय हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_004.mp3"},
  {id: "BG_2.5", label: "BG 2.5", ref: "2.5", chapter: 2, verse: 5, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "गुरूनहत्वा हि महानुभावान्", snippet: "Better it is, indeed, in this world to accept alms than to slay the most noble teachers. But if I were to kill them, even in this world, all my enjoyments of wealth and…", sanskrit: "गुरूनहत्वा हि महानुभावान्\nश्रेयो भोक्तुं भैक्ष्यमपीह लोके ।\nहत्वार्थकामांस्तु गुरूनिहैव\nभुञ्जीय भोगान् रुधिरप्रदिग्धान् ॥", iast: "gurūnahatvā hi mahānubhāvān\nśreyo bhoktuṃ bhaikṣyamapīha loke |\nhatvārthakāmāṃstu gurūnihaiva\nbhuñjīya bhogān rudhirapradigdhān ||", transliteration: "gurūnahatvā hi mahānubhāvān\nśhreyo bhoktuṁ bhaikṣhyamapīha loke\nhatvārtha-kāmāṁstu gurūnihaiva\nbhuñjīya bhogān rudhira-pradigdhān", translation_en: "Better it is, indeed, in this world to accept alms than to slay the most noble teachers. But if I were to kill them, even in this world, all my enjoyments of wealth and fulfilled desires would be stained with their blood.", translation_hi: "इन महानुभाव गुरुजनों को मारने से इस लोक में भिक्षा का अन्न भी ग्रहण करना अधिक कल्याण कारक है, क्योंकि गुरुजनों को मारकर मैं इस लोक में रक्तरंजित अर्थ और काम रूप भोगों को ही भोगूँगा।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_005.mp3"},
  {id: "BG_2.6", label: "BG 2.6", ref: "2.6", chapter: 2, verse: 6, speaker: "arjuna", canonical: true, meter: "tristubh-jagati", sa: "न चैतद्विद्मः कतरन्नो गरीयो", snippet: "I can hardly tell which would be better, that we should conquer them or that they should conquer us. Even the sons of Dhritarashtra, whom we do not wish to slay, stand facing us.", sanskrit: "न चैतद्विद्मः कतरन्नो गरीयो\nयद्वा जयेम यदि वा नो जयेयुः ।\nयानेव हत्वा न जिजीविषाम\nस्तेऽवस्थिताः प्रमुखे धार्तराष्ट्राः ॥", iast: "na caitadvidmaḥ kataranno garīyo\nyadvā jayema yadi vā no jayeyuḥ |\nyāneva hatvā na jijīviṣāma\nste’vasthitāḥ pramukhe dhārtarāṣṭrāḥ ||", transliteration: "na chaitadvidmaḥ kataranno garīyo\nyadvā jayema yadi vā no jayeyuḥ\nyāneva hatvā na jijīviṣhāmas\nte ’vasthitāḥ pramukhe dhārtarāṣhṭrāḥ", translation_en: "I can hardly tell which would be better, that we should conquer them or that they should conquer us. Even the sons of Dhritarashtra, whom we do not wish to slay, stand facing us.", translation_hi: "हम नहीं जानते कि हमें क्या करना उचित है। हम यह भी नहीं जानते कि हम जीतेंगे, या वे हमको जीतेंगे, जिनको मारकर हम जीवित नहीं रहना चाहते वे ही धृतराष्ट्र के पुत्र हमारे सामने युद्ध के लिए खड़े हैं।।", meter_name: "Upajāti (Triṣṭubh–Jagatī mixed)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_006.mp3"},
  {id: "BG_2.7", label: "BG 2.7", ref: "2.7", chapter: 2, verse: 7, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "कार्पण्यदोषोपहतस्वभावः", snippet: "My heart is overpowered by the taint of pity; my mind is confused as to my duty. I ask Thee: Tell me decisively what is good for me. I am Thy disciple; instruct me, who has…", sanskrit: "कार्पण्यदोषोपहतस्वभावः\nपृच्छामि त्वां धर्मसंमूढचेताः ।\nयच्छ्रेयः स्यान्निश्चितं ब्रूहि तन्मे\nशिष्यस्तेऽहं शाधि मां त्वां प्रपन्नम् ॥", iast: "kārpaṇyadoṣopahatasvabhāvaḥ\npṛcchāmi tvāṃ dharmasaṃmūḍhacetāḥ |\nyacchreyaḥ syānniścitaṃ brūhi tanme\nśiṣyaste’haṃ śādhi māṃ tvāṃ prapannam ||", transliteration: "kārpaṇya-doṣhopahata-svabhāvaḥ\npṛichchhāmi tvāṁ dharma-sammūḍha-chetāḥ\nyach-chhreyaḥ syānniśhchitaṁ brūhi tanme\nśhiṣhyaste ’haṁ śhādhi māṁ tvāṁ prapannam", translation_en: "My heart is overpowered by the taint of pity; my mind is confused as to my duty. I ask Thee: Tell me decisively what is good for me. I am Thy disciple; instruct me, who has taken refuge in Thee.", translation_hi: "करुणा के कलुष से अभिभूत और कर्तव्यपथ पर संभ्रमित हुआ मैं आपसे पूछता हूँ, कि मेरे लिये जो श्रेयष्कर हो, उसे आप निश्चय करके कहिये, क्योंकि मैं आपका शिष्य हूँ; शरण में आये मुझको आप उपदेश दीजिये।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_007.mp3"},
  {id: "BG_2.8", label: "BG 2.8", ref: "2.8", chapter: 2, verse: 8, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "न हि प्रपश्यामि ममापनुद्या", snippet: "I do not see that this sorrow that burns up my senses would be removed, even if I were to attain prosperous and unrivaled dominion on earth or lordship over the gods.", sanskrit: "न हि प्रपश्यामि ममापनुद्या\nद्यच्छोकमुच्छोषणमिन्द्रियाणाम् ।\nअवाप्य भूमावसपत्नमृद्धम्\nराज्यं सुराणामपि चाधिपत्यम् ॥", iast: "na hi prapaśyāmi mamāpanudyā\ndyacchokamucchoṣaṇamindriyāṇām |\navāpya bhūmāvasapatnamṛddham\nrājyaṃ surāṇāmapi cādhipatyam ||", transliteration: "na hi prapaśhyāmi mamāpanudyād\nyach-chhokam uchchhoṣhaṇam-indriyāṇām\navāpya bhūmāv-asapatnamṛiddhaṁ\nrājyaṁ surāṇāmapi chādhipatyam", translation_en: "I do not see that this sorrow that burns up my senses would be removed, even if I were to attain prosperous and unrivaled dominion on earth or lordship over the gods.", translation_hi: "पृथ्वी पर निष्कण्टक समृद्ध राज्य को और देवताओं के स्वामित्व को प्राप्त होकर भी मैं उस उपाय को नहीं देखता हूँ, जो मेरी इन्द्रियों को सुखाने वाले इस शोक को दूर कर सके।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_008.mp3"},
  {id: "BG_2.9", label: "BG 2.9", ref: "2.9", chapter: 2, verse: 9, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "एवमुक्त्वा हृषीकेशं गुडाकेशः परन्तप", snippet: "Sanjaya said: Having spoken thus to Hrishikesha, the Lord of the senses, Arjuna, the conqueror of sleep and destroyer of foes, said, \"I will not fight,\" and became silent.", sanskrit: "एवमुक्त्वा हृषीकेशं गुडाकेशः परन्तप ।\nन योत्स्य इति गोविन्दमुक्त्वा तूष्णीं बभूव ह ॥", iast: "evamuktvā hṛṣīkeśaṃ guḍākeśaḥ parantapa |\nna yotsya iti govindamuktvā tūṣṇīṃ babhūva ha ||", transliteration: "evam-uktvā hṛiṣhīkeśhaṁ guḍākeśhaḥ parantapa\nna yotsya iti govindam uktvā tūṣhṇīṁ babhūva ha", translation_en: "Sanjaya said: Having spoken thus to Hrishikesha, the Lord of the senses, Arjuna, the conqueror of sleep and destroyer of foes, said, \"I will not fight,\" and became silent.", translation_hi: "संजय ने कहा -- इस प्रकार गुडाकेश परंतप अर्जुन भगवान् हृषीकेश से यह कहकर कि हे गोविन्द \"मैं युद्ध नहीं करूँगा\" चुप हो गया।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_009.mp3"},
  {id: "BG_2.10", label: "BG 2.10", ref: "2.10", chapter: 2, verse: 10, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "तमुवाच हृषीकेशः प्रहसन्निव भारत", snippet: "To him who was despondent in the midst of the two armies, Krishna, smiling, O Bharata, spoke these words.", sanskrit: "तमुवाच हृषीकेशः प्रहसन्निव भारत ।\nसेनयोरुभयोर्मध्ये विषीदन्तमिदं वचः ॥", iast: "tamuvāca hṛṣīkeśaḥ prahasanniva bhārata |\nsenayorubhayormadhye viṣīdantamidaṃ vacaḥ ||", transliteration: "tam-uvācha hṛiṣhīkeśhaḥ prahasanniva bhārata\nsenayorubhayor-madhye viṣhīdantam-idaṁ vachaḥ", translation_en: "To him who was despondent in the midst of the two armies, Krishna, smiling, O Bharata, spoke these words.", translation_hi: "हे भारत (धृतराष्ट्र) ! दोनों सेनाओं के बीच में उस शोकमग्न अर्जुन को भगवान् हृषीकेश ने हँसते हुए से यह वचन कहे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_010.mp3"},
  {id: "BG_2.11", label: "BG 2.11", ref: "2.11", chapter: 2, verse: 11, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अशोच्यानन्वशोचस्त्वं प्रज्ञावादांश्च भाषसे", snippet: "The Blessed Lord said, \"You have grieved for those who should not be grieved for; yet, you speak words of wisdom. The wise grieve neither for the living nor for the dead.\"", sanskrit: "अशोच्यानन्वशोचस्त्वं प्रज्ञावादांश्च भाषसे ।\nगतासूनगतासूंश्च नानुशोचन्ति पण्डिताः ॥", iast: "aśocyānanvaśocastvaṃ prajñāvādāṃśca bhāṣase |\ngatāsūnagatāsūṃśca nānuśocanti paṇḍitāḥ ||", transliteration: "aśhochyān-anvaśhochas-tvaṁ prajñā-vādānśh cha bhāṣhase\ngatāsūn-agatāsūnśh-cha nānuśhochanti paṇḍitāḥ", translation_en: "The Blessed Lord said, \"You have grieved for those who should not be grieved for; yet, you speak words of wisdom. The wise grieve neither for the living nor for the dead.\"", translation_hi: "श्री भगवान् ने कहा -- (अशोच्यान्) जिनके लिये शोक करना उचित नहीं है, उनके लिये तुम शोक करते हो और ज्ञानियों के से वचनों को कहते हो, परन्तु ज्ञानी पुरुष मृत (गतासून्) और जीवित (अगतासून्) दोनों के लिये शोक नहीं करते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_011.mp3"},
  {id: "BG_2.12", label: "BG 2.12", ref: "2.12", chapter: 2, verse: 12, speaker: "krishna", canonical: true, meter: "anustubh", sa: "न त्वेवाहं जातु नासं न त्वं नेमे जनाधिपाः", snippet: "Nor, at any time, was I not, nor thou, nor these rulers of men; nor, verily, shall we ever cease to be hereafter.", sanskrit: "न त्वेवाहं जातु नासं न त्वं नेमे जनाधिपाः ।\nन चैव न भविष्यामः सर्वे वयमतः परम् ॥", iast: "na tvevāhaṃ jātu nāsaṃ na tvaṃ neme janādhipāḥ |\nna caiva na bhaviṣyāmaḥ sarve vayamataḥ param ||", transliteration: "na tvevāhaṁ jātu nāsaṁ na tvaṁ neme janādhipāḥ\nna chaiva na bhaviṣhyāmaḥ sarve vayamataḥ param", translation_en: "Nor, at any time, was I not, nor thou, nor these rulers of men; nor, verily, shall we ever cease to be hereafter.", translation_hi: "वास्तव में न तो ऐसा ही है कि मैं किसी काल में नहीं था अथवा तुम नहीं थे अथवा ये राजालोग नहीं थे और न ऐसा ही है कि इससे आगे हम सब नहीं रहेंगे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_012.mp3"},
  {id: "BG_2.13", label: "BG 2.13", ref: "2.13", chapter: 2, verse: 13, speaker: "krishna", canonical: true, meter: "anustubh", sa: "देहिनोऽस्मिन्यथा देहे कौमारं यौवनं जरा", snippet: "Just as the embodied soul passes through childhood, youth, and old age in this body, so too does it pass into another body; the steadfast one does not grieve over this.", sanskrit: "देहिनोऽस्मिन्यथा देहे कौमारं यौवनं जरा ।\nतथा देहान्तरप्राप्तिर्धीरस्तत्र न मुह्यति ॥", iast: "dehino’sminyathā dehe kaumāraṃ yauvanaṃ jarā |\ntathā dehāntaraprāptirdhīrastatra na muhyati ||", transliteration: "dehino ’smin yathā dehe kaumāraṁ yauvanaṁ jarā\ntathā dehāntara-prāptir dhīras tatra na muhyati", translation_en: "Just as the embodied soul passes through childhood, youth, and old age in this body, so too does it pass into another body; the steadfast one does not grieve over this.", translation_hi: "जैसे इस देह में देही जीवात्मा की कुमार, युवा और वृद्धावस्था होती है, वैसे ही उसको अन्य शरीर की प्राप्ति होती है;  धीर पुरुष इसमें मोहित नहीं होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_013.mp3"},
  {id: "BG_2.14", label: "BG 2.14", ref: "2.14", chapter: 2, verse: 14, speaker: "krishna", canonical: true, meter: "anustubh", sa: "मात्रास्पर्शास्तु कौन्तेय शीतोष्णसुखदुःखदाः", snippet: "The contact of the senses with the objects, O son of Kunti, which causes heat and cold, pleasure and pain, has a beginning and an end; they are impermanent; endure them…", sanskrit: "मात्रास्पर्शास्तु कौन्तेय शीतोष्णसुखदुःखदाः ।\nआगमापायिनोऽनित्यास्तांस्तितिक्षस्व भारत ॥", iast: "mātrāsparśāstu kaunteya śītoṣṇasukhaduḥkhadāḥ |\nāgamāpāyino’nityāstāṃstitikṣasva bhārata ||", transliteration: "mātrā-sparśhās tu kaunteya śhītoṣhṇa-sukha-duḥkha-dāḥ\nāgamāpāyino ’nityās tans-titikṣhasva bhārata", translation_en: "The contact of the senses with the objects, O son of Kunti, which causes heat and cold, pleasure and pain, has a beginning and an end; they are impermanent; endure them bravely, O Arjuna.", translation_hi: "हे कुन्तीपुत्र ! शीत और उष्ण और सुख दुख को देने वाले इन्द्रिय और विषयों के संयोग का प्रारम्भ और अन्त होता है;  वे अनित्य हैं,  इसलिए,  हे भारत ! उनको तुम सहन करो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_014.mp3"},
  {id: "BG_2.15", label: "BG 2.15", ref: "2.15", chapter: 2, verse: 15, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यं हि न व्यथयन्त्येते पुरुषं पुरुषर्षभ", snippet: "That firm man, whom surely these afflictions do not, O chief among men, to whom pleasure and pain are the same, is fit for attaining immortality.", sanskrit: "यं हि न व्यथयन्त्येते पुरुषं पुरुषर्षभ ।\nसमदुःखसुखं धीरं सोऽमृतत्वाय कल्पते ॥", iast: "yaṃ hi na vyathayantyete puruṣaṃ puruṣarṣabha |\nsamaduḥkhasukhaṃ dhīraṃ so’mṛtatvāya kalpate ||", transliteration: "yaṁ hi na vyathayantyete puruṣhaṁ puruṣharṣhabha\nsama-duḥkha-sukhaṁ dhīraṁ so ’mṛitatvāya kalpate", translation_en: "That firm man, whom surely these afflictions do not, O chief among men, to whom pleasure and pain are the same, is fit for attaining immortality.", translation_hi: "हे पुरुषश्रेष्ठ ! दुख और सुख में समान भाव से रहने वाले जिस धीर पुरुष को ये व्यथित नहीं कर सकते हैं वह अमृतत्व (मोक्ष) का अधिकारी होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_015.mp3"},
  {id: "BG_2.16", label: "BG 2.16", ref: "2.16", chapter: 2, verse: 16, speaker: "krishna", canonical: true, meter: "anustubh", sa: "नासतो विद्यते भावो नाभावो विद्यते सतः", snippet: "The unreal has no being; there is no non-being of the real; the truth about both has been seen by the knowers of the truth (or the seers of the essence).", sanskrit: "नासतो विद्यते भावो नाभावो विद्यते सतः ।\nउभयोरपि दृष्टोऽन्तस्त्वनयोस्तत्त्वदर्शिभिः ॥", iast: "nāsato vidyate bhāvo nābhāvo vidyate sataḥ |\nubhayorapi dṛṣṭo’ntastvanayostattvadarśibhiḥ ||", transliteration: "nāsato vidyate bhāvo nābhāvo vidyate sataḥ\nubhayorapi dṛiṣhṭo ’nta stvanayos tattva-darśhibhiḥ", translation_en: "The unreal has no being; there is no non-being of the real; the truth about both has been seen by the knowers of the truth (or the seers of the essence).", translation_hi: "असत् वस्तु का तो अस्तित्व नहीं है और सत् का कभी अभाव नहीं है। इस प्रकार इन दोनों का ही तत्त्व,  तत्त्वदर्शी ज्ञानी पुरुषों के द्वारा देखा गया है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_016.mp3"},
  {id: "BG_2.17", label: "BG 2.17", ref: "2.17", chapter: 2, verse: 17, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अविनाशि तु तद्विद्धि येन सर्वमिदं ततम्", snippet: "Know that to be indestructible, by which all this is pervaded. No one can cause the destruction of that, the Imperishable.", sanskrit: "अविनाशि तु तद्विद्धि येन सर्वमिदं ततम् ।\nविनाशमव्ययस्यास्य न कश्चित् कर्तुमर्हति ॥", iast: "avināśi tu tadviddhi yena sarvamidaṃ tatam |\nvināśamavyayasyāsya na kaścit kartumarhati ||", transliteration: "avināśhi tu tadviddhi yena sarvam idaṁ tatam\nvināśham avyayasyāsya na kaśhchit kartum arhati", translation_en: "Know that to be indestructible, by which all this is pervaded. No one can cause the destruction of that, the Imperishable.", translation_hi: "उस वस्तु को तुम अविनाशी जानों,  जिससे यह सम्पूर्ण जगत् व्याप्त है। इस अव्यय का नाश करने में कोई भी समर्थ नहीं है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_017.mp3"},
  {id: "BG_2.18", label: "BG 2.18", ref: "2.18", chapter: 2, verse: 18, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अन्तवन्त इमे देहा नित्यस्योक्ताः शरीरिणः", snippet: "These bodies of the embodied Self, which are eternal, indestructible, and immeasurable, are said to have an end. Therefore, fight, O Arjuna.", sanskrit: "अन्तवन्त इमे देहा नित्यस्योक्ताः शरीरिणः ।\nअनाशिनोऽप्रमेयस्य तस्माद्युध्यस्व भारत ॥", iast: "antavanta ime dehā nityasyoktāḥ śarīriṇaḥ |\nanāśino’prameyasya tasmādyudhyasva bhārata ||", transliteration: "antavanta ime dehā nityasyoktāḥ śharīriṇaḥ\nanāśhino ’prameyasya tasmād yudhyasva bhārata", translation_en: "These bodies of the embodied Self, which are eternal, indestructible, and immeasurable, are said to have an end. Therefore, fight, O Arjuna.", translation_hi: "इस नाशरहित अप्रमेय नित्य देही आत्मा के ये सब शरीर नाशवान् कहे गये हैं। इसलिये हे भारत ! तुम युद्ध करो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_018.mp3"},
  {id: "BG_2.19", label: "BG 2.19", ref: "2.19", chapter: 2, verse: 19, speaker: "krishna", canonical: true, meter: "anustubh", sa: "य एनं वेत्ति हन्तारं यश्चैनं मन्यते हतम्", snippet: "He who takes the Self to be the slayer and he who thinks it is slain, neither of them knows. It does not slay, nor is it slain.", sanskrit: "य एनं वेत्ति हन्तारं यश्चैनं मन्यते हतम् ।\nउभौ तौ न विजानीतो नायं हन्ति न हन्यते ॥", iast: "ya enaṃ vetti hantāraṃ yaścainaṃ manyate hatam |\nubhau tau na vijānīto nāyaṃ hanti na hanyate ||", transliteration: "ya enaṁ vetti hantāraṁ yaśh chainaṁ manyate hatam\nubhau tau na vijānīto nāyaṁ hanti na hanyate", translation_en: "He who takes the Self to be the slayer and he who thinks it is slain, neither of them knows. It does not slay, nor is it slain.", translation_hi: "जो इस आत्मा को मारने वाला समझता है और जो इसको मरा समझता है वे दोनों ही नहीं जानते हैं,  क्योंकि यह आत्मा न मरता है और न मारा जाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_019.mp3"},
  {id: "BG_2.20", label: "BG 2.20", ref: "2.20", chapter: 2, verse: 20, speaker: "krishna", canonical: true, meter: "tristubh", sa: "न जायते म्रियते वा कदाचि", snippet: "It is not born, nor does it ever die; after having been, it again does not cease to be; unborn, eternal, changeless, and ancient, it is not killed when the body is killed.", sanskrit: "न जायते म्रियते वा कदाचि\nन्नायं भूत्वा भविता वा न भूयः ।\nअजो नित्यः शाश्वतोऽयं पुराणो\nन हन्यते हन्यमाने शरीरे ॥", iast: "na jāyate mriyate vā kadāci\nnnāyaṃ bhūtvā bhavitā vā na bhūyaḥ |\najo nityaḥ śāśvato’yaṃ purāṇo\nna hanyate hanyamāne śarīre ||", transliteration: "na jāyate mriyate vā kadāchin\nnāyaṁ bhūtvā bhavitā vā na bhūyaḥ\najo nityaḥ śhāśhvato ’yaṁ purāṇo\nna hanyate hanyamāne śharīre", translation_en: "It is not born, nor does it ever die; after having been, it again does not cease to be; unborn, eternal, changeless, and ancient, it is not killed when the body is killed.", translation_hi: "यह आत्मा किसी काल में भी न जन्मता है और न मरता है और न यह एक बार होकर फिर अभावरूप होने वाला है। यह आत्मा अजन्मा, नित्य, शाश्वत और पुरातन है,  शरीर के नाश होने पर भी इसका नाश नहीं होता।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_020.mp3"},
  {id: "BG_2.21", label: "BG 2.21", ref: "2.21", chapter: 2, verse: 21, speaker: "krishna", canonical: true, meter: "anustubh", sa: "वेदाविनाशिनं नित्यं य एनमजमव्ययम्", snippet: "Whoever knows it to be indestructible, eternal, unborn, and inexhaustible, how can that person slay, O Arjuna, or cause to be slain?", sanskrit: "वेदाविनाशिनं नित्यं य एनमजमव्ययम् ।\nकथं स पुरुषः पार्थ कं घातयति हन्ति कम् ॥", iast: "vedāvināśinaṃ nityaṃ ya enamajamavyayam |\nkathaṃ sa puruṣaḥ pārtha kaṃ ghātayati hanti kam ||", transliteration: "vedāvināśhinaṁ nityaṁ ya enam ajam avyayam\nkathaṁ sa puruṣhaḥ pārtha kaṁ ghātayati hanti kam", translation_en: "Whoever knows it to be indestructible, eternal, unborn, and inexhaustible, how can that person slay, O Arjuna, or cause to be slain?", translation_hi: "हे पार्थ ! जो पुरुष इस आत्मा को अविनाशी,  नित्य और अव्ययस्वरूप जानता है,  वह कैसे किसको मरवायेगा और कैसे किसको मारेगा?", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_021.mp3"},
  {id: "BG_2.22", label: "BG 2.22", ref: "2.22", chapter: 2, verse: 22, speaker: "krishna", canonical: true, meter: "tristubh", sa: "वासांसि जीर्णानि यथा विहाय", snippet: "Just as a man casts off worn-out clothes and puts on new ones, so too the embodied Self casts off worn-out bodies and enters others that are new.", sanskrit: "वासांसि जीर्णानि यथा विहाय\nनवानि गृह्णाति नरोऽपराणि ।\nतथा शरीराणि विहाय जीर्णा\nन्यन्यानि संयाति नवानि देही ॥", iast: "vāsāṃsi jīrṇāni yathā vihāya\nnavāni gṛhṇāti naro’parāṇi |\ntathā śarīrāṇi vihāya jīrṇā\nnyanyāni saṃyāti navāni dehī ||", transliteration: "vāsānsi jīrṇāni yathā vihāya\nnavāni gṛihṇāti naro ’parāṇi\ntathā śharīrāṇi vihāya jīrṇānya\nnyāni sanyāti navāni dehī", translation_en: "Just as a man casts off worn-out clothes and puts on new ones, so too the embodied Self casts off worn-out bodies and enters others that are new.", translation_hi: "जैसे मनुष्य जीर्ण वस्त्रों को त्यागकर दूसरे नये वस्त्रों को धारण करता है, वैसे ही देही जीवात्मा पुराने शरीरों को त्याग कर दूसरे नए शरीरों को प्राप्त होता है।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_022.mp3"},
  {id: "BG_2.23", label: "BG 2.23", ref: "2.23", chapter: 2, verse: 23, speaker: "krishna", canonical: true, meter: "anustubh", sa: "नैनं छिन्दन्ति शस्त्राणि नैनं दहति पावकः", snippet: "Weapons cannot cut it, fire cannot burn it, water cannot wet it, wind cannot dry it.", sanskrit: "नैनं छिन्दन्ति शस्त्राणि नैनं दहति पावकः ।\nन चैनं क्लेदयन्त्यापो न शोषयति मारुतः ॥", iast: "nainaṃ chindanti śastrāṇi nainaṃ dahati pāvakaḥ |\nna cainaṃ kledayantyāpo na śoṣayati mārutaḥ ||", transliteration: "nainaṁ chhindanti śhastrāṇi nainaṁ dahati pāvakaḥ\nna chainaṁ kledayantyāpo na śhoṣhayati mārutaḥ", translation_en: "Weapons cannot cut it, fire cannot burn it, water cannot wet it, wind cannot dry it.", translation_hi: "इस आत्मा को शस्त्र काट नहीं सकते और न अग्नि इसे जला सकती है ; जल इसे गीला नहीं कर सकता और वायु इसे सुखा नहीं सकती।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_023.mp3"},
  {id: "BG_2.24", label: "BG 2.24", ref: "2.24", chapter: 2, verse: 24, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अच्छेद्योऽयमदाह्योऽयमक्लेद्योऽशोष्य एव च", snippet: "This Self cannot be cut, burned, wetted, nor dried up; it is eternal, all-pervasive, stable, immovable, and ancient.", sanskrit: "अच्छेद्योऽयमदाह्योऽयमक्लेद्योऽशोष्य एव च ।\nनित्यः सर्वगतः स्थाणुरचलोऽयं सनातनः ॥", iast: "acchedyo’yamadāhyo’yamakledyo’śoṣya eva ca |\nnityaḥ sarvagataḥ sthāṇuracalo’yaṃ sanātanaḥ ||", transliteration: "achchhedyo ’yam adāhyo ’yam akledyo ’śhoṣhya eva cha\nnityaḥ sarva-gataḥ sthāṇur achalo ’yaṁ sanātanaḥ", translation_en: "This Self cannot be cut, burned, wetted, nor dried up; it is eternal, all-pervasive, stable, immovable, and ancient.", translation_hi: "क्योंकि यह आत्मा अच्छेद्य (काटी नहीं जा सकती),  अदाह्य (जलाई नहीं जा सकती),  अक्लेद्य (गीली नहीं हो सकती ) और अशोष्य (सुखाई नहीं जा सकती) है;  यह नित्य,  सर्वगत,  स्थाणु (स्थिर),  अचल और सनातन है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_024.mp3"},
  {id: "BG_2.25", label: "BG 2.25", ref: "2.25", chapter: 2, verse: 25, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अव्यक्तोऽयमचिन्त्योऽयमविकार्योऽयमुच्यते", snippet: "This Self is said to be unmanifested, unthinkable, and unchangeable. Therefore, knowing this to be so, you should not grieve.", sanskrit: "अव्यक्तोऽयमचिन्त्योऽयमविकार्योऽयमुच्यते ।\nतस्मादेवं विदित्वैनं नानुशोचितुमर्हसि ॥", iast: "avyakto’yamacintyo’yamavikāryo’yamucyate |\ntasmādevaṃ viditvainaṃ nānuśocitumarhasi ||", transliteration: "avyakto ’yam achintyo ’yam avikāryo ’yam uchyate\ntasmādevaṁ viditvainaṁ nānuśhochitum arhasi", translation_en: "This Self is said to be unmanifested, unthinkable, and unchangeable. Therefore, knowing this to be so, you should not grieve.", translation_hi: "यह आत्मा अव्यक्त,  अचिन्त्य और अविकारी कहा जाता है;  इसलिए इसको इस प्रकार जानकर तुमको शोक करना उचित नहीं है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_025.mp3"},
  {id: "BG_2.26", label: "BG 2.26", ref: "2.26", chapter: 2, verse: 26, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अथ चैनं नित्यजातं नित्यं वा मन्यसे मृतम्", snippet: "But even if thou thinkest of It as constantly being born and constantly dying, even then, O mighty-armed one, thou shouldst not grieve.", sanskrit: "अथ चैनं नित्यजातं नित्यं वा मन्यसे मृतम् ।\nतथापि त्वं महाबाहो नैवं शोचितुमर्हसि ॥", iast: "atha cainaṃ nityajātaṃ nityaṃ vā manyase mṛtam |\ntathāpi tvaṃ mahābāho naivaṃ śocitumarhasi ||", transliteration: "atha chainaṁ nitya-jātaṁ nityaṁ vā manyase mṛitam\ntathāpi tvaṁ mahā-bāho naivaṁ śhochitum arhasi", translation_en: "But even if thou thinkest of It as constantly being born and constantly dying, even then, O mighty-armed one, thou shouldst not grieve.", translation_hi: "और यदि तुम आत्मा को नित्य जन्मने और नित्य मरने वाला मानो तो भी,  हे महाबाहो !  इस प्रकार शोक करना तुम्हारे लिए उचित नहीं है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_026.mp3"},
  {id: "BG_2.27", label: "BG 2.27", ref: "2.27", chapter: 2, verse: 27, speaker: "krishna", canonical: true, meter: "anustubh", sa: "जातस्य हि ध्रुवो मृत्युर्ध्रुवं जन्म मृतस्य च", snippet: "For the born, death is certain, and for the dead, birth is certain; therefore, you should not grieve over the inevitable.", sanskrit: "जातस्य हि ध्रुवो मृत्युर्ध्रुवं जन्म मृतस्य च ।\nतस्मादपरिहार्येऽर्थे न त्वं शोचितुमर्हसि ॥", iast: "jātasya hi dhruvo mṛtyurdhruvaṃ janma mṛtasya ca |\ntasmādaparihārye’rthe na tvaṃ śocitumarhasi ||", transliteration: "jātasya hi dhruvo mṛityur dhruvaṁ janma mṛitasya cha\ntasmād aparihārye ’rthe na tvaṁ śhochitum arhasi", translation_en: "For the born, death is certain, and for the dead, birth is certain; therefore, you should not grieve over the inevitable.", translation_hi: "जन्मने वाले की मृत्यु निश्चित है और मरने वाले का जन्म निश्चित है;  इसलिए जो अटल है अपरिहार्य - है उसके विषय में तुमको शोक नहीं करना चाहिये।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_027.mp3"},
  {id: "BG_2.28", label: "BG 2.28", ref: "2.28", chapter: 2, verse: 28, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अव्यक्तादीनि भूतानि व्यक्तमध्यानि भारत", snippet: "Beings are unmanifest in their beginning, manifest in their middle state, O Arjuna, and unmanifest again in their end. What is there to grieve about?", sanskrit: "अव्यक्तादीनि भूतानि व्यक्तमध्यानि भारत ।\nअव्यक्तनिधनान्येव तत्र का परिदेवना ॥", iast: "avyaktādīni bhūtāni vyaktamadhyāni bhārata |\navyaktanidhanānyeva tatra kā paridevanā ||", transliteration: "avyaktādīni bhūtāni vyakta-madhyāni bhārata\navyakta-nidhanānyeva tatra kā paridevanā", translation_en: "Beings are unmanifest in their beginning, manifest in their middle state, O Arjuna, and unmanifest again in their end. What is there to grieve about?", translation_hi: "हे भारत ! समस्त प्राणी जन्म से पूर्व और मृत्यु के बाद अव्यक्त अवस्था में रहते हैं और बीच में व्यक्त होते हैं। फिर उसमें चिन्ता या शोक की क्या बात है ?", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_028.mp3"},
  {id: "BG_2.29", label: "BG 2.29", ref: "2.29", chapter: 2, verse: 29, speaker: "krishna", canonical: true, meter: "tristubh-jagati", sa: "आश्चर्यवत्पश्यति कश्चिदेन", snippet: "One sees this (the Self) as a wonder; another speaks of it as a wonder; another hears of it as a wonder; yet, having heard, none understands it at all.", sanskrit: "आश्चर्यवत्पश्यति कश्चिदेन\nमाश्चर्यवद्वदति तथैव चान्यः ।\nआश्चर्यवच्चैनमन्यः श्रृणोति\nश्रुत्वाप्येनं वेद न चैव कश्चित् ॥", iast: "āścaryavatpaśyati kaścidena\nmāścaryavadvadati tathaiva cānyaḥ |\nāścaryavaccainamanyaḥ śrṛṇoti\nśrutvāpyenaṃ veda na caiva kaścit ||", transliteration: "āśhcharya-vat paśhyati kaśhchid enan\nāśhcharya-vad vadati tathaiva chānyaḥ\nāśhcharya-vach chainam anyaḥ śhṛiṇoti\nśhrutvāpyenaṁ veda na chaiva kaśhchit", translation_en: "One sees this (the Self) as a wonder; another speaks of it as a wonder; another hears of it as a wonder; yet, having heard, none understands it at all.", translation_hi: "कोई इसे आश्चर्य के समान देखता है;  कोई इसके विषय में आश्चर्य के समान कहता है;  और कोई अन्य पुरुष इसे आश्चर्य के समान सुनता है;  और फिर कोई सुनकर भी नहीं जानता।।", meter_name: "Upajāti (Triṣṭubh–Jagatī mixed)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_029.mp3"},
  {id: "BG_2.30", label: "BG 2.30", ref: "2.30", chapter: 2, verse: 30, speaker: "krishna", canonical: true, meter: "anustubh", sa: "देही नित्यमवध्योऽयं देहे सर्वस्य भारत", snippet: "This indweller in the body of everyone is ever indestructible, O Arjuna; therefore, you should not grieve for any creature.", sanskrit: "देही नित्यमवध्योऽयं देहे सर्वस्य भारत ।\nतस्मात्सर्वाणि भूतानि न त्वं शोचितुमर्हसि ॥", iast: "dehī nityamavadhyo’yaṃ dehe sarvasya bhārata |\ntasmātsarvāṇi bhūtāni na tvaṃ śocitumarhasi ||", transliteration: "dehī nityam avadhyo ’yaṁ dehe sarvasya bhārata\ntasmāt sarvāṇi bhūtāni na tvaṁ śhochitum arhasi", translation_en: "This indweller in the body of everyone is ever indestructible, O Arjuna; therefore, you should not grieve for any creature.", translation_hi: "हे भारत ! यह देही आत्मा सबके शरीर में सदा ही अवध्य है, इसलिए समस्त प्राणियों के लिए तुम्हें शोक करना उचित नहीं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_030.mp3"},
  {id: "BG_2.31", label: "BG 2.31", ref: "2.31", chapter: 2, verse: 31, speaker: "krishna", canonical: true, meter: "anustubh", sa: "स्वधर्ममपि चावेक्ष्य न विकम्पितुमर्हसि", snippet: "Further, having regard to your duty, you should not waver, for there is nothing higher for a Kshatriya than a righteous war.", sanskrit: "स्वधर्ममपि चावेक्ष्य न विकम्पितुमर्हसि ।\nधर्म्याद्धि युद्धाछ्रेयोऽन्यत्क्षत्रियस्य न विद्यते ॥", iast: "svadharmamapi cāvekṣya na vikampitumarhasi |\ndharmyāddhi yuddhāchreyo’nyatkṣatriyasya na vidyate ||", transliteration: "swa-dharmam api chāvekṣhya na vikampitum arhasi\ndharmyāddhi yuddhāch chhreyo ’nyat kṣhatriyasya na vidyate", translation_en: "Further, having regard to your duty, you should not waver, for there is nothing higher for a Kshatriya than a righteous war.", translation_hi: "और स्वधर्म को भी देखकर तुमको विचलित होना उचित नहीं है,  क्योंकि धर्मयुक्त युद्ध से बढ़कर दूसरा कोई कल्याणकारक कर्त्तव्य क्षत्रिय के लिये नहीं है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_031.mp3"},
  {id: "BG_2.32", label: "BG 2.32", ref: "2.32", chapter: 2, verse: 32, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यदृच्छया चोपपन्नं स्वर्गद्वारमपावृतम्", snippet: "Happy are the Kshatriyas, O Arjuna! who are called to fight in such a battle that comes of its own accord as an open door to heaven.", sanskrit: "यदृच्छया चोपपन्नं स्वर्गद्वारमपावृतम् ।\nसुखिनः क्षत्रियाः पार्थ लभन्ते युद्धमीदृशम् ॥", iast: "yadṛcchayā copapannaṃ svargadvāramapāvṛtam |\nsukhinaḥ kṣatriyāḥ pārtha labhante yuddhamīdṛśam ||", transliteration: "yadṛichchhayā chopapannaṁ swarga-dvāram apāvṛitam\nsukhinaḥ kṣhatriyāḥ pārtha labhante yuddham īdṛiśham", translation_en: "Happy are the Kshatriyas, O Arjuna! who are called to fight in such a battle that comes of its own accord as an open door to heaven.", translation_hi: "और हे पार्थ ! अपने आप प्राप्त हुए और स्वर्ग के लिए खुले हुए द्वाररूप इस प्रकार के युद्ध को भाग्यवान क्षत्रिय लोग ही पाते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_032.mp3"},
  {id: "BG_2.33", label: "BG 2.33", ref: "2.33", chapter: 2, verse: 33, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अथ चैत्त्वमिमं धर्म्यं संग्रामं न करिष्यसि", snippet: "But if you will not fight this righteous war, then having abandoned your own duty and reputation, you will incur sin.", sanskrit: "अथ चैत्त्वमिमं धर्म्यं संग्रामं न करिष्यसि ।\nततः स्वधर्मं कीर्तिं च हित्वा पापमवाप्स्यसि ॥", iast: "atha caittvamimaṃ dharmyaṃ saṃgrāmaṃ na kariṣyasi |\ntataḥ svadharmaṃ kīrtiṃ ca hitvā pāpamavāpsyasi ||", transliteration: "atha chet tvam imaṁ dharmyaṁ saṅgrāmaṁ na kariṣhyasi\ntataḥ sva-dharmaṁ kīrtiṁ cha hitvā pāpam avāpsyasi", translation_en: "But if you will not fight this righteous war, then having abandoned your own duty and reputation, you will incur sin.", translation_hi: "और यदि तुम इस धर्मयुद्ध को स्वीकार नहीं करोगे,  तो स्वधर्म और कीर्ति को खोकर पाप को प्राप्त करोगे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_033.mp3"},
  {id: "BG_2.34", label: "BG 2.34", ref: "2.34", chapter: 2, verse: 34, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अकीर्तिं चापि भूतानि कथयिष्यन्ति तेऽव्ययाम्", snippet: "People will also recount your everlasting dishonor; and for one who has been honored, dishonor is worse than death.", sanskrit: "अकीर्तिं चापि भूतानि कथयिष्यन्ति तेऽव्ययाम् ।\nसंभावितस्य चाकीर्तिर्मरणादतिरिच्यते ॥", iast: "akīrtiṃ cāpi bhūtāni kathayiṣyanti te’vyayām |\nsaṃbhāvitasya cākīrtirmaraṇādatiricyate ||", transliteration: "akīrtiṁ chāpi bhūtāni\nkathayiṣhyanti te ’vyayām\nsambhāvitasya chākīrtir\nmaraṇād atirichyate", translation_en: "People will also recount your everlasting dishonor; and for one who has been honored, dishonor is worse than death.", translation_hi: "और सब लोग तुम्हारी बहुत काल तक रहने वाली अपकीर्ति को भी कहते रहेंगे;  और सम्मानित पुरुष के लिए अपकीर्ति मरण से भी अधिक होती है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_034.mp3"},
  {id: "BG_2.35", label: "BG 2.35", ref: "2.35", chapter: 2, verse: 35, speaker: "krishna", canonical: true, meter: "anustubh", sa: "भयाद्रणादुपरतं मंस्यन्ते त्वां महारथाः", snippet: "The great chariot-warriors will think that you have withdrawn from the battle out of fear, and you will be held in low esteem by those who have held you in high regard.", sanskrit: "भयाद्रणादुपरतं मंस्यन्ते त्वां महारथाः ।\nयेषां च त्वं बहुमतो भूत्वा यास्यसि लाघवम् ॥", iast: "bhayādraṇāduparataṃ maṃsyante tvāṃ mahārathāḥ |\nyeṣāṃ ca tvaṃ bahumato bhūtvā yāsyasi lāghavam ||", transliteration: "bhayād raṇād uparataṁ mansyante tvāṁ mahā-rathāḥ\nyeṣhāṁ cha tvaṁ bahu-mato bhūtvā yāsyasi lāghavam", translation_en: "The great chariot-warriors will think that you have withdrawn from the battle out of fear, and you will be held in low esteem by those who have held you in high regard.", translation_hi: "और जिनके लिए तुम बहुत माननीय हो उनके लिए अब तुम तुच्छता को प्राप्त होओगे,  वे महारथी लोग तुम्हें भय के कारण युद्ध से निवृत्त हुआ मानेंगे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_035.mp3"},
  {id: "BG_2.36", label: "BG 2.36", ref: "2.36", chapter: 2, verse: 36, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अवाच्यवादांश्च बहून् वदिष्यन्ति तवाहिताः", snippet: "Your enemies, scoffing at your power, will speak many abusive words—what could be more painful than this?", sanskrit: "अवाच्यवादांश्च बहून् वदिष्यन्ति तवाहिताः ।\nनिन्दन्तस्तव सामर्थ्यं ततो दुःखतरं नु किम् ॥", iast: "avācyavādāṃśca bahūn vadiṣyanti tavāhitāḥ |\nnindantastava sāmarthyaṃ tato duḥkhataraṃ nu kim ||", transliteration: "avāchya-vādānśh cha bahūn vadiṣhyanti tavāhitāḥ\nnindantastava sāmarthyaṁ tato duḥkhataraṁ nu kim", translation_en: "Your enemies, scoffing at your power, will speak many abusive words—what could be more painful than this?", translation_hi: "तुम्हारे शत्रु तुम्हारे सार्मथ्य की निन्दा करते हुए बहुत से अकथनीय वचनों को कहेंगे,  फिर उससे अधिक दु:ख क्या होगा ?", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_036.mp3"},
  {id: "BG_2.37", label: "BG 2.37", ref: "2.37", chapter: 2, verse: 37, speaker: "krishna", canonical: true, meter: "anustubh", sa: "हतो वा प्राप्स्यसि स्वर्गं जित्वा वा भोक्ष्यसे महीम्", snippet: "Slain, you will obtain heaven; victorious, you will enjoy the earth; therefore, stand up, O son of Kunti, resolved to fight.", sanskrit: "हतो वा प्राप्स्यसि स्वर्गं जित्वा वा भोक्ष्यसे महीम् ।\nतस्मादुत्तिष्ठ कौन्तेय युद्धाय कृतनिश्चयः ॥", iast: "hato vā prāpsyasi svargaṃ jitvā vā bhokṣyase mahīm |\ntasmāduttiṣṭha kaunteya yuddhāya kṛtaniścayaḥ ||", transliteration: "hato vā prāpsyasi swargaṁ jitvā vā bhokṣhyase mahīm\ntasmād uttiṣhṭha kaunteya yuddhāya kṛita-niśhchayaḥ", translation_en: "Slain, you will obtain heaven; victorious, you will enjoy the earth; therefore, stand up, O son of Kunti, resolved to fight.", translation_hi: "युद्ध में मरकर तुम स्वर्ग प्राप्त करोगे या जीतकर पृथ्वी को भोगोगे;  इसलिय, हे कौन्तेय ! युद्ध का निश्चय कर तुम खड़े हो जाओ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_037.mp3"},
  {id: "BG_2.38", label: "BG 2.38", ref: "2.38", chapter: 2, verse: 38, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सुखदुःखे समे कृत्वा लाभालाभौ जयाजयौ", snippet: "Having made pleasure and pain, gain and loss, victory and defeat equal, engage in battle for the sake of battle; thus, you shall not incur sin.", sanskrit: "सुखदुःखे समे कृत्वा लाभालाभौ जयाजयौ ।\nततो युद्धाय युज्यस्व नैवं पापमवाप्स्यसि ॥", iast: "sukhaduḥkhe same kṛtvā lābhālābhau jayājayau |\ntato yuddhāya yujyasva naivaṃ pāpamavāpsyasi ||", transliteration: "sukha-duḥkhe same kṛitvā lābhālābhau jayājayau\ntato yuddhāya yujyasva naivaṁ pāpam avāpsyasi", translation_en: "Having made pleasure and pain, gain and loss, victory and defeat equal, engage in battle for the sake of battle; thus, you shall not incur sin.", translation_hi: "सुख-दु:ख,  लाभ-हानि और जय-पराजय को समान करके युद्ध के लिये तैयार हो जाओ;  इस प्रकार तुमको पाप नहीं होगा।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_038.mp3"},
  {id: "BG_2.39", label: "BG 2.39", ref: "2.39", chapter: 2, verse: 39, speaker: "krishna", canonical: true, meter: "anustubh", sa: "एषा तेऽभिहिता सांख्ये बुद्धिर्योगे त्विमां श्रृणु", snippet: "This, which has been taught to you, is wisdom concerning Sankhya. Now listen to wisdom concerning Yoga, endowed with which, O Arjuna, you shall cast off the bonds of action.", sanskrit: "एषा तेऽभिहिता सांख्ये बुद्धिर्योगे त्विमां श्रृणु ।\nबुद्ध्यायुक्तो यया पार्थ कर्मबन्धं प्रहास्यसि ॥", iast: "eṣā te’bhihitā sāṃkhye buddhiryoge tvimāṃ śrṛṇu |\nbuddhyāyukto yayā pārtha karmabandhaṃ prahāsyasi ||", transliteration: "eṣhā te ’bhihitā sānkhye\nbuddhir yoge tvimāṁ śhṛiṇu\nbuddhyā yukto yayā pārtha\nkarma-bandhaṁ prahāsyasi", translation_en: "This, which has been taught to you, is wisdom concerning Sankhya. Now listen to wisdom concerning Yoga, endowed with which, O Arjuna, you shall cast off the bonds of action.", translation_hi: "हे पार्थ ! तुम्हें सांख्य विषयक ज्ञान कहा गया और अब इस (कर्म) योग से सम्बन्धित ज्ञान को सुनो जिस ज्ञान से युक्त होकर तुम कर्मबन्ध का नाश कर सकोगे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_039.mp3"},
  {id: "BG_2.40", label: "BG 2.40", ref: "2.40", chapter: 2, verse: 40, speaker: "krishna", canonical: true, meter: "anustubh", sa: "नेहाभिक्रमनाशोऽस्ति प्रत्यवायो न विद्यते", snippet: "In this, there is no loss of effort, nor is there any harm produced, nor any transgression. Even a little of this knowledge protects one from great fear.", sanskrit: "नेहाभिक्रमनाशोऽस्ति प्रत्यवायो न विद्यते ।\nस्वल्पमप्यस्य धर्मस्य त्रायते महतो भयात् ॥", iast: "nehābhikramanāśo’sti pratyavāyo na vidyate |\nsvalpamapyasya dharmasya trāyate mahato bhayāt ||", transliteration: "nehābhikrama-nāśho ’sti pratyavāyo na vidyate\nsvalpam apyasya dharmasya trāyate mahato bhayāt", translation_en: "In this, there is no loss of effort, nor is there any harm produced, nor any transgression. Even a little of this knowledge protects one from great fear.", translation_hi: "इसमें क्रमनाश और प्रत्यवाय दोष नहीं है। इस धर्म (योग) का अल्प अभ्यास भी महान् भय से रक्षण करता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_040.mp3"},
  {id: "BG_2.41", label: "BG 2.41", ref: "2.41", chapter: 2, verse: 41, speaker: "krishna", canonical: true, meter: "anustubh", sa: "व्यवसायात्मिका बुद्धिरेकेह कुरुनन्दन", snippet: "Here, O joy of the Kurus, there is only one single-pointed determination; many-branched and endless are the thoughts of the indecisive.", sanskrit: "व्यवसायात्मिका बुद्धिरेकेह कुरुनन्दन ।\nबहुशाखा ह्यनन्ताश्च बुद्धयोऽव्यवसायिनाम् ॥", iast: "vyavasāyātmikā buddhirekeha kurunandana |\nbahuśākhā hyanantāśca buddhayo’vyavasāyinām ||", transliteration: "vyavasāyātmikā buddhir ekeha kuru-nandana\nbahu-śhākhā hyanantāśh cha buddhayo ’vyavasāyinām", translation_en: "Here, O joy of the Kurus, there is only one single-pointed determination; many-branched and endless are the thoughts of the indecisive.", translation_hi: "हे कुरुनन्दन ! इस (विषय) में निश्चयात्मक बुद्धि एक ही है, अज्ञानी पुरुषों की बुद्धियां (संकल्प) बहुत भेदों वाली और अनन्त होती हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_041.mp3"},
  {id: "BG_2.42", label: "BG 2.42", ref: "2.42", chapter: 2, verse: 42, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यामिमां पुष्पितां वाचं प्रवदन्त्यविपश्चितः", snippet: "The unwise, taking pleasure in the eulogizing words of the Vedas, utter flowery speech, saying, \"There is nothing else,\" O Arjuna.", sanskrit: "यामिमां पुष्पितां वाचं प्रवदन्त्यविपश्चितः ।\nवेदवादरताः पार्थ नान्यदस्तीति वादिनः ॥", iast: "yāmimāṃ puṣpitāṃ vācaṃ pravadantyavipaścitaḥ |\nvedavādaratāḥ pārtha nānyadastīti vādinaḥ ||", transliteration: "yāmimāṁ puṣhpitāṁ vāchaṁ pravadanty-avipaśhchitaḥ\nveda-vāda-ratāḥ pārtha nānyad astīti vādinaḥ\nkāmātmānaḥ swarga-parā janma-karma-phala-pradām\nkriyā-viśheṣha-bahulāṁ bhogaiśhwarya-gatiṁ prati", translation_en: "The unwise, taking pleasure in the eulogizing words of the Vedas, utter flowery speech, saying, \"There is nothing else,\" O Arjuna.", translation_hi: "हे पार्थ  अविवेकी पुरुष वेदवाद में रमते हुये जो यह पुष्पिता (दिखावटी शोभा की) वाणी बोलते हैं? इससे (स्वर्ग से) बढ़कर और कुछ नहीं है।।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_042.mp3"},
  {id: "BG_2.43", label: "BG 2.43", ref: "2.43", chapter: 2, verse: 43, speaker: "krishna", canonical: true, meter: "anustubh", sa: "कामात्मानः स्वर्गपरा जन्मकर्मफलप्रदाम्", snippet: "Full of desires, with heaven as their goal, (they speak words that are directed to ends) leading to new births as the result of their works, and prescribe various methods…", sanskrit: "कामात्मानः स्वर्गपरा जन्मकर्मफलप्रदाम् ।\nक्रियाविशेषबहुलां भोगैश्वर्यगतिं प्रति ॥", iast: "kāmātmānaḥ svargaparā janmakarmaphalapradām |\nkriyāviśeṣabahulāṃ bhogaiśvaryagatiṃ prati ||", transliteration: "kāmātmānaḥ svarga-parā\njanma-karma-phala-pradām\nkriyā-viśeṣa-bahulāṁ\nbhogaiśvarya-gatiṁ prati", translation_en: "Full of desires, with heaven as their goal, (they speak words that are directed to ends) leading to new births as the result of their works, and prescribe various methods abounding in specific actions, for the attainment of pleasure and power.", translation_hi: "कामनाओं से युक्त? स्वर्ग को ही श्रेष्ठ मानने वाले लोग भोग और ऐश्वर्य को प्राप्त कराने वाली अनेक क्रियाओं को बताते हैं जो (वास्तव में) जन्मरूप कर्मफल को देने वाली होती हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_043.mp3"},
  {id: "BG_2.44", label: "BG 2.44", ref: "2.44", chapter: 2, verse: 44, speaker: "krishna", canonical: true, meter: "anustubh", sa: "भोगैश्वर्यप्रसक्तानां तयापहृतचेतसाम्", snippet: "For those who are attached to pleasure and power, whose minds are drawn away by such teachings, their determinate reason is not formed which is steadily bent on meditation and…", sanskrit: "भोगैश्वर्यप्रसक्तानां तयापहृतचेतसाम् ।\nव्यवसायात्मिका बुद्धिः समाधौ न विधीयते ॥", iast: "bhogaiśvaryaprasaktānāṃ tayāpahṛtacetasām |\nvyavasāyātmikā buddhiḥ samādhau na vidhīyate ||", transliteration: "bhogaiśwvarya-prasaktānāṁ tayāpahṛita-chetasām\nvyavasāyātmikā buddhiḥ samādhau na vidhīyate", translation_en: "For those who are attached to pleasure and power, whose minds are drawn away by such teachings, their determinate reason is not formed which is steadily bent on meditation and Samadhi (superconscious state).", translation_hi: "उससे जिनका चित्त हर लिया गया है ऐसे भोग और एश्र्वर्य‌ मॆ आसक्ति रखने वाले पुरुषों के अन्तकरण मे निश्चयात्मक् बुद्धि नही हॊती अर्थात वे ध्यान का अभ्यास करने योग्य‌ नही होते।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_044.mp3"},
  {id: "BG_2.45", label: "BG 2.45", ref: "2.45", chapter: 2, verse: 45, speaker: "krishna", canonical: true, meter: "anustubh", sa: "त्रैगुण्यविषया वेदा निस्त्रैगुण्यो भवार्जुन", snippet: "The Vedas deal with the three attributes; be thou above these three attributes. O Arjuna, free yourself from the pairs of opposites and ever remain in the quality of Sattva,…", sanskrit: "त्रैगुण्यविषया वेदा निस्त्रैगुण्यो भवार्जुन ।\nनिर्द्वन्द्वो नित्यसत्त्वस्थो निर्योगक्षेम आत्मवान् ॥", iast: "traiguṇyaviṣayā vedā nistraiguṇyo bhavārjuna |\nnirdvandvo nityasattvastho niryogakṣema ātmavān ||", transliteration: "trai-guṇya-viṣhayā vedā nistrai-guṇyo bhavārjuna\nnirdvandvo nitya-sattva-stho niryoga-kṣhema ātmavān", translation_en: "The Vedas deal with the three attributes; be thou above these three attributes. O Arjuna, free yourself from the pairs of opposites and ever remain in the quality of Sattva, freed from acquisition and preservation, and be established in the Self.", translation_hi: "हे अर्जुन  वेदों का विषय तीन गुणों से सम्बन्धित (संसार से) है  तुम त्रिगुणातीत? निर्द्वन्द्व? नित्य सत्त्व (शुद्धता) में स्थित? योगक्षेम से रहित और आत्मवान् बनो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_045.mp3"},
  {id: "BG_2.46", label: "BG 2.46", ref: "2.46", chapter: 2, verse: 46, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यावानर्थ उदपाने सर्वतः संप्लुतोदके", snippet: "To the Brahmana who has known the Self, all the Vedas are of as much use as a reservoir of water would be in a place where there is a flood.", sanskrit: "यावानर्थ उदपाने सर्वतः संप्लुतोदके ।\nतावान्सर्वेषु वेदेषु ब्राह्मणस्य विजानतः ॥", iast: "yāvānartha udapāne sarvataḥ saṃplutodake |\ntāvānsarveṣu vedeṣu brāhmaṇasya vijānataḥ ||", transliteration: "yāvān artha udapāne sarvataḥ samplutodake\ntāvānsarveṣhu vedeṣhu brāhmaṇasya vijānataḥ", translation_en: "To the Brahmana who has known the Self, all the Vedas are of as much use as a reservoir of water would be in a place where there is a flood.", translation_hi: "सब ओर से परिपूर्ण जलराशि के होने पर मनुष्य का छोटे जलाशय में जितना प्रयोजन रहता है? आत्मज्ञानी ब्राह्मण का सभी वेदों में उतना ही प्रयोजन रहता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_046.mp3"},
  {id: "BG_2.47", label: "BG 2.47", ref: "2.47", chapter: 2, verse: 47, speaker: "krishna", canonical: true, meter: "anustubh", sa: "कर्मण्येवाधिकारस्ते मा फलेषु कदाचन", snippet: "Your right is only to work, but not to its results; do not let the results of action be your motive, nor let your attachment be to inaction.", sanskrit: "कर्मण्येवाधिकारस्ते मा फलेषु कदाचन ।\nमा कर्मफलहेतुर्भूर्मा ते सङ्गोऽस्त्वकर्मणि ॥", iast: "karmaṇyevādhikāraste mā phaleṣu kadācana |\nmā karmaphalaheturbhūrmā te saṅgo’stvakarmaṇi ||", transliteration: "karmaṇy-evādhikāras te mā phaleṣhu kadāchana\nmā karma-phala-hetur bhūr mā te saṅgo ’stvakarmaṇi", translation_en: "Your right is only to work, but not to its results; do not let the results of action be your motive, nor let your attachment be to inaction.", translation_hi: "कर्म करने मात्र में तुम्हारा अधिकार है? फल में कभी नहीं। तुम कर्मफल के हेतु वाले मत होना और अकर्म में भी तुम्हारी आसक्ति न हो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_047.mp3"},
  {id: "BG_2.48", label: "BG 2.48", ref: "2.48", chapter: 2, verse: 48, speaker: "krishna", canonical: true, meter: "anustubh", sa: "योगस्थः कुरु कर्माणि सङ्गं त्यक्त्वा धनञ्जय", snippet: "Perform action, O Arjuna, being steadfast in Yoga, abandoning attachment and balanced in success and failure; evenness of mind is called Yoga.", sanskrit: "योगस्थः कुरु कर्माणि सङ्गं त्यक्त्वा धनञ्जय ।\nसिद्ध्यसिद्ध्योः समो भूत्वा समत्वं योग उच्यते ॥", iast: "yogasthaḥ kuru karmāṇi saṅgaṃ tyaktvā dhanañjaya |\nsiddhyasiddhyoḥ samo bhūtvā samatvaṃ yoga ucyate ||", transliteration: "yoga-sthaḥ kuru karmāṇi saṅgaṁ tyaktvā dhanañjaya\nsiddhy-asiddhyoḥ samo bhūtvā samatvaṁ yoga uchyate", translation_en: "Perform action, O Arjuna, being steadfast in Yoga, abandoning attachment and balanced in success and failure; evenness of mind is called Yoga.", translation_hi: "हे धनंजय  आसक्ति को त्याग कर तथा सिद्धि और असिद्धि में समभाव होकर योग में स्थित हुये तुम कर्म करो। यह समभाव ही योग कहलाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_048.mp3"},
  {id: "BG_2.49", label: "BG 2.49", ref: "2.49", chapter: 2, verse: 49, speaker: "krishna", canonical: true, meter: "anustubh", sa: "दूरेण ह्यवरं कर्म बुद्धियोगाद्धनञ्जय", snippet: "Far lower than the Yoga of wisdom is action, O Arjuna. Seek thou refuge in wisdom; wretched are those whose motive is the fruit.", sanskrit: "दूरेण ह्यवरं कर्म बुद्धियोगाद्धनञ्जय ।\nबुद्धौ शरणमन्विच्छ कृपणाः फलहेतवः ॥", iast: "dūreṇa hyavaraṃ karma buddhiyogāddhanañjaya |\nbuddhau śaraṇamanviccha kṛpaṇāḥ phalahetavaḥ ||", transliteration: "dūreṇa hy-avaraṁ karma buddhi-yogād dhanañjaya\nbuddhau śharaṇam anvichchha kṛipaṇāḥ phala-hetavaḥ", translation_en: "Far lower than the Yoga of wisdom is action, O Arjuna. Seek thou refuge in wisdom; wretched are those whose motive is the fruit.", translation_hi: "इस बुद्धियोग की तुलना में(सकाम) कर्म अत्यन्त निकृष्ट हैं? इसलिये हे धनंजय  तुम बद्धि की शरण लो फल की इच्छा करनेवाले कृपण (दीन) हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_049.mp3"},
  {id: "BG_2.50", label: "BG 2.50", ref: "2.50", chapter: 2, verse: 50, speaker: "krishna", canonical: true, meter: "anustubh", sa: "बुद्धियुक्तो जहातीह उभे सुकृतदुष्कृते", snippet: "Endowed with wisdom and evenness of mind, one casts off in this life both good and evil deeds; therefore, devote yourself to Yoga; Yoga is skill in action.", sanskrit: "बुद्धियुक्तो जहातीह उभे सुकृतदुष्कृते ।\nतस्माद्योगाय युज्यस्व योगः कर्मसु कौशलम् ॥", iast: "buddhiyukto jahātīha ubhe sukṛtaduṣkṛte |\ntasmādyogāya yujyasva yogaḥ karmasu kauśalam ||", transliteration: "buddhi-yukto jahātīha ubhe sukṛita-duṣhkṛite\ntasmād yogāya yujyasva yogaḥ karmasu kauśhalam", translation_en: "Endowed with wisdom and evenness of mind, one casts off in this life both good and evil deeds; therefore, devote yourself to Yoga; Yoga is skill in action.", translation_hi: "समत्वबुद्धि युक्त पुरुष यहां (इस जीवन में) पुण्य और पाप इन दोनों कर्मों को त्याग देता है? इसलिये तुम योग से युक्त हो जाओ। कर्मों में कुशलता योग है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_050.mp3"},
  {id: "BG_2.51", label: "BG 2.51", ref: "2.51", chapter: 2, verse: 51, speaker: "krishna", canonical: true, meter: "anustubh", sa: "कर्मजं बुद्धियुक्ता हि फलं त्यक्त्वा मनीषिणः", snippet: "The wise, possessing knowledge, having abandoned the fruits of their actions, and being freed from the bonds of birth, go to the place which is beyond all evil.", sanskrit: "कर्मजं बुद्धियुक्ता हि फलं त्यक्त्वा मनीषिणः ।\nजन्मबन्धविनिर्मुक्ताः पदं गच्छन्त्यनामयम् ॥", iast: "karmajaṃ buddhiyuktā hi phalaṃ tyaktvā manīṣiṇaḥ |\njanmabandhavinirmuktāḥ padaṃ gacchantyanāmayam ||", transliteration: "karma-jaṁ buddhi-yuktā hi phalaṁ tyaktvā manīṣhiṇaḥ\njanma-bandha-vinirmuktāḥ padaṁ gachchhanty-anāmayam", translation_en: "The wise, possessing knowledge, having abandoned the fruits of their actions, and being freed from the bonds of birth, go to the place which is beyond all evil.", translation_hi: "बुद्धियोग युक्त मनीषी लोग कर्मजन्य फलों को त्यागकर जन्मरूप बन्धन से मुक्त हुये अनामय अर्थात् निर्दोष पद को प्राप्त होते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_051.mp3"},
  {id: "BG_2.52", label: "BG 2.52", ref: "2.52", chapter: 2, verse: 52, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यदा ते मोहकलिलं बुद्धिर्व्यतितरिष्यति", snippet: "When your intellect passes beyond the mire of delusion, then you will attain indifference to what has been heard and what has yet to be heard.", sanskrit: "यदा ते मोहकलिलं बुद्धिर्व्यतितरिष्यति ।\nतदा गन्तासि निर्वेदं श्रोतव्यस्य श्रुतस्य च ॥", iast: "yadā te mohakalilaṃ buddhirvyatitariṣyati |\ntadā gantāsi nirvedaṃ śrotavyasya śrutasya ca ||", transliteration: "yadā te moha-kalilaṁ buddhir vyatitariṣhyati\ntadā gantāsi nirvedaṁ śhrotavyasya śhrutasya cha", translation_en: "When your intellect passes beyond the mire of delusion, then you will attain indifference to what has been heard and what has yet to be heard.", translation_hi: "जब तुम्हारी बुद्धि मोहरूप दलदल (कलिल) को तर जायेगी तब तुम उन सब वस्तुओं से निर्वेद (वैराग्य) को प्राप्त हो जाओगे? जो सुनने योग्य और सुनी हुई हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_052.mp3"},
  {id: "BG_2.53", label: "BG 2.53", ref: "2.53", chapter: 2, verse: 53, speaker: "krishna", canonical: true, meter: "anustubh", sa: "श्रुतिविप्रतिपन्ना ते यदा स्थास्यति निश्चला", snippet: "When your intellect, which is perplexed by the Vedic texts you have read, stands immovable and steady in the Self, then you will attain Self-realization.", sanskrit: "श्रुतिविप्रतिपन्ना ते यदा स्थास्यति निश्चला ।\nसमाधावचला बुद्धिस्तदा योगमवाप्स्यसि ॥", iast: "śrutivipratipannā te yadā sthāsyati niścalā |\nsamādhāvacalā buddhistadā yogamavāpsyasi ||", transliteration: "śhruti-vipratipannā te yadā sthāsyati niśhchalā\nsamādhāv-achalā buddhis tadā yogam avāpsyasi", translation_en: "When your intellect, which is perplexed by the Vedic texts you have read, stands immovable and steady in the Self, then you will attain Self-realization.", translation_hi: "जब अनेक प्रकार के विषयों को सुनने से विचलित हुई तुम्हारी बुद्धि आत्मस्वरूप में अचल और स्थिर हो जायेगी तब तुम (परमार्थ) योग को प्राप्त करोगे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_053.mp3"},
  {id: "BG_2.54", label: "BG 2.54", ref: "2.54", chapter: 2, verse: 54, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "स्थितप्रज्ञस्य का भाषा समाधिस्थस्य केशव", snippet: "Arjuna said, \"O Krishna, what is the description of one who has steady wisdom and is merged in the superconscious state? How does one of steady wisdom speak, how do they sit,…", sanskrit: "स्थितप्रज्ञस्य का भाषा समाधिस्थस्य केशव ।\nस्थितधीः किं प्रभाषेत किमासीत व्रजेत किम् ॥", iast: "sthitaprajñasya kā bhāṣā samādhisthasya keśava |\nsthitadhīḥ kiṃ prabhāṣeta kimāsīta vrajeta kim ||", transliteration: "sthita-prajñasya kā bhāṣhā samādhi-sthasya keśhava\nsthita-dhīḥ kiṁ prabhāṣheta kim āsīta vrajeta kim", translation_en: "Arjuna said, \"O Krishna, what is the description of one who has steady wisdom and is merged in the superconscious state? How does one of steady wisdom speak, how do they sit, and how do they walk?\"", translation_hi: "अर्जुन ने कहा -- हे केशव  समाधि में स्थित स्थिर बुद्धि वाले पुरुष का क्या लक्षण है स्थिर बुद्धि पुरुष कैसे बोलता है कैसे बैठता है  कैसे चलता है", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_054.mp3"},
  {id: "BG_2.55", label: "BG 2.55", ref: "2.55", chapter: 2, verse: 55, speaker: "krishna", canonical: true, meter: "anustubh", sa: "प्रजहाति यदा कामान् सर्वान् पार्थ मनोगतान्", snippet: "The Blessed Lord said, \"When a man completely casts off, O Arjuna, all the desires of the mind and is satisfied in the Self by the Self, then he is said to be one of steady…", sanskrit: "प्रजहाति यदा कामान् सर्वान् पार्थ मनोगतान् ।\nआत्मन्येवात्मना तुष्टः स्थितप्रज्ञस्तदोच्यते ॥", iast: "prajahāti yadā kāmān sarvān pārtha manogatān |\nātmanyevātmanā tuṣṭaḥ sthitaprajñastadocyate ||", transliteration: "prajahāti yadā kāmān sarvān pārtha mano-gatān\nātmany-evātmanā tuṣhṭaḥ sthita-prajñas tadochyate", translation_en: "The Blessed Lord said, \"When a man completely casts off, O Arjuna, all the desires of the mind and is satisfied in the Self by the Self, then he is said to be one of steady wisdom.\"", translation_hi: "श्री भगवान् ने कहा -- हे पार्थ? जिस समय पुरुष मन में स्थित सब कामनाओं को त्याग देता है और आत्मा से ही आत्मा में सन्तुष्ट रहता है? उस समय वह स्थितप्रज्ञ कहलाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_055.mp3"},
  {id: "BG_2.56", label: "BG 2.56", ref: "2.56", chapter: 2, verse: 56, speaker: "krishna", canonical: true, meter: "anustubh", sa: "दुःखेष्वनुद्विग्नमनाः सुखेषु विगतस्पृहः", snippet: "He whose mind is not shaken by adversity, who does not long for pleasures, and is free from attachment, fear, and anger, is called a sage of steady wisdom.", sanskrit: "दुःखेष्वनुद्विग्नमनाः सुखेषु विगतस्पृहः ।\nवीतरागभयक्रोधः स्थितधीर्मुनिरुच्यते ॥", iast: "duḥkheṣvanudvignamanāḥ sukheṣu vigataspṛhaḥ |\nvītarāgabhayakrodhaḥ sthitadhīrmunirucyate ||", transliteration: "duḥkheṣhv-anudvigna-manāḥ sukheṣhu vigata-spṛihaḥ\nvīta-rāga-bhaya-krodhaḥ sthita-dhīr munir uchyate", translation_en: "He whose mind is not shaken by adversity, who does not long for pleasures, and is free from attachment, fear, and anger, is called a sage of steady wisdom.", translation_hi: "दुख में जिसका मन उद्विग्न नहीं होता सुख में जिसकी स्पृहा निवृत्त हो गयी है? जिसके मन से राग? भय और क्रोध नष्ट हो गये हैं? वह मुनि स्थितप्रज्ञ कहलाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_056.mp3"},
  {id: "BG_2.57", label: "BG 2.57", ref: "2.57", chapter: 2, verse: 57, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यः सर्वत्रानभिस्नेहस्तत्तत्प्राप्य शुभाशुभम्", snippet: "He who is everywhere without attachment, upon encountering anything good or bad, neither rejoices nor hastens; his wisdom is firm.", sanskrit: "यः सर्वत्रानभिस्नेहस्तत्तत्प्राप्य शुभाशुभम् ।\nनाभिनन्दति न द्वेष्टि तस्य प्रज्ञा प्रतिष्ठिता ॥", iast: "yaḥ sarvatrānabhisnehastattatprāpya śubhāśubham |\nnābhinandati na dveṣṭi tasya prajñā pratiṣṭhitā ||", transliteration: "yaḥ sarvatrānabhisnehas tat tat prāpya śhubhāśhubham\nnābhinandati na dveṣhṭi tasya prajñā pratiṣhṭhitā", translation_en: "He who is everywhere without attachment, upon encountering anything good or bad, neither rejoices nor hastens; his wisdom is firm.", translation_hi: "जो सर्वत्र अति स्नेह से रहित हुआ उन शुभ तथा अशुभ वस्तुओं को प्राप्त कर न प्रसन्न होता है और न द्वेष करता है? उसकी प्रज्ञा प्रतिष्ठित (स्थिर) है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_057.mp3"},
  {id: "BG_2.58", label: "BG 2.58", ref: "2.58", chapter: 2, verse: 58, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यदा संहरते चायं कूर्मोऽङ्गानीव सर्वशः", snippet: "When, like the tortoise which withdraws all its limbs on all sides, he withdraws his senses from the sense-objects, then his wisdom becomes steady.", sanskrit: "यदा संहरते चायं कूर्मोऽङ्गानीव सर्वशः ।\nइन्द्रियाणीन्द्रियार्थेभ्यस्तस्य प्रज्ञा प्रतिष्ठिता ॥", iast: "yadā saṃharate cāyaṃ kūrmo’ṅgānīva sarvaśaḥ |\nindriyāṇīndriyārthebhyastasya prajñā pratiṣṭhitā ||", transliteration: "yadā sanharate chāyaṁ kūrmo ’ṅgānīva sarvaśhaḥ\nindriyāṇīndriyārthebhyas tasya prajñā pratiṣhṭhitā", translation_en: "When, like the tortoise which withdraws all its limbs on all sides, he withdraws his senses from the sense-objects, then his wisdom becomes steady.", translation_hi: "कछुवा अपने अंगों को जैसे समेट लेता है वैसे ही यह पुरुष जब सब ओर से अपनी इन्द्रियों को इन्द्रियों के विषयों से परावृत्त कर लेता है? तब उसकी बुद्धि स्थिर होती है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_058.mp3"},
  {id: "BG_2.59", label: "BG 2.59", ref: "2.59", chapter: 2, verse: 59, speaker: "krishna", canonical: true, meter: "anustubh", sa: "विषया विनिवर्तन्ते निराहारस्य देहिनः", snippet: "The objects of the senses turn away from the abstinent man, leaving the longing behind; but his longing also turns away upon seeing the Supreme.", sanskrit: "विषया विनिवर्तन्ते निराहारस्य देहिनः ।\nरसवर्जं रसोऽप्यस्य परं दृष्ट्वा निवर्तते ॥", iast: "viṣayā vinivartante nirāhārasya dehinaḥ |\nrasavarjaṃ raso’pyasya paraṃ dṛṣṭvā nivartate ||", transliteration: "viṣhayā vinivartante nirāhārasya dehinaḥ\nrasa-varjaṁ raso ’pyasya paraṁ dṛiṣhṭvā nivartate", translation_en: "The objects of the senses turn away from the abstinent man, leaving the longing behind; but his longing also turns away upon seeing the Supreme.", translation_hi: "निराहारी देही पुरुष से विषय तो निवृत्त (दूर) हो जाते हैं? परन्तु (उनके प्रति) राग नहीं  परम तत्व को देखने पर इस (पुरुष) का राग भी निवृत्त हो जाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_059.mp3"},
  {id: "BG_2.60", label: "BG 2.60", ref: "2.60", chapter: 2, verse: 60, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यततो ह्यपि कौन्तेय पुरुषस्य विपश्चितः", snippet: "The turbulent senses, O Arjuna, can violently carry away the mind of a wise person, even though they are striving to control them.", sanskrit: "यततो ह्यपि कौन्तेय पुरुषस्य विपश्चितः ।\nइन्द्रियाणि प्रमाथीनि हरन्ति प्रसभं मनः ॥", iast: "yatato hyapi kaunteya puruṣasya vipaścitaḥ |\nindriyāṇi pramāthīni haranti prasabhaṃ manaḥ ||", transliteration: "yatato hyapi kaunteya puruṣhasya vipaśhchitaḥ\nindriyāṇi pramāthīni haranti prasabhaṁ manaḥ", translation_en: "The turbulent senses, O Arjuna, can violently carry away the mind of a wise person, even though they are striving to control them.", translation_hi: "हे कौन्तेय  (संयम का) प्रयत्न करते हुए बुद्धिमान (विपश्चित) पुरुष के भी मन को ये इन्द्रियां बलपूर्वक हर लेती हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_060.mp3"},
  {id: "BG_2.61", label: "BG 2.61", ref: "2.61", chapter: 2, verse: 61, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तानि सर्वाणि संयम्य युक्त आसीत मत्परः", snippet: "Having restrained them all, he should sit steadfast, intent on Me; his wisdom is steady whose senses are under control.", sanskrit: "तानि सर्वाणि संयम्य युक्त आसीत मत्परः ।\nवशे हि यस्येन्द्रियाणि तस्य प्रज्ञा प्रतिष्ठिता ॥", iast: "tāni sarvāṇi saṃyamya yukta āsīta matparaḥ |\nvaśe hi yasyendriyāṇi tasya prajñā pratiṣṭhitā ||", transliteration: "tāni sarvāṇi sanyamya yukta āsīta mat-paraḥ\nvaśhe hi yasyendriyāṇi tasya prajñā pratiṣhṭhitā", translation_en: "Having restrained them all, he should sit steadfast, intent on Me; his wisdom is steady whose senses are under control.", translation_hi: "उन सब इन्द्रियों को संयमित कर युक्त और मत्पर होवे। जिस पुरुष की इन्द्रियां वश में होती हैं? उसकी प्रज्ञा प्रतिष्ठित होती है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_061.mp3"},
  {id: "BG_2.62", label: "BG 2.62", ref: "2.62", chapter: 2, verse: 62, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ध्यायतो विषयान्पुंसः सङ्गस्तेषूपजायते", snippet: "When one thinks of objects, attachment to them arises; from attachment, desire is born; from desire, anger arises.", sanskrit: "ध्यायतो विषयान्पुंसः सङ्गस्तेषूपजायते ।\nसङ्गात् संजायते कामः कामात्क्रोधोऽभिजायते ॥", iast: "dhyāyato viṣayānpuṃsaḥ saṅgasteṣūpajāyate |\nsaṅgāt saṃjāyate kāmaḥ kāmātkrodho’bhijāyate ||", transliteration: "dhyāyato viṣhayān puṁsaḥ saṅgas teṣhūpajāyate\nsaṅgāt sañjāyate kāmaḥ kāmāt krodho ’bhijāyate", translation_en: "When one thinks of objects, attachment to them arises; from attachment, desire is born; from desire, anger arises.", translation_hi: "विषयों का चिन्तन करने वाले पुरुष की उसमें आसक्ति हो जाती है? आसक्ति से इच्छा और इच्छा से क्रोध उत्पन्न होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_062.mp3"},
  {id: "BG_2.63", label: "BG 2.63", ref: "2.63", chapter: 2, verse: 63, speaker: "krishna", canonical: true, meter: "anustubh", sa: "क्रोधाद्भवति संमोहः संमोहात्स्मृतिविभ्रमः", snippet: "Anger leads to delusion, which causes loss of memory; this, in turn, leads to the destruction of discrimination, resulting in destruction.", sanskrit: "क्रोधाद्भवति संमोहः संमोहात्स्मृतिविभ्रमः ।\nस्मृतिभ्रंशाद् बुद्धिनाशो बुद्धिनाशात्प्रणश्यति ॥", iast: "krodhādbhavati saṃmohaḥ saṃmohātsmṛtivibhramaḥ |\nsmṛtibhraṃśād buddhināśo buddhināśātpraṇaśyati ||", transliteration: "krodhād bhavati sammohaḥ sammohāt smṛiti-vibhramaḥ\nsmṛiti-bhranśhād buddhi-nāśho buddhi-nāśhāt praṇaśhyati", translation_en: "Anger leads to delusion, which causes loss of memory; this, in turn, leads to the destruction of discrimination, resulting in destruction.", translation_hi: "क्रोध से उत्पन्न होता है मोह और मोह से स्मृति विभ्रम। स्मृति के भ्रमित होने पर बुद्धि का नाश होता है और बुद्धि के नाश होने से वह मनुष्य नष्ट हो जाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_063.mp3"},
  {id: "BG_2.64", label: "BG 2.64", ref: "2.64", chapter: 2, verse: 64, speaker: "krishna", canonical: true, meter: "anustubh", sa: "रागद्वेषवियुक्तैस्तु विषयानिन्द्रियैश्चरन्", snippet: "But the self-controlled man, moving among objects with the senses restrained and free from attraction and repulsion, attains peace.", sanskrit: "रागद्वेषवियुक्तैस्तु विषयानिन्द्रियैश्चरन् ।\nआत्मवश्यैर्विधेयात्मा प्रसादमधिगच्छति ॥", iast: "rāgadveṣaviyuktaistu viṣayānindriyaiścaran |\nātmavaśyairvidheyātmā prasādamadhigacchati ||", transliteration: "rāga-dveṣha-viyuktais tu viṣhayān indriyaiśh charan\nātma-vaśhyair-vidheyātmā prasādam adhigachchhati", translation_en: "But the self-controlled man, moving among objects with the senses restrained and free from attraction and repulsion, attains peace.", translation_hi: "आत्मसंयमी (विधेयात्मा) पुरुष रागद्वेष से रहित अपने वश में की हुई (आत्मवश्यै) इन्द्रियों द्वारा विषयों को भोगता हुआ प्रसन्नता (प्रस्ेााद) प्राप्त करता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_064.mp3"},
  {id: "BG_2.65", label: "BG 2.65", ref: "2.65", chapter: 2, verse: 65, speaker: "krishna", canonical: true, meter: "anustubh", sa: "प्रसादे सर्वदुःखानां हानिरस्योपजायते", snippet: "In that peace, all pains are destroyed; for the intellect of the tranquil-minded soon becomes steady.", sanskrit: "प्रसादे सर्वदुःखानां हानिरस्योपजायते ।\nप्रसन्नचेतसो ह्याशु बुद्धिः पर्यवतिष्ठते ॥", iast: "prasāde sarvaduḥkhānāṃ hānirasyopajāyate |\nprasannacetaso hyāśu buddhiḥ paryavatiṣṭhate ||", transliteration: "prasāde sarva-duḥkhānāṁ hānir asyopajāyate\nprasanna-chetaso hyāśhu buddhiḥ paryavatiṣhṭhate", translation_en: "In that peace, all pains are destroyed; for the intellect of the tranquil-minded soon becomes steady.", translation_hi: "प्रसाद के होने पर सम्पूर्ण दुखों का अन्त हो जाता है और प्रसन्नचित्त पुरुष की बुद्धि ही शीघ्र ही स्थिर हो जाती है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_065.mp3"},
  {id: "BG_2.66", label: "BG 2.66", ref: "2.66", chapter: 2, verse: 66, speaker: "krishna", canonical: true, meter: "anustubh", sa: "नास्ति बुद्धिरयुक्तस्य न चायुक्तस्य भावना", snippet: "There is no knowledge of the Self for the unsteady, and no meditation is possible for the unsteady, and no peace for the unmeditative, and how can there be happiness for one…", sanskrit: "नास्ति बुद्धिरयुक्तस्य न चायुक्तस्य भावना ।\nन चाभावयतः शान्तिरशान्तस्य कुतः सुखम् ॥", iast: "nāsti buddhirayuktasya na cāyuktasya bhāvanā |\nna cābhāvayataḥ śāntiraśāntasya kutaḥ sukham ||", transliteration: "nāsti buddhir-ayuktasya na chāyuktasya bhāvanā\nna chābhāvayataḥ śhāntir aśhāntasya kutaḥ sukham", translation_en: "There is no knowledge of the Self for the unsteady, and no meditation is possible for the unsteady, and no peace for the unmeditative, and how can there be happiness for one who has no peace?", translation_hi: "(संयमरहित) अयुक्त पुरुष को (आत्म) ज्ञान नहीं होता और अयुक्त को भावना और ध्यान की क्षमता नहीं होती भावना रहित पुरुष को शान्ति नहीं मिलती अशान्त पुरुष को सुख कहाँ", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_066.mp3"},
  {id: "BG_2.67", label: "BG 2.67", ref: "2.67", chapter: 2, verse: 67, speaker: "krishna", canonical: true, meter: "anustubh", sa: "इन्द्रियाणां हि चरतां यन्मनोऽनुविधीयते", snippet: "For the mind, which follows in the wake of the wandering senses, carries away his discrimination, as the wind carries away a boat on the waters.", sanskrit: "इन्द्रियाणां हि चरतां यन्मनोऽनुविधीयते ।\nतदस्य हरति प्रज्ञां वायुर्नावमिवाम्भसि ॥", iast: "indriyāṇāṃ hi caratāṃ yanmano’nuvidhīyate |\ntadasya harati prajñāṃ vāyurnāvamivāmbhasi ||", transliteration: "indriyāṇāṁ hi charatāṁ yan mano ’nuvidhīyate\ntadasya harati prajñāṁ vāyur nāvam ivāmbhasi", translation_en: "For the mind, which follows in the wake of the wandering senses, carries away his discrimination, as the wind carries away a boat on the waters.", translation_hi: "जल में वायु जैसे नाव को हर लेता है वैसे ही विषयों में विरचती हुई इन्द्रियों के बीच में जिस इन्द्रिय का अनुकरण मन करता है? वह एक ही इन्द्रिय इसकी प्रज्ञा को हर लेती है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_067.mp3"},
  {id: "BG_2.68", label: "BG 2.68", ref: "2.68", chapter: 2, verse: 68, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तस्माद्यस्य महाबाहो निगृहीतानि सर्वशः", snippet: "Therefore, O mighty-armed Arjuna, his knowledge is steady whose senses are completely restrained from sense objects.", sanskrit: "तस्माद्यस्य महाबाहो निगृहीतानि सर्वशः ।\nइन्द्रियाणीन्द्रियार्थेभ्यस्तस्य प्रज्ञा प्रतिष्ठिता ॥", iast: "tasmādyasya mahābāho nigṛhītāni sarvaśaḥ |\nindriyāṇīndriyārthebhyastasya prajñā pratiṣṭhitā ||", transliteration: "tasmād yasya mahā-bāho nigṛihītāni sarvaśhaḥ\nindriyāṇīndriyārthebhyas tasya prajñā pratiṣhṭhitā", translation_en: "Therefore, O mighty-armed Arjuna, his knowledge is steady whose senses are completely restrained from sense objects.", translation_hi: "इसलिये? हे महाबाहो  जिस पुरुष की इन्द्रियाँ सब प्रकार इन्द्रियों के विषयों के वश में की हुई होती हैं? उसकी बुद्धि स्थिर होती है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_068.mp3"},
  {id: "BG_2.69", label: "BG 2.69", ref: "2.69", chapter: 2, verse: 69, speaker: "krishna", canonical: true, meter: "anustubh", sa: "या निशा सर्वभूतानां तस्यां जागर्ति संयमी", snippet: "That which is night to all beings, in that the self-controlled man is awake; when all beings are awake, that is night for the sage who sees.", sanskrit: "या निशा सर्वभूतानां तस्यां जागर्ति संयमी ।\nयस्यां जाग्रति भूतानि सा निशा पश्यतो मुनेः ॥", iast: "yā niśā sarvabhūtānāṃ tasyāṃ jāgarti saṃyamī |\nyasyāṃ jāgrati bhūtāni sā niśā paśyato muneḥ ||", transliteration: "yā niśhā sarva-bhūtānāṁ tasyāṁ jāgarti sanyamī\nyasyāṁ jāgrati bhūtāni sā niśhā paśhyato muneḥ", translation_en: "That which is night to all beings, in that the self-controlled man is awake; when all beings are awake, that is night for the sage who sees.", translation_hi: "सब प्रणियों के लिए जो रात्रि है? उसमें संयमी पुरुष जागता है और जहाँ सब प्राणी जागते हैं? वह (तत्त्व को) देखने वाले मुनि के लिए रात्रि है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_069.mp3"},
  {id: "BG_2.70", label: "BG 2.70", ref: "2.70", chapter: 2, verse: 70, speaker: "krishna", canonical: true, meter: "tristubh", sa: "आपूर्यमाणमचलप्रतिष्ठं", snippet: "He attains peace into whom all desires enter, just as waters enter the ocean which, filled from all sides, remains unmoved; but not the man who is full of desires.", sanskrit: "आपूर्यमाणमचलप्रतिष्ठं\nसमुद्रमापः प्रविशन्ति यद्वत् ।\nतद्वत्कामा यं प्रविशन्ति सर्वे\nस शान्तिमाप्नोति न कामकामी ॥", iast: "āpūryamāṇamacalapratiṣṭhaṃ\nsamudramāpaḥ praviśanti yadvat |\ntadvatkāmā yaṃ praviśanti sarve\nsa śāntimāpnoti na kāmakāmī ||", transliteration: "āpūryamāṇam achala-pratiṣhṭhaṁ\nsamudram āpaḥ praviśhanti yadvat\ntadvat kāmā yaṁ praviśhanti sarve\nsa śhāntim āpnoti na kāma-kāmī", translation_en: "He attains peace into whom all desires enter, just as waters enter the ocean which, filled from all sides, remains unmoved; but not the man who is full of desires.", translation_hi: "जैसे सब ओर से परिपूर्ण अचल प्रतिष्ठा वाले समुद्र में (अनेक नदियों के) जल (उसे विचलित किये बिना) समा जाते हैं? वैसे ही जिस पुरुष के प्रति कामनाओं के विषय उसमें (विकार उत्पन्न किये बिना) समा जाते हैं? वह पुरुष शान्ति प्राप्त करता है? न कि भोगों की कामना करने वाला पुरुष।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_070.mp3"},
  {id: "BG_2.71", label: "BG 2.71", ref: "2.71", chapter: 2, verse: 71, speaker: "krishna", canonical: true, meter: "anustubh", sa: "विहाय कामान्यः सर्वान्पुमांश्चरति निःस्पृहः", snippet: "That person attains peace who, abandoning all desires, moves about without longing, without the sense of ownership, and without egoism.", sanskrit: "विहाय कामान्यः सर्वान्पुमांश्चरति निःस्पृहः ।\nनिर्ममो निरहंकारः स शांतिमधिगच्छति ॥", iast: "vihāya kāmānyaḥ sarvānpumāṃścarati niḥspṛhaḥ |\nnirmamo nirahaṃkāraḥ sa śāṃtimadhigacchati ||", transliteration: "vihāya kāmān yaḥ sarvān pumānśh charati niḥspṛihaḥ\nnirmamo nirahankāraḥ sa śhāntim adhigachchhati", translation_en: "That person attains peace who, abandoning all desires, moves about without longing, without the sense of ownership, and without egoism.", translation_hi: "जो पुरुष सब कामनाओं को त्यागकर स्पृहारहित? ममभाव रहित और निरहंकार हुआ विचरण करता है? वह शान्ति प्राप्त करता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_071.mp3"},
  {id: "BG_2.72", label: "BG 2.72", ref: "2.72", chapter: 2, verse: 72, speaker: "krishna", canonical: true, meter: "anustubh", sa: "एषा ब्राह्मी स्थितिः पार्थ नैनां प्राप्य विमुह्यति", snippet: "O son of Pritha, this is the eternal state, the Brahmic seat. Attaining this, one is not deluded. Being established in it, one attains oneness with Brahman even at the end of life.", sanskrit: "एषा ब्राह्मी स्थितिः पार्थ नैनां प्राप्य विमुह्यति ।\nस्थित्वाऽस्यामन्तकालेऽपि ब्रह्मनिर्वाणमृच्छति ॥", iast: "eṣā brāhmī sthitiḥ pārtha naināṃ prāpya vimuhyati |\nsthitvā’syāmantakāle’pi brahmanirvāṇamṛcchati ||", transliteration: "eṣhā brāhmī sthitiḥ pārtha naināṁ prāpya vimuhyati\nsthitvāsyām anta-kāle ’pi brahma-nirvāṇam ṛichchhati", translation_en: "O son of Pritha, this is the eternal state, the Brahmic seat. Attaining this, one is not deluded. Being established in it, one attains oneness with Brahman even at the end of life.", translation_hi: "हे पार्थ  यह ब्राह्मी स्थिति है। इसे प्राप्त कर पुरुष मोहित नहीं होता। अन्तकाल में भी इस निष्ठा में स्थित होकर ब्रह्मनिर्वाण (ब्रह्म के साथ एकत्व) को प्राप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/002_072.mp3"},
  {id: "BG_3.1", label: "BG 3.1", ref: "3.1", chapter: 3, verse: 1, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "ज्यायसी चेत्कर्मणस्ते मता बुद्धिर्जनार्दन", snippet: "Arjuna said: If Thou thinkest that knowledge is superior to action, O Krishna, why then, O Kesava, doest Thou ask me to engage in this terrible action?", sanskrit: "ज्यायसी चेत्कर्मणस्ते मता बुद्धिर्जनार्दन ।\nतत्किं कर्मणि घोरे मां नियोजयसि केशव ॥", iast: "jyāyasī cetkarmaṇaste matā buddhirjanārdana |\ntatkiṃ karmaṇi ghore māṃ niyojayasi keśava ||", transliteration: "jyāyasī chet karmaṇas te matā buddhir janārdana\ntat kiṁ karmaṇi ghore māṁ niyojayasi keśhava", translation_en: "Arjuna said: If Thou thinkest that knowledge is superior to action, O Krishna, why then, O Kesava, doest Thou ask me to engage in this terrible action?", translation_hi: "हे जनार्दन  यदि आपको यह मान्य है कि कर्म से ज्ञान श्रेष्ठ है तो फिर हे केशव  आप मुझे इस भयंकर कर्म में क्यों प्रवृत्त करते हैं", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_001.mp3"},
  {id: "BG_3.2", label: "BG 3.2", ref: "3.2", chapter: 3, verse: 2, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "व्यामिश्रेणेव वाक्येन बुद्धिं मोहयसीव मे", snippet: "With this seemingly perplexing speech, you seem to be confusing my understanding; therefore, tell me one certain way by which I may attain bliss.", sanskrit: "व्यामिश्रेणेव वाक्येन बुद्धिं मोहयसीव मे ।\nतदेकं वद निश्चित्य येन श्रेयोऽहमाप्नुयाम् ॥", iast: "vyāmiśreṇeva vākyena buddhiṃ mohayasīva me |\ntadekaṃ vada niścitya yena śreyo’hamāpnuyām ||", transliteration: "vyāmiśhreṇeva vākyena buddhiṁ mohayasīva me\ntad ekaṁ vada niśhchitya yena śhreyo ’ham āpnuyām", translation_en: "With this seemingly perplexing speech, you seem to be confusing my understanding; therefore, tell me one certain way by which I may attain bliss.", translation_hi: "आप इस मिश्रित वाक्य से मेरी बुद्धि को मोहितसा करते हैं अत आप उस एक (मार्ग) को निश्चित रूप से कहिये जिससे मैं परम श्रेय को प्राप्त कर सकूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_002.mp3"},
  {id: "BG_3.3", label: "BG 3.3", ref: "3.3", chapter: 3, verse: 3, speaker: "krishna", canonical: true, meter: "anustubh", sa: "लोकेऽस्मिन्द्विविधा निष्ठा पुरा प्रोक्ता मयानघ", snippet: "The Blessed Lord said, \"In this world, there is a twofold path, as I said before, O sinless one: the path of knowledge of the Sankhyas and the path of action of the Yogins.\"", sanskrit: "लोकेऽस्मिन्द्विविधा निष्ठा पुरा प्रोक्ता मयानघ ।\nज्ञानयोगेन सांख्यानां कर्मयोगेन योगिनाम् ॥", iast: "loke’smindvividhā niṣṭhā purā proktā mayānagha |\njñānayogena sāṃkhyānāṃ karmayogena yoginām ||", transliteration: "loke’smin dvi-vidhā niṣhṭhā purā proktā mayānagha\njñāna-yogena sāṅkhyānāṁ karma-yogena yoginām", translation_en: "The Blessed Lord said, \"In this world, there is a twofold path, as I said before, O sinless one: the path of knowledge of the Sankhyas and the path of action of the Yogins.\"", translation_hi: "श्री भगवान् ने कहा  हे निष्पाप (अनघ) अर्जुन  इस श्लोक में दो प्रकार की निष्ठा मेरे द्वारा पहले कही गयी है ज्ञानियों की (सांख्यानां) ज्ञानयोग से और योगियों की कर्मयोग से।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_003.mp3"},
  {id: "BG_3.4", label: "BG 3.4", ref: "3.4", chapter: 3, verse: 4, speaker: "krishna", canonical: true, meter: "anustubh", sa: "न कर्मणामनारम्भान्नैष्कर्म्यं पुरुषोऽश्नुते", snippet: "Man does not reach actionlessness by not performing actions; nor does he attain perfection by mere renunciation.", sanskrit: "न कर्मणामनारम्भान्नैष्कर्म्यं पुरुषोऽश्नुते ।\nन च संन्यसनादेव सिद्धिं समधिगच्छति ॥", iast: "na karmaṇāmanārambhānnaiṣkarmyaṃ puruṣo’śnute |\nna ca saṃnyasanādeva siddhiṃ samadhigacchati ||", transliteration: "na karmaṇām anārambhān naiṣhkarmyaṁ puruṣho ’śhnute\nna cha sannyasanād eva siddhiṁ samadhigachchhati", translation_en: "Man does not reach actionlessness by not performing actions; nor does he attain perfection by mere renunciation.", translation_hi: "कर्मों के न करने से मनुष्य नैर्ष्कम्य को प्राप्त नहीं होता और न कर्मों के संन्यास से ही वह सिद्धि (पूर्णत्व) प्राप्त करता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_004.mp3"},
  {id: "BG_3.5", label: "BG 3.5", ref: "3.5", chapter: 3, verse: 5, speaker: "krishna", canonical: true, meter: "anustubh", sa: "न हि कश्चित्क्षणमपि जातु तिष्ठत्यकर्मकृत्", snippet: "Verily, no one can remain for even a moment without performing action; for everyone is made to act helplessly, indeed, by the qualities born of Nature.", sanskrit: "न हि कश्चित्क्षणमपि जातु तिष्ठत्यकर्मकृत् ।\nकार्यते ह्यवशः कर्म सर्वः प्रकृतिजैर्गुणैः ॥", iast: "na hi kaścitkṣaṇamapi jātu tiṣṭhatyakarmakṛt |\nkāryate hyavaśaḥ karma sarvaḥ prakṛtijairguṇaiḥ ||", transliteration: "na hi kaśhchit kṣhaṇam api jātu tiṣhṭhatyakarma-kṛit\nkāryate hyavaśhaḥ karma sarvaḥ prakṛiti-jair guṇaiḥ", translation_en: "Verily, no one can remain for even a moment without performing action; for everyone is made to act helplessly, indeed, by the qualities born of Nature.", translation_hi: "कोई भी पुरुष कभी क्षणमात्र भी बिना कर्म किए नहीं रह सकता क्योंकि प्रकृति से उत्पन्न गुणों के द्वारा अवश हुए सब (पुरुषों) से कर्म करवा लिया जाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_005.mp3"},
  {id: "BG_3.6", label: "BG 3.6", ref: "3.6", chapter: 3, verse: 6, speaker: "krishna", canonical: true, meter: "anustubh", sa: "कर्मेन्द्रियाणि संयम्य य आस्ते मनसा स्मरन्", snippet: "He who, restraining the organs of action, sits thinking of the sense-objects in his mind, he of deluded understanding is called a hypocrite.", sanskrit: "कर्मेन्द्रियाणि संयम्य य आस्ते मनसा स्मरन् ।\nइन्द्रियार्थान्विमूढात्मा मिथ्याचारः स उच्यते ॥", iast: "karmendriyāṇi saṃyamya ya āste manasā smaran |\nindriyārthānvimūḍhātmā mithyācāraḥ sa ucyate ||", transliteration: "karmendriyāṇi sanyamya ya āste manasā smaran\nindriyārthān vimūḍhātmā mithyāchāraḥ sa uchyate", translation_en: "He who, restraining the organs of action, sits thinking of the sense-objects in his mind, he of deluded understanding is called a hypocrite.", translation_hi: "जो मूढ बुद्धि पुरुष कर्मेन्द्रियों का निग्रह कर इन्द्रियों के भोगों का मन से स्मरण (चिन्तन) करता रहता है वह मिथ्याचारी (दम्भी) कहा जाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_006.mp3"},
  {id: "BG_3.7", label: "BG 3.7", ref: "3.7", chapter: 3, verse: 7, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यस्त्विन्द्रियाणि मनसा नियम्यारभतेऽर्जुन", snippet: "But whoever, controlling the senses by the mind, O Arjuna, engages himself in Karma Yoga with the organs of action, without attachment, he excels.", sanskrit: "यस्त्विन्द्रियाणि मनसा नियम्यारभतेऽर्जुन ।\nकर्मेन्द्रियैः कर्मयोगमसक्तः स विशिष्यते ॥", iast: "yastvindriyāṇi manasā niyamyārabhate’rjuna |\nkarmendriyaiḥ karmayogamasaktaḥ sa viśiṣyate ||", transliteration: "yas tvindriyāṇi manasā niyamyārabhate ’rjuna\nkarmendriyaiḥ karma-yogam asaktaḥ sa viśhiṣhyate", translation_en: "But whoever, controlling the senses by the mind, O Arjuna, engages himself in Karma Yoga with the organs of action, without attachment, he excels.", translation_hi: "परन्तु हे अर्जुन  जो पुरुष मन से इन्द्रियों को वश में करके अनासक्त हुआ कर्मेंन्द्रियों से कर्मयोग का आचरण करता है वह श्रेष्ठ है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_007.mp3"},
  {id: "BG_3.8", label: "BG 3.8", ref: "3.8", chapter: 3, verse: 8, speaker: "krishna", canonical: true, meter: "anustubh", sa: "नियतं कुरु कर्म त्वं कर्म ज्यायो ह्यकर्मणः", snippet: "Perform your bounden duty, for action is superior to inaction, and even the maintenance of the body would not be possible for you through inaction.", sanskrit: "नियतं कुरु कर्म त्वं कर्म ज्यायो ह्यकर्मणः ।\nशरीरयात्रापि च ते न प्रसिद्ध्येदकर्मणः ॥", iast: "niyataṃ kuru karma tvaṃ karma jyāyo hyakarmaṇaḥ |\nśarīrayātrāpi ca te na prasiddhyedakarmaṇaḥ ||", transliteration: "niyataṁ kuru karma tvaṁ karma jyāyo hyakarmaṇaḥ\nśharīra-yātrāpi cha te na prasiddhyed akarmaṇaḥ", translation_en: "Perform your bounden duty, for action is superior to inaction, and even the maintenance of the body would not be possible for you through inaction.", translation_hi: "तुम (अपने) नियत (कर्तव्य) कर्म करो क्योंकि अकर्म से श्रेष्ठ कर्म है। तुम्हारे अकर्म होने से (तुम्हारा) शरीर निर्वाह भी नहीं सिद्ध होगा।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_008.mp3"},
  {id: "BG_3.9", label: "BG 3.9", ref: "3.9", chapter: 3, verse: 9, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यज्ञार्थात्कर्मणोऽन्यत्र लोकोऽयं कर्मबन्धनः", snippet: "The world is bound by actions other than those performed for the sake of sacrifice; do thou, therefore, O son of Kunti (Arjuna), perform actions for that sake alone, free from…", sanskrit: "यज्ञार्थात्कर्मणोऽन्यत्र लोकोऽयं कर्मबन्धनः ।\nतदर्थं कर्म कौन्तेय मुक्तसंगः समाचर ॥", iast: "yajñārthātkarmaṇo’nyatra loko’yaṃ karmabandhanaḥ |\ntadarthaṃ karma kaunteya muktasaṃgaḥ samācara ||", transliteration: "yajñārthāt karmaṇo ’nyatra loko ’yaṁ karma-bandhanaḥ\ntad-arthaṁ karma kaunteya mukta-saṅgaḥ samāchara", translation_en: "The world is bound by actions other than those performed for the sake of sacrifice; do thou, therefore, O son of Kunti (Arjuna), perform actions for that sake alone, free from attachment.", translation_hi: "यज्ञ के लिये किये हुए कर्म के अतिरिक्त अन्य कर्म में प्रवृत्त हुआ यह पुरुष कर्मों द्वारा बंधता है इसलिए हे कौन्तेय आसक्ति को त्यागकर यज्ञ के निमित्त ही कर्म का सम्यक् आचरण करो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_009.mp3"},
  {id: "BG_3.10", label: "BG 3.10", ref: "3.10", chapter: 3, verse: 10, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सहयज्ञाः प्रजाः सृष्ट्वा पुरोवाच प्रजापतिः", snippet: "The Creator, having in the beginning created mankind together with sacrifice, said, \"By this shall you propagate; let this be the milch cow of your desires—the cow that yields…", sanskrit: "सहयज्ञाः प्रजाः सृष्ट्वा पुरोवाच प्रजापतिः ।\nअनेन प्रसविष्यध्वमेष वोऽस्त्विष्टकामधुक् ॥", iast: "sahayajñāḥ prajāḥ sṛṣṭvā purovāca prajāpatiḥ |\nanena prasaviṣyadhvameṣa vo’stviṣṭakāmadhuk ||", transliteration: "saha-yajñāḥ prajāḥ sṛiṣhṭvā purovācha prajāpatiḥ\nanena prasaviṣhyadhvam eṣha vo ’stviṣhṭa-kāma-dhuk", translation_en: "The Creator, having in the beginning created mankind together with sacrifice, said, \"By this shall you propagate; let this be the milch cow of your desires—the cow that yields all the desired objects.\"", translation_hi: "प्रजापति (सृष्टिकर्त्ता) ने (सृष्टि के) आदि में यज्ञ सहित प्रजा का निर्माण कर कहा इस यज्ञ द्वारा तुम वृद्धि को प्राप्त हो और यह यज्ञ तुम्हारे लिये इच्छित कामनाओं को पूर्ण करने वाला (इष्टकामधुक्) होवे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_010.mp3"},
  {id: "BG_3.11", label: "BG 3.11", ref: "3.11", chapter: 3, verse: 11, speaker: "krishna", canonical: true, meter: "anustubh", sa: "देवान्भावयतानेन ते देवा भावयन्तु वः", snippet: "With this, nourish the gods, and may the gods nourish you; thus, nourishing each other, you shall attain the highest good.", sanskrit: "देवान्भावयतानेन ते देवा भावयन्तु वः ।\nपरस्परं भावयन्तः श्रेयः परमवाप्स्यथ ॥", iast: "devānbhāvayatānena te devā bhāvayantu vaḥ |\nparasparaṃ bhāvayantaḥ śreyaḥ paramavāpsyatha ||", transliteration: "devān bhāvayatānena te devā bhāvayantu vaḥ\nparasparaṁ bhāvayantaḥ śhreyaḥ param avāpsyatha", translation_en: "With this, nourish the gods, and may the gods nourish you; thus, nourishing each other, you shall attain the highest good.", translation_hi: "तुम लोग इस यज्ञ द्वारा देवताओं की उन्नति करो और वे देवतागण तुम्हारी उन्नति करें। इस प्रकार परस्पर उन्नति करते हुये परम श्रेय को तुम प्राप्त होगे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_011.mp3"},
  {id: "BG_3.12", label: "BG 3.12", ref: "3.12", chapter: 3, verse: 12, speaker: "krishna", canonical: true, meter: "anustubh", sa: "इष्टान्भोगान्हि वो देवा दास्यन्ते यज्ञभाविताः", snippet: "The gods, nourished by the sacrifice, will give you the desired objects. So, he who enjoys the objects given by the gods without offering anything in return is indeed a thief.", sanskrit: "इष्टान्भोगान्हि वो देवा दास्यन्ते यज्ञभाविताः ।\nतैर्दत्तानप्रदायैभ्यो यो भुङ्क्ते स्तेन एव सः ॥", iast: "iṣṭānbhogānhi vo devā dāsyante yajñabhāvitāḥ |\ntairdattānapradāyaibhyo yo bhuṅkte stena eva saḥ ||", transliteration: "iṣhṭān bhogān hi vo devā dāsyante yajña-bhāvitāḥ\ntair dattān apradāyaibhyo yo bhuṅkte stena eva saḥ", translation_en: "The gods, nourished by the sacrifice, will give you the desired objects. So, he who enjoys the objects given by the gods without offering anything in return is indeed a thief.", translation_hi: "यज्ञ द्वारा पोषित देवतागण तुम्हें इष्ट भोग प्रदान करेंगे। उनके द्वारा दिये हुये भोगों को जो पुरुष उनको दिये बिना ही भोगता है वह निश्चय ही चोर है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_012.mp3"},
  {id: "BG_3.13", label: "BG 3.13", ref: "3.13", chapter: 3, verse: 13, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यज्ञशिष्टाशिनः सन्तो मुच्यन्ते सर्वकिल्बिषैः", snippet: "The righteous who eat the remnants of the sacrifice are freed from all sins; but those sinful ones who cook food solely for their own sake indeed consume sin.", sanskrit: "यज्ञशिष्टाशिनः सन्तो मुच्यन्ते सर्वकिल्बिषैः ।\nभुञ्जते ते त्वघं पापा ये पचन्त्यात्मकारणात् ॥", iast: "yajñaśiṣṭāśinaḥ santo mucyante sarvakilbiṣaiḥ |\nbhuñjate te tvaghaṃ pāpā ye pacantyātmakāraṇāt ||", transliteration: "yajña-śhiṣhṭāśhinaḥ santo muchyante sarva-kilbiṣhaiḥ\nbhuñjate te tvaghaṁ pāpā ye pachantyātma-kāraṇāt", translation_en: "The righteous who eat the remnants of the sacrifice are freed from all sins; but those sinful ones who cook food solely for their own sake indeed consume sin.", translation_hi: "यज्ञ के अवशिष्ट अन्न को खाने वाले श्रेष्ठ पुरुष सब पापों से मुक्त हो जाते हैं किन्तु जो लोग केवल स्वयं के लिये ही पकाते हैं वे तो पापों को ही खाते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_013.mp3"},
  {id: "BG_3.14", label: "BG 3.14", ref: "3.14", chapter: 3, verse: 14, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अन्नाद्भवन्ति भूतानि पर्जन्यादन्नसम्भवः", snippet: "From food come forth beings; from rain, food is produced; from sacrifice arises rain, and sacrifice is born of action.", sanskrit: "अन्नाद्भवन्ति भूतानि पर्जन्यादन्नसम्भवः ।\nयज्ञाद्भवति पर्जन्यो यज्ञः कर्मसमुद्भवः ॥", iast: "annādbhavanti bhūtāni parjanyādannasambhavaḥ |\nyajñādbhavati parjanyo yajñaḥ karmasamudbhavaḥ ||", transliteration: "annād bhavanti bhūtāni parjanyād anna-sambhavaḥ\nyajñād bhavati parjanyo yajñaḥ karma-samudbhavaḥ", translation_en: "From food come forth beings; from rain, food is produced; from sacrifice arises rain, and sacrifice is born of action.", translation_hi: "समस्त प्राणी अन्न से उत्पन्न होते हैं अन्न की उत्पत्ति पर्जन्य से। पर्जन्य की उत्पत्ति यज्ञ से और यज्ञ कर्मों से उत्पन्न होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_014.mp3"},
  {id: "BG_3.15", label: "BG 3.15", ref: "3.15", chapter: 3, verse: 15, speaker: "krishna", canonical: true, meter: "anustubh", sa: "कर्म ब्रह्मोद्भवं विद्धि ब्रह्माक्षरसमुद्भवम्", snippet: "Know that action comes from Brahma, and Brahma comes from the Imperishable. Therefore, the all-pervasive Brahma ever rests in sacrifice.", sanskrit: "कर्म ब्रह्मोद्भवं विद्धि ब्रह्माक्षरसमुद्भवम् ।\nतस्मात्सर्वगतं ब्रह्म नित्यं यज्ञे प्रतिष्ठितम् ॥", iast: "karma brahmodbhavaṃ viddhi brahmākṣarasamudbhavam |\ntasmātsarvagataṃ brahma nityaṃ yajñe pratiṣṭhitam ||", transliteration: "karma brahmodbhavaṁ viddhi brahmākṣhara-samudbhavam\ntasmāt sarva-gataṁ brahma nityaṁ yajñe pratiṣhṭhitam", translation_en: "Know that action comes from Brahma, and Brahma comes from the Imperishable. Therefore, the all-pervasive Brahma ever rests in sacrifice.", translation_hi: "कर्म की उत्पत्ति ब्रह्माजी से होती है और ब्रह्माजी अक्षर तत्त्व से व्यक्त होते हैं। इसलिये सर्व व्यापी ब्रह्म सदा ही यज्ञ में प्रतिष्ठित है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_015.mp3"},
  {id: "BG_3.16", label: "BG 3.16", ref: "3.16", chapter: 3, verse: 16, speaker: "krishna", canonical: true, meter: "anustubh", sa: "एवं प्रवर्तितं चक्रं नानुवर्तयतीह यः", snippet: "He who does not follow the wheel thus set in motion, who is of sinful life, rejoicing in the senses, lives in vain, O Arjuna.", sanskrit: "एवं प्रवर्तितं चक्रं नानुवर्तयतीह यः ।\nअघायुरिन्द्रियारामो मोघं पार्थ स जीवति ॥", iast: "evaṃ pravartitaṃ cakraṃ nānuvartayatīha yaḥ |\naghāyurindriyārāmo moghaṃ pārtha sa jīvati ||", transliteration: "evaṁ pravartitaṁ chakraṁ nānuvartayatīha yaḥ\naghāyur indriyārāmo moghaṁ pārtha sa jīvati", translation_en: "He who does not follow the wheel thus set in motion, who is of sinful life, rejoicing in the senses, lives in vain, O Arjuna.", translation_hi: "जो पुरुष यहाँ इस प्रकार प्रवर्तित हुए चक्र का अनुवर्तन नहीं करता हे पार्थ इंन्द्रियों में रमने वाला वह पाप आयु पुरुष व्यर्थ ही जीता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_016.mp3"},
  {id: "BG_3.17", label: "BG 3.17", ref: "3.17", chapter: 3, verse: 17, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यस्त्वात्मरतिरेव स्यादात्मतृप्तश्च मानवः", snippet: "But for that man who rejoices only in the Self, who is satisfied with the Self and is content in the Self alone, indeed there is nothing to do.", sanskrit: "यस्त्वात्मरतिरेव स्यादात्मतृप्तश्च मानवः ।\nआत्मन्येव च सन्तुष्टस्तस्य कार्यं न विद्यते ॥", iast: "yastvātmaratireva syādātmatṛptaśca mānavaḥ |\nātmanyeva ca santuṣṭastasya kāryaṃ na vidyate ||", transliteration: "yas tvātma-ratir eva syād ātma-tṛiptaśh cha mānavaḥ\nātmanyeva cha santuṣhṭas tasya kāryaṁ na vidyate", translation_en: "But for that man who rejoices only in the Self, who is satisfied with the Self and is content in the Self alone, indeed there is nothing to do.", translation_hi: "परन्तु जो मनुष्य आत्मा में ही रमने वाला आत्मा में ही तृप्त तथा आत्मा में ही सन्तुष्ट हो उसके लिये कोई कर्तव्य नहीं रहता।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_017.mp3"},
  {id: "BG_3.18", label: "BG 3.18", ref: "3.18", chapter: 3, verse: 18, speaker: "krishna", canonical: true, meter: "anustubh", sa: "नैव तस्य कृतेनार्थो नाकृतेनेह कश्चन", snippet: "For him, there is no interest whatsoever in what is done or not done; nor does he depend on any being for any purpose.", sanskrit: "नैव तस्य कृतेनार्थो नाकृतेनेह कश्चन ।\nन चास्य सर्वभूतेषु कश्चिदर्थव्यपाश्रयः ॥", iast: "naiva tasya kṛtenārtho nākṛteneha kaścana |\nna cāsya sarvabhūteṣu kaścidarthavyapāśrayaḥ ||", transliteration: "naiva tasya kṛitenārtho nākṛiteneha kaśhchana\nna chāsya sarva-bhūteṣhu kaśhchid artha-vyapāśhrayaḥ", translation_en: "For him, there is no interest whatsoever in what is done or not done; nor does he depend on any being for any purpose.", translation_hi: "इस जगत् में उस पुरुष का कृत और अकृत से कोई प्रयोजन नहीं है और न वह किसी वस्तु के लिये भूतमात्र पर आश्रित होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_018.mp3"},
  {id: "BG_3.19", label: "BG 3.19", ref: "3.19", chapter: 3, verse: 19, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तस्मादसक्तः सततं कार्यं कर्म समाचर", snippet: "Therefore, without attachment, always perform the actions that should be done; for by performing actions without attachment, one reaches the Supreme.", sanskrit: "तस्मादसक्तः सततं कार्यं कर्म समाचर ।\nअसक्तो ह्याचरन्कर्म परमाप्नोति पूरुषः ॥", iast: "tasmādasaktaḥ satataṃ kāryaṃ karma samācara |\nasakto hyācarankarma paramāpnoti pūruṣaḥ ||", transliteration: "tasmād asaktaḥ satataṁ kāryaṁ karma samāchara\nasakto hyācharan karma param āpnoti pūruṣhaḥ", translation_en: "Therefore, without attachment, always perform the actions that should be done; for by performing actions without attachment, one reaches the Supreme.", translation_hi: "इसलिए,  तुम अनासक्त होकर सदैव कर्तव्य कर्म का सम्यक् आचरण करो;  क्योकि,  अनासक्त पुरुष कर्म करता हुआ परमात्मा को प्राप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_019.mp3"},
  {id: "BG_3.20", label: "BG 3.20", ref: "3.20", chapter: 3, verse: 20, speaker: "krishna", canonical: true, meter: "anustubh", sa: "कर्मणैव हि संसिद्धिमास्थिता जनकादयः", snippet: "Janaka and others attained perfection indeed through action alone; even with the intention of protecting the masses, you should perform action.", sanskrit: "कर्मणैव हि संसिद्धिमास्थिता जनकादयः ।\nलोकसंग्रहमेवापि संपश्यन्कर्तुमर्हसि ॥", iast: "karmaṇaiva hi saṃsiddhimāsthitā janakādayaḥ |\nlokasaṃgrahamevāpi saṃpaśyankartumarhasi ||", transliteration: "karmaṇaiva hi sansiddhim āsthitā janakādayaḥ\nloka-saṅgraham evāpi sampaśhyan kartum arhasi", translation_en: "Janaka and others attained perfection indeed through action alone; even with the intention of protecting the masses, you should perform action.", translation_hi: "जनकादि (ज्ञानी जन) भी कर्म द्वारा ही संसिद्धि को प्राप्त हुये लोक संग्रह (लोक रक्षण) को भी देखते हुये;  तुम कर्म करने योग्य हो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_020.mp3"},
  {id: "BG_3.21", label: "BG 3.21", ref: "3.21", chapter: 3, verse: 21, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यद्यदाचरति श्रेष्ठस्तत्तदेवेतरो जनः", snippet: "Whatever a great man does, others also do; whatever he establishes as the standard, the world follows.", sanskrit: "यद्यदाचरति श्रेष्ठस्तत्तदेवेतरो जनः ।\nस यत्प्रमाणं कुरुते लोकस्तदनुवर्तते ॥", iast: "yadyadācarati śreṣṭhastattadevetaro janaḥ |\nsa yatpramāṇaṃ kurute lokastadanuvartate ||", transliteration: "yad yad ācharati śhreṣhṭhas tat tad evetaro janaḥ\nsa yat pramāṇaṁ kurute lokas tad anuvartate", translation_en: "Whatever a great man does, others also do; whatever he establishes as the standard, the world follows.", translation_hi: "श्रेष्ठ पुरुष जैसा आचरण करता है, अन्य लोग भी वैसा ही अनुकरण करते हैं; वह पुरुष जो कुछ प्रमाण कर देता है, लोग भी उसका अनुसरण करते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_021.mp3"},
  {id: "BG_3.22", label: "BG 3.22", ref: "3.22", chapter: 3, verse: 22, speaker: "krishna", canonical: true, meter: "anustubh", sa: "न मे पार्थास्ति कर्तव्यं त्रिषु लोकेषु किञ्चन", snippet: "There is nothing in the three worlds, O Arjuna, that needs to be done by Me, nor is there anything unattained that needs to be attained; yet I engage Myself in action.", sanskrit: "न मे पार्थास्ति कर्तव्यं त्रिषु लोकेषु किञ्चन ।\nनानवाप्तमवाप्तव्यं वर्त एव च कर्मणि ॥", iast: "na me pārthāsti kartavyaṃ triṣu lokeṣu kiñcana |\nnānavāptamavāptavyaṃ varta eva ca karmaṇi ||", transliteration: "na me pārthāsti kartavyaṁ triṣhu lokeṣhu kiñchana\nnānavāptam avāptavyaṁ varta eva cha karmaṇi", translation_en: "There is nothing in the three worlds, O Arjuna, that needs to be done by Me, nor is there anything unattained that needs to be attained; yet I engage Myself in action.", translation_hi: "यद्यपि मुझे त्रैलोक्य में कुछ भी कर्तव्य नहीं हैं तथा किंचित भी प्राप्त होने योग्य (अवाप्तव्यम्) वस्तु अप्राप्त नहीं है, तो भी मैं कर्म में ही बर्तता हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_022.mp3"},
  {id: "BG_3.23", label: "BG 3.23", ref: "3.23", chapter: 3, verse: 23, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यदि ह्यहं न वर्तेयं जातु कर्मण्यतन्द्रितः", snippet: "For, should I not ever engage myself in action, unwearied, people would in every way follow my path, O Arjuna.", sanskrit: "यदि ह्यहं न वर्तेयं जातु कर्मण्यतन्द्रितः ।\nमम वर्त्मानुवर्तन्ते मनुष्याः पार्थ सर्वशः ॥", iast: "yadi hyahaṃ na varteyaṃ jātu karmaṇyatandritaḥ |\nmama vartmānuvartante manuṣyāḥ pārtha sarvaśaḥ ||", transliteration: "yadi hyahaṁ na varteyaṁ jātu karmaṇyatandritaḥ\nmama vartmānuvartante manuṣhyāḥ pārtha sarvaśhaḥ", translation_en: "For, should I not ever engage myself in action, unwearied, people would in every way follow my path, O Arjuna.", translation_hi: "यदि मैं सावधान हुआ (अतन्द्रित:) कदाचित कर्म में न लगा रहूँ तो, हे पार्थ ! सब प्रकार से मनुष्य मेरे मार्ग (र्वत्म) का अनुसरण करेंगे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_023.mp3"},
  {id: "BG_3.24", label: "BG 3.24", ref: "3.24", chapter: 3, verse: 24, speaker: "krishna", canonical: true, meter: "anustubh", sa: "उत्सीदेयुरिमे लोका न कुर्यां कर्म चेदहम्", snippet: "These worlds would perish if I did not perform action; I would be the author of confusion of castes and destruction of these beings.", sanskrit: "उत्सीदेयुरिमे लोका न कुर्यां कर्म चेदहम् ।\nसङ्करस्य च कर्ता स्यामुपहन्यामिमाः प्रजाः ॥", iast: "utsīdeyurime lokā na kuryāṃ karma cedaham |\nsaṅkarasya ca kartā syāmupahanyāmimāḥ prajāḥ ||", transliteration: "utsīdeyur ime lokā na kuryāṁ karma ched aham\nsankarasya cha kartā syām upahanyām imāḥ prajāḥ", translation_en: "These worlds would perish if I did not perform action; I would be the author of confusion of castes and destruction of these beings.", translation_hi: "यदि मैं कर्म न करूँ, तो ये समस्त लोक नष्ट हो जायेंगे; और मैं वर्णसंकर का कर्ता तथा इस प्रजा का हनन करने वाला होऊँगा।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_024.mp3"},
  {id: "BG_3.25", label: "BG 3.25", ref: "3.25", chapter: 3, verse: 25, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सक्ताः कर्मण्यविद्वांसो यथा कुर्वन्ति भारत", snippet: "As the ignorant act out of attachment to action, O Bharata, so should the wise act without attachment, wishing for the welfare of the world.", sanskrit: "सक्ताः कर्मण्यविद्वांसो यथा कुर्वन्ति भारत ।\nकुर्याद्विद्वांस्तथासक्तश्चिकीर्षुर्लोकसंग्रहम् ॥", iast: "saktāḥ karmaṇyavidvāṃso yathā kurvanti bhārata |\nkuryādvidvāṃstathāsaktaścikīrṣurlokasaṃgraham ||", transliteration: "saktāḥ karmaṇyavidvānso yathā kurvanti bhārata\nkuryād vidvāns tathāsaktaśh chikīrṣhur loka-saṅgraham", translation_en: "As the ignorant act out of attachment to action, O Bharata, so should the wise act without attachment, wishing for the welfare of the world.", translation_hi: "हे भारत ! कर्म में आसक्त हुए अज्ञानीजन जैसे कर्म करते हैं वैसे ही विद्वान् पुरुष अनासक्त होकर, लोकसंग्रह (लोक कल्याण) की इच्छा से कर्म करे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_025.mp3"},
  {id: "BG_3.26", label: "BG 3.26", ref: "3.26", chapter: 3, verse: 26, speaker: "krishna", canonical: true, meter: "anustubh", sa: "न बुद्धिभेदं जनयेदज्ञानां कर्मसङ्गिनाम्", snippet: "Let no wise man unsettle the minds of ignorant people who are attached to action; he should engage them in all actions, himself fulfilling them with devotion.", sanskrit: "न बुद्धिभेदं जनयेदज्ञानां कर्मसङ्गिनाम् ।\nजोषयेत्सर्वकर्माणि विद्वान् युक्तः समाचरन् ॥", iast: "na buddhibhedaṃ janayedajñānāṃ karmasaṅginām |\njoṣayetsarvakarmāṇi vidvān yuktaḥ samācaran ||", transliteration: "na buddhi-bhedaṁ janayed ajñānāṁ karma-saṅginām\njoṣhayet sarva-karmāṇi vidvān yuktaḥ samācharan", translation_en: "Let no wise man unsettle the minds of ignorant people who are attached to action; he should engage them in all actions, himself fulfilling them with devotion.", translation_hi: "ज्ञानी पुरुष, कर्मों में आसक्त अज्ञानियों की बुद्धि में भ्रम उत्पन्न न करे, स्वयं (भक्ति से) युक्त होकर कर्मों का सम्यक् आचरण कर, उनसे भी वैसा ही कराये।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_026.mp3"},
  {id: "BG_3.27", label: "BG 3.27", ref: "3.27", chapter: 3, verse: 27, speaker: "krishna", canonical: true, meter: "anustubh", sa: "प्रकृतेः क्रियमाणानि गुणैः कर्माणि सर्वशः", snippet: "All actions are wrought in all cases by the qualities of Nature alone. He whose mind is deluded by egoism thinks, \"I am the doer.\"", sanskrit: "प्रकृतेः क्रियमाणानि गुणैः कर्माणि सर्वशः ।\nअहङ्कारविमूढात्मा कर्ताऽहमिति मन्यते ॥", iast: "prakṛteḥ kriyamāṇāni guṇaiḥ karmāṇi sarvaśaḥ |\nahaṅkāravimūḍhātmā kartā’hamiti manyate ||", transliteration: "prakṛiteḥ kriyamāṇāni guṇaiḥ karmāṇi sarvaśhaḥ\nahankāra-vimūḍhātmā kartāham iti manyate", translation_en: "All actions are wrought in all cases by the qualities of Nature alone. He whose mind is deluded by egoism thinks, \"I am the doer.\"", translation_hi: "सम्पूर्ण कर्म प्रकृति के गुणों द्वारा किये जाते हैं, अहंकार से मोहित हुआ पुरुष,  \"मैं कर्ता हूँ\"  ऐसा मान लेता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_027.mp3"},
  {id: "BG_3.28", label: "BG 3.28", ref: "3.28", chapter: 3, verse: 28, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तत्त्ववित्तु महाबाहो गुणकर्मविभागयोः", snippet: "But he who knows the Truth, O mighty-armed Arjuna, about the divisions of the qualities and their functions, knowing that the Gunas, as senses, move amidst the Gunas, as the…", sanskrit: "तत्त्ववित्तु महाबाहो गुणकर्मविभागयोः ।\nगुणा गुणेषु वर्तन्त इति मत्वा न सज्जते ॥", iast: "tattvavittu mahābāho guṇakarmavibhāgayoḥ |\nguṇā guṇeṣu vartanta iti matvā na sajjate ||", transliteration: "tattva-vit tu mahā-bāho guṇa-karma-vibhāgayoḥ\nguṇā guṇeṣhu vartanta iti matvā na sajjate", translation_en: "But he who knows the Truth, O mighty-armed Arjuna, about the divisions of the qualities and their functions, knowing that the Gunas, as senses, move amidst the Gunas, as the sense-objects, is not attached.", translation_hi: "परन्तु हे महाबाहो ! गुण और कर्म के विभाग के सत्य (तत्त्व)को जानने वाला ज्ञानी पुरुष यह जानकर कि \"गुण गुणों में बर्तते हैं\" (कर्म में) आसक्त नहीं होता।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_028.mp3"},
  {id: "BG_3.29", label: "BG 3.29", ref: "3.29", chapter: 3, verse: 29, speaker: "krishna", canonical: true, meter: "anustubh", sa: "प्रकृतेर्गुणसम्मूढाः सज्जन्ते गुणकर्मसु", snippet: "Those deluded by the qualities of Nature are attached to the functions of the qualities. The man of perfect knowledge should not unsettle the foolish one who is of imperfect…", sanskrit: "प्रकृतेर्गुणसम्मूढाः सज्जन्ते गुणकर्मसु ।\nतानकृत्स्नविदो मन्दान्कृत्स्नविन्न विचालयेत् ॥", iast: "prakṛterguṇasammūḍhāḥ sajjante guṇakarmasu |\ntānakṛtsnavido mandānkṛtsnavinna vicālayet ||", transliteration: "prakṛiter guṇa-sammūḍhāḥ sajjante guṇa-karmasu\ntān akṛitsna-vido mandān kṛitsna-vin na vichālayet", translation_en: "Those deluded by the qualities of Nature are attached to the functions of the qualities. The man of perfect knowledge should not unsettle the foolish one who is of imperfect knowledge.", translation_hi: "प्रकृति के गुणों से मोहित हुए पुरुष गुण और कर्म में आसक्त होते हैं, उन अपूर्ण ज्ञान वाले (अकृत्स्नविद:) मंदबुद्धि पुरुषों को पूर्ण ज्ञान प्राप्त पुरुष विचलित न करे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_029.mp3"},
  {id: "BG_3.30", label: "BG 3.30", ref: "3.30", chapter: 3, verse: 30, speaker: "krishna", canonical: true, meter: "anustubh", sa: "मयि सर्वाणि कर्माणि संन्यस्याध्यात्मचेतसा", snippet: "Renouncing all actions in Me, with the mind centered on the Self, free from hope and egoism, and from mental fever, fight thou.", sanskrit: "मयि सर्वाणि कर्माणि संन्यस्याध्यात्मचेतसा ।\nनिराशीर्निर्ममो भूत्वा युध्यस्व विगतज्वरः ॥", iast: "mayi sarvāṇi karmāṇi saṃnyasyādhyātmacetasā |\nnirāśīrnirmamo bhūtvā yudhyasva vigatajvaraḥ ||", transliteration: "mayi sarvāṇi karmāṇi sannyasyādhyātma-chetasā\nnirāśhīr nirmamo bhūtvā yudhyasva vigata-jvaraḥ", translation_en: "Renouncing all actions in Me, with the mind centered on the Self, free from hope and egoism, and from mental fever, fight thou.", translation_hi: "सम्पूर्ण कर्मों का मुझ में संन्यास करके,  आशा और ममता से रहित होकर,  संतापरहित हुए तुम युद्ध करो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_030.mp3"},
  {id: "BG_3.31", label: "BG 3.31", ref: "3.31", chapter: 3, verse: 31, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ये मे मतमिदं नित्यमनुतिष्ठन्ति मानवाः", snippet: "Those who constantly practice this teaching of Mine with faith and without caviling, they too are freed from actions.", sanskrit: "ये मे मतमिदं नित्यमनुतिष्ठन्ति मानवाः ।\nश्रद्धावन्तोऽनसूयन्तो मुच्यन्ते तेऽपि कर्मभिः ॥", iast: "ye me matamidaṃ nityamanutiṣṭhanti mānavāḥ |\nśraddhāvanto’nasūyanto mucyante te’pi karmabhiḥ ||", transliteration: "ye me matam idaṁ nityam anutiṣhṭhanti mānavāḥ\nśhraddhāvanto ’nasūyanto muchyante te ’pi karmabhiḥ", translation_en: "Those who constantly practice this teaching of Mine with faith and without caviling, they too are freed from actions.", translation_hi: "जो मनुष्य दोष बुद्धि से रहित (अनसूयन्त:) और श्रद्धा से युक्त हुए सदा मेरे इस मत (उपदेश) का अनुष्ठानपूर्वक पालन करते हैं, वे कर्मों से (बन्धन से) मुक्त हो जाते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_031.mp3"},
  {id: "BG_3.32", label: "BG 3.32", ref: "3.32", chapter: 3, verse: 32, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ये त्वेतदभ्यसूयन्तो नानुतिष्ठन्ति मे मतम्", snippet: "But those who criticize My teaching and do not practice it, deprived of all knowledge and lacking discernment, know them to be doomed to destruction.", sanskrit: "ये त्वेतदभ्यसूयन्तो नानुतिष्ठन्ति मे मतम् ।\nसर्वज्ञानविमूढांस्तान्विद्धि नष्टानचेतसः ॥", iast: "ye tvetadabhyasūyanto nānutiṣṭhanti me matam |\nsarvajñānavimūḍhāṃstānviddhi naṣṭānacetasaḥ ||", transliteration: "ye tvetad abhyasūyanto nānutiṣhṭhanti me matam\nsarva-jñāna-vimūḍhāns tān viddhi naṣhṭān achetasaḥ", translation_en: "But those who criticize My teaching and do not practice it, deprived of all knowledge and lacking discernment, know them to be doomed to destruction.", translation_hi: "परन्तु जो दोष दृष्टि वाले मूढ़ लोग इस मेरे मत का पालन नहीं करते, उन सब ज्ञानों में मोहित चित्तवालों को नष्ट हुये ही तुम समझो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_032.mp3"},
  {id: "BG_3.33", label: "BG 3.33", ref: "3.33", chapter: 3, verse: 33, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सदृशं चेष्टते स्वस्याः प्रकृतेर्ज्ञानवानपि", snippet: "Even a wise man acts in accordance with his own nature; beings will follow their nature; what can restraint do?", sanskrit: "सदृशं चेष्टते स्वस्याः प्रकृतेर्ज्ञानवानपि ।\nप्रकृतिं यान्ति भूतानि निग्रहः किं करिष्यति ॥", iast: "sadṛśaṃ ceṣṭate svasyāḥ prakṛterjñānavānapi |\nprakṛtiṃ yānti bhūtāni nigrahaḥ kiṃ kariṣyati ||", transliteration: "sadṛiśhaṁ cheṣhṭate svasyāḥ prakṛiter jñānavān api\nprakṛitiṁ yānti bhūtāni nigrahaḥ kiṁ kariṣhyati", translation_en: "Even a wise man acts in accordance with his own nature; beings will follow their nature; what can restraint do?", translation_hi: "ज्ञानवान् पुरुष भी अपनी प्रकृति के अनुसार चेष्टा करता है। सभी प्राणी अपनी प्रकृति पर ही जाते हैं, फिर इनमें (किसी का) निग्रह क्या करेगा।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_033.mp3"},
  {id: "BG_3.34", label: "BG 3.34", ref: "3.34", chapter: 3, verse: 34, speaker: "krishna", canonical: true, meter: "anustubh", sa: "इन्द्रियस्येन्द्रियस्यार्थे रागद्वेषौ व्यवस्थितौ", snippet: "Attachment and aversion for the objects of the senses abide in the senses; let no one come under their sway; for, they are his enemies.", sanskrit: "इन्द्रियस्येन्द्रियस्यार्थे रागद्वेषौ व्यवस्थितौ ।\nतयोर्न वशमागच्छेत्तौ ह्यस्य परिपन्थिनौ ॥", iast: "indriyasyendriyasyārthe rāgadveṣau vyavasthitau |\ntayorna vaśamāgacchettau hyasya paripanthinau ||", transliteration: "indriyasyendriyasyārthe rāga-dveṣhau vyavasthitau\ntayor na vaśham āgachchhet tau hyasya paripanthinau", translation_en: "Attachment and aversion for the objects of the senses abide in the senses; let no one come under their sway; for, they are his enemies.", translation_hi: "इन्द्रियइन्द्रिय (अर्थात् प्रत्येक इन्द्रिय) के विषय के प्रति (मन में) रागद्वेष रहते हैं;  मनुष्य को चाहिये कि वह उन दोनों के वश में न हो;  क्योंकि वे इसके (मनुष्य के) शत्रु हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_034.mp3"},
  {id: "BG_3.35", label: "BG 3.35", ref: "3.35", chapter: 3, verse: 35, speaker: "krishna", canonical: true, meter: "anustubh", sa: "श्रेयान्स्वधर्मो विगुणः परधर्मात्स्वनुष्ठितात्", snippet: "Better is one's own duty, though devoid of merit, than the duty of another well discharged. Better is death in one's own duty; the duty of another is fraught with fear.", sanskrit: "श्रेयान्स्वधर्मो विगुणः परधर्मात्स्वनुष्ठितात् ।\nस्वधर्मे निधनं श्रेयः परधर्मो भयावहः ॥", iast: "śreyānsvadharmo viguṇaḥ paradharmātsvanuṣṭhitāt |\nsvadharme nidhanaṃ śreyaḥ paradharmo bhayāvahaḥ ||", transliteration: "śhreyān swa-dharmo viguṇaḥ para-dharmāt sv-anuṣhṭhitāt\nswa-dharme nidhanaṁ śhreyaḥ para-dharmo bhayāvahaḥ", translation_en: "Better is one's own duty, though devoid of merit, than the duty of another well discharged. Better is death in one's own duty; the duty of another is fraught with fear.", translation_hi: "सम्यक् प्रकार से अनुष्ठित परधर्म की अपेक्षा गुणरहित स्वधर्म का पालन श्रेयष्कर है;  स्वधर्म में मरण कल्याणकारक है (किन्तु) परधर्म भय को देने वाला है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_035.mp3"},
  {id: "BG_3.36", label: "BG 3.36", ref: "3.36", chapter: 3, verse: 36, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "अथ केन प्रयुक्तोऽयं पापं चरति पूरुषः", snippet: "Arjuna said, \"But what compels man to commit sin, even against his wishes, O Varshneya (Krishna), as if constrained by force?\"", sanskrit: "अथ केन प्रयुक्तोऽयं पापं चरति पूरुषः ।\nअनिच्छन्नपि वार्ष्णेय बलादिव नियोजितः ॥", iast: "atha kena prayukto’yaṃ pāpaṃ carati pūruṣaḥ |\nanicchannapi vārṣṇeya balādiva niyojitaḥ ||", transliteration: "atha kena prayukto ’yaṁ pāpaṁ charati pūruṣhaḥ\nanichchhann api vārṣhṇeya balād iva niyojitaḥ", translation_en: "Arjuna said, \"But what compels man to commit sin, even against his wishes, O Varshneya (Krishna), as if constrained by force?\"", translation_hi: "अर्जुन ने कहा -- हे वार्ष्णेय ! फिर यह पुरुष बलपूर्वक बाध्य किये हुये के समान अनिच्छा होते हुये भी किसके द्वारा प्रेरित होकर पाप का आचरण करता है?", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_036.mp3"},
  {id: "BG_3.37", label: "BG 3.37", ref: "3.37", chapter: 3, verse: 37, speaker: "krishna", canonical: true, meter: "anustubh", sa: "काम एष क्रोध एष रजोगुणसमुद्भवः", snippet: "The Blessed Lord said, \"It is desire and it is anger, both of the quality of Rajas, all-devouring and all-sinful; know this as the foe here in this world.\"", sanskrit: "काम एष क्रोध एष रजोगुणसमुद्भवः ।\nमहाशनो महापाप्मा विद्ध्येनमिह वैरिणम् ॥", iast: "kāma eṣa krodha eṣa rajoguṇasamudbhavaḥ |\nmahāśano mahāpāpmā viddhyenamiha vairiṇam ||", transliteration: "kāma eṣha krodha eṣha rajo-guṇa-samudbhavaḥ\nmahāśhano mahā-pāpmā viddhyenam iha vairiṇam", translation_en: "The Blessed Lord said, \"It is desire and it is anger, both of the quality of Rajas, all-devouring and all-sinful; know this as the foe here in this world.\"", translation_hi: "श्रीभगवान् ने कहा -- रजोगुण में उत्पन्न हुई यह 'कामना' है,  यही क्रोध है; यह महाशना (जिसकी भूख बड़ी हो) और महापापी है, इसे ही तुम यहाँ (इस जगत् में) शत्रु जानो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_037.mp3"},
  {id: "BG_3.38", label: "BG 3.38", ref: "3.38", chapter: 3, verse: 38, speaker: "krishna", canonical: true, meter: "anustubh", sa: "धूमेनाव्रियते वह्निर्यथाऽऽदर्शो मलेन च", snippet: "As fire is enveloped by smoke, as a mirror is covered by dust, and as an embryo is surrounded by the amniotic sac, so is this enveloped by that.", sanskrit: "धूमेनाव्रियते वह्निर्यथाऽऽदर्शो मलेन च ।\nयथोल्बेनावृतो गर्भस्तथा तेनेदमावृतम् ॥", iast: "dhūmenāvriyate vahniryathā’’darśo malena ca |\nyatholbenāvṛto garbhastathā tenedamāvṛtam ||", transliteration: "dhūmenāvriyate vahnir yathādarśho malena cha\nyatholbenāvṛito garbhas tathā tenedam āvṛitam", translation_en: "As fire is enveloped by smoke, as a mirror is covered by dust, and as an embryo is surrounded by the amniotic sac, so is this enveloped by that.", translation_hi: "जैसे धुयें से अग्नि और धूलि से दर्पण ढक जाता है तथा जैसे भ्रूण गर्भाशय से ढका रहता है, वैसे उस (काम) के द्वारा यह (ज्ञान) आवृत होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_038.mp3"},
  {id: "BG_3.39", label: "BG 3.39", ref: "3.39", chapter: 3, verse: 39, speaker: "krishna", canonical: true, meter: "anustubh", sa: "आवृतं ज्ञानमेतेन ज्ञानिनो नित्यवैरिणा", snippet: "O Arjuna, wisdom is enveloped by this constant enemy of the wise, in the form of desire, which is insatiable like fire.", sanskrit: "आवृतं ज्ञानमेतेन ज्ञानिनो नित्यवैरिणा ।\nकामरूपेण कौन्तेय दुष्पूरेणानलेन च ॥", iast: "āvṛtaṃ jñānametena jñānino nityavairiṇā |\nkāmarūpeṇa kaunteya duṣpūreṇānalena ca ||", transliteration: "āvṛitaṁ jñānam etena jñānino nitya-vairiṇā\nkāma-rūpeṇa kaunteya duṣhpūreṇānalena cha", translation_en: "O Arjuna, wisdom is enveloped by this constant enemy of the wise, in the form of desire, which is insatiable like fire.", translation_hi: "हे कौन्तेय ! अग्नि के समान जिसको तृप्त करना कठिन है ऐसे कामरूप,  ज्ञानी के इस नित्य शत्रु द्वारा ज्ञान आवृत है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_039.mp3"},
  {id: "BG_3.40", label: "BG 3.40", ref: "3.40", chapter: 3, verse: 40, speaker: "krishna", canonical: true, meter: "anustubh", sa: "इन्द्रियाणि मनो बुद्धिरस्याधिष्ठानमुच्यते", snippet: "The senses, the mind, and the intellect are said to be its seat; through these, it deludes the embodied one, veiling their wisdom.", sanskrit: "इन्द्रियाणि मनो बुद्धिरस्याधिष्ठानमुच्यते ।\nएतैर्विमोहयत्येष ज्ञानमावृत्य देहिनम् ॥", iast: "indriyāṇi mano buddhirasyādhiṣṭhānamucyate |\netairvimohayatyeṣa jñānamāvṛtya dehinam ||", transliteration: "indriyāṇi mano buddhir asyādhiṣhṭhānam uchyate\netair vimohayatyeṣha jñānam āvṛitya dehinam", translation_en: "The senses, the mind, and the intellect are said to be its seat; through these, it deludes the embodied one, veiling their wisdom.", translation_hi: "इन्द्रियाँ,  मन और बुद्धि इसके निवास स्थान कहे जाते हैं;  यह काम इनके द्वारा ही ज्ञान को आच्छादित करके देही पुरुष को मोहित करता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_040.mp3"},
  {id: "BG_3.41", label: "BG 3.41", ref: "3.41", chapter: 3, verse: 41, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तस्मात्त्वमिन्द्रियाण्यादौ नियम्य भरतर्षभ", snippet: "Therefore, O best of the Bharatas, control your senses first and then kill this sinful thing, which destroys knowledge and realization.", sanskrit: "तस्मात्त्वमिन्द्रियाण्यादौ नियम्य भरतर्षभ ।\nपाप्मानं प्रजहि ह्येनं ज्ञानविज्ञाननाशनम् ॥", iast: "tasmāttvamindriyāṇyādau niyamya bharatarṣabha |\npāpmānaṃ prajahi hyenaṃ jñānavijñānanāśanam ||", transliteration: "tasmāt tvam indriyāṇyādau niyamya bharatarṣhabha\npāpmānaṁ prajahi hyenaṁ jñāna-vijñāna-nāśhanam", translation_en: "Therefore, O best of the Bharatas, control your senses first and then kill this sinful thing, which destroys knowledge and realization.", translation_hi: "इसलिये, हे अर्जुन ! तुम पहले इन्द्रियों को वश में करके, ज्ञान और विज्ञान के नाशक इस कामरूप पापी को नष्ट करो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_041.mp3"},
  {id: "BG_3.42", label: "BG 3.42", ref: "3.42", chapter: 3, verse: 42, speaker: "krishna", canonical: true, meter: "anustubh", sa: "इन्द्रियाणि पराण्याहुरिन्द्रियेभ्यः परं मनः", snippet: "They say that the senses are superior to the body; the mind is superior to the senses; the intellect is superior to the mind; and He (the Self) is superior even to the intellect.", sanskrit: "इन्द्रियाणि पराण्याहुरिन्द्रियेभ्यः परं मनः ।\nमनसस्तु परा बुद्धिर्यो बुद्धेः परतस्तु सः ॥", iast: "indriyāṇi parāṇyāhurindriyebhyaḥ paraṃ manaḥ |\nmanasastu parā buddhiryo buddheḥ paratastu saḥ ||", transliteration: "indriyāṇi parāṇyāhur indriyebhyaḥ paraṁ manaḥ\nmanasas tu parā buddhir yo buddheḥ paratas tu saḥ", translation_en: "They say that the senses are superior to the body; the mind is superior to the senses; the intellect is superior to the mind; and He (the Self) is superior even to the intellect.", translation_hi: "(शरीर से) परे (श्रेष्ठ) इन्द्रियाँ कही जाती हैं;  इन्द्रियों से परे मन है और मन से परे बुद्धि है, और जो बुद्धि से भी परे है, वह है आत्मा।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_042.mp3"},
  {id: "BG_3.43", label: "BG 3.43", ref: "3.43", chapter: 3, verse: 43, speaker: "krishna", canonical: true, meter: "anustubh", sa: "एवं बुद्धेः परं बुद्ध्वा संस्तभ्यात्मानमात्मना", snippet: "Thus, knowing Him who is superior to the intellect and restraining the self by the Self, slay thou, O mighty-armed Arjuna, the enemy in the form of desire, hard to conquer.", sanskrit: "एवं बुद्धेः परं बुद्ध्वा संस्तभ्यात्मानमात्मना ।\nजहि शत्रुं महाबाहो कामरूपं दुरासदम् ॥", iast: "evaṃ buddheḥ paraṃ buddhvā saṃstabhyātmānamātmanā |\njahi śatruṃ mahābāho kāmarūpaṃ durāsadam ||", transliteration: "evaṁ buddheḥ paraṁ buddhvā sanstabhyātmānam ātmanā\njahi śhatruṁ mahā-bāho kāma-rūpaṁ durāsadam", translation_en: "Thus, knowing Him who is superior to the intellect and restraining the self by the Self, slay thou, O mighty-armed Arjuna, the enemy in the form of desire, hard to conquer.", translation_hi: "इस प्रकार बुद्धि से परे (शुद्ध) आत्मा को जानकर आत्मा (बुद्धि) के द्वारा आत्मा (मन) को वश में करके, हे महाबाहो ! तुम इस दुर्जेय (दुरासदम्) कामरूप शत्रु को मारो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/003_043.mp3"},
  {id: "BG_4.1", label: "BG 4.1", ref: "4.1", chapter: 4, verse: 1, speaker: "krishna", canonical: true, meter: "anustubh", sa: "इमं विवस्वते योगं प्रोक्तवानहमव्ययम्", snippet: "The Blessed Lord said, \"I taught this imperishable Yoga to Vivasvan; he then told it to Manu; Manu proclaimed it to Ikshvaku.", sanskrit: "इमं विवस्वते योगं प्रोक्तवानहमव्ययम् ।\nविवस्वान् मनवे प्राह मनुरिक्ष्वाकवेऽब्रवीत् ॥", iast: "imaṃ vivasvate yogaṃ proktavānahamavyayam |\nvivasvān manave prāha manurikṣvākave’bravīt ||", transliteration: "imaṁ vivasvate yogaṁ proktavān aham avyayam\nvivasvān manave prāha manur ikṣhvākave ’bravīt", translation_en: "The Blessed Lord said, \"I taught this imperishable Yoga to Vivasvan; he then told it to Manu; Manu proclaimed it to Ikshvaku.", translation_hi: "श्रीभगवान् ने कहा ---  मैंने इस अविनाशी योग को विवस्वान् (सूर्य देवता) से कहा (सिखाया);  विवस्वान् ने मनु से कहा;  मनु ने इक्ष्वाकु से कहा।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_001.mp3"},
  {id: "BG_4.2", label: "BG 4.2", ref: "4.2", chapter: 4, verse: 2, speaker: "krishna", canonical: true, meter: "anustubh", sa: "एवं परम्पराप्राप्तमिमं राजर्षयो विदुः", snippet: "This, handed down in regular succession by the royal sages, was known. This Yoga, however, has been lost here over time, O Parantapa (burner of the foes).", sanskrit: "एवं परम्पराप्राप्तमिमं राजर्षयो विदुः ।\nस कालेनेह महता योगो नष्टः परन्तप ॥", iast: "evaṃ paramparāprāptamimaṃ rājarṣayo viduḥ |\nsa kāleneha mahatā yogo naṣṭaḥ parantapa ||", transliteration: "evaṁ paramparā-prāptam imaṁ rājarṣhayo viduḥ\nsa kāleneha mahatā yogo naṣhṭaḥ parantapa", translation_en: "This, handed down in regular succession by the royal sages, was known. This Yoga, however, has been lost here over time, O Parantapa (burner of the foes).", translation_hi: "इस प्रकार परम्परा से प्राप्त हुये इस योग को राजर्षियों ने जाना, (परन्तु) हे परन्तप ! वह योग बहुत काल (के अन्तराल) से यहाँ (इस लोक में) नष्टप्राय हो गया।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_002.mp3"},
  {id: "BG_4.3", label: "BG 4.3", ref: "4.3", chapter: 4, verse: 3, speaker: "krishna", canonical: true, meter: "anustubh", sa: "स एवायं मया तेऽद्य योगः प्रोक्तः पुरातनः", snippet: "That same ancient yoga has been today taught to you by me, for you are my devotee and my friend; it is the supreme secret.", sanskrit: "स एवायं मया तेऽद्य योगः प्रोक्तः पुरातनः ।\nभक्तोऽसि मे सखा चेति रहस्यं ह्येतदुत्तमम् ॥", iast: "sa evāyaṃ mayā te’dya yogaḥ proktaḥ purātanaḥ |\nbhakto’si me sakhā ceti rahasyaṃ hyetaduttamam ||", transliteration: "sa evāyaṁ mayā te ’dya yogaḥ proktaḥ purātanaḥ\nbhakto ’si me sakhā cheti rahasyaṁ hyetad uttamam", translation_en: "That same ancient yoga has been today taught to you by me, for you are my devotee and my friend; it is the supreme secret.", translation_hi: "वह ही यह पुरातन योग आज मैंने तुम्हें कहा (सिखाया) क्योंकि तुम मेरे भक्त और मित्र हो। यह उत्तम रहस्य है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_003.mp3"},
  {id: "BG_4.4", label: "BG 4.4", ref: "4.4", chapter: 4, verse: 4, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "अपरं भवतो जन्म परं जन्म विवस्वतः", snippet: "Arjuna said, \"Later was Thy birth, and prior to it was the birth of Vivasvan (the Sun); how am I to understand that Thou hast taught this Yoga from the beginning?\"", sanskrit: "अपरं भवतो जन्म परं जन्म विवस्वतः ।\nकथमेतद्विजानीयां त्वमादौ प्रोक्तवानिति ॥", iast: "aparaṃ bhavato janma paraṃ janma vivasvataḥ |\nkathametadvijānīyāṃ tvamādau proktavāniti ||", transliteration: "aparaṁ bhavato janma paraṁ janma vivasvataḥ\nkatham etad vijānīyāṁ tvam ādau proktavān iti", translation_en: "Arjuna said, \"Later was Thy birth, and prior to it was the birth of Vivasvan (the Sun); how am I to understand that Thou hast taught this Yoga from the beginning?\"", translation_hi: "अर्जुन ने कहा -- आपका जन्म अपर अर्थात् पश्चात का है और विवस्वान् का जन्म (आपके) पूर्व का है, इसलिये यह मैं कैसे जानूँ कि (सृष्टि के) आदि में आपने (इस योग को) कहा था?", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_004.mp3"},
  {id: "BG_4.5", label: "BG 4.5", ref: "4.5", chapter: 4, verse: 5, speaker: "krishna", canonical: true, meter: "anustubh", sa: "बहूनि मे व्यतीतानि जन्मानि तव चार्जुन", snippet: "The Blessed Lord said, \"Many births of Mine have passed, as well as of thine, O Arjuna; I know them all, but thou knowest not, O Parantapa (scorcher of foes).\"", sanskrit: "बहूनि मे व्यतीतानि जन्मानि तव चार्जुन ।\nतान्यहं वेद सर्वाणि न त्वं वेत्थ परन्तप ॥", iast: "bahūni me vyatītāni janmāni tava cārjuna |\ntānyahaṃ veda sarvāṇi na tvaṃ vettha parantapa ||", transliteration: "bahūni me vyatītāni janmāni tava chārjuna\ntānyahaṁ veda sarvāṇi na tvaṁ vettha parantapa", translation_en: "The Blessed Lord said, \"Many births of Mine have passed, as well as of thine, O Arjuna; I know them all, but thou knowest not, O Parantapa (scorcher of foes).\"", translation_hi: "श्रीभगवान् ने कहा -- हे अर्जुन ! मेरे और तुम्हारे बहुत से जन्म हो चुके हैं, (परन्तु) हे परन्तप ! उन सबको मैं जानता हूँ और तुम नहीं जानते।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_005.mp3"},
  {id: "BG_4.6", label: "BG 4.6", ref: "4.6", chapter: 4, verse: 6, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अजोऽपि सन्नव्ययात्मा भूतानामीश्वरोऽपि सन्", snippet: "Though I am unborn and of imperishable nature, and though I am the Lord of all beings, yet, governing my own nature, I am born by my own Maya.", sanskrit: "अजोऽपि सन्नव्ययात्मा भूतानामीश्वरोऽपि सन् ।\nप्रकृतिं स्वामधिष्ठाय संभवाम्यात्ममायया ॥", iast: "ajo’pi sannavyayātmā bhūtānāmīśvaro’pi san |\nprakṛtiṃ svāmadhiṣṭhāya saṃbhavāmyātmamāyayā ||", transliteration: "ajo ’pi sannavyayātmā bhūtānām īśhvaro ’pi san\nprakṛitiṁ svām adhiṣhṭhāya sambhavāmyātma-māyayā", translation_en: "Though I am unborn and of imperishable nature, and though I am the Lord of all beings, yet, governing my own nature, I am born by my own Maya.", translation_hi: "यद्यपि मैं अजन्मा और अविनाशी स्वरूप हूँ और भूतमात्र का ईश्वर हूँ (तथापि) अपनी प्रकृति को अपने अधीन रखकर (अधिष्ठाय) मैं अपनी माया से जन्म लेता हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_006.mp3"},
  {id: "BG_4.7", label: "BG 4.7", ref: "4.7", chapter: 4, verse: 7, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यदा यदा हि धर्मस्य ग्लानिर्भवति भारत", snippet: "Whenever there is a decline of righteousness and an increase of unrighteousness, O Arjuna, then I manifest Myself.", sanskrit: "यदा यदा हि धर्मस्य ग्लानिर्भवति भारत ।\nअभ्युत्थानमधर्मस्य तदाऽऽत्मानं सृजाम्यहम् ॥", iast: "yadā yadā hi dharmasya glānirbhavati bhārata |\nabhyutthānamadharmasya tadā’’tmānaṃ sṛjāmyaham ||", transliteration: "yadā yadā hi dharmasya glānir bhavati bhārata\nabhyutthānam adharmasya tadātmānaṁ sṛijāmyaham", translation_en: "Whenever there is a decline of righteousness and an increase of unrighteousness, O Arjuna, then I manifest Myself.", translation_hi: "हे भारत ! जब-जब धर्म की हानि और अधर्म की वृद्धि होती है,  तब-तब मैं स्वयं को प्रकट करता हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_007.mp3"},
  {id: "BG_4.8", label: "BG 4.8", ref: "4.8", chapter: 4, verse: 8, speaker: "krishna", canonical: true, meter: "anustubh", sa: "परित्राणाय साधूनां विनाशाय च दुष्कृताम्", snippet: "For the protection of the good, for the destruction of the wicked, and for the establishment of righteousness, I am born in every age.", sanskrit: "परित्राणाय साधूनां विनाशाय च दुष्कृताम् ।\nधर्मसंस्थापनार्थाय संभवामि युगे युगे ॥", iast: "paritrāṇāya sādhūnāṃ vināśāya ca duṣkṛtām |\ndharmasaṃsthāpanārthāya saṃbhavāmi yuge yuge ||", transliteration: "paritrāṇāya sādhūnāṁ vināśhāya cha duṣhkṛitām\ndharma-sansthāpanārthāya sambhavāmi yuge yuge", translation_en: "For the protection of the good, for the destruction of the wicked, and for the establishment of righteousness, I am born in every age.", translation_hi: "साधु पुरुषों के रक्षण,  दुष्कृत्य करने वालों के नाश,  तथा धर्म संस्थापना के लिये,  मैं प्रत्येक युग में प्रगट होता हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_008.mp3"},
  {id: "BG_4.9", label: "BG 4.9", ref: "4.9", chapter: 4, verse: 9, speaker: "krishna", canonical: true, meter: "anustubh", sa: "जन्म कर्म च मे दिव्यमेवं यो वेत्ति तत्त्वतः", snippet: "He who thus knows, in their true light, My divine birth and actions, having abandoned the body, is not born again; he comes to Me, O Arjuna.", sanskrit: "जन्म कर्म च मे दिव्यमेवं यो वेत्ति तत्त्वतः ।\nत्यक्त्वा देहं पुनर्जन्म नैति मामेति सोऽर्जुन ॥", iast: "janma karma ca me divyamevaṃ yo vetti tattvataḥ |\ntyaktvā dehaṃ punarjanma naiti māmeti so’rjuna ||", transliteration: "janma karma cha me divyam evaṁ yo vetti tattvataḥ\ntyaktvā dehaṁ punar janma naiti mām eti so ’rjuna", translation_en: "He who thus knows, in their true light, My divine birth and actions, having abandoned the body, is not born again; he comes to Me, O Arjuna.", translation_hi: "हे अर्जुन ! मेरा जन्म और कर्म दिव्य है,  इस प्रकार जो पुरुष तत्त्वत:  जानता है, वह शरीर को त्यागकर फिर जन्म को नहीं प्राप्त होता;  वह मुझे ही प्राप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_009.mp3"},
  {id: "BG_4.10", label: "BG 4.10", ref: "4.10", chapter: 4, verse: 10, speaker: "krishna", canonical: true, meter: "anustubh", sa: "वीतरागभयक्रोधा मन्मया मामुपाश्रिताः", snippet: "Freed from attachment, fear, and anger, absorbed in Me, taking refuge in Me, purified by the fire of knowledge, many have attained My Being.", sanskrit: "वीतरागभयक्रोधा मन्मया मामुपाश्रिताः ।\nबहवो ज्ञानतपसा पूता मद्भावमागताः ॥", iast: "vītarāgabhayakrodhā manmayā māmupāśritāḥ |\nbahavo jñānatapasā pūtā madbhāvamāgatāḥ ||", transliteration: "vīta-rāga-bhaya-krodhā man-mayā mām upāśhritāḥ\nbahavo jñāna-tapasā pūtā mad-bhāvam āgatāḥ", translation_en: "Freed from attachment, fear, and anger, absorbed in Me, taking refuge in Me, purified by the fire of knowledge, many have attained My Being.", translation_hi: "राग भय और क्रोध से रहित मनमय मेरे शरण हुए बहुत से पुरुष ज्ञान रुप तप से पवित्र‌ हुए मेरे स्वरुप को प्राप्त हुए हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_010.mp3"},
  {id: "BG_4.11", label: "BG 4.11", ref: "4.11", chapter: 4, verse: 11, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ये यथा मां प्रपद्यन्ते तांस्तथैव भजाम्यहम्", snippet: "In whatever way men approach Me, even so do I reward them; My path do men tread in all ways, O Arjuna.", sanskrit: "ये यथा मां प्रपद्यन्ते तांस्तथैव भजाम्यहम् ।\nमम वर्त्मानुवर्तन्ते मनुष्याः पार्थ सर्वशः ॥", iast: "ye yathā māṃ prapadyante tāṃstathaiva bhajāmyaham |\nmama vartmānuvartante manuṣyāḥ pārtha sarvaśaḥ ||", transliteration: "ye yathā māṁ prapadyante tāns tathaiva bhajāmyaham\nmama vartmānuvartante manuṣhyāḥ pārtha sarvaśhaḥ", translation_en: "In whatever way men approach Me, even so do I reward them; My path do men tread in all ways, O Arjuna.", translation_hi: "जो मुझे जैसे भजते हैं,  मैं उन पर वैसे ही अनुग्रह करता हूँ;  हे पार्थ सभी मनुष्य सब प्रकार से, मेरे ही मार्ग का अनुवर्तन करते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_011.mp3"},
  {id: "BG_4.12", label: "BG 4.12", ref: "4.12", chapter: 4, verse: 12, speaker: "krishna", canonical: true, meter: "anustubh", sa: "काङ्क्षन्तः कर्मणां सिद्धिं यजन्त इह देवताः", snippet: "Those who long for success in action in this world sacrifice to the gods; for success is quickly attained by men through action.", sanskrit: "काङ्क्षन्तः कर्मणां सिद्धिं यजन्त इह देवताः ।\nक्षिप्रं हि मानुषे लोके सिद्धिर्भवति कर्मजा ॥", iast: "kāṅkṣantaḥ karmaṇāṃ siddhiṃ yajanta iha devatāḥ |\nkṣipraṃ hi mānuṣe loke siddhirbhavati karmajā ||", transliteration: "kāṅkṣhantaḥ karmaṇāṁ siddhiṁ yajanta iha devatāḥ\nkṣhipraṁ hi mānuṣhe loke siddhir bhavati karmajā", translation_en: "Those who long for success in action in this world sacrifice to the gods; for success is quickly attained by men through action.", translation_hi: "(सामान्य मनुष्य) यहाँ (इस लोक में) कर्मों के फल को चाहते हुये देवताओं को पूजते हैं;  क्योंकि मनुष्य लोक में कर्मों के फल शीघ्र ही प्राप्त होते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_012.mp3"},
  {id: "BG_4.13", label: "BG 4.13", ref: "4.13", chapter: 4, verse: 13, speaker: "krishna", canonical: true, meter: "anustubh", sa: "चातुर्वर्ण्यं मया सृष्टं गुणकर्मविभागशः", snippet: "The fourfold caste has been created by Me according to the differentiation of Guna and Karma; though I am the author of it, know Me as non-doer and immutable.", sanskrit: "चातुर्वर्ण्यं मया सृष्टं गुणकर्मविभागशः ।\nतस्य कर्तारमपि मां विद्ध्यकर्तारमव्ययम् ॥", iast: "cāturvarṇyaṃ mayā sṛṣṭaṃ guṇakarmavibhāgaśaḥ |\ntasya kartāramapi māṃ viddhyakartāramavyayam ||", transliteration: "chātur-varṇyaṁ mayā sṛiṣhṭaṁ guṇa-karma-vibhāgaśhaḥ\ntasya kartāram api māṁ viddhyakartāram avyayam", translation_en: "The fourfold caste has been created by Me according to the differentiation of Guna and Karma; though I am the author of it, know Me as non-doer and immutable.", translation_hi: "गुण और कर्मों के विभाग से चातुर्वण्य मेरे द्वारा रचा गया है। यद्यपि मैं उसका कर्ता हूँ, तथापि तुम मुझे अकर्ता और अविनाशी जानो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_013.mp3"},
  {id: "BG_4.14", label: "BG 4.14", ref: "4.14", chapter: 4, verse: 14, speaker: "krishna", canonical: true, meter: "anustubh", sa: "न मां कर्माणि लिम्पन्ति न मे कर्मफले स्पृहा", snippet: "Actions do not taint Me, nor do I have a desire for the fruit of actions. He who knows Me thus is not bound by actions.", sanskrit: "न मां कर्माणि लिम्पन्ति न मे कर्मफले स्पृहा ।\nइति मां योऽभिजानाति कर्मभिर्न स बध्यते ॥", iast: "na māṃ karmāṇi limpanti na me karmaphale spṛhā |\niti māṃ yo’bhijānāti karmabhirna sa badhyate ||", transliteration: "na māṁ karmāṇi limpanti na me karma-phale spṛihā\niti māṁ yo ’bhijānāti karmabhir na sa badhyate", translation_en: "Actions do not taint Me, nor do I have a desire for the fruit of actions. He who knows Me thus is not bound by actions.", translation_hi: "कर्म मुझे लिप्त नहीं करते;  न मुझे कर्मफल में स्पृहा है। इस प्रकार मुझे जो जानता है, वह भी कर्मों से नहीं बन्धता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_014.mp3"},
  {id: "BG_4.15", label: "BG 4.15", ref: "4.15", chapter: 4, verse: 15, speaker: "krishna", canonical: true, meter: "anustubh", sa: "एवं ज्ञात्वा कृतं कर्म पूर्वैरपि मुमुक्षुभिः", snippet: "Having known this, the ancient seekers of freedom also performed action; therefore, do thou also perform action, as the ancients did in days of yore.", sanskrit: "एवं ज्ञात्वा कृतं कर्म पूर्वैरपि मुमुक्षुभिः ।\nकुरु कर्मैव तस्मात्त्वं पूर्वैः पूर्वतरं कृतम् ॥", iast: "evaṃ jñātvā kṛtaṃ karma pūrvairapi mumukṣubhiḥ |\nkuru karmaiva tasmāttvaṃ pūrvaiḥ pūrvataraṃ kṛtam ||", transliteration: "evaṁ jñātvā kṛitaṁ karma pūrvair api mumukṣhubhiḥ\nkuru karmaiva tasmāttvaṁ pūrvaiḥ pūrvataraṁ kṛitam", translation_en: "Having known this, the ancient seekers of freedom also performed action; therefore, do thou also perform action, as the ancients did in days of yore.", translation_hi: "पूर्व के मुमुक्ष पुरुषों द्वारा भी इस प्रकार जानकर ही कर्म किया गया है;  इसलिये तुम भी पूर्वजों द्वारा सदा से किये हुए कर्मों को ही करो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_015.mp3"},
  {id: "BG_4.16", label: "BG 4.16", ref: "4.16", chapter: 4, verse: 16, speaker: "krishna", canonical: true, meter: "anustubh", sa: "किं कर्म किमकर्मेति कवयोऽप्यत्र मोहिताः", snippet: "What is action? What is inaction? Even the wise are confused about this. Therefore, I shall teach you the nature of action and inaction, by knowing which you will be liberated…", sanskrit: "किं कर्म किमकर्मेति कवयोऽप्यत्र मोहिताः ।\nतत्ते कर्म प्रवक्ष्यामि यज्ज्ञात्वा मोक्ष्यसेऽशुभात् ॥", iast: "kiṃ karma kimakarmeti kavayo’pyatra mohitāḥ |\ntatte karma pravakṣyāmi yajjñātvā mokṣyase’śubhāt ||", transliteration: "kiṁ karma kim akarmeti kavayo ’pyatra mohitāḥ\ntat te karma pravakṣhyāmi yaj jñātvā mokṣhyase ’śhubhāt", translation_en: "What is action? What is inaction? Even the wise are confused about this. Therefore, I shall teach you the nature of action and inaction, by knowing which you will be liberated from the evil of Samsara, the wheel of birth and death.", translation_hi: "कर्म क्या है और अकर्म क्या है? इस विषय में बुद्धिमान पुरुष भी भ्रमित हो जाते हैं। इसलिये मैं तुम्हें कर्म कहूँगा,  (अर्थात् कर्म और अकर्म का स्वरूप समझाऊँगा) जिसको जानकर तुम अशुभ (संसार बन्धन) से मुक्त हो जाओगे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_016.mp3"},
  {id: "BG_4.17", label: "BG 4.17", ref: "4.17", chapter: 4, verse: 17, speaker: "krishna", canonical: true, meter: "anustubh", sa: "कर्मणो ह्यपि बोद्धव्यं बोद्धव्यं च विकर्मणः", snippet: "For verily, the true nature of action enjoined by the scriptures should be known, as well as that of forbidden or unlawful action, and of inaction; the nature of action is hard…", sanskrit: "कर्मणो ह्यपि बोद्धव्यं बोद्धव्यं च विकर्मणः ।\nअकर्मणश्च बोद्धव्यं गहना कर्मणो गतिः ॥", iast: "karmaṇo hyapi boddhavyaṃ boddhavyaṃ ca vikarmaṇaḥ |\nakarmaṇaśca boddhavyaṃ gahanā karmaṇo gatiḥ ||", transliteration: "karmaṇo hyapi boddhavyaṁ boddhavyaṁ cha vikarmaṇaḥ\nakarmaṇaśh cha boddhavyaṁ gahanā karmaṇo gatiḥ", translation_en: "For verily, the true nature of action enjoined by the scriptures should be known, as well as that of forbidden or unlawful action, and of inaction; the nature of action is hard to understand.", translation_hi: "कर्म का (स्वरूप) जानना चाहिये और विकर्म का (स्वरूप) भी जानना चाहिये ; (बोद्धव्यम्) तथा अकर्म का भी (स्वरूप) जानना चाहिये (क्योंकि) कर्म की गति गहन है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_017.mp3"},
  {id: "BG_4.18", label: "BG 4.18", ref: "4.18", chapter: 4, verse: 18, speaker: "krishna", canonical: true, meter: "anustubh", sa: "कर्मण्यकर्म यः पश्येदकर्मणि च कर्म यः", snippet: "He who sees inaction in action and action in inaction, he is wise among men; he is a yogi and performer of all actions.", sanskrit: "कर्मण्यकर्म यः पश्येदकर्मणि च कर्म यः ।\nस बुद्धिमान् मनुष्येषु स युक्तः कृत्स्नकर्मकृत् ॥", iast: "karmaṇyakarma yaḥ paśyedakarmaṇi ca karma yaḥ |\nsa buddhimān manuṣyeṣu sa yuktaḥ kṛtsnakarmakṛt ||", transliteration: "karmaṇyakarma yaḥ paśhyed akarmaṇi cha karma yaḥ\nsa buddhimān manuṣhyeṣhu sa yuktaḥ kṛitsna-karma-kṛit", translation_en: "He who sees inaction in action and action in inaction, he is wise among men; he is a yogi and performer of all actions.", translation_hi: "जो पुरुष कर्म में अकर्म और अकर्म में कर्म देखता है,  वह मनुष्यों में बुद्धिमान है,  वह योगी सम्पूर्ण कर्मों को करने वाला है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_018.mp3"},
  {id: "BG_4.19", label: "BG 4.19", ref: "4.19", chapter: 4, verse: 19, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यस्य सर्वे समारम्भाः कामसङ्कल्पवर्जिताः", snippet: "He whose undertakings are all devoid of desires and selfish purposes, and whose actions have been burned by the fire of knowledge, the wise call him a sage.", sanskrit: "यस्य सर्वे समारम्भाः कामसङ्कल्पवर्जिताः ।\nज्ञानाग्निदग्धकर्माणं तमाहुः पण्डितं बुधाः ॥", iast: "yasya sarve samārambhāḥ kāmasaṅkalpavarjitāḥ |\njñānāgnidagdhakarmāṇaṃ tamāhuḥ paṇḍitaṃ budhāḥ ||", transliteration: "yasya sarve samārambhāḥ kāma-saṅkalpa-varjitāḥ\njñānāgni-dagdha-karmāṇaṁ tam āhuḥ paṇḍitaṁ budhāḥ", translation_en: "He whose undertakings are all devoid of desires and selfish purposes, and whose actions have been burned by the fire of knowledge, the wise call him a sage.", translation_hi: "जिसके समस्त कार्य कामना और संकल्प से रहित हैं,  ऐसे उस ज्ञानरूप अग्नि के द्वारा भस्म हुये कर्मों वाले पुरुष को ज्ञानीजन पण्डित कहते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_019.mp3"},
  {id: "BG_4.20", label: "BG 4.20", ref: "4.20", chapter: 4, verse: 20, speaker: "krishna", canonical: true, meter: "anustubh", sa: "त्यक्त्वा कर्मफलासङ्गं नित्यतृप्तो निराश्रयः", snippet: "Having abandoned attachment to the fruits of the action, ever content, depending on nothing, he does not do anything even while being engaged in activity.", sanskrit: "त्यक्त्वा कर्मफलासङ्गं नित्यतृप्तो निराश्रयः ।\nकर्मण्यभिप्रवृत्तोऽपि नैव किञ्चित्करोति सः ॥", iast: "tyaktvā karmaphalāsaṅgaṃ nityatṛpto nirāśrayaḥ |\nkarmaṇyabhipravṛtto’pi naiva kiñcitkaroti saḥ ||", transliteration: "tyaktvā karma-phalāsaṅgaṁ nitya-tṛipto nirāśhrayaḥ\nkarmaṇyabhipravṛitto ’pi naiva kiñchit karoti saḥ", translation_en: "Having abandoned attachment to the fruits of the action, ever content, depending on nothing, he does not do anything even while being engaged in activity.", translation_hi: "जो पुरुष,  कर्मफलासक्ति को त्यागकर,  नित्यतृप्त और सब आश्रयों से रहित है वह कर्म में प्रवृत्त होते हुए भी (वास्तव में) कुछ भी नहीं करता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_020.mp3"},
  {id: "BG_4.21", label: "BG 4.21", ref: "4.21", chapter: 4, verse: 21, speaker: "krishna", canonical: true, meter: "anustubh", sa: "निराशीर्यतचित्तात्मा त्यक्तसर्वपरिग्रहः", snippet: "Without hope, controlling the mind and the self, having abandoned all covetousness, and performing only bodily actions, one incurs no sin.", sanskrit: "निराशीर्यतचित्तात्मा त्यक्तसर्वपरिग्रहः ।\nशारीरं केवलं कर्म कुर्वन्नाप्नोति किल्बिषम् ॥", iast: "nirāśīryatacittātmā tyaktasarvaparigrahaḥ |\nśārīraṃ kevalaṃ karma kurvannāpnoti kilbiṣam ||", transliteration: "nirāśhīr yata-chittātmā tyakta-sarva-parigrahaḥ\nśhārīraṁ kevalaṁ karma kurvan nāpnoti kilbiṣham", translation_en: "Without hope, controlling the mind and the self, having abandoned all covetousness, and performing only bodily actions, one incurs no sin.", translation_hi: "जो आशा रहित है तथा जिसने चित्त और आत्मा (शरीर) को संयमित किया है,  जिसने सब परिग्रहों का त्याग किया है,  ऐसा पुरुष शारीरिक कर्म करते हुए भी पाप को नहीं प्राप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_021.mp3"},
  {id: "BG_4.22", label: "BG 4.22", ref: "4.22", chapter: 4, verse: 22, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यदृच्छालाभसन्तुष्टो द्वन्द्वातीतो विमत्सरः", snippet: "Content with what comes to him without effort, free from the pairs of opposites and envy, even-minded in success and failure, he acts yet is not bound.", sanskrit: "यदृच्छालाभसन्तुष्टो द्वन्द्वातीतो विमत्सरः ।\nसमः सिद्धावसिद्धौ च कृत्वापि न निबध्यते ॥", iast: "yadṛcchālābhasantuṣṭo dvandvātīto vimatsaraḥ |\nsamaḥ siddhāvasiddhau ca kṛtvāpi na nibadhyate ||", transliteration: "yadṛichchhā-lābha-santuṣhṭo dvandvātīto vimatsaraḥ\nsamaḥ siddhāvasiddhau cha kṛitvāpi na nibadhyate", translation_en: "Content with what comes to him without effort, free from the pairs of opposites and envy, even-minded in success and failure, he acts yet is not bound.", translation_hi: "यदृच्छया (अपने आप) जो कुछ प्राप्त हो उसमें ही सन्तुष्ट रहने वाला,  द्वन्द्वों से अतीत तथा मत्सर से रहित,  सिद्धि व असिद्धि में समभाव वाला पुरुष कर्म करके भी नहीं बन्धता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_022.mp3"},
  {id: "BG_4.23", label: "BG 4.23", ref: "4.23", chapter: 4, verse: 23, speaker: "krishna", canonical: true, meter: "anustubh", sa: "गतसङ्गस्य मुक्तस्य ज्ञानावस्थितचेतसः", snippet: "To one who is devoid of attachment, who is liberated, whose mind is established in knowledge, and who works for the sake of sacrifice (for the sake of God), the whole action is…", sanskrit: "गतसङ्गस्य मुक्तस्य ज्ञानावस्थितचेतसः ।\nयज्ञायाचरतः कर्म समग्रं प्रविलीयते ॥", iast: "gatasaṅgasya muktasya jñānāvasthitacetasaḥ |\nyajñāyācarataḥ karma samagraṃ pravilīyate ||", transliteration: "gata-saṅgasya muktasya jñānāvasthita-chetasaḥ\nyajñāyācharataḥ karma samagraṁ pravilīyate", translation_en: "To one who is devoid of attachment, who is liberated, whose mind is established in knowledge, and who works for the sake of sacrifice (for the sake of God), the whole action is dissolved.", translation_hi: "जो आसक्तिरहित और मुक्त है,  जिसका चित्त ज्ञान में स्थित है,  यज्ञ के लिये आचरण करने वाले ऐसे पुरुष के समस्त कर्म लीन हो जाते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_023.mp3"},
  {id: "BG_4.24", label: "BG 4.24", ref: "4.24", chapter: 4, verse: 24, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ब्रह्मार्पणं ब्रह्महविर्ब्रह्माग्नौ ब्रह्मणा हुतम्", snippet: "Brahman is the oblation; Brahman is the melted butter (ghee); by Brahman is the oblation poured into the fire of Brahman; Brahman indeed shall be attained by one who always…", sanskrit: "ब्रह्मार्पणं ब्रह्महविर्ब्रह्माग्नौ ब्रह्मणा हुतम् ।\nब्रह्मैव तेन गन्तव्यं ब्रह्मकर्मसमाधिना ॥", iast: "brahmārpaṇaṃ brahmahavirbrahmāgnau brahmaṇā hutam |\nbrahmaiva tena gantavyaṃ brahmakarmasamādhinā ||", transliteration: "brahmārpaṇaṁ brahma havir brahmāgnau brahmaṇā hutam\nbrahmaiva tena gantavyaṁ brahma-karma-samādhinā", translation_en: "Brahman is the oblation; Brahman is the melted butter (ghee); by Brahman is the oblation poured into the fire of Brahman; Brahman indeed shall be attained by one who always sees Brahman in action.", translation_hi: "अर्पण (अर्थात् अर्पण करने का साधन श्रुवा) ब्रह्म है और हवि (शाकल्य अथवा हवन करने योग्य द्रव्य) भी ब्रह्म है;  ब्रह्मरूप अग्नि में ब्रह्मरूप कर्ता के द्वारा जो हवन किया गया है,  वह भी ब्रह्म ही है। इस प्रकार ब्रह्मरूप कर्म में समाधिस्थ पुरुष का गन्तव्य भी ब्रह्म ही है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_024.mp3"},
  {id: "BG_4.25", label: "BG 4.25", ref: "4.25", chapter: 4, verse: 25, speaker: "krishna", canonical: true, meter: "anustubh", sa: "दैवमेवापरे यज्ञं योगिनः पर्युपासते", snippet: "Some yogis perform sacrifice to the gods alone; while others, who have realized the Self, offer the Self as sacrifice in the fire of Brahman alone.", sanskrit: "दैवमेवापरे यज्ञं योगिनः पर्युपासते ।\nब्रह्माग्नावपरे यज्ञं यज्ञेनैवोपजुह्वति ॥", iast: "daivamevāpare yajñaṃ yoginaḥ paryupāsate |\nbrahmāgnāvapare yajñaṃ yajñenaivopajuhvati ||", transliteration: "daivam evāpare yajñaṁ yoginaḥ paryupāsate\nbrahmāgnāvapare yajñaṁ yajñenaivopajuhvati", translation_en: "Some yogis perform sacrifice to the gods alone; while others, who have realized the Self, offer the Self as sacrifice in the fire of Brahman alone.", translation_hi: "कोई योगीजन देवताओं के पूजनरूप यज्ञ को ही करते हैं ; और दूसरे (ज्ञानीजन) ब्रह्मरूप अग्नि में यज्ञ के द्वारा यज्ञ को हवन करते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_025.mp3"},
  {id: "BG_4.26", label: "BG 4.26", ref: "4.26", chapter: 4, verse: 26, speaker: "krishna", canonical: true, meter: "anustubh", sa: "श्रोत्रादीनीन्द्रियाण्यन्ये संयमाग्निषु जुह्वति", snippet: "Some again offer the organ of hearing and other senses as a sacrifice in the fire of restraint; others offer sound and other objects of the senses as a sacrifice in the fire of…", sanskrit: "श्रोत्रादीनीन्द्रियाण्यन्ये संयमाग्निषु जुह्वति ।\nशब्दादीन्विषयानन्य इन्द्रियाग्निषु जुह्वति ॥", iast: "śrotrādīnīndriyāṇyanye saṃyamāgniṣu juhvati |\nśabdādīnviṣayānanya indriyāgniṣu juhvati ||", transliteration: "śhrotrādīnīndriyāṇyanye sanyamāgniṣhu juhvati\nśhabdādīn viṣhayānanya indriyāgniṣhu juhvati", translation_en: "Some again offer the organ of hearing and other senses as a sacrifice in the fire of restraint; others offer sound and other objects of the senses as a sacrifice in the fire of the senses.", translation_hi: "अन्य (योगीजन) श्रोत्रादिक सब इन्द्रियों को संयमरूप अग्नि में हवन करते हैं,  और अन्य (लोग) शब्दादिक विषयों को इन्द्रियरूप अग्नि में हवन करते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_026.mp3"},
  {id: "BG_4.27", label: "BG 4.27", ref: "4.27", chapter: 4, verse: 27, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सर्वाणीन्द्रियकर्माणि प्राणकर्माणि चापरे", snippet: "Others again sacrifice all the functions of the senses and those of the breath (vital energy, or Prana) in the fire of the Yoga of self-restraint, kindled by knowledge.", sanskrit: "सर्वाणीन्द्रियकर्माणि प्राणकर्माणि चापरे ।\nआत्मसंयमयोगाग्नौ जुह्वति ज्ञानदीपिते ॥", iast: "sarvāṇīndriyakarmāṇi prāṇakarmāṇi cāpare |\nātmasaṃyamayogāgnau juhvati jñānadīpite ||", transliteration: "sarvāṇīndriya-karmāṇi prāṇa-karmāṇi chāpare\nātma-sanyama-yogāgnau juhvati jñāna-dīpite", translation_en: "Others again sacrifice all the functions of the senses and those of the breath (vital energy, or Prana) in the fire of the Yoga of self-restraint, kindled by knowledge.", translation_hi: "दूसरे (योगीजन) सम्पूर्ण इन्द्रियों के तथा प्राणों के कर्मों को ज्ञान से प्रकाशित आत्मसंयमयोगरूप अग्नि में हवन करते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_027.mp3"},
  {id: "BG_4.28", label: "BG 4.28", ref: "4.28", chapter: 4, verse: 28, speaker: "krishna", canonical: true, meter: "anustubh", sa: "द्रव्ययज्ञास्तपोयज्ञा योगयज्ञास्तथापरे", snippet: "Others again offer wealth, austerity, and Yoga as sacrifice, while ascetics of self-restraint and rigid vows offer the study of scriptures and knowledge as sacrifice.", sanskrit: "द्रव्ययज्ञास्तपोयज्ञा योगयज्ञास्तथापरे ।\nस्वाध्यायज्ञानयज्ञाश्च यतयः संशितव्रताः ॥", iast: "dravyayajñāstapoyajñā yogayajñāstathāpare |\nsvādhyāyajñānayajñāśca yatayaḥ saṃśitavratāḥ ||", transliteration: "dravya-yajñās tapo-yajñā yoga-yajñās tathāpare\nswādhyāya-jñāna-yajñāśh cha yatayaḥ sanśhita-vratāḥ", translation_en: "Others again offer wealth, austerity, and Yoga as sacrifice, while ascetics of self-restraint and rigid vows offer the study of scriptures and knowledge as sacrifice.", translation_hi: "कुछ (साधक) द्रव्ययज्ञ, तपयज्ञ और योगयज्ञ करने वाले होते हैं;  और दूसरे कठिन व्रत करने वाले स्वाध्याय और ज्ञानयज्ञ करने वाले योगीजन होते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_028.mp3"},
  {id: "BG_4.29", label: "BG 4.29", ref: "4.29", chapter: 4, verse: 29, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अपाने जुह्वति प्राण प्राणेऽपानं तथाऽपरे", snippet: "Others offer as sacrifice the outgoing breath into the incoming, and the incoming into the outgoing, restraining the flow of the outgoing and the incoming breaths, solely…", sanskrit: "अपाने जुह्वति प्राण प्राणेऽपानं तथाऽपरे ।\nप्राणापानगती रुद्ध्वा प्राणायामपरायणाः ॥", iast: "apāne juhvati prāṇa prāṇe’pānaṃ tathā’pare |\nprāṇāpānagatī ruddhvā prāṇāyāmaparāyaṇāḥ ||", transliteration: "apāne juhvati prāṇaṁ prāṇe ’pānaṁ tathāpare\nprāṇāpāna-gatī ruddhvā prāṇāyāma-parāyaṇāḥ\napare niyatāhārāḥ prāṇān prāṇeṣhu juhvati\nsarve ’pyete yajña-vido yajña-kṣhapita-kalmaṣhāḥ", translation_en: "Others offer as sacrifice the outgoing breath into the incoming, and the incoming into the outgoing, restraining the flow of the outgoing and the incoming breaths, solely absorbed in the restraint of the breath.", translation_hi: "अन्य (योगीजन) अपानवायु में प्राणवायु को हवन करते हैं,  तथा प्राण में अपान की आहुति देते हैं,  प्राण और अपान की गति को रोककर,  वे प्राणायाम के ही समलक्ष्य समझने वाले होते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_029.mp3"},
  {id: "BG_4.30", label: "BG 4.30", ref: "4.30", chapter: 4, verse: 30, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अपरे नियताहाराः प्राणान्प्राणेषु जुह्वति", snippet: "Others who regulate their diet offer life-breaths in each life-breath. All these are knowers of sacrifice, whose sins are destroyed through sacrifice.", sanskrit: "अपरे नियताहाराः प्राणान्प्राणेषु जुह्वति ।\nसर्वेऽप्येते यज्ञविदो यज्ञक्षपितकल्मषाः ॥", iast: "apare niyatāhārāḥ prāṇānprāṇeṣu juhvati |\nsarve’pyete yajñavido yajñakṣapitakalmaṣāḥ ||", transliteration: "apare niyatāhārāḥ prāṇān  prāṇeṣu juhvati\nsarve py 'ete yajña-vido yajña-kṣapita-kalmaṣāḥ", translation_en: "Others who regulate their diet offer life-breaths in each life-breath. All these are knowers of sacrifice, whose sins are destroyed through sacrifice.", translation_hi: "दूसरे नियमित आहार करने वाले (साधक जन) प्राणों को प्राणों में हवन करते हैं। ये सभी यज्ञ को जानने वाले हैं, जिनके पाप यज्ञ के द्वारा नष्ट हो चुके हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_030.mp3"},
  {id: "BG_4.31", label: "BG 4.31", ref: "4.31", chapter: 4, verse: 31, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यज्ञशिष्टामृतभुजो यान्ति ब्रह्म सनातनम्", snippet: "Those who eat the remnants of the sacrifice, which are like nectar, go to the eternal Brahman. This world is not for the one who does not perform sacrifice; how then can they…", sanskrit: "यज्ञशिष्टामृतभुजो यान्ति ब्रह्म सनातनम् ।\nनायं लोकोऽस्त्ययज्ञस्य कुतो़ऽन्यः कुरुसत्तम ॥", iast: "yajñaśiṣṭāmṛtabhujo yānti brahma sanātanam |\nnāyaṃ loko’styayajñasya kuto’nyaḥ kurusattama ||", transliteration: "yajña-śhiṣhṭāmṛita-bhujo yānti brahma sanātanam\nnāyaṁ loko ’styayajñasya kuto ’nyaḥ kuru-sattama", translation_en: "Those who eat the remnants of the sacrifice, which are like nectar, go to the eternal Brahman. This world is not for the one who does not perform sacrifice; how then can they have the other, O Arjuna?", translation_hi: "हे कुरुश्रेष्ठ ! यज्ञ के अवशिष्ट अमृत को भोगने वाले पुरुष सनातन ब्रह्म को प्राप्त होते हैं। यज्ञ रहित पुरुष को यह लोक भी नहीं मिलता,  फिर परलोक कैसे मिलेगा?", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_031.mp3"},
  {id: "BG_4.32", label: "BG 4.32", ref: "4.32", chapter: 4, verse: 32, speaker: "krishna", canonical: true, meter: "anustubh", sa: "एवं बहुविधा यज्ञा वितता ब्रह्मणो मुखे", snippet: "Thus, manifold sacrifices are spread out before Brahman at the face of Brahman. Know them all to be born of action, and thus knowing, you shall be liberated.", sanskrit: "एवं बहुविधा यज्ञा वितता ब्रह्मणो मुखे ।\nकर्मजान्विद्धि तान्सर्वानेवं ज्ञात्वा विमोक्ष्यसे ॥", iast: "evaṃ bahuvidhā yajñā vitatā brahmaṇo mukhe |\nkarmajānviddhi tānsarvānevaṃ jñātvā vimokṣyase ||", transliteration: "evaṁ bahu-vidhā yajñā vitatā brahmaṇo mukhe\nkarma-jān viddhi tān sarvān evaṁ jñātvā vimokṣhyase", translation_en: "Thus, manifold sacrifices are spread out before Brahman at the face of Brahman. Know them all to be born of action, and thus knowing, you shall be liberated.", translation_hi: "ऐसे अनेक प्रकार के यज्ञों का ब्रह्मा के मुख अर्थात् वेदों में प्रसार है अर्थात् वर्णित हैं। उन सब को कर्मों से उत्पन्न हुए जानो;  इस प्रकार जानकर तुम मुक्त हो जाओगे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_032.mp3"},
  {id: "BG_4.33", label: "BG 4.33", ref: "4.33", chapter: 4, verse: 33, speaker: "krishna", canonical: true, meter: "anustubh", sa: "श्रेयान्द्रव्यमयाद्यज्ञाज्ज्ञानयज्ञः परन्तप", snippet: "Superior is wisdom-sacrifice to the sacrifice with objects, O Parantapa (scorcher of the foes). All actions in their entirety, O Arjuna, culminate in knowledge.", sanskrit: "श्रेयान्द्रव्यमयाद्यज्ञाज्ज्ञानयज्ञः परन्तप ।\nसर्वं कर्माखिलं पार्थ ज्ञाने परिसमाप्यते ॥", iast: "śreyāndravyamayādyajñājjñānayajñaḥ parantapa |\nsarvaṃ karmākhilaṃ pārtha jñāne parisamāpyate ||", transliteration: "śhreyān dravya-mayād yajñāj jñāna-yajñaḥ parantapa\nsarvaṁ karmākhilaṁ pārtha jñāne parisamāpyate", translation_en: "Superior is wisdom-sacrifice to the sacrifice with objects, O Parantapa (scorcher of the foes). All actions in their entirety, O Arjuna, culminate in knowledge.", translation_hi: "हे परन्तप ! द्रव्यों से सम्पन्न होने वाले यज्ञ की अपेक्षा ज्ञानयज्ञ श्रेष्ठ है। हे पार्थ ! सम्पूर्ण अखिल कर्म ज्ञान में समाप्त होते हैं,  अर्थात् ज्ञान उनकी पराकाष्ठा है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_033.mp3"},
  {id: "BG_4.34", label: "BG 4.34", ref: "4.34", chapter: 4, verse: 34, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तद्विद्धि प्रणिपातेन परिप्रश्नेन सेवया", snippet: "Know that the wise who have realized the truth will instruct thee in that knowledge through long prostration, supplication, and service.", sanskrit: "तद्विद्धि प्रणिपातेन परिप्रश्नेन सेवया ।\nउपदेक्ष्यन्ति ते ज्ञानं ज्ञानिनस्तत्त्वदर्शिनः ॥", iast: "tadviddhi praṇipātena paripraśnena sevayā |\nupadekṣyanti te jñānaṃ jñāninastattvadarśinaḥ ||", transliteration: "tad viddhi praṇipātena paripraśhnena sevayā\nupadekṣhyanti te jñānaṁ jñāninas tattva-darśhinaḥ", translation_en: "Know that the wise who have realized the truth will instruct thee in that knowledge through long prostration, supplication, and service.", translation_hi: "उस (ज्ञान) को (गुरु के समीप जाकर) साष्टांग प्रणिपात,  प्रश्न तथा सेवा करके जानो;  ये तत्त्वदर्शी ज्ञानी पुरुष तुम्हें ज्ञान का उपदेश करेंगे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_034.mp3"},
  {id: "BG_4.35", label: "BG 4.35", ref: "4.35", chapter: 4, verse: 35, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यज्ज्ञात्वा न पुनर्मोहमेवं यास्यसि पाण्डव", snippet: "Knowing that thou shalt not, O Arjuna, again be deluded like this; and by that thou shalt see all beings in thyself and also in me.", sanskrit: "यज्ज्ञात्वा न पुनर्मोहमेवं यास्यसि पाण्डव ।\nयेन भूतान्यशेषेण द्रक्ष्यस्यात्मन्यथो मयि ॥", iast: "yajjñātvā na punarmohamevaṃ yāsyasi pāṇḍava |\nyena bhūtānyaśeṣeṇa drakṣyasyātmanyatho mayi ||", transliteration: "yaj jñātvā na punar moham evaṁ yāsyasi pāṇḍava\nyena bhūtānyaśheṣheṇa drakṣhyasyātmanyatho mayi", translation_en: "Knowing that thou shalt not, O Arjuna, again be deluded like this; and by that thou shalt see all beings in thyself and also in me.", translation_hi: "जिसको जानकर तुम पुन इस प्रकार मोह को नहीं प्राप्त होगे,  और हे पाण्डव ! जिसके द्वारा तुम भूतमात्र को अपने आत्मस्वरूप में तथा मुझमें भी देखोगे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_035.mp3"},
  {id: "BG_4.36", label: "BG 4.36", ref: "4.36", chapter: 4, verse: 36, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अपि चेदसि पापेभ्यः सर्वेभ्यः पापकृत्तमः", snippet: "Even if thou art the most sinful of all sinners, yet thou shalt surely cross over all sins by the raft of knowledge.", sanskrit: "अपि चेदसि पापेभ्यः सर्वेभ्यः पापकृत्तमः ।\nसर्वं ज्ञानप्लवेनैव वृजिनं सन्तरिष्यसि ॥", iast: "api cedasi pāpebhyaḥ sarvebhyaḥ pāpakṛttamaḥ |\nsarvaṃ jñānaplavenaiva vṛjinaṃ santariṣyasi ||", transliteration: "api ched asi pāpebhyaḥ sarvebhyaḥ pāpa-kṛit-tamaḥ\nsarvaṁ jñāna-plavenaiva vṛijinaṁ santariṣhyasi", translation_en: "Even if thou art the most sinful of all sinners, yet thou shalt surely cross over all sins by the raft of knowledge.", translation_hi: "यदि तुम सब पापियों से भी अधिक पाप करने वाले हो,  तो भी ज्ञानरूपी नौका द्वारा,  निश्चय ही सम्पूर्ण पापों का तुम संतरण कर जाओगे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_036.mp3"},
  {id: "BG_4.37", label: "BG 4.37", ref: "4.37", chapter: 4, verse: 37, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यथैधांसि समिद्धोऽग्निर्भस्मसात्कुरुतेऽर्जुन", snippet: "As the blazing fire reduces fuel to ashes, O Arjuna, so does the fire of knowledge reduce all actions to ash.", sanskrit: "यथैधांसि समिद्धोऽग्निर्भस्मसात्कुरुतेऽर्जुन ।\nज्ञानाग्निः सर्वकर्माणि भस्मसात्कुरुते तथा ॥", iast: "yathaidhāṃsi samiddho’gnirbhasmasātkurute’rjuna |\njñānāgniḥ sarvakarmāṇi bhasmasātkurute tathā ||", transliteration: "yathaidhānsi samiddho ’gnir bhasma-sāt kurute ’rjuna\njñānāgniḥ sarva-karmāṇi bhasma-sāt kurute tathā", translation_en: "As the blazing fire reduces fuel to ashes, O Arjuna, so does the fire of knowledge reduce all actions to ash.", translation_hi: "जैसे प्रज्जवलित अग्नि ईन्धन को भस्मसात् कर देती है,  वैसे ही,  हे अर्जुन ! ज्ञानरूपी अग्नि सम्पूर्ण कर्मों को भस्मसात् कर देती है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_037.mp3"},
  {id: "BG_4.38", label: "BG 4.38", ref: "4.38", chapter: 4, verse: 38, speaker: "krishna", canonical: true, meter: "anustubh", sa: "न हि ज्ञानेन सदृशं पवित्रमिह विद्यते", snippet: "Verily, there is no purifier in this world like knowledge. He who is perfected in Yoga finds it within the Self in due time.", sanskrit: "न हि ज्ञानेन सदृशं पवित्रमिह विद्यते ।\nतत्स्वयं योगसंसिद्धः कालेनात्मनि विन्दति ॥", iast: "na hi jñānena sadṛśaṃ pavitramiha vidyate |\ntatsvayaṃ yogasaṃsiddhaḥ kālenātmani vindati ||", transliteration: "na hi jñānena sadṛiśhaṁ pavitramiha vidyate\ntatsvayaṁ yogasansiddhaḥ kālenātmani vindati", translation_en: "Verily, there is no purifier in this world like knowledge. He who is perfected in Yoga finds it within the Self in due time.", translation_hi: "इस लोक में ज्ञान के समान पवित्र करने वाला,  निसंदेह,  कुछ भी नहीं है। योग में संसिद्ध पुरुष स्वयं ही उसे (उचित) काल में आत्मा में प्राप्त करता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_038.mp3"}
] AS row
MERGE (n:Verse {id: row.id}) SET n += row;

UNWIND [
  {id: "BG_4.39", label: "BG 4.39", ref: "4.39", chapter: 4, verse: 39, speaker: "krishna", canonical: true, meter: "anustubh", sa: "श्रद्धावाँल्लभते ज्ञानं तत्परः संयतेन्द्रियः", snippet: "The one who is full of faith, devoted to it, and has subdued their senses obtains this knowledge; and upon obtaining the knowledge, they attain the supreme peace immediately.", sanskrit: "श्रद्धावाँल्लभते ज्ञानं तत्परः संयतेन्द्रियः ।\nज्ञानं लब्ध्वा परां शान्तिमचिरेणाधिगच्छति ॥", iast: "śraddhāvām̐llabhate jñānaṃ tatparaḥ saṃyatendriyaḥ |\njñānaṃ labdhvā parāṃ śāntimacireṇādhigacchati ||", transliteration: "śhraddhāvān labhate jñānaṁ tat-paraḥ sanyatendriyaḥ\njñānaṁ labdhvā parāṁ śhāntim achireṇādhigachchhati", translation_en: "The one who is full of faith, devoted to it, and has subdued their senses obtains this knowledge; and upon obtaining the knowledge, they attain the supreme peace immediately.", translation_hi: "श्रद्धावान्,  तत्पर और जितेन्द्रिय पुरुष ज्ञान प्राप्त करता है। ज्ञान को प्राप्त करके शीघ्र ही वह परम शान्ति को प्राप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_039.mp3"},
  {id: "BG_4.40", label: "BG 4.40", ref: "4.40", chapter: 4, verse: 40, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अज्ञश्चाश्रद्दधानश्च संशयात्मा विनश्यति", snippet: "The ignorant, the faithless, and the doubting self go to destruction; there is neither this world nor the other, nor happiness for the doubting one.", sanskrit: "अज्ञश्चाश्रद्दधानश्च संशयात्मा विनश्यति ।\nनायं लोकोऽस्ति न परो न सुखं संशयात्मनः ॥", iast: "ajñaścāśraddadhānaśca saṃśayātmā vinaśyati |\nnāyaṃ loko’sti na paro na sukhaṃ saṃśayātmanaḥ ||", transliteration: "ajñaśh chāśhraddadhānaśh cha sanśhayātmā vinaśhyati\nnāyaṁ loko ’sti na paro na sukhaṁ sanśhayātmanaḥ", translation_en: "The ignorant, the faithless, and the doubting self go to destruction; there is neither this world nor the other, nor happiness for the doubting one.", translation_hi: "अज्ञानी तथा श्रद्धारहित और संशययुक्त पुरुष नष्ट हो जाता है,  (उनमें भी) संशयी पुरुष के लिये न यह लोक है,  न परलोक और न सुख।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_040.mp3"},
  {id: "BG_4.41", label: "BG 4.41", ref: "4.41", chapter: 4, verse: 41, speaker: "krishna", canonical: true, meter: "anustubh", sa: "योगसंन्यस्तकर्माणं ज्ञानसंछिन्नसंशयम्", snippet: "He who has renounced actions through Yoga, whose doubts have been dispelled by knowledge, and who is self-possessed—such a one is not bound by actions, O Arjuna.", sanskrit: "योगसंन्यस्तकर्माणं ज्ञानसंछिन्नसंशयम् ।\nआत्मवन्तं न कर्माणि निबध्नन्ति धनञ्जय ॥", iast: "yogasaṃnyastakarmāṇaṃ jñānasaṃchinnasaṃśayam |\nātmavantaṃ na karmāṇi nibadhnanti dhanañjaya ||", transliteration: "yoga-sannyasta-karmāṇaṁ jñāna-sañchhinna-sanśhayam\nātmavantaṁ na karmāṇi nibadhnanti dhanañjaya", translation_en: "He who has renounced actions through Yoga, whose doubts have been dispelled by knowledge, and who is self-possessed—such a one is not bound by actions, O Arjuna.", translation_hi: "जिसने योगद्वारा कर्मों का संन्यास किया है,  ज्ञानद्वारा जिसके संशय नष्ट हो गये हैं,  ऐसे आत्मवान् पुरुष को,  हे धनंजय ! कर्म नहीं बांधते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_041.mp3"},
  {id: "BG_4.42", label: "BG 4.42", ref: "4.42", chapter: 4, verse: 42, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तस्मादज्ञानसंभूतं हृत्स्थं ज्ञानासिनाऽऽत्मनः", snippet: "Therefore, with the sword of knowledge (of the Self), cut asunder the doubt of the self, born of ignorance, residing in your heart, and take refuge in Yoga. Arise, O Arjuna!", sanskrit: "तस्मादज्ञानसंभूतं हृत्स्थं ज्ञानासिनाऽऽत्मनः ।\nछित्त्वैनं संशयं योगमातिष्ठोत्तिष्ठ भारत ॥", iast: "tasmādajñānasaṃbhūtaṃ hṛtsthaṃ jñānāsinā’’tmanaḥ |\nchittvainaṃ saṃśayaṃ yogamātiṣṭhottiṣṭha bhārata ||", transliteration: "tasmād ajñāna-sambhūtaṁ hṛit-sthaṁ jñānāsinātmanaḥ\nchhittvainaṁ sanśhayaṁ yogam ātiṣhṭhottiṣhṭha bhārata", translation_en: "Therefore, with the sword of knowledge (of the Self), cut asunder the doubt of the self, born of ignorance, residing in your heart, and take refuge in Yoga. Arise, O Arjuna!", translation_hi: "इसलिये अपने हृदय में स्थित अज्ञान से उत्पन्न आत्मविषयक संशय को ज्ञान खड्ग से काटकर,  हे भारत ! योग का आश्रय लेकर खड़े हो जाओ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/004_042.mp3"},
  {id: "BG_5.1", label: "BG 5.1", ref: "5.1", chapter: 5, verse: 1, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "संन्यासं कर्मणां कृष्ण पुनर्योगं च शंससि", snippet: "Arjuna said, \"O Krishna, you praise renunciation of actions and also yoga. Please tell me conclusively which is better of the two.\"", sanskrit: "संन्यासं कर्मणां कृष्ण पुनर्योगं च शंससि ।\nयच्छ्रेय एतयोरेकं तन्मे ब्रूहि सुनिश्चितम् ॥", iast: "saṃnyāsaṃ karmaṇāṃ kṛṣṇa punaryogaṃ ca śaṃsasi |\nyacchreya etayorekaṃ tanme brūhi suniścitam ||", transliteration: "sannyāsaṁ karmaṇāṁ kṛiṣhṇa punar yogaṁ cha śhansasi\nyach chhreya etayor ekaṁ tan me brūhi su-niśhchitam", translation_en: "Arjuna said, \"O Krishna, you praise renunciation of actions and also yoga. Please tell me conclusively which is better of the two.\"", translation_hi: "अर्जुन ने कहा हे --  कृष्ण ! आप कर्मों के संन्यास की और फिर योग (कर्म के आचरण) की प्रशंसा करते हैं। इन दोनों में एक जो निश्चय पूर्वक श्रेयस्कर है, उसको मेरे लिए कहिये।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_001.mp3"},
  {id: "BG_5.2", label: "BG 5.2", ref: "5.2", chapter: 5, verse: 2, speaker: "krishna", canonical: true, meter: "anustubh", sa: "संन्यासः कर्मयोगश्च निःश्रेयसकरावुभौ", snippet: "The Blessed Lord said, \"Renunciation and the Yoga of action both lead to the highest bliss; but of the two, the Yoga of action is superior to the renunciation of action.\"", sanskrit: "संन्यासः कर्मयोगश्च निःश्रेयसकरावुभौ ।\nतयोस्तु कर्मसंन्यासात्कर्मयोगो विशिष्यते ॥", iast: "saṃnyāsaḥ karmayogaśca niḥśreyasakarāvubhau |\ntayostu karmasaṃnyāsātkarmayogo viśiṣyate ||", transliteration: "sannyāsaḥ karma-yogaśh cha niḥśhreyasa-karāvubhau\ntayos tu karma-sannyāsāt karma-yogo viśhiṣhyate", translation_en: "The Blessed Lord said, \"Renunciation and the Yoga of action both lead to the highest bliss; but of the two, the Yoga of action is superior to the renunciation of action.\"", translation_hi: "श्रीभगवान् ने कहा --  कर्मसंन्यास और कर्मयोग ये दोनों ही परम कल्याणकारक हैं;  परन्तु उन दोनों में कर्मसंन्यास से कर्मयोग श्रेष्ठ है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_002.mp3"},
  {id: "BG_5.3", label: "BG 5.3", ref: "5.3", chapter: 5, verse: 3, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ज्ञेयः स नित्यसंन्यासी यो न द्वेष्टि न काङ्क्षति", snippet: "He should be known as a perpetual Sannyasi who neither hates nor desires; for, free from the pairs of opposites, O mighty-armed Arjuna, he is easily freed from bondage.", sanskrit: "ज्ञेयः स नित्यसंन्यासी यो न द्वेष्टि न काङ्क्षति ।\nनिर्द्वन्द्वो हि महाबाहो सुखं बन्धात्प्रमुच्यते ॥", iast: "jñeyaḥ sa nityasaṃnyāsī yo na dveṣṭi na kāṅkṣati |\nnirdvandvo hi mahābāho sukhaṃ bandhātpramucyate ||", transliteration: "jñeyaḥ sa nitya-sannyāsī yo na dveṣhṭi na kāṅkṣhati\nnirdvandvo hi mahā-bāho sukhaṁ bandhāt pramuchyate", translation_en: "He should be known as a perpetual Sannyasi who neither hates nor desires; for, free from the pairs of opposites, O mighty-armed Arjuna, he is easily freed from bondage.", translation_hi: "जो पुरुष न किसी से द्वेष करता है और न किसी की आकांक्षा,  वह सदा संन्यासी ही समझने योग्य है;  क्योंकि,  हे महाबाहो ! द्वन्द्वों से रहित पुरुष सहज ही बन्धन मुक्त हो जाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_003.mp3"},
  {id: "BG_5.4", label: "BG 5.4", ref: "5.4", chapter: 5, verse: 4, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सांख्ययोगौ पृथग्बालाः प्रवदन्ति न पण्डिताः", snippet: "Children, not the wise, speak of knowledge and the Yoga of action, or the performance of action, as though they are distinct and different; he who is truly established in one,…", sanskrit: "सांख्ययोगौ पृथग्बालाः प्रवदन्ति न पण्डिताः ।\nएकमप्यास्थितः सम्यगुभयोर्विन्दते फलम् ॥", iast: "sāṃkhyayogau pṛthagbālāḥ pravadanti na paṇḍitāḥ |\nekamapyāsthitaḥ samyagubhayorvindate phalam ||", transliteration: "sānkhya-yogau pṛithag bālāḥ pravadanti na paṇḍitāḥ\nekamapyāsthitaḥ samyag ubhayor vindate phalam", translation_en: "Children, not the wise, speak of knowledge and the Yoga of action, or the performance of action, as though they are distinct and different; he who is truly established in one, obtains the fruits of both.", translation_hi: "बालक अर्थात् बालबुद्धि के लोग सांख्य (संन्यास) और योग को परस्पर भिन्न समझते हैं;  किसी एक में भी सम्यक् प्रकार से स्थित हुआ पुरुष दोनों के फल को प्राप्त कर लेता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_004.mp3"},
  {id: "BG_5.5", label: "BG 5.5", ref: "5.5", chapter: 5, verse: 5, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यत्सांख्यैः प्राप्यते स्थानं तद्योगैरपि गम्यते", snippet: "That place which is reached by the Sankhyas or the Jnanis is also reached by the Yogis (Karma Yogis). He who sees knowledge and the performance of action (Karma Yoga) as one,…", sanskrit: "यत्सांख्यैः प्राप्यते स्थानं तद्योगैरपि गम्यते ।\nएकं सांख्यं च योगं च यः पश्यति स पश्यति ॥", iast: "yatsāṃkhyaiḥ prāpyate sthānaṃ tadyogairapi gamyate |\nekaṃ sāṃkhyaṃ ca yogaṃ ca yaḥ paśyati sa paśyati ||", transliteration: "yat sānkhyaiḥ prāpyate sthānaṁ tad yogair api gamyate\nekaṁ sānkhyaṁ cha yogaṁ cha yaḥ paśhyati sa paśhyati", translation_en: "That place which is reached by the Sankhyas or the Jnanis is also reached by the Yogis (Karma Yogis). He who sees knowledge and the performance of action (Karma Yoga) as one, sees truly.", translation_hi: "जो स्थान ज्ञानियों द्वारा प्राप्त किया जाता है,  उसी स्थान पर कर्मयोगी भी पहुँचते हैं। इसलिए जो पुरुष सांख्य और योग को (फलरूप से) एक ही देखता है,  वही (वास्तव में) देखता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_005.mp3"},
  {id: "BG_5.6", label: "BG 5.6", ref: "5.6", chapter: 5, verse: 6, speaker: "krishna", canonical: true, meter: "anustubh", sa: "संन्यासस्तु महाबाहो दुःखमाप्तुमयोगतः", snippet: "But, O mighty-armed Arjuna, renunciation is hard to attain without Yoga; the sage who is in harmony with Yoga quickly goes to Brahman.", sanskrit: "संन्यासस्तु महाबाहो दुःखमाप्तुमयोगतः ।\nयोगयुक्तो मुनिर्ब्रह्म नचिरेणाधिगच्छति ॥", iast: "saṃnyāsastu mahābāho duḥkhamāptumayogataḥ |\nyogayukto munirbrahma nacireṇādhigacchati ||", transliteration: "sannyāsas tu mahā-bāho duḥkham āptum ayogataḥ\nyoga-yukto munir brahma na chireṇādhigachchhati", translation_en: "But, O mighty-armed Arjuna, renunciation is hard to attain without Yoga; the sage who is in harmony with Yoga quickly goes to Brahman.", translation_hi: "परन्तु,  हे महाबाहो ! योग के बिना संन्यास प्राप्त होना कठिन है;  योगयुक्त मननशील पुरुष परमात्मा को शीघ्र ही प्राप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_006.mp3"},
  {id: "BG_5.7", label: "BG 5.7", ref: "5.7", chapter: 5, verse: 7, speaker: "krishna", canonical: true, meter: "anustubh", sa: "योगयुक्तो विशुद्धात्मा विजितात्मा जितेन्द्रियः", snippet: "He who is devoted to the path of action, whose mind is pure, who has conquered the self, who has subdued his senses, and who realizes his Self as the Self in all beings, though…", sanskrit: "योगयुक्तो विशुद्धात्मा विजितात्मा जितेन्द्रियः ।\nसर्वभूतात्मभूतात्मा कुर्वन्नपि न लिप्यते ॥", iast: "yogayukto viśuddhātmā vijitātmā jitendriyaḥ |\nsarvabhūtātmabhūtātmā kurvannapi na lipyate ||", transliteration: "yoga-yukto viśhuddhātmā vijitātmā jitendriyaḥ\nsarva-bhūtātma-bhūtātmā kurvann api na lipyate", translation_en: "He who is devoted to the path of action, whose mind is pure, who has conquered the self, who has subdued his senses, and who realizes his Self as the Self in all beings, though acting, is not tainted.", translation_hi: "जो पुरुष योगयुक्त, विशुद्ध अन्तकरण वाला, शरीर को वश में किये हुए, जितेन्द्रिय तथा भूतमात्र में स्थित आत्मा के साथ एकत्व अनुभव किये हुए है वह कर्म करते हुए भी उनसे लिप्त नहीं होता।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_007.mp3"},
  {id: "BG_5.8", label: "BG 5.8", ref: "5.8", chapter: 5, verse: 8, speaker: "krishna", canonical: true, meter: "anustubh", sa: "नैव किंचित्करोमीति युक्तो मन्येत तत्त्ववित्", snippet: "I do nothing at all,\" thus would the harmonized knower of Truth think, seeing, hearing, touching, smelling, eating, going, sleeping, and breathing.", sanskrit: "नैव किंचित्करोमीति युक्तो मन्येत तत्त्ववित् ।\nपश्यन् श्रृणवन्स्पृशञ्जिघ्रन्नश्नन्गच्छन्स्वपन् श्वसन् ॥", iast: "naiva kiṃcitkaromīti yukto manyeta tattvavit |\npaśyan śrṛṇavanspṛśañjighrannaśnangacchansvapan śvasan ||", transliteration: "naiva kiñchit karomīti yukto manyeta tattva-vit\npaśhyañ śhṛiṇvan spṛiśhañjighrann aśhnangachchhan svapañśhvasan\npralapan visṛijan gṛihṇann unmiṣhan nimiṣhann api\nindriyāṇīndriyārtheṣhu vartanta iti dhārayan", translation_en: "I do nothing at all,\" thus would the harmonized knower of Truth think, seeing, hearing, touching, smelling, eating, going, sleeping, and breathing.", translation_hi: "तत्त्ववित् युक्त पुरुष यह सोचेगा (अर्थात् जानता है) कि  \"मैं किंचित् मात्र कर्म नहीं करता हूँ\"  देखता हुआ, सुनता हुआ, स्पर्श करता हुआ, सूंघता हुआ, खाता हुआ, चलता हुआ, सोता हुआ, श्वास लेता हुआ,।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_008.mp3"},
  {id: "BG_5.9", label: "BG 5.9", ref: "5.9", chapter: 5, verse: 9, speaker: "krishna", canonical: true, meter: "anustubh", sa: "प्रलपन्विसृजन्गृह्णन्नुन्मिषन्निमिषन्नपि", snippet: "Speaking, letting go, seizing, opening, and closing the eyes, one should be convinced that the senses move among the sense-objects.", sanskrit: "प्रलपन्विसृजन्गृह्णन्नुन्मिषन्निमिषन्नपि ।\nइन्द्रियाणीन्द्रियार्थेषु वर्तन्त इति धारयन् ॥", iast: "pralapanvisṛjangṛhṇannunmiṣannimiṣannapi |\nindriyāṇīndriyārtheṣu vartanta iti dhārayan ||", transliteration: "pralapan visṛjan gṛhṇann unmiṣan nimiṣann api indriyāṇīndriyārtheṣu vartanta iti dhārayan", translation_en: "Speaking, letting go, seizing, opening, and closing the eyes, one should be convinced that the senses move among the sense-objects.", translation_hi: "बोलता हुआ,  त्यागता हुआ,  ग्रहण करता हुआ  तथा आँखों को खोलता और बन्द करता हुआ (वह) निश्चयात्मक रूप से जानता है कि सब इन्द्रियाँ अपने-अपने विषयों में विचरण कर रही हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_009.mp3"},
  {id: "BG_5.10", label: "BG 5.10", ref: "5.10", chapter: 5, verse: 10, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ब्रह्मण्याधाय कर्माणि सङ्गं त्यक्त्वा करोति यः", snippet: "He who does actions, offering them to Brahman and abandoning attachment, is not tainted by sin, just as a lotus leaf is not tainted by water.", sanskrit: "ब्रह्मण्याधाय कर्माणि सङ्गं त्यक्त्वा करोति यः ।\nलिप्यते न स पापेन पद्मपत्रमिवाम्भसा ॥", iast: "brahmaṇyādhāya karmāṇi saṅgaṃ tyaktvā karoti yaḥ |\nlipyate na sa pāpena padmapatramivāmbhasā ||", transliteration: "brahmaṇyādhāya karmāṇi saṅgaṁ tyaktvā karoti yaḥ\nlipyate na sa pāpena padma-patram ivāmbhasā", translation_en: "He who does actions, offering them to Brahman and abandoning attachment, is not tainted by sin, just as a lotus leaf is not tainted by water.", translation_hi: "जो पुरुष सब कर्म ब्रह्म में अर्पण करके और आसक्ति को त्यागकर करता है,  वह पुरुष कमल के पत्ते के सदृश पाप से लिप्त नहीं होता।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_010.mp3"},
  {id: "BG_5.11", label: "BG 5.11", ref: "5.11", chapter: 5, verse: 11, speaker: "krishna", canonical: true, meter: "anustubh", sa: "कायेन मनसा बुद्ध्या केवलैरिन्द्रियैरपि", snippet: "Yogis, having abandoned attachment, perform actions only through the body, mind, intellect, and even the senses, for the purification of the self.", sanskrit: "कायेन मनसा बुद्ध्या केवलैरिन्द्रियैरपि ।\nयोगिनः कर्म कुर्वन्ति सङ्गं त्यक्त्वाऽऽत्मशुद्धये ॥", iast: "kāyena manasā buddhyā kevalairindriyairapi |\nyoginaḥ karma kurvanti saṅgaṃ tyaktvā’’tmaśuddhaye ||", transliteration: "kāyena manasā buddhyā kevalair indriyair api\nyoginaḥ karma kurvanti saṅgaṁ tyaktvātma-śhuddhaye", translation_en: "Yogis, having abandoned attachment, perform actions only through the body, mind, intellect, and even the senses, for the purification of the self.", translation_hi: "योगीजन, शरीर, मन, बुद्धि और इन्द्रियों द्वारा आसक्ति को त्याग कर आत्मशुद्धि (चित्तशुद्धि) के लिए कर्म करते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_011.mp3"},
  {id: "BG_5.12", label: "BG 5.12", ref: "5.12", chapter: 5, verse: 12, speaker: "krishna", canonical: true, meter: "anustubh", sa: "युक्तः कर्मफलं त्यक्त्वा शान्तिमाप्नोति नैष्ठिकीम्", snippet: "The one who is united (the well-poised or harmonized) having abandoned the fruit of action attains eternal peace; whereas the one who is not united (the unsteady or…", sanskrit: "युक्तः कर्मफलं त्यक्त्वा शान्तिमाप्नोति नैष्ठिकीम् ।\nअयुक्तः कामकारेण फले सक्तो निबध्यते ॥", iast: "yuktaḥ karmaphalaṃ tyaktvā śāntimāpnoti naiṣṭhikīm |\nayuktaḥ kāmakāreṇa phale sakto nibadhyate ||", transliteration: "yuktaḥ karma-phalaṁ tyaktvā śhāntim āpnoti naiṣhṭhikīm\nayuktaḥ kāma-kāreṇa phale sakto nibadhyate", translation_en: "The one who is united (the well-poised or harmonized) having abandoned the fruit of action attains eternal peace; whereas the one who is not united (the unsteady or unbalanced), impelled by desire and attached to the fruit, is bound.", translation_hi: "युक्त पुरुष कर्मफल का त्याग करके परम शान्ति को प्राप्त होता है;  और अयुक्त पुरुष फल में आसक्त हुआ कामना के द्वारा बँधता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_012.mp3"},
  {id: "BG_5.13", label: "BG 5.13", ref: "5.13", chapter: 5, verse: 13, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सर्वकर्माणि मनसा संन्यस्यास्ते सुखं वशी", snippet: "Mentally renouncing all actions and being self-controlled, the embodied one happily rests in the nine-gated city, neither acting nor causing others (body and senses) to act.", sanskrit: "सर्वकर्माणि मनसा संन्यस्यास्ते सुखं वशी ।\nनवद्वारे पुरे देही नैव कुर्वन्न कारयन् ॥", iast: "sarvakarmāṇi manasā saṃnyasyāste sukhaṃ vaśī |\nnavadvāre pure dehī naiva kurvanna kārayan ||", transliteration: "sarva-karmāṇi manasā sannyasyāste sukhaṁ vaśhī\nnava-dvāre pure dehī naiva kurvan na kārayan", translation_en: "Mentally renouncing all actions and being self-controlled, the embodied one happily rests in the nine-gated city, neither acting nor causing others (body and senses) to act.", translation_hi: "सब कर्मों का मन से संन्यास करके संयमी पुरुष नवद्वार वाली शरीर रूप नगरी में सुख से रहता हुआ न कर्म करता है और न करवाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_013.mp3"},
  {id: "BG_5.14", label: "BG 5.14", ref: "5.14", chapter: 5, verse: 14, speaker: "krishna", canonical: true, meter: "anustubh", sa: "न कर्तृत्वं न कर्माणि लोकस्य सृजति प्रभुः", snippet: "Neither does the Lord create agency nor actions for the world, nor union with the fruits of actions; rather, it is Nature that acts.", sanskrit: "न कर्तृत्वं न कर्माणि लोकस्य सृजति प्रभुः ।\nन कर्मफलसंयोगं स्वभावस्तु प्रवर्तते ॥", iast: "na kartṛtvaṃ na karmāṇi lokasya sṛjati prabhuḥ |\nna karmaphalasaṃyogaṃ svabhāvastu pravartate ||", transliteration: "na kartṛitvaṁ na karmāṇi lokasya sṛijati prabhuḥ\nna karma-phala-saṅyogaṁ svabhāvas tu pravartate", translation_en: "Neither does the Lord create agency nor actions for the world, nor union with the fruits of actions; rather, it is Nature that acts.", translation_hi: "लोकमात्र के लिए प्रभु (ईश्वर) न कर्तृत्व, न कर्म और न कर्मफल के संयोग को रचता है। परन्तु प्रकृति (सब कुछ) करती है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_014.mp3"},
  {id: "BG_5.15", label: "BG 5.15", ref: "5.15", chapter: 5, verse: 15, speaker: "krishna", canonical: true, meter: "anustubh", sa: "नादत्ते कस्यचित्पापं न चैव सुकृतं विभुः", snippet: "The Lord takes neither the demerit nor the merit of any; knowledge is enveloped by ignorance, and beings are deluded.", sanskrit: "नादत्ते कस्यचित्पापं न चैव सुकृतं विभुः ।\nअज्ञानेनावृतं ज्ञानं तेन मुह्यन्ति जन्तवः ॥", iast: "nādatte kasyacitpāpaṃ na caiva sukṛtaṃ vibhuḥ |\najñānenāvṛtaṃ jñānaṃ tena muhyanti jantavaḥ ||", transliteration: "nādatte kasyachit pāpaṁ na chaiva sukṛitaṁ vibhuḥ\najñānenāvṛitaṁ jñānaṁ tena muhyanti jantavaḥ", translation_en: "The Lord takes neither the demerit nor the merit of any; knowledge is enveloped by ignorance, and beings are deluded.", translation_hi: "विभु परमात्मा न किसी के पापकर्म को और न पुण्यकर्म को ही ग्रहण करता है;  (किन्तु) अज्ञान से ज्ञान ढका हुआ है,  इससे सब जीव मोहित होते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_015.mp3"},
  {id: "BG_5.16", label: "BG 5.16", ref: "5.16", chapter: 5, verse: 16, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ज्ञानेन तु तदज्ञानं येषां नाशितमात्मनः", snippet: "But to those whose ignorance is destroyed by knowledge of the Self, like the sun, knowledge reveals the Supreme Brahman.", sanskrit: "ज्ञानेन तु तदज्ञानं येषां नाशितमात्मनः ।\nतेषामादित्यवज्ज्ञानं प्रकाशयति तत्परम् ॥", iast: "jñānena tu tadajñānaṃ yeṣāṃ nāśitamātmanaḥ |\nteṣāmādityavajjñānaṃ prakāśayati tatparam ||", transliteration: "jñānena tu tad ajñānaṁ yeṣhāṁ nāśhitam ātmanaḥ\nteṣhām āditya-vaj jñānaṁ prakāśhayati tat param", translation_en: "But to those whose ignorance is destroyed by knowledge of the Self, like the sun, knowledge reveals the Supreme Brahman.", translation_hi: "परन्तु जिनका वह अज्ञान आत्मज्ञान से नष्ट हो जाता है,  उनके लिए वह ज्ञान,  सूर्य के सदृश,  परमात्मा को प्रकाशित करता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_016.mp3"},
  {id: "BG_5.17", label: "BG 5.17", ref: "5.17", chapter: 5, verse: 17, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तद्बुद्धयस्तदात्मानस्तन्निष्ठास्तत्परायणाः", snippet: "Their intellect absorbed in That, their self being That, established in That, with That as their supreme goal, they go whence there is no return, their sins dispelled by knowledge.", sanskrit: "तद्बुद्धयस्तदात्मानस्तन्निष्ठास्तत्परायणाः ।\nगच्छन्त्यपुनरावृत्तिं ज्ञाननिर्धूतकल्मषाः ॥", iast: "tadbuddhayastadātmānastanniṣṭhāstatparāyaṇāḥ |\ngacchantyapunarāvṛttiṃ jñānanirdhūtakalmaṣāḥ ||", transliteration: "tad-buddhayas tad-ātmānas tan-niṣhṭhās tat-parāyaṇāḥ\ngachchhantyapunar-āvṛittiṁ jñāna-nirdhūta-kalmaṣhāḥ", translation_en: "Their intellect absorbed in That, their self being That, established in That, with That as their supreme goal, they go whence there is no return, their sins dispelled by knowledge.", translation_hi: "जिनकी बुद्धि उस (परमात्मा) में स्थित है,  जिनका मन तद्रूप हुआ है,  उसमें ही जिनकी निष्ठा है,  वह (ब्रह्म) ही जिनका परम लक्ष्य है,  ज्ञान के द्वारा पापरहित पुरुष अपुनरावृत्ति को प्राप्त होते हैं,  अर्थात् उनका पुनर्जन्म नहीं होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_017.mp3"},
  {id: "BG_5.18", label: "BG 5.18", ref: "5.18", chapter: 5, verse: 18, speaker: "krishna", canonical: true, meter: "anustubh", sa: "विद्याविनयसंपन्ने ब्राह्मणे गवि हस्तिनि", snippet: "Sages look with an equal eye on a Brahmana endowed with learning and humility, on a cow, an elephant, a dog, and even an outcaste.", sanskrit: "विद्याविनयसंपन्ने ब्राह्मणे गवि हस्तिनि ।\nशुनि चैव श्वपाके च पण्डिताः समदर्शिनः ॥", iast: "vidyāvinayasaṃpanne brāhmaṇe gavi hastini |\nśuni caiva śvapāke ca paṇḍitāḥ samadarśinaḥ ||", transliteration: "vidyā-vinaya-sampanne brāhmaṇe gavi hastini\nśhuni chaiva śhva-pāke cha paṇḍitāḥ sama-darśhinaḥ", translation_en: "Sages look with an equal eye on a Brahmana endowed with learning and humility, on a cow, an elephant, a dog, and even an outcaste.", translation_hi: "(ऐसे वे) ज्ञानीजन विद्या और विनय से सम्पन्न ब्राह्मण,  तथा गाय,  हाथी,  श्वान और चाण्डाल में भी सम तत्त्व को देखते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_018.mp3"},
  {id: "BG_5.19", label: "BG 5.19", ref: "5.19", chapter: 5, verse: 19, speaker: "krishna", canonical: true, meter: "anustubh", sa: "इहैव तैर्जितः सर्गो येषां साम्ये स्थितं मनः", snippet: "Even here in this world, those whose minds rest in reality overcome birth; Brahman is indeed spotless and real; therefore they are established in Brahman.", sanskrit: "इहैव तैर्जितः सर्गो येषां साम्ये स्थितं मनः ।\nनिर्दोषं हि समं ब्रह्म तस्माद्ब्रह्मणि ते स्थिताः ॥", iast: "ihaiva tairjitaḥ sargo yeṣāṃ sāmye sthitaṃ manaḥ |\nnirdoṣaṃ hi samaṃ brahma tasmādbrahmaṇi te sthitāḥ ||", transliteration: "ihaiva tair jitaḥ sargo yeṣhāṁ sāmye sthitaṁ manaḥ\nnirdoṣhaṁ hi samaṁ brahma tasmād brahmaṇi te sthitāḥ", translation_en: "Even here in this world, those whose minds rest in reality overcome birth; Brahman is indeed spotless and real; therefore they are established in Brahman.", translation_hi: "जिनका मन समत्वभाव में स्थित है,  उनके द्वारा यहीं पर यह सर्ग जीत लिया जाता है; क्योंकि ब्रह्म निर्दोष और सम है इसलिये वे ब्रह्म में ही स्थित हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_019.mp3"},
  {id: "BG_5.20", label: "BG 5.20", ref: "5.20", chapter: 5, verse: 20, speaker: "krishna", canonical: true, meter: "anustubh", sa: "न प्रहृष्येत्प्रियं प्राप्य नोद्विजेत्प्राप्य चाप्रियम्", snippet: "Resting in Brahman, with a steady intellect and undeluded, the knower of Brahman neither rejoices upon obtaining what is pleasant nor grieves upon obtaining what is unpleasant.", sanskrit: "न प्रहृष्येत्प्रियं प्राप्य नोद्विजेत्प्राप्य चाप्रियम् ।\nस्थिरबुद्धिरसम्मूढो ब्रह्मविद्ब्रह्मणि स्थितः ॥", iast: "na prahṛṣyetpriyaṃ prāpya nodvijetprāpya cāpriyam |\nsthirabuddhirasammūḍho brahmavidbrahmaṇi sthitaḥ ||", transliteration: "na prahṛiṣhyet priyaṁ prāpya nodvijet prāpya chāpriyam\nsthira-buddhir asammūḍho brahma-vid brahmaṇi sthitaḥ", translation_en: "Resting in Brahman, with a steady intellect and undeluded, the knower of Brahman neither rejoices upon obtaining what is pleasant nor grieves upon obtaining what is unpleasant.", translation_hi: "जो स्थिरबुद्धि,  संमोहरहित ब्रह्मवित् पुरुष ब्रह्म में स्थित है,  वह प्रिय वस्तु को प्राप्त होकर हर्षित नहीं होता और अप्रिय को पाकर उद्विग्न नहीं होता।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_020.mp3"},
  {id: "BG_5.21", label: "BG 5.21", ref: "5.21", chapter: 5, verse: 21, speaker: "krishna", canonical: true, meter: "anustubh", sa: "बाह्यस्पर्शेष्वसक्तात्मा विन्दत्यात्मनि यत्सुखम्", snippet: "With the self unattached to external contacts, he finds happiness in the Self; with the self engaged in the meditation of Brahman, he attains endless happiness.", sanskrit: "बाह्यस्पर्शेष्वसक्तात्मा विन्दत्यात्मनि यत्सुखम् ।\nस ब्रह्मयोगयुक्तात्मा सुखमक्षयमश्नुते ॥", iast: "bāhyasparśeṣvasaktātmā vindatyātmani yatsukham |\nsa brahmayogayuktātmā sukhamakṣayamaśnute ||", transliteration: "bāhya-sparśheṣhvasaktātmā vindatyātmani yat sukham\nsa brahma-yoga-yuktātmā sukham akṣhayam aśhnute", translation_en: "With the self unattached to external contacts, he finds happiness in the Self; with the self engaged in the meditation of Brahman, he attains endless happiness.", translation_hi: "बाह्य विषयों में आसक्तिरहित अन्त:करण वाला पुरुष आत्मा में ही सुख प्राप्त करता है;  ब्रह्म के ध्यान में समाहित चित्त वाला पुरुष अक्षय सुख प्राप्त करता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_021.mp3"},
  {id: "BG_5.22", label: "BG 5.22", ref: "5.22", chapter: 5, verse: 22, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ये हि संस्पर्शजा भोगा दुःखयोनय एव ते", snippet: "The enjoyments that arise from contact are only sources of pain, for they have a beginning and an end, O Arjuna; the wise do not rejoice in them.", sanskrit: "ये हि संस्पर्शजा भोगा दुःखयोनय एव ते ।\nआद्यन्तवन्तः कौन्तेय न तेषु रमते बुधः ॥", iast: "ye hi saṃsparśajā bhogā duḥkhayonaya eva te |\nādyantavantaḥ kaunteya na teṣu ramate budhaḥ ||", transliteration: "ye hi sansparśha-jā bhogā duḥkha-yonaya eva te\nādyantavantaḥ kaunteya na teṣhu ramate budhaḥ", translation_en: "The enjoyments that arise from contact are only sources of pain, for they have a beginning and an end, O Arjuna; the wise do not rejoice in them.", translation_hi: "हे कौन्तेय (इन्द्रिय तथा विषयों के) संयोग से उत्पन्न होने वाले जो भोग हैं वे दु:ख के ही हेतु हैं, क्योंकि वे आदि-अन्त वाले हैं। बुद्धिमान् पुरुष उनमें नहीं रमता।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_022.mp3"},
  {id: "BG_5.23", label: "BG 5.23", ref: "5.23", chapter: 5, verse: 23, speaker: "krishna", canonical: true, meter: "anustubh", sa: "शक्नोतीहैव यः सोढुं प्राक्शरीरविमोक्षणात्", snippet: "He who is able, while still here in this world, to withstand the impulse born out of desire and anger before the liberation from the body, he is a Yogi, and he is a happy man.", sanskrit: "शक्नोतीहैव यः सोढुं प्राक्शरीरविमोक्षणात् ।\nकामक्रोधोद्भवं वेगं स युक्तः स सुखी नरः ॥", iast: "śaknotīhaiva yaḥ soḍhuṃ prākśarīravimokṣaṇāt |\nkāmakrodhodbhavaṃ vegaṃ sa yuktaḥ sa sukhī naraḥ ||", transliteration: "śhaknotīhaiva yaḥ soḍhuṁ prāk śharīra-vimokṣhaṇāt\nkāma-krodhodbhavaṁ vegaṁ sa yuktaḥ sa sukhī naraḥ", translation_en: "He who is able, while still here in this world, to withstand the impulse born out of desire and anger before the liberation from the body, he is a Yogi, and he is a happy man.", translation_hi: "जो मनुष्य इसी लोक में शरीर त्यागने के पूर्व ही काम और क्रोध से उत्पन्न हुए वेग को सहन करने में समर्थ है,  वह योगी (युक्त) और सुखी मनुष्य है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_023.mp3"},
  {id: "BG_5.24", label: "BG 5.24", ref: "5.24", chapter: 5, verse: 24, speaker: "krishna", canonical: true, meter: "anustubh", sa: "योऽन्तःसुखोऽन्तरारामस्तथान्तर्ज्योतिरेव यः", snippet: "He who is happy within, who rejoices within, and who is illuminated within, that Yogi attains absolute freedom, or Moksha, becoming Brahman himself.", sanskrit: "योऽन्तःसुखोऽन्तरारामस्तथान्तर्ज्योतिरेव यः ।\nस योगी ब्रह्मनिर्वाणं ब्रह्मभूतोऽधिगच्छति ॥", iast: "yo’ntaḥsukho’ntarārāmastathāntarjyotireva yaḥ |\nsa yogī brahmanirvāṇaṃ brahmabhūto’dhigacchati ||", transliteration: "yo 'ntaḥ-sukho 'ntar-ārāmas tathāntar-jyotir eva yaḥ\nsa yogī brahma-nirvāṇaṁ brahma-bhūto 'dhigachchhati", translation_en: "He who is happy within, who rejoices within, and who is illuminated within, that Yogi attains absolute freedom, or Moksha, becoming Brahman himself.", translation_hi: "जो पुरुष अन्तरात्मा में ही सुख वाला,  आत्मा में ही आराम वाला तथा आत्मा में ही ज्ञान वाला है,  वह योगी ब्रह्मरूप बनकर ब्रह्मनिर्वाण अर्थात् परम मोक्ष को प्राप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_024.mp3"},
  {id: "BG_5.25", label: "BG 5.25", ref: "5.25", chapter: 5, verse: 25, speaker: "krishna", canonical: true, meter: "anustubh", sa: "लभन्ते ब्रह्मनिर्वाणमृषयः क्षीणकल्मषाः", snippet: "The sages obtain absolute freedom or Moksha when their sins have been destroyed, their dualities have been torn asunder, they are self-controlled, and they are intent on the…", sanskrit: "लभन्ते ब्रह्मनिर्वाणमृषयः क्षीणकल्मषाः ।\nछिन्नद्वैधा यतात्मानः सर्वभूतहिते रताः ॥", iast: "labhante brahmanirvāṇamṛṣayaḥ kṣīṇakalmaṣāḥ |\nchinnadvaidhā yatātmānaḥ sarvabhūtahite ratāḥ ||", transliteration: "labhante brahma-nirvāṇam ṛiṣhayaḥ kṣhīṇa-kalmaṣhāḥ\nchhinna-dvaidhā yatātmānaḥ sarva-bhūta-hite ratāḥ", translation_en: "The sages obtain absolute freedom or Moksha when their sins have been destroyed, their dualities have been torn asunder, they are self-controlled, and they are intent on the welfare of all beings.", translation_hi: "वे ऋषिगण मोक्ष को प्राप्त होते हैं - जिनके पाप नष्ट हो गये हैं, जो छिन्नसंशय, संयमी और भूतमात्र के हित में रमने वाले हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_025.mp3"},
  {id: "BG_5.26", label: "BG 5.26", ref: "5.26", chapter: 5, verse: 26, speaker: "krishna", canonical: true, meter: "anustubh", sa: "कामक्रोधवियुक्तानां यतीनां यतचेतसाम्", snippet: "Absolute freedom exists on all sides for those self-controlled ascetics who are free from desire and anger, who have controlled their thoughts, and who have realized the Self.", sanskrit: "कामक्रोधवियुक्तानां यतीनां यतचेतसाम् ।\nअभितो ब्रह्मनिर्वाणं वर्तते विदितात्मनाम् ॥", iast: "kāmakrodhaviyuktānāṃ yatīnāṃ yatacetasām |\nabhito brahmanirvāṇaṃ vartate viditātmanām ||", transliteration: "kāma-krodha-viyuktānāṁ yatīnāṁ yata-chetasām\nabhito brahma-nirvāṇaṁ vartate viditātmanām", translation_en: "Absolute freedom exists on all sides for those self-controlled ascetics who are free from desire and anger, who have controlled their thoughts, and who have realized the Self.", translation_hi: "काम और क्रोध से रहित,  संयतचित्त वाले तथा आत्मा को जानने वाले यतियों के लिए सब ओर मोक्ष (या ब्रह्मानन्द) विद्यमान रहता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_026.mp3"},
  {id: "BG_5.27", label: "BG 5.27", ref: "5.27", chapter: 5, verse: 27, speaker: "krishna", canonical: true, meter: "anustubh", sa: "स्पर्शान्कृत्वा बहिर्बाह्यांश्चक्षुश्चैवान्तरे भ्रुवोः", snippet: "Shutting out all external contacts and fixing the gaze between the eyebrows, realizing the outgoing and incoming breaths moving within the nostrils.", sanskrit: "स्पर्शान्कृत्वा बहिर्बाह्यांश्चक्षुश्चैवान्तरे भ्रुवोः ।\nप्राणापानौ समौ कृत्वा नासाभ्यन्तरचारिणौ ॥", iast: "sparśānkṛtvā bahirbāhyāṃścakṣuścaivāntare bhruvoḥ |\nprāṇāpānau samau kṛtvā nāsābhyantaracāriṇau ||", transliteration: "sparśhān kṛitvā bahir bāhyānśh chakṣhuśh chaivāntare bhruvoḥ\nprāṇāpānau samau kṛitvā nāsābhyantara-chāriṇau\nyatendriya-mano-buddhir munir mokṣha-parāyaṇaḥ\nvigatechchhā-bhaya-krodho yaḥ sadā mukta eva saḥ", translation_en: "Shutting out all external contacts and fixing the gaze between the eyebrows, realizing the outgoing and incoming breaths moving within the nostrils.", translation_hi: "बाह्य विषयों को बाहर ही रखकर नेत्रों की दृष्टि को भृकुटि के बीच में स्थित करके तथा नासिका में विचरने वाले प्राण और अपानवायु को सम करके,।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_027.mp3"},
  {id: "BG_5.28", label: "BG 5.28", ref: "5.28", chapter: 5, verse: 28, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यतेन्द्रियमनोबुद्धिर्मुनिर्मोक्षपरायणः", snippet: "With the senses, mind, and intellect ever controlled, having liberation as their supreme goal, free from desire, fear, and anger, the sage is truly liberated forever.", sanskrit: "यतेन्द्रियमनोबुद्धिर्मुनिर्मोक्षपरायणः ।\nविगतेच्छाभयक्रोधो यः सदा मुक्त एव सः ॥", iast: "yatendriyamanobuddhirmunirmokṣaparāyaṇaḥ |\nvigatecchābhayakrodho yaḥ sadā mukta eva saḥ ||", transliteration: "yatendriya-mano-buddhir  munir   mokṣa-parāyaṇaḥ vigatecchā-bhaya-krodho yaḥ sadā    mukta   eva saḥ", translation_en: "With the senses, mind, and intellect ever controlled, having liberation as their supreme goal, free from desire, fear, and anger, the sage is truly liberated forever.", translation_hi: "जिस पुरुष की इन्द्रियाँ,  मन और बुद्धि संयत हैं, ऐसा मोक्ष परायण मुनि इच्छा, भय और क्रोध से रहित है, वह सदा मुक्त ही है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_028.mp3"},
  {id: "BG_5.29", label: "BG 5.29", ref: "5.29", chapter: 5, verse: 29, speaker: "krishna", canonical: true, meter: "anustubh", sa: "भोक्तारं यज्ञतपसां सर्वलोकमहेश्वरम्", snippet: "He who knows Me as the enjoyer of sacrifices and austerities, the great Lord of all the worlds, and the friend of all beings, attains peace.", sanskrit: "भोक्तारं यज्ञतपसां सर्वलोकमहेश्वरम् ।\nसुहृदं सर्वभूतानां ज्ञात्वा मां शान्तिमृच्छति ॥", iast: "bhoktāraṃ yajñatapasāṃ sarvalokamaheśvaram |\nsuhṛdaṃ sarvabhūtānāṃ jñātvā māṃ śāntimṛcchati ||", transliteration: "bhoktāraṁ yajña-tapasāṁ sarva-loka-maheśhvaram\nsuhṛidaṁ sarva-bhūtānāṁ jñātvā māṁ śhāntim ṛichchhati", translation_en: "He who knows Me as the enjoyer of sacrifices and austerities, the great Lord of all the worlds, and the friend of all beings, attains peace.", translation_hi: "(साधक भक्त) मुझे यज्ञ और तपों का भोक्ता और सम्पूर्ण लोकों का महान् ईश्वर तथा भूतमात्र का सुहृद् (मित्र) जानकर शान्ति को प्राप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/005_029.mp3"},
  {id: "BG_6.1", label: "BG 6.1", ref: "6.1", chapter: 6, verse: 1, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अनाश्रितः कर्मफलं कार्यं कर्म करोति यः", snippet: "The Blessed Lord said: He who performs his bounden duty without depending on the fruits of his actions—he is a sannyasi and a yogi, not he who is without fire and without action.", sanskrit: "अनाश्रितः कर्मफलं कार्यं कर्म करोति यः ।\nस संन्यासी च योगी च न निरग्निर्न चाक्रियः ॥", iast: "anāśritaḥ karmaphalaṃ kāryaṃ karma karoti yaḥ |\nsa saṃnyāsī ca yogī ca na niragnirna cākriyaḥ ||", transliteration: "anāśhritaḥ karma-phalaṁ kāryaṁ karma karoti yaḥ\nsa sannyāsī cha yogī cha na niragnir na chākriyaḥ", translation_en: "The Blessed Lord said: He who performs his bounden duty without depending on the fruits of his actions—he is a sannyasi and a yogi, not he who is without fire and without action.", translation_hi: "श्रीभगवान् ने कहा -- जो पुरुष कर्मफल पर आश्रित न होकर कर्तव्य कर्म करता है, वह संन्यासी और योगी है, न कि वह जिसने केवल अग्नि का और क्रियायों का त्याग किया है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_001.mp3"},
  {id: "BG_6.2", label: "BG 6.2", ref: "6.2", chapter: 6, verse: 2, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यं संन्यासमिति प्राहुर्योगं तं विद्धि पाण्डव", snippet: "Do you, O Arjuna, know that Yoga is what they call renunciation; no one indeed becomes a Yogi who has not renounced their thoughts.", sanskrit: "यं संन्यासमिति प्राहुर्योगं तं विद्धि पाण्डव ।\nन ह्यसंन्यस्तसङ्कल्पो योगी भवति कश्चन ॥", iast: "yaṃ saṃnyāsamiti prāhuryogaṃ taṃ viddhi pāṇḍava |\nna hyasaṃnyastasaṅkalpo yogī bhavati kaścana ||", transliteration: "yaṁ sannyāsam iti prāhur yogaṁ taṁ viddhi pāṇḍava\nna hyasannyasta-saṅkalpo yogī bhavati kaśhchana", translation_en: "Do you, O Arjuna, know that Yoga is what they call renunciation; no one indeed becomes a Yogi who has not renounced their thoughts.", translation_hi: "हे पाण्डव ! जिसको (शास्त्रवित्) संन्यास कहते हैं, उसी को तुम योग समझो; क्योंकि संकल्पों को न त्यागने वाला कोई भी पुरुष योगी नहीं होता।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_002.mp3"},
  {id: "BG_6.3", label: "BG 6.3", ref: "6.3", chapter: 6, verse: 3, speaker: "krishna", canonical: true, meter: "anustubh", sa: "आरुरुक्षोर्मुनेर्योगं कर्म कारणमुच्यते", snippet: "For a sage who wishes to attain to Yoga, action is said to be the means; for the same sage who has attained Yoga, inaction is said to be the means.", sanskrit: "आरुरुक्षोर्मुनेर्योगं कर्म कारणमुच्यते ।\nयोगारूढस्य तस्यैव शमः कारणमुच्यते ॥", iast: "ārurukṣormuneryogaṃ karma kāraṇamucyate |\nyogārūḍhasya tasyaiva śamaḥ kāraṇamucyate ||", transliteration: "ārurukṣhor muner yogaṁ karma kāraṇam uchyate\nyogārūḍhasya tasyaiva śhamaḥ kāraṇam uchyate", translation_en: "For a sage who wishes to attain to Yoga, action is said to be the means; for the same sage who has attained Yoga, inaction is said to be the means.", translation_hi: "योग में आरूढ़ होने की इच्छा वाले मुनि के लिए कर्म करना ही हेतु (साधन) कहा है और योगारूढ़ हो जाने पर उसी पुरुष के लिए शम को (शांति, संकल्पसंन्यास) साधन कहा गया है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_003.mp3"},
  {id: "BG_6.4", label: "BG 6.4", ref: "6.4", chapter: 6, verse: 4, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यदा हि नेन्द्रियार्थेषु न कर्मस्वनुषज्जते", snippet: "When a person is not attached to the sense-objects or to actions, having renounced all thoughts, then they are said to have attained Yoga.", sanskrit: "यदा हि नेन्द्रियार्थेषु न कर्मस्वनुषज्जते ।\nसर्वसङ्कल्पसंन्यासी योगारूढस्तदोच्यते ॥", iast: "yadā hi nendriyārtheṣu na karmasvanuṣajjate |\nsarvasaṅkalpasaṃnyāsī yogārūḍhastadocyate ||", transliteration: "yadā hi nendriyārtheṣhu na karmasv-anuṣhajjate\nsarva-saṅkalpa-sannyāsī yogārūḍhas tadochyate", translation_en: "When a person is not attached to the sense-objects or to actions, having renounced all thoughts, then they are said to have attained Yoga.", translation_hi: "जब (साधक) न इन्द्रियों के विषयों में और न कर्मों में आसक्त होता है तब सर्व संकल्पों के संन्यासी को योगारूढ़ कहा जाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_004.mp3"},
  {id: "BG_6.5", label: "BG 6.5", ref: "6.5", chapter: 6, verse: 5, speaker: "krishna", canonical: true, meter: "anustubh", sa: "उद्धरेदात्मनाऽऽत्मानं नात्मानमवसादयेत्", snippet: "One should raise oneself by one's own self alone; let not one lower oneself; for the self alone is one's own friend, and the self alone is one's own enemy.", sanskrit: "उद्धरेदात्मनाऽऽत्मानं नात्मानमवसादयेत् ।\nआत्मैव ह्यात्मनो बन्धुरात्मैव रिपुरात्मनः ॥", iast: "uddharedātmanā’’tmānaṃ nātmānamavasādayet |\nātmaiva hyātmano bandhurātmaiva ripurātmanaḥ ||", transliteration: "uddhared ātmanātmānaṁ nātmānam avasādayet\nātmaiva hyātmano bandhur ātmaiva ripur ātmanaḥ", translation_en: "One should raise oneself by one's own self alone; let not one lower oneself; for the self alone is one's own friend, and the self alone is one's own enemy.", translation_hi: "मनुष्य को अपने द्वारा अपना उद्धार करना चाहिये और अपना अध: पतन नहीं करना चाहिये; क्योंकि आत्मा ही आत्मा का मित्र है और आत्मा (मनुष्य स्वयं) ही आत्मा का (अपना) शत्रु है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_005.mp3"},
  {id: "BG_6.6", label: "BG 6.6", ref: "6.6", chapter: 6, verse: 6, speaker: "krishna", canonical: true, meter: "anustubh", sa: "बन्धुरात्माऽऽत्मनस्तस्य येनात्मैवात्मना जितः", snippet: "The Self is the friend of the self of him by whom the Self has been conquered; but to the unconquered self, this Self stands in the position of an enemy, like an external foe.", sanskrit: "बन्धुरात्माऽऽत्मनस्तस्य येनात्मैवात्मना जितः ।\nअनात्मनस्तु शत्रुत्वे वर्तेतात्मैव शत्रुवत् ॥", iast: "bandhurātmā’’tmanastasya yenātmaivātmanā jitaḥ |\nanātmanastu śatrutve vartetātmaiva śatruvat ||", transliteration: "bandhur ātmātmanas tasya yenātmaivātmanā jitaḥ\nanātmanas tu śhatrutve vartetātmaiva śhatru-vat", translation_en: "The Self is the friend of the self of him by whom the Self has been conquered; but to the unconquered self, this Self stands in the position of an enemy, like an external foe.", translation_hi: "जिसने आत्मा (इंद्रियों,आदि) को आत्मा के द्वारा जीत लिया है, उस पुरुष का आत्मा उसका मित्र होता है, परन्तु अजितेन्द्रिय के लिए आत्मा शत्रु के समान स्थित होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_006.mp3"},
  {id: "BG_6.7", label: "BG 6.7", ref: "6.7", chapter: 6, verse: 7, speaker: "krishna", canonical: true, meter: "anustubh", sa: "जितात्मनः प्रशान्तस्य परमात्मा समाहितः", snippet: "The Supreme Self of him who is self-controlled and peaceful remains balanced in cold and heat, pleasure and pain, as well as in honor and dishonor.", sanskrit: "जितात्मनः प्रशान्तस्य परमात्मा समाहितः ।\nशीतोष्णसुखदुःखेषु तथा मानापमानयोः ॥", iast: "jitātmanaḥ praśāntasya paramātmā samāhitaḥ |\nśītoṣṇasukhaduḥkheṣu tathā mānāpamānayoḥ ||", transliteration: "jitātmanaḥ praśhāntasya paramātmā samāhitaḥ\nśhītoṣhṇa-sukha-duḥkheṣhu tathā mānāpamānayoḥ", translation_en: "The Supreme Self of him who is self-controlled and peaceful remains balanced in cold and heat, pleasure and pain, as well as in honor and dishonor.", translation_hi: "शीत-उष्ण, सुख-दु:ख तथा मान-अपमान में जो प्रशान्त रहता है, ऐसे जितात्मा पुरुष के लिये परमात्मा सम्यक् प्रकार से स्थित है, अर्थात्, आत्मरूप से विद्यमान है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_007.mp3"},
  {id: "BG_6.8", label: "BG 6.8", ref: "6.8", chapter: 6, verse: 8, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ज्ञानविज्ञानतृप्तात्मा कूटस्थो विजितेन्द्रियः", snippet: "The Yogi who is satisfied with the knowledge and wisdom of the Self, who has conquered the senses, and to whom a clod of earth, a piece of stone, and gold are all the same, is…", sanskrit: "ज्ञानविज्ञानतृप्तात्मा कूटस्थो विजितेन्द्रियः ।\nयुक्त इत्युच्यते योगी समलोष्टाश्मकाञ्चनः ॥", iast: "jñānavijñānatṛptātmā kūṭastho vijitendriyaḥ |\nyukta ityucyate yogī samaloṣṭāśmakāñcanaḥ ||", transliteration: "jñāna-vijñāna-tṛiptātmā kūṭa-stho vijitendriyaḥ\nyukta ityuchyate yogī sama-loṣhṭāśhma-kāñchanaḥ", translation_en: "The Yogi who is satisfied with the knowledge and wisdom of the Self, who has conquered the senses, and to whom a clod of earth, a piece of stone, and gold are all the same, is said to have attained Nirvikalpa Samadhi.", translation_hi: "जो योगी ज्ञान और विज्ञान से तृप्त है, जो विकार रहित (कूटस्थ) और जितेन्द्रिय है, जिसको मिट्टी, पाषाण और कंचन समान है, वह (परमात्मा से) युक्त कहलाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_008.mp3"},
  {id: "BG_6.9", label: "BG 6.9", ref: "6.9", chapter: 6, verse: 9, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सुहृन्मित्रार्युदासीनमध्यस्थद्वेष्यबन्धुषु", snippet: "He who is of the same mind towards the good-hearted, friends, enemies, the indifferent, the neutral, the hateful, the relatives, the righteous, and the unrighteous, excels.", sanskrit: "सुहृन्मित्रार्युदासीनमध्यस्थद्वेष्यबन्धुषु ।\nसाधुष्वपि च पापेषु समबुद्धिर्विशिष्यते ॥", iast: "suhṛnmitrāryudāsīnamadhyasthadveṣyabandhuṣu |\nsādhuṣvapi ca pāpeṣu samabuddhirviśiṣyate ||", transliteration: "suhṛin-mitrāryudāsīna-madhyastha-dveṣhya-bandhuṣhu\nsādhuṣhvapi cha pāpeṣhu sama-buddhir viśhiṣhyate", translation_en: "He who is of the same mind towards the good-hearted, friends, enemies, the indifferent, the neutral, the hateful, the relatives, the righteous, and the unrighteous, excels.", translation_hi: "जो पुरुष सुहृद्, मित्र, शत्रु, उदासीन, मध्यस्थ, द्वेषी और बान्धवों में तथा धर्मात्माओं में और पापियों में भी समान भाव वाला है, वह श्रेष्ठ है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_009.mp3"},
  {id: "BG_6.10", label: "BG 6.10", ref: "6.10", chapter: 6, verse: 10, speaker: "krishna", canonical: true, meter: "anustubh", sa: "योगी युञ्जीत सततमात्मानं रहसि स्थितः", snippet: "Let the yogi constantly strive to keep the mind steady, remaining in solitude, alone, with the body and mind controlled, and free from hope and greed.", sanskrit: "योगी युञ्जीत सततमात्मानं रहसि स्थितः ।\nएकाकी यतचित्तात्मा निराशीरपरिग्रहः ॥", iast: "yogī yuñjīta satatamātmānaṃ rahasi sthitaḥ |\nekākī yatacittātmā nirāśīraparigrahaḥ ||", transliteration: "yogī yuñjīta satatam ātmānaṁ rahasi sthitaḥ\nekākī yata-chittātmā nirāśhīr aparigrahaḥ", translation_en: "Let the yogi constantly strive to keep the mind steady, remaining in solitude, alone, with the body and mind controlled, and free from hope and greed.", translation_hi: "शरीर और मन को संयमित किया हुआ योगी एकान्त स्थान पर अकेला रहता हुआ आशा और परिग्रह से मुक्त होकर निरन्तर मन को आत्मा में स्थिर करे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_010.mp3"},
  {id: "BG_6.11", label: "BG 6.11", ref: "6.11", chapter: 6, verse: 11, speaker: "krishna", canonical: true, meter: "anustubh", sa: "शुचौ देशे प्रतिष्ठाप्य स्थिरमासनमात्मनः", snippet: "In a clean spot, having established a firm seat of his own, neither too high nor too low, made of cloth, skin, and kusha grass layered one over the other.", sanskrit: "शुचौ देशे प्रतिष्ठाप्य स्थिरमासनमात्मनः ।\nनात्युच्छ्रितं नातिनीचं चैलाजिनकुशोत्तरम् ॥", iast: "śucau deśe pratiṣṭhāpya sthiramāsanamātmanaḥ |\nnātyucchritaṃ nātinīcaṃ cailājinakuśottaram ||", transliteration: "śhuchau deśhe pratiṣhṭhāpya sthiram āsanam ātmanaḥ\nnātyuchchhritaṁ nāti-nīchaṁ chailājina-kuśhottaram", translation_en: "In a clean spot, having established a firm seat of his own, neither too high nor too low, made of cloth, skin, and kusha grass layered one over the other.", translation_hi: "शुद्ध (स्वच्छ) भूमि में कुश, मृगशाला और उस पर वस्त्र रखा हो ऐसे अपने आसन को न अति ऊँचा और न अति नीचा स्थिर स्थापित करके....৷৷.।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_011.mp3"},
  {id: "BG_6.12", label: "BG 6.12", ref: "6.12", chapter: 6, verse: 12, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तत्रैकाग्रं मनः कृत्वा यतचित्तेन्द्रियक्रियः", snippet: "There, having made the mind one-pointed, with the actions of the mind and senses controlled, let him, seated on the seat, practice Yoga for the purification of the self.", sanskrit: "तत्रैकाग्रं मनः कृत्वा यतचित्तेन्द्रियक्रियः ।\nउपविश्यासने युञ्ज्याद्योगमात्मविशुद्धये ॥", iast: "tatraikāgraṃ manaḥ kṛtvā yatacittendriyakriyaḥ |\nupaviśyāsane yuñjyādyogamātmaviśuddhaye ||", transliteration: "tatraikāgraṁ manaḥ kṛitvā yata-chittendriya-kriyaḥ\nupaviśhyāsane yuñjyād yogam ātma-viśhuddhaye", translation_en: "There, having made the mind one-pointed, with the actions of the mind and senses controlled, let him, seated on the seat, practice Yoga for the purification of the self.", translation_hi: "वहाँ (आसन में बैठकर) मन को एकाग्र करके, चित्त और इन्द्रियों की क्रियाओं को वश में किये हुये आत्मशुद्धि के लिए योग का अभ्यास करे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_012.mp3"},
  {id: "BG_6.13", label: "BG 6.13", ref: "6.13", chapter: 6, verse: 13, speaker: "krishna", canonical: true, meter: "anustubh", sa: "समं कायशिरोग्रीवं धारयन्नचलं स्थिरः", snippet: "Let him firmly hold his body, head, and neck erect and still, gazing at the tip of his nose without looking around.", sanskrit: "समं कायशिरोग्रीवं धारयन्नचलं स्थिरः ।\nसंप्रेक्ष्य नासिकाग्रं स्वं दिशश्चानवलोकयन् ॥", iast: "samaṃ kāyaśirogrīvaṃ dhārayannacalaṃ sthiraḥ |\nsaṃprekṣya nāsikāgraṃ svaṃ diśaścānavalokayan ||", transliteration: "samaṁ kāya-śhiro-grīvaṁ dhārayann achalaṁ sthiraḥ\nsamprekṣhya nāsikāgraṁ svaṁ diśhaśh chānavalokayan", translation_en: "Let him firmly hold his body, head, and neck erect and still, gazing at the tip of his nose without looking around.", translation_hi: "काया, सिर और ग्रीवा को समान और अचल धारण किये हुए स्थिर होकर अपनी नासिका के अग्र भाग को देखकर अन्य दिशाओं को न देखता हुआ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_013.mp3"},
  {id: "BG_6.14", label: "BG 6.14", ref: "6.14", chapter: 6, verse: 14, speaker: "krishna", canonical: true, meter: "anustubh", sa: "प्रशान्तात्मा विगतभीर्ब्रह्मचारिव्रते स्थितः", snippet: "Serene-minded, fearless, firm in the vow of a Brahmachari, having controlled their mind, thinking of Me and balanced in mind, let them sit, having Me as their supreme goal.", sanskrit: "प्रशान्तात्मा विगतभीर्ब्रह्मचारिव्रते स्थितः ।\nमनः संयम्य मच्चित्तो युक्त आसीत मत्परः ॥", iast: "praśāntātmā vigatabhīrbrahmacārivrate sthitaḥ |\nmanaḥ saṃyamya maccitto yukta āsīta matparaḥ ||", transliteration: "praśhāntātmā vigata-bhīr brahmachāri-vrate sthitaḥ\nmanaḥ sanyamya mach-chitto yukta āsīta mat-paraḥ", translation_en: "Serene-minded, fearless, firm in the vow of a Brahmachari, having controlled their mind, thinking of Me and balanced in mind, let them sit, having Me as their supreme goal.", translation_hi: "(साधक को) प्रशान्त अन्त:करण, निर्भय और ब्रह्मचर्य ब्रत में स्थित होकर, मन को संयमित करके चित्त को मुझमें लगाकर मुझे ही परम लक्ष्य समझकर बैठना चाहिए।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_014.mp3"},
  {id: "BG_6.15", label: "BG 6.15", ref: "6.15", chapter: 6, verse: 15, speaker: "krishna", canonical: true, meter: "anustubh", sa: "युञ्जन्नेवं सदाऽऽत्मानं योगी नियतमानसः", snippet: "Thus, always keeping the mind balanced, the yogi, with the mind controlled, attains the peace abiding in Me, culminating in liberation.", sanskrit: "युञ्जन्नेवं सदाऽऽत्मानं योगी नियतमानसः ।\nशान्तिं निर्वाणपरमां मत्संस्थामधिगच्छति ॥", iast: "yuñjannevaṃ sadā’’tmānaṃ yogī niyatamānasaḥ |\nśāntiṃ nirvāṇaparamāṃ matsaṃsthāmadhigacchati ||", transliteration: "yuñjann evaṁ sadātmānaṁ yogī niyata-mānasaḥ\nśhantiṁ nirvāṇa-paramāṁ mat-sansthām adhigachchhati", translation_en: "Thus, always keeping the mind balanced, the yogi, with the mind controlled, attains the peace abiding in Me, culminating in liberation.", translation_hi: "इस प्रकार सदा मन को स्थिर करने का प्रयास करता हुआ संयमित मन का योगी मुझमें स्थित परम निर्वाण (मोक्ष) स्वरूप शांति को प्राप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_015.mp3"},
  {id: "BG_6.16", label: "BG 6.16", ref: "6.16", chapter: 6, verse: 16, speaker: "krishna", canonical: true, meter: "anustubh", sa: "नात्यश्नतस्तु योगोऽस्ति न चैकान्तमनश्नतः", snippet: "Verily, Yoga is not possible for him who eats too much, nor for him who does not eat at all, nor for him who sleeps too much, nor for him who is always awake, O Arjuna.", sanskrit: "नात्यश्नतस्तु योगोऽस्ति न चैकान्तमनश्नतः ।\nन चातिस्वप्नशीलस्य जाग्रतो नैव चार्जुन ॥", iast: "nātyaśnatastu yogo’sti na caikāntamanaśnataḥ |\nna cātisvapnaśīlasya jāgrato naiva cārjuna ||", transliteration: "nātyaśhnatastu yogo ’sti na chaikāntam anaśhnataḥ\nna chāti-svapna-śhīlasya jāgrato naiva chārjuna", translation_en: "Verily, Yoga is not possible for him who eats too much, nor for him who does not eat at all, nor for him who sleeps too much, nor for him who is always awake, O Arjuna.", translation_hi: "परन्तु, हे अर्जुन ! यह योग उस पुरुष के लिए सम्भव नहीं होता, जो अधिक खाने वाला है या बिल्कुल न खाने वाला है तथा जो अधिक सोने वाला है या सदा जागने वाला है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_016.mp3"},
  {id: "BG_6.17", label: "BG 6.17", ref: "6.17", chapter: 6, verse: 17, speaker: "krishna", canonical: true, meter: "anustubh", sa: "युक्ताहारविहारस्य युक्तचेष्टस्य कर्मसु", snippet: "Yoga becomes the destroyer of pain for him who is moderate in eating and recreation (such as walking, etc.), who exercises moderation in action, and who is moderate in sleep…", sanskrit: "युक्ताहारविहारस्य युक्तचेष्टस्य कर्मसु ।\nयुक्तस्वप्नावबोधस्य योगो भवति दुःखहा ॥", iast: "yuktāhāravihārasya yuktaceṣṭasya karmasu |\nyuktasvapnāvabodhasya yogo bhavati duḥkhahā ||", transliteration: "yuktāhāra-vihārasya yukta-cheṣhṭasya karmasu\nyukta-svapnāvabodhasya yogo bhavati duḥkha-hā", translation_en: "Yoga becomes the destroyer of pain for him who is moderate in eating and recreation (such as walking, etc.), who exercises moderation in action, and who is moderate in sleep and wakefulness.", translation_hi: "उस पुरुष के लिए योग दु:खनाशक होता है, जो युक्त आहार और विहार करने वाला है, यथायोग्य चेष्टा करने वाला है और परिमित शयन और जागरण करने वाला है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_017.mp3"},
  {id: "BG_6.18", label: "BG 6.18", ref: "6.18", chapter: 6, verse: 18, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यदा विनियतं चित्तमात्मन्येवावतिष्ठते", snippet: "When the perfectly controlled mind rests in the Self alone, free from longing for any of the objects of desire, then it is said, 'He is united'.", sanskrit: "यदा विनियतं चित्तमात्मन्येवावतिष्ठते ।\nनिःस्पृहः सर्वकामेभ्यो युक्त इत्युच्यते तदा ॥", iast: "yadā viniyataṃ cittamātmanyevāvatiṣṭhate |\nniḥspṛhaḥ sarvakāmebhyo yukta ityucyate tadā ||", transliteration: "yadā viniyataṁ chittam ātmanyevāvatiṣhṭhate\nniḥspṛihaḥ sarva-kāmebhyo yukta ityuchyate tadā", translation_en: "When the perfectly controlled mind rests in the Self alone, free from longing for any of the objects of desire, then it is said, 'He is united'.", translation_hi: "वश में किया हुआ चित्त जिस कालमें अपने स्वरुपमें ही स्थित हो जाता है और स्वयं सम्पूर्ण पदार्थों नि: स्पृह हो जाता है, उस कालमें वह योगी कहा जाता है।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_018.mp3"},
  {id: "BG_6.19", label: "BG 6.19", ref: "6.19", chapter: 6, verse: 19, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यथा दीपो निवातस्थो नेङ्गते सोपमा स्मृता", snippet: "As a lamp placed in a windless spot does not flicker, so is the Yogi of a controlled mind, who practices Yoga in the Self, compared.", sanskrit: "यथा दीपो निवातस्थो नेङ्गते सोपमा स्मृता ।\nयोगिनो यतचित्तस्य युञ्जतो योगमात्मनः ॥", iast: "yathā dīpo nivātastho neṅgate sopamā smṛtā |\nyogino yatacittasya yuñjato yogamātmanaḥ ||", transliteration: "yathā dīpo nivāta-stho neṅgate sopamā smṛitā\nyogino yata-chittasya yuñjato yogam ātmanaḥ", translation_en: "As a lamp placed in a windless spot does not flicker, so is the Yogi of a controlled mind, who practices Yoga in the Self, compared.", translation_hi: "जैसे स्पन्दनरहित वायुके स्थानमें स्थित दीपककी लौ चेष्टारहित हो जाती है, योगका अभ्यास करते हुए यतचित्तवाले योगीके चित्तकी वैसी ही उपमा कही गयी है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_019.mp3"},
  {id: "BG_6.20", label: "BG 6.20", ref: "6.20", chapter: 6, verse: 20, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यत्रोपरमते चित्तं निरुद्धं योगसेवया", snippet: "When the mind, restrained by the practice of yoga, attains quietude, and when one sees the Self by the Self, they are satisfied in their own Self.", sanskrit: "यत्रोपरमते चित्तं निरुद्धं योगसेवया ।\nयत्र चैवात्मनाऽऽत्मानं पश्यन्नात्मनि तुष्यति ॥", iast: "yatroparamate cittaṃ niruddhaṃ yogasevayā |\nyatra caivātmanā’’tmānaṃ paśyannātmani tuṣyati ||", transliteration: "yatroparamate chittaṁ niruddhaṁ yoga-sevayā\nyatra chaivātmanātmānaṁ paśhyann ātmani tuṣhyati", translation_en: "When the mind, restrained by the practice of yoga, attains quietude, and when one sees the Self by the Self, they are satisfied in their own Self.", translation_hi: "योगका सेवन करनेसे जिस अवस्थामें निरुध्द चित्त उपराम हो जाता है तथा जिस अवस्थामें स्वयं अपने-आपमें अपने-आपको देखता हुआ अपने-आपमें सन्तुष्ट हो जाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_020.mp3"},
  {id: "BG_6.21", label: "BG 6.21", ref: "6.21", chapter: 6, verse: 21, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सुखमात्यन्तिकं यत्तद्बुद्धिग्राह्यमतीन्द्रियम्", snippet: "When he (the Yogi) feels that infinite bliss which can be grasped by the pure intellect and which transcends the senses, and is established therein, never moving away from the…", sanskrit: "सुखमात्यन्तिकं यत्तद्बुद्धिग्राह्यमतीन्द्रियम् ।\nवेत्ति यत्र न चैवायं स्थितश्चलति तत्त्वतः ॥", iast: "sukhamātyantikaṃ yattadbuddhigrāhyamatīndriyam |\nvetti yatra na caivāyaṃ sthitaścalati tattvataḥ ||", transliteration: "sukham ātyantikaṁ yat tad buddhi-grāhyam atīndriyam\nvetti yatra na chaivāyaṁ sthitaśh chalati tattvataḥ", translation_en: "When he (the Yogi) feels that infinite bliss which can be grasped by the pure intellect and which transcends the senses, and is established therein, never moving away from the reality.", translation_hi: "जो सुख आत्यन्तिक, अतीन्द्रिय और बुध्दिग्राह्म है, उस सुखका जिस अवस्थामें अनुभव करता है और जिस सुखमें स्थित हुआ यह ध्यानयोगी फिर कभी तत्वसे विचलित नहीं होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_021.mp3"},
  {id: "BG_6.22", label: "BG 6.22", ref: "6.22", chapter: 6, verse: 22, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यं लब्ध्वा चापरं लाभं मन्यते नाधिकं ततः", snippet: "Having obtained it, he thinks there is no other gain superior to it; established in it, he is not moved even by heavy sorrow.", sanskrit: "यं लब्ध्वा चापरं लाभं मन्यते नाधिकं ततः ।\nयस्मिन्स्थितो न दुःखेन गुरुणापि विचाल्यते ॥", iast: "yaṃ labdhvā cāparaṃ lābhaṃ manyate nādhikaṃ tataḥ |\nyasminsthito na duḥkhena guruṇāpi vicālyate ||", transliteration: "yaṁ labdhvā chāparaṁ lābhaṁ manyate nādhikaṁ tataḥ\nyasmin sthito na duḥkhena guruṇāpi vichālyate", translation_en: "Having obtained it, he thinks there is no other gain superior to it; established in it, he is not moved even by heavy sorrow.", translation_hi: "जिस लाभकी प्राप्ति होनेपर उससे अधिक कोई दूसरा लाभ उसके माननेमें भी नहीं आता और जिसमें स्थित होनेपर वह बड़े भारी दु:ख से भी विचलित नहीं होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_022.mp3"},
  {id: "BG_6.23", label: "BG 6.23", ref: "6.23", chapter: 6, verse: 23, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तं विद्याद् दुःखसंयोगवियोगं योगसंज्ञितम्", snippet: "Let this be known by the name of Yoga, the severance from union with pain. This Yoga should be practiced with determination and with an undespairing mind.", sanskrit: "तं विद्याद् दुःखसंयोगवियोगं योगसंज्ञितम् ।\nस निश्चयेन योक्तव्यो योगोऽनिर्विण्णचेतसा ॥", iast: "taṃ vidyād duḥkhasaṃyogaviyogaṃ yogasaṃjñitam |\nsa niścayena yoktavyo yogo’nirviṇṇacetasā ||", transliteration: "taṁ vidyād duḥkha-sanyoga-viyogaṁ yogasaṅjñitam\nsa niśhchayena yoktavyo yogo ’nirviṇṇa-chetasā", translation_en: "Let this be known by the name of Yoga, the severance from union with pain. This Yoga should be practiced with determination and with an undespairing mind.", translation_hi: "दु:ख के संयोग से वियोग है, उसीको 'योग' नामसे जानना चाहिये । (वह योग जिस ध्यानयोग लक्ष्य है,) उस ध्यानयोका अभ्यास न उकताये हुए चित्तसे   निश्चयपूर्वक करना चाहिये।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_023.mp3"},
  {id: "BG_6.24", label: "BG 6.24", ref: "6.24", chapter: 6, verse: 24, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सङ्कल्पप्रभवान्कामांस्त्यक्त्वा सर्वानशेषतः", snippet: "Abandoning unreservedly all desires born of Sankalpa (thought and imagination) and completely restraining the whole group of senses by the mind from all sides.", sanskrit: "सङ्कल्पप्रभवान्कामांस्त्यक्त्वा सर्वानशेषतः ।\nमनसैवेन्द्रियग्रामं विनियम्य समन्ततः ॥", iast: "saṅkalpaprabhavānkāmāṃstyaktvā sarvānaśeṣataḥ |\nmanasaivendriyagrāmaṃ viniyamya samantataḥ ||", transliteration: "saṅkalpa-prabhavān kāmāns tyaktvā sarvān aśheṣhataḥ\nmanasaivendriya-grāmaṁ viniyamya samantataḥ", translation_en: "Abandoning unreservedly all desires born of Sankalpa (thought and imagination) and completely restraining the whole group of senses by the mind from all sides.", translation_hi: "संकल्प से उत्पन्न समस्त कामनाओं को नि:शेष रूप से परित्याग कर मन के द्वारा इन्द्रिय समुदाय को सब ओर से सम्यक् प्रकार वश में करके।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_024.mp3"},
  {id: "BG_6.25", label: "BG 6.25", ref: "6.25", chapter: 6, verse: 25, speaker: "krishna", canonical: true, meter: "anustubh", sa: "शनैः शनैरुपरमेद् बुद्ध्या धृतिगृहीतया", snippet: "Little by little, let him attain steadiness of the intellect by holding it firmly; having made the mind establish itself in the Self, let him not think of anything else.", sanskrit: "शनैः शनैरुपरमेद् बुद्ध्या धृतिगृहीतया ।\nआत्मसंस्थं मनः कृत्वा न किञ्चिदपि चिन्तयेत् ॥", iast: "śanaiḥ śanairuparamed buddhyā dhṛtigṛhītayā |\nātmasaṃsthaṃ manaḥ kṛtvā na kiñcidapi cintayet ||", transliteration: "śhanaiḥ śhanair uparamed buddhyā dhṛiti-gṛihītayā\nātma-sansthaṁ manaḥ kṛitvā na kiñchid api chintayet", translation_en: "Little by little, let him attain steadiness of the intellect by holding it firmly; having made the mind establish itself in the Self, let him not think of anything else.", translation_hi: "शनै: शनै: धैर्ययुक्त बुद्धि के द्वारा (योगी) उपरामता (शांति) को प्राप्त होवे;  मन को आत्मा में स्थित करके फिर अन्य कुछ भी चिन्तन न करे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_025.mp3"},
  {id: "BG_6.26", label: "BG 6.26", ref: "6.26", chapter: 6, verse: 26, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यतो यतो निश्चरति मनश्चञ्चलमस्थिरम्", snippet: "From whatever cause the restless and unsteady mind wanders away, let him restrain it from that and bring it under the control of the Self alone.", sanskrit: "यतो यतो निश्चरति मनश्चञ्चलमस्थिरम् ।\nततस्ततो नियम्यैतदात्मन्येव वशं नयेत् ॥", iast: "yato yato niścarati manaścañcalamasthiram |\ntatastato niyamyaitadātmanyeva vaśaṃ nayet ||", transliteration: "yato yato niśhcharati manaśh chañchalam asthiram\ntatas tato niyamyaitad ātmanyeva vaśhaṁ nayet", translation_en: "From whatever cause the restless and unsteady mind wanders away, let him restrain it from that and bring it under the control of the Self alone.", translation_hi: "यह चंचल और अस्थिर मन जिन कारणों से (विषयों में) विचरण करता है, उनसे संयमित करके उसे आत्मा के ही वश में लावे अर्थात् आत्मा में स्थिर करे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_026.mp3"},
  {id: "BG_6.27", label: "BG 6.27", ref: "6.27", chapter: 6, verse: 27, speaker: "krishna", canonical: true, meter: "anustubh", sa: "प्रशान्तमनसं ह्येनं योगिनं सुखमुत्तमम्", snippet: "Supreme Bliss indeed comes to this Yogi whose mind is made peaceful, whose passion is quelled, who has become Brahman, and who is free from sin.", sanskrit: "प्रशान्तमनसं ह्येनं योगिनं सुखमुत्तमम् ।\nउपैति शान्तरजसं ब्रह्मभूतमकल्मषम् ॥", iast: "praśāntamanasaṃ hyenaṃ yoginaṃ sukhamuttamam |\nupaiti śāntarajasaṃ brahmabhūtamakalmaṣam ||", transliteration: "praśhānta-manasaṁ hyenaṁ yoginaṁ sukham uttamam\nupaiti śhānta-rajasaṁ brahma-bhūtam akalmaṣham", translation_en: "Supreme Bliss indeed comes to this Yogi whose mind is made peaceful, whose passion is quelled, who has become Brahman, and who is free from sin.", translation_hi: "जिसका मन प्रशान्त है, जो पापरहित (अकल्मषम्) है और जिसका रजोगुण (विक्षेप) शांत हुआ है, ऐसे ब्रह्मरूप हुए इस योगी को उत्तम सुख प्राप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_027.mp3"},
  {id: "BG_6.28", label: "BG 6.28", ref: "6.28", chapter: 6, verse: 28, speaker: "krishna", canonical: true, meter: "anustubh", sa: "युञ्जन्नेवं सदाऽऽत्मानं योगी विगतकल्मषः", snippet: "The yogi, always engaging the mind thus (in the practice of yoga), is freed from sins and easily enjoys the infinite bliss of contact with Brahman (the Eternal).", sanskrit: "युञ्जन्नेवं सदाऽऽत्मानं योगी विगतकल्मषः ।\nसुखेन ब्रह्मसंस्पर्शमत्यन्तं सुखमश्नुते ॥", iast: "yuñjannevaṃ sadā’’tmānaṃ yogī vigatakalmaṣaḥ |\nsukhena brahmasaṃsparśamatyantaṃ sukhamaśnute ||", transliteration: "yuñjann evaṁ sadātmānaṁ yogī vigata-kalmaṣhaḥ\nsukhena brahma-sansparśham atyantaṁ sukham aśhnute", translation_en: "The yogi, always engaging the mind thus (in the practice of yoga), is freed from sins and easily enjoys the infinite bliss of contact with Brahman (the Eternal).", translation_hi: "इस प्रकार मन को सदा आत्मा में स्थिर करने का योग करने वाला पापरहित योगी सुखपूर्वक ब्रह्मसंस्पर्श का परम सुख प्राप्त करता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_028.mp3"},
  {id: "BG_6.29", label: "BG 6.29", ref: "6.29", chapter: 6, verse: 29, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सर्वभूतस्थमात्मानं सर्वभूतानि चात्मनि", snippet: "With the mind harmonized by Yoga, he sees the Self abiding in all beings and all beings in the Self; he sees the same everywhere.", sanskrit: "सर्वभूतस्थमात्मानं सर्वभूतानि चात्मनि ।\nईक्षते योगयुक्तात्मा सर्वत्र समदर्शनः ॥", iast: "sarvabhūtasthamātmānaṃ sarvabhūtāni cātmani |\nīkṣate yogayuktātmā sarvatra samadarśanaḥ ||", transliteration: "sarva-bhūta-stham ātmānaṁ sarva-bhūtāni chātmani\nīkṣhate yoga-yuktātmā sarvatra sama-darśhanaḥ", translation_en: "With the mind harmonized by Yoga, he sees the Self abiding in all beings and all beings in the Self; he sees the same everywhere.", translation_hi: "योगयुक्त अन्त:करण वाला और सर्वत्र समदर्शी योगी आत्मा को सब भूतों में और भूतमात्र को आत्मा में देखता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_029.mp3"},
  {id: "BG_6.30", label: "BG 6.30", ref: "6.30", chapter: 6, verse: 30, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यो मां पश्यति सर्वत्र सर्वं च मयि पश्यति", snippet: "He who sees Me everywhere and sees everything in Me, never becomes separated from Me, nor do I from him.", sanskrit: "यो मां पश्यति सर्वत्र सर्वं च मयि पश्यति ।\nतस्याहं न प्रणश्यामि स च मे न प्रणश्यति ॥", iast: "yo māṃ paśyati sarvatra sarvaṃ ca mayi paśyati |\ntasyāhaṃ na praṇaśyāmi sa ca me na praṇaśyati ||", transliteration: "yo māṁ paśhyati sarvatra sarvaṁ cha mayi paśhyati\ntasyāhaṁ na praṇaśhyāmi sa cha me na praṇaśhyati", translation_en: "He who sees Me everywhere and sees everything in Me, never becomes separated from Me, nor do I from him.", translation_hi: "जो पुरुष मुझे सर्वत्र देखता है और सबको मुझमें देखता है, उसके लिए मैं नष्ट नहीं होता (अर्थात् उसके लिए मैं दूर नहीं होता) और वह मुझसे वियुक्त नहीं होता।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_030.mp3"},
  {id: "BG_6.31", label: "BG 6.31", ref: "6.31", chapter: 6, verse: 31, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सर्वभूतस्थितं यो मां भजत्येकत्वमास्थितः", snippet: "He who, being established in unity, worships Me, who dwells in all beings, that yogi abides in Me, whatever their mode of living may be.", sanskrit: "सर्वभूतस्थितं यो मां भजत्येकत्वमास्थितः ।\nसर्वथा वर्तमानोऽपि स योगी मयि वर्तते ॥", iast: "sarvabhūtasthitaṃ yo māṃ bhajatyekatvamāsthitaḥ |\nsarvathā vartamāno’pi sa yogī mayi vartate ||", transliteration: "sarva-bhūta-sthitaṁ yo māṁ bhajatyekatvam āsthitaḥ\nsarvathā vartamāno ’pi sa yogī mayi vartate", translation_en: "He who, being established in unity, worships Me, who dwells in all beings, that yogi abides in Me, whatever their mode of living may be.", translation_hi: "जो पुरुष एकत्वभाव मंे स्थित हुआ सम्पूर्ण भूतों में स्थित मुझे भजता है, वह योगी सब प्रकार से वर्तता हुआ (रहता हुआ) मुझमें स्थित रहता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_031.mp3"},
  {id: "BG_6.32", label: "BG 6.32", ref: "6.32", chapter: 6, verse: 32, speaker: "krishna", canonical: true, meter: "anustubh", sa: "आत्मौपम्येन सर्वत्र समं पश्यति योऽर्जुन", snippet: "He who, through the likeness of the Self, O Arjuna, sees reality everywhere, be it pleasure or pain, is regarded as the highest Yogi.", sanskrit: "आत्मौपम्येन सर्वत्र समं पश्यति योऽर्जुन ।\nसुखं वा यदि वा दुःखं सः योगी परमो मतः ॥", iast: "ātmaupamyena sarvatra samaṃ paśyati yo’rjuna |\nsukhaṃ vā yadi vā duḥkhaṃ saḥ yogī paramo mataḥ ||", transliteration: "ātmaupamyena sarvatra samaṁ paśhyati yo ’rjuna\nsukhaṁ vā yadi vā duḥkhaṁ sa yogī paramo mataḥ", translation_en: "He who, through the likeness of the Self, O Arjuna, sees reality everywhere, be it pleasure or pain, is regarded as the highest Yogi.", translation_hi: "हे अर्जुन ! जो पुरुष अपने समान सर्वत्र सम देखता है, चाहे वह सुख हो या दु:ख, वह परम योगी माना गया है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_032.mp3"},
  {id: "BG_6.33", label: "BG 6.33", ref: "6.33", chapter: 6, verse: 33, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "योऽयं योगस्त्वया प्रोक्तः साम्येन मधुसूदन", snippet: "Arjuna said, \"O Krishna, I do not see how this Yoga of equanimity, which you have taught me, can be maintained steadily, due to the restlessness of the mind.\"", sanskrit: "योऽयं योगस्त्वया प्रोक्तः साम्येन मधुसूदन ।\nएतस्याहं न पश्यामि चञ्चलत्वात् स्थितिं स्थिराम् ॥", iast: "yo’yaṃ yogastvayā proktaḥ sāmyena madhusūdana |\netasyāhaṃ na paśyāmi cañcalatvāt sthitiṃ sthirām ||", transliteration: "yo ’yaṁ yogas tvayā proktaḥ sāmyena madhusūdana\netasyāhaṁ na paśhyāmi chañchalatvāt sthitiṁ sthirām", translation_en: "Arjuna said, \"O Krishna, I do not see how this Yoga of equanimity, which you have taught me, can be maintained steadily, due to the restlessness of the mind.\"", translation_hi: "अर्जुन ने कहा --  हे मधुसूदन ! जो यह साम्य योग आपने कहा, मैं मन के चंचल होने से इसकी चिरस्थायी स्थिति को नहीं देखता हूं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_033.mp3"},
  {id: "BG_6.34", label: "BG 6.34", ref: "6.34", chapter: 6, verse: 34, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "चञ्चलं हि मनः कृष्ण प्रमाथि बलवद्दृढम्", snippet: "The mind is indeed restless, turbulent, strong, and unyielding, O Krishna; I consider it as difficult to control as controlling the wind.", sanskrit: "चञ्चलं हि मनः कृष्ण प्रमाथि बलवद्दृढम् ।\nतस्याहं निग्रहं मन्ये वायोरिव सुदुष्करम् ॥", iast: "cañcalaṃ hi manaḥ kṛṣṇa pramāthi balavaddṛḍham |\ntasyāhaṃ nigrahaṃ manye vāyoriva suduṣkaram ||", transliteration: "chañchalaṁ hi manaḥ kṛiṣhṇa pramāthi balavad dṛiḍham\ntasyāhaṁ nigrahaṁ manye vāyor iva su-duṣhkaram", translation_en: "The mind is indeed restless, turbulent, strong, and unyielding, O Krishna; I consider it as difficult to control as controlling the wind.", translation_hi: "क्योंकि हे कृष्ण ! यह मन चंचल और प्रमथन स्वभाव का तथा बलवान् और दृढ़ है; उसका निग्रह करना मैं वायु के समान अति दुष्कर मानता हूँ ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_034.mp3"},
  {id: "BG_6.35", label: "BG 6.35", ref: "6.35", chapter: 6, verse: 35, speaker: "krishna", canonical: true, meter: "anustubh", sa: "असंशयं महाबाहो मनो दुर्निग्रहं चलं", snippet: "The Blessed Lord said, \"Undoubtedly, O mighty-armed Arjuna, the mind is difficult to control and restless; but with practice and dispassion, it can be restrained.\"", sanskrit: "असंशयं महाबाहो मनो दुर्निग्रहं चलं ।\nअभ्यासेन तु कौन्तेय वैराग्येण च गृह्यते ॥", iast: "asaṃśayaṃ mahābāho mano durnigrahaṃ calaṃ |\nabhyāsena tu kaunteya vairāgyeṇa ca gṛhyate ||", transliteration: "asanśhayaṁ mahā-bāho mano durnigrahaṁ chalam\nabhyāsena tu kaunteya vairāgyeṇa cha gṛihyate", translation_en: "The Blessed Lord said, \"Undoubtedly, O mighty-armed Arjuna, the mind is difficult to control and restless; but with practice and dispassion, it can be restrained.\"", translation_hi: "श्रीभगवान् कहते हैं --  हे महबाहो ! नि:सन्देह मन चंचल और कठिनता से वश में होने वाला है; परन्तु, हे कुन्तीपुत्र ! उसे अभ्यास और वैराग्य के द्वारा वश में किया जा सकता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_035.mp3"},
  {id: "BG_6.36", label: "BG 6.36", ref: "6.36", chapter: 6, verse: 36, speaker: "krishna", canonical: true, meter: "anustubh", sa: "असंयतात्मना योगो दुष्प्राप इति मे मतिः", snippet: "I think Yoga is hard to be attained by one with an uncontrolled self, but the self-controlled and striving one can attain it by the appropriate means.", sanskrit: "असंयतात्मना योगो दुष्प्राप इति मे मतिः ।\nवश्यात्मना तु यतता शक्योऽवाप्तुमुपायतः ॥", iast: "asaṃyatātmanā yogo duṣprāpa iti me matiḥ |\nvaśyātmanā tu yatatā śakyo’vāptumupāyataḥ ||", transliteration: "asaṅyatātmanā yogo duṣhprāpa iti me matiḥ\nvaśhyātmanā tu yatatā śhakyo ’vāptum upāyataḥ", translation_en: "I think Yoga is hard to be attained by one with an uncontrolled self, but the self-controlled and striving one can attain it by the appropriate means.", translation_hi: "असंयत मन के पुरुष द्वारा योग प्राप्त होना कठिन है, परन्तु स्वाधीन मन वाले प्रयत्नशील पुरुष द्वारा उपाय से योग प्राप्त होना संभव है, यह मेरा मत है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_036.mp3"},
  {id: "BG_6.37", label: "BG 6.37", ref: "6.37", chapter: 6, verse: 37, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "अयतिः श्रद्धयोपेतो योगाच्चलितमानसः", snippet: "Arjuna said, \"He who is unable to control himself, even though he has faith, and whose mind wanders away from Yoga, what end does he meet, having failed to attain perfection in…", sanskrit: "अयतिः श्रद्धयोपेतो योगाच्चलितमानसः ।\nअप्राप्य योगसंसिद्धिं कां गतिं कृष्ण गच्छति ॥", iast: "ayatiḥ śraddhayopeto yogāccalitamānasaḥ |\naprāpya yogasaṃsiddhiṃ kāṃ gatiṃ kṛṣṇa gacchati ||", transliteration: "ayatiḥ śhraddhayopeto yogāch chalita-mānasaḥ\naprāpya yoga-sansiddhiṁ kāṅ gatiṁ kṛiṣhṇa gachchhati", translation_en: "Arjuna said, \"He who is unable to control himself, even though he has faith, and whose mind wanders away from Yoga, what end does he meet, having failed to attain perfection in Yoga, O Krishna?\"", translation_hi: "अर्जुन ने कहा -- हे कृष्ण ! जिसका मन योग से चलायमान हो गया है, ऐसा अपूर्ण प्रयत्न वाला (अयति) श्रद्धायुक्त पुरुष योग की सिद्धि को न प्राप्त होकर किस गति को प्राप्त होता है?", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_037.mp3"},
  {id: "BG_6.38", label: "BG 6.38", ref: "6.38", chapter: 6, verse: 38, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "कच्चिन्नोभयविभ्रष्टश्छिन्नाभ्रमिव नश्यति", snippet: "Fallen from both, does he not perish like a rent cloud, supportless, O mighty-armed one, deluded on the path of Brahman?", sanskrit: "कच्चिन्नोभयविभ्रष्टश्छिन्नाभ्रमिव नश्यति ।\nअप्रतिष्ठो महाबाहो विमूढो ब्रह्मणः पथि ॥", iast: "kaccinnobhayavibhraṣṭaśchinnābhramiva naśyati |\napratiṣṭho mahābāho vimūḍho brahmaṇaḥ pathi ||", transliteration: "kachchin nobhaya-vibhraṣhṭaśh chhinnābhram iva naśhyati\napratiṣhṭho mahā-bāho vimūḍho brahmaṇaḥ pathi", translation_en: "Fallen from both, does he not perish like a rent cloud, supportless, O mighty-armed one, deluded on the path of Brahman?", translation_hi: "हे महबाहो ! क्या वह ब्रह्म के मार्ग में मोहित तथा आश्रयरहित पुरुष छिन्न-भिन्न मेघ के समान दोनों ओर से भ्रष्ट हुआ नष्ट तो नहीं हो जाता है?", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_038.mp3"},
  {id: "BG_6.39", label: "BG 6.39", ref: "6.39", chapter: 6, verse: 39, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "एतन्मे संशयं कृष्ण छेत्तुमर्हस्यशेषतः", snippet: "O Krishna, please completely dispel this doubt of mine, for it is not possible for anyone but You to do so.", sanskrit: "एतन्मे संशयं कृष्ण छेत्तुमर्हस्यशेषतः ।\nत्वदन्यः संशयस्यास्य छेत्ता न ह्युपपद्यते ॥", iast: "etanme saṃśayaṃ kṛṣṇa chettumarhasyaśeṣataḥ |\ntvadanyaḥ saṃśayasyāsya chettā na hyupapadyate ||", transliteration: "etan me sanśhayaṁ kṛiṣhṇa chhettum arhasyaśheṣhataḥ\ntvad-anyaḥ sanśhayasyāsya chhettā na hyupapadyate", translation_en: "O Krishna, please completely dispel this doubt of mine, for it is not possible for anyone but You to do so.", translation_hi: "हे कृष्ण ! मेरे इस संशय को नि:शेष रूप से छेदन (निराकरण) करने के लिए आप ही योग्य है; क्योंकि आपके अतिरिक्त अन्य कोई इस संशय का छेदन करन वाला (छेत्ता) मिलना संभव नहीं है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_039.mp3"},
  {id: "BG_6.40", label: "BG 6.40", ref: "6.40", chapter: 6, verse: 40, speaker: "krishna", canonical: true, meter: "anustubh", sa: "पार्थ नैवेह नामुत्र विनाशस्तस्य विद्यते", snippet: "The Blessed Lord said, \"O Arjuna, neither in this world nor in the next will there be destruction for him; none, indeed, who does good, O my son, ever comes to grief.\"", sanskrit: "पार्थ नैवेह नामुत्र विनाशस्तस्य विद्यते ।\nनहि कल्याणकृत्कश्चिद्दुर्गतिं तात गच्छति ॥", iast: "pārtha naiveha nāmutra vināśastasya vidyate |\nnahi kalyāṇakṛtkaściddurgatiṃ tāta gacchati ||", transliteration: "pārtha naiveha nāmutra vināśhas tasya vidyate\nna hi kalyāṇa-kṛit kaśhchid durgatiṁ tāta gachchhati", translation_en: "The Blessed Lord said, \"O Arjuna, neither in this world nor in the next will there be destruction for him; none, indeed, who does good, O my son, ever comes to grief.\"", translation_hi: "श्रीभगवान् ने कहा -- हे पार्थ ! उस पुरुष का, न तो इस लोक में और न ही परलोक में ही नाश होता है; हे तात ! कोई भी शुभ कर्म करने वाला दुर्गति को नहीं प्राप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_040.mp3"},
  {id: "BG_6.41", label: "BG 6.41", ref: "6.41", chapter: 6, verse: 41, speaker: "krishna", canonical: true, meter: "anustubh", sa: "प्राप्य पुण्यकृतां लोकानुषित्वा शाश्वतीः समाः", snippet: "Having attained to the worlds of the righteous and having dwelt there for everlasting years, he who fell from Yoga is born in a house of the pure and wealthy.", sanskrit: "प्राप्य पुण्यकृतां लोकानुषित्वा शाश्वतीः समाः ।\nशुचीनां श्रीमतां गेहे योगभ्रष्टोऽभिजायते ॥", iast: "prāpya puṇyakṛtāṃ lokānuṣitvā śāśvatīḥ samāḥ |\nśucīnāṃ śrīmatāṃ gehe yogabhraṣṭo’bhijāyate ||", transliteration: "prāpya puṇya-kṛitāṁ lokān uṣhitvā śhāśhvatīḥ samāḥ\nśhuchīnāṁ śhrīmatāṁ gehe yoga-bhraṣhṭo’bhijāyate", translation_en: "Having attained to the worlds of the righteous and having dwelt there for everlasting years, he who fell from Yoga is born in a house of the pure and wealthy.", translation_hi: "योगभ्रष्ट पुरुष पुण्यवानों के लोकों को प्राप्त होकर वहाँ दीर्घकाल तक वास करके शुद्ध आचरण वाले श्रीमन्त (धनवान) पुरुषों के घर में जन्म लेता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_041.mp3"},
  {id: "BG_6.42", label: "BG 6.42", ref: "6.42", chapter: 6, verse: 42, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अथवा योगिनामेव कुले भवति धीमताम्", snippet: "Or he is born in a family of even the wisest of yogis; verily, such a birth is very difficult to obtain in this world.", sanskrit: "अथवा योगिनामेव कुले भवति धीमताम् ।\nएतद्धि दुर्लभतरं लोके जन्म यदीदृशम् ॥", iast: "athavā yogināmeva kule bhavati dhīmatām |\netaddhi durlabhataraṃ loke janma yadīdṛśam ||", transliteration: "atha vā yoginām eva kule bhavati dhīmatām\netad dhi durlabhataraṁ loke janma yad īdṛiśham", translation_en: "Or he is born in a family of even the wisest of yogis; verily, such a birth is very difficult to obtain in this world.", translation_hi: "अथवा, (साधक) ज्ञानवान् योगियों के ही कुल में जन्म लेता है, परन्तु इस प्रकार का जन्म इस लोक में नि:संदेह अति दुर्लभ है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_042.mp3"},
  {id: "BG_6.43", label: "BG 6.43", ref: "6.43", chapter: 6, verse: 43, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तत्र तं बुद्धिसंयोगं लभते पौर्वदेहिकम्", snippet: "Then he comes into contact with the knowledge acquired in his former body and strives even more for perfection, O Arjuna.", sanskrit: "तत्र तं बुद्धिसंयोगं लभते पौर्वदेहिकम् ।\nयतते च ततो भूयः संसिद्धौ कुरुनन्दन ॥", iast: "tatra taṃ buddhisaṃyogaṃ labhate paurvadehikam |\nyatate ca tato bhūyaḥ saṃsiddhau kurunandana ||", transliteration: "tatra taṁ buddhi-sanyogaṁ labhate paurva-dehikam\nyatate cha tato bhūyaḥ sansiddhau kuru-nandana", translation_en: "Then he comes into contact with the knowledge acquired in his former body and strives even more for perfection, O Arjuna.", translation_hi: "हे कुरुनन्दन ! वह पुरुष वहाँ पूर्व देह में प्राप्त किये गये ज्ञान से सम्पन्न होकर योगसंसिद्धि के लिए उससे भी अधिक प्रयत्न करता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_043.mp3"},
  {id: "BG_6.44", label: "BG 6.44", ref: "6.44", chapter: 6, verse: 44, speaker: "krishna", canonical: true, meter: "anustubh", sa: "पूर्वाभ्यासेन तेनैव ह्रियते ह्यवशोऽपि सः", snippet: "By that same former practice, he is borne on in spite of himself. Even he who merely wishes to know Yoga goes beyond the Brahmanic word.", sanskrit: "पूर्वाभ्यासेन तेनैव ह्रियते ह्यवशोऽपि सः ।\nजिज्ञासुरपि योगस्य शब्दब्रह्मातिवर्तते ॥", iast: "pūrvābhyāsena tenaiva hriyate hyavaśo’pi saḥ |\njijñāsurapi yogasya śabdabrahmātivartate ||", transliteration: "pūrvābhyāsena tenaiva hriyate hyavaśho ’pi saḥ\njijñāsur api yogasya śhabda-brahmātivartate", translation_en: "By that same former practice, he is borne on in spite of himself. Even he who merely wishes to know Yoga goes beyond the Brahmanic word.", translation_hi: "उसी पूर्वाभ्यास के कारण वह अवश हुआ योग की ओर आकर्षित होता है। योग का जो केवल जिज्ञासु है वह शब्दब्रह्म का अतिक्रमण करता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_044.mp3"},
  {id: "BG_6.45", label: "BG 6.45", ref: "6.45", chapter: 6, verse: 45, speaker: "krishna", canonical: true, meter: "anustubh", sa: "प्रयत्नाद्यतमानस्तु योगी संशुद्धकिल्बिषः", snippet: "But the Yogi who strives assiduously, purified of sins and perfected gradually over many births, reaches the highest goal.", sanskrit: "प्रयत्नाद्यतमानस्तु योगी संशुद्धकिल्बिषः ।\nअनेकजन्मसंसिद्धस्ततो याति परां गतिम् ॥", iast: "prayatnādyatamānastu yogī saṃśuddhakilbiṣaḥ |\nanekajanmasaṃsiddhastato yāti parāṃ gatim ||", transliteration: "prayatnād yatamānas tu yogī sanśhuddha-kilbiṣhaḥ\naneka-janma-sansiddhas tato yāti parāṁ gatim", translation_en: "But the Yogi who strives assiduously, purified of sins and perfected gradually over many births, reaches the highest goal.", translation_hi: "परन्तु प्रयत्नपूर्वक अभ्यास करने वाला योगी सम्पूर्ण पापों से शुद्ध होकर अनेक जन्मों से (शनै: शनै:) सिद्ध होता हुआ, तब परम गति को प्राप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_045.mp3"},
  {id: "BG_6.46", label: "BG 6.46", ref: "6.46", chapter: 6, verse: 46, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तपस्विभ्योऽधिको योगी ज्ञानिभ्योऽपि मतोऽधिकः", snippet: "The yogi is thought to be superior to the ascetics, even superior to those who have knowledge obtained through the study of scriptures; he is also superior to men of action;…", sanskrit: "तपस्विभ्योऽधिको योगी ज्ञानिभ्योऽपि मतोऽधिकः ।\nकर्मिभ्यश्चाधिको योगी तस्माद्योगी भवार्जुन ॥", iast: "tapasvibhyo’dhiko yogī jñānibhyo’pi mato’dhikaḥ |\nkarmibhyaścādhiko yogī tasmādyogī bhavārjuna ||", transliteration: "tapasvibhyo ’dhiko yogī\njñānibhyo ’pi mato ’dhikaḥ\nkarmibhyaśh chādhiko yogī\ntasmād yogī bhavārjuna", translation_en: "The yogi is thought to be superior to the ascetics, even superior to those who have knowledge obtained through the study of scriptures; he is also superior to men of action; therefore, be thou a yogi, O Arjuna.", translation_hi: "क्योंकि योगी तपस्वियों से श्रेष्ठ है और (केवल शास्त्र के) ज्ञान वालों से भी श्रेष्ठ माना गया है तथा कर्म करने वालों से भी योगी श्रेष्ठ है, इसलिए हे अर्जुन तुम योगी बनो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_046.mp3"},
  {id: "BG_6.47", label: "BG 6.47", ref: "6.47", chapter: 6, verse: 47, speaker: "krishna", canonical: true, meter: "anustubh", sa: "योगिनामपि सर्वेषां मद्गतेनान्तरात्मना", snippet: "And among all the Yogis, he who, full of faith and with his inner self merged in Me, worships Me is deemed by Me to be the most devoted.", sanskrit: "योगिनामपि सर्वेषां मद्गतेनान्तरात्मना ।\nश्रद्धावान्भजते यो मां स मे युक्ततमो मतः ॥", iast: "yogināmapi sarveṣāṃ madgatenāntarātmanā |\nśraddhāvānbhajate yo māṃ sa me yuktatamo mataḥ ||", transliteration: "yoginām api sarveṣhāṁ mad-gatenāntar-ātmanā\nśhraddhāvān bhajate yo māṁ sa me yuktatamo mataḥ", translation_en: "And among all the Yogis, he who, full of faith and with his inner self merged in Me, worships Me is deemed by Me to be the most devoted.", translation_hi: "समस्त योगियों में जो भी श्रद्धावान् योगी मुझ में युक्त हुये अन्तरात्मा से (अर्थात् एकत्व भाव से मुझे भजता है, वह मुझे युक्ततम (सर्वश्रेष्ठ) मान्य है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/006_047.mp3"},
  {id: "BG_7.1", label: "BG 7.1", ref: "7.1", chapter: 7, verse: 1, speaker: "krishna", canonical: true, meter: "anustubh", sa: "मय्यासक्तमनाः पार्थ योगं युञ्जन्मदाश्रयः", snippet: "The Blessed Lord said, \"O Arjuna, hear how you shall, without doubt, know Me fully, with your mind intent on Me, practicing Yoga and taking refuge in Me.\"", sanskrit: "मय्यासक्तमनाः पार्थ योगं युञ्जन्मदाश्रयः ।\nअसंशयं समग्रं मां यथा ज्ञास्यसि तच्छृणु ॥", iast: "mayyāsaktamanāḥ pārtha yogaṃ yuñjanmadāśrayaḥ |\nasaṃśayaṃ samagraṃ māṃ yathā jñāsyasi tacchṛṇu ||", transliteration: "mayyāsakta-manāḥ pārtha yogaṁ yuñjan mad-āśhrayaḥ\nasanśhayaṁ samagraṁ māṁ yathā jñāsyasi tach chhṛiṇu", translation_en: "The Blessed Lord said, \"O Arjuna, hear how you shall, without doubt, know Me fully, with your mind intent on Me, practicing Yoga and taking refuge in Me.\"", translation_hi: "हे पार्थ ! मुझमें असक्त हुए मन वाले तथा मदाश्रित होकर योग का अभ्यास करते हुए जिस प्रकार तुम मुझे समग्ररूप से, बिना किसी संशय के, जानोगे वह सुनो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_001.mp3"},
  {id: "BG_7.2", label: "BG 7.2", ref: "7.2", chapter: 7, verse: 2, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ज्ञानं तेऽहं सविज्ञानमिदं वक्ष्याम्यशेषतः", snippet: "I will declare to you in full this knowledge combined with realization, after knowing which nothing else remains to be known here.", sanskrit: "ज्ञानं तेऽहं सविज्ञानमिदं वक्ष्याम्यशेषतः ।\nयज्ज्ञात्वा नेह भूयोऽन्यज्ज्ञातव्यमवशिष्यते ॥", iast: "jñānaṃ te’haṃ savijñānamidaṃ vakṣyāmyaśeṣataḥ |\nyajjñātvā neha bhūyo’nyajjñātavyamavaśiṣyate ||", transliteration: "jñānaṁ te ’haṁ sa-vijñānam idaṁ vakṣhyāmyaśheṣhataḥ\nyaj jñātvā neha bhūyo ’nyaj jñātavyam-avaśhiṣhyate", translation_en: "I will declare to you in full this knowledge combined with realization, after knowing which nothing else remains to be known here.", translation_hi: "मैं तुम्हारे लिए विज्ञान सहित इस ज्ञान को अशेष रूप से कहूँगा जिसको जानकर यहाँ (जगत् में) फिर और कुछ जानने योग्य (ज्ञातव्य) शेष नहीं रह जाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_002.mp3"},
  {id: "BG_7.3", label: "BG 7.3", ref: "7.3", chapter: 7, verse: 3, speaker: "krishna", canonical: true, meter: "anustubh", sa: "मनुष्याणां सहस्रेषु कश्चिद्यतति सिद्धये", snippet: "Among thousands of men, one may perchance strive for perfection; even among those successful strivers, only one may perchance know Me in essence.", sanskrit: "मनुष्याणां सहस्रेषु कश्चिद्यतति सिद्धये ।\nयततामपि सिद्धानां कश्चिन्मां वेत्ति तत्त्वतः ॥", iast: "manuṣyāṇāṃ sahasreṣu kaścidyatati siddhaye |\nyatatāmapi siddhānāṃ kaścinmāṃ vetti tattvataḥ ||", transliteration: "manuṣhyāṇāṁ sahasreṣhu kaśhchid yatati siddhaye\nyatatām api siddhānāṁ kaśhchin māṁ vetti tattvataḥ", translation_en: "Among thousands of men, one may perchance strive for perfection; even among those successful strivers, only one may perchance know Me in essence.", translation_hi: "सहस्रों मनुष्यों में कोई ही मनुष्य पूर्णत्व की सिद्धि के लिए प्रयत्न करता है और उन प्रयत्नशील साधकों में भी कोई ही पुरुष मुझे तत्त्व से जानता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_003.mp3"},
  {id: "BG_7.4", label: "BG 7.4", ref: "7.4", chapter: 7, verse: 4, speaker: "krishna", canonical: true, meter: "anustubh", sa: "भूमिरापोऽनलो वायुः खं मनो बुद्धिरेव च", snippet: "Earth, water, fire, air, ether, mind, intellect, and egoism—thus is My Nature divided eightfold.", sanskrit: "भूमिरापोऽनलो वायुः खं मनो बुद्धिरेव च ।\nअहङ्कार इतीयं मे भिन्ना प्रकृतिरष्टधा ॥", iast: "bhūmirāpo’nalo vāyuḥ khaṃ mano buddhireva ca |\nahaṅkāra itīyaṃ me bhinnā prakṛtiraṣṭadhā ||", transliteration: "bhūmir-āpo ’nalo vāyuḥ khaṁ mano buddhir eva cha\nahankāra itīyaṁ me bhinnā prakṛitir aṣhṭadhā", translation_en: "Earth, water, fire, air, ether, mind, intellect, and egoism—thus is My Nature divided eightfold.", translation_hi: "पृथ्वी, जल, अग्नि, वायु और आकाश तथा मन, बुद्धि और अहंकार - यह आठ प्रकार से विभक्त हुई मेरी प्रकृति है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_004.mp3"},
  {id: "BG_7.5", label: "BG 7.5", ref: "7.5", chapter: 7, verse: 5, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अपरेयमितस्त्वन्यां प्रकृतिं विद्धि मे पराम्", snippet: "O mighty-armed Arjuna, this is the inferior Prakriti; know it as distinct from My higher Prakriti, the very life-element, by which this world is upheld.", sanskrit: "अपरेयमितस्त्वन्यां प्रकृतिं विद्धि मे पराम् ।\nजीवभूतां महाबाहो ययेदं धार्यते जगत् ॥", iast: "apareyamitastvanyāṃ prakṛtiṃ viddhi me parām |\njīvabhūtāṃ mahābāho yayedaṃ dhāryate jagat ||", transliteration: "apareyam itas tvanyāṁ prakṛitiṁ viddhi me parām\njīva-bhūtāṁ mahā-bāho yayedaṁ dhāryate jagat", translation_en: "O mighty-armed Arjuna, this is the inferior Prakriti; know it as distinct from My higher Prakriti, the very life-element, by which this world is upheld.", translation_hi: "हे महाबाहो ! यह अपरा प्रकृति है। इससे भिन्न मेरी जीवरूपी पराप्रकृति को जानो, जिससे यह जगत् धारण किया जाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_005.mp3"},
  {id: "BG_7.6", label: "BG 7.6", ref: "7.6", chapter: 7, verse: 6, speaker: "krishna", canonical: true, meter: "anustubh", sa: "एतद्योनीनि भूतानि सर्वाणीत्युपधारय", snippet: "Know that these two are the womb of all beings; thus, I am the source and dissolution of the whole universe.", sanskrit: "एतद्योनीनि भूतानि सर्वाणीत्युपधारय ।\nअहं कृत्स्नस्य जगतः प्रभवः प्रलयस्तथा ॥", iast: "etadyonīni bhūtāni sarvāṇītyupadhāraya |\nahaṃ kṛtsnasya jagataḥ prabhavaḥ pralayastathā ||", transliteration: "etad-yonīni bhūtāni sarvāṇītyupadhāraya\nahaṁ kṛitsnasya jagataḥ prabhavaḥ pralayas tathā", translation_en: "Know that these two are the womb of all beings; thus, I am the source and dissolution of the whole universe.", translation_hi: "यह जानो कि समम्पूर्ण भूत इन दोनों प्रकृतियों से उत्पत्ति वाले हैं। (अत:) मैं सम्पूर्ण जगत् का उत्पत्ति तथा प्रलय स्थान हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_006.mp3"},
  {id: "BG_7.7", label: "BG 7.7", ref: "7.7", chapter: 7, verse: 7, speaker: "krishna", canonical: true, meter: "anustubh", sa: "मत्तः परतरं नान्यत्किञ्चिदस्ति धनञ्जय", snippet: "There is nothing higher than Me, O Arjuna. All this is strung on Me, like clusters of gems on a string.", sanskrit: "मत्तः परतरं नान्यत्किञ्चिदस्ति धनञ्जय ।\nमयि सर्वमिदं प्रोतं सूत्रे मणिगणा इव ॥", iast: "mattaḥ parataraṃ nānyatkiñcidasti dhanañjaya |\nmayi sarvamidaṃ protaṃ sūtre maṇigaṇā iva ||", transliteration: "mattaḥ parataraṁ nānyat kiñchid asti dhanañjaya\nmayi sarvam idaṁ protaṁ sūtre maṇi-gaṇā iva", translation_en: "There is nothing higher than Me, O Arjuna. All this is strung on Me, like clusters of gems on a string.", translation_hi: "हे धनंजय ! मुझसे श्रेष्ठ (परे) अन्य किचिन्मात्र वस्तु नहीं है। यह सम्पूर्ण जगत् सूत्र में मणियों के सदृश मुझमें पिरोया हुआ है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_007.mp3"},
  {id: "BG_7.8", label: "BG 7.8", ref: "7.8", chapter: 7, verse: 8, speaker: "krishna", canonical: true, meter: "anustubh", sa: "रसोऽहमप्सु कौन्तेय प्रभास्मि शशिसूर्ययोः", snippet: "I am the flavor in water, O Arjuna; I am the light in the moon and the sun; I am the syllable Om in all the Vedas, sound in the ether and virility in men.", sanskrit: "रसोऽहमप्सु कौन्तेय प्रभास्मि शशिसूर्ययोः ।\nप्रणवः सर्ववेदेषु शब्दः खे पौरुषं नृषु ॥", iast: "raso’hamapsu kaunteya prabhāsmi śaśisūryayoḥ |\npraṇavaḥ sarvavedeṣu śabdaḥ khe pauruṣaṃ nṛṣu ||", transliteration: "raso ’ham apsu kaunteya prabhāsmi śhaśhi-sūryayoḥ\npraṇavaḥ sarva-vedeṣhu śhabdaḥ khe pauruṣhaṁ nṛiṣhu", translation_en: "I am the flavor in water, O Arjuna; I am the light in the moon and the sun; I am the syllable Om in all the Vedas, sound in the ether and virility in men.", translation_hi: "हे कौन्तेय ! जल में मैं रस हूँ, चन्द्रमा और सूर्य में प्रकाश हूँ, सब वेदों में प्रणव (ँ़कार) हूँ तथा आकाश में शब्द और पुरुषों में पुरुषत्व हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_008.mp3"},
  {id: "BG_7.9", label: "BG 7.9", ref: "7.9", chapter: 7, verse: 9, speaker: "krishna", canonical: true, meter: "anustubh", sa: "पुण्यो गन्धः पृथिव्यां च तेजश्चास्मि विभावसौ", snippet: "I am the sweet fragrance in the earth and the brilliance in the fire, the life in all beings, and I am the austerity of ascetics.", sanskrit: "पुण्यो गन्धः पृथिव्यां च तेजश्चास्मि विभावसौ ।\nजीवनं सर्वभूतेषु तपश्चास्मि तपस्विषु ॥", iast: "puṇyo gandhaḥ pṛthivyāṃ ca tejaścāsmi vibhāvasau |\njīvanaṃ sarvabhūteṣu tapaścāsmi tapasviṣu ||", transliteration: "puṇyo gandhaḥ pṛithivyāṁ cha tejaśh chāsmi vibhāvasau\njīvanaṁ sarva-bhūteṣhu tapaśh chāsmi tapasviṣhu", translation_en: "I am the sweet fragrance in the earth and the brilliance in the fire, the life in all beings, and I am the austerity of ascetics.", translation_hi: "पृथ्वी में पवित्र गन्ध हूँ और अग्नि में तेज हूँ; सम्पूर्ण भूतों में जीवन हूँ और तपस्वियों में मैं तप हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_009.mp3"},
  {id: "BG_7.10", label: "BG 7.10", ref: "7.10", chapter: 7, verse: 10, speaker: "krishna", canonical: true, meter: "anustubh", sa: "बीजं मां सर्वभूतानां विद्धि पार्थ सनातनम्", snippet: "Know Me, O Arjuna, as the eternal seed of all beings; I am the intelligence of the intelligent, and the splendour of the splendid objects.", sanskrit: "बीजं मां सर्वभूतानां विद्धि पार्थ सनातनम् ।\nबुद्धिर्बुद्धिमतामस्मि तेजस्तेजस्विनामहम् ॥", iast: "bījaṃ māṃ sarvabhūtānāṃ viddhi pārtha sanātanam |\nbuddhirbuddhimatāmasmi tejastejasvināmaham ||", transliteration: "bījaṁ māṁ sarva-bhūtānāṁ viddhi pārtha sanātanam\nbuddhir buddhimatām asmi tejas tejasvinām aham", translation_en: "Know Me, O Arjuna, as the eternal seed of all beings; I am the intelligence of the intelligent, and the splendour of the splendid objects.", translation_hi: "हे पार्थ ! सम्पूर्ण भूतों का सनातन बीज (कारण) मुझे ही जानो; मैं बुद्धिमानों की बुद्धि और तेजस्वियों का तेज हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_010.mp3"},
  {id: "BG_7.11", label: "BG 7.11", ref: "7.11", chapter: 7, verse: 11, speaker: "krishna", canonical: true, meter: "anustubh", sa: "बलं बलवतां चाहं कामरागविवर्जितम्", snippet: "Of the strong, I am the strength devoid of desire and attachment, and in all beings, I am the desire in accordance with Dharma, O Arjuna.", sanskrit: "बलं बलवतां चाहं कामरागविवर्जितम् ।\nधर्माविरुद्धो भूतेषु कामोऽस्मि भरतर्षभ ॥", iast: "balaṃ balavatāṃ cāhaṃ kāmarāgavivarjitam |\ndharmāviruddho bhūteṣu kāmo’smi bharatarṣabha ||", transliteration: "balaṁ balavatāṁ chāhaṁ kāma-rāga-vivarjitam\ndharmāviruddho bhūteṣhu kāmo ’smi bharatarṣhabha", translation_en: "Of the strong, I am the strength devoid of desire and attachment, and in all beings, I am the desire in accordance with Dharma, O Arjuna.", translation_hi: "हे भरत श्रेष्ठ ! मैं बलवानों का कामना तथा आसक्ति से रहित बल हूँ और सब भूतों में धर्म के अविरुद्ध अर्थात् अनुकूल काम हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_011.mp3"},
  {id: "BG_7.12", label: "BG 7.12", ref: "7.12", chapter: 7, verse: 12, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ये चैव सात्त्विका भावा राजसास्तामसाश्च ये", snippet: "Whatever beings (and objects) that are pure, active, and inert, know that they proceed from Me. They are in Me, yet I am not in them.", sanskrit: "ये चैव सात्त्विका भावा राजसास्तामसाश्च ये ।\nमत्त एवेति तान्विद्धि नत्वहं तेषु ते मयि ॥", iast: "ye caiva sāttvikā bhāvā rājasāstāmasāśca ye |\nmatta eveti tānviddhi natvahaṃ teṣu te mayi ||", transliteration: "ye chaiva sāttvikā bhāvā rājasās tāmasāśh cha ye\nmatta eveti tān viddhi na tvahaṁ teṣhu te mayi", translation_en: "Whatever beings (and objects) that are pure, active, and inert, know that they proceed from Me. They are in Me, yet I am not in them.", translation_hi: "जो भी सात्त्विक (शुद्ध), राजसिक (क्रियाशील) और तामसिक (जड़) भाव हैं, उन सबको तुम मेरे से उत्पन्न हुए जानो; तथापि मैं उनमें नहीं हूँ, वे मुझमें हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_012.mp3"},
  {id: "BG_7.13", label: "BG 7.13", ref: "7.13", chapter: 7, verse: 13, speaker: "krishna", canonical: true, meter: "anustubh", sa: "त्रिभिर्गुणमयैर्भावैरेभिः सर्वमिदं जगत्", snippet: "Deluded by these Natures, composed of the three qualities of Nature, all this world does not know Me as distinct from them and immutable.", sanskrit: "त्रिभिर्गुणमयैर्भावैरेभिः सर्वमिदं जगत् ।\nमोहितं नाभिजानाति मामेभ्यः परमव्ययम् ॥", iast: "tribhirguṇamayairbhāvairebhiḥ sarvamidaṃ jagat |\nmohitaṃ nābhijānāti māmebhyaḥ paramavyayam ||", transliteration: "tribhir guṇa-mayair bhāvair ebhiḥ sarvam idaṁ jagat\nmohitaṁ nābhijānāti māmebhyaḥ param avyayam", translation_en: "Deluded by these Natures, composed of the three qualities of Nature, all this world does not know Me as distinct from them and immutable.", translation_hi: "त्रिगुणों से उत्पन्न इन भावों (विकारों) से सम्पूर्ण जगत् (लोग) मोहित हुआ इन (गुणों) से परे अव्यय स्वरूप मुझे नहीं जानता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_013.mp3"},
  {id: "BG_7.14", label: "BG 7.14", ref: "7.14", chapter: 7, verse: 14, speaker: "krishna", canonical: true, meter: "anustubh", sa: "दैवी ह्येषा गुणमयी मम माया दुरत्यया", snippet: "Verily, this divine illusion of Mine, composed of the three qualities, is difficult to cross over; those who take refuge in Me alone, can cross over this illusion.", sanskrit: "दैवी ह्येषा गुणमयी मम माया दुरत्यया ।\nमामेव ये प्रपद्यन्ते मायामेतां तरन्ति ते ॥", iast: "daivī hyeṣā guṇamayī mama māyā duratyayā |\nmāmeva ye prapadyante māyāmetāṃ taranti te ||", transliteration: "daivī hyeṣhā guṇa-mayī mama māyā duratyayā\nmām eva ye prapadyante māyām etāṁ taranti te", translation_en: "Verily, this divine illusion of Mine, composed of the three qualities, is difficult to cross over; those who take refuge in Me alone, can cross over this illusion.", translation_hi: "यह दैवी त्रिगुणमयी मेरी माया बड़ी दुस्तर है। परन्तु जो मेरी शरण में आते हैं, वे इस माया को पार कर जाते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_014.mp3"},
  {id: "BG_7.15", label: "BG 7.15", ref: "7.15", chapter: 7, verse: 15, speaker: "krishna", canonical: true, meter: "anustubh", sa: "न मां दुष्कृतिनो मूढाः प्रपद्यन्ते नराधमाः", snippet: "The evil-doers and the deluded, who are the lowest of men, do not seek Me; those whose knowledge is destroyed by illusion follow the ways of demons.", sanskrit: "न मां दुष्कृतिनो मूढाः प्रपद्यन्ते नराधमाः ।\nमाययापहृतज्ञाना आसुरं भावमाश्रिताः ॥", iast: "na māṃ duṣkṛtino mūḍhāḥ prapadyante narādhamāḥ |\nmāyayāpahṛtajñānā āsuraṃ bhāvamāśritāḥ ||", transliteration: "na māṁ duṣhkṛitino mūḍhāḥ prapadyante narādhamāḥ\nmāyayāpahṛita-jñānā āsuraṁ bhāvam āśhritāḥ", translation_en: "The evil-doers and the deluded, who are the lowest of men, do not seek Me; those whose knowledge is destroyed by illusion follow the ways of demons.", translation_hi: "दुष्कृत्य करने वाले, मूढ, नराधम पुरुष मुझे नहीं भजते हैं; माया के द्वारा जिनका ज्ञान हर लिया गया है, वे आसुरी भाव को धारण किये रहते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_015.mp3"},
  {id: "BG_7.16", label: "BG 7.16", ref: "7.16", chapter: 7, verse: 16, speaker: "krishna", canonical: true, meter: "anustubh", sa: "चतुर्विधा भजन्ते मां जनाः सुकृतिनोऽर्जुन", snippet: "Four kinds of virtuous men worship Me, O Arjuna, and they are the distressed, the seekers of knowledge, the seekers of wealth, and the wise, O Lord of the Bharatas.", sanskrit: "चतुर्विधा भजन्ते मां जनाः सुकृतिनोऽर्जुन ।\nआर्तो जिज्ञासुरर्थार्थी ज्ञानी च भरतर्षभ ॥", iast: "caturvidhā bhajante māṃ janāḥ sukṛtino’rjuna |\nārto jijñāsurarthārthī jñānī ca bharatarṣabha ||", transliteration: "chatur-vidhā bhajante māṁ janāḥ sukṛitino ’rjuna\nārto jijñāsur arthārthī jñānī cha bharatarṣhabha", translation_en: "Four kinds of virtuous men worship Me, O Arjuna, and they are the distressed, the seekers of knowledge, the seekers of wealth, and the wise, O Lord of the Bharatas.", translation_hi: "हे भरत श्रेष्ठ अर्जुन ! उत्तम कर्म करने वाले (सुकृतिन:) आर्त, जिज्ञासु, अर्थार्थी और ज्ञानी ऐसे चार प्रकार के लोग मुझे भजते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_016.mp3"},
  {id: "BG_7.17", label: "BG 7.17", ref: "7.17", chapter: 7, verse: 17, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तेषां ज्ञानी नित्ययुक्त एकभक्तिर्विशिष्यते", snippet: "Of them, the wise who are ever steadfast and devoted to the One, excel; for I am exceedingly dear to the wise, and they are dear to Me.", sanskrit: "तेषां ज्ञानी नित्ययुक्त एकभक्तिर्विशिष्यते ।\nप्रियो हि ज्ञानिनोऽत्यर्थमहं स च मम प्रियः ॥", iast: "teṣāṃ jñānī nityayukta ekabhaktirviśiṣyate |\npriyo hi jñānino’tyarthamahaṃ sa ca mama priyaḥ ||", transliteration: "teṣhāṁ jñānī nitya-yukta eka-bhaktir viśhiṣhyate\npriyo hi jñānino ’tyartham ahaṁ sa cha mama priyaḥ", translation_en: "Of them, the wise who are ever steadfast and devoted to the One, excel; for I am exceedingly dear to the wise, and they are dear to Me.", translation_hi: "उनमें भी मुझ से नित्ययुक्त, अनन्य भक्ति वाला ज्ञानी श्रेष्ठ है, क्योंकि ज्ञानी को मैं अत्यन्त प्रिय हूँ और वह मुझे अत्यन्त प्रिय है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_017.mp3"},
  {id: "BG_7.18", label: "BG 7.18", ref: "7.18", chapter: 7, verse: 18, speaker: "krishna", canonical: true, meter: "anustubh", sa: "उदाराः सर्व एवैते ज्ञानी त्वात्मैव मे मतम्", snippet: "Indeed, all these are noble; however, I consider the wise man as My very Self; for, he is steadfast in mind and established in Me alone as the supreme goal.", sanskrit: "उदाराः सर्व एवैते ज्ञानी त्वात्मैव मे मतम् ।\nआस्थितः स हि युक्तात्मा मामेवानुत्तमां गतिम् ॥", iast: "udārāḥ sarva evaite jñānī tvātmaiva me matam |\nāsthitaḥ sa hi yuktātmā māmevānuttamāṃ gatim ||", transliteration: "udārāḥ sarva evaite jñānī tvātmaiva me matam\nāsthitaḥ sa hi yuktātmā mām evānuttamāṁ gatim", translation_en: "Indeed, all these are noble; however, I consider the wise man as My very Self; for, he is steadfast in mind and established in Me alone as the supreme goal.", translation_hi: "(यद्यपि) ये सब उत्कृष्ट हैं, परन्तु ज्ञानी तो मेरा स्वरूप ही है ऐसा मेरा मत है, क्योंकि वह स्थिर बुद्धि ज्ञानी अति उत्तम गतिस्वरूप मुझमें अच्छी प्रकार स्थित है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_018.mp3"},
  {id: "BG_7.19", label: "BG 7.19", ref: "7.19", chapter: 7, verse: 19, speaker: "krishna", canonical: true, meter: "anustubh", sa: "बहूनां जन्मनामन्ते ज्ञानवान्मां प्रपद्यते", snippet: "At the end of many births, the wise man comes to Me, realizing that all this is Vaasudeva (the innermost Self); such a great soul (Mahatma) is very hard to find.", sanskrit: "बहूनां जन्मनामन्ते ज्ञानवान्मां प्रपद्यते ।\nवासुदेवः सर्वमिति स महात्मा सुदुर्लभः ॥", iast: "bahūnāṃ janmanāmante jñānavānmāṃ prapadyate |\nvāsudevaḥ sarvamiti sa mahātmā sudurlabhaḥ ||", transliteration: "bahūnāṁ janmanām ante jñānavān māṁ prapadyate\nvāsudevaḥ sarvam iti sa mahātmā su-durlabhaḥ", translation_en: "At the end of many births, the wise man comes to Me, realizing that all this is Vaasudeva (the innermost Self); such a great soul (Mahatma) is very hard to find.", translation_hi: "बहुत जन्मों के अन्त में (किसी एक जन्म विशेष में) ज्ञान को प्राप्त होकर कि 'यह सब वासुदेव है' ज्ञानी भक्त मुझे प्राप्त होता है; ऐसा महात्मा अति दुर्लभ है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_019.mp3"},
  {id: "BG_7.20", label: "BG 7.20", ref: "7.20", chapter: 7, verse: 20, speaker: "krishna", canonical: true, meter: "anustubh", sa: "कामैस्तैस्तैर्हृतज्ञानाः प्रपद्यन्तेऽन्यदेवताः", snippet: "Those whose wisdom has been taken away by this or that desire, go to other gods, following this or that rite, led by their own nature.", sanskrit: "कामैस्तैस्तैर्हृतज्ञानाः प्रपद्यन्तेऽन्यदेवताः ।\nतं तं नियममास्थाय प्रकृत्या नियताः स्वया ॥", iast: "kāmaistaistairhṛtajñānāḥ prapadyante’nyadevatāḥ |\ntaṃ taṃ niyamamāsthāya prakṛtyā niyatāḥ svayā ||", transliteration: "kāmais tais tair hṛita-jñānāḥ prapadyante ’nya-devatāḥ\ntaṁ taṁ niyamam āsthāya prakṛityā niyatāḥ svayā", translation_en: "Those whose wisdom has been taken away by this or that desire, go to other gods, following this or that rite, led by their own nature.", translation_hi: "भोगविशेष की कामना से जिनका ज्ञान हर लिया गया है, ऐसे पुरुष अपने स्वभाव से प्रेरित हुए अन्य देवताओं को विशिष्ट नियम का पालन करते हुए भजते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_020.mp3"},
  {id: "BG_7.21", label: "BG 7.21", ref: "7.21", chapter: 7, verse: 21, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यो यो यां यां तनुं भक्तः श्रद्धयार्चितुमिच्छति", snippet: "Whatever form any devotee desires to worship with faith, I make that same faith of his firm and unflinching.", sanskrit: "यो यो यां यां तनुं भक्तः श्रद्धयार्चितुमिच्छति ।\nतस्य तस्याचलां श्रद्धां तामेव विदधाम्यहम् ॥", iast: "yo yo yāṃ yāṃ tanuṃ bhaktaḥ śraddhayārcitumicchati |\ntasya tasyācalāṃ śraddhāṃ tāmeva vidadhāmyaham ||", transliteration: "yo yo yāṁ yāṁ tanuṁ bhaktaḥ śhraddhayārchitum ichchhati\ntasya tasyāchalāṁ śhraddhāṁ tām eva vidadhāmyaham", translation_en: "Whatever form any devotee desires to worship with faith, I make that same faith of his firm and unflinching.", translation_hi: "जो-जो (सकामी) भक्त जिस-जिस (देवता के) रूप को श्रद्धा से पूजना चाहता है, उस-उस (भक्त) की मैं उस ही देवता के प्रति श्रद्धा को स्थिर करता हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_021.mp3"},
  {id: "BG_7.22", label: "BG 7.22", ref: "7.22", chapter: 7, verse: 22, speaker: "krishna", canonical: true, meter: "anustubh", sa: "स तया श्रद्धया युक्तस्तस्याराधनमीहते", snippet: "Endowed with that faith, he engages in the worship of that form and obtains his desired outcome, which is ordained by Me alone.", sanskrit: "स तया श्रद्धया युक्तस्तस्याराधनमीहते ।\nलभते च ततः कामान्मयैव विहितान् हि तान् ॥", iast: "sa tayā śraddhayā yuktastasyārādhanamīhate |\nlabhate ca tataḥ kāmānmayaiva vihitān hi tān ||", transliteration: "sa tayā śhraddhayā yuktas tasyārādhanam īhate\nlabhate cha tataḥ kāmān mayaiva vihitān hi tān", translation_en: "Endowed with that faith, he engages in the worship of that form and obtains his desired outcome, which is ordained by Me alone.", translation_hi: "वह (भक्त) उस श्रद्धा से युक्त होकर उस देवता का पूजन करता है और उससे मेरे द्वारा विधान किये हुये इच्छित भोगों को नि:सन्देह प्राप्त करता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_022.mp3"},
  {id: "BG_7.23", label: "BG 7.23", ref: "7.23", chapter: 7, verse: 23, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अन्तवत्तु फलं तेषां तद्भवत्यल्पमेधसाम्", snippet: "Verily, the reward (fruit) that accrues to those men of small intelligence is finite. The worshippers of the gods go to them, whereas My devotees come to Me.", sanskrit: "अन्तवत्तु फलं तेषां तद्भवत्यल्पमेधसाम् ।\nदेवान्देवयजो यान्ति मद्भक्ता यान्ति मामपि ॥", iast: "antavattu phalaṃ teṣāṃ tadbhavatyalpamedhasām |\ndevāndevayajo yānti madbhaktā yānti māmapi ||", transliteration: "antavat tu phalaṁ teṣhāṁ tad bhavatyalpa-medhasām\ndevān deva-yajo yānti mad-bhaktā yānti mām api", translation_en: "Verily, the reward (fruit) that accrues to those men of small intelligence is finite. The worshippers of the gods go to them, whereas My devotees come to Me.", translation_hi: "परन्तु उन अल्प बुद्धि पुरुषों का वह फल नाशवान् होता है। देवताओं के पूजक देवताओं को प्राप्त होते हैं और मेरे भक्त मुझे ही प्राप्त होते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_023.mp3"},
  {id: "BG_7.24", label: "BG 7.24", ref: "7.24", chapter: 7, verse: 24, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अव्यक्तं व्यक्तिमापन्नं मन्यन्ते मामबुद्धयः", snippet: "The foolish think of Me, the Unmanifest, as having manifestation, not knowing My higher, immutable, and most excellent nature.", sanskrit: "अव्यक्तं व्यक्तिमापन्नं मन्यन्ते मामबुद्धयः ।\nपरं भावमजानन्तो ममाव्ययमनुत्तमम् ॥", iast: "avyaktaṃ vyaktimāpannaṃ manyante māmabuddhayaḥ |\nparaṃ bhāvamajānanto mamāvyayamanuttamam ||", transliteration: "avyaktaṁ vyaktim āpannaṁ manyante mām abuddhayaḥ\nparaṁ bhāvam ajānanto mamāvyayam anuttamam", translation_en: "The foolish think of Me, the Unmanifest, as having manifestation, not knowing My higher, immutable, and most excellent nature.", translation_hi: "बुद्धिहीन पुरुष मेरे अनुत्तम (सर्वोत्तम) अव्यय परम भाव को न जानते हुए मुझ अव्यक्त को व्यक्त मानते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_024.mp3"},
  {id: "BG_7.25", label: "BG 7.25", ref: "7.25", chapter: 7, verse: 25, speaker: "krishna", canonical: true, meter: "anustubh", sa: "नाहं प्रकाशः सर्वस्य योगमायासमावृतः", snippet: "I am not manifest to all, veiled as I am by the Yoga-Maya. This deluded world does not know Me, who am unborn and imperishable.", sanskrit: "नाहं प्रकाशः सर्वस्य योगमायासमावृतः ।\nमूढोऽयं नाभिजानाति लोको मामजमव्ययम् ॥", iast: "nāhaṃ prakāśaḥ sarvasya yogamāyāsamāvṛtaḥ |\nmūḍho’yaṃ nābhijānāti loko māmajamavyayam ||", transliteration: "nāhaṁ prakāśhaḥ sarvasya yoga-māyā-samāvṛitaḥ\nmūḍho ’yaṁ nābhijānāti loko mām ajam avyayam", translation_en: "I am not manifest to all, veiled as I am by the Yoga-Maya. This deluded world does not know Me, who am unborn and imperishable.", translation_hi: "अपनी योगमाया से आवृत्त मैं सबको प्रत्यक्ष नहीं होता हूँ। यह मोहित लोक (मनुष्य) मुझ जन्मरहित, अविनाशी को नहीं जानता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_025.mp3"},
  {id: "BG_7.26", label: "BG 7.26", ref: "7.26", chapter: 7, verse: 26, speaker: "krishna", canonical: true, meter: "anustubh", sa: "वेदाहं समतीतानि वर्तमानानि चार्जुन", snippet: "I know, O Arjuna, the beings of the past, the present, and the future; however, no one knows Me.", sanskrit: "वेदाहं समतीतानि वर्तमानानि चार्जुन ।\nभविष्याणि च भूतानि मां तु वेद न कश्चन ॥", iast: "vedāhaṃ samatītāni vartamānāni cārjuna |\nbhaviṣyāṇi ca bhūtāni māṃ tu veda na kaścana ||", transliteration: "vedāhaṁ samatītāni vartamānāni chārjuna\nbhaviṣhyāṇi cha bhūtāni māṁ tu veda na kaśhchana", translation_en: "I know, O Arjuna, the beings of the past, the present, and the future; however, no one knows Me.", translation_hi: "हे अर्जुन ! पूर्व में व्यतीत हुए और वर्तमान में स्थित तथा भविष्य में होने वाले भूतमात्र को मैं जानता हूँ, परन्तु मुझे कोई भी पुरुष नहीं जानता हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_026.mp3"},
  {id: "BG_7.27", label: "BG 7.27", ref: "7.27", chapter: 7, verse: 27, speaker: "krishna", canonical: true, meter: "anustubh", sa: "इच्छाद्वेषसमुत्थेन द्वन्द्वमोहेन भारत", snippet: "O Bharata, all beings are subject to delusion at birth due to the delusion of the pairs of opposites arising from desire and aversion, O Parantapa.", sanskrit: "इच्छाद्वेषसमुत्थेन द्वन्द्वमोहेन भारत ।\nसर्वभूतानि संमोहं सर्गे यान्ति परन्तप ॥", iast: "icchādveṣasamutthena dvandvamohena bhārata |\nsarvabhūtāni saṃmohaṃ sarge yānti parantapa ||", transliteration: "ichchhā-dveṣha-samutthena dvandva-mohena bhārata\nsarva-bhūtāni sammohaṁ sarge yānti parantapa", translation_en: "O Bharata, all beings are subject to delusion at birth due to the delusion of the pairs of opposites arising from desire and aversion, O Parantapa.", translation_hi: "हे परन्तप भारत ! इच्छा और द्वेष से उत्पन्न द्वन्द्वमोह से भूतमात्र उत्पत्ति काल में ही संमोह (अविवेक) को प्राप्त होते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_027.mp3"},
  {id: "BG_7.28", label: "BG 7.28", ref: "7.28", chapter: 7, verse: 28, speaker: "krishna", canonical: true, meter: "anustubh", sa: "येषां त्वन्तगतं पापं जनानां पुण्यकर्मणाम्", snippet: "But those men of virtuous deeds, whose sins have come to an end and who are freed from the delusion of the pairs of opposites, worship Me steadfastly, with their vows.", sanskrit: "येषां त्वन्तगतं पापं जनानां पुण्यकर्मणाम् ।\nते द्वन्द्वमोहनिर्मुक्ता भजन्ते मां दृढव्रताः ॥", iast: "yeṣāṃ tvantagataṃ pāpaṃ janānāṃ puṇyakarmaṇām |\nte dvandvamohanirmuktā bhajante māṃ dṛḍhavratāḥ ||", transliteration: "yeṣhāṁ tvanta-gataṁ pāpaṁ janānāṁ puṇya-karmaṇām\nte dvandva-moha-nirmuktā bhajante māṁ dṛiḍha-vratāḥ", translation_en: "But those men of virtuous deeds, whose sins have come to an end and who are freed from the delusion of the pairs of opposites, worship Me steadfastly, with their vows.", translation_hi: "परन्तु जिन पुण्यकर्मी पुरुषों का पाप नष्ट हो गया है, वे द्वन्द्वमोह से निर्मुक्त और दृढ़वती पुरुष मुझे भजते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_028.mp3"},
  {id: "BG_7.29", label: "BG 7.29", ref: "7.29", chapter: 7, verse: 29, speaker: "krishna", canonical: true, meter: "anustubh", sa: "जरामरणमोक्षाय मामाश्रित्य यतन्ति ये", snippet: "Those who strive for liberation from old age and death, taking refuge in Me, realize in full that Brahman, the whole knowledge of the Self, and all action.", sanskrit: "जरामरणमोक्षाय मामाश्रित्य यतन्ति ये ।\nते ब्रह्म तद्विदुः कृत्स्नमध्यात्मं कर्म चाखिलम् ॥", iast: "jarāmaraṇamokṣāya māmāśritya yatanti ye |\nte brahma tadviduḥ kṛtsnamadhyātmaṃ karma cākhilam ||", transliteration: "jarā-maraṇa-mokṣhāya mām āśhritya yatanti ye\nte brahma tadviduḥ kṛitsnam adhyātmaṁ karma chākhilam", translation_en: "Those who strive for liberation from old age and death, taking refuge in Me, realize in full that Brahman, the whole knowledge of the Self, and all action.", translation_hi: "जो मेरे शरणागत होकर जरा और मरण से मुक्ति पाने के लिए यत्न करते हैं, वे पुरुष उस ब्रह्म को, सम्पूर्ण अध्यात्म को और सम्पूर्ण कर्म को जानते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_029.mp3"},
  {id: "BG_7.30", label: "BG 7.30", ref: "7.30", chapter: 7, verse: 30, speaker: "krishna", canonical: true, meter: "anustubh", sa: "साधिभूताधिदैवं मां साधियज्ञं च ये विदुः", snippet: "Those who know Me with the Adhibhuta (pertaining to the elements), Adhidaiva (pertaining to the gods), and the Adhiyajna (pertaining to the sacrifice) know Me even at the time…", sanskrit: "साधिभूताधिदैवं मां साधियज्ञं च ये विदुः ।\nप्रयाणकालेऽपि च मां ते विदुर्युक्तचेतसः ॥", iast: "sādhibhūtādhidaivaṃ māṃ sādhiyajñaṃ ca ye viduḥ |\nprayāṇakāle’pi ca māṃ te viduryuktacetasaḥ ||", transliteration: "sādhibhūtādhidaivaṁ māṁ sādhiyajñaṁ cha ye viduḥ\nprayāṇa-kāle ’pi cha māṁ te vidur yukta-chetasaḥ", translation_en: "Those who know Me with the Adhibhuta (pertaining to the elements), Adhidaiva (pertaining to the gods), and the Adhiyajna (pertaining to the sacrifice) know Me even at the time of death, remaining steadfast in mind.", translation_hi: "जो पुरुष अधिभूत और अधिदैव तथा अधियज्ञ के सहित मुझे जानते हैं, वे युक्तचित्त वाले पुरुष अन्तकाल में भी मुझे जानते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/007_030.mp3"},
  {id: "BG_8.1", label: "BG 8.1", ref: "8.1", chapter: 8, verse: 1, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "किं तद्ब्रह्म किमध्यात्मं किं कर्म पुरुषोत्तम", snippet: "Arjuna said, \"What is Brahman? What is Adhyatma? What is action, O best among men? What is Adhibhuta declared to be? And, what is Adhidaiva said to be?\"", sanskrit: "किं तद्ब्रह्म किमध्यात्मं किं कर्म पुरुषोत्तम ।\nअधिभूतं च किं प्रोक्तमधिदैवं किमुच्यते ॥", iast: "kiṃ tadbrahma kimadhyātmaṃ kiṃ karma puruṣottama |\nadhibhūtaṃ ca kiṃ proktamadhidaivaṃ kimucyate ||", transliteration: "kiṁ tad brahma kim adhyātmaṁ kiṁ karma puruṣhottama\nadhibhūtaṁ cha kiṁ proktam adhidaivaṁ kim uchyate", translation_en: "Arjuna said, \"What is Brahman? What is Adhyatma? What is action, O best among men? What is Adhibhuta declared to be? And, what is Adhidaiva said to be?\"", translation_hi: "अर्जुन ने कहा -हे पुरुषोत्तम ! वह ब्रह्म क्या है अध्यात्म क्या है? तथा कर्म क्या है? और अधिभूत नाम से क्या कहा गया है? तथा अधिदैव नाम से क्या कहा जाता है,", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_001.mp3"},
  {id: "BG_8.2", label: "BG 8.2", ref: "8.2", chapter: 8, verse: 2, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "अधियज्ञः कथं कोऽत्र देहेऽस्मिन्मधुसूदन", snippet: "Who and how is Adhiyajna here in this body, O destroyer of Madhu? And how, at the time of death, are You to be known by the self-controlled?", sanskrit: "अधियज्ञः कथं कोऽत्र देहेऽस्मिन्मधुसूदन ।\nप्रयाणकाले च कथं ज्ञेयोऽसि नियतात्मभिः ॥", iast: "adhiyajñaḥ kathaṃ ko’tra dehe’sminmadhusūdana |\nprayāṇakāle ca kathaṃ jñeyo’si niyatātmabhiḥ ||", transliteration: "adhiyajñaḥ kathaṁ ko ’tra dehe ’smin madhusūdana\nprayāṇa-kāle cha kathaṁ jñeyo ’si niyatātmabhiḥ", translation_en: "Who and how is Adhiyajna here in this body, O destroyer of Madhu? And how, at the time of death, are You to be known by the self-controlled?", translation_hi: "और हे मधुसूदन ! यहाँ अधियज्ञ कौन है? और वह इस शरीर में कैसे है? और संयत चित्त वाले पुरुषों द्वारा अन्त समय में आप किस प्रकार जाने जाते हैं,", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_002.mp3"},
  {id: "BG_8.3", label: "BG 8.3", ref: "8.3", chapter: 8, verse: 3, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अक्षरं ब्रह्म परमं स्वभावोऽध्यात्ममुच्यते", snippet: "The Blessed Lord said, \"Brahman is the Imperishable, the Supreme; its essential nature is called Self-knowledge; the offering (to the gods) that causes the existence and…", sanskrit: "अक्षरं ब्रह्म परमं स्वभावोऽध्यात्ममुच्यते ।\nभूतभावोद्भवकरो विसर्गः कर्मसंज्ञितः ॥", iast: "akṣaraṃ brahma paramaṃ svabhāvo’dhyātmamucyate |\nbhūtabhāvodbhavakaro visargaḥ karmasaṃjñitaḥ ||", transliteration: "akṣharaṁ brahma paramaṁ svabhāvo ’dhyātmam uchyate\nbhūta-bhāvodbhava-karo visargaḥ karma-sanjñitaḥ", translation_en: "The Blessed Lord said, \"Brahman is the Imperishable, the Supreme; its essential nature is called Self-knowledge; the offering (to the gods) that causes the existence and manifestation of beings and sustains them is called action.\"", translation_hi: "श्रीभगवान् ने कहा -- परम अक्षर (अविनाशी) तत्त्व ब्रह्म है; स्वभाव (अपना स्वरूप) अध्यात्म कहा जाता है; भूतों के भावों को उत्पन्न करने वाला विसर्ग (यज्ञ, प्रेरक बल) कर्म नाम से जाना जाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_003.mp3"},
  {id: "BG_8.4", label: "BG 8.4", ref: "8.4", chapter: 8, verse: 4, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अधिभूतं क्षरो भावः पुरुषश्चाधिदैवतम्", snippet: "Adhibhuta—knowledge of the elements—pertains to My perishable nature, and the Purusha, or the Soul, is the Adhidaiva; I alone am the Adhiyajna here in this body, O best among…", sanskrit: "अधिभूतं क्षरो भावः पुरुषश्चाधिदैवतम् ।\nअधियज्ञोऽहमेवात्र देहे देहभृतां वर ॥", iast: "adhibhūtaṃ kṣaro bhāvaḥ puruṣaścādhidaivatam |\nadhiyajño’hamevātra dehe dehabhṛtāṃ vara ||", transliteration: "adhibhūtaṁ kṣharo bhāvaḥ puruṣhaśh chādhidaivatam\nadhiyajño ’ham evātra dehe deha-bhṛitāṁ vara", translation_en: "Adhibhuta—knowledge of the elements—pertains to My perishable nature, and the Purusha, or the Soul, is the Adhidaiva; I alone am the Adhiyajna here in this body, O best among the embodied.", translation_hi: "हे देहधारियों में श्रेष्ठ अर्जुन ! नश्वर वस्तु (पंचमहाभूत) अधिभूत और पुरुष अधिदैव है; इस शरीर में मैं ही अधियज्ञ हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_004.mp3"},
  {id: "BG_8.5", label: "BG 8.5", ref: "8.5", chapter: 8, verse: 5, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अन्तकाले च मामेव स्मरन्मुक्त्वा कलेवरम्", snippet: "And whoever, leaving their body, goes forth remembering Me alone at the time of death, they will attain My Being; there is no doubt about this.", sanskrit: "अन्तकाले च मामेव स्मरन्मुक्त्वा कलेवरम् ।\nयः प्रयाति स मद्भावं याति नास्त्यत्र संशयः ॥", iast: "antakāle ca māmeva smaranmuktvā kalevaram |\nyaḥ prayāti sa madbhāvaṃ yāti nāstyatra saṃśayaḥ ||", transliteration: "anta-kāle cha mām eva smaran muktvā kalevaram\nyaḥ prayāti sa mad-bhāvaṁ yāti nāstyatra sanśhayaḥ", translation_en: "And whoever, leaving their body, goes forth remembering Me alone at the time of death, they will attain My Being; there is no doubt about this.", translation_hi: "और जो कोई पुरुष अन्तकाल में मुझे ही स्मरण करता हुआ शरीर को त्याग कर जाता है, वह मेरे स्वरूप को प्राप्त होता है, इसमें कुछ भी संशय नहीं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_005.mp3"},
  {id: "BG_8.6", label: "BG 8.6", ref: "8.6", chapter: 8, verse: 6, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यं यं वापि स्मरन्भावं त्यजत्यन्ते कलेवरम्", snippet: "Whoever at the end leaves the body, thinking of any being, to that being only does he go, O son of Kunti (Arjuna), due to his constant thought of that being.", sanskrit: "यं यं वापि स्मरन्भावं त्यजत्यन्ते कलेवरम् ।\nतं तमेवैति कौन्तेय सदा तद्भावभावितः ॥", iast: "yaṃ yaṃ vāpi smaranbhāvaṃ tyajatyante kalevaram |\ntaṃ tamevaiti kaunteya sadā tadbhāvabhāvitaḥ ||", transliteration: "yaṁ yaṁ vāpi smaran bhāvaṁ tyajatyante kalevaram\ntaṁ tam evaiti kaunteya sadā tad-bhāva-bhāvitaḥ", translation_en: "Whoever at the end leaves the body, thinking of any being, to that being only does he go, O son of Kunti (Arjuna), due to his constant thought of that being.", translation_hi: "हे कौन्तेय ! (यह जीव) अन्तकाल में जिस किसी भी भाव को स्मरण करता हुआ शरीर को त्यागता है, वह सदैव उस भाव के चिन्तन के फलस्वरूप उसी भाव को ही प्राप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_006.mp3"},
  {id: "BG_8.7", label: "BG 8.7", ref: "8.7", chapter: 8, verse: 7, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तस्मात्सर्वेषु कालेषु मामनुस्मर युध्य च", snippet: "Therefore, at all times, remember Me only and fight. With your mind and intellect fixed on Me, you will undoubtedly come to Me alone.", sanskrit: "तस्मात्सर्वेषु कालेषु मामनुस्मर युध्य च ।\nमय्यर्पितमनोबुद्धिर्मामेवैष्यस्यसंशयम् ॥", iast: "tasmātsarveṣu kāleṣu māmanusmara yudhya ca |\nmayyarpitamanobuddhirmāmevaiṣyasyasaṃśayam ||", transliteration: "tasmāt sarveṣhu kāleṣhu mām anusmara yudhya cha\nmayyarpita-mano-buddhir mām evaiṣhyasyasanśhayam", translation_en: "Therefore, at all times, remember Me only and fight. With your mind and intellect fixed on Me, you will undoubtedly come to Me alone.", translation_hi: "इसलिए, तुम सब काल में मेरा निरन्तर स्मरण करो; और युद्ध करो मुझमें अर्पण किये मन, बुद्धि से युक्त हुए निःसन्देह तुम मुझे ही प्राप्त होओगे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_007.mp3"},
  {id: "BG_8.8", label: "BG 8.8", ref: "8.8", chapter: 8, verse: 8, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अभ्यासयोगयुक्तेन चेतसा नान्यगामिना", snippet: "With the mind not moving towards any other thing, made steadfast through the practice of habitual meditation, and constantly meditating, one goes to the Supreme Person, the…", sanskrit: "अभ्यासयोगयुक्तेन चेतसा नान्यगामिना ।\nपरमं पुरुषं दिव्यं याति पार्थानुचिन्तयन् ॥", iast: "abhyāsayogayuktena cetasā nānyagāminā |\nparamaṃ puruṣaṃ divyaṃ yāti pārthānucintayan ||", transliteration: "abhyāsa-yoga-yuktena chetasā nānya-gāminā\nparamaṁ puruṣhaṁ divyaṁ yāti pārthānuchintayan", translation_en: "With the mind not moving towards any other thing, made steadfast through the practice of habitual meditation, and constantly meditating, one goes to the Supreme Person, the Resplendent, O Arjuna.", translation_hi: "हे पार्थ ! अभ्यासयोग से युक्त अन्यत्र न जाने वाले चित्त से निरन्तर चिन्तन करता हुआ (साधक) परम दिव्य पुरुष को प्राप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_008.mp3"},
  {id: "BG_8.9", label: "BG 8.9", ref: "8.9", chapter: 8, verse: 9, speaker: "krishna", canonical: true, meter: "tristubh", sa: "कविं पुराणमनुशासितार", snippet: "Whosoever meditates on the Omniscient, the Ancient, the Ruler of the whole world, minuter than an atom, the supporter of all, of inconceivable form, effulgent like the sun and…", sanskrit: "कविं पुराणमनुशासितार\nमणोरणीयांसमनुस्मरेद्यः ।\nसर्वस्य धातारमचिन्त्यरूप\nमादित्यवर्णं तमसः परस्तात् ॥", iast: "kaviṃ purāṇamanuśāsitāra\nmaṇoraṇīyāṃsamanusmaredyaḥ |\nsarvasya dhātāramacintyarūpa\nmādityavarṇaṃ tamasaḥ parastāt ||", transliteration: "kaviṁ purāṇam anuśhāsitāram\naṇor aṇīyānsam anusmared yaḥ\nsarvasya dhātāram achintya-rūpam\nāditya-varṇaṁ tamasaḥ parastāt", translation_en: "Whosoever meditates on the Omniscient, the Ancient, the Ruler of the whole world, minuter than an atom, the supporter of all, of inconceivable form, effulgent like the sun and beyond the darkness of ignorance.", translation_hi: "जो पुरुष सर्वज्ञ, प्राचीन (पुराण), सबके नियन्ता, सूक्ष्म से भी सूक्ष्मतर, सब के धाता, अचिन्त्यरूप, सूर्य के समान प्रकाश रूप और (अविद्या) अन्धकार से परे तत्त्व का अनुस्मरण करता है।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_009.mp3"},
  {id: "BG_8.10", label: "BG 8.10", ref: "8.10", chapter: 8, verse: 10, speaker: "krishna", canonical: true, meter: "tristubh-jagati", sa: "प्रयाणकाले मनसाऽचलेन", snippet: "At the time of death, with an unwavering mind, endowed with devotion, by the power of Yoga, fixing the whole life-breath in the middle of the two eyebrows, he reaches that…", sanskrit: "प्रयाणकाले मनसाऽचलेन\nभक्त्या युक्तो योगबलेन चैव ।\nभ्रुवोर्मध्ये प्राणमावेश्य सम्यक्\nस तं परं पुरुषमुपैति दिव्यम् ॥", iast: "prayāṇakāle manasā’calena\nbhaktyā yukto yogabalena caiva |\nbhruvormadhye prāṇamāveśya samyak\nsa taṃ paraṃ puruṣamupaiti divyam ||", transliteration: "prayāṇa-kāle manasāchalena\nbhaktyā yukto yoga-balena chaiva\nbhruvor madhye prāṇam āveśhya samyak\nsa taṁ paraṁ puruṣham upaiti divyam", translation_en: "At the time of death, with an unwavering mind, endowed with devotion, by the power of Yoga, fixing the whole life-breath in the middle of the two eyebrows, he reaches that resplendent Supreme Person.", translation_hi: "वह (साधक) अन्तकाल में योगबल से प्राण को भ्रकुटि के मध्य सम्यक् प्रकार स्थापन करके निश्चल मन से भक्ति युक्त होकर उस परम दिव्य पुरुष को प्राप्त होता है।।", meter_name: "Upajāti (Triṣṭubh–Jagatī mixed)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_010.mp3"},
  {id: "BG_8.11", label: "BG 8.11", ref: "8.11", chapter: 8, verse: 11, speaker: "krishna", canonical: true, meter: "tristubh", sa: "यदक्षरं वेदविदो वदन्ति", snippet: "That which is declared to be Imperishable by those who know the Vedas, that which the self-controlled (ascetics or Sannyasins) and passion-free enter, that goal, desiring which…", sanskrit: "यदक्षरं वेदविदो वदन्ति\nविशन्ति यद्यतयो वीतरागाः ।\nयदिच्छन्तो ब्रह्मचर्यं चरन्ति\nतत्ते पदं संग्रहेण प्रवक्ष्ये ॥", iast: "yadakṣaraṃ vedavido vadanti\nviśanti yadyatayo vītarāgāḥ |\nyadicchanto brahmacaryaṃ caranti\ntatte padaṃ saṃgraheṇa pravakṣye ||", transliteration: "yad akṣharaṁ veda-vido vadanti\nviśhanti yad yatayo vīta-rāgāḥ\nyad ichchhanto brahmacharyaṁ charanti\ntat te padaṁ saṅgraheṇa pravakṣhye", translation_en: "That which is declared to be Imperishable by those who know the Vedas, that which the self-controlled (ascetics or Sannyasins) and passion-free enter, that goal, desiring which celibacy is practised, I will declare to thee in brief.", translation_hi: "वेद के जानने वाले विद्वान जिसे अक्षर कहते हैं; रागरहित यत्नशील पुरुष जिसमें प्रवेश करते हैं; जिसकी इच्छा से (साधक गण) ब्रह्मचर्य का पालन करते हैं - उस पद (लक्ष्य) को मैं तुम्हें संक्षेप में कहूँगा।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_011.mp3"},
  {id: "BG_8.12", label: "BG 8.12", ref: "8.12", chapter: 8, verse: 12, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सर्वद्वाराणि संयम्य मनो हृदि निरुध्य च", snippet: "Having closed all the gates, confined the mind in the heart, and fixed the life-breath in the head, engage in the practice of concentration.", sanskrit: "सर्वद्वाराणि संयम्य मनो हृदि निरुध्य च ।\nमूर्ध्न्याधायात्मनः प्राणमास्थितो योगधारणाम् ॥", iast: "sarvadvārāṇi saṃyamya mano hṛdi nirudhya ca |\nmūrdhnyādhāyātmanaḥ prāṇamāsthito yogadhāraṇām ||", transliteration: "sarva-dvārāṇi sanyamya mano hṛidi nirudhya cha\nmūrdhnyādhāyātmanaḥ prāṇam āsthito yoga-dhāraṇām", translation_en: "Having closed all the gates, confined the mind in the heart, and fixed the life-breath in the head, engage in the practice of concentration.", translation_hi: "सब (इन्द्रियों के) द्वारों को संयमित कर मन को हृदय में स्थिर करके और प्राण को मस्तक में स्थापित करके योगधारणा में स्थित हुआ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_012.mp3"},
  {id: "BG_8.13", label: "BG 8.13", ref: "8.13", chapter: 8, verse: 13, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ओमित्येकाक्षरं ब्रह्म व्याहरन्मामनुस्मरन्", snippet: "Uttering the one-syllabled Om, the Brahman, and remembering Me, he who departs, leaving the body, attains the Supreme Goal.", sanskrit: "ओमित्येकाक्षरं ब्रह्म व्याहरन्मामनुस्मरन् ।\nयः प्रयाति त्यजन्देहं स याति परमां गतिम् ॥", iast: "omityekākṣaraṃ brahma vyāharanmāmanusmaran |\nyaḥ prayāti tyajandehaṃ sa yāti paramāṃ gatim ||", transliteration: "oṁ ityekākṣharaṁ brahma vyāharan mām anusmaran\nyaḥ prayāti tyajan dehaṁ sa yāti paramāṁ gatim", translation_en: "Uttering the one-syllabled Om, the Brahman, and remembering Me, he who departs, leaving the body, attains the Supreme Goal.", translation_hi: "जो पुरुष ओऽम् इस एक अक्षर ब्रह्म का उच्चारण करता हुआ और मेरा स्मरण करता हुआ शरीर का त्याग करता है, वह परम गति को प्राप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_013.mp3"},
  {id: "BG_8.14", label: "BG 8.14", ref: "8.14", chapter: 8, verse: 14, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अनन्यचेताः सततं यो मां स्मरति नित्यशः", snippet: "I am easily attainable by that ever-steadfast yogi who constantly and daily remembers me for a long time, not thinking of anything else with a single-minded or one-pointed…", sanskrit: "अनन्यचेताः सततं यो मां स्मरति नित्यशः ।\nतस्याहं सुलभः पार्थ नित्ययुक्तस्य योगिनः ॥", iast: "ananyacetāḥ satataṃ yo māṃ smarati nityaśaḥ |\ntasyāhaṃ sulabhaḥ pārtha nityayuktasya yoginaḥ ||", transliteration: "ananya-chetāḥ satataṁ yo māṁ smarati nityaśhaḥ\ntasyāhaṁ sulabhaḥ pārtha nitya-yuktasya yoginaḥ", translation_en: "I am easily attainable by that ever-steadfast yogi who constantly and daily remembers me for a long time, not thinking of anything else with a single-minded or one-pointed focus, O Partha.", translation_hi: "हे पार्थ ! जो अनन्यचित्त वाला पुरुष मेरा स्मरण करता है, उस नित्ययुक्त योगी के लिए मैं सुलभ हूँ अर्थात् सहज ही प्राप्त हो जाता हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_014.mp3"},
  {id: "BG_8.15", label: "BG 8.15", ref: "8.15", chapter: 8, verse: 15, speaker: "krishna", canonical: true, meter: "anustubh", sa: "मामुपेत्य पुनर्जन्म दुःखालयमशाश्वतम्", snippet: "Having attained Me, these great souls do not take birth again here—a place of pain and impermanence—but have reached the highest perfection of liberation.", sanskrit: "मामुपेत्य पुनर्जन्म दुःखालयमशाश्वतम् ।\nनाप्नुवन्ति महात्मानः संसिद्धिं परमां गताः ॥", iast: "māmupetya punarjanma duḥkhālayamaśāśvatam |\nnāpnuvanti mahātmānaḥ saṃsiddhiṃ paramāṃ gatāḥ ||", transliteration: "mām upetya punar janma duḥkhālayam aśhāśhvatam\nnāpnuvanti mahātmānaḥ sansiddhiṁ paramāṁ gatāḥ", translation_en: "Having attained Me, these great souls do not take birth again here—a place of pain and impermanence—but have reached the highest perfection of liberation.", translation_hi: "परम सिद्धि को प्राप्त हुये महात्माजन मुझे प्राप्त कर अनित्य दुःख के आलयरूप (गृहरूप) पुनर्जन्म को नहीं प्राप्त होते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_015.mp3"},
  {id: "BG_8.16", label: "BG 8.16", ref: "8.16", chapter: 8, verse: 16, speaker: "krishna", canonical: true, meter: "anustubh", sa: "आब्रह्मभुवनाल्लोकाः पुनरावर्तिनोऽर्जुन", snippet: "All the worlds, including the world of Brahma, are subject to return again, O Arjuna; but he who reaches Me, O son of Kunti, has no rebirth.", sanskrit: "आब्रह्मभुवनाल्लोकाः पुनरावर्तिनोऽर्जुन ।\nमामुपेत्य तु कौन्तेय पुनर्जन्म न विद्यते ॥", iast: "ābrahmabhuvanāllokāḥ punarāvartino’rjuna |\nmāmupetya tu kaunteya punarjanma na vidyate ||", transliteration: "ā-brahma-bhuvanāl lokāḥ punar āvartino ’rjuna\nmām upetya tu kaunteya punar janma na vidyate", translation_en: "All the worlds, including the world of Brahma, are subject to return again, O Arjuna; but he who reaches Me, O son of Kunti, has no rebirth.", translation_hi: "हे अर्जुन ! ब्रह्म लोक तक के सब लोग पुनरावर्ती स्वभाव वाले हैं। परन्तु, हे कौन्तेय ! मुझे प्राप्त होने पर पुनर्जन्म नहीं होता।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_016.mp3"},
  {id: "BG_8.17", label: "BG 8.17", ref: "8.17", chapter: 8, verse: 17, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सहस्रयुगपर्यन्तमहर्यद्ब्रह्मणो विदुः", snippet: "Those who know the day of Brahma, which lasts a thousand Yugas, and the night, which also lasts a thousand Yugas, know day and night.", sanskrit: "सहस्रयुगपर्यन्तमहर्यद्ब्रह्मणो विदुः ।\nरात्रिं युगसहस्रान्तां तेऽहोरात्रविदो जनाः ॥", iast: "sahasrayugaparyantamaharyadbrahmaṇo viduḥ |\nrātriṃ yugasahasrāntāṃ te’horātravido janāḥ ||", transliteration: "sahasra-yuga-paryantam ahar yad brahmaṇo viduḥ\nrātriṁ yuga-sahasrāntāṁ te ’ho-rātra-vido janāḥ", translation_en: "Those who know the day of Brahma, which lasts a thousand Yugas, and the night, which also lasts a thousand Yugas, know day and night.", translation_hi: "जो लोग ब्रह्मा जी के एक दिन की अवधि जानते हैं जो कि सहस्र वर्ष की है तथा एक सहस्र वर्ष की अवधि की एक रात्रि को जानते हैं वे दिन और रात्रि को जानने वाले पुरुष हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_017.mp3"},
  {id: "BG_8.18", label: "BG 8.18", ref: "8.18", chapter: 8, verse: 18, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अव्यक्ताद्व्यक्तयः सर्वाः प्रभवन्त्यहरागमे", snippet: "From the Unmanifested, all the manifested worlds proceed upon the arrival of the 'day'; upon the arrival of the 'night', they dissolve indeed into that which is known as the…", sanskrit: "अव्यक्ताद्व्यक्तयः सर्वाः प्रभवन्त्यहरागमे ।\nरात्र्यागमे प्रलीयन्ते तत्रैवाव्यक्तसंज्ञके ॥", iast: "avyaktādvyaktayaḥ sarvāḥ prabhavantyaharāgame |\nrātryāgame pralīyante tatraivāvyaktasaṃjñake ||", transliteration: "avyaktād vyaktayaḥ sarvāḥ prabhavantyahar-āgame\nrātryāgame pralīyante tatraivāvyakta-sanjñake", translation_en: "From the Unmanifested, all the manifested worlds proceed upon the arrival of the 'day'; upon the arrival of the 'night', they dissolve indeed into that which is known as the Unmanifested.", translation_hi: "(ब्रह्माजी के) दिन का उदय होने पर अव्यक्त से (यह) व्यक्त (चराचर जगत्) उत्पन्न होता है; और (ब्रह्माजी की) रात्रि के आगमन पर उसी अव्यक्त में लीन हो जाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_018.mp3"},
  {id: "BG_8.19", label: "BG 8.19", ref: "8.19", chapter: 8, verse: 19, speaker: "krishna", canonical: true, meter: "anustubh", sa: "भूतग्रामः स एवायं भूत्वा भूत्वा प्रलीयते", snippet: "This same multitude of beings, being born again and again, helplessly dissolves, O Arjuna, into the Unmanifested at the coming of the night and comes forth at the coming of the…", sanskrit: "भूतग्रामः स एवायं भूत्वा भूत्वा प्रलीयते ।\nरात्र्यागमेऽवशः पार्थ प्रभवत्यहरागमे ॥", iast: "bhūtagrāmaḥ sa evāyaṃ bhūtvā bhūtvā pralīyate |\nrātryāgame’vaśaḥ pārtha prabhavatyaharāgame ||", transliteration: "bhūta-grāmaḥ sa evāyaṁ bhūtvā bhūtvā pralīyate\nrātryāgame ’vaśhaḥ pārtha prabhavatyahar-āgame", translation_en: "This same multitude of beings, being born again and again, helplessly dissolves, O Arjuna, into the Unmanifested at the coming of the night and comes forth at the coming of the day.", translation_hi: "हे पार्थ ! वही यह भूतसमुदाय, है जो पुनः पुनः उत्पन्न होकर लीन होता है। अवश हुआ (यह भूतग्राम) रात्रि के आगमन पर लीन तथा दिन के उदय होने पर व्यक्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_019.mp3"},
  {id: "BG_8.20", label: "BG 8.20", ref: "8.20", chapter: 8, verse: 20, speaker: "krishna", canonical: true, meter: "anustubh", sa: "परस्तस्मात्तु भावोऽन्योऽव्यक्तोऽव्यक्तात्सनातनः", snippet: "But verily, there exists higher than this Unmanifested, another Unmanifested Eternal, which is not destroyed even when all beings are destroyed.", sanskrit: "परस्तस्मात्तु भावोऽन्योऽव्यक्तोऽव्यक्तात्सनातनः ।\nयः स सर्वेषु भूतेषु नश्यत्सु न विनश्यति ॥", iast: "parastasmāttu bhāvo’nyo’vyakto’vyaktātsanātanaḥ |\nyaḥ sa sarveṣu bhūteṣu naśyatsu na vinaśyati ||", transliteration: "paras tasmāt tu bhāvo ’nyo ’vyakto ’vyaktāt sanātanaḥ\nyaḥ sa sarveṣhu bhūteṣhu naśhyatsu na vinaśhyati", translation_en: "But verily, there exists higher than this Unmanifested, another Unmanifested Eternal, which is not destroyed even when all beings are destroyed.", translation_hi: "परन्तु उस अव्यक्त से परे अन्य जो सनातन अव्यक्त भाव है, वह समस्त भूतों के नष्ट होने पर भी नष्ट नहीं होता।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_020.mp3"},
  {id: "BG_8.21", label: "BG 8.21", ref: "8.21", chapter: 8, verse: 21, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अव्यक्तोऽक्षर इत्युक्तस्तमाहुः परमां गतिम्", snippet: "What is known as the Unmanifested and the Imperishable, That is said to be the highest goal. Those who reach It do not return (to this Samsara). That is My supreme abode (place…", sanskrit: "अव्यक्तोऽक्षर इत्युक्तस्तमाहुः परमां गतिम् ।\nयं प्राप्य न निवर्तन्ते तद्धाम परमं मम ॥", iast: "avyakto’kṣara ityuktastamāhuḥ paramāṃ gatim |\nyaṃ prāpya na nivartante taddhāma paramaṃ mama ||", transliteration: "avyakto ’kṣhara ityuktas tam āhuḥ paramāṁ gatim\nyaṁ prāpya na nivartante tad dhāma paramaṁ mama", translation_en: "What is known as the Unmanifested and the Imperishable, That is said to be the highest goal. Those who reach It do not return (to this Samsara). That is My supreme abode (place or state).", translation_hi: "जो अव्यक्त अक्षर कहा गया है, वही परम गति (लक्ष्य) है। जिसे प्राप्त होकर (साधकगण) पुनः (संसार को) नहीं लौटते, वह मेरा परम धाम है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_021.mp3"},
  {id: "BG_8.22", label: "BG 8.22", ref: "8.22", chapter: 8, verse: 22, speaker: "krishna", canonical: true, meter: "anustubh", sa: "पुरुषः स परः पार्थ भक्त्या लभ्यस्त्वनन्यया", snippet: "That highest Purusha, O Arjuna, is attainable by unswerving devotion to Him alone, within Whom all beings dwell and by Whom all this is pervaded.", sanskrit: "पुरुषः स परः पार्थ भक्त्या लभ्यस्त्वनन्यया ।\nयस्यान्तःस्थानि भूतानि येन सर्वमिदं ततम् ॥", iast: "puruṣaḥ sa paraḥ pārtha bhaktyā labhyastvananyayā |\nyasyāntaḥsthāni bhūtāni yena sarvamidaṃ tatam ||", transliteration: "puruṣhaḥ sa paraḥ pārtha bhaktyā labhyas tvananyayā\nyasyāntaḥ-sthāni bhūtāni yena sarvam idaṁ tatam", translation_en: "That highest Purusha, O Arjuna, is attainable by unswerving devotion to Him alone, within Whom all beings dwell and by Whom all this is pervaded.", translation_hi: "हे पार्थ ! जिस (परमात्मा) के अन्तर्गत समस्त भूत हैं और जिससे यह सम्पूर्ण (जगत्) व्याप्त है, वह परम पुरुष अनन्य भक्ति से ही प्राप्त करने योग्य है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_022.mp3"},
  {id: "BG_8.23", label: "BG 8.23", ref: "8.23", chapter: 8, verse: 23, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यत्र काले त्वनावृत्तिमावृत्तिं चैव योगिनः", snippet: "Now I will tell you, O chief of the Bharatas, the times of departure at which the Yogis will return or not return.", sanskrit: "यत्र काले त्वनावृत्तिमावृत्तिं चैव योगिनः ।\nप्रयाता यान्ति तं कालं वक्ष्यामि भरतर्षभ ॥", iast: "yatra kāle tvanāvṛttimāvṛttiṃ caiva yoginaḥ |\nprayātā yānti taṃ kālaṃ vakṣyāmi bharatarṣabha ||", transliteration: "yatra kāle tvanāvṛittim āvṛittiṁ chaiva yoginaḥ\nprayātā yānti taṁ kālaṁ vakṣhyāmi bharatarṣhabha", translation_en: "Now I will tell you, O chief of the Bharatas, the times of departure at which the Yogis will return or not return.", translation_hi: "हे भरतश्रेष्ठ ! जिस काल में (मार्ग में) शरीर त्याग कर गये हुए योगीजन अपुनरावृत्ति को, और (या) पुनरावृत्ति को प्राप्त होते हैं, वह काल (मार्ग) मैं तुम्हें बताऊँगा।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_023.mp3"},
  {id: "BG_8.24", label: "BG 8.24", ref: "8.24", chapter: 8, verse: 24, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अग्निर्ज्योतिरहः शुक्लः षण्मासा उत्तरायणम्", snippet: "Fire, light, daytime, the bright fortnight, the six months of the northern path of the sun (the northern solstice) departing, then men who know Brahman go to Brahman.", sanskrit: "अग्निर्ज्योतिरहः शुक्लः षण्मासा उत्तरायणम् ।\nतत्र प्रयाता गच्छन्ति ब्रह्म ब्रह्मविदो जनाः ॥", iast: "agnirjyotirahaḥ śuklaḥ ṣaṇmāsā uttarāyaṇam |\ntatra prayātā gacchanti brahma brahmavido janāḥ ||", transliteration: "agnir jyotir ahaḥ śhuklaḥ ṣhaṇ-māsā uttarāyaṇam\ntatra prayātā gachchhanti brahma brahma-vido janāḥ", translation_en: "Fire, light, daytime, the bright fortnight, the six months of the northern path of the sun (the northern solstice) departing, then men who know Brahman go to Brahman.", translation_hi: "जो ब्रह्मविद् साधकजन मरणोपरान्त अग्नि, ज्योति, दिन, शुक्लपक्ष और उत्तरायण के छः मास वाले मार्ग से जाते हैं, वे ब्रह्म को प्राप्त होते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_024.mp3"},
  {id: "BG_8.25", label: "BG 8.25", ref: "8.25", chapter: 8, verse: 25, speaker: "krishna", canonical: true, meter: "anustubh", sa: "धूमो रात्रिस्तथा कृष्णः षण्मासा दक्षिणायनम्", snippet: "Attaining the lunar light through smoke, night time, the dark fortnight, and the six months of the southern path of the sun (the southern solstice), the yogi returns.", sanskrit: "धूमो रात्रिस्तथा कृष्णः षण्मासा दक्षिणायनम् ।\nतत्र चान्द्रमसं ज्योतिर्योगी प्राप्य निवर्तते ॥", iast: "dhūmo rātristathā kṛṣṇaḥ ṣaṇmāsā dakṣiṇāyanam |\ntatra cāndramasaṃ jyotiryogī prāpya nivartate ||", transliteration: "dhūmo rātris tathā kṛiṣhṇaḥ ṣhaṇ-māsā dakṣhiṇāyanam\ntatra chāndramasaṁ jyotir yogī prāpya nivartate", translation_en: "Attaining the lunar light through smoke, night time, the dark fortnight, and the six months of the southern path of the sun (the southern solstice), the yogi returns.", translation_hi: "धूम, रात्रि, कृष्णपक्ष और दक्षिणायन के छः मास वाले मार्ग से चन्द्रमा की ज्योति को प्राप्त कर, योगी (संसार को) लौटता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_025.mp3"},
  {id: "BG_8.26", label: "BG 8.26", ref: "8.26", chapter: 8, verse: 26, speaker: "krishna", canonical: true, meter: "anustubh", sa: "शुक्लकृष्णे गती ह्येते जगतः शाश्वते मते", snippet: "The bright and dark paths of the world are thought to be eternal; one leads to no return, and the other leads to return.", sanskrit: "शुक्लकृष्णे गती ह्येते जगतः शाश्वते मते ।\nएकया यात्यनावृत्तिमन्ययाऽऽवर्तते पुनः ॥", iast: "śuklakṛṣṇe gatī hyete jagataḥ śāśvate mate |\nekayā yātyanāvṛttimanyayā’’vartate punaḥ ||", transliteration: "śhukla-kṛiṣhṇe gatī hyete jagataḥ śhāśhvate mate\nekayā yātyanāvṛittim anyayāvartate punaḥ", translation_en: "The bright and dark paths of the world are thought to be eternal; one leads to no return, and the other leads to return.", translation_hi: "जगत् के ये दो प्रकार के शुक्ल और कृष्ण मार्ग सनातन माने गये हैं । इनमें एक (शुक्ल) के द्वारा (साधक) अपुनरावृत्ति को तथा अन्य (कृष्ण) के द्वारा पुनरावृत्ति को प्राप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_026.mp3"},
  {id: "BG_8.27", label: "BG 8.27", ref: "8.27", chapter: 8, verse: 27, speaker: "krishna", canonical: true, meter: "anustubh", sa: "नैते सृती पार्थ जानन्योगी मुह्यति कश्चन", snippet: "Knowing these paths, O Arjuna, no yogi is deluded; therefore, at all times, be steadfast in yoga.", sanskrit: "नैते सृती पार्थ जानन्योगी मुह्यति कश्चन ।\nतस्मात्सर्वेषु कालेषु योगयुक्तो भवार्जुन ॥", iast: "naite sṛtī pārtha jānanyogī muhyati kaścana |\ntasmātsarveṣu kāleṣu yogayukto bhavārjuna ||", transliteration: "naite sṛitī pārtha jānan yogī muhyati kaśhchana\ntasmāt sarveṣhu kāleṣhu yoga-yukto bhavārjuna", translation_en: "Knowing these paths, O Arjuna, no yogi is deluded; therefore, at all times, be steadfast in yoga.", translation_hi: "हे पार्थ इन दो मार्गों को (तत्त्व से) जानने वाला कोई भी योगी मोहित नहीं होता। इसलिए, हे अर्जुन ! तुम सब काल में योगयुक्त बनो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_027.mp3"},
  {id: "BG_8.28", label: "BG 8.28", ref: "8.28", chapter: 8, verse: 28, speaker: "krishna", canonical: true, meter: "tristubh", sa: "वेदेषु यज्ञेषु तपःसु चैव", snippet: "Whatever fruit of merit is declared (in the scriptures) to accrue from (the study of) the Vedas, (the performance of) sacrifices, (the practice of) austerities, and gifts,…", sanskrit: "वेदेषु यज्ञेषु तपःसु चैव\nदानेषु यत्पुण्यफलं प्रदिष्टम् ।\nअत्येति तत्सर्वमिदं विदित्वा\nयोगी परं स्थानमुपैति चाद्यम् ॥", iast: "vedeṣu yajñeṣu tapaḥsu caiva\ndāneṣu yatpuṇyaphalaṃ pradiṣṭam |\natyeti tatsarvamidaṃ viditvā\nyogī paraṃ sthānamupaiti cādyam ||", transliteration: "vedeṣhu yajñeṣhu tapaḥsu chaiva\ndāneṣhu yat puṇya-phalaṁ pradiṣhṭam\natyeti tat sarvam idaṁ viditvā\nyogī paraṁ sthānam upaiti chādyam", translation_en: "Whatever fruit of merit is declared (in the scriptures) to accrue from (the study of) the Vedas, (the performance of) sacrifices, (the practice of) austerities, and gifts, beyond all this goes the Yogi, having known this; and he attains to the Supreme, Primeval (first or ancient) Abode.", translation_hi: "योगी पुरुष यह सब (दोनों मार्गों के तत्त्व को) जानकर वेदाध्ययन, यज्ञ, तप और दान करने में जो पुण्य फल कहा गया है, उस सबका उल्लंघन कर जाता है और आद्य (सनातन), परम स्थान को प्राप्त होता है।।", meter_name: "Triṣṭubh — Indravajrā", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/008_028.mp3"},
  {id: "BG_9.1", label: "BG 9.1", ref: "9.1", chapter: 9, verse: 1, speaker: "krishna", canonical: true, meter: "anustubh", sa: "इदं तु ते गुह्यतमं प्रवक्ष्याम्यनसूयवे", snippet: "The Blessed Lord said, \"I shall now declare to thee, who does not cavil, the greatest secret—the knowledge combined with experience (Self-realisation). Having known this, thou…", sanskrit: "इदं तु ते गुह्यतमं प्रवक्ष्याम्यनसूयवे ।\nज्ञानं विज्ञानसहितं यज्ज्ञात्वा मोक्ष्यसेऽशुभात् ॥", iast: "idaṃ tu te guhyatamaṃ pravakṣyāmyanasūyave |\njñānaṃ vijñānasahitaṃ yajjñātvā mokṣyase’śubhāt ||", transliteration: "idaṁ tu te guhyatamaṁ pravakṣhyāmyanasūyave\njñānaṁ vijñāna-sahitaṁ yaj jñātvā mokṣhyase ’śhubhāt", translation_en: "The Blessed Lord said, \"I shall now declare to thee, who does not cavil, the greatest secret—the knowledge combined with experience (Self-realisation). Having known this, thou shalt be free from evil.\"", translation_hi: "श्रीभगवान् ने कहा -- तुम अनसूयु (दोष दृष्टि रहित) के लिए मैं इस गुह्यतम ज्ञान को विज्ञान के सहित कहूँगा, जिसको जानकर तुम अशुभ (संसार बंधन) से मुक्त हो जाओगे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_001.mp3"},
  {id: "BG_9.2", label: "BG 9.2", ref: "9.2", chapter: 9, verse: 2, speaker: "krishna", canonical: true, meter: "anustubh", sa: "राजविद्या राजगुह्यं पवित्रमिदमुत्तमम्", snippet: "This is the royal science, the royal secret, the supreme purifier, realizable by direct intuitive knowledge, according to righteousness, very easy to perform and imperishable.", sanskrit: "राजविद्या राजगुह्यं पवित्रमिदमुत्तमम् ।\nप्रत्यक्षावगमं धर्म्यं सुसुखं कर्तुमव्ययम् ॥", iast: "rājavidyā rājaguhyaṃ pavitramidamuttamam |\npratyakṣāvagamaṃ dharmyaṃ susukhaṃ kartumavyayam ||", transliteration: "rāja-vidyā rāja-guhyaṁ pavitram idam uttamam\npratyakṣhāvagamaṁ dharmyaṁ su-sukhaṁ kartum avyayam", translation_en: "This is the royal science, the royal secret, the supreme purifier, realizable by direct intuitive knowledge, according to righteousness, very easy to perform and imperishable.", translation_hi: "यह ज्ञान राजविद्या (विद्याओं का राजा) और राजगुह्य (सब गुह्यों अर्थात् रहस्यों का राजा) एवं पवित्र, उत्तम, प्रत्यक्ष ज्ञानवाला और धर्मयुक्त है, तथा करने में सरल और अव्यय है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_002.mp3"},
  {id: "BG_9.3", label: "BG 9.3", ref: "9.3", chapter: 9, verse: 3, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अश्रद्दधानाः पुरुषा धर्मस्यास्य परन्तप", snippet: "Those who have no faith in this Dharma, O Parantapa, return to the path of this world without attaining Me.", sanskrit: "अश्रद्दधानाः पुरुषा धर्मस्यास्य परन्तप ।\nअप्राप्य मां निवर्तन्ते मृत्युसंसारवर्त्मनि ॥", iast: "aśraddadhānāḥ puruṣā dharmasyāsya parantapa |\naprāpya māṃ nivartante mṛtyusaṃsāravartmani ||", transliteration: "aśhraddadhānāḥ puruṣhā dharmasyāsya parantapa\naprāpya māṁ nivartante mṛityu-samsāra-vartmani", translation_en: "Those who have no faith in this Dharma, O Parantapa, return to the path of this world without attaining Me.", translation_hi: "हे परन्तप ! इस धर्म में श्रद्धारहित पुरुष मुझे प्राप्त न होकर मृत्युरूपी संसार में रहते हैं (भ्रमण करते हैं)।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_003.mp3"},
  {id: "BG_9.4", label: "BG 9.4", ref: "9.4", chapter: 9, verse: 4, speaker: "krishna", canonical: true, meter: "anustubh", sa: "मया ततमिदं सर्वं जगदव्यक्तमूर्तिना", snippet: "All of this world is pervaded by Me in My unmanifest aspect; all beings exist within Me, but I do not dwell within them.", sanskrit: "मया ततमिदं सर्वं जगदव्यक्तमूर्तिना ।\nमत्स्थानि सर्वभूतानि न चाहं तेष्ववस्थितः ॥", iast: "mayā tatamidaṃ sarvaṃ jagadavyaktamūrtinā |\nmatsthāni sarvabhūtāni na cāhaṃ teṣvavasthitaḥ ||", transliteration: "mayā tatam idaṁ sarvaṁ jagad avyakta-mūrtinā\nmat-sthāni sarva-bhūtāni na chāhaṁ teṣhvavasthitaḥ", translation_en: "All of this world is pervaded by Me in My unmanifest aspect; all beings exist within Me, but I do not dwell within them.", translation_hi: "यह सम्पूर्ण जगत् मुझ (परमात्मा) के अव्यक्त स्वरूप से व्याप्त है; भूतमात्र मुझमें स्थित है, परन्तु मैं उनमें स्थित नहीं हूं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_004.mp3"},
  {id: "BG_9.5", label: "BG 9.5", ref: "9.5", chapter: 9, verse: 5, speaker: "krishna", canonical: true, meter: "anustubh", sa: "न च मत्स्थानि भूतानि पश्य मे योगमैश्वरम्", snippet: "Nor do beings exist in Me (in reality); behold, My divine Yoga, which supports all beings, but does not dwell in them, is My Self, the efficient cause of beings.", sanskrit: "न च मत्स्थानि भूतानि पश्य मे योगमैश्वरम् ।\nभूतभृन्न च भूतस्थो ममात्मा भूतभावनः ॥", iast: "na ca matsthāni bhūtāni paśya me yogamaiśvaram |\nbhūtabhṛnna ca bhūtastho mamātmā bhūtabhāvanaḥ ||", transliteration: "na cha mat-sthāni bhūtāni paśhya me yogam aiśhwaram\nbhūta-bhṛin na cha bhūta-stho mamātmā bhūta-bhāvanaḥ", translation_en: "Nor do beings exist in Me (in reality); behold, My divine Yoga, which supports all beings, but does not dwell in them, is My Self, the efficient cause of beings.", translation_hi: "और (वस्तुत:) भूतमात्र मुझ में स्थित नहीं है; मेरे ईश्वरीय योग को देखो कि भूतों को धारण करने वाली और भूतों को उत्पन्न करने वाली मेरी आत्मा उन भूतों में स्थित नहीं है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_005.mp3"},
  {id: "BG_9.6", label: "BG 9.6", ref: "9.6", chapter: 9, verse: 6, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यथाऽऽकाशस्थितो नित्यं वायुः सर्वत्रगो महान्", snippet: "As the mighty wind, moving everywhere, always rests in the ether, so too, know that all beings rest in Me.", sanskrit: "यथाऽऽकाशस्थितो नित्यं वायुः सर्वत्रगो महान् ।\nतथा सर्वाणि भूतानि मत्स्थानीत्युपधारय ॥", iast: "yathā’’kāśasthito nityaṃ vāyuḥ sarvatrago mahān |\ntathā sarvāṇi bhūtāni matsthānītyupadhāraya ||", transliteration: "yathākāśha-sthito nityaṁ vāyuḥ sarvatra-go mahān\ntathā sarvāṇi bhūtāni mat-sthānītyupadhāraya", translation_en: "As the mighty wind, moving everywhere, always rests in the ether, so too, know that all beings rest in Me.", translation_hi: "जैसे सर्वत्र विचरण करने वाली महान् वायु सदा आकाश में स्थित रहती हैं, वैसे ही सम्पूर्ण भूत मुझमें स्थित हैं, ऐसा तुम जानो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_006.mp3"},
  {id: "BG_9.7", label: "BG 9.7", ref: "9.7", chapter: 9, verse: 7, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सर्वभूतानि कौन्तेय प्रकृतिं यान्ति मामिकाम्", snippet: "All beings, O Arjuna, go into My Nature at the end of a Kalpa; I send them forth again at the beginning of the next Kalpa.", sanskrit: "सर्वभूतानि कौन्तेय प्रकृतिं यान्ति मामिकाम् ।\nकल्पक्षये पुनस्तानि कल्पादौ विसृजाम्यहम् ॥", iast: "sarvabhūtāni kaunteya prakṛtiṃ yānti māmikām |\nkalpakṣaye punastāni kalpādau visṛjāmyaham ||", transliteration: "sarva-bhūtāni kaunteya prakṛitiṁ yānti māmikām\nkalpa-kṣhaye punas tāni kalpādau visṛijāmyaham", translation_en: "All beings, O Arjuna, go into My Nature at the end of a Kalpa; I send them forth again at the beginning of the next Kalpa.", translation_hi: "हे कौन्तेय ! (एक) कल्प के अन्त में समस्त भूत मेरी प्रकृति को प्राप्त होते हैं; और (दूसरे) कल्प के प्रारम्भ में उनको मैं फिर रचता हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_007.mp3"},
  {id: "BG_9.8", label: "BG 9.8", ref: "9.8", chapter: 9, verse: 8, speaker: "krishna", canonical: true, meter: "anustubh", sa: "प्रकृतिं स्वामवष्टभ्य विसृजामि पुनः पुनः", snippet: "Animating My Nature, I again and again send forth all this multitude of beings, helpless under the force of Nature.", sanskrit: "प्रकृतिं स्वामवष्टभ्य विसृजामि पुनः पुनः ।\nभूतग्राममिमं कृत्स्नमवशं प्रकृतेर्वशात् ॥", iast: "prakṛtiṃ svāmavaṣṭabhya visṛjāmi punaḥ punaḥ |\nbhūtagrāmamimaṃ kṛtsnamavaśaṃ prakṛtervaśāt ||", transliteration: "prakṛitiṁ svām avaṣhṭabhya visṛijāmi punaḥ punaḥ\nbhūta-grāmam imaṁ kṛitsnam avaśhaṁ prakṛiter vaśhāt", translation_en: "Animating My Nature, I again and again send forth all this multitude of beings, helpless under the force of Nature.", translation_hi: "प्रकृति को अपने वश में करके (अर्थात् उसे चेतनता प्रदान कर) स्वभाव के वश से परतन्त्र (अवश) हुए इस सम्पूर्ण भूत समुदाय को मैं पुन:-पुन: रचता हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_008.mp3"},
  {id: "BG_9.9", label: "BG 9.9", ref: "9.9", chapter: 9, verse: 9, speaker: "krishna", canonical: true, meter: "anustubh", sa: "न च मां तानि कर्माणि निबध्नन्ति धनञ्जय", snippet: "These acts do not bind Me, O Arjuna, sitting as one indifferent, unattached to those acts.", sanskrit: "न च मां तानि कर्माणि निबध्नन्ति धनञ्जय ।\nउदासीनवदासीनमसक्तं तेषु कर्मसु ॥", iast: "na ca māṃ tāni karmāṇi nibadhnanti dhanañjaya |\nudāsīnavadāsīnamasaktaṃ teṣu karmasu ||", transliteration: "na cha māṁ tāni karmāṇi nibadhnanti dhanañjaya\nudāsīna-vad āsīnam asaktaṁ teṣhu karmasu", translation_en: "These acts do not bind Me, O Arjuna, sitting as one indifferent, unattached to those acts.", translation_hi: "हे धनंजय ! उन कर्मों में आसक्ति रहित और उदासीन के समान स्थित मुझ (परमात्मा) को वे कर्म नहीं बांधते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_009.mp3"},
  {id: "BG_9.10", label: "BG 9.10", ref: "9.10", chapter: 9, verse: 10, speaker: "krishna", canonical: true, meter: "anustubh", sa: "मयाऽध्यक्षेण प्रकृतिः सूयते सचराचरम्", snippet: "Under Me, as supervisor, Nature produces the moving and the unmoving; therefore, O Arjuna, the world revolves.", sanskrit: "मयाऽध्यक्षेण प्रकृतिः सूयते सचराचरम् ।\nहेतुनाऽनेन कौन्तेय जगद्विपरिवर्तते ॥", iast: "mayā’dhyakṣeṇa prakṛtiḥ sūyate sacarācaram |\nhetunā’nena kaunteya jagadviparivartate ||", transliteration: "mayādhyakṣheṇa prakṛitiḥ sūyate sa-charācharam\nhetunānena kaunteya jagad viparivartate", translation_en: "Under Me, as supervisor, Nature produces the moving and the unmoving; therefore, O Arjuna, the world revolves.", translation_hi: "हे कौन्तेय ! मुझ अध्यक्ष के कारण ( अर्थात् मेरी अध्यक्षता में) प्रकृति चराचर जगत् को उत्पन्न करती है; इस कारण यह जगत् घूमता रहता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_010.mp3"},
  {id: "BG_9.11", label: "BG 9.11", ref: "9.11", chapter: 9, verse: 11, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अवजानन्ति मां मूढा मानुषीं तनुमाश्रितम्", snippet: "Fools disregard Me, clad in human form, not knowing My higher Being as the great Lord of all beings.", sanskrit: "अवजानन्ति मां मूढा मानुषीं तनुमाश्रितम् ।\nपरं भावमजानन्तो मम भूतमहेश्वरम् ॥", iast: "avajānanti māṃ mūḍhā mānuṣīṃ tanumāśritam |\nparaṃ bhāvamajānanto mama bhūtamaheśvaram ||", transliteration: "avajānanti māṁ mūḍhā mānuṣhīṁ tanum āśhritam\nparaṁ bhāvam ajānanto mama bhūta-maheśhvaram", translation_en: "Fools disregard Me, clad in human form, not knowing My higher Being as the great Lord of all beings.", translation_hi: "समस्त भूतों के महान् ईश्वर रूप मेरे परम भाव को नहीं जानते हुए मूढ़ लोग मनुष्य शरीरधारी मुझ परमात्मा का अनादर करते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_011.mp3"},
  {id: "BG_9.12", label: "BG 9.12", ref: "9.12", chapter: 9, verse: 12, speaker: "krishna", canonical: true, meter: "anustubh", sa: "मोघाशा मोघकर्माणो मोघज्ञाना विचेतसः", snippet: "They are possessed of the deceitful nature of demons and undivine beings, filled with vain hopes, vain actions, and vain knowledge that is senseless.", sanskrit: "मोघाशा मोघकर्माणो मोघज्ञाना विचेतसः ।\nराक्षसीमासुरीं चैव प्रकृतिं मोहिनीं श्रिताः ॥", iast: "moghāśā moghakarmāṇo moghajñānā vicetasaḥ |\nrākṣasīmāsurīṃ caiva prakṛtiṃ mohinīṃ śritāḥ ||", transliteration: "moghāśhā mogha-karmāṇo mogha-jñānā vichetasaḥ\nrākṣhasīm āsurīṁ chaiva prakṛitiṁ mohinīṁ śhritāḥ", translation_en: "They are possessed of the deceitful nature of demons and undivine beings, filled with vain hopes, vain actions, and vain knowledge that is senseless.", translation_hi: "वृथा आशा, वृथा कर्म और वृथा ज्ञान वाले अविचारीजन राक्षसों के और असुरों के मोहित करने वाले स्वभाव को धारण किये रहते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_012.mp3"},
  {id: "BG_9.13", label: "BG 9.13", ref: "9.13", chapter: 9, verse: 13, speaker: "krishna", canonical: true, meter: "anustubh", sa: "महात्मानस्तु मां पार्थ दैवीं प्रकृतिमाश्रिताः", snippet: "But the great souls, O Arjuna, partaking of My divine nature, worship Me with a single-minded devotion, knowing Me as the imperishable source of all beings.", sanskrit: "महात्मानस्तु मां पार्थ दैवीं प्रकृतिमाश्रिताः ।\nभजन्त्यनन्यमनसो ज्ञात्वा भूतादिमव्ययम् ॥", iast: "mahātmānastu māṃ pārtha daivīṃ prakṛtimāśritāḥ |\nbhajantyananyamanaso jñātvā bhūtādimavyayam ||", transliteration: "mahātmānas tu māṁ pārtha daivīṁ prakṛitim āśhritāḥ\nbhajantyananya-manaso jñātvā bhūtādim avyayam", translation_en: "But the great souls, O Arjuna, partaking of My divine nature, worship Me with a single-minded devotion, knowing Me as the imperishable source of all beings.", translation_hi: "हे पार्थ ! परन्तु दैवी प्रकृति के आश्रित महात्मा पुरुष मुझे समस्त भूतों का आदिकारण और अव्ययस्वरूप जानकर अनन्यमन से युक्त होकर मुझे भजते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_013.mp3"},
  {id: "BG_9.14", label: "BG 9.14", ref: "9.14", chapter: 9, verse: 14, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सततं कीर्तयन्तो मां यतन्तश्च दृढव्रताः", snippet: "Always glorifying Me, striving, firm in their vows, prostrating themselves before Me, they worship Me with steadfast devotion.", sanskrit: "सततं कीर्तयन्तो मां यतन्तश्च दृढव्रताः ।\nनमस्यन्तश्च मां भक्त्या नित्ययुक्ता उपासते ॥", iast: "satataṃ kīrtayanto māṃ yatantaśca dṛḍhavratāḥ |\nnamasyantaśca māṃ bhaktyā nityayuktā upāsate ||", transliteration: "satataṁ kīrtayanto māṁ yatantaśh cha dṛiḍha-vratāḥ\nnamasyantaśh cha māṁ bhaktyā nitya-yuktā upāsate", translation_en: "Always glorifying Me, striving, firm in their vows, prostrating themselves before Me, they worship Me with steadfast devotion.", translation_hi: "सतत मेरा कीर्तन करते हुए, प्रयत्नशील, दढ़व्रती पुरुष मुझे नमस्कार करते हुए, नित्ययुक्त होकर भक्तिपूर्वक मेरी उपासना करते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_014.mp3"},
  {id: "BG_9.15", label: "BG 9.15", ref: "9.15", chapter: 9, verse: 15, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ज्ञानयज्ञेन चाप्यन्ये यजन्तो मामुपासते", snippet: "Others also, sacrificing with the wisdom-sacrifice, worship Me, the All-Faced, as one, distinct, and manifold.", sanskrit: "ज्ञानयज्ञेन चाप्यन्ये यजन्तो मामुपासते ।\nएकत्वेन पृथक्त्वेन बहुधा विश्वतोमुखम् ॥", iast: "jñānayajñena cāpyanye yajanto māmupāsate |\nekatvena pṛthaktvena bahudhā viśvatomukham ||", transliteration: "jñāna-yajñena chāpyanye yajanto mām upāsate\nekatvena pṛithaktvena bahudhā viśhvato-mukham", translation_en: "Others also, sacrificing with the wisdom-sacrifice, worship Me, the All-Faced, as one, distinct, and manifold.", translation_hi: "कोई मुझे ज्ञानयज्ञ के द्वारा पूजन करते हुए एकत्वभाव से उपासते हैं, कोई पृथक भाव से, कोई बहुत प्रकार से मुझ विराट स्वरूप (विश्वतो मुखम्) को उपासते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_015.mp3"},
  {id: "BG_9.16", label: "BG 9.16", ref: "9.16", chapter: 9, verse: 16, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अहं क्रतुरहं यज्ञः स्वधाऽहमहमौषधम्", snippet: "I am Kratu; I am Yajna; I am the offering to the manes; I am the medicinal herbs and all plants; I am the Mantra; I am also the ghee or melted butter; I am the fire; I am the…", sanskrit: "अहं क्रतुरहं यज्ञः स्वधाऽहमहमौषधम् ।\nमंत्रोऽहमहमेवाज्यमहमग्निरहं हुतम् ॥", iast: "ahaṃ kraturahaṃ yajñaḥ svadhā’hamahamauṣadham |\nmaṃtro’hamahamevājyamahamagnirahaṃ hutam ||", transliteration: "ahaṁ kratur ahaṁ yajñaḥ svadhāham aham auṣhadham\nmantro ’ham aham evājyam aham agnir ahaṁ hutam", translation_en: "I am Kratu; I am Yajna; I am the offering to the manes; I am the medicinal herbs and all plants; I am the Mantra; I am also the ghee or melted butter; I am the fire; I am the oblation.", translation_hi: "मैं ऋक्रतु हूँ; मैं यज्ञ हूँ; स्वधा और औषध मैं हूँ, मैं मन्त्र हूँ, घी हूँ, मैं अग्नि हूँ और हुतं अर्थात् हवन कर्म मैं हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_016.mp3"},
  {id: "BG_9.17", label: "BG 9.17", ref: "9.17", chapter: 9, verse: 17, speaker: "krishna", canonical: true, meter: "anustubh", sa: "पिताऽहमस्य जगतो माता धाता पितामहः", snippet: "I am the father of this world, the mother, the dispenser of the fruits of actions, and the grandfather; the one thing to be known, the purifier, the sacred monosyllable (Om),…", sanskrit: "पिताऽहमस्य जगतो माता धाता पितामहः ।\nवेद्यं पवित्रमोंकार ऋक् साम यजुरेव च ॥", iast: "pitā’hamasya jagato mātā dhātā pitāmahaḥ |\nvedyaṃ pavitramoṃkāra ṛk sāma yajureva ca ||", transliteration: "pitāham asya jagato mātā dhātā pitāmahaḥ\nvedyaṁ pavitram oṁkāra ṛik sāma yajur eva cha", translation_en: "I am the father of this world, the mother, the dispenser of the fruits of actions, and the grandfather; the one thing to be known, the purifier, the sacred monosyllable (Om), and also the Rik, Sama, and Yajur Vedas.", translation_hi: "मैं ही इस जगत् का पिता, माता, धाता (धारण करने वाला) और पितामह हूँमैं वेद्य (जानने योग्य) वस्तु हूँ, पवित्र, ओंकार, ऋग्वेद, सामवेद और यजुर्वेद भी मैं ही हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_017.mp3"},
  {id: "BG_9.18", label: "BG 9.18", ref: "9.18", chapter: 9, verse: 18, speaker: "krishna", canonical: true, meter: "anustubh", sa: "गतिर्भर्ता प्रभुः साक्षी निवासः शरणं सुहृत्", snippet: "I am the goal, the supporter, the Lord, the witness, the abode, the shelter, the friend, the origin, the dissolution, the foundation, the treasure-house, and the imperishable seed.", sanskrit: "गतिर्भर्ता प्रभुः साक्षी निवासः शरणं सुहृत् ।\nप्रभवः प्रलयः स्थानं निधानं बीजमव्ययम् ॥", iast: "gatirbhartā prabhuḥ sākṣī nivāsaḥ śaraṇaṃ suhṛt |\nprabhavaḥ pralayaḥ sthānaṃ nidhānaṃ bījamavyayam ||", transliteration: "gatir bhartā prabhuḥ sākṣhī nivāsaḥ śharaṇaṁ suhṛit\nprabhavaḥ pralayaḥ sthānaṁ nidhānaṁ bījam avyayam", translation_en: "I am the goal, the supporter, the Lord, the witness, the abode, the shelter, the friend, the origin, the dissolution, the foundation, the treasure-house, and the imperishable seed.", translation_hi: "गति (लक्ष्य), भरण-पोषण करने वाला, प्रभु (स्वामी), साक्षी, निवास, शरणस्थान तथा मित्र और उत्पत्ति, प्रलयरूप तथा स्थान (आधार), निधान और अव्यय कारण भी मैं हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_018.mp3"},
  {id: "BG_9.19", label: "BG 9.19", ref: "9.19", chapter: 9, verse: 19, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तपाम्यहमहं वर्षं निगृह्णाम्युत्सृजामि च", snippet: "As the sun, I give heat; I withhold and send forth the rain; I am immortality and also death, existence and non-existence, O Arjuna.", sanskrit: "तपाम्यहमहं वर्षं निगृह्णाम्युत्सृजामि च ।\nअमृतं चैव मृत्युश्च सदसच्चाहमर्जुन ॥", iast: "tapāmyahamahaṃ varṣaṃ nigṛhṇāmyutsṛjāmi ca |\namṛtaṃ caiva mṛtyuśca sadasaccāhamarjuna ||", transliteration: "tapāmyaham ahaṁ varṣhaṁ nigṛihṇāmyutsṛijāmi cha\namṛitaṁ chaiva mṛityuśh cha sad asach chāham arjuna", translation_en: "As the sun, I give heat; I withhold and send forth the rain; I am immortality and also death, existence and non-existence, O Arjuna.", translation_hi: "हे अर्जुन ! मैं ही (सूर्य रूप में) तपता हूँ; मैं वर्षा का निग्रह और उत्सर्जन करता हूँ। मैं ही अमृत और मृत्यु एवं सत् और असत् हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_019.mp3"},
  {id: "BG_9.20", label: "BG 9.20", ref: "9.20", chapter: 9, verse: 20, speaker: "krishna", canonical: true, meter: "tristubh", sa: "त्रैविद्या मां सोमपाः पूतपापा", snippet: "The knowers of the three Vedas, the drinkers of Soma, purified of all sins, worshipping Me through sacrifices, pray for the way to heaven; they reach the holy world of the Lord…", sanskrit: "त्रैविद्या मां सोमपाः पूतपापा\nयज्ञैरिष्ट्वा स्वर्गतिं प्रार्थयन्ते ।\nते पुण्यमासाद्य सुरेन्द्रलोक\nमश्नन्ति दिव्यान्दिवि देवभोगान् ॥", iast: "traividyā māṃ somapāḥ pūtapāpā\nyajñairiṣṭvā svargatiṃ prārthayante |\nte puṇyamāsādya surendraloka\nmaśnanti divyāndivi devabhogān ||", transliteration: "trai-vidyā māṁ soma-pāḥ pūta-pāpā\nyajñair iṣhṭvā svar-gatiṁ prārthayante\nte puṇyam āsādya surendra-lokam\naśhnanti divyān divi deva-bhogān", translation_en: "The knowers of the three Vedas, the drinkers of Soma, purified of all sins, worshipping Me through sacrifices, pray for the way to heaven; they reach the holy world of the Lord of the gods and enjoy the divine pleasures of the gods in heaven.", translation_hi: "तीनों वेदों के ज्ञाता (वेदोक्त सकाम कर्म करने वाले), सोमपान करने वाले एवं पापों से पवित्र हुए पुरुष मुझे यज्ञों के द्वारा पूजकर स्वर्ग प्राप्ति चाहते हैं; वे पुरुष अपने पुण्यों के फलरूप इन्द्रलोक को प्राप्त कर स्वर्ग में दिव्य देवताओं के भोग भोगते हैं।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_020.mp3"},
  {id: "BG_9.21", label: "BG 9.21", ref: "9.21", chapter: 9, verse: 21, speaker: "krishna", canonical: true, meter: "tristubh", sa: "ते तं भुक्त्वा स्वर्गलोकं विशालं", snippet: "They, having enjoyed the vast heaven, enter the world of mortals when their merit is exhausted; thus abiding by the injunctions of the three (Vedas) and desiring objects of…", sanskrit: "ते तं भुक्त्वा स्वर्गलोकं विशालं\nक्षीणे पुण्ये मर्त्यलोकं विशन्ति ।\nएव त्रयीधर्ममनुप्रपन्ना\nगतागतं कामकामा लभन्ते ॥", iast: "te taṃ bhuktvā svargalokaṃ viśālaṃ\nkṣīṇe puṇye martyalokaṃ viśanti |\neva trayīdharmamanuprapannā\ngatāgataṃ kāmakāmā labhante ||", transliteration: "te taṁ bhuktvā swarga-lokaṁ viśhālaṁ\nkṣhīṇe puṇye martya-lokaṁ viśhanti\nevaṁ trayī-dharmam anuprapannā\ngatāgataṁ kāma-kāmā labhante", translation_en: "They, having enjoyed the vast heaven, enter the world of mortals when their merit is exhausted; thus abiding by the injunctions of the three (Vedas) and desiring objects of desires, they attain to the state of coming and going.", translation_hi: "वे उस विशाल स्वर्गलोक को भोगकर, पुण्यक्षीण होने पर, मृत्युलोक को प्राप्त होते हैं। इस प्रकार तीनों वेदों में कहे गये कर्म के शरण हुए और भोगों की कामना वाले पुरुष आवागमन (गतागत) को प्राप्त होते हैं।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_021.mp3"},
  {id: "BG_9.22", label: "BG 9.22", ref: "9.22", chapter: 9, verse: 22, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अनन्याश्चिन्तयन्तो मां ये जनाः पर्युपासते", snippet: "For those men who worship Me alone, thinking of no one else, for those ever-united, I secure what they have not already possessed and preserve what they already possess.", sanskrit: "अनन्याश्चिन्तयन्तो मां ये जनाः पर्युपासते ।\nतेषां नित्याभियुक्तानां योगक्षेमं वहाम्यहम् ॥", iast: "ananyāścintayanto māṃ ye janāḥ paryupāsate |\nteṣāṃ nityābhiyuktānāṃ yogakṣemaṃ vahāmyaham ||", transliteration: "ananyāśh chintayanto māṁ ye janāḥ paryupāsate\nteṣhāṁ nityābhiyuktānāṁ yoga-kṣhemaṁ vahāmyaham", translation_en: "For those men who worship Me alone, thinking of no one else, for those ever-united, I secure what they have not already possessed and preserve what they already possess.", translation_hi: "अनन्य भाव से मेरा चिन्तन करते हुए जो भक्तजन मेरी ही उपासना करते हैं, उन नित्ययुक्त पुरुषों का योगक्षेम मैं वहन करता हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_022.mp3"},
  {id: "BG_9.23", label: "BG 9.23", ref: "9.23", chapter: 9, verse: 23, speaker: "krishna", canonical: true, meter: "anustubh", sa: "येऽप्यन्यदेवता भक्ता यजन्ते श्रद्धयाऽन्विताः", snippet: "Even those devotees who, endowed with faith, worship other gods, worship Me alone, O Arjuna, but by the wrong method.", sanskrit: "येऽप्यन्यदेवता भक्ता यजन्ते श्रद्धयाऽन्विताः ।\nतेऽपि मामेव कौन्तेय यजन्त्यविधिपूर्वकम् ॥", iast: "ye’pyanyadevatā bhaktā yajante śraddhayā’nvitāḥ |\nte’pi māmeva kaunteya yajantyavidhipūrvakam ||", transliteration: "ye ’pyanya-devatā-bhaktā yajante śhraddhayānvitāḥ\nte ’pi mām eva kaunteya yajantyavidhi-pūrvakam", translation_en: "Even those devotees who, endowed with faith, worship other gods, worship Me alone, O Arjuna, but by the wrong method.", translation_hi: "हे कौन्तेय ! श्रद्धा से युक्त जो भक्त अन्य देवताओं को पूजते हैं, वे भी मुझे ही अविधिपूर्वक पूजते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_023.mp3"},
  {id: "BG_9.24", label: "BG 9.24", ref: "9.24", chapter: 9, verse: 24, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अहं हि सर्वयज्ञानां भोक्ता च प्रभुरेव च", snippet: "For I alone am the enjoyer and Lord of all sacrifices; but they do not know Me in reality, and thus they return to this mortal world.", sanskrit: "अहं हि सर्वयज्ञानां भोक्ता च प्रभुरेव च ।\nन तु मामभिजानन्ति तत्त्वेनातश्च्यवन्ति ते ॥", iast: "ahaṃ hi sarvayajñānāṃ bhoktā ca prabhureva ca |\nna tu māmabhijānanti tattvenātaścyavanti te ||", transliteration: "ahaṁ hi sarva-yajñānāṁ bhoktā cha prabhureva cha\nna tu mām abhijānanti tattvenātaśh chyavanti te", translation_en: "For I alone am the enjoyer and Lord of all sacrifices; but they do not know Me in reality, and thus they return to this mortal world.", translation_hi: "क्योंकि सब यज्ञों का भोक्ता और स्वामी मैं ही हूँ, परन्तु वे मुझे तत्त्वत: नहीं जानते हैं, इसलिए वे गिरते हैं, अर्थात् संसार को प्राप्त होते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_024.mp3"},
  {id: "BG_9.25", label: "BG 9.25", ref: "9.25", chapter: 9, verse: 25, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यान्ति देवव्रता देवान् पितृ़न्यान्ति पितृव्रताः", snippet: "The worshippers of the gods go to them; the ancestor-worshippers go to the manes; the worshippers of the deities who preside over the elements go to them; but My devotees come…", sanskrit: "यान्ति देवव्रता देवान् पितृ़न्यान्ति पितृव्रताः ।\nभूतानि यान्ति भूतेज्या यान्ति मद्याजिनोऽपि माम् ॥", iast: "yānti devavratā devān pitṛnyānti pitṛvratāḥ |\nbhūtāni yānti bhūtejyā yānti madyājino’pi mām ||", transliteration: "yānti deva-vratā devān pitṝīn yānti pitṛi-vratāḥ\nbhūtāni yānti bhūtejyā yānti mad-yājino ’pi mām", translation_en: "The worshippers of the gods go to them; the ancestor-worshippers go to the manes; the worshippers of the deities who preside over the elements go to them; but My devotees come to Me.", translation_hi: "देवताओं के पूजक देवताओं को प्राप्त होते हैं, पितरपूजक पितरों को जाते हैं, भूतों का यजन करने वाले भूतों को प्राप्त होते हैं और मुझे पूजने वाले भक्त मुझे ही प्राप्त होते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_025.mp3"},
  {id: "BG_9.26", label: "BG 9.26", ref: "9.26", chapter: 9, verse: 26, speaker: "krishna", canonical: true, meter: "anustubh", sa: "पत्रं पुष्पं फलं तोयं यो मे भक्त्या प्रयच्छति", snippet: "Whoever offers Me with devotion a leaf, a flower, a fruit, or a little water, that, so offered devotedly by the pure-minded, I accept.", sanskrit: "पत्रं पुष्पं फलं तोयं यो मे भक्त्या प्रयच्छति ।\nतदहं भक्त्युपहृतमश्नामि प्रयतात्मनः ॥", iast: "patraṃ puṣpaṃ phalaṃ toyaṃ yo me bhaktyā prayacchati |\ntadahaṃ bhaktyupahṛtamaśnāmi prayatātmanaḥ ||", transliteration: "patraṁ puṣhpaṁ phalaṁ toyaṁ yo me bhaktyā prayachchhati\ntadahaṁ bhaktyupahṛitam aśhnāmi prayatātmanaḥ", translation_en: "Whoever offers Me with devotion a leaf, a flower, a fruit, or a little water, that, so offered devotedly by the pure-minded, I accept.", translation_hi: "जो कोई भी भक्त मेरे लिए पत्र, पुष्प, फल, जल आदि भक्ति से अर्पण करता है, उस शुद्ध मन के भक्त का वह भक्तिपूर्वक अर्पण किया हुआ (पत्र पुष्पादि) मैं भोगता हूँ अर्थात् स्वीकार करता हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_026.mp3"},
  {id: "BG_9.27", label: "BG 9.27", ref: "9.27", chapter: 9, verse: 27, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यत्करोषि यदश्नासि यज्जुहोषि ददासि यत्", snippet: "Whatever you do, whatever you eat, whatever you offer in sacrifice, whatever you give, whatever austerity you practice, O Arjuna, do it as an offering to Me.", sanskrit: "यत्करोषि यदश्नासि यज्जुहोषि ददासि यत् ।\nयत्तपस्यसि कौन्तेय तत्कुरुष्व मदर्पणम् ॥", iast: "yatkaroṣi yadaśnāsi yajjuhoṣi dadāsi yat |\nyattapasyasi kaunteya tatkuruṣva madarpaṇam ||", transliteration: "yat karoṣhi yad aśhnāsi yaj juhoṣhi dadāsi yat\nyat tapasyasi kaunteya tat kuruṣhva mad-arpaṇam", translation_en: "Whatever you do, whatever you eat, whatever you offer in sacrifice, whatever you give, whatever austerity you practice, O Arjuna, do it as an offering to Me.", translation_hi: "हे कौन्तेय ! तुम जो कुछ कर्म करते हो, जो कुछ खाते हो, जो कुछ हवन करते हो, जो कुछ दान देते हो और जो कुछ तप करते हो, वह सब तुम मुझे अर्पण करो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_027.mp3"},
  {id: "BG_9.28", label: "BG 9.28", ref: "9.28", chapter: 9, verse: 28, speaker: "krishna", canonical: true, meter: "anustubh", sa: "शुभाशुभफलैरेवं मोक्ष्यसे कर्मबन्धनैः", snippet: "Thus, you shall be freed from the bonds of actions yielding good and evil fruits; with the mind steadfast in the Yoga of renunciation, and liberated, you shall come to Me.", sanskrit: "शुभाशुभफलैरेवं मोक्ष्यसे कर्मबन्धनैः ।\nसंन्यासयोगयुक्तात्मा विमुक्तो मामुपैष्यसि ॥", iast: "śubhāśubhaphalairevaṃ mokṣyase karmabandhanaiḥ |\nsaṃnyāsayogayuktātmā vimukto māmupaiṣyasi ||", transliteration: "śhubhāśhubha-phalair evaṁ mokṣhyase karma-bandhanaiḥ\nsannyāsa-yoga-yuktātmā vimukto mām upaiṣhyasi", translation_en: "Thus, you shall be freed from the bonds of actions yielding good and evil fruits; with the mind steadfast in the Yoga of renunciation, and liberated, you shall come to Me.", translation_hi: "इस प्रकार तुम शुभाशुभ फलस्वरूप कर्मबन्धनों से मुक्त हो जाओगे; और संन्यासयोग से युक्तचित्त हुए तुम विमुक्त होकर मुझे ही प्राप्त हो जाओगे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_028.mp3"},
  {id: "BG_9.29", label: "BG 9.29", ref: "9.29", chapter: 9, verse: 29, speaker: "krishna", canonical: true, meter: "anustubh", sa: "समोऽहं सर्वभूतेषु न मे द्वेष्योऽस्ति न प्रियः", snippet: "I am the same to all beings; there is none hateful or dear to Me; but those who worship Me with devotion are in Me, and I am also in them.", sanskrit: "समोऽहं सर्वभूतेषु न मे द्वेष्योऽस्ति न प्रियः ।\nये भजन्ति तु मां भक्त्या मयि ते तेषु चाप्यहम् ॥", iast: "samo’haṃ sarvabhūteṣu na me dveṣyo’sti na priyaḥ |\nye bhajanti tu māṃ bhaktyā mayi te teṣu cāpyaham ||", transliteration: "samo ’haṁ sarva-bhūteṣhu na me dveṣhyo ’sti na priyaḥ\nye bhajanti tu māṁ bhaktyā mayi te teṣhu chāpyaham", translation_en: "I am the same to all beings; there is none hateful or dear to Me; but those who worship Me with devotion are in Me, and I am also in them.", translation_hi: "मैं समस्त भूतों में सम हूँ; न कोई मुझे अप्रिय है और न प्रिय; परन्तु जो मुझे भक्तिपूर्वक भजते हैं, वे मुझमें और मैं भी उनमें हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_029.mp3"},
  {id: "BG_9.30", label: "BG 9.30", ref: "9.30", chapter: 9, verse: 30, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अपि चेत्सुदुराचारो भजते मामनन्यभाक्", snippet: "Even if the most sinful worships Me, with devotion to no one else, he should indeed be regarded as righteous, for he has rightly resolved.", sanskrit: "अपि चेत्सुदुराचारो भजते मामनन्यभाक् ।\nसाधुरेव स मन्तव्यः सम्यग्व्यवसितो हि सः ॥", iast: "api cetsudurācāro bhajate māmananyabhāk |\nsādhureva sa mantavyaḥ samyagvyavasito hi saḥ ||", transliteration: "api chet su-durāchāro bhajate mām ananya-bhāk\nsādhur eva sa mantavyaḥ samyag vyavasito hi saḥ", translation_en: "Even if the most sinful worships Me, with devotion to no one else, he should indeed be regarded as righteous, for he has rightly resolved.", translation_hi: "यदि कोई अतिशय दुराचारी भी अनन्यभाव से मेरा भक्त होकर मुझे भजता है, वह साधु ही मानने योग्य है, क्योंकि वह यथार्थ निश्चय वाला है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_030.mp3"},
  {id: "BG_9.31", label: "BG 9.31", ref: "9.31", chapter: 9, verse: 31, speaker: "krishna", canonical: true, meter: "anustubh", sa: "क्षिप्रं भवति धर्मात्मा शश्वच्छान्तिं निगच्छति", snippet: "Soon he becomes righteous and attains eternal peace; O Arjuna, proclaim thou for certain that My devotee never perishes.", sanskrit: "क्षिप्रं भवति धर्मात्मा शश्वच्छान्तिं निगच्छति ।\nकौन्तेय प्रतिजानीहि न मे भक्तः प्रणश्यति ॥", iast: "kṣipraṃ bhavati dharmātmā śaśvacchāntiṃ nigacchati |\nkaunteya pratijānīhi na me bhaktaḥ praṇaśyati ||", transliteration: "kṣhipraṁ bhavati dharmātmā śhaśhvach-chhāntiṁ nigachchhati\nkaunteya pratijānīhi na me bhaktaḥ praṇaśhyati", translation_en: "Soon he becomes righteous and attains eternal peace; O Arjuna, proclaim thou for certain that My devotee never perishes.", translation_hi: "हे कौन्तेय, वह शीघ्र ही धर्मात्मा बन जाता है और शाश्वत शान्ति को प्राप्त होता है। तुम निश्चयपूर्वक सत्य जानो कि मेरा भक्त कभी नष्ट नहीं होता।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_031.mp3"},
  {id: "BG_9.32", label: "BG 9.32", ref: "9.32", chapter: 9, verse: 32, speaker: "krishna", canonical: true, meter: "anustubh", sa: "मां हि पार्थ व्यपाश्रित्य येऽपि स्युः पापयोनयः", snippet: "For, taking refuge in Me, they who, O Arjuna, may be of a sinful birth—women, Vaisyas, and Sudras—attain the Supreme Goal.", sanskrit: "मां हि पार्थ व्यपाश्रित्य येऽपि स्युः पापयोनयः ।\nस्त्रियो वैश्यास्तथा शूद्रास्तेऽपि यान्ति परां गतिम् ॥", iast: "māṃ hi pārtha vyapāśritya ye’pi syuḥ pāpayonayaḥ |\nstriyo vaiśyāstathā śūdrāste’pi yānti parāṃ gatim ||", transliteration: "māṁ hi pārtha vyapāśhritya ye ’pi syuḥ pāpa-yonayaḥ\nstriyo vaiśhyās tathā śhūdrās te ’pi yānti parāṁ gatim", translation_en: "For, taking refuge in Me, they who, O Arjuna, may be of a sinful birth—women, Vaisyas, and Sudras—attain the Supreme Goal.", translation_hi: "हे पार्थ ! स्त्री, वैश्य और शूद्र ये जो कोई पापयोनि वाले हों, वे भी मुझ पर आश्रित (मेरे शरण) होकर परम गति को प्राप्त होते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_032.mp3"},
  {id: "BG_9.33", label: "BG 9.33", ref: "9.33", chapter: 9, verse: 33, speaker: "krishna", canonical: true, meter: "anustubh", sa: "किं पुनर्ब्राह्मणाः पुण्या भक्ता राजर्षयस्तथा", snippet: "How much more easily, then, do Brahmins and devoted royal saints attain the goal? Having come to this impermanent and unhappy world, do thou worship Me.", sanskrit: "किं पुनर्ब्राह्मणाः पुण्या भक्ता राजर्षयस्तथा ।\nअनित्यमसुखं लोकमिमं प्राप्य भजस्व माम् ॥", iast: "kiṃ punarbrāhmaṇāḥ puṇyā bhaktā rājarṣayastathā |\nanityamasukhaṃ lokamimaṃ prāpya bhajasva mām ||", transliteration: "kiṁ punar brāhmaṇāḥ puṇyā bhaktā rājarṣhayas tathā\nanityam asukhaṁ lokam imaṁ prāpya bhajasva mām", translation_en: "How much more easily, then, do Brahmins and devoted royal saints attain the goal? Having come to this impermanent and unhappy world, do thou worship Me.", translation_hi: "फिर क्या कहना है कि पुण्यशील ब्राह्मण और राजर्षि भक्तजन (परम गति को प्राप्त होते हैं); (इसलिए) इस अनित्य और सुखरहित लोक को प्राप्त होकर (अब) तुम भक्तिपूर्वक मेरी ही पूजा करो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_033.mp3"},
  {id: "BG_9.34", label: "BG 9.34", ref: "9.34", chapter: 9, verse: 34, speaker: "krishna", canonical: true, meter: "anustubh", sa: "मन्मना भव मद्भक्तो मद्याजी मां नमस्कुरु", snippet: "Fix your mind on Me; be devoted to Me; sacrifice to Me; bow down to Me; having thus united your whole self to Me, taking Me as the supreme goal, you will come to Me.", sanskrit: "मन्मना भव मद्भक्तो मद्याजी मां नमस्कुरु ।\nमामेवैष्यसि युक्त्वैवमात्मानं मत्परायणः ॥", iast: "manmanā bhava madbhakto madyājī māṃ namaskuru |\nmāmevaiṣyasi yuktvaivamātmānaṃ matparāyaṇaḥ ||", transliteration: "man-manā bhava mad-bhakto mad-yājī māṁ namaskuru\nmām evaiṣhyasi yuktvaivam ātmānaṁ mat-parāyaṇaḥ", translation_en: "Fix your mind on Me; be devoted to Me; sacrifice to Me; bow down to Me; having thus united your whole self to Me, taking Me as the supreme goal, you will come to Me.", translation_hi: "(तुम) मुझमें स्थिर मन वाले बनो; मेरे भक्त और मेरे पूजन करने वाले बनो; मुझे नमस्कार करो; इस प्रकार मत्परायण (अर्थात् मैं ही जिसका परम लक्ष्य हूँ ऐसे) होकर आत्मा को मुझसे युक्त करके तुम मुझे ही प्राप्त होओगे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/009_034.mp3"},
  {id: "BG_10.1", label: "BG 10.1", ref: "10.1", chapter: 10, verse: 1, speaker: "krishna", canonical: true, meter: "anustubh", sa: "भूय एव महाबाहो श्रृणु मे परमं वचः", snippet: "The Blessed Lord said, Again, O mighty-armed Arjuna, listen to my supreme word which I will declare to you, who are beloved, for your welfare.", sanskrit: "भूय एव महाबाहो श्रृणु मे परमं वचः ।\nयत्तेऽहं प्रीयमाणाय वक्ष्यामि हितकाम्यया ॥", iast: "bhūya eva mahābāho śrṛṇu me paramaṃ vacaḥ |\nyatte’haṃ prīyamāṇāya vakṣyāmi hitakāmyayā ||", transliteration: "bhūya eva mahā-bāho śhṛiṇu me paramaṁ vachaḥ\nyatte ’haṁ prīyamāṇāya vakṣhyāmi hita-kāmyayā", translation_en: "The Blessed Lord said, Again, O mighty-armed Arjuna, listen to my supreme word which I will declare to you, who are beloved, for your welfare.", translation_hi: "श्रीभगवान् ने कहा -- हे महाबाहो ! पुन: तुम मेरे परम वचनों का श्रवण करो, जो मैं तुझ अतिशय प्रेम रखने वाले के लिये हित की इच्छा से कहूँगा।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_001.mp3"},
  {id: "BG_10.2", label: "BG 10.2", ref: "10.2", chapter: 10, verse: 2, speaker: "krishna", canonical: true, meter: "anustubh", sa: "न मे विदुः सुरगणाः प्रभवं न महर्षयः", snippet: "Neither the hosts of the gods nor the great sages know My origin; for I am the source of all the gods and the great sages in every way.", sanskrit: "न मे विदुः सुरगणाः प्रभवं न महर्षयः ।\nअहमादिर्हि देवानां महर्षीणां च सर्वशः ॥", iast: "na me viduḥ suragaṇāḥ prabhavaṃ na maharṣayaḥ |\nahamādirhi devānāṃ maharṣīṇāṃ ca sarvaśaḥ ||", transliteration: "na me viduḥ sura-gaṇāḥ prabhavaṁ na maharṣhayaḥ\naham ādir hi devānāṁ maharṣhīṇāṁ cha sarvaśhaḥ", translation_en: "Neither the hosts of the gods nor the great sages know My origin; for I am the source of all the gods and the great sages in every way.", translation_hi: "मेरी उत्पत्ति (प्रभव) को न देवतागण जानते हैं और न महर्षिजन; क्योंकि मैं सब प्रकार से देवताओं और महर्षियों का भी आदिकारण हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_002.mp3"},
  {id: "BG_10.3", label: "BG 10.3", ref: "10.3", chapter: 10, verse: 3, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यो मामजमनादिं च वेत्ति लोकमहेश्वरम्", snippet: "He who knows Me as unborn and beginningless, as the great Lord of the worlds, he among mortals is undeluded and is liberated from all sins.", sanskrit: "यो मामजमनादिं च वेत्ति लोकमहेश्वरम् ।\nअसम्मूढः स मर्त्येषु सर्वपापैः प्रमुच्यते ॥", iast: "yo māmajamanādiṃ ca vetti lokamaheśvaram |\nasammūḍhaḥ sa martyeṣu sarvapāpaiḥ pramucyate ||", transliteration: "yo māmajam anādiṁ cha vetti loka-maheśhvaram\nasammūḍhaḥ sa martyeṣhu sarva-pāpaiḥ pramuchyate", translation_en: "He who knows Me as unborn and beginningless, as the great Lord of the worlds, he among mortals is undeluded and is liberated from all sins.", translation_hi: "जो मुझे अजन्मा, अनादि और लोकों के महान् ईश्वर के रूप में जानता है, र्मत्य मनुष्यों में ऐसा संमोहरहित (ज्ञानी) पुरुष सब पापों से मुक्त हो जाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_003.mp3"},
  {id: "BG_10.4", label: "BG 10.4", ref: "10.4", chapter: 10, verse: 4, speaker: "krishna", canonical: true, meter: "anustubh", sa: "बुद्धिर्ज्ञानमसंमोहः क्षमा सत्यं दमः शमः", snippet: "Intellect, wisdom, non-delusion, forgiveness, truth, self-restraint, calmness, happiness, pain, existence or birth, non-existence or death, fear, and also fearlessness.", sanskrit: "बुद्धिर्ज्ञानमसंमोहः क्षमा सत्यं दमः शमः ।\nसुखं दुःखं भवोऽभावो भयं चाभयमेव च ॥", iast: "buddhirjñānamasaṃmohaḥ kṣamā satyaṃ damaḥ śamaḥ |\nsukhaṃ duḥkhaṃ bhavo’bhāvo bhayaṃ cābhayameva ca ||", transliteration: "buddhir jñānam asammohaḥ kṣhamā satyaṁ damaḥ śhamaḥ\nsukhaṁ duḥkhaṁ bhavo ’bhāvo bhayaṁ chābhayameva cha", translation_en: "Intellect, wisdom, non-delusion, forgiveness, truth, self-restraint, calmness, happiness, pain, existence or birth, non-existence or death, fear, and also fearlessness.", translation_hi: "बुद्धि, ज्ञान, मोह का अभाव, क्षमा, सत्य, दम (इन्द्रिय संयम), शम (मन: संयम), सुख, दु:ख, जन्म और मृत्यु, भय और अभय।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_004.mp3"},
  {id: "BG_10.5", label: "BG 10.5", ref: "10.5", chapter: 10, verse: 5, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अहिंसा समता तुष्टिस्तपो दानं यशोऽयशः", snippet: "Non-injury, equanimity, contentment, austerity, beneficence, fame, and ill-fame—these different qualities of beings arise from Me alone.", sanskrit: "अहिंसा समता तुष्टिस्तपो दानं यशोऽयशः ।\nभवन्ति भावा भूतानां मत्त एव पृथग्विधाः ॥", iast: "ahiṃsā samatā tuṣṭistapo dānaṃ yaśo’yaśaḥ |\nbhavanti bhāvā bhūtānāṃ matta eva pṛthagvidhāḥ ||", transliteration: "ahiṁsā   samatā  tuṣṭis tapo dānaṁ   yaśo    'yaśaḥ  bhavanti    bhāvā   bhūtānāṁ    matta   eva pṛthag-vidhāḥ", translation_en: "Non-injury, equanimity, contentment, austerity, beneficence, fame, and ill-fame—these different qualities of beings arise from Me alone.", translation_hi: "अहिंसा, समता, सन्तोष, तप, दान. यश और अपयश ऐसे ये प्राणियों के नानाविध भाव मुझ से ही प्रकट होते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_005.mp3"},
  {id: "BG_10.6", label: "BG 10.6", ref: "10.6", chapter: 10, verse: 6, speaker: "krishna", canonical: true, meter: "anustubh", sa: "महर्षयः सप्त पूर्वे चत्वारो मनवस्तथा", snippet: "The seven great sages, the ancient four, and the Manus, possessing powers like Mine (due to their minds being fixed on Me), were born from My mind; from them, these creatures…", sanskrit: "महर्षयः सप्त पूर्वे चत्वारो मनवस्तथा ।\nमद्भावा मानसा जाता येषां लोक इमाः प्रजाः ॥", iast: "maharṣayaḥ sapta pūrve catvāro manavastathā |\nmadbhāvā mānasā jātā yeṣāṃ loka imāḥ prajāḥ ||", transliteration: "maharṣhayaḥ sapta pūrve chatvāro manavas tathā\nmad-bhāvā mānasā jātā yeṣhāṁ loka imāḥ prajāḥ", translation_en: "The seven great sages, the ancient four, and the Manus, possessing powers like Mine (due to their minds being fixed on Me), were born from My mind; from them, these creatures have been born in this world.", translation_hi: "सात महर्षिजन, पूर्वकाल के चार (सनकादि) तथा (चौदह) मनु ये मेरे प्रभाव वाले मेरे संकल्प से उत्पन्न हुए हैं, जिनकी संसार (लोक) में यह प्रजा है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_006.mp3"},
  {id: "BG_10.7", label: "BG 10.7", ref: "10.7", chapter: 10, verse: 7, speaker: "krishna", canonical: true, meter: "anustubh", sa: "एतां विभूतिं योगं च मम यो वेत्ति तत्त्वतः", snippet: "He who truly knows these manifold manifestations of My Being and this Yoga-power of Mine, becomes established in unshakable Yoga; there is no doubt about it.", sanskrit: "एतां विभूतिं योगं च मम यो वेत्ति तत्त्वतः ।\nसोऽविकम्पेन योगेन युज्यते नात्र संशयः ॥", iast: "etāṃ vibhūtiṃ yogaṃ ca mama yo vetti tattvataḥ |\nso’vikampena yogena yujyate nātra saṃśayaḥ ||", transliteration: "etāṁ vibhūtiṁ yogaṁ cha mama yo vetti tattvataḥ\nso ’vikampena yogena yujyate nātra sanśhayaḥ", translation_en: "He who truly knows these manifold manifestations of My Being and this Yoga-power of Mine, becomes established in unshakable Yoga; there is no doubt about it.", translation_hi: "जो पुरुष इस मेरी विभूति और योग को तत्त्व से जानता है, वह पुरुष अविकम्प योग (अर्थात् निश्चल ध्यान योग) से युक्त हो जाता है, इसमें कुछ भी संशय नहीं है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_007.mp3"},
  {id: "BG_10.8", label: "BG 10.8", ref: "10.8", chapter: 10, verse: 8, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अहं सर्वस्य प्रभवो मत्तः सर्वं प्रवर्तते", snippet: "I am the source of all; from me everything evolves; Understanding this, the wise, endowed with meditation, worship me.", sanskrit: "अहं सर्वस्य प्रभवो मत्तः सर्वं प्रवर्तते ।\nइति मत्वा भजन्ते मां बुधा भावसमन्विताः ॥", iast: "ahaṃ sarvasya prabhavo mattaḥ sarvaṃ pravartate |\niti matvā bhajante māṃ budhā bhāvasamanvitāḥ ||", transliteration: "ahaṁ sarvasya prabhavo mattaḥ sarvaṁ pravartate\niti matvā bhajante māṁ budhā bhāva-samanvitāḥ", translation_en: "I am the source of all; from me everything evolves; Understanding this, the wise, endowed with meditation, worship me.", translation_hi: "मैं ही सबका प्रभव स्थान हूँ; मुझसे ही सब (जगत्) विकास को प्राप्त होता है, इस प्रकार जानकर बुधजन भक्ति भाव से युक्त होकर मुझे ही भजते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_008.mp3"},
  {id: "BG_10.9", label: "BG 10.9", ref: "10.9", chapter: 10, verse: 9, speaker: "krishna", canonical: true, meter: "anustubh", sa: "मच्चित्ता मद्गतप्राणा बोधयन्तः परस्परम्", snippet: "With their minds and lives wholly absorbed in Me, they enlighten each other and ever speak of Me, being satisfied and delighted.", sanskrit: "मच्चित्ता मद्गतप्राणा बोधयन्तः परस्परम् ।\nकथयन्तश्च मां नित्यं तुष्यन्ति च रमन्ति च ॥", iast: "maccittā madgataprāṇā bodhayantaḥ parasparam |\nkathayantaśca māṃ nityaṃ tuṣyanti ca ramanti ca ||", transliteration: "mach-chittā mad-gata-prāṇā bodhayantaḥ parasparam\nkathayantaśh cha māṁ nityaṁ tuṣhyanti cha ramanti cha", translation_en: "With their minds and lives wholly absorbed in Me, they enlighten each other and ever speak of Me, being satisfied and delighted.", translation_hi: "मुझमें ही चित्त को स्थिर करने वाले और मुझमें ही प्राणों (इन्द्रियों) को अर्पित करने वाले भक्तजन, सदैव परस्पर मेरा बोध कराते हुए, मेरे ही विषय में कथन करते हुए सन्तुष्ट होते हैं और रमते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_009.mp3"},
  {id: "BG_10.10", label: "BG 10.10", ref: "10.10", chapter: 10, verse: 10, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तेषां सततयुक्तानां भजतां प्रीतिपूर्वकम्", snippet: "To those who are ever steadfast, worshipping me with love, I give the yoga of discrimination, by which they come to me.", sanskrit: "तेषां सततयुक्तानां भजतां प्रीतिपूर्वकम् ।\nददामि बुद्धियोगं तं येन मामुपयान्ति ते ॥", iast: "teṣāṃ satatayuktānāṃ bhajatāṃ prītipūrvakam |\ndadāmi buddhiyogaṃ taṃ yena māmupayānti te ||", transliteration: "teṣhāṁ satata-yuktānāṁ bhajatāṁ prīti-pūrvakam\ndadāmi buddhi-yogaṁ taṁ yena mām upayānti te", translation_en: "To those who are ever steadfast, worshipping me with love, I give the yoga of discrimination, by which they come to me.", translation_hi: "उन (मुझ से) नित्य युक्त हुए और प्रेमपूर्वक मेरा भजन करने वाले भक्तों को, मैं वह 'बुद्धियोग' देता हूँ जिससे वे मुझे प्राप्त होते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_010.mp3"},
  {id: "BG_10.11", label: "BG 10.11", ref: "10.11", chapter: 10, verse: 11, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तेषामेवानुकम्पार्थमहमज्ञानजं तमः", snippet: "Out of mere compassion for them, I, dwelling within their selves, destroy the darkness born of ignorance with the luminous lamp of knowledge.", sanskrit: "तेषामेवानुकम्पार्थमहमज्ञानजं तमः ।\nनाशयाम्यात्मभावस्थो ज्ञानदीपेन भास्वता ॥", iast: "teṣāmevānukampārthamahamajñānajaṃ tamaḥ |\nnāśayāmyātmabhāvastho jñānadīpena bhāsvatā ||", transliteration: "teṣhām evānukampārtham aham ajñāna-jaṁ tamaḥ\nnāśhayāmyātma-bhāva-stho jñāna-dīpena bhāsvatā", translation_en: "Out of mere compassion for them, I, dwelling within their selves, destroy the darkness born of ignorance with the luminous lamp of knowledge.", translation_hi: "उनके ऊपर अनुग्रह करने के लिए मैं उनके अन्त:करण में स्थित होकर, अज्ञानजनित अन्धकार को प्रकाशमय ज्ञान के दीपक द्वारा नष्ट करता हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_011.mp3"},
  {id: "BG_10.12", label: "BG 10.12", ref: "10.12", chapter: 10, verse: 12, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "परं ब्रह्म परं धाम पवित्रं परमं भवान्", snippet: "Arjuna said, \"You are the Supreme Brahman, the supreme abode, the supreme purifier, eternal, divine Person, the primeval God, unborn, and omnipresent.\"", sanskrit: "परं ब्रह्म परं धाम पवित्रं परमं भवान् ।\nपुरुषं शाश्वतं दिव्यमादिदेवमजं विभुम् ॥", iast: "paraṃ brahma paraṃ dhāma pavitraṃ paramaṃ bhavān |\npuruṣaṃ śāśvataṃ divyamādidevamajaṃ vibhum ||", transliteration: "paraṁ brahma paraṁ dhāma pavitraṁ paramaṁ bhavān\npuruṣhaṁ śhāśhvataṁ divyam ādi-devam ajaṁ vibhum", translation_en: "Arjuna said, \"You are the Supreme Brahman, the supreme abode, the supreme purifier, eternal, divine Person, the primeval God, unborn, and omnipresent.\"", translation_hi: "अर्जुन ने कहा आप -परम ब्रह्म, परम धाम और परम पवित्र हंै; सनातन दिव्य पुरुष, देवों के भी आदि देव, जन्म रहित और सर्वव्यापी हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_012.mp3"},
  {id: "BG_10.13", label: "BG 10.13", ref: "10.13", chapter: 10, verse: 13, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "आहुस्त्वामृषयः सर्वे देवर्षिर्नारदस्तथा", snippet: "All the sages have thus declared Thee, as also the divine sage Narada; so also Asita, Devala, and Vyasa; and now Thou Thyself dost say so to me.", sanskrit: "आहुस्त्वामृषयः सर्वे देवर्षिर्नारदस्तथा ।\nअसितो देवलो व्यासः स्वयं चैव ब्रवीषि मे ॥", iast: "āhustvāmṛṣayaḥ sarve devarṣirnāradastathā |\nasito devalo vyāsaḥ svayaṃ caiva bravīṣi me ||", transliteration: "āhus tvām ṛiṣhayaḥ sarve devarṣhir nāradas tathā\nasito devalo vyāsaḥ svayaṁ chaiva bravīṣhi me", translation_en: "All the sages have thus declared Thee, as also the divine sage Narada; so also Asita, Devala, and Vyasa; and now Thou Thyself dost say so to me.", translation_hi: "ऐसा आपको समस्त ऋषिजन कहते हैं;  वैसे ही देवर्षि नारद, असित, देवल ऋषि तथा व्यास और स्वयं आप भी मेरे प्रति कहते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_013.mp3"},
  {id: "BG_10.14", label: "BG 10.14", ref: "10.14", chapter: 10, verse: 14, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "सर्वमेतदृतं मन्ये यन्मां वदसि केशव", snippet: "I believe all that You have said to me to be true, O Krishna; indeed, O blessed Lord! Neither the gods nor the demons know Your manifestation (origin).", sanskrit: "सर्वमेतदृतं मन्ये यन्मां वदसि केशव ।\nन हि ते भगवन् व्यक्तिं विदुर्देवा न दानवाः ॥", iast: "sarvametadṛtaṃ manye yanmāṃ vadasi keśava |\nna hi te bhagavan vyaktiṃ vidurdevā na dānavāḥ ||", transliteration: "sarvam etad ṛitaṁ manye yan māṁ vadasi keśhava\nna hi te bhagavan vyaktiṁ vidur devā na dānavāḥ", translation_en: "I believe all that You have said to me to be true, O Krishna; indeed, O blessed Lord! Neither the gods nor the demons know Your manifestation (origin).", translation_hi: "हे केशव ! जो कुछ भी आप मेरे प्रति कहते हैं, इस सबको मैं सत्य मानता हूँ। हे भगवन्, आपके (वास्तविक) स्वरूप को न देवता जानते हैं और न दानव।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_014.mp3"},
  {id: "BG_10.15", label: "BG 10.15", ref: "10.15", chapter: 10, verse: 15, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "स्वयमेवात्मनाऽत्मानं वेत्थ त्वं पुरुषोत्तम", snippet: "Verily, Thou Thyself knowest Thyself by Thyself, O Supreme Person, O source and Lord of all beings, O God of gods, O ruler of the world!", sanskrit: "स्वयमेवात्मनाऽत्मानं वेत्थ त्वं पुरुषोत्तम ।\nभूतभावन भूतेश देवदेव जगत्पते ॥", iast: "svayamevātmanā’tmānaṃ vettha tvaṃ puruṣottama |\nbhūtabhāvana bhūteśa devadeva jagatpate ||", transliteration: "swayam evātmanātmānaṁ vettha tvaṁ puruṣhottama\nbhūta-bhāvana bhūteśha deva-deva jagat-pate", translation_en: "Verily, Thou Thyself knowest Thyself by Thyself, O Supreme Person, O source and Lord of all beings, O God of gods, O ruler of the world!", translation_hi: "हे पुरुषोत्तम ! हे भूतभावन ! हे भूतेश ! हे देवों के देव ! हे जगत् के स्वामी ! आप स्वयं ही अपने आप को जानते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_015.mp3"},
  {id: "BG_10.16", label: "BG 10.16", ref: "10.16", chapter: 10, verse: 16, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "वक्तुमर्हस्यशेषेण दिव्या ह्यात्मविभूतयः", snippet: "You should indeed tell, without reserve, of your divine glories by which you exist, pervading all these worlds. (No one else can do so.)", sanskrit: "वक्तुमर्हस्यशेषेण दिव्या ह्यात्मविभूतयः ।\nयाभिर्विभूतिभिर्लोकानिमांस्त्वं व्याप्य तिष्ठसि ॥", iast: "vaktumarhasyaśeṣeṇa divyā hyātmavibhūtayaḥ |\nyābhirvibhūtibhirlokānimāṃstvaṃ vyāpya tiṣṭhasi ||", transliteration: "vaktum arhasyaśheṣheṇa divyā hyātma-vibhūtayaḥ\nyābhir vibhūtibhir lokān imāṁs tvaṁ vyāpya tiṣhṭhasi", translation_en: "You should indeed tell, without reserve, of your divine glories by which you exist, pervading all these worlds. (No one else can do so.)", translation_hi: "आप ही उन अपनी दिव्य विभूतियों को अशेषत: कहने के लिए योग्य हैं, जिन विभूतियों के द्वारा इन समस्त लोकों को आप व्याप्त करके स्थित हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_016.mp3"},
  {id: "BG_10.17", label: "BG 10.17", ref: "10.17", chapter: 10, verse: 17, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "कथं विद्यामहं योगिंस्त्वां सदा परिचिन्तयन्", snippet: "How shall I, ever meditating, know you, O Yogin? In what aspects or things, O blessed Lord, should I think of you?", sanskrit: "कथं विद्यामहं योगिंस्त्वां सदा परिचिन्तयन् ।\nकेषु केषु च भावेषु चिन्त्योऽसि भगवन्मया ॥", iast: "kathaṃ vidyāmahaṃ yogiṃstvāṃ sadā paricintayan |\nkeṣu keṣu ca bhāveṣu cintyo’si bhagavanmayā ||", transliteration: "kathaṁ vidyām ahaṁ yogins tvāṁ sadā parichintayan\nkeṣhu keṣhu cha bhāveṣhu chintyo ’si bhagavan mayā", translation_en: "How shall I, ever meditating, know you, O Yogin? In what aspects or things, O blessed Lord, should I think of you?", translation_hi: "हे योगेश्वर ! मैं किस प्रकार निरन्तर चिन्तन करता हुआ आपको जानूँ, और हे भगवन् ! आप किनकिन भावों में मेरे द्वारा चिन्तन करने योग्य हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_017.mp3"},
  {id: "BG_10.18", label: "BG 10.18", ref: "10.18", chapter: 10, verse: 18, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "विस्तरेणात्मनो योगं विभूतिं च जनार्दन", snippet: "Tell me again in detail, O Krishna, of your yogic power and glory; for I am not satiated with what I have heard of your life-giving and nectar-like speech.", sanskrit: "विस्तरेणात्मनो योगं विभूतिं च जनार्दन ।\nभूयः कथय तृप्तिर्हि श्रृण्वतो नास्ति मेऽमृतम् ॥", iast: "vistareṇātmano yogaṃ vibhūtiṃ ca janārdana |\nbhūyaḥ kathaya tṛptirhi śrṛṇvato nāsti me’mṛtam ||", transliteration: "vistareṇātmano yogaṁ vibhūtiṁ cha janārdana\nbhūyaḥ kathaya tṛiptir hi śhṛiṇvato nāsti me ’mṛitam", translation_en: "Tell me again in detail, O Krishna, of your yogic power and glory; for I am not satiated with what I have heard of your life-giving and nectar-like speech.", translation_hi: "हे जनार्दन ! अपनी योग शक्ति और विभूति को पुन: विस्तारपूर्वक कहिए, क्योंकि आपके अमृतमय वचनों को सुनते हुए मुझे तृप्ति नहीं होती।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_018.mp3"},
  {id: "BG_10.19", label: "BG 10.19", ref: "10.19", chapter: 10, verse: 19, speaker: "krishna", canonical: true, meter: "anustubh", sa: "हन्त ते कथयिष्यामि दिव्या ह्यात्मविभूतयः", snippet: "The Blessed Lord said, \"Very well! Now I will declare to you My divine glories in their prominence, O Arjuna; there is no end to their detailed description.\"", sanskrit: "हन्त ते कथयिष्यामि दिव्या ह्यात्मविभूतयः ।\nप्राधान्यतः कुरुश्रेष्ठ नास्त्यन्तो विस्तरस्य मे ॥", iast: "hanta te kathayiṣyāmi divyā hyātmavibhūtayaḥ |\nprādhānyataḥ kuruśreṣṭha nāstyanto vistarasya me ||", transliteration: "hanta te kathayiṣhyāmi divyā hyātma-vibhūtayaḥ\nprādhānyataḥ kuru-śhreṣhṭha nāstyanto vistarasya me", translation_en: "The Blessed Lord said, \"Very well! Now I will declare to you My divine glories in their prominence, O Arjuna; there is no end to their detailed description.\"", translation_hi: "श्रीभगवान् ने कहा -हन्त अब मैं तुम्हें अपनी दिव्य विभूतियों को प्रधानता से कहूँगा। हे कुरुश्रेष्ठ मेरे विस्तार का अन्त नहीं है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_019.mp3"},
  {id: "BG_10.20", label: "BG 10.20", ref: "10.20", chapter: 10, verse: 20, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अहमात्मा गुडाकेश सर्वभूताशयस्थितः", snippet: "I am the Self, O Gudakesa, seated in the hearts of all beings; I am the beginning, the middle, and the end of all beings.", sanskrit: "अहमात्मा गुडाकेश सर्वभूताशयस्थितः ।\nअहमादिश्च मध्यं च भूतानामन्त एव च ॥", iast: "ahamātmā guḍākeśa sarvabhūtāśayasthitaḥ |\nahamādiśca madhyaṃ ca bhūtānāmanta eva ca ||", transliteration: "aham ātmā guḍākeśha sarva-bhūtāśhaya-sthitaḥ\naham ādiśh cha madhyaṁ cha bhūtānām anta eva cha", translation_en: "I am the Self, O Gudakesa, seated in the hearts of all beings; I am the beginning, the middle, and the end of all beings.", translation_hi: "हे गुडाकेश (निद्राजित्) ! मैं समस्त भूतों के हृदय में स्थित सबकी आत्मा हूँ तथा सम्पूर्ण भूतों का आदि, मध्य और अन्त भी मैं ही हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_020.mp3"},
  {id: "BG_10.21", label: "BG 10.21", ref: "10.21", chapter: 10, verse: 21, speaker: "krishna", canonical: true, meter: "anustubh", sa: "आदित्यानामहं विष्णुर्ज्योतिषां रविरंशुमान्", snippet: "Among the twelve Adityas, I am Vishnu; among luminaries, the radiant sun; among the seven or forty-nine Maruts, I am Marichi; among stars, I am the moon.", sanskrit: "आदित्यानामहं विष्णुर्ज्योतिषां रविरंशुमान् ।\nमरीचिर्मरुतामस्मि नक्षत्राणामहं शशी ॥", iast: "ādityānāmahaṃ viṣṇurjyotiṣāṃ raviraṃśumān |\nmarīcirmarutāmasmi nakṣatrāṇāmahaṃ śaśī ||", transliteration: "ādityānām ahaṁ viṣhṇur jyotiṣhāṁ ravir anśhumān\nmarīchir marutām asmi nakṣhatrāṇām ahaṁ śhaśhī", translation_en: "Among the twelve Adityas, I am Vishnu; among luminaries, the radiant sun; among the seven or forty-nine Maruts, I am Marichi; among stars, I am the moon.", translation_hi: "मैं (बारह) आदित्यों में विष्णु और ज्योतियों में अंशुमान् सूर्य हूँ; मैं (उनचास) मरुतों (वायु देवताओं) में मरीचि हूँ और नक्षत्रों में शशी (चन्द्रमा) हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_021.mp3"},
  {id: "BG_10.22", label: "BG 10.22", ref: "10.22", chapter: 10, verse: 22, speaker: "krishna", canonical: true, meter: "anustubh", sa: "वेदानां सामवेदोऽस्मि देवानामस्मि वासवः", snippet: "Among the Vedas, I am the Sama-Veda; among the gods, I am Vasava; among the senses, I am the mind; and among living beings, I am intelligence.", sanskrit: "वेदानां सामवेदोऽस्मि देवानामस्मि वासवः ।\nइन्द्रियाणां मनश्चास्मि भूतानामस्मि चेतना ॥", iast: "vedānāṃ sāmavedo’smi devānāmasmi vāsavaḥ |\nindriyāṇāṃ manaścāsmi bhūtānāmasmi cetanā ||", transliteration: "vedānāṁ sāma-vedo ’smi devānām asmi vāsavaḥ\nindriyāṇāṁ manaśh chāsmi bhūtānām asmi chetanā", translation_en: "Among the Vedas, I am the Sama-Veda; among the gods, I am Vasava; among the senses, I am the mind; and among living beings, I am intelligence.", translation_hi: "मैं वेदों में सामवेद हूँ, देवों में वासव (इन्द्र) हूँ; मैं इन्द्रियों में मन और भूतप्राणियों में चेतना (ज्ञानशक्ति) हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_022.mp3"},
  {id: "BG_10.23", label: "BG 10.23", ref: "10.23", chapter: 10, verse: 23, speaker: "krishna", canonical: true, meter: "anustubh", sa: "रुद्राणां शङ्करश्चास्मि वित्तेशो यक्षरक्षसाम्", snippet: "And among the Rudras, I am Sankara; among the Yakshas and Rakshasas, the Lord of Wealth (Kubera); among the Vasus, I am Pavaka (Fire); and among the seven mountains, I am Meru.", sanskrit: "रुद्राणां शङ्करश्चास्मि वित्तेशो यक्षरक्षसाम् ।\nवसूनां पावकश्चास्मि मेरुः शिखरिणामहम् ॥", iast: "rudrāṇāṃ śaṅkaraścāsmi vitteśo yakṣarakṣasām |\nvasūnāṃ pāvakaścāsmi meruḥ śikhariṇāmaham ||", transliteration: "rudrāṇāṁ śhaṅkaraśh chāsmi vitteśho yakṣha-rakṣhasām\nvasūnāṁ pāvakaśh chāsmi meruḥ śhikhariṇām aham", translation_en: "And among the Rudras, I am Sankara; among the Yakshas and Rakshasas, the Lord of Wealth (Kubera); among the Vasus, I am Pavaka (Fire); and among the seven mountains, I am Meru.", translation_hi: "मैं (ग्यारह) रुद्रों में शंकर हूँ और यक्ष तथा राक्षसों में धनपति कुबेर (वित्तेश) हूँ; (आठ) वसुओं में अग्नि हूँ तथा शिखर वाले पर्वतों में मेरु हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_023.mp3"},
  {id: "BG_10.24", label: "BG 10.24", ref: "10.24", chapter: 10, verse: 24, speaker: "krishna", canonical: true, meter: "anustubh", sa: "पुरोधसां च मुख्यं मां विद्धि पार्थ बृहस्पतिम्", snippet: "And, among the household priests of kings, O Arjuna, know Me to be the chief, Brihaspati; among the army generals, I am Skanda; among lakes, I am the ocean.", sanskrit: "पुरोधसां च मुख्यं मां विद्धि पार्थ बृहस्पतिम् ।\nसेनानीनामहं स्कन्दः सरसामस्मि सागरः ॥", iast: "purodhasāṃ ca mukhyaṃ māṃ viddhi pārtha bṛhaspatim |\nsenānīnāmahaṃ skandaḥ sarasāmasmi sāgaraḥ ||", transliteration: "purodhasāṁ cha mukhyaṁ māṁ viddhi pārtha bṛihaspatim\nsenānīnām ahaṁ skandaḥ sarasām asmi sāgaraḥ", translation_en: "And, among the household priests of kings, O Arjuna, know Me to be the chief, Brihaspati; among the army generals, I am Skanda; among lakes, I am the ocean.", translation_hi: "हे पार्थ ! पुरोहितों में मुझे बृहस्पति जानो; मैं सेनापतियों में स्कन्द और जलाशयों में समुद्र हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_024.mp3"},
  {id: "BG_10.25", label: "BG 10.25", ref: "10.25", chapter: 10, verse: 25, speaker: "krishna", canonical: true, meter: "anustubh", sa: "महर्षीणां भृगुरहं गिरामस्म्येकमक्षरम्", snippet: "Among the great sages, I am Bhrigu; among words, I am the one syllable (Om); among sacrifices, I am the sacrifice of silent repetition; among the immovable things, I am the…", sanskrit: "महर्षीणां भृगुरहं गिरामस्म्येकमक्षरम् ।\nयज्ञानां जपयज्ञोऽस्मि स्थावराणां हिमालयः ॥", iast: "maharṣīṇāṃ bhṛgurahaṃ girāmasmyekamakṣaram |\nyajñānāṃ japayajño’smi sthāvarāṇāṃ himālayaḥ ||", transliteration: "maharṣhīṇāṁ bhṛigur ahaṁ girām asmyekam akṣharam\nyajñānāṁ japa-yajño ’smi sthāvarāṇāṁ himālayaḥ", translation_en: "Among the great sages, I am Bhrigu; among words, I am the one syllable (Om); among sacrifices, I am the sacrifice of silent repetition; among the immovable things, I am the Himalayas.", translation_hi: "मैं महर्षियों में भृगु और वाणी (शब्दों) में एकाक्षर ओंकार हूँ। मैं यज्ञों में जपयज्ञ और स्थावरों (अचलों) में हिमालय हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_025.mp3"},
  {id: "BG_10.26", label: "BG 10.26", ref: "10.26", chapter: 10, verse: 26, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अश्वत्थः सर्ववृक्षाणां देवर्षीणां च नारदः", snippet: "Among all the trees, I am the Peepul; among the divine sages, I am Narada; among the Gandharvas, I am Chitraratha; among the perfected, I am the sage Kapila.", sanskrit: "अश्वत्थः सर्ववृक्षाणां देवर्षीणां च नारदः ।\nगन्धर्वाणां चित्ररथः सिद्धानां कपिलो मुनिः ॥", iast: "aśvatthaḥ sarvavṛkṣāṇāṃ devarṣīṇāṃ ca nāradaḥ |\ngandharvāṇāṃ citrarathaḥ siddhānāṃ kapilo muniḥ ||", transliteration: "aśhvatthaḥ sarva-vṛikṣhāṇāṁ devarṣhīṇāṁ cha nāradaḥ\ngandharvāṇāṁ chitrarathaḥ siddhānāṁ kapilo muniḥ", translation_en: "Among all the trees, I am the Peepul; among the divine sages, I am Narada; among the Gandharvas, I am Chitraratha; among the perfected, I am the sage Kapila.", translation_hi: "मैं समस्त वृक्षों में अश्वत्थ (पीपल) हूँ और देवर्षियों में नारद हूँ; मैं गन्धर्वों में चित्ररथ और सिद्ध पुरुषों में कपिल मुनि हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_026.mp3"},
  {id: "BG_10.27", label: "BG 10.27", ref: "10.27", chapter: 10, verse: 27, speaker: "krishna", canonical: true, meter: "anustubh", sa: "उच्चैःश्रवसमश्वानां विद्धि माममृतोद्भवम्", snippet: "Know Me as Ucchaisravas, born of nectar, among horses; Airavata among lordly elephants; and the king among men.", sanskrit: "उच्चैःश्रवसमश्वानां विद्धि माममृतोद्भवम् ।\nऐरावतं गजेन्द्राणां नराणां च नराधिपम् ॥", iast: "uccaiḥśravasamaśvānāṃ viddhi māmamṛtodbhavam |\nairāvataṃ gajendrāṇāṃ narāṇāṃ ca narādhipam ||", transliteration: "uchchaiḥśhravasam aśhvānāṁ viddhi mām amṛitodbhavam\nairāvataṁ gajendrāṇāṁ narāṇāṁ cha narādhipam", translation_en: "Know Me as Ucchaisravas, born of nectar, among horses; Airavata among lordly elephants; and the king among men.", translation_hi: "अश्वों में अमृत से उत्पन्न हुए उच्चैश्रवा नामक अश्व, हाथियों में ऐरावत और मनुष्यों में राजा मुझे ही जानो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_027.mp3"},
  {id: "BG_10.28", label: "BG 10.28", ref: "10.28", chapter: 10, verse: 28, speaker: "krishna", canonical: true, meter: "anustubh", sa: "आयुधानामहं वज्रं धेनूनामस्मि कामधुक्", snippet: "Among weapons, I am the thunderbolt; among cows, I am the wish-fulfilling cow called Kamadhenu; I am the progenitor, the god of love; among serpents, I am Vasuki.", sanskrit: "आयुधानामहं वज्रं धेनूनामस्मि कामधुक् ।\nप्रजनश्चास्मि कन्दर्पः सर्पाणामस्मि वासुकिः ॥", iast: "āyudhānāmahaṃ vajraṃ dhenūnāmasmi kāmadhuk |\nprajanaścāsmi kandarpaḥ sarpāṇāmasmi vāsukiḥ ||", transliteration: "āyudhānām ahaṁ vajraṁ dhenūnām asmi kāmadhuk\nprajanaśh chāsmi kandarpaḥ sarpāṇām asmi vāsukiḥ", translation_en: "Among weapons, I am the thunderbolt; among cows, I am the wish-fulfilling cow called Kamadhenu; I am the progenitor, the god of love; among serpents, I am Vasuki.", translation_hi: "मैं शस्त्रों में वज्र और धेनुओं (गायों) में कामधेनु हूँ, प्रजा उत्पत्ति का हेतु कन्दर्प (कामदेव) मैं हूँ और सर्पों में वासुकि हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_028.mp3"}
] AS row
MERGE (n:Verse {id: row.id}) SET n += row;

UNWIND [
  {id: "BG_10.29", label: "BG 10.29", ref: "10.29", chapter: 10, verse: 29, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अनन्तश्चास्मि नागानां वरुणो यादसामहम्", snippet: "I am Ananta among the Nagas; I am Varuna among water-deities; Aryaman among the Manes; I am Yama among the governors.", sanskrit: "अनन्तश्चास्मि नागानां वरुणो यादसामहम् ।\nपितृ़णामर्यमा चास्मि यमः संयमतामहम् ॥", iast: "anantaścāsmi nāgānāṃ varuṇo yādasāmaham |\npitṛṇāmaryamā cāsmi yamaḥ saṃyamatāmaham ||", transliteration: "anantaśh chāsmi nāgānāṁ varuṇo yādasām aham\npitṝīṇām aryamā chāsmi yamaḥ sanyamatām aham", translation_en: "I am Ananta among the Nagas; I am Varuna among water-deities; Aryaman among the Manes; I am Yama among the governors.", translation_hi: "मैं नागों में अनन्त (शेषनाग) हूँ और जल देवताओं में वरुण हूँ; मैं पितरों में अर्यमा हँ और नियमन करने वालों में यम हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_029.mp3"},
  {id: "BG_10.30", label: "BG 10.30", ref: "10.30", chapter: 10, verse: 30, speaker: "krishna", canonical: true, meter: "anustubh", sa: "प्रह्लादश्चास्मि दैत्यानां कालः कलयतामहम्", snippet: "And I am Prahlada among the demons, I am Time among reckoners, I am the lion among beasts, and Vainateya (Garuda) among birds.", sanskrit: "प्रह्लादश्चास्मि दैत्यानां कालः कलयतामहम् ।\nमृगाणां च मृगेन्द्रोऽहं वैनतेयश्च पक्षिणाम् ॥", iast: "prahlādaścāsmi daityānāṃ kālaḥ kalayatāmaham |\nmṛgāṇāṃ ca mṛgendro’haṃ vainateyaśca pakṣiṇām ||", transliteration: "prahlādaśh chāsmi daityānāṁ kālaḥ kalayatām aham\nmṛigāṇāṁ cha mṛigendro ’haṁ vainateyaśh cha pakṣhiṇām", translation_en: "And I am Prahlada among the demons, I am Time among reckoners, I am the lion among beasts, and Vainateya (Garuda) among birds.", translation_hi: "मैं दैत्यों में प्रह्लाद और गणना करने वालों में काल हूँ, मैं 'पशुओं' में सिंह (मृगेन्द्र) और पक्षियों में गरुड़ हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_030.mp3"},
  {id: "BG_10.31", label: "BG 10.31", ref: "10.31", chapter: 10, verse: 31, speaker: "krishna", canonical: true, meter: "anustubh", sa: "पवनः पवतामस्मि रामः शस्त्रभृतामहम्", snippet: "Among the purifiers, I am the wind; among the warriors, I am Rama; among the fishes, I am the shark; among the streams, I am the Ganga.", sanskrit: "पवनः पवतामस्मि रामः शस्त्रभृतामहम् ।\nझषाणां मकरश्चास्मि स्रोतसामस्मि जाह्नवी ॥", iast: "pavanaḥ pavatāmasmi rāmaḥ śastrabhṛtāmaham |\njhaṣāṇāṃ makaraścāsmi srotasāmasmi jāhnavī ||", transliteration: "pavanaḥ pavatām asmi rāmaḥ śhastra-bhṛitām aham\njhaṣhāṇāṁ makaraśh chāsmi srotasām asmi jāhnavī", translation_en: "Among the purifiers, I am the wind; among the warriors, I am Rama; among the fishes, I am the shark; among the streams, I am the Ganga.", translation_hi: "मैं पवित्र करने वालों में वायु हूँ और शस्त्रधारियों में राम हूँ; तथा मत्स्यों (जलचरों) में मैं मगरमच्छ और नदियों में मैं गंगा हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_031.mp3"},
  {id: "BG_10.32", label: "BG 10.32", ref: "10.32", chapter: 10, verse: 32, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सर्गाणामादिरन्तश्च मध्यं चैवाहमर्जुन", snippet: "Among creations I am the beginning, the middle, and the end, O Arjuna; among the sciences, I am the science of the Self; and I am the logic among controversialists.", sanskrit: "सर्गाणामादिरन्तश्च मध्यं चैवाहमर्जुन ।\nअध्यात्मविद्या विद्यानां वादः प्रवदतामहम् ॥", iast: "sargāṇāmādirantaśca madhyaṃ caivāhamarjuna |\nadhyātmavidyā vidyānāṃ vādaḥ pravadatāmaham ||", transliteration: "sargāṇām ādir antaśh cha madhyaṁ chaivāham arjuna\nadhyātma-vidyā vidyānāṁ vādaḥ pravadatām aham", translation_en: "Among creations I am the beginning, the middle, and the end, O Arjuna; among the sciences, I am the science of the Self; and I am the logic among controversialists.", translation_hi: "हे अर्जुन ! सृष्टियों का आदि, अन्त और मध्य भी मैं ही हूँ, मैं विद्याओं में अध्यात्मविद्या और विवाद करने वालों में (अर्थात् विवाद के प्रकारों में) मैं वाद हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_032.mp3"},
  {id: "BG_10.33", label: "BG 10.33", ref: "10.33", chapter: 10, verse: 33, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अक्षराणामकारोऽस्मि द्वन्द्वः सामासिकस्य च", snippet: "Among the letters of the alphabet, I am the letter 'A' and the dual among compounds. I am verily the inexhaustible and everlasting time; I am the dispenser of the fruits of…", sanskrit: "अक्षराणामकारोऽस्मि द्वन्द्वः सामासिकस्य च ।\nअहमेवाक्षयः कालो धाताऽहं विश्वतोमुखः ॥", iast: "akṣarāṇāmakāro’smi dvandvaḥ sāmāsikasya ca |\nahamevākṣayaḥ kālo dhātā’haṃ viśvatomukhaḥ ||", transliteration: "अहमेवाक्षय: कालो धाताहं विश्वतोमुख: || 33||\nakṣharāṇām a-kāro ’smi dvandvaḥ sāmāsikasya cha\naham evākṣhayaḥ kālo dhātāhaṁ viśhvato-mukhaḥ", translation_en: "Among the letters of the alphabet, I am the letter 'A' and the dual among compounds. I am verily the inexhaustible and everlasting time; I am the dispenser of the fruits of actions, having faces in all directions.", translation_hi: "मैं अक्षरों (वर्णमाला) में अकार और समासों में द्वन्द्व (नामक समास) हूँ; मैं अक्षय काल और विश्वतोमुख (विराट् स्वरूप) धाता हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_033.mp3"},
  {id: "BG_10.34", label: "BG 10.34", ref: "10.34", chapter: 10, verse: 34, speaker: "krishna", canonical: true, meter: "anustubh", sa: "मृत्युः सर्वहरश्चाहमुद्भवश्च भविष्यताम्", snippet: "And I am the all-devouring Death, and the source of prosperity for those who are to be prosperous; among the feminine qualities, I am fame, prosperity, speech, memory,…", sanskrit: "मृत्युः सर्वहरश्चाहमुद्भवश्च भविष्यताम् ।\nकीर्तिः श्रीर्वाक्च नारीणां स्मृतिर्मेधा धृतिः क्षमा ॥", iast: "mṛtyuḥ sarvaharaścāhamudbhavaśca bhaviṣyatām |\nkīrtiḥ śrīrvākca nārīṇāṃ smṛtirmedhā dhṛtiḥ kṣamā ||", transliteration: "mṛityuḥ sarva-haraśh chāham udbhavaśh cha bhaviṣhyatām\nkīrtiḥ śhrīr vāk cha nārīṇāṁ smṛitir medhā dhṛitiḥ kṣhamā", translation_en: "And I am the all-devouring Death, and the source of prosperity for those who are to be prosperous; among the feminine qualities, I am fame, prosperity, speech, memory, intelligence, firmness, and forgiveness.", translation_hi: "मैं सर्वभक्षक मृत्यु और भविष्य में होने वालों की उत्पत्ति का कारण हूँ; स्त्रियों में कीर्ति, श्री, वाक (वाणी), स्मृति, मेधा, धृति और क्षमा हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_034.mp3"},
  {id: "BG_10.35", label: "BG 10.35", ref: "10.35", chapter: 10, verse: 35, speaker: "krishna", canonical: true, meter: "anustubh", sa: "बृहत्साम तथा साम्नां गायत्री छन्दसामहम्", snippet: "Among the hymns, I am the Brihatsaman; among meters, I am Gayatri; among months, I am Margasirsha; among seasons, I am the flowery season.", sanskrit: "बृहत्साम तथा साम्नां गायत्री छन्दसामहम् ।\nमासानां मार्गशीर्षोऽहमृतूनां कुसुमाकरः ॥", iast: "bṛhatsāma tathā sāmnāṃ gāyatrī chandasāmaham |\nmāsānāṃ mārgaśīrṣo’hamṛtūnāṃ kusumākaraḥ ||", transliteration: "bṛihat-sāma tathā sāmnāṁ gāyatrī chhandasām aham\nmāsānāṁ mārga-śhīrṣho ’ham ṛitūnāṁ kusumākaraḥ", translation_en: "Among the hymns, I am the Brihatsaman; among meters, I am Gayatri; among months, I am Margasirsha; among seasons, I am the flowery season.", translation_hi: "सामों (गेय मन्त्रों) में मैं बृहत्साम और छन्दों में गायत्री छन्द हूँ; मैं मासों में मार्गशीर्ष (दिसम्बरजनवरी के भाग) और ऋतुओं में वसन्त हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_035.mp3"},
  {id: "BG_10.36", label: "BG 10.36", ref: "10.36", chapter: 10, verse: 36, speaker: "krishna", canonical: true, meter: "anustubh", sa: "द्यूतं छलयतामस्मि तेजस्तेजस्विनामहम्", snippet: "I am the gambling of the deceitful; I am the splendor of the splendid; I am victory; I am the resolve of the resolute; I am the goodness of the good.", sanskrit: "द्यूतं छलयतामस्मि तेजस्तेजस्विनामहम् ।\nजयोऽस्मि व्यवसायोऽस्मि सत्त्वं सत्त्ववतामहम् ॥", iast: "dyūtaṃ chalayatāmasmi tejastejasvināmaham |\njayo’smi vyavasāyo’smi sattvaṃ sattvavatāmaham ||", transliteration: "dyūtaṁ chhalayatām asmi tejas tejasvinām aham\njayo ’smi vyavasāyo ’smi sattvaṁ sattvavatām aham", translation_en: "I am the gambling of the deceitful; I am the splendor of the splendid; I am victory; I am the resolve of the resolute; I am the goodness of the good.", translation_hi: "मैं छल करने वालों में द्यूत हूँ और तेजस्वियों में तेज हूँ, मैं विजय हूँ; मैं व्यवसाय (उद्यमशीलता) हूँ और सात्विक पुरुषों का सात्विक भाव हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_036.mp3"},
  {id: "BG_10.37", label: "BG 10.37", ref: "10.37", chapter: 10, verse: 37, speaker: "krishna", canonical: true, meter: "anustubh", sa: "वृष्णीनां वासुदेवोऽस्मि पाण्डवानां धनंजयः", snippet: "Among the Vrishnis, I am Vaasudeva; among the Pandavas, I am Arjuna; among the sages, I am Vyasa; among the poets, I am Usanas, the poet.", sanskrit: "वृष्णीनां वासुदेवोऽस्मि पाण्डवानां धनंजयः ।\nमुनीनामप्यहं व्यासः कवीनामुशना कविः ॥", iast: "vṛṣṇīnāṃ vāsudevo’smi pāṇḍavānāṃ dhanaṃjayaḥ |\nmunīnāmapyahaṃ vyāsaḥ kavīnāmuśanā kaviḥ ||", transliteration: "vṛiṣhṇīnāṁ vāsudevo ’smi pāṇḍavānāṁ dhanañjayaḥ\nmunīnām apyahaṁ vyāsaḥ kavīnām uśhanā kaviḥ", translation_en: "Among the Vrishnis, I am Vaasudeva; among the Pandavas, I am Arjuna; among the sages, I am Vyasa; among the poets, I am Usanas, the poet.", translation_hi: "मैं वृष्णियों में वासुदेव हूँ और पाण्डवों में धनंजय, मैं मुनियों में व्यास और कवियों में उशना कवि हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_037.mp3"},
  {id: "BG_10.38", label: "BG 10.38", ref: "10.38", chapter: 10, verse: 38, speaker: "krishna", canonical: true, meter: "anustubh", sa: "दण्डो दमयतामस्मि नीतिरस्मि जिगीषताम्", snippet: "Of those who punish, I am the scepter; among those who seek victory, I am statesmanship; and among secrets, I am silence; I am knowledge among knowers.", sanskrit: "दण्डो दमयतामस्मि नीतिरस्मि जिगीषताम् ।\nमौनं चैवास्मि गुह्यानां ज्ञानं ज्ञानवतामहम् ॥", iast: "daṇḍo damayatāmasmi nītirasmi jigīṣatām |\nmaunaṃ caivāsmi guhyānāṃ jñānaṃ jñānavatāmaham ||", transliteration: "daṇḍo damayatām asmi nītir asmi jigīṣhatām\nmaunaṁ chaivāsmi guhyānāṁ jñānaṁ jñānavatām aham", translation_en: "Of those who punish, I am the scepter; among those who seek victory, I am statesmanship; and among secrets, I am silence; I am knowledge among knowers.", translation_hi: "मैं दमन करने वालों का दण्ड हूँ और विजयेच्छुओं की नीति हूँ; मैं गुह्यों में मौन हूँ और ज्ञानवानों का ज्ञान हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_038.mp3"},
  {id: "BG_10.39", label: "BG 10.39", ref: "10.39", chapter: 10, verse: 39, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यच्चापि सर्वभूतानां बीजं तदहमर्जुन", snippet: "And whatever is the seed of all beings, that too am I, O Arjuna; there is no being, be it moving or unmoving, that can exist without Me.", sanskrit: "यच्चापि सर्वभूतानां बीजं तदहमर्जुन ।\nन तदस्ति विना यत्स्यान्मया भूतं चराचरम् ॥", iast: "yaccāpi sarvabhūtānāṃ bījaṃ tadahamarjuna |\nna tadasti vinā yatsyānmayā bhūtaṃ carācaram ||", transliteration: "yach chāpi sarva-bhūtānāṁ bījaṁ tad aham arjuna\nna tad asti vinā yat syān mayā bhūtaṁ charācharam", translation_en: "And whatever is the seed of all beings, that too am I, O Arjuna; there is no being, be it moving or unmoving, that can exist without Me.", translation_hi: "हे अर्जुन ! जो समस्त भूतों की उत्पत्ति का बीज (कारण) है, वह भी में ही हूँ, क्योंकि ऐसा कोई चर और अचर भूत नहीं है, जो मुझसे रहित है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_039.mp3"},
  {id: "BG_10.40", label: "BG 10.40", ref: "10.40", chapter: 10, verse: 40, speaker: "krishna", canonical: true, meter: "anustubh", sa: "नान्तोऽस्ति मम दिव्यानां विभूतीनां परंतप", snippet: "There is no end to My divine glories, O Arjuna, but this is a brief statement by Me of the particulars of My divine glory.", sanskrit: "नान्तोऽस्ति मम दिव्यानां विभूतीनां परंतप ।\nएष तूद्देशतः प्रोक्तो विभूतेर्विस्तरो मया ॥", iast: "nānto’sti mama divyānāṃ vibhūtīnāṃ paraṃtapa |\neṣa tūddeśataḥ prokto vibhūtervistaro mayā ||", transliteration: "nānto ’sti mama divyānāṁ vibhūtīnāṁ parantapa\neṣha tūddeśhataḥ prokto vibhūter vistaro mayā", translation_en: "There is no end to My divine glories, O Arjuna, but this is a brief statement by Me of the particulars of My divine glory.", translation_hi: "हे परन्तप ! मेरी दिव्य विभूतियों का अन्त नहीं है; अपनी विभूतियों का यह विस्तार मैंने एक देश से अर्थात् संक्षेप में कहा है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_040.mp3"},
  {id: "BG_10.41", label: "BG 10.41", ref: "10.41", chapter: 10, verse: 41, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यद्यद्विभूतिमत्सत्त्वं श्रीमदूर्जितमेव वा", snippet: "Whatever being there is glorious, prosperous, or powerful, know that to be a manifestation of a part of My splendor.", sanskrit: "यद्यद्विभूतिमत्सत्त्वं श्रीमदूर्जितमेव वा ।\nतत्तदेवावगच्छ त्वं मम तेजोंऽशसंभवम् ॥", iast: "yadyadvibhūtimatsattvaṃ śrīmadūrjitameva vā |\ntattadevāvagaccha tvaṃ mama tejoṃ’śasaṃbhavam ||", transliteration: "yad yad vibhūtimat sattvaṁ śhrīmad ūrjitam eva vā\ntat tad evāvagachchha tvaṁ mama tejo ’nśha-sambhavam", translation_en: "Whatever being there is glorious, prosperous, or powerful, know that to be a manifestation of a part of My splendor.", translation_hi: "जो कोई भी विभूतियुक्त, कान्तियुक्त अथवा शक्तियुक्त वस्तु (या प्राणी) है, उसको तुम मेरे तेज के अंश से ही उत्पन्न हुई जानो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_041.mp3"},
  {id: "BG_10.42", label: "BG 10.42", ref: "10.42", chapter: 10, verse: 42, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अथवा बहुनैतेन किं ज्ञातेन तवार्जुन", snippet: "But, of what avail is the knowledge of all these details to you, O Arjuna? I exist, supporting this whole world with one part of Myself.", sanskrit: "अथवा बहुनैतेन किं ज्ञातेन तवार्जुन ।\nविष्टभ्याहमिदं कृत्स्नमेकांशेन स्थितो जगत् ॥", iast: "athavā bahunaitena kiṃ jñātena tavārjuna |\nviṣṭabhyāhamidaṃ kṛtsnamekāṃśena sthito jagat ||", transliteration: "atha vā bahunaitena kiṁ jñātena tavārjuna\nviṣhṭabhyāham idaṁ kṛitsnam ekānśhena sthito jagat", translation_en: "But, of what avail is the knowledge of all these details to you, O Arjuna? I exist, supporting this whole world with one part of Myself.", translation_hi: "अथवा हे अर्जुन ! बहुत जानने से तुम्हारा क्या प्रयोजन है? मैं इस सम्पूर्ण जगत् को अपने एक अंश मात्र से धारण करके स्थित हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/010_042.mp3"},
  {id: "BG_11.1", label: "BG 11.1", ref: "11.1", chapter: 11, verse: 1, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "मदनुग्रहाय परमं गुह्यमध्यात्मसंज्ञितम्", snippet: "Arjuna said, By this explanation of the highest secret concerning the Self which Thou hast spoken, for the sake of blessing me, my delusion has been dispelled.", sanskrit: "मदनुग्रहाय परमं गुह्यमध्यात्मसंज्ञितम् ।\nयत्त्वयोक्तं वचस्तेन मोहोऽयं विगतो मम ॥", iast: "madanugrahāya paramaṃ guhyamadhyātmasaṃjñitam |\nyattvayoktaṃ vacastena moho’yaṃ vigato mama ||", transliteration: "mad-anugrahāya paramaṁ guhyam adhyātma-sanjñitam\nyat tvayoktaṁ vachas tena moho ’yaṁ vigato mama", translation_en: "Arjuna said, By this explanation of the highest secret concerning the Self which Thou hast spoken, for the sake of blessing me, my delusion has been dispelled.", translation_hi: "अर्जुन ने कहा -- मुझ पर अनुग्रह करने के लिए जो परम गोपनीय, अध्यात्मविषयक वचन (उपदेश) आपके द्वारा कहा गया, उससे मेरा मोह दूर हो गया है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_001.mp3"},
  {id: "BG_11.2", label: "BG 11.2", ref: "11.2", chapter: 11, verse: 2, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "भवाप्ययौ हि भूतानां श्रुतौ विस्तरशो मया", snippet: "The origin and destruction of beings have been heard in detail from You, O lotus-eyed Lord, and also Your inexhaustible greatness.", sanskrit: "भवाप्ययौ हि भूतानां श्रुतौ विस्तरशो मया ।\nत्वत्तः कमलपत्राक्ष माहात्म्यमपि चाव्ययम् ॥", iast: "bhavāpyayau hi bhūtānāṃ śrutau vistaraśo mayā |\ntvattaḥ kamalapatrākṣa māhātmyamapi cāvyayam ||", transliteration: "bhavāpyayau hi bhūtānāṁ śhrutau vistaraśho mayā\ntvattaḥ kamala-patrākṣha māhātmyam api chāvyayam", translation_en: "The origin and destruction of beings have been heard in detail from You, O lotus-eyed Lord, and also Your inexhaustible greatness.", translation_hi: "हे कमलनयन ! मैंने भूतों की उत्पत्ति और प्रलय आपसे विस्तारपूर्वक सुने हैं तथा आपका अव्यय माहात्म्य (प्रभाव) भी सुना है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_002.mp3"},
  {id: "BG_11.3", label: "BG 11.3", ref: "11.3", chapter: 11, verse: 3, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "एवमेतद्यथात्थ त्वमात्मानं परमेश्वर", snippet: "Now, O Supreme Lord, as Thou hast thus described Thyself, O Supreme Person, I wish to behold Thy divine form.", sanskrit: "एवमेतद्यथात्थ त्वमात्मानं परमेश्वर ।\nद्रष्टुमिच्छामि ते रूपमैश्वरं पुरुषोत्तम ॥", iast: "evametadyathāttha tvamātmānaṃ parameśvara |\ndraṣṭumicchāmi te rūpamaiśvaraṃ puruṣottama ||", transliteration: "evam etad yathāttha tvam ātmānaṁ parameśhvara\ndraṣhṭum ichchhāmi te rūpam aiśhwaraṁ puruṣhottama", translation_en: "Now, O Supreme Lord, as Thou hast thus described Thyself, O Supreme Person, I wish to behold Thy divine form.", translation_hi: "हे परमेश्वर ! आप अपने को जैसा कहते हो, यह ठीक ऐसा ही है। (परन्तु) हे पुरुषोत्तम ! मैं आपके ईश्वरीय रूप को प्रत्यक्ष देखना चाहता हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_003.mp3"},
  {id: "BG_11.4", label: "BG 11.4", ref: "11.4", chapter: 11, verse: 4, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "मन्यसे यदि तच्छक्यं मया द्रष्टुमिति प्रभो", snippet: "If Thou, O Lord, thinkest it possible for me to see it, do Thou, then, O Lord of the Yogis, show me Thy imperishable Self.", sanskrit: "मन्यसे यदि तच्छक्यं मया द्रष्टुमिति प्रभो ।\nयोगेश्वर ततो मे त्वं दर्शयाऽत्मानमव्ययम् ॥", iast: "manyase yadi tacchakyaṃ mayā draṣṭumiti prabho |\nyogeśvara tato me tvaṃ darśayā’tmānamavyayam ||", transliteration: "manyase yadi tach chhakyaṁ mayā draṣhṭum iti prabho\nyogeśhvara tato me tvaṁ darśhayātmānam avyayam", translation_en: "If Thou, O Lord, thinkest it possible for me to see it, do Thou, then, O Lord of the Yogis, show me Thy imperishable Self.", translation_hi: "हे प्रभो ! यदि आप मानते हैं कि मेरे द्वारा वह आपका रूप देखा जाना संभव है, तो हे योगेश्वर ! आप अपने अव्यय रूप का दर्शन कराइये।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_004.mp3"},
  {id: "BG_11.5", label: "BG 11.5", ref: "11.5", chapter: 11, verse: 5, speaker: "krishna", canonical: true, meter: "anustubh", sa: "पश्य मे पार्थ रूपाणि शतशोऽथ सहस्रशः", snippet: "The Blessed Lord said, \"Behold, O Arjuna, forms of Mine, by the hundreds and thousands, of different sorts, divine, and of various colors and shapes.\"", sanskrit: "पश्य मे पार्थ रूपाणि शतशोऽथ सहस्रशः ।\nनानाविधानि दिव्यानि नानावर्णाकृतीनि च ॥", iast: "paśya me pārtha rūpāṇi śataśo’tha sahasraśaḥ |\nnānāvidhāni divyāni nānāvarṇākṛtīni ca ||", transliteration: "paśhya me pārtha rūpāṇi śhataśho ’tha sahasraśhaḥ\nnānā-vidhāni divyāni nānā-varṇākṛitīni cha", translation_en: "The Blessed Lord said, \"Behold, O Arjuna, forms of Mine, by the hundreds and thousands, of different sorts, divine, and of various colors and shapes.\"", translation_hi: "श्रीभगवान् ने कहा -- हे पार्थ ! मेरे सैकड़ों तथा सहस्रों नाना प्रकार के और नाना वर्ण तथा आकृति वाले दिव्य रूपों को देखो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_005.mp3"},
  {id: "BG_11.6", label: "BG 11.6", ref: "11.6", chapter: 11, verse: 6, speaker: "krishna", canonical: true, meter: "anustubh", sa: "पश्यादित्यान्वसून्रुद्रानश्विनौ मरुतस्तथा", snippet: "Behold the Adityas, the Vasus, the Rudras, the two Asvins, and the Maruts; behold many wonders never before seen, O Arjuna.", sanskrit: "पश्यादित्यान्वसून्रुद्रानश्विनौ मरुतस्तथा ।\nबहून्यदृष्टपूर्वाणि पश्याऽश्चर्याणि भारत ॥", iast: "paśyādityānvasūnrudrānaśvinau marutastathā |\nbahūnyadṛṣṭapūrvāṇi paśyā’ścaryāṇi bhārata ||", transliteration: "paśhyādityān vasūn rudrān aśhvinau marutas tathā\nbahūny adṛiṣhṭa-pūrvāṇi paśhyāśhcharyāṇi bhārata", translation_en: "Behold the Adityas, the Vasus, the Rudras, the two Asvins, and the Maruts; behold many wonders never before seen, O Arjuna.", translation_hi: "हे भारत ! (मुझमें) आदित्यों, वसुओं, रुद्रों तथा अश्विनीकुमारों और मरुद्गणों को देखो, तथा और भी अनेक इसके पूर्व कभी न देखे हुए आश्चर्यों को देखो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_006.mp3"},
  {id: "BG_11.7", label: "BG 11.7", ref: "11.7", chapter: 11, verse: 7, speaker: "krishna", canonical: true, meter: "anustubh", sa: "इहैकस्थं जगत्कृत्स्नं पश्याद्य सचराचरम्", snippet: "Now, behold, O Arjuna, in this My body, the entire universe centered in one, including the moving and the unmoving, and whatever else you desire to see.", sanskrit: "इहैकस्थं जगत्कृत्स्नं पश्याद्य सचराचरम् ।\nमम देहे गुडाकेश यच्चान्यद्द्रष्टुमिच्छसि ॥", iast: "ihaikasthaṃ jagatkṛtsnaṃ paśyādya sacarācaram |\nmama dehe guḍākeśa yaccānyaddraṣṭumicchasi ||", transliteration: "ihaika-sthaṁ jagat kṛitsnaṁ paśhyādya sa-charācharam\nmama dehe guḍākeśha yach chānyad draṣhṭum ichchhasi", translation_en: "Now, behold, O Arjuna, in this My body, the entire universe centered in one, including the moving and the unmoving, and whatever else you desire to see.", translation_hi: "हे गुडाकेश ! आज (अब) इस मेरे शरीर में एक स्थान पर स्थित हुए चराचर सहित सम्पूर्ण जगत् को देखो तथा और भी जो कुछ तुम देखना चाहते हो, उसे भी देखो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_007.mp3"},
  {id: "BG_11.8", label: "BG 11.8", ref: "11.8", chapter: 11, verse: 8, speaker: "krishna", canonical: true, meter: "anustubh", sa: "न तु मां शक्यसे द्रष्टुमनेनैव स्वचक्षुषा", snippet: "But you are not able to behold Me with these your own eyes; I give you the divine eye; behold My lordly Yoga.", sanskrit: "न तु मां शक्यसे द्रष्टुमनेनैव स्वचक्षुषा ।\nदिव्यं ददामि ते चक्षुः पश्य मे योगमैश्वरम् ॥", iast: "na tu māṃ śakyase draṣṭumanenaiva svacakṣuṣā |\ndivyaṃ dadāmi te cakṣuḥ paśya me yogamaiśvaram ||", transliteration: "na tu māṁ śhakyase draṣhṭum anenaiva sva-chakṣhuṣhā\ndivyaṁ dadāmi te chakṣhuḥ paśhya me yogam aiśhwaram", translation_en: "But you are not able to behold Me with these your own eyes; I give you the divine eye; behold My lordly Yoga.", translation_hi: "परन्तु तुम अपने इन्हीं (प्राकृत) नेत्रों के द्वारा मुझे देखने में समर्थ नहीं हो; (इसलिए) मैं तुम्हें दिव्यचक्षु देता हूँ, जिससे तुम मेरे ईश्वरीय 'योग' को देखो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_008.mp3"},
  {id: "BG_11.9", label: "BG 11.9", ref: "11.9", chapter: 11, verse: 9, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "एवमुक्त्वा ततो राजन्महायोगेश्वरो हरिः", snippet: "Sanjaya said, Having thus spoken, O king, the great Lord of Yoga, Hari (Krishna), showed Arjuna His supreme form as the Lord.", sanskrit: "एवमुक्त्वा ततो राजन्महायोगेश्वरो हरिः ।\nदर्शयामास पार्थाय परमं रूपमैश्वरम् ॥", iast: "evamuktvā tato rājanmahāyogeśvaro hariḥ |\ndarśayāmāsa pārthāya paramaṃ rūpamaiśvaram ||", transliteration: "evam uktvā tato rājan mahā-yogeśhvaro hariḥ\ndarśhayām āsa pārthāya paramaṁ rūpam aiśhwaram", translation_en: "Sanjaya said, Having thus spoken, O king, the great Lord of Yoga, Hari (Krishna), showed Arjuna His supreme form as the Lord.", translation_hi: "संजय ने कहा -- हे राजन् ! महायोगेश्वर हरि ने इस प्रकार कहकर फिर अर्जुन के लिए परम ऐश्वर्ययुक्त रूप को दर्शाया।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_009.mp3"},
  {id: "BG_11.10", label: "BG 11.10", ref: "11.10", chapter: 11, verse: 10, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "अनेकवक्त्रनयनमनेकाद्भुतदर्शनम्", snippet: "With numerous mouths and eyes, with numerous wondrous sights, with numerous divine adornments, with numerous divine weapons uplifted, such a form He showed.", sanskrit: "अनेकवक्त्रनयनमनेकाद्भुतदर्शनम् ।\nअनेकदिव्याभरणं दिव्यानेकोद्यतायुधम् ॥", iast: "anekavaktranayanamanekādbhutadarśanam |\nanekadivyābharaṇaṃ divyānekodyatāyudham ||", transliteration: "aneka-vaktra-nayanam anekādbhuta-darśhanam\naneka-divyābharaṇaṁ divyānekodyatāyudham", translation_en: "With numerous mouths and eyes, with numerous wondrous sights, with numerous divine adornments, with numerous divine weapons uplifted, such a form He showed.", translation_hi: "उस अनेक मुख और नेत्रों से युक्त तथा अनेक अद्भुत दर्शनों वाले एवं बहुत से दिव्य भूषणों से युक्त और बहुत से दिव्य शस्त्रों को हाथों में उठाये हुये।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_010.mp3"},
  {id: "BG_11.11", label: "BG 11.11", ref: "11.11", chapter: 11, verse: 11, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "दिव्यमाल्याम्बरधरं दिव्यगन्धानुलेपनम्", snippet: "Wearing divine garlands and apparel, anointed with divine unguents, the all-wonderful, resplendent Being is endless with faces on all sides.", sanskrit: "दिव्यमाल्याम्बरधरं दिव्यगन्धानुलेपनम् ।\nसर्वाश्चर्यमयं देवमनन्तं विश्वतोमुखम् ॥", iast: "divyamālyāmbaradharaṃ divyagandhānulepanam |\nsarvāścaryamayaṃ devamanantaṃ viśvatomukham ||", transliteration: "divya-mālyāmbara-dharaṁ divya-gandhānulepanam\nsarvāśhcharya-mayaṁ devam anantaṁ viśhvato-mukham", translation_en: "Wearing divine garlands and apparel, anointed with divine unguents, the all-wonderful, resplendent Being is endless with faces on all sides.", translation_hi: "दिव्य माला और वस्त्रों को धारण किये हुये और दिव्य गन्ध का लेपन किये हुये एवं समस्त प्रकार के आश्चर्यों से युक्त अनन्त, विश्वतोमुख (विराट् स्वरूप) परम देव (को अर्जुन ने देखा)।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_011.mp3"},
  {id: "BG_11.12", label: "BG 11.12", ref: "11.12", chapter: 11, verse: 12, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "दिवि सूर्यसहस्रस्य भवेद्युगपदुत्थिता", snippet: "If the splendour of a thousand suns were to blaze out simultaneously in the sky, that would be the splendour of that mighty being.", sanskrit: "दिवि सूर्यसहस्रस्य भवेद्युगपदुत्थिता ।\nयदि भाः सदृशी सा स्याद्भासस्तस्य महात्मनः ॥", iast: "divi sūryasahasrasya bhavedyugapadutthitā |\nyadi bhāḥ sadṛśī sā syādbhāsastasya mahātmanaḥ ||", transliteration: "divi sūrya-sahasrasya bhaved yugapad utthitā\nyadi bhāḥ sadṛiśhī sā syād bhāsas tasya mahātmanaḥ", translation_en: "If the splendour of a thousand suns were to blaze out simultaneously in the sky, that would be the splendour of that mighty being.", translation_hi: "आकाश में सहस्र सूर्यों के एक साथ उदय होने से उत्पन्न जो प्रकाश होगा, वह उस (विश्वरूप) परमात्मा के प्रकाश के सदृश होगा।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_012.mp3"},
  {id: "BG_11.13", label: "BG 11.13", ref: "11.13", chapter: 11, verse: 13, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "तत्रैकस्थं जगत्कृत्स्नं प्रविभक्तमनेकधा", snippet: "There, in the body of the God of gods, Arjuna then saw the entire universe resting in one, with its myriad of divisions.", sanskrit: "तत्रैकस्थं जगत्कृत्स्नं प्रविभक्तमनेकधा ।\nअपश्यद्देवदेवस्य शरीरे पाण्डवस्तदा ॥", iast: "tatraikasthaṃ jagatkṛtsnaṃ pravibhaktamanekadhā |\napaśyaddevadevasya śarīre pāṇḍavastadā ||", transliteration: "tatraika-sthaṁ jagat kṛitsnaṁ pravibhaktam anekadhā\napaśhyad deva-devasya śharīre pāṇḍavas tadā", translation_en: "There, in the body of the God of gods, Arjuna then saw the entire universe resting in one, with its myriad of divisions.", translation_hi: "पाण्डुपुत्र अर्जुन ने उस समय अनेक प्रकार से विभक्त हुए सम्पूर्ण जगत् को देवों के देव श्रीकृष्ण के शरीर में एक स्थान पर स्थित देखा।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_013.mp3"},
  {id: "BG_11.14", label: "BG 11.14", ref: "11.14", chapter: 11, verse: 14, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "ततः स विस्मयाविष्टो हृष्टरोमा धनञ्जयः", snippet: "Then, Arjuna, filled with wonder and his hair standing on end, bowed his head to the God and spoke with palms joined.", sanskrit: "ततः स विस्मयाविष्टो हृष्टरोमा धनञ्जयः ।\nप्रणम्य शिरसा देवं कृताञ्जलिरभाषत ॥", iast: "tataḥ sa vismayāviṣṭo hṛṣṭaromā dhanañjayaḥ |\npraṇamya śirasā devaṃ kṛtāñjalirabhāṣata ||", transliteration: "tataḥ sa vismayāviṣhṭo hṛiṣhṭa-romā dhanañjayaḥ\npraṇamya śhirasā devaṁ kṛitāñjalir abhāṣhata", translation_en: "Then, Arjuna, filled with wonder and his hair standing on end, bowed his head to the God and spoke with palms joined.", translation_hi: "उसके उपरान्त वह आश्चर्यचकित हुआ हर्षित रोमों वाला (जिसे रोमांच का अनुभव हो रहा हो) धनंजय अर्जुन विश्वरूप देव को (श्रद्धा भक्ति सहित) शिर से प्रणाम करके हाथ जोड़कर बोला।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_014.mp3"},
  {id: "BG_11.15", label: "BG 11.15", ref: "11.15", chapter: 11, verse: 15, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "पश्यामि देवांस्तव देव देहे", snippet: "Arjuna said, \"O God, I see all the gods in Your body, as well as hosts of various classes of beings, Brahma the Lord seated on the lotus, all the sages, and the celestial…", sanskrit: "पश्यामि देवांस्तव देव देहे\nसर्वांस्तथा भूतविशेषसङ्घान् ।\nब्रह्माणमीशं कमलासनस्थ\nमृषींश्च सर्वानुरगांश्च दिव्यान् ॥", iast: "paśyāmi devāṃstava deva dehe\nsarvāṃstathā bhūtaviśeṣasaṅghān |\nbrahmāṇamīśaṃ kamalāsanastha\nmṛṣīṃśca sarvānuragāṃśca divyān ||", transliteration: "paśhyāmi devāns tava deva dehe\nsarvāns tathā bhūta-viśheṣha-saṅghān\nbrahmāṇam īśhaṁ kamalāsana-stham\nṛiṣhīnśh cha sarvān uragānśh cha divyān", translation_en: "Arjuna said, \"O God, I see all the gods in Your body, as well as hosts of various classes of beings, Brahma the Lord seated on the lotus, all the sages, and the celestial serpents.\"", translation_hi: "अर्जुन ने कहा -- हे देव! मैं आपके शरीर में समस्त देवों को तथा अनेक भूतविशेषों के समुदायों को और कमलासन पर स्थित सृष्टि के स्वामी ब्रह्माजी को, ऋषियों को और दिव्य सर्पों को देख रहा हूँ।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_015.mp3"},
  {id: "BG_11.16", label: "BG 11.16", ref: "11.16", chapter: 11, verse: 16, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "अनेकबाहूदरवक्त्रनेत्रं", snippet: "I see You with boundless form on every side, with many arms, stomachs, mouths, and eyes; neither the end nor the middle nor the beginning do I see, O Lord of the Universe, O…", sanskrit: "अनेकबाहूदरवक्त्रनेत्रं\nपश्यामि त्वां सर्वतोऽनन्तरूपम् ।\nनान्तं न मध्यं न पुनस्तवादिं\nपश्यामि विश्वेश्वर विश्वरूप ॥", iast: "anekabāhūdaravaktranetraṃ\npaśyāmi tvāṃ sarvato’nantarūpam |\nnāntaṃ na madhyaṃ na punastavādiṃ\npaśyāmi viśveśvara viśvarūpa ||", transliteration: "aneka-bāhūdara-vaktra-netraṁ\npaśhyāmi tvāṁ sarvato ’nanta-rūpam\nnāntaṁ na madhyaṁ na punas tavādiṁ\npaśhyāmi viśhveśhvara viśhva-rūpa", translation_en: "I see You with boundless form on every side, with many arms, stomachs, mouths, and eyes; neither the end nor the middle nor the beginning do I see, O Lord of the Universe, O Cosmic Form.", translation_hi: "हे विश्वेश्वर! मैं आपकी अनेक बाहु, उदर, मुख और नेत्रों से युक्त तथा सब ओर से अनन्त रूपों वाला देखता हूँ। हे विश्वरूप! मैं आपके न अन्त को देखता हूँ और न मध्य को और न आदि को।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_016.mp3"},
  {id: "BG_11.17", label: "BG 11.17", ref: "11.17", chapter: 11, verse: 17, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "किरीटिनं गदिनं चक्रिणं च", snippet: "I see You with the diadem, club, and discus, a mass of radiance shining everywhere, very hard to look at, blazing all around like a burning fire and the sun, and immeasurable.", sanskrit: "किरीटिनं गदिनं चक्रिणं च\nतेजोराशिं सर्वतोदीप्तिमन्तम् ।\nपश्यामि त्वां दुर्निरीक्ष्यं समन्ता\nद्दीप्तानलार्कद्युतिमप्रमेयम् ॥", iast: "kirīṭinaṃ gadinaṃ cakriṇaṃ ca\ntejorāśiṃ sarvatodīptimantam |\npaśyāmi tvāṃ durnirīkṣyaṃ samantā\nddīptānalārkadyutimaprameyam ||", transliteration: "kirīṭinaṁ gadinaṁ chakriṇaṁ cha\ntejo-rāśhiṁ sarvato dīptimantam\npaśhyāmi tvāṁ durnirīkṣhyaṁ samantād\ndīptānalārka-dyutim aprameyam", translation_en: "I see You with the diadem, club, and discus, a mass of radiance shining everywhere, very hard to look at, blazing all around like a burning fire and the sun, and immeasurable.", translation_hi: "मैं आपका मुकुटयुक्त, गदायुक्त और चक्रधारण किये हुये तथा सब ओर से प्रकाशमान् तेज का पुंज, दीप्त अग्नि और सूर्य के समान ज्योतिर्मय, देखने में अति कठिन और अप्रमेयस्वरूप सब ओर से देखता हूँ।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_017.mp3"},
  {id: "BG_11.18", label: "BG 11.18", ref: "11.18", chapter: 11, verse: 18, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "त्वमक्षरं परमं वेदितव्यं", snippet: "You are the Imperishable, the Supreme Being, worthy of being known. You are the great treasure-house of this universe; You are the imperishable protector of the eternal Dharma;…", sanskrit: "त्वमक्षरं परमं वेदितव्यं\nत्वमस्य विश्वस्य परं निधानम् ।\nत्वमव्ययः शाश्वतधर्मगोप्ता\nसनातनस्त्वं पुरुषो मतो मे ॥", iast: "tvamakṣaraṃ paramaṃ veditavyaṃ\ntvamasya viśvasya paraṃ nidhānam |\ntvamavyayaḥ śāśvatadharmagoptā\nsanātanastvaṃ puruṣo mato me ||", transliteration: "tvam akṣharaṁ paramaṁ veditavyaṁ\ntvam asya viśhvasya paraṁ nidhānam\ntvam avyayaḥ śhāśhvata-dharma-goptā\nsanātanas tvaṁ puruṣho mato me", translation_en: "You are the Imperishable, the Supreme Being, worthy of being known. You are the great treasure-house of this universe; You are the imperishable protector of the eternal Dharma; You are the Primal Person, I believe.", translation_hi: "आप ही जानने योग्य (वेदितव्यम्) परम अक्षर हैं; आप ही इस विश्व के परम आश्रय (निधान) हैं ! आप ही शाश्वत धर्म के रक्षक हैं और आप ही सनातन पुरुष हैं,ऐसा मेरा मत है।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_018.mp3"},
  {id: "BG_11.19", label: "BG 11.19", ref: "11.19", chapter: 11, verse: 19, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "अनादिमध्यान्तमनन्तवीर्य", snippet: "I see You without beginning, middle, or end, infinite in power, with endless arms, the sun and moon as Your eyes, the burning fire Your mouth, heating the entire universe with…", sanskrit: "अनादिमध्यान्तमनन्तवीर्य\nमनन्तबाहुं शशिसूर्यनेत्रम् ।\nपश्यामि त्वां दीप्तहुताशवक्त्रम्\nस्वतेजसा विश्वमिदं तपन्तम् ॥", iast: "anādimadhyāntamanantavīrya\nmanantabāhuṃ śaśisūryanetram |\npaśyāmi tvāṃ dīptahutāśavaktram\nsvatejasā viśvamidaṃ tapantam ||", transliteration: "स्वतेजसा विश्वमिदं तपन्तम् || 19||", translation_en: "I see You without beginning, middle, or end, infinite in power, with endless arms, the sun and moon as Your eyes, the burning fire Your mouth, heating the entire universe with Your radiance.", translation_hi: "मैं आपको आदि, अन्त और मध्य से रहित तथा अनंत सार्मथ्य से युक्त और अनंत बाहुओं वाला तथा चन्द्रसूर्यरूपी नेत्रों वाला और दीप्त अग्निरूपी मुख वाला तथा अपने तेज से इस विश्व को तपाते हुए देखता हूँ।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_019.mp3"},
  {id: "BG_11.20", label: "BG 11.20", ref: "11.20", chapter: 11, verse: 20, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "द्यावापृथिव्योरिदमन्तरं हि", snippet: "This space between the earth and the heavens, and all the quarters, is filled by You alone; having seen this, Your wonderful and terrible form, the three worlds are trembling…", sanskrit: "द्यावापृथिव्योरिदमन्तरं हि\nव्याप्तं त्वयैकेन दिशश्च सर्वाः ।\nदृष्ट्वाऽद्भुतं रूपमुग्रं तवेदं\nलोकत्रयं प्रव्यथितं महात्मन् ॥", iast: "dyāvāpṛthivyoridamantaraṃ hi\nvyāptaṃ tvayaikena diśaśca sarvāḥ |\ndṛṣṭvā’dbhutaṃ rūpamugraṃ tavedaṃ\nlokatrayaṃ pravyathitaṃ mahātman ||", transliteration: "dyāv ā-pṛithivyor idam antaraṁ hi\nvyāptaṁ tvayaikena diśhaśh cha sarvāḥ\ndṛiṣhṭvādbhutaṁ rūpam ugraṁ tavedaṁ\nloka-trayaṁ pravyathitaṁ mahātman", translation_en: "This space between the earth and the heavens, and all the quarters, is filled by You alone; having seen this, Your wonderful and terrible form, the three worlds are trembling with fear, O great-souled Being.", translation_hi: "हे महात्मन् ! स्वर्ग और पृथ्वी के मध्य का यह आकाश तथा समस्त दिशाएं अकेले आप से ही व्याप्त हैं; आपके इस अद्भुत और उग्र रूप को देखकर तीनों लोक अतिव्यथा (भय) को प्राप्त हो रहे हैं।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_020.mp3"},
  {id: "BG_11.21", label: "BG 11.21", ref: "11.21", chapter: 11, verse: 21, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "अमी हि त्वां सुरसङ्घाः विशन्ति", snippet: "Verily, these hosts of gods enter into Thee; some extol Thee with joined palms in fear, saying, 'May it be well!' Bands of great sages and perfected ones praise Thee with…", sanskrit: "अमी हि त्वां सुरसङ्घाः विशन्ति\nकेचिद्भीताः प्राञ्जलयो गृणन्ति ।\nस्वस्तीत्युक्त्वा महर्षिसिद्धसङ्घाः\nस्तुवन्ति त्वां स्तुतिभिः पुष्कलाभिः ॥", iast: "amī hi tvāṃ surasaṅghāḥ viśanti\nkecidbhītāḥ prāñjalayo gṛṇanti |\nsvastītyuktvā maharṣisiddhasaṅghāḥ\nstuvanti tvāṃ stutibhiḥ puṣkalābhiḥ ||", transliteration: "amī hi tvāṁ sura-saṅghā viśhanti\nkechid bhītāḥ prāñjalayo gṛiṇanti\nsvastīty uktvā maharṣhi-siddha-saṅghāḥ\nstuvanti tvāṁ stutibhiḥ puṣhkalābhiḥ", translation_en: "Verily, these hosts of gods enter into Thee; some extol Thee with joined palms in fear, saying, 'May it be well!' Bands of great sages and perfected ones praise Thee with complete hymns.", translation_hi: "ये समस्त देवताओं के समूह आप में ही प्रवेश कर रहे हैं और कई एक भयभीत होकर हाथ जोड़े हुए आप की स्तुति करते हैं; महर्षि और सिद्धों के समुदाय 'कल्याण होवे' (स्वस्तिवाचन करते हुए) ऐसा कहकर, उत्तम (या सम्पूर्ण) स्रोतों द्वारा आपकी स्तुति करते हैं।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_021.mp3"},
  {id: "BG_11.22", label: "BG 11.22", ref: "11.22", chapter: 11, verse: 22, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "रुद्रादित्या वसवो ये च साध्या", snippet: "The Rudras, Adityas, Vasus, Sadhyas, Visvedevas, the two Asvins, Maruts, the Manus, and the hosts of celestial singers, Yakshas, demons, and the perfected ones, all look upon…", sanskrit: "रुद्रादित्या वसवो ये च साध्या\nविश्वेऽश्विनौ मरुतश्चोष्मपाश्च ।\nगन्धर्वयक्षासुरसिद्धसङ्घा\nवीक्षन्ते त्वां विस्मिताश्चैव सर्वे ॥", iast: "rudrādityā vasavo ye ca sādhyā\nviśve’śvinau marutaścoṣmapāśca |\ngandharvayakṣāsurasiddhasaṅghā\nvīkṣante tvāṃ vismitāścaiva sarve ||", transliteration: "rudrādityā vasavo ye cha sādhyā\nviśhve ’śhvinau marutaśh choṣhmapāśh cha\ngandharva-yakṣhāsura-siddha-saṅghā\nvīkṣhante tvāṁ vismitāśh chaiva sarve", translation_en: "The Rudras, Adityas, Vasus, Sadhyas, Visvedevas, the two Asvins, Maruts, the Manus, and the hosts of celestial singers, Yakshas, demons, and the perfected ones, all look upon Thee with great amazement.", translation_hi: "रुद्रगण, आदित्य, वसु और साध्यगण, विश्वेदेव तथा दो अश्विनीकुमार, मरुद्गण और उष्मपा, गन्धर्व, यक्ष, असुर और सिद्धगणों के समुदाय- ये सब ही विस्मित होते हुए आपको देखते हैं।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_022.mp3"},
  {id: "BG_11.23", label: "BG 11.23", ref: "11.23", chapter: 11, verse: 23, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "रूपं महत्ते बहुवक्त्रनेत्रं", snippet: "Having seen Your immeasurable form with many mouths and eyes, O mighty-armed one, with many arms, thighs, and feet, with many stomachs and fearsome with many teeth, the worlds…", sanskrit: "रूपं महत्ते बहुवक्त्रनेत्रं\nमहाबाहो बहुबाहूरुपादम् ।\nबहूदरं बहुदंष्ट्राकरालं\nदृष्ट्वा लोकाः प्रव्यथितास्तथाऽहम् ॥", iast: "rūpaṃ mahatte bahuvaktranetraṃ\nmahābāho bahubāhūrupādam |\nbahūdaraṃ bahudaṃṣṭrākarālaṃ\ndṛṣṭvā lokāḥ pravyathitāstathā’ham ||", transliteration: "rūpaṁ mahat te bahu-vaktra-netraṁ\nmahā-bāho bahu-bāhūru-pādam\nbahūdaraṁ bahu-danṣhṭrā-karālaṁ\ndṛiṣhṭvā lokāḥ pravyathitās tathāham", translation_en: "Having seen Your immeasurable form with many mouths and eyes, O mighty-armed one, with many arms, thighs, and feet, with many stomachs and fearsome with many teeth, the worlds are terrified, and so am I.", translation_hi: "हे महाबाहो! आपके बहुत मुख तथा नेत्र वाले, बहुत बाहु, उरु (जंघा) तथा पैरों वाले, बहुत-ंंसी उदरों वाले तथा बहुतसी विकराल दाढ़ों वाले महान् रूप को देखकर सब लोग व्यथित हो रहे हैं और उसी प्रकार मैं भी (व्याकुल हो रहा हूँ)।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_023.mp3"},
  {id: "BG_11.24", label: "BG 11.24", ref: "11.24", chapter: 11, verse: 24, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "नभःस्पृशं दीप्तमनेकवर्णं", snippet: "On seeing Thee, touching the sky, shining in many colors, with mouths wide open, with large fiery eyes, I am terrified at heart and find neither courage nor peace, O Vishnu.", sanskrit: "नभःस्पृशं दीप्तमनेकवर्णं\nव्यात्ताननं दीप्तविशालनेत्रम् ।\nदृष्ट्वा हि त्वां प्रव्यथितान्तरात्मा\nधृतिं न विन्दामि शमं च विष्णो ॥", iast: "nabhaḥspṛśaṃ dīptamanekavarṇaṃ\nvyāttānanaṃ dīptaviśālanetram |\ndṛṣṭvā hi tvāṃ pravyathitāntarātmā\ndhṛtiṃ na vindāmi śamaṃ ca viṣṇo ||", transliteration: "nabhaḥ-spṛiśhaṁ dīptam aneka-varṇaṁ\nvyāttānanaṁ dīpta-viśhāla-netram\ndṛiṣhṭvā hi tvāṁ pravyathitāntar-ātmā\ndhṛitiṁ na vindāmi śhamaṁ cha viṣhṇo", translation_en: "On seeing Thee, touching the sky, shining in many colors, with mouths wide open, with large fiery eyes, I am terrified at heart and find neither courage nor peace, O Vishnu.", translation_hi: "हे विष्णो! आकाश के साथ स्पर्श किये हुए देदीप्यमान अनेक रूपों से युक्त तथा विस्तरित मुख और प्रकाशमान विशाल नेत्रों से युक्त आपको देखकर भयभीत हुआ मैं धैर्य और शान्ति को नहीं प्राप्त हो रहा हूँ।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_024.mp3"},
  {id: "BG_11.25", label: "BG 11.25", ref: "11.25", chapter: 11, verse: 25, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "दंष्ट्राकरालानि च ते मुखानि", snippet: "Having seen Thy mouths fearful with teeth blazing like the fires of cosmic dissolution, I know not the four quarters, nor do I find peace. Have mercy, O Lord of the gods, O…", sanskrit: "दंष्ट्राकरालानि च ते मुखानि\nदृष्ट्वैव कालानलसन्निभानि ।\nदिशो न जाने न लभे च शर्म\nप्रसीद देवेश जगन्निवास ॥", iast: "daṃṣṭrākarālāni ca te mukhāni\ndṛṣṭvaiva kālānalasannibhāni |\ndiśo na jāne na labhe ca śarma\nprasīda deveśa jagannivāsa ||", transliteration: "danṣhṭrā-karālāni cha te mukhāni\ndṛiṣhṭvaiva kālānala-sannibhāni\ndiśho na jāne na labhe cha śharma\nprasīda deveśha jagan-nivāsa", translation_en: "Having seen Thy mouths fearful with teeth blazing like the fires of cosmic dissolution, I know not the four quarters, nor do I find peace. Have mercy, O Lord of the gods, O abode of the universe.", translation_hi: "आपके विकराल दाढ़ों वाले और प्रलयाग्नि के समान प्रज्वलित मुखों को देखकर, मैं न दिशाओं को जान पा रहा हूँ और न शान्ति को प्राप्त हो रहा हूँ; इसलिए हे देवेश!  हे जगन्निवास! आप प्रसन्न हो जाइए।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_025.mp3"},
  {id: "BG_11.26", label: "BG 11.26", ref: "11.26", chapter: 11, verse: 26, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "अमी च त्वां धृतराष्ट्रस्य पुत्राः", snippet: "All the sons of Dhritarashtra, along with the hosts of kings of the earth, Bhishma, Drona, and Karna, as well as the chief among our warriors.", sanskrit: "अमी च त्वां धृतराष्ट्रस्य पुत्राः\nसर्वे सहैवावनिपालसङ्घैः ।\nभीष्मो द्रोणः सूतपुत्रस्तथाऽसौ\nसहास्मदीयैरपि योधमुख्यैः ॥", iast: "amī ca tvāṃ dhṛtarāṣṭrasya putrāḥ\nsarve sahaivāvanipālasaṅghaiḥ |\nbhīṣmo droṇaḥ sūtaputrastathā’sau\nsahāsmadīyairapi yodhamukhyaiḥ ||", transliteration: "amī cha tvāṁ dhṛitarāśhtrasya putrāḥ\nsarve sahaivāvani-pāla-saṅghaiḥ\nbhīṣhmo droṇaḥ sūta-putras tathāsau\nsahāsmadīyair api yodha-mukhyaiḥ\nvaktrāṇi te tvaramāṇā viśhanti\ndanṣhṭrā-karālāni bhayānakāni\nkechid vilagnā daśhanāntareṣhu\nsandṛiśhyante chūrṇitair uttamāṅgaiḥ", translation_en: "All the sons of Dhritarashtra, along with the hosts of kings of the earth, Bhishma, Drona, and Karna, as well as the chief among our warriors.", translation_hi: "और ये समस्त धृतराष्ट्र के पुत्र राजाओं के समुदाय सहित आप में प्रवेश करते हैं। भीष्म, द्रोण तथा कर्ण और हमारे पक्ष के भी प्रधान योद्धाओं के सहित.।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_026.mp3"},
  {id: "BG_11.27", label: "BG 11.27", ref: "11.27", chapter: 11, verse: 27, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "वक्त्राणि ते त्वरमाणा विशन्ति", snippet: "Some hurry into Your mouths with their terrible teeth, fearful to behold. Some are found stuck in the gaps between the teeth, their heads crushed to powder.", sanskrit: "वक्त्राणि ते त्वरमाणा विशन्ति\nदंष्ट्राकरालानि भयानकानि ।\nकेचिद्विलग्ना दशनान्तरेषु\nसंदृश्यन्ते चूर्णितैरुत्तमाङ्गैः ॥", iast: "vaktrāṇi te tvaramāṇā viśanti\ndaṃṣṭrākarālāni bhayānakāni |\nkecidvilagnā daśanāntareṣu\nsaṃdṛśyante cūrṇitairuttamāṅgaiḥ ||", transliteration: "vaktrāṇi te  tvaramāṇā   viśanti daṁṣṭrā-karālāni    bhayānakāni kecid   vilagnā daśanāntareṣu   sandṛśyante cūrṇitair   uttamāṅgaiḥ", translation_en: "Some hurry into Your mouths with their terrible teeth, fearful to behold. Some are found stuck in the gaps between the teeth, their heads crushed to powder.", translation_hi: "तीव्र वेग से आपके विकराल दाढ़ों वाले भयानक मुखों में प्रवेश करते हैं और कई एक चूर्णित शिरों सहित आपके दांतों के बीच में फँसे हुए दिख रहे हैं।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_027.mp3"},
  {id: "BG_11.28", label: "BG 11.28", ref: "11.28", chapter: 11, verse: 28, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "यथा नदीनां बहवोऽम्बुवेगाः", snippet: "Verily, just as many torrents of rivers flow towards the ocean, so too these heroes in the world of men enter Thy flaming mouths.", sanskrit: "यथा नदीनां बहवोऽम्बुवेगाः\nसमुद्रमेवाभिमुखाः द्रवन्ति ।\nतथा तवामी नरलोकवीरा\nविशन्ति वक्त्राण्यभिविज्वलन्ति ॥", iast: "yathā nadīnāṃ bahavo’mbuvegāḥ\nsamudramevābhimukhāḥ dravanti |\ntathā tavāmī naralokavīrā\nviśanti vaktrāṇyabhivijvalanti ||", transliteration: "yathā nadīnāṁ bahavo ’mbu-vegāḥ\nsamudram evābhimukhā dravanti\ntathā tavāmī nara-loka-vīrā\nviśhanti vaktrāṇy abhivijvalanti", translation_en: "Verily, just as many torrents of rivers flow towards the ocean, so too these heroes in the world of men enter Thy flaming mouths.", translation_hi: "जैसे नदियों के बहुत से जलप्रवाह समुद्र की ओर वेग से बहते हैं, वैसे ही मनुष्यलोक के ये वीर योद्धागण आपके प्रज्वलित मुखों में प्रवेश करते हैं।।", meter_name: "Triṣṭubh — Upendravajrā", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_028.mp3"},
  {id: "BG_11.29", label: "BG 11.29", ref: "11.29", chapter: 11, verse: 29, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "यथा प्रदीप्तं ज्वलनं पतङ्गा", snippet: "As moths hurriedly rush into a blazing fire, leading to their own destruction, so too these creatures hurry into Your mouths, leading to their own destruction.", sanskrit: "यथा प्रदीप्तं ज्वलनं पतङ्गा\nविशन्ति नाशाय समृद्धवेगाः ।\nतथैव नाशाय विशन्ति लोका\nस्तवापि वक्त्राणि समृद्धवेगाः ॥", iast: "yathā pradīptaṃ jvalanaṃ pataṅgā\nviśanti nāśāya samṛddhavegāḥ |\ntathaiva nāśāya viśanti lokā\nstavāpi vaktrāṇi samṛddhavegāḥ ||", transliteration: "yathā pradīptaṁ jvalanaṁ pataṅgā\nviśhanti nāśhāya samṛiddha-vegāḥ\ntathaiva nāśhāya viśhanti lokās\ntavāpi vaktrāṇi samṛiddha-vegāḥ", translation_en: "As moths hurriedly rush into a blazing fire, leading to their own destruction, so too these creatures hurry into Your mouths, leading to their own destruction.", translation_hi: "जैसे पतंगे अपने नाश के लिए प्रज्वलित अग्नि में अतिवेग से प्रवेश करते हैं, वैसे ही ये लोग भी अपने नाश के लिए आपके मुखों में अतिवेग से प्रवेश करते हैं।।", meter_name: "Triṣṭubh — Upendravajrā", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_029.mp3"},
  {id: "BG_11.30", label: "BG 11.30", ref: "11.30", chapter: 11, verse: 30, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "लेलिह्यसे ग्रसमानः समन्ता", snippet: "Thou lickest up, devouring all the worlds on every side with Thy flaming mouths. Thy fierce rays, filling the whole world with radiance, burn, O Vishnu!", sanskrit: "लेलिह्यसे ग्रसमानः समन्ता\nल्लोकान्समग्रान्वदनैर्ज्वलद्भिः ।\nतेजोभिरापूर्य जगत्समग्रं\nभासस्तवोग्राः प्रतपन्ति विष्णो ॥", iast: "lelihyase grasamānaḥ samantā\nllokānsamagrānvadanairjvaladbhiḥ |\ntejobhirāpūrya jagatsamagraṃ\nbhāsastavogrāḥ pratapanti viṣṇo ||", transliteration: "lelihyase grasamānaḥ samantāl\nlokān samagrān vadanair jvaladbhiḥ\ntejobhir āpūrya jagat samagraṁ\nbhāsas tavogrāḥ pratapanti viṣhṇo", translation_en: "Thou lickest up, devouring all the worlds on every side with Thy flaming mouths. Thy fierce rays, filling the whole world with radiance, burn, O Vishnu!", translation_hi: "हे विष्णो! आप प्रज्वलित मुखों के द्वारा इन समस्त लोकों का ग्रसन करते हुए आस्वाद ले रहे हैं, आपका उग्र प्रकाश सम्पूर्ण जगत् को तेज के द्वारा परिपूर्ण करके तपा रहा है।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_030.mp3"},
  {id: "BG_11.31", label: "BG 11.31", ref: "11.31", chapter: 11, verse: 31, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "आख्याहि मे को भवानुग्ररूपो", snippet: "Tell me, who you are, so fierce of form. I offer my salutations to you, O God Supreme; have mercy on me. I desire to know you, the original Being. I do not indeed know your…", sanskrit: "आख्याहि मे को भवानुग्ररूपो\nनमोऽस्तु ते देववर प्रसीद ।\nविज्ञातुमिच्छामि भवन्तमाद्यं\nन हि प्रजानामि तव प्रवृत्तिम् ॥", iast: "ākhyāhi me ko bhavānugrarūpo\nnamo’stu te devavara prasīda |\nvijñātumicchāmi bhavantamādyaṃ\nna hi prajānāmi tava pravṛttim ||", transliteration: "ākhyāhi me ko bhavān ugra-rūpo\nnamo ’stu te deva-vara prasīda\nvijñātum ichchhāmi bhavantam ādyaṁ\nna hi prajānāmi tava pravṛittim", translation_en: "Tell me, who you are, so fierce of form. I offer my salutations to you, O God Supreme; have mercy on me. I desire to know you, the original Being. I do not indeed know your workings.", translation_hi: "(कृपया) मेरे प्रति कहिये, कि उग्ररूप वाले आप कौन हैं? हे देवों में श्रेष्ठ! आपको नमस्कार है, आप प्रसन्न होइये। आदि स्वरूप आपको मैं (तत्त्व से) जानना चाहता हूँ, क्योंकि आपकी प्रवृत्ति (अर्थात् प्रयोजन को) को मैं नहीं समझ पा रहा हूँ।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_031.mp3"},
  {id: "BG_11.32", label: "BG 11.32", ref: "11.32", chapter: 11, verse: 32, speaker: "krishna", canonical: true, meter: "tristubh", sa: "कालोऽस्मि लोकक्षयकृत्प्रवृद्धो", snippet: "The Blessed Lord said, \"I am the full-grown, world-destroying Time, now engaged in destroying the worlds. Even without you, none of the warriors arrayed in the hostile armies…", sanskrit: "कालोऽस्मि लोकक्षयकृत्प्रवृद्धो\nलोकान्समाहर्तुमिह प्रवृत्तः ।\nऋतेऽपि त्वां न भविष्यन्ति सर्वे\nयेऽवस्थिताः प्रत्यनीकेषु योधाः ॥", iast: "kālo’smi lokakṣayakṛtpravṛddho\nlokānsamāhartumiha pravṛttaḥ |\nṛte’pi tvāṃ na bhaviṣyanti sarve\nye’vasthitāḥ pratyanīkeṣu yodhāḥ ||", transliteration: "kālo ’smi loka-kṣhaya-kṛit pravṛiddho\nlokān samāhartum iha pravṛittaḥ\nṛite ’pi tvāṁ na bhaviṣhyanti sarve\nye ’vasthitāḥ pratyanīkeṣhu yodhāḥ", translation_en: "The Blessed Lord said, \"I am the full-grown, world-destroying Time, now engaged in destroying the worlds. Even without you, none of the warriors arrayed in the hostile armies will live.\"", translation_hi: "श्रीभगवान् ने कहा -- मैं लोकों का नाश करने वाला प्रवृद्ध काल हूँ। इस समय, मैं इन लोकों का संहार करने में प्रवृत्त हूँ। जो प्रतिपक्षियों की सेना में स्थित योद्धा हैं, वे सब तुम्हारे बिना भी नहीं रहेंगे।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_032.mp3"},
  {id: "BG_11.33", label: "BG 11.33", ref: "11.33", chapter: 11, verse: 33, speaker: "krishna", canonical: true, meter: "tristubh", sa: "तस्मात्त्वमुत्तिष्ठ यशो लभस्व", snippet: "Therefore, stand up and obtain fame. Conquer the enemies and enjoy the unparalleled kingdom. Verily, by Me they have already been slain; be thou a mere instrument, O Arjuna.", sanskrit: "तस्मात्त्वमुत्तिष्ठ यशो लभस्व\nजित्वा शत्रून् भुङ्क्ष्व राज्यं समृद्धम् ।\nमयैवैते निहताः पूर्वमेव\nनिमित्तमात्रं भव सव्यसाचिन् ॥", iast: "tasmāttvamuttiṣṭha yaśo labhasva\njitvā śatrūn bhuṅkṣva rājyaṃ samṛddham |\nmayaivaite nihatāḥ pūrvameva\nnimittamātraṃ bhava savyasācin ||", transliteration: "tasmāt tvam uttiṣhṭha yaśho labhasva\njitvā śhatrūn bhuṅkṣhva rājyaṁ samṛiddham\nmayaivaite nihatāḥ pūrvam eva\nnimitta-mātraṁ bhava savya-sāchin", translation_en: "Therefore, stand up and obtain fame. Conquer the enemies and enjoy the unparalleled kingdom. Verily, by Me they have already been slain; be thou a mere instrument, O Arjuna.", translation_hi: "इसलिए तुम उठ खड़े हो जाओ और यश को प्राप्त करो; शत्रुओं को जीतकर समृद्ध राज्य को भोगो। ये सब पहले से ही मेरे द्वारा मारे जा चुके हैं। हे सव्यसाचिन्! तुम केवल निमित्त ही बनो।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_033.mp3"},
  {id: "BG_11.34", label: "BG 11.34", ref: "11.34", chapter: 11, verse: 34, speaker: "krishna", canonical: true, meter: "tristubh", sa: "द्रोणं च भीष्मं च जयद्रथं च", snippet: "Drona, Bhishma, Jayadratha, Karna, and other brave warriors have already been slain by Me; do not be distressed with fear; fight and you shall conquer your enemies in battle.", sanskrit: "द्रोणं च भीष्मं च जयद्रथं च\nकर्णं तथाऽन्यानपि योधवीरान् ।\nमया हतांस्त्वं जहि मा व्यथिष्ठा\nयुध्यस्व जेतासि रणे सपत्नान् ॥", iast: "droṇaṃ ca bhīṣmaṃ ca jayadrathaṃ ca\nkarṇaṃ tathā’nyānapi yodhavīrān |\nmayā hatāṃstvaṃ jahi mā vyathiṣṭhā\nyudhyasva jetāsi raṇe sapatnān ||", transliteration: "droṇaṁ cha bhīṣhmaṁ cha jayadrathaṁ cha\nkarṇaṁ tathānyān api yodha-vīrān\nmayā hatāṁs tvaṁ jahi mā vyathiṣhṭhā\nyudhyasva jetāsi raṇe sapatnān", translation_en: "Drona, Bhishma, Jayadratha, Karna, and other brave warriors have already been slain by Me; do not be distressed with fear; fight and you shall conquer your enemies in battle.", translation_hi: "द्रोण, भीष्म, जयद्रथ, कर्ण तथा और भी बहुत से मेरे द्वारा मारे गये वीर योद्धाओं को तुम मारो; भय मत करो; युद्ध करो; तुम युद्ध में शत्रुओं को जीतोगे।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_034.mp3"},
  {id: "BG_11.35", label: "BG 11.35", ref: "11.35", chapter: 11, verse: 35, speaker: "sanjaya", canonical: true, meter: "tristubh", sa: "एतच्छ्रुत्वा वचनं केशवस्य", snippet: "Sanjaya said, Having heard that speech of Lord Krishna, Arjuna, with joined palms, trembling, prostrated himself, again addressing Krishna in a choked voice, bowing down,…", sanskrit: "एतच्छ्रुत्वा वचनं केशवस्य\nकृताञ्जलिर्वेपमानः किरीटी ।\nनमस्कृत्वा भूय एवाह कृष्णं\nसगद्गदं भीतभीतः प्रणम्य ॥", iast: "etacchrutvā vacanaṃ keśavasya\nkṛtāñjalirvepamānaḥ kirīṭī |\nnamaskṛtvā bhūya evāha kṛṣṇaṃ\nsagadgadaṃ bhītabhītaḥ praṇamya ||", transliteration: "etach chhrutvā vachanaṁ keśhavasya\nkṛitāñjalir vepamānaḥ kirīṭī\nnamaskṛitvā bhūya evāha kṛiṣhṇaṁ\nsa-gadgadaṁ bhīta-bhītaḥ praṇamya", translation_en: "Sanjaya said, Having heard that speech of Lord Krishna, Arjuna, with joined palms, trembling, prostrated himself, again addressing Krishna in a choked voice, bowing down, overwhelmed with fear.", translation_hi: "संजय ने कहा -- केशव भगवान् के इस वचन को सुनकर मुकुटधारी अर्जुन हाथ जोड़े हुए, कांपता हुआ नमस्कार करके पुन: भयभीत हुआ श्रीकृष्ण के प्रति गद्गद् वाणी से बोला।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_035.mp3"},
  {id: "BG_11.36", label: "BG 11.36", ref: "11.36", chapter: 11, verse: 36, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "स्थाने हृषीकेश तव प्रकीर्त्या", snippet: "Arjuna said, \"It is fitting, O Krishna, that the world delights and rejoices in Your praise; demons fly in fear in all directions and the hosts of the perfected ones bow to You.\"", sanskrit: "स्थाने हृषीकेश तव प्रकीर्त्या\nजगत् प्रहृष्यत्यनुरज्यते च ।\nरक्षांसि भीतानि दिशो द्रवन्ति\nसर्वे नमस्यन्ति च सिद्धसङ्घाः ॥", iast: "sthāne hṛṣīkeśa tava prakīrtyā\njagat prahṛṣyatyanurajyate ca |\nrakṣāṃsi bhītāni diśo dravanti\nsarve namasyanti ca siddhasaṅghāḥ ||", transliteration: "sthāne hṛiṣhīkeśha tava prakīrtyā\njagat prahṛiṣhyaty anurajyate cha\nrakṣhānsi bhītāni diśho dravanti\nsarve namasyanti cha siddha-saṅghāḥ", translation_en: "Arjuna said, \"It is fitting, O Krishna, that the world delights and rejoices in Your praise; demons fly in fear in all directions and the hosts of the perfected ones bow to You.\"", translation_hi: "अर्जुन ने कहा -- यह योग्य ही है कि आपके कीर्तन से जगत् अति हर्षित होता है और अनुराग को भी प्राप्त होता है। भयभीत राक्षस लोग समस्त दिशाओं में भागते हैं और समस्त सिद्धगणों के समुदाय आपको नमस्कार करते हैं।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_036.mp3"},
  {id: "BG_11.37", label: "BG 11.37", ref: "11.37", chapter: 11, verse: 37, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "कस्माच्च ते न नमेरन्महात्मन्", snippet: "And why should they not, O great Soul, bow to Thee Who art greater than all else, the primal cause even of the Creator (Brahma), O Infinite Being, O Lord of the gods, O Abode…", sanskrit: "कस्माच्च ते न नमेरन्महात्मन्\nगरीयसे ब्रह्मणोऽप्यादिकर्त्रे ।\nअनन्त देवेश जगन्निवास\nत्वमक्षरं सदसत्तत्परं यत् ॥", iast: "kasmācca te na nameranmahātman\ngarīyase brahmaṇo’pyādikartre |\nananta deveśa jagannivāsa\ntvamakṣaraṃ sadasattatparaṃ yat ||", transliteration: "kasmāch cha te na nameran mahātman\ngarīyase brahmaṇo ’py ādi-kartre\nananta deveśha jagan-nivāsa\ntvam akṣharaṁ sad-asat tat paraṁ yat", translation_en: "And why should they not, O great Soul, bow to Thee Who art greater than all else, the primal cause even of the Creator (Brahma), O Infinite Being, O Lord of the gods, O Abode of the universe; Thou art the imperishable, the Being, the non-being, and That which is supreme—that which is beyond the Being and the non-being.", translation_hi: "हे महात्मन् ! ब्रह्मा के भी आदि कर्ता और सबसे श्रेष्ठ आपके लिए वे कैसे नमस्कार नहीं करें? (क्योंकि) हे अनन्त! हे देवेश! हे जगन्निवास! जो सत् असत् और इन दोनों से परे अक्षरतत्त्व है, वह आप ही हैं।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_037.mp3"},
  {id: "BG_11.38", label: "BG 11.38", ref: "11.38", chapter: 11, verse: 38, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "त्वमादिदेवः पुरुषः पुराण", snippet: "You are the primal God, the ancient Purusha, the supreme refuge of this universe, the knower, the knowable, and the supreme Abode. Through You, the universe is pervaded, O…", sanskrit: "त्वमादिदेवः पुरुषः पुराण\nस्त्वमस्य विश्वस्य परं निधानम् ।\nवेत्तासि वेद्यं च परं च धाम\nत्वया ततं विश्वमनन्तरूप ॥", iast: "tvamādidevaḥ puruṣaḥ purāṇa\nstvamasya viśvasya paraṃ nidhānam |\nvettāsi vedyaṃ ca paraṃ ca dhāma\ntvayā tataṃ viśvamanantarūpa ||", transliteration: "tvam ādi-devaḥ puruṣhaḥ purāṇas\ntvam asya viśhvasya paraṁ nidhānam\nvettāsi vedyaṁ cha paraṁ cha dhāma\ntvayā tataṁ viśhvam ananta-rūpa", translation_en: "You are the primal God, the ancient Purusha, the supreme refuge of this universe, the knower, the knowable, and the supreme Abode. Through You, the universe is pervaded, O Being of infinite forms.", translation_hi: "आप आदिदेव और पुराण (सनातन) पुरुष हैं। आप इस जगत् के परम आश्रय, ज्ञाता, ज्ञेय, (जानने योग्य) और परम धाम हैं। हे अनन्तरूप आपसे ही यह विश्व व्याप्त है।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_038.mp3"},
  {id: "BG_11.39", label: "BG 11.39", ref: "11.39", chapter: 11, verse: 39, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "वायुर्यमोऽग्निर्वरुणः शशाङ्कः", snippet: "You are Vayu, Yama, Agni, Varuna, the moon, the Creator, and the great-grandfather. I offer my salutations to You a thousand times, and again I offer my salutations to You.", sanskrit: "वायुर्यमोऽग्निर्वरुणः शशाङ्कः\nप्रजापतिस्त्वं प्रपितामहश्च ।\nनमो नमस्तेऽस्तु सहस्रकृत्वः\nपुनश्च भूयोऽपि नमो नमस्ते ॥", iast: "vāyuryamo’gnirvaruṇaḥ śaśāṅkaḥ\nprajāpatistvaṃ prapitāmahaśca |\nnamo namaste’stu sahasrakṛtvaḥ\npunaśca bhūyo’pi namo namaste ||", transliteration: "vāyur yamo ’gnir varuṇaḥ śhaśhāṅkaḥ\nprajāpatis tvaṁ prapitāmahaśh cha\nnamo namas te ’stu sahasra-kṛitvaḥ\npunaśh cha bhūyo ’pi namo namas te", translation_en: "You are Vayu, Yama, Agni, Varuna, the moon, the Creator, and the great-grandfather. I offer my salutations to You a thousand times, and again I offer my salutations to You.", translation_hi: "आप वायु, यम, अग्नि, वरुण, चन्द्रमा, प्रजापति (ब्रह्मा) और प्रपितामह (ब्रह्मा के भी कारण) हैं; आपके लिए सहस्र बार नमस्कार, नमस्कार है, पुन: आपको बारम्बार नमस्कार, नमस्कार है।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_039.mp3"},
  {id: "BG_11.40", label: "BG 11.40", ref: "11.40", chapter: 11, verse: 40, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "नमः पुरस्तादथ पृष्ठतस्ते", snippet: "Salutations to You in front and behind! Salutations to You on every side! O All! You, infinite in power and prowess, pervade all; therefore You are all.", sanskrit: "नमः पुरस्तादथ पृष्ठतस्ते\nनमोऽस्तु ते सर्वत एव सर्व ।\nअनन्तवीर्यामितविक्रमस्त्वं\nसर्वं समाप्नोषि ततोऽसि सर्वः ॥", iast: "namaḥ purastādatha pṛṣṭhataste\nnamo’stu te sarvata eva sarva |\nanantavīryāmitavikramastvaṃ\nsarvaṃ samāpnoṣi tato’si sarvaḥ ||", transliteration: "namaḥ purastād atha pṛiṣhṭhatas te\nnamo ’stu te sarvata eva sarva\nananta-vīryāmita-vikramas tvaṁ\nsarvaṁ samāpnoṣhi tato ’si sarvaḥ", translation_en: "Salutations to You in front and behind! Salutations to You on every side! O All! You, infinite in power and prowess, pervade all; therefore You are all.", translation_hi: "हे अनन्तसार्मथ्य वाले भगवन्! आपके लिए अग्रत: और पृष्ठत: नमस्कार है, हे सर्वात्मन्! आपको सब ओर से नमस्कार है। आप अमित विक्रमशाली हैं और आप सबको व्याप्त किये हुए हैं, इससे आप सर्वरूप हैं।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_040.mp3"},
  {id: "BG_11.41", label: "BG 11.41", ref: "11.41", chapter: 11, verse: 41, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "सखेति मत्वा प्रसभं यदुक्तं", snippet: "Whatever I have presumptuously said from carelessness or love, addressing You as O Krishna! O Yadava! O Friend! regarding You merely as a friend, unknowing of Your greatness.", sanskrit: "सखेति मत्वा प्रसभं यदुक्तं\nहे कृष्ण हे यादव हे सखेति ।\nअजानता महिमानं तवेदं\nमया प्रमादात्प्रणयेन वापि ॥", iast: "sakheti matvā prasabhaṃ yaduktaṃ\nhe kṛṣṇa he yādava he sakheti |\najānatā mahimānaṃ tavedaṃ\nmayā pramādātpraṇayena vāpi ||", transliteration: "sakheti matvā prasabhaṁ yad uktaṁ\nhe kṛiṣhṇa he yādava he sakheti\najānatā mahimānaṁ tavedaṁ\nmayā pramādāt praṇayena vāpi", translation_en: "Whatever I have presumptuously said from carelessness or love, addressing You as O Krishna! O Yadava! O Friend! regarding You merely as a friend, unknowing of Your greatness.", translation_hi: "हे भगवन्! आपको सखा मानकर आपकी इस महिमा को न जानते हुए मेरे द्वारा प्रमाद से अथवा प्रेम से भी \"हे कृष्ण हे! यादव हे सखे!\" इस प्रकार जो कुछ बलात् कहा गया है।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_041.mp3"},
  {id: "BG_11.42", label: "BG 11.42", ref: "11.42", chapter: 11, verse: 42, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "यच्चावहासार्थमसत्कृतोऽसि", snippet: "In whatever way I may have insulted You for the sake of fun, while at play, reposing, sitting, or at meals, when alone (with You), O Krishna, or in company, that I implore You,…", sanskrit: "यच्चावहासार्थमसत्कृतोऽसि\nविहारशय्यासनभोजनेषु ।\nएकोऽथवाप्यच्युत तत्समक्षं\nतत्क्षामये त्वामहमप्रमेयम् ॥", iast: "yaccāvahāsārthamasatkṛto’si\nvihāraśayyāsanabhojaneṣu |\neko’thavāpyacyuta tatsamakṣaṃ\ntatkṣāmaye tvāmahamaprameyam ||", transliteration: "yach chāvahāsārtham asat-kṛito ’si\nvihāra-śhayyāsana-bhojaneṣhu\neko ’tha vāpy achyuta tat-samakṣhaṁ\ntat kṣhāmaye tvām aham aprameyam", translation_en: "In whatever way I may have insulted You for the sake of fun, while at play, reposing, sitting, or at meals, when alone (with You), O Krishna, or in company, that I implore You, immeasurable one, to forgive.", translation_hi: "और, हे अच्युत! जो आप मेरे द्वारा हँसी के लिये बिहार, शय्या, आसन और भोजन के समय अकेले में अथवा अन्यों के समक्ष भी अपमानित किये गये हैं, उन सब के लिए अप्रमेय स्वरूप आप से मैं क्षमायाचना करता हूँ।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_042.mp3"},
  {id: "BG_11.43", label: "BG 11.43", ref: "11.43", chapter: 11, verse: 43, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "पितासि लोकस्य चराचरस्य", snippet: "Thou art the Father of this world, both moving and unmoving. Thou art to be adored by this world; Thou, the greatest Guru; for none exists who is equal to Thee; how then could…", sanskrit: "पितासि लोकस्य चराचरस्य\nत्वमस्य पूज्यश्च गुरुर्गरीयान् ।\nन त्वत्समोऽस्त्यभ्यधिकः कुतोऽन्यो\nलोकत्रयेऽप्यप्रतिमप्रभाव ॥", iast: "pitāsi lokasya carācarasya\ntvamasya pūjyaśca gururgarīyān |\nna tvatsamo’styabhyadhikaḥ kuto’nyo\nlokatraye’pyapratimaprabhāva ||", transliteration: "pitāsi lokasya charācharasya\ntvam asya pūjyaśh cha gurur garīyān\nna tvat-samo ’sty abhyadhikaḥ kuto ’nyo\nloka-traye ’py apratima-prabhāva", translation_en: "Thou art the Father of this world, both moving and unmoving. Thou art to be adored by this world; Thou, the greatest Guru; for none exists who is equal to Thee; how then could there be another superior to Thee in the three worlds, O Being of unrivaled power?", translation_hi: "आप इस चराचर जगत् के पिता, पूजनीय और सर्वश्रेष्ठ गुरु हैं। हे अप्रितम प्रभाव वाले भगवन्! तीनों लोकों में आपके समान भी कोई नहीं हैं, तो फिर आपसे अधिक श्रेष्ठ कैसे होगा?।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_043.mp3"},
  {id: "BG_11.44", label: "BG 11.44", ref: "11.44", chapter: 11, verse: 44, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "तस्मात्प्रणम्य प्रणिधाय कायं", snippet: "Therefore, bowing down and prostrating my body, I crave Thy forgiveness, O adorable Lord. As a father forgives his son, a friend his dear friend, a lover his beloved, even so…", sanskrit: "तस्मात्प्रणम्य प्रणिधाय कायं\nप्रसादये त्वामहमीशमीड्यम् ।\nपितेव पुत्रस्य सखेव सख्युः\nप्रियः प्रियायार्हसि देव सोढुम् ॥", iast: "tasmātpraṇamya praṇidhāya kāyaṃ\nprasādaye tvāmahamīśamīḍyam |\npiteva putrasya sakheva sakhyuḥ\npriyaḥ priyāyārhasi deva soḍhum ||", transliteration: "tasmāt praṇamya praṇidhāya kāyaṁ\nprasādaye tvām aham īśham īḍyam\npiteva putrasya sakheva sakhyuḥ\npriyaḥ priyāyārhasi deva soḍhum", translation_en: "Therefore, bowing down and prostrating my body, I crave Thy forgiveness, O adorable Lord. As a father forgives his son, a friend his dear friend, a lover his beloved, even so may Thou forgive me, O God.", translation_hi: "इसलिये हे भगवन्! मैं शरीर के द्वारा साष्टांग प्रणिपात करके स्तुति के योग्य आप ईश्वर को प्रसन्न होने के लिये प्रार्थना करता हूँ। हे देव! जैसे पिता पुत्र के, मित्र अपने मित्र के और प्रिय अपनी प्रिया के(अपराध को क्षमा करता है), वैसे ही आप भी मेरे अपराधों को क्षमा कीजिये।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_044.mp3"},
  {id: "BG_11.45", label: "BG 11.45", ref: "11.45", chapter: 11, verse: 45, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "अदृष्टपूर्वं हृषितोऽस्मि दृष्ट्वा", snippet: "I am delighted, having seen something never seen before; yet my mind is distressed with fear. Show me that form only, O God; have mercy, O God of gods, O Abode of the universe.", sanskrit: "अदृष्टपूर्वं हृषितोऽस्मि दृष्ट्वा\nभयेन च प्रव्यथितं मनो मे ।\nतदेव मे दर्शय देव रूपं\nप्रसीद देवेश जगन्निवास ॥", iast: "adṛṣṭapūrvaṃ hṛṣito’smi dṛṣṭvā\nbhayena ca pravyathitaṃ mano me |\ntadeva me darśaya deva rūpaṃ\nprasīda deveśa jagannivāsa ||", transliteration: "adṛiṣhṭa-pūrvaṁ hṛiṣhito ’smi dṛiṣhṭvā\nbhayena cha pravyathitaṁ mano me\ntad eva me darśhaya deva rūpaṁ\nprasīda deveśha jagan-nivāsa", translation_en: "I am delighted, having seen something never seen before; yet my mind is distressed with fear. Show me that form only, O God; have mercy, O God of gods, O Abode of the universe.", translation_hi: "मैं आपके इस अदृष्टपूर्व रूप को देखकर हर्षित हो रहा हूँ और मेरा मन भय से अतिव्याकुल भी हो रहा हैं। इसलिए हे देव! आप उस पूर्वकाल को ही मुझे दिखाइये। हे देवेश! हे जगन्निवास! आप प्रसन्न होइये।।", meter_name: "Triṣṭubh — Upendravajrā", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_045.mp3"},
  {id: "BG_11.46", label: "BG 11.46", ref: "11.46", chapter: 11, verse: 46, speaker: "arjuna", canonical: true, meter: "tristubh", sa: "किरीटिनं गदिनं चक्रहस्त", snippet: "I desire to see You as before, crowned, bearing a mace, with the discus in hand, in Your former form only, having four arms, O thousand-armed, Cosmic Being.", sanskrit: "किरीटिनं गदिनं चक्रहस्त\nमिच्छामि त्वां द्रष्टुमहं तथैव ।\nतेनैव रूपेण चतुर्भुजेन\nसहस्रबाहो भव विश्वमूर्ते ॥", iast: "kirīṭinaṃ gadinaṃ cakrahasta\nmicchāmi tvāṃ draṣṭumahaṃ tathaiva |\ntenaiva rūpeṇa caturbhujena\nsahasrabāho bhava viśvamūrte ||", transliteration: "kirīṭinaṁ gadinaṁ chakra-hastam\nichchhāmi tvāṁ draṣhṭum ahaṁ tathaiva\ntenaiva rūpeṇa chatur-bhujena\nsahasra-bāho bhava viśhva-mūrte", translation_en: "I desire to see You as before, crowned, bearing a mace, with the discus in hand, in Your former form only, having four arms, O thousand-armed, Cosmic Being.", translation_hi: "मैं आपको उसी प्रकार मुकुटधारी, गदा और चक्र हाथ में लिए हुए देखना चाहता हूँ। हे विश्वमूर्ते! हे सहस्रबाहो! आप उस चतुर्भुजरूप के ही बन जाइए।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_046.mp3"},
  {id: "BG_11.47", label: "BG 11.47", ref: "11.47", chapter: 11, verse: 47, speaker: "krishna", canonical: true, meter: "tristubh", sa: "मया प्रसन्नेन तवार्जुनेदं", snippet: "The Blessed Lord said, \"O Arjuna, this Cosmic Form has graciously been shown to you by Me through My own Yogic power. It is full of splendour, primeval, and infinite; this…", sanskrit: "मया प्रसन्नेन तवार्जुनेदं\nरूपं परं दर्शितमात्मयोगात् ।\nतेजोमयं विश्वमनन्तमाद्यं\nयन्मे त्वदन्येन न दृष्टपूर्वम् ॥", iast: "mayā prasannena tavārjunedaṃ\nrūpaṃ paraṃ darśitamātmayogāt |\ntejomayaṃ viśvamanantamādyaṃ\nyanme tvadanyena na dṛṣṭapūrvam ||", transliteration: "mayā prasannena tavārjunedaṁ\nrūpaṁ paraṁ darśhitam ātma-yogāt\ntejo-mayaṁ viśhvam anantam ādyaṁ\nyan me tvad anyena na dṛiṣhṭa-pūrvam", translation_en: "The Blessed Lord said, \"O Arjuna, this Cosmic Form has graciously been shown to you by Me through My own Yogic power. It is full of splendour, primeval, and infinite; this Cosmic Form of Mine has never been seen before by anyone other than you.\"", translation_hi: "हे अर्जुन! तुम पर प्रसन्न होकर मैंने अपनी योगशक्ति (आत्मयोगात्) के प्रभाव से यह अपना परम तेजोमय, सबका आदि और अनन्त विश्वरूप तुझे दर्शाया है, जिसे तुम्हारे पूर्व किसी ने नहीं देखा है।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_047.mp3"},
  {id: "BG_11.48", label: "BG 11.48", ref: "11.48", chapter: 11, verse: 48, speaker: "krishna", canonical: true, meter: "tristubh", sa: "न वेदयज्ञाध्ययनैर्न दानै", snippet: "Neither by the study of the Vedas, nor by gifts, nor by sacrifices, nor by severe austerities, can I be seen in this form in the world of men by any other than yourself, O…", sanskrit: "न वेदयज्ञाध्ययनैर्न दानै\nर्न च क्रियाभिर्न तपोभिरुग्रैः ।\nएवंरूपः शक्य अहं नृलोके\nद्रष्टुं त्वदन्येन कुरुप्रवीर ॥", iast: "na vedayajñādhyayanairna dānai\nrna ca kriyābhirna tapobhirugraiḥ |\nevaṃrūpaḥ śakya ahaṃ nṛloke\ndraṣṭuṃ tvadanyena kurupravīra ||", transliteration: "na veda-yajñādhyayanair na dānair\nna cha kriyābhir na tapobhir ugraiḥ\nevaṁ-rūpaḥ śhakya ahaṁ nṛi-loke\ndraṣhṭuṁ tvad anyena kuru-pravīra", translation_en: "Neither by the study of the Vedas, nor by gifts, nor by sacrifices, nor by severe austerities, can I be seen in this form in the world of men by any other than yourself, O great hero of the Kurus (Arjuna).", translation_hi: "हे कुरुप्रवीर! तुम्हारे अतिरिक्त इस मनुष्य लोक में किसी अन्य के द्वारा मैं इस रूप में, न वेदाध्ययन और न यज्ञ, न दान और न (धार्मिक) क्रियायों के द्वारा और न उग्र तपों के द्वारा ही देखा जा सकता हूँ।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_048.mp3"},
  {id: "BG_11.49", label: "BG 11.49", ref: "11.49", chapter: 11, verse: 49, speaker: "krishna", canonical: true, meter: "tristubh", sa: "मा ते व्यथा मा च विमूढभावो", snippet: "Do not be afraid, nor be bewildered on seeing such a terrible form of Mine; with your fear dispelled and with a gladdened heart, now behold again this former form of Mine.", sanskrit: "मा ते व्यथा मा च विमूढभावो\nदृष्ट्वा रूपं घोरमीदृङ्ममेदम् ।\nव्यपेतभीः प्रीतमनाः पुनस्त्वं\nतदेव मे रूपमिदं प्रपश्य ॥", iast: "mā te vyathā mā ca vimūḍhabhāvo\ndṛṣṭvā rūpaṃ ghoramīdṛṅmamedam |\nvyapetabhīḥ prītamanāḥ punastvaṃ\ntadeva me rūpamidaṃ prapaśya ||", transliteration: "mā te vyathā mā cha vimūḍha-bhāvo\ndṛiṣhṭvā rūpaṁ ghoram īdṛiṅ mamedam\nvyapeta-bhīḥ prīta-manāḥ punas tvaṁ\ntad eva me rūpam idaṁ prapaśhya", translation_en: "Do not be afraid, nor be bewildered on seeing such a terrible form of Mine; with your fear dispelled and with a gladdened heart, now behold again this former form of Mine.", translation_hi: "इस प्रकार मेरे इस घोर रूप को देखकर तुम व्यथा और मूढ़भाव को मत प्राप्त हो। निर्भय और प्रसन्नचित्त होकर तुम पुन: मेरे उसी (पूर्व के) रूप को देखो।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_049.mp3"},
  {id: "BG_11.50", label: "BG 11.50", ref: "11.50", chapter: 11, verse: 50, speaker: "sanjaya", canonical: true, meter: "tristubh", sa: "इत्यर्जुनं वासुदेवस्तथोक्त्वा", snippet: "Sanjaya said, Having thus spoken to Arjuna, Krishna again showed His own form. The great Soul, assuming His gentle form, then consoled Arjuna, who was terrified.", sanskrit: "इत्यर्जुनं वासुदेवस्तथोक्त्वा\nस्वकं रूपं दर्शयामास भूयः ।\nआश्वासयामास च भीतमेनं\nभूत्वा पुनः सौम्यवपुर्महात्मा ॥", iast: "ityarjunaṃ vāsudevastathoktvā\nsvakaṃ rūpaṃ darśayāmāsa bhūyaḥ |\nāśvāsayāmāsa ca bhītamenaṃ\nbhūtvā punaḥ saumyavapurmahātmā ||", transliteration: "ity arjunaṁ vāsudevas tathoktvā\nsvakaṁ rūpaṁ darśhayām āsa bhūyaḥ\nāśhvāsayām āsa cha bhītam enaṁ\nbhūtvā punaḥ saumya-vapur mahātmā", translation_en: "Sanjaya said, Having thus spoken to Arjuna, Krishna again showed His own form. The great Soul, assuming His gentle form, then consoled Arjuna, who was terrified.", translation_hi: "संजय ने कहा -- भगवान् वासुदेव ने अर्जुन से इस प्रकार कहकर, पुन: अपने (पूर्व) रूप को दर्शाया, और फिर, सौम्यरूप महात्मा श्रीकृष्ण ने इस भयभीत अर्जुन को आश्वस्त किया।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_050.mp3"},
  {id: "BG_11.51", label: "BG 11.51", ref: "11.51", chapter: 11, verse: 51, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "दृष्ट्वेदं मानुषं रूपं तवसौम्यं जनार्दन", snippet: "Arjuna said, \"Having seen this Thy gentle human form, O Krishna, now I am composed and have been restored to my own nature.\"", sanskrit: "दृष्ट्वेदं मानुषं रूपं तवसौम्यं जनार्दन ।\nइदानीमस्मि संवृत्तः सचेताः प्रकृतिं गतः ॥", iast: "dṛṣṭvedaṃ mānuṣaṃ rūpaṃ tavasaumyaṃ janārdana |\nidānīmasmi saṃvṛttaḥ sacetāḥ prakṛtiṃ gataḥ ||", transliteration: "dṛiṣhṭvedaṁ mānuṣhaṁ rūpaṁ tava saumyaṁ janārdana\nidānīm asmi saṁvṛittaḥ sa-chetāḥ prakṛitiṁ gataḥ", translation_en: "Arjuna said, \"Having seen this Thy gentle human form, O Krishna, now I am composed and have been restored to my own nature.\"", translation_hi: "अर्जुन ने कहा -- हे जनार्दन! आपके इस सौम्य मनुष्य रूप को देखकर अब मैं शांतचित्त हुआ अपने स्वभाव को प्राप्त हो गया हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_051.mp3"},
  {id: "BG_11.52", label: "BG 11.52", ref: "11.52", chapter: 11, verse: 52, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सुदुर्दर्शमिदं रूपं दृष्टवानसि यन्मम", snippet: "The Blessed Lord said, \"It is very hard indeed to see this form of Mine which thou hast seen; even the gods are ever longing to behold it.\"", sanskrit: "सुदुर्दर्शमिदं रूपं दृष्टवानसि यन्मम ।\nदेवा अप्यस्य रूपस्य नित्यं दर्शनकाङ्क्षिणः ॥", iast: "sudurdarśamidaṃ rūpaṃ dṛṣṭavānasi yanmama |\ndevā apyasya rūpasya nityaṃ darśanakāṅkṣiṇaḥ ||", transliteration: "su-durdarśham idaṁ rūpaṁ dṛiṣhṭavān asi yan mama\ndevā apy asya rūpasya nityaṁ darśhana-kāṅkṣhiṇaḥ", translation_en: "The Blessed Lord said, \"It is very hard indeed to see this form of Mine which thou hast seen; even the gods are ever longing to behold it.\"", translation_hi: "श्रीभगवान् ने कहा -- मेरा यह रूप देखने को मिलना अति दुर्लभ है, जिसको कि तुमने देखा है। देवतागण भी सदा इस रूप के दर्शन के इच्छुक रहते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_052.mp3"},
  {id: "BG_11.53", label: "BG 11.53", ref: "11.53", chapter: 11, verse: 53, speaker: "krishna", canonical: true, meter: "anustubh", sa: "नाहं वेदैर्न तपसा न दानेन न चेज्यया", snippet: "Neither by the Vedas, nor by austerity, nor by gift, nor by sacrifice can I be seen in this form as thou hast seen Me so easily.", sanskrit: "नाहं वेदैर्न तपसा न दानेन न चेज्यया ।\nशक्य एवंविधो द्रष्टुं दृष्टवानसि मां यथा ॥", iast: "nāhaṃ vedairna tapasā na dānena na cejyayā |\nśakya evaṃvidho draṣṭuṃ dṛṣṭavānasi māṃ yathā ||", transliteration: "nāhaṁ vedair na tapasā na dānena na chejyayā\nśhakya evaṁ-vidho draṣhṭuṁ dṛiṣhṭavān asi māṁ yathā", translation_en: "Neither by the Vedas, nor by austerity, nor by gift, nor by sacrifice can I be seen in this form as thou hast seen Me so easily.", translation_hi: "न वेदों से, न तप से, न दान से और न यज्ञ से ही मैं इस प्रकार देखा जा सकता हूँ, जैसा कि तुमने मुझे देखा है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_053.mp3"},
  {id: "BG_11.54", label: "BG 11.54", ref: "11.54", chapter: 11, verse: 54, speaker: "krishna", canonical: true, meter: "anustubh", sa: "भक्त्या त्वनन्यया शक्यमहमेवंविधोऽर्जुन", snippet: "But by single-minded devotion, I can be known, seen, and entered into in reality, O Arjuna.", sanskrit: "भक्त्या त्वनन्यया शक्यमहमेवंविधोऽर्जुन ।\nज्ञातुं दृष्टुं च तत्त्वेन प्रवेष्टुं च परंतप ॥", iast: "bhaktyā tvananyayā śakyamahamevaṃvidho’rjuna |\njñātuṃ dṛṣṭuṃ ca tattvena praveṣṭuṃ ca paraṃtapa ||", transliteration: "bhaktyā tv ananyayā śhakya aham evaṁ-vidho ’rjuna\njñātuṁ draṣhṭuṁ cha tattvena praveṣhṭuṁ cha parantapa", translation_en: "But by single-minded devotion, I can be known, seen, and entered into in reality, O Arjuna.", translation_hi: "परन्तु हे परन्तप अर्जुन! अनन्य भक्ति के द्वारा मैं तत्त्वत: 'जानने', 'देखने' और 'प्रवेश' करने के लिए (एकी भाव से प्राप्त होने के लिए) भी, शक्य हूँ!।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_054.mp3"},
  {id: "BG_11.55", label: "BG 11.55", ref: "11.55", chapter: 11, verse: 55, speaker: "krishna", canonical: true, meter: "anustubh", sa: "मत्कर्मकृन्मत्परमो मद्भक्तः सङ्गवर्जितः", snippet: "He who does all actions for Me, who regards Me as the Supreme, who is devoted to Me, who is free from attachment, who bears no enmity towards any creature, he comes to Me, O…", sanskrit: "मत्कर्मकृन्मत्परमो मद्भक्तः सङ्गवर्जितः ।\nनिर्वैरः सर्वभूतेषु यः स मामेति पाण्डव ॥", iast: "matkarmakṛnmatparamo madbhaktaḥ saṅgavarjitaḥ |\nnirvairaḥ sarvabhūteṣu yaḥ sa māmeti pāṇḍava ||", transliteration: "mat-karma-kṛin mat-paramo mad-bhaktaḥ saṅga-varjitaḥ\nnirvairaḥ sarva-bhūteṣhu yaḥ sa mām eti pāṇḍava", translation_en: "He who does all actions for Me, who regards Me as the Supreme, who is devoted to Me, who is free from attachment, who bears no enmity towards any creature, he comes to Me, O Arjuna.", translation_hi: "हे पाण्डव! जो पुरुष मेरे लिए ही कर्म करने वाला है, और मुझे ही परम लक्ष्य मानता है, जो मेरा भक्त है तथा संगरहित है, जो भूतमात्र के प्रति निर्वैर है, वह मुझे प्राप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/011_055.mp3"},
  {id: "BG_12.1", label: "BG 12.1", ref: "12.1", chapter: 12, verse: 1, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "एवं सततयुक्ता ये भक्तास्त्वां पर्युपासते", snippet: "Arjuna said, \"Which of them are better versed in Yoga—those who steadfastly worship You, or those who worship the imperishable and the unmanifested?\"", sanskrit: "एवं सततयुक्ता ये भक्तास्त्वां पर्युपासते ।\nयेचाप्यक्षरमव्यक्तं तेषां के योगवित्तमाः ॥", iast: "evaṃ satatayuktā ye bhaktāstvāṃ paryupāsate |\nyecāpyakṣaramavyaktaṃ teṣāṃ ke yogavittamāḥ ||", transliteration: "evaṁ satata-yuktā ye bhaktās tvāṁ paryupāsate\nye chāpy akṣharam avyaktaṁ teṣhāṁ ke yoga-vittamāḥ", translation_en: "Arjuna said, \"Which of them are better versed in Yoga—those who steadfastly worship You, or those who worship the imperishable and the unmanifested?\"", translation_hi: "अर्जुन ने कहा -- जो भक्त, सतत युक्त होकर इस (पूर्वोक्त) प्रकार से आपकी उपासना करते हैं और जो भक्त अक्षर, और अव्यक्त की उपासना करते हैं, उन दोनों में कौन उत्तम योगवित् है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/012_001.mp3"},
  {id: "BG_12.2", label: "BG 12.2", ref: "12.2", chapter: 12, verse: 2, speaker: "krishna", canonical: true, meter: "anustubh", sa: "मय्यावेश्य मनो ये मां नित्ययुक्ता उपासते", snippet: "The Blessed Lord said, \"In My opinion, those who fix their minds on Me, worship Me ever steadfastly, and are endowed with supreme faith, are the best in Yoga.\"", sanskrit: "मय्यावेश्य मनो ये मां नित्ययुक्ता उपासते ।\nश्रद्धया परयोपेतास्ते मे युक्ततमा मताः ॥", iast: "mayyāveśya mano ye māṃ nityayuktā upāsate |\nśraddhayā parayopetāste me yuktatamā matāḥ ||", transliteration: "mayy āveśhya mano ye māṁ nitya-yuktā upāsate\nśhraddhayā parayopetās te me yuktatamā matāḥ", translation_en: "The Blessed Lord said, \"In My opinion, those who fix their minds on Me, worship Me ever steadfastly, and are endowed with supreme faith, are the best in Yoga.\"", translation_hi: "श्रीभगवान् ने कहा -- मुझमें मन को एकाग्र करके नित्ययुक्त हुए जो भक्तजन परम श्रद्धा से युक्त होकर मेरी उपासना करते हैं, वे, मेरे मत से, युक्ततम हैं अर्थात् श्रेष्ठ हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/012_002.mp3"},
  {id: "BG_12.3", label: "BG 12.3", ref: "12.3", chapter: 12, verse: 3, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ये त्वक्षरमनिर्देश्यमव्यक्तं पर्युपासते", snippet: "Those who worship the imperishable, the indefinable, the unmanifest, the omnipresent, the unthinkable, the immovable, and the eternal.", sanskrit: "ये त्वक्षरमनिर्देश्यमव्यक्तं पर्युपासते ।\nसर्वत्रगमचिन्त्यं च कूटस्थमचलं ध्रुवम् ॥", iast: "ye tvakṣaramanirdeśyamavyaktaṃ paryupāsate |\nsarvatragamacintyaṃ ca kūṭasthamacalaṃ dhruvam ||", transliteration: "ye tv akṣharam anirdeśhyam avyaktaṁ paryupāsate\nsarvatra-gam achintyañcha kūṭa-stham achalandhruvam\nsanniyamyendriya-grāmaṁ sarvatra sama-buddhayaḥ\nte prāpnuvanti mām eva sarva-bhūta-hite ratāḥ", translation_en: "Those who worship the imperishable, the indefinable, the unmanifest, the omnipresent, the unthinkable, the immovable, and the eternal.", translation_hi: "परन्तु जो भक्त अक्षर ,अनिर्देश्य, अव्यक्त, सर्वगत, अचिन्त्य, कूटस्थ, अचल और ध्रुव की उपासना करते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/012_003.mp3"},
  {id: "BG_12.4", label: "BG 12.4", ref: "12.4", chapter: 12, verse: 4, speaker: "krishna", canonical: true, meter: "anustubh", sa: "संनियम्येन्द्रियग्रामं सर्वत्र समबुद्धयः", snippet: "Having restrained all the senses, being even-minded everywhere, and intent on the welfare of all beings, they verily come unto Me.", sanskrit: "संनियम्येन्द्रियग्रामं सर्वत्र समबुद्धयः ।\nते प्राप्नुवन्ति मामेव सर्वभूतहिते रताः ॥", iast: "saṃniyamyendriyagrāmaṃ sarvatra samabuddhayaḥ |\nte prāpnuvanti māmeva sarvabhūtahite ratāḥ ||", transliteration: "sanniyamyendriya-grāmaṁ  sarvatra    sama-buddhayaḥ  te  prāpnuvanti mām eva sarva-bhūta-hite    ratāḥ", translation_en: "Having restrained all the senses, being even-minded everywhere, and intent on the welfare of all beings, they verily come unto Me.", translation_hi: "इन्द्रिय समुदाय को सम्यक् प्रकार से नियमित करके, सर्वत्र समभाव वाले, भूतमात्र के हित में रत वे भक्त मुझे ही प्राप्त होते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/012_004.mp3"},
  {id: "BG_12.5", label: "BG 12.5", ref: "12.5", chapter: 12, verse: 5, speaker: "krishna", canonical: true, meter: "anustubh", sa: "क्लेशोऽधिकतरस्तेषामव्यक्तासक्तचेतसाम्", snippet: "Greater is their trouble whose minds are set on the unmanifested, for the goal of the unmanifested is very hard for the embodied to reach.", sanskrit: "क्लेशोऽधिकतरस्तेषामव्यक्तासक्तचेतसाम् ।\nअव्यक्ता हि गतिर्दुःखं देहवद्भिरवाप्यते ॥", iast: "kleśo’dhikatarasteṣāmavyaktāsaktacetasām |\navyaktā hi gatirduḥkhaṃ dehavadbhiravāpyate ||", transliteration: "kleśho ’dhikataras teṣhām avyaktāsakta-chetasām\navyaktā hi gatir duḥkhaṁ dehavadbhir avāpyate", translation_en: "Greater is their trouble whose minds are set on the unmanifested, for the goal of the unmanifested is very hard for the embodied to reach.", translation_hi: "परन्तु उन अव्यक्त में आसक्त हुए चित्त वाले पुरुषों को क्लेश अधिक होता है, क्योंकि देहधारियों से अव्यक्त की गति कठिनाईपूर्वक प्राप्त की जाती है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/012_005.mp3"},
  {id: "BG_12.6", label: "BG 12.6", ref: "12.6", chapter: 12, verse: 6, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ये तु सर्वाणि कर्माणि मयि संन्यस्य मत्पराः", snippet: "But to those who worship Me, renouncing all actions in Me, regarding Me as the supreme goal, meditating on Me with single-minded yoga.", sanskrit: "ये तु सर्वाणि कर्माणि मयि संन्यस्य मत्पराः ।\nअनन्येनैव योगेन मां ध्यायन्त उपासते ॥", iast: "ye tu sarvāṇi karmāṇi mayi saṃnyasya matparāḥ |\nananyenaiva yogena māṃ dhyāyanta upāsate ||", transliteration: "ye tu sarvāṇi karmāṇi mayi sannyasya mat-paraḥ\nananyenaiva yogena māṁ dhyāyanta upāsate", translation_en: "But to those who worship Me, renouncing all actions in Me, regarding Me as the supreme goal, meditating on Me with single-minded yoga.", translation_hi: "परन्तु जो भक्तजन मुझे ही परम लक्ष्य समझते हुए सब कर्मों को मुझे अर्पण करके अनन्ययोग के द्वारा मेरा (सगुण का) ही ध्यान करते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/012_006.mp3"},
  {id: "BG_12.7", label: "BG 12.7", ref: "12.7", chapter: 12, verse: 7, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तेषामहं समुद्धर्ता मृत्युसंसारसागरात्", snippet: "To those whose minds are set on Me, O Arjuna, verily I soon become the savior out of the ocean of Samsara.", sanskrit: "तेषामहं समुद्धर्ता मृत्युसंसारसागरात् ।\nभवामि नचिरात्पार्थ मय्यावेशितचेतसाम् ॥", iast: "teṣāmahaṃ samuddhartā mṛtyusaṃsārasāgarāt |\nbhavāmi nacirātpārtha mayyāveśitacetasām ||", transliteration: "teṣhām ahaṁ samuddhartā mṛityu-saṁsāra-sāgarāt\nbhavāmi na chirāt pārtha mayy āveśhita-chetasām", translation_en: "To those whose minds are set on Me, O Arjuna, verily I soon become the savior out of the ocean of Samsara.", translation_hi: "हे पार्थ ! जिनका चित्त मुझमें ही स्थिर हुआ है ऐसे भक्तों का मैं शीघ्र ही मृत्युरूप संसार सागर से उद्धार करने वाला होता हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/012_007.mp3"},
  {id: "BG_12.8", label: "BG 12.8", ref: "12.8", chapter: 12, verse: 8, speaker: "krishna", canonical: true, meter: "anustubh", sa: "मय्येव मन आधत्स्व मयि बुद्धिं निवेशय", snippet: "Fix your mind on Me, and your intellect in Me. Then you will certainly live in Me alone hereafter.", sanskrit: "मय्येव मन आधत्स्व मयि बुद्धिं निवेशय ।\nनिवसिष्यसि मय्येव अत ऊर्ध्वं न संशयः ॥", iast: "mayyeva mana ādhatsva mayi buddhiṃ niveśaya |\nnivasiṣyasi mayyeva ata ūrdhvaṃ na saṃśayaḥ ||", transliteration: "mayy eva mana ādhatsva mayi buddhiṁ niveśhaya\nnivasiṣhyasi mayy eva ata ūrdhvaṁ na sanśhayaḥ", translation_en: "Fix your mind on Me, and your intellect in Me. Then you will certainly live in Me alone hereafter.", translation_hi: "तुम अपने मन और बुद्धि को मुझमें ही स्थिर करो, तदुपरान्त तुम मुझमें ही निवास करोगे, इसमें कोई संशय नहीं है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/012_008.mp3"},
  {id: "BG_12.9", label: "BG 12.9", ref: "12.9", chapter: 12, verse: 9, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अथ चित्तं समाधातुं न शक्नोषि मयि स्थिरम्", snippet: "If you are unable to fix your mind steadily on Me, then seek to reach Me through the yoga of constant practice, O Arjuna.", sanskrit: "अथ चित्तं समाधातुं न शक्नोषि मयि स्थिरम् ।\nअभ्यासयोगेन ततो मामिच्छाप्तुं धनञ्जय ॥", iast: "atha cittaṃ samādhātuṃ na śaknoṣi mayi sthiram |\nabhyāsayogena tato māmicchāptuṃ dhanañjaya ||", transliteration: "atha chittaṁ samādhātuṁ na śhaknoṣhi mayi sthiram\nabhyāsa-yogena tato mām ichchhāptuṁ dhanañjaya", translation_en: "If you are unable to fix your mind steadily on Me, then seek to reach Me through the yoga of constant practice, O Arjuna.", translation_hi: "हे धनंजय ! यदि तुम अपने मन को मुझमें स्थिर करने में समर्थ नहीं हो, तो अभ्यासयोग के द्वारा तुम मुझे प्राप्त करने की इच्छा (अर्थात् प्रयत्न) करो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/012_009.mp3"},
  {id: "BG_12.10", label: "BG 12.10", ref: "12.10", chapter: 12, verse: 10, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अभ्यासेऽप्यसमर्थोऽसि मत्कर्मपरमो भव", snippet: "If you are unable to practice even this Abhyasa Yoga, be intent on doing actions for My sake; even by doing actions for My sake, you will attain perfection.", sanskrit: "अभ्यासेऽप्यसमर्थोऽसि मत्कर्मपरमो भव ।\nमदर्थमपि कर्माणि कुर्वन् सिद्धिमवाप्स्यसि ॥", iast: "abhyāse’pyasamartho’si matkarmaparamo bhava |\nmadarthamapi karmāṇi kurvan siddhimavāpsyasi ||", transliteration: "abhyāse ’py asamartho ’si mat-karma-paramo bhava\nmad-artham api karmāṇi kurvan siddhim avāpsyasi", translation_en: "If you are unable to practice even this Abhyasa Yoga, be intent on doing actions for My sake; even by doing actions for My sake, you will attain perfection.", translation_hi: "यदि तुम अभ्यास में भी असमर्थ हो तो मत्कर्म परायण बनो; इस प्रकार मेरे लिए कर्मों को करते हुए भी तुम सिद्धि को प्राप्त करोगे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/012_010.mp3"},
  {id: "BG_12.11", label: "BG 12.11", ref: "12.11", chapter: 12, verse: 11, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अथैतदप्यशक्तोऽसि कर्तुं मद्योगमाश्रितः", snippet: "If you are unable to do even this, then, resort to union with Me and renounce the fruits of all actions with self-control.", sanskrit: "अथैतदप्यशक्तोऽसि कर्तुं मद्योगमाश्रितः ।\nसर्वकर्मफलत्यागं ततः कुरु यतात्मवान् ॥", iast: "athaitadapyaśakto’si kartuṃ madyogamāśritaḥ |\nsarvakarmaphalatyāgaṃ tataḥ kuru yatātmavān ||", transliteration: "athaitad apy aśhakto ’si kartuṁ mad-yogam āśhritaḥ\nsarva-karma-phala-tyāgaṁ tataḥ kuru yatātmavān", translation_en: "If you are unable to do even this, then, resort to union with Me and renounce the fruits of all actions with self-control.", translation_hi: "और यदि इसको भी करने के लिए तुम असमर्थ हो, तो आत्मसंयम से युक्त होकर मेरी प्राप्ति रूप योग का आश्रय लेकर, तुम समस्त कर्मों के फल का त्याग करो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/012_011.mp3"},
  {id: "BG_12.12", label: "BG 12.12", ref: "12.12", chapter: 12, verse: 12, speaker: "krishna", canonical: true, meter: "anustubh", sa: "श्रेयो हि ज्ञानमभ्यासाज्ज्ञानाद्ध्यानं विशिष्यते", snippet: "Better indeed is knowledge than practice; better than knowledge is meditation; better than meditation is the renunciation of the fruits of actions: peace immediately follows…", sanskrit: "श्रेयो हि ज्ञानमभ्यासाज्ज्ञानाद्ध्यानं विशिष्यते ।\nध्यानात्कर्मफलत्यागस्त्यागाच्छान्तिरनन्तरम् ॥", iast: "śreyo hi jñānamabhyāsājjñānāddhyānaṃ viśiṣyate |\ndhyānātkarmaphalatyāgastyāgācchāntiranantaram ||", transliteration: "śhreyo hi jñānam abhyāsāj jñānād dhyānaṁ viśhiṣhyate\ndhyānāt karma-phala-tyāgas tyāgāch chhāntir anantaram", translation_en: "Better indeed is knowledge than practice; better than knowledge is meditation; better than meditation is the renunciation of the fruits of actions: peace immediately follows renunciation.", translation_hi: "अभ्यास से ज्ञान श्रेष्ठ है; ज्ञान से श्रेष्ठ ध्यान है और ध्यान से भी श्रेष्ठ कर्मफल त्याग है त्याग; से तत्काल ही शान्ति मिलती है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/012_012.mp3"},
  {id: "BG_12.13", label: "BG 12.13", ref: "12.13", chapter: 12, verse: 13, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अद्वेष्टा सर्वभूतानां मैत्रः करुण एव च", snippet: "He who hates no creature, is friendly and compassionate to all, is free from attachment and egoism, is balanced in pleasure and pain, and is forgiving.", sanskrit: "अद्वेष्टा सर्वभूतानां मैत्रः करुण एव च ।\nनिर्ममो निरहङ्कारः समदुःखसुखः क्षमी ॥", iast: "adveṣṭā sarvabhūtānāṃ maitraḥ karuṇa eva ca |\nnirmamo nirahaṅkāraḥ samaduḥkhasukhaḥ kṣamī ||", transliteration: "adveṣhṭā sarva-bhūtānāṁ maitraḥ karuṇa eva cha\nnirmamo nirahankāraḥ sama-duḥkha-sukhaḥ kṣhamī", translation_en: "He who hates no creature, is friendly and compassionate to all, is free from attachment and egoism, is balanced in pleasure and pain, and is forgiving.", translation_hi: "भूतमात्र के प्रति जो द्वेषरहित है तथा सबका मित्र तथा करुणावान् है; जो ममता और अहंकार से रहित, सुख और दु:ख में सम और क्षमावान् है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/012_013.mp3"},
  {id: "BG_12.14", label: "BG 12.14", ref: "12.14", chapter: 12, verse: 14, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सन्तुष्टः सततं योगी यतात्मा दृढनिश्चयः", snippet: "Ever content, steady in meditation, self-controlled, possessing firm conviction, with the mind and intellect dedicated to Me, he, My devotee, is dear to Me.", sanskrit: "सन्तुष्टः सततं योगी यतात्मा दृढनिश्चयः ।\nमय्यर्पितमनोबुद्धिर्यो मद्भक्तः स मे प्रियः ॥", iast: "santuṣṭaḥ satataṃ yogī yatātmā dṛḍhaniścayaḥ |\nmayyarpitamanobuddhiryo madbhaktaḥ sa me priyaḥ ||", transliteration: "santuṣhṭaḥ satataṁ yogī yatātmā dṛiḍha-niśhchayaḥ\nmayy arpita-mano-buddhir yo mad-bhaktaḥ sa me priyaḥ", translation_en: "Ever content, steady in meditation, self-controlled, possessing firm conviction, with the mind and intellect dedicated to Me, he, My devotee, is dear to Me.", translation_hi: "जो संयतात्मा, दृढ़निश्चयी योगी सदा सन्तुष्ट है, जो अपने मन और बुद्धि को मुझमें अर्पण किये हुए है, जो ऐसा मेरा भक्त है, वह मुझे प्रिय है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/012_014.mp3"},
  {id: "BG_12.15", label: "BG 12.15", ref: "12.15", chapter: 12, verse: 15, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यस्मान्नोद्विजते लोको लोकान्नोद्विजते च यः", snippet: "He whom the world does not agitate, and who cannot be agitated by the world, and who is freed from joy, anger, fear, and anxiety—he is dear to Me.", sanskrit: "यस्मान्नोद्विजते लोको लोकान्नोद्विजते च यः ।\nहर्षामर्षभयोद्वेगैर्मुक्तो यः स च मे प्रियः ॥", iast: "yasmānnodvijate loko lokānnodvijate ca yaḥ |\nharṣāmarṣabhayodvegairmukto yaḥ sa ca me priyaḥ ||", transliteration: "yasmān nodvijate loko lokān nodvijate cha yaḥ\nharṣhāmarṣha-bhayodvegair mukto yaḥ sa cha me priyaḥ", translation_en: "He whom the world does not agitate, and who cannot be agitated by the world, and who is freed from joy, anger, fear, and anxiety—he is dear to Me.", translation_hi: "जिससे कोई लोक (अर्थात् जीव, व्यक्ति) उद्वेग को प्राप्त नहीं होता और जो स्वयं भी किसी व्यक्ति से उद्वेग अनुभव नहीं करता तथा जो हर्ष, अमर्ष (असहिष्णुता) भय और उद्वेगों से मुक्त है,वह भक्त मुझे प्रिय है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/012_015.mp3"},
  {id: "BG_12.16", label: "BG 12.16", ref: "12.16", chapter: 12, verse: 16, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अनपेक्षः शुचिर्दक्ष उदासीनो गतव्यथः", snippet: "He who is free from wants, pure, expert, unconcerned, and free from pain, renouncing all undertakings and commencements, he who is devoted to Me is dear to Me.", sanskrit: "अनपेक्षः शुचिर्दक्ष उदासीनो गतव्यथः ।\nसर्वारम्भपरित्यागी यो मद्भक्तः स मे प्रियः ॥", iast: "anapekṣaḥ śucirdakṣa udāsīno gatavyathaḥ |\nsarvārambhaparityāgī yo madbhaktaḥ sa me priyaḥ ||", transliteration: "anapekṣhaḥ śhuchir dakṣha udāsīno gata-vyathaḥ\nsarvārambha-parityāgī yo mad-bhaktaḥ sa me priyaḥ", translation_en: "He who is free from wants, pure, expert, unconcerned, and free from pain, renouncing all undertakings and commencements, he who is devoted to Me is dear to Me.", translation_hi: "जो अपेक्षारहित, शुद्ध, दक्ष, उदासीन, व्यथारहित और सर्वकर्मों का संन्यास करने वाला मेरा भक्त है, वह मुझे प्रिय है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/012_016.mp3"},
  {id: "BG_12.17", label: "BG 12.17", ref: "12.17", chapter: 12, verse: 17, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यो न हृष्यति न द्वेष्टि न शोचति न काङ्क्षति", snippet: "He who neither rejoices nor hates, nor grieves nor desires, renouncing both good and evil, and who is full of devotion, is dear to Me.", sanskrit: "यो न हृष्यति न द्वेष्टि न शोचति न काङ्क्षति ।\nशुभाशुभपरित्यागी भक्तिमान्यः स मे प्रियः ॥", iast: "yo na hṛṣyati na dveṣṭi na śocati na kāṅkṣati |\nśubhāśubhaparityāgī bhaktimānyaḥ sa me priyaḥ ||", transliteration: "yo na hṛiṣhyati na dveṣhṭi na śhochati na kāṅkṣhati\nśhubhāśhubha-parityāgī bhaktimān yaḥ sa me priyaḥ", translation_en: "He who neither rejoices nor hates, nor grieves nor desires, renouncing both good and evil, and who is full of devotion, is dear to Me.", translation_hi: "जो न हर्षित होता है और न द्वेष करता है; न शोक करता है और न आकांक्षा; तथा जो शुभ और अशुभ को त्याग देता है, वह भक्तिमान् पुरुष मुझे प्रिय है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/012_017.mp3"},
  {id: "BG_12.18", label: "BG 12.18", ref: "12.18", chapter: 12, verse: 18, speaker: "krishna", canonical: true, meter: "anustubh", sa: "समः शत्रौ च मित्रे च तथा मानापमानयोः", snippet: "He who is the same to foe and friend, and also in honor and dishonor, who is the same in cold and heat, in pleasure and pain, and who is free from attachment.", sanskrit: "समः शत्रौ च मित्रे च तथा मानापमानयोः ।\nशीतोष्णसुखदुःखेषु समः सङ्गविवर्जितः ॥", iast: "samaḥ śatrau ca mitre ca tathā mānāpamānayoḥ |\nśītoṣṇasukhaduḥkheṣu samaḥ saṅgavivarjitaḥ ||", transliteration: "samaḥ śhatrau cha mitre cha tathā mānāpamānayoḥ\nśhītoṣhṇa-sukha-duḥkheṣhu samaḥ saṅga-vivarjitaḥ", translation_en: "He who is the same to foe and friend, and also in honor and dishonor, who is the same in cold and heat, in pleasure and pain, and who is free from attachment.", translation_hi: "जो पुरुष शत्रु और मित्र में तथा मान और अपमान में सम है; जो शीत-उष्ण व सुखदु:खादिक द्वन्द्वों में सम है और आसक्ति रहित है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/012_018.mp3"},
  {id: "BG_12.19", label: "BG 12.19", ref: "12.19", chapter: 12, verse: 19, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तुल्यनिन्दास्तुतिर्मौनी सन्तुष्टो येनकेनचित्", snippet: "He to whom censure and praise are equal, who is silent, content with anything, homeless, of a steady mind, and full of devotion; that man is dear to me.", sanskrit: "तुल्यनिन्दास्तुतिर्मौनी सन्तुष्टो येनकेनचित् ।\nअनिकेतः स्थिरमतिर्भक्तिमान्मे प्रियो नरः ॥", iast: "tulyanindāstutirmaunī santuṣṭo yenakenacit |\naniketaḥ sthiramatirbhaktimānme priyo naraḥ ||", transliteration: "tulya-nindā-stutir maunī santuṣhṭo yena kenachit\naniketaḥ sthira-matir bhaktimān me priyo naraḥ", translation_en: "He to whom censure and praise are equal, who is silent, content with anything, homeless, of a steady mind, and full of devotion; that man is dear to me.", translation_hi: "जिसको निन्दा और स्तुति दोनों ही तुल्य है, जो मौनी है, जो किसी अल्प वस्तु से भी सन्तुष्ट है, जो अनिकेत है, वह स्थिर बुद्धि का भक्तिमान् पुरुष मुझे प्रिय है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/012_019.mp3"},
  {id: "BG_12.20", label: "BG 12.20", ref: "12.20", chapter: 12, verse: 20, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ये तु धर्म्यामृतमिदं यथोक्तं पर्युपासते", snippet: "They who follow this immortal Dharma, endowed with faith and regarding Me as their supreme goal, are exceedingly dear to Me.", sanskrit: "ये तु धर्म्यामृतमिदं यथोक्तं पर्युपासते ।\nश्रद्दधाना मत्परमा भक्तास्तेऽतीव मे प्रियाः ॥", iast: "ye tu dharmyāmṛtamidaṃ yathoktaṃ paryupāsate |\nśraddadhānā matparamā bhaktāste’tīva me priyāḥ ||", transliteration: "ye tu dharmyāmṛitam idaṁ yathoktaṁ paryupāsate\nśhraddadhānā mat-paramā bhaktās te ’tīva me priyāḥ", translation_en: "They who follow this immortal Dharma, endowed with faith and regarding Me as their supreme goal, are exceedingly dear to Me.", translation_hi: "जो भक्त श्रद्धावान् तथा मुझे ही परम लक्ष्य समझने वाले हैं और इस यथोक्त धर्ममय अमृत का अर्थात् धर्ममय जीवन का पालन करते हैं, वे मुझे अतिशय प्रिय हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/012_020.mp3"},
  {id: "BG_13.1", label: "BG 13.1", ref: "13.1", chapter: 13, verse: 1, speaker: "arjuna", canonical: false, meter: "anustubh", sa: "प्रकृतिं पुरुषं चैव क्षेत्रं क्षेत्रज्ञमेव च", snippet: "Arjuna said, \"I wish to learn about Nature and the Spirit, the field and the knower of the field, knowledge and that which ought to be known, O Kesava.\"", sanskrit: "प्रकृतिं पुरुषं चैव क्षेत्रं क्षेत्रज्ञमेव च ।\nएतद्वेदितुमिच्छामि ज्ञानं ज्ञेयं च केशव ॥", iast: "prakṛtiṃ puruṣaṃ caiva kṣetraṃ kṣetrajñameva ca |\netadveditumicchāmi jñānaṃ jñeyaṃ ca keśava ||", transliteration: "prakṛitiṁ puruṣhaṁ chaiva kṣhetraṁ kṣhetra-jñam eva cha\netad veditum ichchhāmi jñānaṁ jñeyaṁ cha keśhava", translation_en: "Arjuna said, \"I wish to learn about Nature and the Spirit, the field and the knower of the field, knowledge and that which ought to be known, O Kesava.\"", translation_hi: "अर्जुन ने कहा -- हे केशव ! मैं, प्रकृति और पुरुष, क्षेत्र और क्षेत्रज्ञ तथा ज्ञान और ज्ञेय को जानना चाहता हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_001.mp3"},
  {id: "BG_13.2", label: "BG 13.2", ref: "13.2", chapter: 13, verse: 2, speaker: "krishna", canonical: true, meter: "anustubh", sa: "इदं शरीरं कौन्तेय क्षेत्रमित्यभिधीयते", snippet: "The Blessed Lord said, \"O Arjuna, this body is called the field; he who knows it is called the knower of the field by those who know them.\"", sanskrit: "इदं शरीरं कौन्तेय क्षेत्रमित्यभिधीयते ।\nएतद्यो वेत्ति तं प्राहुः क्षेत्रज्ञ इति तद्विदः ॥", iast: "idaṃ śarīraṃ kaunteya kṣetramityabhidhīyate |\netadyo vetti taṃ prāhuḥ kṣetrajña iti tadvidaḥ ||", transliteration: "idaṁ śharīraṁ kaunteya kṣhetram ity abhidhīyate\netad yo vetti taṁ prāhuḥ kṣhetra-jña iti tad-vidaḥ", translation_en: "The Blessed Lord said, \"O Arjuna, this body is called the field; he who knows it is called the knower of the field by those who know them.\"", translation_hi: "श्रीभगवान् ने कहा -- हे कौन्तेय ! यह शरीर क्षेत्र कहा जाता है और इसको जो जानता है, उसे तत्त्वज्ञ जन, क्षेत्रज्ञ कहते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_002.mp3"},
  {id: "BG_13.3", label: "BG 13.3", ref: "13.3", chapter: 13, verse: 3, speaker: "krishna", canonical: true, meter: "anustubh", sa: "क्षेत्रज्ञं चापि मां विद्धि सर्वक्षेत्रेषु भारत", snippet: "Do thou also know Me as the knower of the field in all fields, O Arjuna. Knowledge of both the field and the knower of the field is considered by Me to be the knowledge.", sanskrit: "क्षेत्रज्ञं चापि मां विद्धि सर्वक्षेत्रेषु भारत ।\nक्षेत्रक्षेत्रज्ञयोर्ज्ञानं यत्तज्ज्ञानं मतं मम ॥", iast: "kṣetrajñaṃ cāpi māṃ viddhi sarvakṣetreṣu bhārata |\nkṣetrakṣetrajñayorjñānaṃ yattajjñānaṃ mataṃ mama ||", transliteration: "kṣhetra-jñaṁ chāpi māṁ viddhi sarva-kṣhetreṣhu bhārata\nkṣhetra-kṣhetrajñayor jñānaṁ yat taj jñānaṁ mataṁ mama", translation_en: "Do thou also know Me as the knower of the field in all fields, O Arjuna. Knowledge of both the field and the knower of the field is considered by Me to be the knowledge.", translation_hi: "हे भारत ! तुम समस्त क्षेत्रों में क्षेत्रज्ञ मुझे ही जानो। क्षेत्र और क्षेत्रज्ञ का जो ज्ञान है, वही (वास्तव में) ज्ञान है , ऐसा मेरा मत है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_003.mp3"},
  {id: "BG_13.4", label: "BG 13.4", ref: "13.4", chapter: 13, verse: 4, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तत्क्षेत्रं यच्च यादृक् च यद्विकारि यतश्च यत्", snippet: "Hear from Me in brief what the field is, of what nature it is, what its modifications are, whence it is, who He is, and what His powers are.", sanskrit: "तत्क्षेत्रं यच्च यादृक् च यद्विकारि यतश्च यत् ।\nस च यो यत्प्रभावश्च तत्समासेन मे श्रृणु ॥", iast: "tatkṣetraṃ yacca yādṛk ca yadvikāri yataśca yat |\nsa ca yo yatprabhāvaśca tatsamāsena me śrṛṇu ||", transliteration: "tat kṣhetraṁ yach cha yādṛik cha yad-vikāri yataśh cha yat\nsa cha yo yat-prabhāvaśh cha tat samāsena me śhṛiṇu", translation_en: "Hear from Me in brief what the field is, of what nature it is, what its modifications are, whence it is, who He is, and what His powers are.", translation_hi: "इसलिये, वह क्षेत्र जो है और जैसा है तथा जिन विकारों वाला है, और जिस (कारण) से जो (कार्य) हुआ है तथा वह (क्षेत्रज्ञ) भी जो है और जिस प्रभाव वाला है, वह संक्षेप में मुझसे सुनो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_004.mp3"},
  {id: "BG_13.5", label: "BG 13.5", ref: "13.5", chapter: 13, verse: 5, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ऋषिभिर्बहुधा गीतं छन्दोभिर्विविधैः पृथक्", snippet: "Sages have sung in many ways, with various distinctive chants and also with suggestive words indicative of the Absolute, full of reasoning and decisive.", sanskrit: "ऋषिभिर्बहुधा गीतं छन्दोभिर्विविधैः पृथक् ।\nब्रह्मसूत्रपदैश्चैव हेतुमद्भिर्विनिश्चितैः ॥", iast: "ṛṣibhirbahudhā gītaṃ chandobhirvividhaiḥ pṛthak |\nbrahmasūtrapadaiścaiva hetumadbhirviniścitaiḥ ||", transliteration: "ṛiṣhibhir bahudhā gītaṁ chhandobhir vividhaiḥ pṛithak\nbrahma-sūtra-padaiśh chaiva hetumadbhir viniśhchitaiḥ", translation_en: "Sages have sung in many ways, with various distinctive chants and also with suggestive words indicative of the Absolute, full of reasoning and decisive.", translation_hi: "(क्षेत्र-क्षेत्रज्ञ के विषय में) ऋषियों द्वारा विभिन्न और विविध छन्दों में बहुत प्रकार से गाया गया है, तथा सम्यक् प्रकार से निश्चित किये हुये युक्तियुक्त ब्रह्मसूत्र के पदों द्वारा (अर्थात् ब्रह्म के सूचक शब्दों द्वारा) भी (वैसे ही कहा गया है)।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_005.mp3"},
  {id: "BG_13.6", label: "BG 13.6", ref: "13.6", chapter: 13, verse: 6, speaker: "krishna", canonical: true, meter: "anustubh", sa: "महाभूतान्यहङ्कारो बुद्धिरव्यक्तमेव च", snippet: "The great elements, egoism, intellect, and also the Unmanifested Nature, the ten senses, and one mind, and the five objects of the senses.", sanskrit: "महाभूतान्यहङ्कारो बुद्धिरव्यक्तमेव च ।\nइन्द्रियाणि दशैकं च पञ्च चेन्द्रियगोचराः ॥", iast: "mahābhūtānyahaṅkāro buddhiravyaktameva ca |\nindriyāṇi daśaikaṃ ca pañca cendriyagocarāḥ ||", transliteration: "mahā-bhūtāny ahankāro buddhir avyaktam eva cha\nindriyāṇi daśhaikaṁ cha pañcha chendriya-gocharāḥ", translation_en: "The great elements, egoism, intellect, and also the Unmanifested Nature, the ten senses, and one mind, and the five objects of the senses.", translation_hi: "पंच महाभूत, अहंकार, बुद्धि, अव्यक्त (प्रकृति), दस इन्द्रियाँ, एक मन, इन्द्रियों के पाँच विषय।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_006.mp3"},
  {id: "BG_13.7", label: "BG 13.7", ref: "13.7", chapter: 13, verse: 7, speaker: "krishna", canonical: true, meter: "anustubh", sa: "इच्छा द्वेषः सुखं दुःखं सङ्घातश्चेतनाधृतिः", snippet: "Desire, hatred, pleasure, pain, the aggregate (body), intelligence, and fortitude—the field has thus been briefly described with its modifications.", sanskrit: "इच्छा द्वेषः सुखं दुःखं सङ्घातश्चेतनाधृतिः ।\nएतत्क्षेत्रं समासेन सविकारमुदाहृतम् ॥", iast: "icchā dveṣaḥ sukhaṃ duḥkhaṃ saṅghātaścetanādhṛtiḥ |\netatkṣetraṃ samāsena savikāramudāhṛtam ||", transliteration: "ichchhā dveṣhaḥ sukhaṁ duḥkhaṁ saṅghātaśh chetanā dhṛitiḥ\netat kṣhetraṁ samāsena sa-vikāram udāhṛitam", translation_en: "Desire, hatred, pleasure, pain, the aggregate (body), intelligence, and fortitude—the field has thus been briefly described with its modifications.", translation_hi: "इच्छा, द्वेष, सुख, दुख, संघात (स्थूलदेह), चेतना (अन्त:करण की चेतन वृत्ति) तथा धृति -  इस प्रकार यह क्षेत्र विकारों के सहित संक्षेप में कहा गया है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_007.mp3"},
  {id: "BG_13.8", label: "BG 13.8", ref: "13.8", chapter: 13, verse: 8, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अमानित्वमदम्भित्वमहिंसा क्षान्तिरार्जवम्", snippet: "Humility, unpretentiousness, non-injury, forgiveness, uprightness, service to the teacher, purity, steadfastness, and self-control.", sanskrit: "अमानित्वमदम्भित्वमहिंसा क्षान्तिरार्जवम् ।\nआचार्योपासनं शौचं स्थैर्यमात्मविनिग्रहः ॥", iast: "amānitvamadambhitvamahiṃsā kṣāntirārjavam |\nācāryopāsanaṃ śaucaṃ sthairyamātmavinigrahaḥ ||", transliteration: "amānitvam adambhitvam ahinsā kṣhāntir ārjavam\nāchāryopāsanaṁ śhauchaṁ sthairyam ātma-vinigrahaḥ", translation_en: "Humility, unpretentiousness, non-injury, forgiveness, uprightness, service to the teacher, purity, steadfastness, and self-control.", translation_hi: "अमानित्व, अदम्भित्व, अहिंसा, क्षमा, आर्जव, आचार्य की सेवा, शुद्धि, स्थिरता और आत्मसंयम।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_008.mp3"},
  {id: "BG_13.9", label: "BG 13.9", ref: "13.9", chapter: 13, verse: 9, speaker: "krishna", canonical: true, meter: "anustubh", sa: "इन्द्रियार्थेषु वैराग्यमनहङ्कार एव च", snippet: "Indifference to the objects of the senses and also absence of egoism; perceiving the evil in birth, death, old age, sickness, and pain.", sanskrit: "इन्द्रियार्थेषु वैराग्यमनहङ्कार एव च ।\nजन्ममृत्युजराव्याधिदुःखदोषानुदर्शनम् ॥", iast: "indriyārtheṣu vairāgyamanahaṅkāra eva ca |\njanmamṛtyujarāvyādhiduḥkhadoṣānudarśanam ||", transliteration: "indriyārtheṣhu vairāgyam anahankāra eva cha\njanma-mṛityu-jarā-vyādhi-duḥkha-doṣhānudarśhanam", translation_en: "Indifference to the objects of the senses and also absence of egoism; perceiving the evil in birth, death, old age, sickness, and pain.", translation_hi: "इन्द्रियों के विषय के प्रति वैराग्य, अहंकार का अभाव, जन्म, मृत्यु, वृद्धवस्था, व्याधि और दुख में दोष दर्शन...৷৷.।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_009.mp3"},
  {id: "BG_13.10", label: "BG 13.10", ref: "13.10", chapter: 13, verse: 10, speaker: "krishna", canonical: true, meter: "anustubh", sa: "असक्तिरनभिष्वङ्गः पुत्रदारगृहादिषु", snippet: "Non-attachment, non-identification of the Self with son, wife, home, and the rest, and constant even-mindedness in the face of the attainment of both desirable and undesirable.", sanskrit: "असक्तिरनभिष्वङ्गः पुत्रदारगृहादिषु ।\nनित्यं च समचित्तत्वमिष्टानिष्टोपपत्तिषु ॥", iast: "asaktiranabhiṣvaṅgaḥ putradāragṛhādiṣu |\nnityaṃ ca samacittatvamiṣṭāniṣṭopapattiṣu ||", transliteration: "asaktir anabhiṣhvaṅgaḥ putra-dāra-gṛihādiṣhu\nnityaṁ cha sama-chittatvam iṣhṭāniṣhṭopapattiṣhu", translation_en: "Non-attachment, non-identification of the Self with son, wife, home, and the rest, and constant even-mindedness in the face of the attainment of both desirable and undesirable.", translation_hi: "आसक्ति तथा पुत्र, पत्नी, गृह आदि में अनभिष्वङ्ग (तादात्म्य का अभाव); और इष्ट और अनिष्ट की प्राप्ति में समचित्तता।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_010.mp3"},
  {id: "BG_13.11", label: "BG 13.11", ref: "13.11", chapter: 13, verse: 11, speaker: "krishna", canonical: true, meter: "anustubh", sa: "मयि चानन्ययोगेन भक्तिरव्यभिचारिणी", snippet: "Unswerving devotion to Me through the Yoga of non-separation, resorting to solitary places, and a distaste for the company of people.", sanskrit: "मयि चानन्ययोगेन भक्तिरव्यभिचारिणी ।\nविविक्तदेशसेवित्वमरतिर्जनसंसदि ॥", iast: "mayi cānanyayogena bhaktiravyabhicāriṇī |\nviviktadeśasevitvamaratirjanasaṃsadi ||", transliteration: "mayi chānanya-yogena bhaktir avyabhichāriṇī\nvivikta-deśha-sevitvam aratir jana-sansadi", translation_en: "Unswerving devotion to Me through the Yoga of non-separation, resorting to solitary places, and a distaste for the company of people.", translation_hi: "अनन्ययोग के द्वारा मुझमें अव्यभिचारिणी भक्ति; एकान्त स्थान में रहने का स्वभाव और (असंस्कृत) जनों के समुदाय में अरुचि।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_011.mp3"},
  {id: "BG_13.12", label: "BG 13.12", ref: "13.12", chapter: 13, verse: 12, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अध्यात्मज्ञाननित्यत्वं तत्त्वज्ञानार्थदर्शनम्", snippet: "Constancy in Self-knowledge, the perception of the end of true knowledge—this is declared to be knowledge, and what is opposed to it is ignorance.", sanskrit: "अध्यात्मज्ञाननित्यत्वं तत्त्वज्ञानार्थदर्शनम् ।\nएतज्ज्ञानमिति प्रोक्तमज्ञानं यदतोन्यथा ॥", iast: "adhyātmajñānanityatvaṃ tattvajñānārthadarśanam |\netajjñānamiti proktamajñānaṃ yadatonyathā ||", transliteration: "adhyātma-jñāna-nityatvaṁ tattva-jñānārtha-darśhanam\netaj jñānam iti proktam ajñānaṁ yad ato ’nyathā", translation_en: "Constancy in Self-knowledge, the perception of the end of true knowledge—this is declared to be knowledge, and what is opposed to it is ignorance.", translation_hi: "अध्यात्मज्ञान में नित्यत्व अर्थात् स्थिरता तथा तत्त्वज्ञान के अर्थ रूप परमात्मा का दर्शन, यह सब तो ज्ञान कहा गया है, और जो इससे विपरीत है, वह अज्ञान है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_012.mp3"},
  {id: "BG_13.13", label: "BG 13.13", ref: "13.13", chapter: 13, verse: 13, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ज्ञेयं यत्तत्प्रवक्ष्यामि यज्ज्ञात्वाऽमृतमश्नुते", snippet: "I will declare that which is to be known, knowing which one attains immortality; the beginningless Supreme Brahman, which is neither being nor non-being.", sanskrit: "ज्ञेयं यत्तत्प्रवक्ष्यामि यज्ज्ञात्वाऽमृतमश्नुते ।\nअनादिमत्परं ब्रह्म न सत्तन्नासदुच्यते ॥", iast: "jñeyaṃ yattatpravakṣyāmi yajjñātvā’mṛtamaśnute |\nanādimatparaṃ brahma na sattannāsaducyate ||", transliteration: "jñeyaṁ yat tat pravakṣhyāmi yaj jñātvāmṛitam aśhnute\nanādi mat-paraṁ brahma na sat tan nāsad uchyate", translation_en: "I will declare that which is to be known, knowing which one attains immortality; the beginningless Supreme Brahman, which is neither being nor non-being.", translation_hi: "मैं उस ज्ञेय वस्तु को स्पष्ट कहूंगा जिसे जानकर मनुष्य अमृतत्व को प्राप्त करता है। वह ज्ञेय है - अनादि, परम ब्रह्म, जो न सत् और न असत् ही कहा जा सकता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_013.mp3"},
  {id: "BG_13.14", label: "BG 13.14", ref: "13.14", chapter: 13, verse: 14, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सर्वतः पाणिपादं तत्सर्वतोऽक्षिशिरोमुखम्", snippet: "With hands and feet everywhere, with eyes, heads, and mouths everywhere, with ears everywhere, He exists in the worlds, enveloping all.", sanskrit: "सर्वतः पाणिपादं तत्सर्वतोऽक्षिशिरोमुखम् ।\nसर्वतः श्रुतिमल्लोके सर्वमावृत्य तिष्ठति ॥", iast: "sarvataḥ pāṇipādaṃ tatsarvato’kṣiśiromukham |\nsarvataḥ śrutimalloke sarvamāvṛtya tiṣṭhati ||", transliteration: "sarvataḥ pāṇi-pādaṁ tat sarvato ’kṣhi-śhiro-mukham\nsarvataḥ śhrutimal loke sarvam āvṛitya tiṣhṭhati", translation_en: "With hands and feet everywhere, with eyes, heads, and mouths everywhere, with ears everywhere, He exists in the worlds, enveloping all.", translation_hi: "वह सब ओर हाथ-पैर वाला है और सब ओर से नेत्र, शिर और मुखवाला तथा सब ओर से श्रोत्रवाला है; वह जगत् में सबको व्याप्त करके स्थित है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_014.mp3"},
  {id: "BG_13.15", label: "BG 13.15", ref: "13.15", chapter: 13, verse: 15, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सर्वेन्द्रियगुणाभासं सर्वेन्द्रियविवर्जितम्", snippet: "Shining by the functions of all the senses, yet without being attached to them; unattached, yet supporting all; devoid of qualities, yet the experiencer of them.", sanskrit: "सर्वेन्द्रियगुणाभासं सर्वेन्द्रियविवर्जितम् ।\nअसक्तं सर्वभृच्चैव निर्गुणं गुणभोक्तृ च ॥", iast: "sarvendriyaguṇābhāsaṃ sarvendriyavivarjitam |\nasaktaṃ sarvabhṛccaiva nirguṇaṃ guṇabhoktṛ ca ||", transliteration: "sarvendriya-guṇābhāsaṁ sarvendriya-vivarjitam\nasaktaṁ sarva-bhṛich chaiva nirguṇaṁ guṇa-bhoktṛi cha", translation_en: "Shining by the functions of all the senses, yet without being attached to them; unattached, yet supporting all; devoid of qualities, yet the experiencer of them.", translation_hi: "वह समस्त इन्द्रियों के गुणो (कार्यों) के द्वारा प्रकाशित होने वाला, परन्तु (वस्तुत:) समस्त इन्द्रियों से रहित है; आसक्ति रहित तथा गुण रहित होते हुए भी सबको धारणपोषण करने वाला और गुणों का भोक्ता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_015.mp3"},
  {id: "BG_13.16", label: "BG 13.16", ref: "13.16", chapter: 13, verse: 16, speaker: "krishna", canonical: true, meter: "anustubh", sa: "बहिरन्तश्च भूतानामचरं चरमेव च", snippet: "It is within and without all beings, both the unmoving and the moving; It is subtle and unknowable, and It is near and far away.", sanskrit: "बहिरन्तश्च भूतानामचरं चरमेव च ।\nसूक्ष्मत्वात्तदविज्ञेयं दूरस्थं चान्तिके च तत् ॥", iast: "bahirantaśca bhūtānāmacaraṃ carameva ca |\nsūkṣmatvāttadavijñeyaṃ dūrasthaṃ cāntike ca tat ||", transliteration: "bahir antaśh cha bhūtānām acharaṁ charam eva cha\nsūkṣhmatvāt tad avijñeyaṁ dūra-sthaṁ chāntike cha tat", translation_en: "It is within and without all beings, both the unmoving and the moving; It is subtle and unknowable, and It is near and far away.", translation_hi: "(वह ब्रह्म) भूत मात्र के अन्तर्बाह्य स्थित है; वह चर है और अचर भी। सूक्ष्म होने से वह अविज्ञेय है; वह सुदूर और अत्यन्त समीपस्थ भी है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_016.mp3"},
  {id: "BG_13.17", label: "BG 13.17", ref: "13.17", chapter: 13, verse: 17, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अविभक्तं च भूतेषु विभक्तमिव च स्थितम्", snippet: "Undivided yet, It exists as if divided in beings; It is to be known as the supporter of beings; It devours and It generates.", sanskrit: "अविभक्तं च भूतेषु विभक्तमिव च स्थितम् ।\nभूतभर्तृ च तज्ज्ञेयं ग्रसिष्णु प्रभविष्णु च ॥", iast: "avibhaktaṃ ca bhūteṣu vibhaktamiva ca sthitam |\nbhūtabhartṛ ca tajjñeyaṃ grasiṣṇu prabhaviṣṇu ca ||", transliteration: "avibhaktaṁ cha bhūteṣhu vibhaktam iva cha sthitam\nbhūta-bhartṛi cha taj jñeyaṁ grasiṣhṇu prabhaviṣhṇu cha", translation_en: "Undivided yet, It exists as if divided in beings; It is to be known as the supporter of beings; It devours and It generates.", translation_hi: "और वह अविभक्त है, तथापि वह भूतों में विभक्त के समान स्थित है। वह ज्ञेय ब्रह्म भूतमात्र का भर्ता, संहारकर्ता और उत्पत्ति कर्ता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_017.mp3"},
  {id: "BG_13.18", label: "BG 13.18", ref: "13.18", chapter: 13, verse: 18, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ज्योतिषामपि तज्ज्योतिस्तमसः परमुच्यते", snippet: "That Light of all lights is said to be beyond darkness: knowledge, the knowable, and the goal of knowledge, seated in the hearts of all.", sanskrit: "ज्योतिषामपि तज्ज्योतिस्तमसः परमुच्यते ।\nज्ञानं ज्ञेयं ज्ञानगम्यं हृदि सर्वस्य विष्ठितम् ॥", iast: "jyotiṣāmapi tajjyotistamasaḥ paramucyate |\njñānaṃ jñeyaṃ jñānagamyaṃ hṛdi sarvasya viṣṭhitam ||", transliteration: "jyotiṣhām api taj jyotis tamasaḥ param uchyate\njñānaṁ jñeyaṁ jñāna-gamyaṁ hṛidi sarvasya viṣhṭhitam", translation_en: "That Light of all lights is said to be beyond darkness: knowledge, the knowable, and the goal of knowledge, seated in the hearts of all.", translation_hi: "(वह ब्रह्म) ज्योतियों की भी ज्योति और (अज्ञान) अन्धकार से परे कहा जाता है। वह ज्ञान (चैतन्यस्वरूप) ज्ञेय और ज्ञान के द्वारा जानने योग्य (ज्ञानगम्य) है। वह सभी के हृदय में स्थित है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_018.mp3"},
  {id: "BG_13.19", label: "BG 13.19", ref: "13.19", chapter: 13, verse: 19, speaker: "krishna", canonical: true, meter: "anustubh", sa: "इति क्षेत्रं तथा ज्ञानं ज्ञेयं चोक्तं समासतः", snippet: "Thus, the field, as well as knowledge and the knowable, have been briefly stated. My devotee, knowing this, enters into My being.", sanskrit: "इति क्षेत्रं तथा ज्ञानं ज्ञेयं चोक्तं समासतः ।\nमद्भक्त एतद्विज्ञाय मद्भावायोपपद्यते ॥", iast: "iti kṣetraṃ tathā jñānaṃ jñeyaṃ coktaṃ samāsataḥ |\nmadbhakta etadvijñāya madbhāvāyopapadyate ||", transliteration: "iti kṣhetraṁ tathā jñānaṁ jñeyaṁ choktaṁ samāsataḥ\nmad-bhakta etad vijñāya mad-bhāvāyopapadyate", translation_en: "Thus, the field, as well as knowledge and the knowable, have been briefly stated. My devotee, knowing this, enters into My being.", translation_hi: "इस प्रकार, (मेरे द्वारा) क्षेत्र, ज्ञान और ज्ञेय को संक्षेपत: कहा गया। इसे तत्त्व से जानकर (विज्ञाय) मेरा भक्त मेरे स्वरूप को प्राप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_019.mp3"},
  {id: "BG_13.20", label: "BG 13.20", ref: "13.20", chapter: 13, verse: 20, speaker: "krishna", canonical: true, meter: "anustubh", sa: "प्रकृतिं पुरुषं चैव विद्ध्यनादी उभावपि", snippet: "Know that Nature (matter) and the Spirit are both beginningless, and know also that all modifications and qualities are born from Nature.", sanskrit: "प्रकृतिं पुरुषं चैव विद्ध्यनादी उभावपि ।\nविकारांश्च गुणांश्चैव विद्धि प्रकृतिसंभवान् ॥", iast: "prakṛtiṃ puruṣaṃ caiva viddhyanādī ubhāvapi |\nvikārāṃśca guṇāṃścaiva viddhi prakṛtisaṃbhavān ||", transliteration: "prakṛitiṁ puruṣhaṁ chaiva viddhy anādī ubhāv api\nvikārānśh cha guṇānśh chaiva viddhi prakṛiti-sambhavān", translation_en: "Know that Nature (matter) and the Spirit are both beginningless, and know also that all modifications and qualities are born from Nature.", translation_hi: "प्रकृति और पुरुष इन दोनों को ही तुम अनादि जानो। और तुम यह भी जानो कि सभी विकार और गुण प्रकृति से ही उत्पन्न हुए हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_020.mp3"},
  {id: "BG_13.21", label: "BG 13.21", ref: "13.21", chapter: 13, verse: 21, speaker: "krishna", canonical: true, meter: "anustubh", sa: "कार्यकारणकर्तृत्वे हेतुः प्रकृतिरुच्यते", snippet: "In the production of the effect and the cause, Nature (matter) is said to be the cause; in the experience of pleasure and pain, the soul is said to be the one responsible.", sanskrit: "कार्यकारणकर्तृत्वे हेतुः प्रकृतिरुच्यते ।\nपुरुषः सुखदुःखानां भोक्तृत्वे हेतुरुच्यते ॥", iast: "kāryakāraṇakartṛtve hetuḥ prakṛtirucyate |\npuruṣaḥ sukhaduḥkhānāṃ bhoktṛtve heturucyate ||", transliteration: "kārya-kāraṇa-kartṛitve hetuḥ prakṛitir uchyate\npuruṣhaḥ sukha-duḥkhānāṁ bhoktṛitve hetur uchyate", translation_en: "In the production of the effect and the cause, Nature (matter) is said to be the cause; in the experience of pleasure and pain, the soul is said to be the one responsible.", translation_hi: "कार्य और कारण के उत्पन्न करने में हेतु प्रकृति कही जाती है और पुरुष सुख-दु:ख के भोक्तृत्व में हेतु कहा जाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_021.mp3"},
  {id: "BG_13.22", label: "BG 13.22", ref: "13.22", chapter: 13, verse: 22, speaker: "krishna", canonical: true, meter: "anustubh", sa: "पुरुषः प्रकृतिस्थो हि भुङ्क्ते प्रकृतिजान्गुणान्", snippet: "The soul seated in Nature experiences the qualities born of Nature; attachment to the qualities is the cause of its birth in good and evil wombs.", sanskrit: "पुरुषः प्रकृतिस्थो हि भुङ्क्ते प्रकृतिजान्गुणान् ।\nकारणं गुणसङ्गोऽस्य सदसद्योनिजन्मसु ॥", iast: "puruṣaḥ prakṛtistho hi bhuṅkte prakṛtijānguṇān |\nkāraṇaṃ guṇasaṅgo’sya sadasadyonijanmasu ||", transliteration: "puruṣhaḥ prakṛiti-stho hi bhuṅkte prakṛiti-jān guṇān\nkāraṇaṁ guṇa-saṅgo ’sya sad-asad-yoni-janmasu", translation_en: "The soul seated in Nature experiences the qualities born of Nature; attachment to the qualities is the cause of its birth in good and evil wombs.", translation_hi: "प्रकृति में स्थित पुरुष प्रकृति से उत्पन्न गुणों को भोगता है। इन गुणों का संग ही इस पुरुष (जीव) के शुभ और अशुभ योनियों में जन्म लेने का कारण है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_022.mp3"},
  {id: "BG_13.23", label: "BG 13.23", ref: "13.23", chapter: 13, verse: 23, speaker: "krishna", canonical: true, meter: "anustubh", sa: "उपद्रष्टाऽनुमन्ता च भर्ता भोक्ता महेश्वरः", snippet: "The Supreme Soul in this body is also called the observer, the permitter, the sustainer, the enjoyer, the great Lord, and the Supreme Self.", sanskrit: "उपद्रष्टाऽनुमन्ता च भर्ता भोक्ता महेश्वरः ।\nपरमात्मेति चाप्युक्तो देहेऽस्मिन्पुरुषः परः ॥", iast: "upadraṣṭā’numantā ca bhartā bhoktā maheśvaraḥ |\nparamātmeti cāpyukto dehe’sminpuruṣaḥ paraḥ ||", transliteration: "upadraṣhṭānumantā cha bhartā bhoktā maheśhvaraḥ\nparamātmeti chāpy ukto dehe ’smin puruṣhaḥ paraḥ", translation_en: "The Supreme Soul in this body is also called the observer, the permitter, the sustainer, the enjoyer, the great Lord, and the Supreme Self.", translation_hi: "परम पुरुष ही इस देह में उपद्रष्टा, अनुमन्ता ,भर्ता, भोक्ता, महेश्वर और परमात्मा कहा जाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_023.mp3"},
  {id: "BG_13.24", label: "BG 13.24", ref: "13.24", chapter: 13, verse: 24, speaker: "krishna", canonical: true, meter: "anustubh", sa: "य एवं वेत्ति पुरुषं प्रकृतिं च गुणैःसह", snippet: "He who thus knows the Spirit and Matter together with their qualities, in whatever condition he may be, he is not reborn.", sanskrit: "य एवं वेत्ति पुरुषं प्रकृतिं च गुणैःसह ।\nसर्वथा वर्तमानोऽपि न स भूयोऽभिजायते ॥", iast: "ya evaṃ vetti puruṣaṃ prakṛtiṃ ca guṇaiḥsaha |\nsarvathā vartamāno’pi na sa bhūyo’bhijāyate ||", transliteration: "ya evaṁ vetti puruṣhaṁ prakṛitiṁ cha guṇaiḥ saha\nsarvathā vartamāno ’pi na sa bhūyo ’bhijāyate", translation_en: "He who thus knows the Spirit and Matter together with their qualities, in whatever condition he may be, he is not reborn.", translation_hi: "इस प्रकार पुरुष और गुणों के सहित प्रकृति को जो मनुष्य जानता है, वह सब प्रकार से रहता हुआ (व्यवहार करता हुआ) भी पुन: नहीं जन्मता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_024.mp3"},
  {id: "BG_13.25", label: "BG 13.25", ref: "13.25", chapter: 13, verse: 25, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ध्यानेनात्मनि पश्यन्ति केचिदात्मानमात्मना", snippet: "Some behold the Self within themselves through meditation, others through the Yoga of knowledge, and still others through the Yoga of action.", sanskrit: "ध्यानेनात्मनि पश्यन्ति केचिदात्मानमात्मना ।\nअन्ये सांख्येन योगेन कर्मयोगेन चापरे ॥", iast: "dhyānenātmani paśyanti kecidātmānamātmanā |\nanye sāṃkhyena yogena karmayogena cāpare ||", transliteration: "dhyānenātmani paśhyanti kechid ātmānam ātmanā\nanye sānkhyena yogena karma-yogena chāpare", translation_en: "Some behold the Self within themselves through meditation, others through the Yoga of knowledge, and still others through the Yoga of action.", translation_hi: "कोई पुरुष ध्यान के अभ्यास से आत्मा को आत्मा (हृदय) में आत्मा (शुद्ध बुद्धि) के द्वारा देखते हैं; अन्य लोग सांख्य योग के द्वारा तथा कोई साधक कर्मयोग से (आत्मा को देखते हैं )।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_025.mp3"},
  {id: "BG_13.26", label: "BG 13.26", ref: "13.26", chapter: 13, verse: 26, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अन्ये त्वेवमजानन्तः श्रुत्वाऽन्येभ्य उपासते", snippet: "Others, too, who do not know thus, worship, having heard of It from others; they, too, cross beyond death, regarding what they have heard as the supreme refuge.", sanskrit: "अन्ये त्वेवमजानन्तः श्रुत्वाऽन्येभ्य उपासते ।\nतेऽपि चातितरन्त्येव मृत्युं श्रुतिपरायणाः ॥", iast: "anye tvevamajānantaḥ śrutvā’nyebhya upāsate |\nte’pi cātitarantyeva mṛtyuṃ śrutiparāyaṇāḥ ||", transliteration: "anye tv evam ajānantaḥ śhrutvānyebhya upāsate\nte ’pi chātitaranty eva mṛityuṁ śhruti-parāyaṇāḥ", translation_en: "Others, too, who do not know thus, worship, having heard of It from others; they, too, cross beyond death, regarding what they have heard as the supreme refuge.", translation_hi: "परन्तु, अन्य लोग जो स्वयं इस प्रकार न जानते हुए, दूसरों से (आचार्यों से) सुनकर ही उपासना करते हैं, वे श्रुतिपरायण (अर्थात् श्रवण ही जिनके लिए परम साधन है) लोग भी मृत्यु को नि:सन्देह तर जाते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_026.mp3"},
  {id: "BG_13.27", label: "BG 13.27", ref: "13.27", chapter: 13, verse: 27, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यावत्सञ्जायते किञ्चित्सत्त्वं स्थावरजङ्गमम्", snippet: "Wherever a being is born, whether unmoving or moving, know thou, O best of the Bharatas (Arjuna), that it is from the union of the field and its knower.", sanskrit: "यावत्सञ्जायते किञ्चित्सत्त्वं स्थावरजङ्गमम् ।\nक्षेत्रक्षेत्रज्ञसंयोगात्तद्विद्धि भरतर्षभ ॥", iast: "yāvatsañjāyate kiñcitsattvaṃ sthāvarajaṅgamam |\nkṣetrakṣetrajñasaṃyogāttadviddhi bharatarṣabha ||", transliteration: "yāvat sañjāyate kiñchit sattvaṁ sthāvara-jaṅgamam\nkṣhetra-kṣhetrajña-sanyogāt tad viddhi bharatarṣhabha", translation_en: "Wherever a being is born, whether unmoving or moving, know thou, O best of the Bharatas (Arjuna), that it is from the union of the field and its knower.", translation_hi: "हे भरत श्रेष्ठ ! यावन्मात्र जो कुछ भी स्थावर जंगम (चराचर) वस्तु उत्पन्न होती है, उस सबको तुम क्षेत्र और क्षेत्रज्ञ के संयोग से उत्पन्न हुई जानो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_027.mp3"},
  {id: "BG_13.28", label: "BG 13.28", ref: "13.28", chapter: 13, verse: 28, speaker: "krishna", canonical: true, meter: "anustubh", sa: "समं सर्वेषु भूतेषु तिष्ठन्तं परमेश्वरम्", snippet: "He who sees the Supreme Lord existing truly in all beings, the imperishable within the perishable, sees indeed.", sanskrit: "समं सर्वेषु भूतेषु तिष्ठन्तं परमेश्वरम् ।\nविनश्यत्स्वविनश्यन्तं यः पश्यति स पश्यति ॥", iast: "samaṃ sarveṣu bhūteṣu tiṣṭhantaṃ parameśvaram |\nvinaśyatsvavinaśyantaṃ yaḥ paśyati sa paśyati ||", transliteration: "samaṁ sarveṣhu bhūteṣhu tiṣhṭhantaṁ parameśhvaram\nvinaśhyatsv avinaśhyantaṁ yaḥ paśhyati sa paśhyati", translation_en: "He who sees the Supreme Lord existing truly in all beings, the imperishable within the perishable, sees indeed.", translation_hi: "जो पुरुष समस्त नश्वर भूतों में अनश्वर परमेश्वर को समभाव से स्थित देखता है, वही (वास्तव में) देखता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_028.mp3"},
  {id: "BG_13.29", label: "BG 13.29", ref: "13.29", chapter: 13, verse: 29, speaker: "krishna", canonical: true, meter: "anustubh", sa: "समं पश्यन्हि सर्वत्र समवस्थितमीश्वरम्", snippet: "For he who truly sees the same Lord dwelling everywhere does not destroy the Self by the self; rather, he attains the highest goal.", sanskrit: "समं पश्यन्हि सर्वत्र समवस्थितमीश्वरम् ।\nन हिनस्त्यात्मनाऽऽत्मानं ततो याति परां गतिम् ॥", iast: "samaṃ paśyanhi sarvatra samavasthitamīśvaram |\nna hinastyātmanā’’tmānaṃ tato yāti parāṃ gatim ||", transliteration: "samaṁ paśhyan hi sarvatra samavasthitam īśhvaram\nna hinasty ātmanātmānaṁ tato yāti parāṁ gatim", translation_en: "For he who truly sees the same Lord dwelling everywhere does not destroy the Self by the self; rather, he attains the highest goal.", translation_hi: "निश्चय ही, वह पुरुष सर्वत्र सम भाव से स्थित परमेश्वर को समान हुआ आत्मा (स्वयं) के द्वारा आत्मा (स्वयं) का नाश नहीं करता है, इससे वह परम गति को प्राप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_029.mp3"},
  {id: "BG_13.30", label: "BG 13.30", ref: "13.30", chapter: 13, verse: 30, speaker: "krishna", canonical: true, meter: "anustubh", sa: "प्रकृत्यैव च कर्माणि क्रियमाणानि सर्वशः", snippet: "He sees, who sees that all actions are performed solely by Nature and that the Self is without action.", sanskrit: "प्रकृत्यैव च कर्माणि क्रियमाणानि सर्वशः ।\nयः पश्यति तथाऽऽत्मानमकर्तारं स पश्यति ॥", iast: "prakṛtyaiva ca karmāṇi kriyamāṇāni sarvaśaḥ |\nyaḥ paśyati tathā’’tmānamakartāraṃ sa paśyati ||", transliteration: "prakṛityaiva cha karmāṇi kriyamāṇāni sarvaśhaḥ\nyaḥ paśhyati tathātmānam akartāraṁ sa paśhyati", translation_en: "He sees, who sees that all actions are performed solely by Nature and that the Self is without action.", translation_hi: "जो पुरुष समस्त कर्मों को सर्वश: प्रकृति द्वारा ही किये गये देखता है तथा आत्मा को अकर्ता देखता है, वही (वास्तव में) देखता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_030.mp3"},
  {id: "BG_13.31", label: "BG 13.31", ref: "13.31", chapter: 13, verse: 31, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यदा भूतपृथग्भावमेकस्थमनुपश्यति", snippet: "When a person sees all beings as resting in the One and emanating from the One alone, they then become Brahman.", sanskrit: "यदा भूतपृथग्भावमेकस्थमनुपश्यति ।\nतत एव च विस्तारं ब्रह्म सम्पद्यते तदा ॥", iast: "yadā bhūtapṛthagbhāvamekasthamanupaśyati |\ntata eva ca vistāraṃ brahma sampadyate tadā ||", transliteration: "yadā bhūta-pṛithag-bhāvam eka-stham anupaśhyati\ntata eva cha vistāraṁ brahma sampadyate tadā", translation_en: "When a person sees all beings as resting in the One and emanating from the One alone, they then become Brahman.", translation_hi: "यह पुरुष जब भूतों के पृथक् भावों को एक (परमात्मा) में स्थित देखता है तथा उस (परमात्मा) से ही यह विस्तार हुआ जानता है, तब वह ब्रह्म को प्राप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_031.mp3"},
  {id: "BG_13.32", label: "BG 13.32", ref: "13.32", chapter: 13, verse: 32, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अनादित्वान्निर्गुणत्वात्परमात्मायमव्ययः", snippet: "Being without beginning, devoid of any qualities, the Supreme Self, imperishable, though dwelling in the body, O Arjuna, neither acts nor is tainted.", sanskrit: "अनादित्वान्निर्गुणत्वात्परमात्मायमव्ययः ।\nशरीरस्थोऽपि कौन्तेय न करोति न लिप्यते ॥", iast: "anāditvānnirguṇatvātparamātmāyamavyayaḥ |\nśarīrastho’pi kaunteya na karoti na lipyate ||", transliteration: "anāditvān nirguṇatvāt paramātmāyam avyayaḥ\nśharīra-stho ’pi kaunteya na karoti na lipyate", translation_en: "Being without beginning, devoid of any qualities, the Supreme Self, imperishable, though dwelling in the body, O Arjuna, neither acts nor is tainted.", translation_hi: "हे कौन्तेय ! अनादि और निर्गुण होने से यह परमात्मा अव्यय है। शरीर में स्थित हुआ भी, वस्तुत:, वह न (कर्म) करता है और न (फलों से) लिप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_032.mp3"},
  {id: "BG_13.33", label: "BG 13.33", ref: "13.33", chapter: 13, verse: 33, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यथा सर्वगतं सौक्ष्म्यादाकाशं नोपलिप्यते", snippet: "As the all-pervading ether is not tainted, due to its subtlety, so the Self seated everywhere in the body is not tainted either.", sanskrit: "यथा सर्वगतं सौक्ष्म्यादाकाशं नोपलिप्यते ।\nसर्वत्रावस्थितो देहे तथाऽऽत्मा नोपलिप्यते ॥", iast: "yathā sarvagataṃ saukṣmyādākāśaṃ nopalipyate |\nsarvatrāvasthito dehe tathā’’tmā nopalipyate ||", transliteration: "yathā sarva-gataṁ saukṣhmyād ākāśhaṁ nopalipyate\nsarvatrāvasthito dehe tathātmā nopalipyate", translation_en: "As the all-pervading ether is not tainted, due to its subtlety, so the Self seated everywhere in the body is not tainted either.", translation_hi: "जिस प्रकार सर्वगत आकाश सूक्ष्म होने के कारण लिप्त नहीं होता, उसी प्रकार सर्वत्र देह में स्थित आत्मा लिप्त नहीं होता।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_033.mp3"},
  {id: "BG_13.34", label: "BG 13.34", ref: "13.34", chapter: 13, verse: 34, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यथा प्रकाशयत्येकः कृत्स्नं लोकमिमं रविः", snippet: "Just as the one sun illuminates the entire world, so too does the Lord of the field (Supreme Self) illuminate the entire field, O Arjuna.", sanskrit: "यथा प्रकाशयत्येकः कृत्स्नं लोकमिमं रविः ।\nक्षेत्रं क्षेत्री तथा कृत्स्नं प्रकाशयति भारत ॥", iast: "yathā prakāśayatyekaḥ kṛtsnaṃ lokamimaṃ raviḥ |\nkṣetraṃ kṣetrī tathā kṛtsnaṃ prakāśayati bhārata ||", transliteration: "yathā prakāśhayaty ekaḥ kṛitsnaṁ lokam imaṁ raviḥ\nkṣhetraṁ kṣhetrī tathā kṛitsnaṁ prakāśhayati bhārata", translation_en: "Just as the one sun illuminates the entire world, so too does the Lord of the field (Supreme Self) illuminate the entire field, O Arjuna.", translation_hi: "हे भारत ! जिस प्रकार एक ही सूर्य इस सम्पूर्ण लोक को प्रकाशित करता है, उसी प्रकार एक ही क्षेत्री (क्षेत्रज्ञ) सम्पूर्ण क्षेत्र को प्रकाशित करता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_034.mp3"},
  {id: "BG_13.35", label: "BG 13.35", ref: "13.35", chapter: 13, verse: 35, speaker: "krishna", canonical: true, meter: "anustubh", sa: "क्षेत्रक्षेत्रज्ञयोरेवमन्तरं ज्ञानचक्षुषा", snippet: "They who, by the eye of knowledge, perceive the distinction between the field and its knower, as well as the liberation from the Nature of being, go to the Supreme.", sanskrit: "क्षेत्रक्षेत्रज्ञयोरेवमन्तरं ज्ञानचक्षुषा ।\nभूतप्रकृतिमोक्षं च ये विदुर्यान्ति ते परम् ॥", iast: "kṣetrakṣetrajñayorevamantaraṃ jñānacakṣuṣā |\nbhūtaprakṛtimokṣaṃ ca ye viduryānti te param ||", transliteration: "kṣhetra-kṣhetrajñayor evam antaraṁ jñāna-chakṣhuṣhā\nbhūta-prakṛiti-mokṣhaṁ cha ye vidur yānti te param", translation_en: "They who, by the eye of knowledge, perceive the distinction between the field and its knower, as well as the liberation from the Nature of being, go to the Supreme.", translation_hi: "इस प्रकार, जो पुरुष ज्ञानचक्षु के द्वारा क्षेत्र और क्षेत्रज्ञ के भेद को तथा प्रकृति के विकारों से मोक्ष को जानते हैं, वे परम ब्रह्म को प्राप्त होते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/013_035.mp3"},
  {id: "BG_14.1", label: "BG 14.1", ref: "14.1", chapter: 14, verse: 1, speaker: "krishna", canonical: true, meter: "anustubh", sa: "परं भूयः प्रवक्ष्यामि ज्ञानानां ज्ञानमुत्तमम्", snippet: "The Blessed Lord said, \"I will again declare to thee that supreme knowledge, the best of all knowledge, having known which all the sages have gone to supreme perfection after…", sanskrit: "परं भूयः प्रवक्ष्यामि ज्ञानानां ज्ञानमुत्तमम् ।\nयज्ज्ञात्वा मुनयः सर्वे परां सिद्धिमितो गताः ॥", iast: "paraṃ bhūyaḥ pravakṣyāmi jñānānāṃ jñānamuttamam |\nyajjñātvā munayaḥ sarve parāṃ siddhimito gatāḥ ||", transliteration: "paraṁ bhūyaḥ pravakṣhyāmi jñānānāṁ jñānam uttamam\nyaj jñātvā munayaḥ sarve parāṁ siddhim ito gatāḥ", translation_en: "The Blessed Lord said, \"I will again declare to thee that supreme knowledge, the best of all knowledge, having known which all the sages have gone to supreme perfection after this life.\"", translation_hi: "श्री भगवान् ने कहा -- समस्त ज्ञानों में उत्तम परम ज्ञान को मैं पुन: कहूंगा, जिसको जानकर सभी मुनिजन इस (लोक) से जाकर (इस जीवनोपरान्त) परम सिद्धि को प्राप्त हुए हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/014_001.mp3"},
  {id: "BG_14.2", label: "BG 14.2", ref: "14.2", chapter: 14, verse: 2, speaker: "krishna", canonical: true, meter: "anustubh", sa: "इदं ज्ञानमुपाश्रित्य मम साधर्म्यमागताः", snippet: "Those who, having taken refuge in this knowledge, have attained unity with Me, are neither born at the time of creation nor disturbed at the time of dissolution.", sanskrit: "इदं ज्ञानमुपाश्रित्य मम साधर्म्यमागताः ।\nसर्गेऽपि नोपजायन्ते प्रलये न व्यथन्ति च ॥", iast: "idaṃ jñānamupāśritya mama sādharmyamāgatāḥ |\nsarge’pi nopajāyante pralaye na vyathanti ca ||", transliteration: "idaṁ jñānam upāśhritya mama sādharmyam āgatāḥ\nsarge ’pi nopajāyante pralaye na vyathanti cha", translation_en: "Those who, having taken refuge in this knowledge, have attained unity with Me, are neither born at the time of creation nor disturbed at the time of dissolution.", translation_hi: "इस ज्ञान का आश्रय लेकर मेरे स्वरूप (सार्धम्यम्) को प्राप्त पुरुष सृष्टि के आदि में जन्म नहीं लेते और प्रलयकाल में व्याकुल भी नहीं होते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/014_002.mp3"},
  {id: "BG_14.3", label: "BG 14.3", ref: "14.3", chapter: 14, verse: 3, speaker: "krishna", canonical: true, meter: "anustubh", sa: "मम योनिर्महद्ब्रह्म तस्मिन् गर्भं दधाम्यहम्", snippet: "My womb is the great Brahma; in it I place the germ; thence, O Arjuna, is the birth of all beings.", sanskrit: "मम योनिर्महद्ब्रह्म तस्मिन् गर्भं दधाम्यहम् ।\nसंभवः सर्वभूतानां ततो भवति भारत ॥", iast: "mama yonirmahadbrahma tasmin garbhaṃ dadhāmyaham |\nsaṃbhavaḥ sarvabhūtānāṃ tato bhavati bhārata ||", transliteration: "mama yonir mahad brahma tasmin garbhaṁ dadhāmy aham\nsambhavaḥ sarva-bhūtānāṁ tato bhavati bhārata", translation_en: "My womb is the great Brahma; in it I place the germ; thence, O Arjuna, is the birth of all beings.", translation_hi: "हे भारत ! मेरी महद् ब्रह्मरूप प्रकृति, (भूतों की) योनि है, जिसमें मैं गर्भाधान करता हूँ; इससे समस्त भूतों की उत्पत्ति होती है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/014_003.mp3"},
  {id: "BG_14.4", label: "BG 14.4", ref: "14.4", chapter: 14, verse: 4, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सर्वयोनिषु कौन्तेय मूर्तयः सम्भवन्ति याः", snippet: "Whatever forms are produced, O Arjuna, in any womb whatsoever, the great Brahma is their womb, and I am the seed-giving father.", sanskrit: "सर्वयोनिषु कौन्तेय मूर्तयः सम्भवन्ति याः ।\nतासां ब्रह्म महद्योनिरहं बीजप्रदः पिता ॥", iast: "sarvayoniṣu kaunteya mūrtayaḥ sambhavanti yāḥ |\ntāsāṃ brahma mahadyonirahaṃ bījapradaḥ pitā ||", transliteration: "sarva-yoniṣhu kaunteya mūrtayaḥ sambhavanti yāḥ\ntāsāṁ brahma mahad yonir ahaṁ bīja-pradaḥ pitā", translation_en: "Whatever forms are produced, O Arjuna, in any womb whatsoever, the great Brahma is their womb, and I am the seed-giving father.", translation_hi: "हे कौन्तेय ! समस्त योनियों में जितनी मूर्तियाँ (शरीर) उत्पन्न होती हैं, उन सबकी योनि अर्थात् गर्भ है महद्ब्रह्म और मैं बीज की स्थापना करने वाला पिता हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/014_004.mp3"},
  {id: "BG_14.5", label: "BG 14.5", ref: "14.5", chapter: 14, verse: 5, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सत्त्वं रजस्तम इति गुणाः प्रकृतिसंभवाः", snippet: "These qualities, O Arjuna, born of Nature, bind fast in the body of the embodied, the indestructible: purity, passion, and inertia.", sanskrit: "सत्त्वं रजस्तम इति गुणाः प्रकृतिसंभवाः ।\nनिबध्नन्ति महाबाहो देहे देहिनमव्ययम् ॥", iast: "sattvaṃ rajastama iti guṇāḥ prakṛtisaṃbhavāḥ |\nnibadhnanti mahābāho dehe dehinamavyayam ||", transliteration: "sattvaṁ rajas tama iti guṇāḥ prakṛiti-sambhavāḥ\nnibadhnanti mahā-bāho dehe dehinam avyayam", translation_en: "These qualities, O Arjuna, born of Nature, bind fast in the body of the embodied, the indestructible: purity, passion, and inertia.", translation_hi: "हे महाबाहो ! सत्त्व, रज और तम ये प्रकृति से उत्पन्न तीनों गुण देही आत्मा को देह के साथ बांध देते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/014_005.mp3"},
  {id: "BG_14.6", label: "BG 14.6", ref: "14.6", chapter: 14, verse: 6, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तत्र सत्त्वं निर्मलत्वात्प्रकाशकमनामयम्", snippet: "Of these, sattva, which is luminous and healthy due to its stainlessness, binds one by attachment to happiness and knowledge, O sinless one.", sanskrit: "तत्र सत्त्वं निर्मलत्वात्प्रकाशकमनामयम् ।\nसुखसङ्गेन बध्नाति ज्ञानसङ्गेन चानघ ॥", iast: "tatra sattvaṃ nirmalatvātprakāśakamanāmayam |\nsukhasaṅgena badhnāti jñānasaṅgena cānagha ||", transliteration: "tatra sattvaṁ nirmalatvāt prakāśhakam anāmayam\nsukha-saṅgena badhnāti jñāna-saṅgena chānagha", translation_en: "Of these, sattva, which is luminous and healthy due to its stainlessness, binds one by attachment to happiness and knowledge, O sinless one.", translation_hi: "हे निष्पाप अर्जुन ! इन (तीनों) में, सत्त्वगुण निर्मल होने से प्रकाशक और अनामय (निरुपद्रव, निर्विकार या निरोग) है; (वह जीव को) सुख की आसक्ति से और ज्ञान की आसक्ति से बांध देता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/014_006.mp3"},
  {id: "BG_14.7", label: "BG 14.7", ref: "14.7", chapter: 14, verse: 7, speaker: "krishna", canonical: true, meter: "anustubh", sa: "रजो रागात्मकं विद्धि तृष्णासङ्गसमुद्भवम्", snippet: "Know, O Arjuna, that Rajas is of the nature of passion, the source of thirst and attachment; it binds fast the embodied one by attachment to action.", sanskrit: "रजो रागात्मकं विद्धि तृष्णासङ्गसमुद्भवम् ।\nतन्निबध्नाति कौन्तेय कर्मसङ्गेन देहिनम् ॥", iast: "rajo rāgātmakaṃ viddhi tṛṣṇāsaṅgasamudbhavam |\ntannibadhnāti kaunteya karmasaṅgena dehinam ||", transliteration: "rajo rāgātmakaṁ viddhi tṛiṣhṇā-saṅga-samudbhavam\ntan nibadhnāti kaunteya karma-saṅgena dehinam", translation_en: "Know, O Arjuna, that Rajas is of the nature of passion, the source of thirst and attachment; it binds fast the embodied one by attachment to action.", translation_hi: "हे कौन्तेय ! रजोगुण को रागस्वरूप जानो, जिससे तृष्णा और आसक्ति उत्पन्न होती है। वह देही आत्मा को कर्मों की आसक्ति से बांधता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/014_007.mp3"},
  {id: "BG_14.8", label: "BG 14.8", ref: "14.8", chapter: 14, verse: 8, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तमस्त्वज्ञानजं विद्धि मोहनं सर्वदेहिनाम्", snippet: "But know thou Tamas to be born of ignorance, deluding all embodied beings; it binds fast, O Arjuna, through heedlessness, indolence, and sleep.", sanskrit: "तमस्त्वज्ञानजं विद्धि मोहनं सर्वदेहिनाम् ।\nप्रमादालस्यनिद्राभिस्तन्निबध्नाति भारत ॥", iast: "tamastvajñānajaṃ viddhi mohanaṃ sarvadehinām |\npramādālasyanidrābhistannibadhnāti bhārata ||", transliteration: "tamas tv ajñāna-jaṁ viddhi mohanaṁ sarva-dehinām\npramādālasya-nidrābhis tan nibadhnāti bhārata", translation_en: "But know thou Tamas to be born of ignorance, deluding all embodied beings; it binds fast, O Arjuna, through heedlessness, indolence, and sleep.", translation_hi: "और हे भारत ! तमोगुण को अज्ञान से उत्पन्न जानो; जो समस्त देहधारियों (जीवों) को मोहित करने वाला है। वह प्रमाद, आलस्य और निद्रा के द्वारा जीव को बांधता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/014_008.mp3"},
  {id: "BG_14.9", label: "BG 14.9", ref: "14.9", chapter: 14, verse: 9, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सत्त्वं सुखे सञ्जयति रजः कर्मणि भारत", snippet: "Sattva attaches to happiness, Rajas to action, O Arjuna, while Tamas, verily shrouding knowledge, attaches to heedlessness.", sanskrit: "सत्त्वं सुखे सञ्जयति रजः कर्मणि भारत ।\nज्ञानमावृत्य तु तमः प्रमादे सञ्जयत्युत ॥", iast: "sattvaṃ sukhe sañjayati rajaḥ karmaṇi bhārata |\njñānamāvṛtya tu tamaḥ pramāde sañjayatyuta ||", transliteration: "sattvaṁ sukhe sañjayati rajaḥ karmaṇi bhārata\njñānam āvṛitya tu tamaḥ pramāde sañjayaty uta", translation_en: "Sattva attaches to happiness, Rajas to action, O Arjuna, while Tamas, verily shrouding knowledge, attaches to heedlessness.", translation_hi: "हे भारत ! सत्त्वगुण सुख में आसक्त कर देता है और रजोगुण कर्म में, किन्तु तमोगुण ज्ञान को आवृत्त करके जीव को प्रमाद से युक्त कर देता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/014_009.mp3"},
  {id: "BG_14.10", label: "BG 14.10", ref: "14.10", chapter: 14, verse: 10, speaker: "krishna", canonical: true, meter: "anustubh", sa: "रजस्तमश्चाभिभूय सत्त्वं भवति भारत", snippet: "Now, O Arjuna, Sattva prevails, having overpowered Rajas and Tamas; then Rajas, having overpowered Sattva and Tamas; and then Tamas, having overpowered Sattva and Rajas.", sanskrit: "रजस्तमश्चाभिभूय सत्त्वं भवति भारत ।\nरजः सत्त्वं तमश्चैव तमः सत्त्वं रजस्तथा ॥", iast: "rajastamaścābhibhūya sattvaṃ bhavati bhārata |\nrajaḥ sattvaṃ tamaścaiva tamaḥ sattvaṃ rajastathā ||", transliteration: "rajas tamaśh chābhibhūya sattvaṁ bhavati bhārata\nrajaḥ sattvaṁ tamaśh chaiva tamaḥ sattvaṁ rajas tathā", translation_en: "Now, O Arjuna, Sattva prevails, having overpowered Rajas and Tamas; then Rajas, having overpowered Sattva and Tamas; and then Tamas, having overpowered Sattva and Rajas.", translation_hi: "हे भारत ! कभी रज और तम को अभिभूत (दबा) करके सत्त्वगुण की वृद्धि होती है, कभी रज और सत्त्व को दबाकर तमोगुण की वृद्धि होती है, तो कभी तम और सत्त्व को अभिभूत कर रजोगुण की वृद्धि होती है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/014_010.mp3"},
  {id: "BG_14.11", label: "BG 14.11", ref: "14.11", chapter: 14, verse: 11, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सर्वद्वारेषु देहेऽस्मिन्प्रकाश उपजायते", snippet: "When the wisdom-light shines through every gate of this body, then it may be known that Sattva is predominant.", sanskrit: "सर्वद्वारेषु देहेऽस्मिन्प्रकाश उपजायते ।\nज्ञानं यदा तदा विद्याद्विवृद्धं सत्त्वमित्युत ॥", iast: "sarvadvāreṣu dehe’sminprakāśa upajāyate |\njñānaṃ yadā tadā vidyādvivṛddhaṃ sattvamityuta ||", transliteration: "sarva-dvāreṣhu dehe ’smin prakāśha upajāyate\njñānaṁ yadā tadā vidyād vivṛiddhaṁ sattvam ity uta", translation_en: "When the wisdom-light shines through every gate of this body, then it may be known that Sattva is predominant.", translation_hi: "जब इस देह के द्वारों अर्थात् समस्त इन्द्रियों में ज्ञानरूप प्रकाश उत्पन्न होता है, तब सत्त्वगुण को प्रवृद्ध हुआ जानो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/014_011.mp3"},
  {id: "BG_14.12", label: "BG 14.12", ref: "14.12", chapter: 14, verse: 12, speaker: "krishna", canonical: true, meter: "anustubh", sa: "लोभः प्रवृत्तिरारम्भः कर्मणामशमः स्पृहा", snippet: "Greed, activity, the undertaking of actions, restlessness, and longing—these arise when Rajas is predominant, O Arjuna.", sanskrit: "लोभः प्रवृत्तिरारम्भः कर्मणामशमः स्पृहा ।\nरजस्येतानि जायन्ते विवृद्धे भरतर्षभ ॥", iast: "lobhaḥ pravṛttirārambhaḥ karmaṇāmaśamaḥ spṛhā |\nrajasyetāni jāyante vivṛddhe bharatarṣabha ||", transliteration: "lobhaḥ pravṛittir ārambhaḥ karmaṇām aśhamaḥ spṛihā\nrajasy etāni jāyante vivṛiddhe bharatarṣhabha", translation_en: "Greed, activity, the undertaking of actions, restlessness, and longing—these arise when Rajas is predominant, O Arjuna.", translation_hi: "हे भरत-श्रेष्ठ ! रजोगुण के प्रवृद्ध होने पर लोभ, प्रवृत्ति (सामान्य चेष्टा) कर्मों का आरम्भ, शम का अभाव तथा स्पृहा, ये सब उत्पन्न होते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/014_012.mp3"},
  {id: "BG_14.13", label: "BG 14.13", ref: "14.13", chapter: 14, verse: 13, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अप्रकाशोऽप्रवृत्तिश्च प्रमादो मोह एव च", snippet: "Darkness, inertia, carelessness, and delusion—these arise when Tamas is predominant, O Arjuna.", sanskrit: "अप्रकाशोऽप्रवृत्तिश्च प्रमादो मोह एव च ।\nतमस्येतानि जायन्ते विवृद्धे कुरुनन्दन ॥", iast: "aprakāśo’pravṛttiśca pramādo moha eva ca |\ntamasyetāni jāyante vivṛddhe kurunandana ||", transliteration: "aprakāśho ’pravṛittiśh cha pramādo moha eva cha\ntamasy etāni jāyante vivṛiddhe kuru-nandana", translation_en: "Darkness, inertia, carelessness, and delusion—these arise when Tamas is predominant, O Arjuna.", translation_hi: "हे कुरुनन्दन ! तमोगुण के प्रवृद्ध होने पर अप्रकाश, अप्रवृत्ति, प्रमाद और मोह ये सब उत्पन्न होते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/014_013.mp3"},
  {id: "BG_14.14", label: "BG 14.14", ref: "14.14", chapter: 14, verse: 14, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यदा सत्त्वे प्रवृद्धे तु प्रलयं याति देहभृत्", snippet: "If the embodied one meets death when Sattva is predominant, then they attain the spotless worlds of the knowers of the Highest.", sanskrit: "यदा सत्त्वे प्रवृद्धे तु प्रलयं याति देहभृत् ।\nतदोत्तमविदां लोकानमलान्प्रतिपद्यते ॥", iast: "yadā sattve pravṛddhe tu pralayaṃ yāti dehabhṛt |\ntadottamavidāṃ lokānamalānpratipadyate ||", transliteration: "yadā sattve pravṛiddhe tu pralayaṁ yāti deha-bhṛit\ntadottama-vidāṁ lokān amalān pratipadyate", translation_en: "If the embodied one meets death when Sattva is predominant, then they attain the spotless worlds of the knowers of the Highest.", translation_hi: "जब यह जीव (देहभृत्) सत्त्वगुण की प्रवृद्धि में मृत्यु को प्राप्त होता है, तब उत्तम कर्म करने वालों के निर्मल अर्थात् स्वर्गादि लोकों को प्राप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/014_014.mp3"},
  {id: "BG_14.15", label: "BG 14.15", ref: "14.15", chapter: 14, verse: 15, speaker: "krishna", canonical: true, meter: "anustubh", sa: "रजसि प्रलयं गत्वा कर्मसङ्गिषु जायते", snippet: "Meeting death in Rajas, he is born among those who are attached to action; and dying in Tamas, he is born in the womb of the thoughtless.", sanskrit: "रजसि प्रलयं गत्वा कर्मसङ्गिषु जायते ।\nतथा प्रलीनस्तमसि मूढयोनिषु जायते ॥", iast: "rajasi pralayaṃ gatvā karmasaṅgiṣu jāyate |\ntathā pralīnastamasi mūḍhayoniṣu jāyate ||", transliteration: "rajasi pralayaṁ gatvā karma-saṅgiṣhu jāyate\ntathā pralīnas tamasi mūḍha-yoniṣhu jāyate", translation_en: "Meeting death in Rajas, he is born among those who are attached to action; and dying in Tamas, he is born in the womb of the thoughtless.", translation_hi: "रजोगुण के प्रवृद्ध काल में मृत्यु को प्राप्त होकर कर्मासक्ति वाले (मनुष्य) लोक में वह जन्म लेता है तथा तमोगुण के प्रवृद्धकाल में (मरण होने पर) मूढ़योनि में जन्म लेता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/014_015.mp3"},
  {id: "BG_14.16", label: "BG 14.16", ref: "14.16", chapter: 14, verse: 16, speaker: "krishna", canonical: true, meter: "anustubh", sa: "कर्मणः सुकृतस्याहुः सात्त्विकं निर्मलं फलम्", snippet: "They say that the fruit of good action is Sattvic and pure; indeed, the fruit of Rajas is pain, and the fruit of Tamas is ignorance.", sanskrit: "कर्मणः सुकृतस्याहुः सात्त्विकं निर्मलं फलम् ।\nरजसस्तु फलं दुःखमज्ञानं तमसः फलम् ॥", iast: "karmaṇaḥ sukṛtasyāhuḥ sāttvikaṃ nirmalaṃ phalam |\nrajasastu phalaṃ duḥkhamajñānaṃ tamasaḥ phalam ||", transliteration: "karmaṇaḥ sukṛitasyāhuḥ sāttvikaṁ nirmalaṁ phalam\nrajasas tu phalaṁ duḥkham ajñānaṁ tamasaḥ phalam", translation_en: "They say that the fruit of good action is Sattvic and pure; indeed, the fruit of Rajas is pain, and the fruit of Tamas is ignorance.", translation_hi: "शुभ कर्म का फल सात्विक और निर्मल कहा गया है; रजोगुण का फल दु;ख और तमोगुण का फल अज्ञान है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/014_016.mp3"},
  {id: "BG_14.17", label: "BG 14.17", ref: "14.17", chapter: 14, verse: 17, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सत्त्वात्सञ्जायते ज्ञानं रजसो लोभ एव च", snippet: "From Sattva arises knowledge, and greed from Rajas; heedlessness and delusion arise from Tamas, and also ignorance.", sanskrit: "सत्त्वात्सञ्जायते ज्ञानं रजसो लोभ एव च ।\nप्रमादमोहौ तमसो भवतोऽज्ञानमेव च ॥", iast: "sattvātsañjāyate jñānaṃ rajaso lobha eva ca |\npramādamohau tamaso bhavato’jñānameva ca ||", transliteration: "sattvāt sañjāyate jñānaṁ rajaso lobha eva cha\npramāda-mohau tamaso bhavato ’jñānam eva cha", translation_en: "From Sattva arises knowledge, and greed from Rajas; heedlessness and delusion arise from Tamas, and also ignorance.", translation_hi: "सत्त्वगुण से ज्ञान उत्पन्न होता है। रजोगुण से लोभ तथा तमोगुण से प्रमाद, मोह और अज्ञान उत्पन्न होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/014_017.mp3"},
  {id: "BG_14.18", label: "BG 14.18", ref: "14.18", chapter: 14, verse: 18, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ऊर्ध्वं गच्छन्ति सत्त्वस्था मध्ये तिष्ठन्ति राजसाः", snippet: "Those seated in Sattva ascend; those of Rajasic nature dwell in the middle; and those of Tamasic nature, abiding in the function of the lowest Guna, descend.", sanskrit: "ऊर्ध्वं गच्छन्ति सत्त्वस्था मध्ये तिष्ठन्ति राजसाः ।\nजघन्यगुणवृत्तिस्था अधो गच्छन्ति तामसाः ॥", iast: "ūrdhvaṃ gacchanti sattvasthā madhye tiṣṭhanti rājasāḥ |\njaghanyaguṇavṛttisthā adho gacchanti tāmasāḥ ||", transliteration: "ūrdhvaṁ gachchhanti sattva-sthā madhye tiṣhṭhanti rājasāḥ\njaghanya-guṇa-vṛitti-sthā adho gachchhanti tāmasāḥ", translation_en: "Those seated in Sattva ascend; those of Rajasic nature dwell in the middle; and those of Tamasic nature, abiding in the function of the lowest Guna, descend.", translation_hi: "सत्त्वगुण में स्थित पुरुष उच्च (लोकों को) जाते हैं; राजस पुरुष मध्य (मनुष्य लोक) में रहते हैं और तमोगुण की अत्यन्त हीन प्रवृत्तियों में स्थित तामस लोग अधोगति को प्राप्त होते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/014_018.mp3"},
  {id: "BG_14.19", label: "BG 14.19", ref: "14.19", chapter: 14, verse: 19, speaker: "krishna", canonical: true, meter: "anustubh", sa: "नान्यं गुणेभ्यः कर्तारं यदा द्रष्टानुपश्यति", snippet: "When the seer beholds no agent other than the Gunas and knows that which is higher than them, he attains to My Being.", sanskrit: "नान्यं गुणेभ्यः कर्तारं यदा द्रष्टानुपश्यति ।\nगुणेभ्यश्च परं वेत्ति मद्भावं सोऽधिगच्छति ॥", iast: "nānyaṃ guṇebhyaḥ kartāraṃ yadā draṣṭānupaśyati |\nguṇebhyaśca paraṃ vetti madbhāvaṃ so’dhigacchati ||", transliteration: "nānyaṁ guṇebhyaḥ kartāraṁ yadā draṣhṭānupaśhyati\nguṇebhyaśh cha paraṁ vetti mad-bhāvaṁ so ’dhigachchhati", translation_en: "When the seer beholds no agent other than the Gunas and knows that which is higher than them, he attains to My Being.", translation_hi: "जब द्रष्टा (साधक) पुरुष तीनों गुणों के अतिरिक्त किसी अन्य को कर्ता नहीं देखता, अर्थात् नहीं समझता है और तीनों गुणों से परे मेरे तत्व को जानता है, तब वह मेरे स्वरूप को प्राप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/014_019.mp3"},
  {id: "BG_14.20", label: "BG 14.20", ref: "14.20", chapter: 14, verse: 20, speaker: "krishna", canonical: true, meter: "anustubh", sa: "गुणानेतानतीत्य त्रीन्देही देहसमुद्भवान्", snippet: "The embodied one, having crossed beyond these three Gunas from which the body is evolved, is freed from birth, death, decay, and pain, and attains immortality.", sanskrit: "गुणानेतानतीत्य त्रीन्देही देहसमुद्भवान् ।\nजन्ममृत्युजरादुःखैर्विमुक्तोऽमृतमश्नुते ॥", iast: "guṇānetānatītya trīndehī dehasamudbhavān |\njanmamṛtyujarāduḥkhairvimukto’mṛtamaśnute ||", transliteration: "guṇān etān atītya trīn dehī deha-samudbhavān\njanma-mṛityu-jarā-duḥkhair vimukto ’mṛitam aśhnute", translation_en: "The embodied one, having crossed beyond these three Gunas from which the body is evolved, is freed from birth, death, decay, and pain, and attains immortality.", translation_hi: "यह देही पुरुष शरीर की उत्पत्ति के कारणरूप तीनों गुणों से अतीत होकर जन्म, मृत्यु, जरा और दु:खों से विमुक्त हुआ अमृतत्व को प्राप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/014_020.mp3"},
  {id: "BG_14.21", label: "BG 14.21", ref: "14.21", chapter: 14, verse: 21, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "कैर्लिंगैस्त्रीन्गुणानेतानतीतो भवति प्रभो", snippet: "Arjuna said, \"What are the marks of one who has transcended the three qualities, O Lord? What is their conduct, and how do they go beyond these three qualities?\"", sanskrit: "कैर्लिंगैस्त्रीन्गुणानेतानतीतो भवति प्रभो ।\nकिमाचारः कथं चैतांस्त्रीन्गुणानतिवर्तते ॥", iast: "kairliṃgaistrīnguṇānetānatīto bhavati prabho |\nkimācāraḥ kathaṃ caitāṃstrīnguṇānativartate ||", transliteration: "kair liṅgais trīn guṇān etān atīto bhavati prabho\nkim āchāraḥ kathaṁ chaitāns trīn guṇān ativartate", translation_en: "Arjuna said, \"What are the marks of one who has transcended the three qualities, O Lord? What is their conduct, and how do they go beyond these three qualities?\"", translation_hi: "अर्जुन ने कहा -- हे प्रभो ! इन तीनो गुणों से अतीत हुआ पुरुष किन लक्षणों से युक्त होता है ? वह किस प्रकार के आचरण वाला होता है ? और, वह किस उपाय से इन तीनों गुणों से अतीत होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/014_021.mp3"},
  {id: "BG_14.22", label: "BG 14.22", ref: "14.22", chapter: 14, verse: 22, speaker: "krishna", canonical: true, meter: "anustubh", sa: "प्रकाशं च प्रवृत्तिं च मोहमेव च पाण्डव", snippet: "The Blessed Lord said, \"When light, activity, and delusion are present, he does not hate them, nor does he long for them when they are absent.", sanskrit: "प्रकाशं च प्रवृत्तिं च मोहमेव च पाण्डव ।\nन द्वेष्टि सम्प्रवृत्तानि न निवृत्तानि काङ्क्षति ॥", iast: "prakāśaṃ ca pravṛttiṃ ca mohameva ca pāṇḍava |\nna dveṣṭi sampravṛttāni na nivṛttāni kāṅkṣati ||", transliteration: "prakāśhaṁ cha pravṛittiṁ cha moham eva cha pāṇḍava\nna dveṣhṭi sampravṛittāni na nivṛittāni kāṅkṣhati", translation_en: "The Blessed Lord said, \"When light, activity, and delusion are present, he does not hate them, nor does he long for them when they are absent.", translation_hi: "श्रीभगवान् ने कहा -- हे पाण्डव ! (ज्ञानी पुरुष) प्रकाश, प्रवृत्ति और मोह के प्रवृत्त होने पर भी उनका द्वेष नहीं करता तथा निवृत्त होने पर उनकी आकांक्षा नहीं करता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/014_022.mp3"},
  {id: "BG_14.23", label: "BG 14.23", ref: "14.23", chapter: 14, verse: 23, speaker: "krishna", canonical: true, meter: "anustubh", sa: "उदासीनवदासीनो गुणैर्यो न विचाल्यते", snippet: "He who, seated like one unconcerned, is not moved by the dualities, and who, knowing that the dualities are active, is self-centered and does not move.", sanskrit: "उदासीनवदासीनो गुणैर्यो न विचाल्यते ।\nगुणा वर्तन्त इत्येव योऽवतिष्ठति नेङ्गते ॥", iast: "udāsīnavadāsīno guṇairyo na vicālyate |\nguṇā vartanta ityeva yo’vatiṣṭhati neṅgate ||", transliteration: "udāsīna-vad āsīno guṇair yo na vichālyate\nguṇā vartanta ity evaṁ yo ’vatiṣhṭhati neṅgate", translation_en: "He who, seated like one unconcerned, is not moved by the dualities, and who, knowing that the dualities are active, is self-centered and does not move.", translation_hi: "जो उदासीन के समान आसीन होकर गुणों के द्वारा विचलित नहीं किया जा सकता और \"गुण ही व्यवहार करते हैं\" ऐसा जानकर स्थित रहता है और उस स्थिति से विचलित नहीं होता।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/014_023.mp3"},
  {id: "BG_14.24", label: "BG 14.24", ref: "14.24", chapter: 14, verse: 24, speaker: "krishna", canonical: true, meter: "anustubh", sa: "समदुःखसुखः स्वस्थः समलोष्टाश्मकाञ्चनः", snippet: "Who is the same in pleasure and pain, who dwells in the Self, to whom a clod of earth, a stone, and gold are all alike, who is the same to the dear and the unfriendly, who is…", sanskrit: "समदुःखसुखः स्वस्थः समलोष्टाश्मकाञ्चनः ।\nतुल्यप्रियाप्रियो धीरस्तुल्यनिन्दात्मसंस्तुतिः ॥", iast: "samaduḥkhasukhaḥ svasthaḥ samaloṣṭāśmakāñcanaḥ |\ntulyapriyāpriyo dhīrastulyanindātmasaṃstutiḥ ||", transliteration: "sama-duḥkha-sukhaḥ sva-sthaḥ sama-loṣhṭāśhma-kāñchanaḥ\ntulya-priyāpriyo dhīras tulya-nindātma-sanstutiḥ", translation_en: "Who is the same in pleasure and pain, who dwells in the Self, to whom a clod of earth, a stone, and gold are all alike, who is the same to the dear and the unfriendly, who is firm, and to whom censure and praise are one and the same.", translation_hi: "जो स्वस्थ (स्वरूप में स्थित), सुख-दु:ख में समान रहता है तथा मिट्टी, पत्थर और स्वर्ण में समदृष्टि रखता है; ऐसा वीर पुरुष प्रिय और अप्रिय को तथा निन्दा और आत्मस्तुति को तुल्य समझता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/014_024.mp3"},
  {id: "BG_14.25", label: "BG 14.25", ref: "14.25", chapter: 14, verse: 25, speaker: "krishna", canonical: true, meter: "anustubh", sa: "मानापमानयोस्तुल्यस्तुल्यो मित्रारिपक्षयोः", snippet: "Who is the same in honor and dishonor, the same to friend and foe, abandoning all undertakings, he is said to have transcended the dualities.", sanskrit: "मानापमानयोस्तुल्यस्तुल्यो मित्रारिपक्षयोः ।\nसर्वारम्भपरित्यागी गुणातीतः स उच्यते ॥", iast: "mānāpamānayostulyastulyo mitrāripakṣayoḥ |\nsarvārambhaparityāgī guṇātītaḥ sa ucyate ||", transliteration: "mānāpamānayos tulyas tulyo mitrāri-pakṣhayoḥ\nsarvārambha-parityāgī guṇātītaḥ sa uchyate", translation_en: "Who is the same in honor and dishonor, the same to friend and foe, abandoning all undertakings, he is said to have transcended the dualities.", translation_hi: "जो मान और अपमान में सम है; शत्रु और मित्र के पक्ष में भी सम है, ऐसा सर्वारम्भ परित्यागी पुरुष गुणातीत कहा जाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/014_025.mp3"},
  {id: "BG_14.26", label: "BG 14.26", ref: "14.26", chapter: 14, verse: 26, speaker: "krishna", canonical: true, meter: "anustubh", sa: "मां च योऽव्यभिचारेण भक्तियोगेन सेवते", snippet: "And he who serves Me with unwavering devotion, he, crossing beyond the dualities, is fit for becoming Brahman.", sanskrit: "मां च योऽव्यभिचारेण भक्तियोगेन सेवते ।\nस गुणान्समतीत्यैतान् ब्रह्मभूयाय कल्पते ॥", iast: "māṃ ca yo’vyabhicāreṇa bhaktiyogena sevate |\nsa guṇānsamatītyaitān brahmabhūyāya kalpate ||", transliteration: "māṁ cha yo ’vyabhichāreṇa bhakti-yogena sevate\nsa guṇān samatītyaitān brahma-bhūyāya kalpate", translation_en: "And he who serves Me with unwavering devotion, he, crossing beyond the dualities, is fit for becoming Brahman.", translation_hi: "जो पुरुष अव्यभिचारी भक्तियोग के द्वारा मेरी सेवा अर्थात् उपासना करता है, वह इन तीनों गुणों के अतीत होकर ब्रह्म बनने के लिये योग्य हो जाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/014_026.mp3"},
  {id: "BG_14.27", label: "BG 14.27", ref: "14.27", chapter: 14, verse: 27, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ब्रह्मणो हि प्रतिष्ठाऽहममृतस्याव्ययस्य च", snippet: "For I am the abode of Brahman, the immortal, immutable, and everlasting Dharma, and absolute bliss.", sanskrit: "ब्रह्मणो हि प्रतिष्ठाऽहममृतस्याव्ययस्य च ।\nशाश्वतस्य च धर्मस्य सुखस्यैकान्तिकस्य च ॥", iast: "brahmaṇo hi pratiṣṭhā’hamamṛtasyāvyayasya ca |\nśāśvatasya ca dharmasya sukhasyaikāntikasya ca ||", transliteration: "brahmaṇo hi pratiṣhṭhāham amṛitasyāvyayasya cha\nśhāśhvatasya cha dharmasya sukhasyaikāntikasya cha", translation_en: "For I am the abode of Brahman, the immortal, immutable, and everlasting Dharma, and absolute bliss.", translation_hi: "क्योंकि मैं अमृत, अव्यय, ब्रह्म, शाश्वत धर्म और ऐकान्तिक अर्थात् पारमार्थिक सुख की प्रतिष्ठा हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/014_027.mp3"},
  {id: "BG_15.1", label: "BG 15.1", ref: "15.1", chapter: 15, verse: 1, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ऊर्ध्वमूलमधःशाखमश्वत्थं प्राहुरव्ययम्", snippet: "The Blessed Lord said: They (the wise) speak of the indestructible peepul tree, with its roots above and branches below, whose leaves are the meters or hymns; he who knows it…", sanskrit: "ऊर्ध्वमूलमधःशाखमश्वत्थं प्राहुरव्ययम् ।\nछन्दांसि यस्य पर्णानि यस्तं वेद स वेदवित् ॥", iast: "ūrdhvamūlamadhaḥśākhamaśvatthaṃ prāhuravyayam |\nchandāṃsi yasya parṇāni yastaṃ veda sa vedavit ||", transliteration: "ūrdhva-mūlam adhaḥ-śhākham aśhvatthaṁ prāhur avyayam\nchhandānsi yasya parṇāni yas taṁ veda sa veda-vit", translation_en: "The Blessed Lord said: They (the wise) speak of the indestructible peepul tree, with its roots above and branches below, whose leaves are the meters or hymns; he who knows it is a knower of the Vedas.", translation_hi: "श्री भगवान् ने कहा -- (ज्ञानी पुरुष इस संसार वृक्ष को) ऊर्ध्वमूल और अध:शाखा वाला अश्वत्थ और अव्यय कहते हैं; जिसके पर्ण छन्द अर्थात् वेद हैं, ऐसे (संसार वृक्ष) को जो जानता है, वह वेदवित् है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/015_001.mp3"},
  {id: "BG_15.2", label: "BG 15.2", ref: "15.2", chapter: 15, verse: 2, speaker: "krishna", canonical: true, meter: "tristubh", sa: "अधश्चोर्ध्वं प्रसृतास्तस्य शाखा     गुणप्रवृद्धा विषयप्रवालाः", snippet: "Its branches spread below and above, nourished by the Gunas; its buds are sense-objects, and its roots stretch forth below in the world of men, originating action.", sanskrit: "अधश्चोर्ध्वं प्रसृतास्तस्य शाखा     गुणप्रवृद्धा विषयप्रवालाः ।\nअधश्च मूलान्यनुसन्ततानि     कर्मानुबन्धीनि मनुष्यलोके ॥", iast: "adhaścordhvaṃ prasṛtāstasya śākhā     guṇapravṛddhā viṣayapravālāḥ |\nadhaśca mūlānyanusantatāni     karmānubandhīni manuṣyaloke ||", transliteration: "adhaśh chordhvaṁ prasṛitās tasya śhākhā\nguṇa-pravṛiddhā viṣhaya-pravālāḥ\nadhaśh cha mūlāny anusantatāni\nkarmānubandhīni manuṣhya-loke", translation_en: "Its branches spread below and above, nourished by the Gunas; its buds are sense-objects, and its roots stretch forth below in the world of men, originating action.", translation_hi: "उस वृक्ष की शाखाएं गुणों से प्रवृद्ध हुईं नीचे और ऊपर फैली हुईं हैं; (पंच) विषय इसके अंकुर हैं; मनुष्य लोक में कर्मों का अनुसरण करने वाली इसकी अन्य जड़ें नीचे फैली हुईं हैं।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/015_002.mp3"},
  {id: "BG_15.3", label: "BG 15.3", ref: "15.3", chapter: 15, verse: 3, speaker: "krishna", canonical: true, meter: "tristubh-jagati", sa: "न रूपमस्येह तथोपलभ्यते    नान्तो न चादिर्न च संप्रतिष्ठा", snippet: "Its form is not perceived here as such, nor its end, origin, foundation, or resting place; having cut asunder this firmly rooted peepul tree with the strong axe of non-attachment.", sanskrit: "न रूपमस्येह तथोपलभ्यते    नान्तो न चादिर्न च संप्रतिष्ठा ।\nअश्वत्थमेनं सुविरूढमूल    मसङ्गशस्त्रेण दृढेन छित्त्वा ॥", iast: "na rūpamasyeha tathopalabhyate    nānto na cādirna ca saṃpratiṣṭhā |\naśvatthamenaṃ suvirūḍhamūla    masaṅgaśastreṇa dṛḍhena chittvā ||", transliteration: "na rūpam asyeha tathopalabhyate\nnānto na chādir na cha sampratiṣhṭhā\naśhvattham enaṁ su-virūḍha-mūlam\nasaṅga-śhastreṇa dṛiḍhena chhittvā", translation_en: "Its form is not perceived here as such, nor its end, origin, foundation, or resting place; having cut asunder this firmly rooted peepul tree with the strong axe of non-attachment.", translation_hi: "इस (संसार वृक्ष) का स्वरूप जैसा कहा गया है वैसा यहाँ उपलब्ध नहीं होता है, क्योंकि इसका न आदि है और न अंत और न प्रतिष्ठा ही है। इस अति दृढ़ मूल वाले अश्वत्थ वृक्ष को दृढ़ असङ्ग शस्त्र से काटकर ...৷৷৷৷।।", meter_name: "Upajāti (Triṣṭubh–Jagatī mixed)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/015_003.mp3"},
  {id: "BG_15.4", label: "BG 15.4", ref: "15.4", chapter: 15, verse: 4, speaker: "krishna", canonical: true, meter: "tristubh", sa: "ततः पदं तत्परिमार्गितव्य    यस्मिन्गता न निवर्तन्ति भूयः", snippet: "Then, that goal should be sought for, to which, having gone, none returns again. I seek refuge in that Primeval Purusha, from whence streamed forth the ancient activity or energy.", sanskrit: "ततः पदं तत्परिमार्गितव्य    यस्मिन्गता न निवर्तन्ति भूयः ।\nतमेव चाद्यं पुरुषं प्रपद्ये    यतः प्रवृत्तिः प्रसृता पुराणी ॥", iast: "tataḥ padaṃ tatparimārgitavya    yasmingatā na nivartanti bhūyaḥ |\ntameva cādyaṃ puruṣaṃ prapadye    yataḥ pravṛttiḥ prasṛtā purāṇī ||", transliteration: "tataḥ padaṁ tat parimārgitavyaṁ\nyasmin gatā na nivartanti bhūyaḥ\ntam eva chādyaṁ puruṣhaṁ prapadye\nyataḥ pravṛittiḥ prasṛitā purāṇī", translation_en: "Then, that goal should be sought for, to which, having gone, none returns again. I seek refuge in that Primeval Purusha, from whence streamed forth the ancient activity or energy.", translation_hi: "(तदुपरान्त) उस पद का अन्वेषण करना चाहिए जिसको प्राप्त हुए पुरुष पुन: संसार में नहीं लौटते हैं। \"मैं उस आदि पुरुष की शरण हूँ, जिससे यह पुरातन प्रवृत्ति प्रसृत हुई है\"।।", meter_name: "Triṣṭubh — Upajāti", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/015_004.mp3"},
  {id: "BG_15.5", label: "BG 15.5", ref: "15.5", chapter: 15, verse: 5, speaker: "krishna", canonical: true, meter: "tristubh", sa: "निर्मानमोहा जितसङ्गदोषा    अध्यात्मनित्या विनिवृत्तकामाः", snippet: "Free from pride and delusion, victorious over the evil of attachment, dwelling constantly in the Self, their desires having completely turned away, freed from the pairs of…", sanskrit: "निर्मानमोहा जितसङ्गदोषा    अध्यात्मनित्या विनिवृत्तकामाः ।\nद्वन्द्वैर्विमुक्ताः सुखदुःखसंज्ञै    र्गच्छन्त्यमूढाः पदमव्ययं तत् ॥", iast: "nirmānamohā jitasaṅgadoṣā    adhyātmanityā vinivṛttakāmāḥ |\ndvandvairvimuktāḥ sukhaduḥkhasaṃjñai    rgacchantyamūḍhāḥ padamavyayaṃ tat ||", transliteration: "nirmāna-mohā jita-saṅga-doṣhā\nadhyātma-nityā vinivṛitta-kāmāḥ\ndvandvair vimuktāḥ sukha-duḥkha-sanjñair\ngachchhanty amūḍhāḥ padam avyayaṁ tat", translation_en: "Free from pride and delusion, victorious over the evil of attachment, dwelling constantly in the Self, their desires having completely turned away, freed from the pairs of opposites known as pleasure and pain, they, the undeluded, reach the eternal goal.", translation_hi: "जिनका मान और मोह निवृत्त हो गया है, जिन्होंने संगदोष को जीत लिया है, जो अध्यात्म में स्थित हैं जिनकी कामनाएं निवृत्त हो चुकी हैं और जो सुख-दु:ख नामक द्वन्द्वों से विमुक्त हो गये हैं, ऐसे सम्मोह रहित ज्ञानीजन उस अव्यय पद को प्राप्त होते हैं।।", meter_name: "Triṣṭubh — Indravajrā", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/015_005.mp3"},
  {id: "BG_15.6", label: "BG 15.6", ref: "15.6", chapter: 15, verse: 6, speaker: "krishna", canonical: true, meter: "anustubh", sa: "न तद्भासयते सूर्यो न शशाङ्को न पावकः", snippet: "Neither does the sun illuminate there, nor the moon, nor the fire; having gone there, they do not return; that is My supreme abode.", sanskrit: "न तद्भासयते सूर्यो न शशाङ्को न पावकः ।\nयद्गत्वा न निवर्तन्ते तद्धाम परमं मम ॥", iast: "na tadbhāsayate sūryo na śaśāṅko na pāvakaḥ |\nyadgatvā na nivartante taddhāma paramaṃ mama ||", transliteration: "na tad bhāsayate sūryo na śhaśhāṅko na pāvakaḥ\nyad gatvā na nivartante tad dhāma paramaṁ mama", translation_en: "Neither does the sun illuminate there, nor the moon, nor the fire; having gone there, they do not return; that is My supreme abode.", translation_hi: "उसे न सूर्य प्रकाशित कर सकता है और न चन्द्रमा और न अग्नि। जिसे प्राप्त कर मनुष्य पुन: (संसार को) नहीं लौटते हैं, वह मेरा परम धाम है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/015_006.mp3"},
  {id: "BG_15.7", label: "BG 15.7", ref: "15.7", chapter: 15, verse: 7, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ममैवांशो जीवलोके जीवभूतः सनातनः", snippet: "An eternal portion of Myself having become a living soul in the world of life, draws to itself the five senses, with the mind as the sixth, abiding in Nature.", sanskrit: "ममैवांशो जीवलोके जीवभूतः सनातनः ।\nमनःषष्ठानीन्द्रियाणि प्रकृतिस्थानि कर्षति ॥", iast: "mamaivāṃśo jīvaloke jīvabhūtaḥ sanātanaḥ |\nmanaḥṣaṣṭhānīndriyāṇi prakṛtisthāni karṣati ||", transliteration: "mamaivānśho jīva-loke jīva-bhūtaḥ sanātanaḥ\nmanaḥ-ṣhaṣhṭhānīndriyāṇi prakṛiti-sthāni karṣhati", translation_en: "An eternal portion of Myself having become a living soul in the world of life, draws to itself the five senses, with the mind as the sixth, abiding in Nature.", translation_hi: "इस जीव लोक में मेरा ही एक सनातन अंश जीव बना है। वह प्रकृति में स्थित हुआ (देहत्याग के समय) पाँचो इन्द्रियों तथा मन को अपनी ओर खींच लेता है अर्थात् उन्हें एकत्रित कर लेता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/015_007.mp3"},
  {id: "BG_15.8", label: "BG 15.8", ref: "15.8", chapter: 15, verse: 8, speaker: "krishna", canonical: true, meter: "anustubh", sa: "शरीरं यदवाप्नोति यच्चाप्युत्क्रामतीश्वरः", snippet: "When the Lord, as the individual soul, obtains a body and when He leaves it, He takes these with Him, just as the wind takes the scents from their seats (flowers, etc.).", sanskrit: "शरीरं यदवाप्नोति यच्चाप्युत्क्रामतीश्वरः ।\nगृहीत्वैतानि संयाति वायुर्गन्धानिवाशयात् ॥", iast: "śarīraṃ yadavāpnoti yaccāpyutkrāmatīśvaraḥ |\ngṛhītvaitāni saṃyāti vāyurgandhānivāśayāt ||", transliteration: "śharīraṁ yad avāpnoti yach chāpy utkrāmatīśhvaraḥ\ngṛihītvaitāni sanyāti vāyur gandhān ivāśhayāt", translation_en: "When the Lord, as the individual soul, obtains a body and when He leaves it, He takes these with Him, just as the wind takes the scents from their seats (flowers, etc.).", translation_hi: "जब (देहादि का) ईश्वर (जीव) (एक शरीर से) उत्क्रमण करता है, तब इन (इन्द्रियों और मन) को ग्रहण कर अन्य शरीर में इस प्रकार ले जाता है, जैसे गन्ध के आश्रय (फूलादि) से गन्ध को वायु ले जाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/015_008.mp3"},
  {id: "BG_15.9", label: "BG 15.9", ref: "15.9", chapter: 15, verse: 9, speaker: "krishna", canonical: true, meter: "anustubh", sa: "श्रोत्रं चक्षुः स्पर्शनं च रसनं घ्राणमेव च", snippet: "Presiding over the ears, eyes, touch, taste, smell, and mind, it enjoys the objects of the senses.", sanskrit: "श्रोत्रं चक्षुः स्पर्शनं च रसनं घ्राणमेव च ।\nअधिष्ठाय मनश्चायं विषयानुपसेवते ॥", iast: "śrotraṃ cakṣuḥ sparśanaṃ ca rasanaṃ ghrāṇameva ca |\nadhiṣṭhāya manaścāyaṃ viṣayānupasevate ||", transliteration: "śhrotraṁ chakṣhuḥ sparśhanaṁ cha rasanaṁ ghrāṇam eva cha\nadhiṣhṭhāya manaśh chāyaṁ viṣhayān upasevate", translation_en: "Presiding over the ears, eyes, touch, taste, smell, and mind, it enjoys the objects of the senses.", translation_hi: "(यह जीव) श्रोत्र, चक्षु, स्पर्शेन्द्रिय, रसना और घ्राण (नाक) इन इन्द्रियों तथा मन को आश्रय करके अर्थात् इनके द्वारा विषयों का सेवन करता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/015_009.mp3"},
  {id: "BG_15.10", label: "BG 15.10", ref: "15.10", chapter: 15, verse: 10, speaker: "krishna", canonical: true, meter: "anustubh", sa: "उत्क्रामन्तं स्थितं वापि भुञ्जानं वा गुणान्वितम्", snippet: "The deluded do not see Him who departs, stays, and enjoys; but those who possess the eye of knowledge behold Him.", sanskrit: "उत्क्रामन्तं स्थितं वापि भुञ्जानं वा गुणान्वितम् ।\nविमूढा नानुपश्यन्ति पश्यन्ति ज्ञानचक्षुषः ॥", iast: "utkrāmantaṃ sthitaṃ vāpi bhuñjānaṃ vā guṇānvitam |\nvimūḍhā nānupaśyanti paśyanti jñānacakṣuṣaḥ ||", transliteration: "utkrāmantaṁ sthitaṁ vāpi bhuñjānaṁ vā guṇānvitam\nvimūḍhā nānupaśhyanti paśhyanti jñāna-chakṣhuṣhaḥ", translation_en: "The deluded do not see Him who departs, stays, and enjoys; but those who possess the eye of knowledge behold Him.", translation_hi: "शरीर को त्यागते हुये, उसमें स्थित हुये अथवा (विषयों को) भोगते हुये, गुणों से समन्वित आत्मा को विमूढ़ लोग नहीं देखते हैं; (परन्तु) ज्ञानचक्षु वाले पुरुष उसे देखते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/015_010.mp3"},
  {id: "BG_15.11", label: "BG 15.11", ref: "15.11", chapter: 15, verse: 11, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यतन्तो योगिनश्चैनं पश्यन्त्यात्मन्यवस्थितम्", snippet: "The yogis striving for perfection behold Him dwelling in the Self; but, the unrefined and unintelligent, even though striving, do not see Him.", sanskrit: "यतन्तो योगिनश्चैनं पश्यन्त्यात्मन्यवस्थितम् ।\nयतन्तोऽप्यकृतात्मानो नैनं पश्यन्त्यचेतसः ॥", iast: "yatanto yoginaścainaṃ paśyantyātmanyavasthitam |\nyatanto’pyakṛtātmāno nainaṃ paśyantyacetasaḥ ||", transliteration: "yatanto yoginaśh chainaṁ paśhyanty ātmany avasthitam\nyatanto ‘py akṛitātmāno nainaṁ paśhyanty achetasaḥ", translation_en: "The yogis striving for perfection behold Him dwelling in the Self; but, the unrefined and unintelligent, even though striving, do not see Him.", translation_hi: "योगीजन प्रयत्न करते हुये ही अपने हृदय में स्थित आत्मा को देखते हैं, जब कि अशुद्ध अन्त:करण वाले (अकृतात्मान:) और अविवेकी (अचेतस:) लोग यत्न करते हुये भी इसे नहीं देखते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/015_011.mp3"},
  {id: "BG_15.12", label: "BG 15.12", ref: "15.12", chapter: 15, verse: 12, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यदादित्यगतं तेजो जगद्भासयतेऽखिलम्", snippet: "That light which resides in the sun, illuminating the whole world; that which is in the moon and in the fire—know that light to be Mine.", sanskrit: "यदादित्यगतं तेजो जगद्भासयतेऽखिलम् ।\nयच्चन्द्रमसि यच्चाग्नौ तत्तेजो विद्धि मामकम् ॥", iast: "yadādityagataṃ tejo jagadbhāsayate’khilam |\nyaccandramasi yaccāgnau tattejo viddhi māmakam ||", transliteration: "yad āditya-gataṁ tejo jagad bhāsayate ’khilam\nyach chandramasi yach chāgnau tat tejo viddhi māmakam", translation_en: "That light which resides in the sun, illuminating the whole world; that which is in the moon and in the fire—know that light to be Mine.", translation_hi: "जो तेज सूर्य में स्थित होकर सम्पूर्ण जगत् को प्रकाशित करता है तथा जो तेज चन्द्रमा में है और अग्नि में है, उस तेज को तुम मेरा ही जानो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/015_012.mp3"},
  {id: "BG_15.13", label: "BG 15.13", ref: "15.13", chapter: 15, verse: 13, speaker: "krishna", canonical: true, meter: "anustubh", sa: "गामाविश्य च भूतानि धारयाम्यहमोजसा", snippet: "Permeating the earth, I support all beings with My energy; and having become the watery moon, I nourish all herbs.", sanskrit: "गामाविश्य च भूतानि धारयाम्यहमोजसा ।\nपुष्णामि चौषधीः सर्वाः सोमो भूत्वा रसात्मकः ॥", iast: "gāmāviśya ca bhūtāni dhārayāmyahamojasā |\npuṣṇāmi cauṣadhīḥ sarvāḥ somo bhūtvā rasātmakaḥ ||", transliteration: "gām āviśhya cha bhūtāni dhārayāmy aham ojasā\npuṣhṇāmi chauṣhadhīḥ sarvāḥ somo bhūtvā rasātmakaḥ", translation_en: "Permeating the earth, I support all beings with My energy; and having become the watery moon, I nourish all herbs.", translation_hi: "मैं ही पृथ्वी में प्रवेश करके अपने ओज से भूतमात्र को धारण करता हूँ और रसस्वरूप चन्द्रमा बनकर समस्त औषधियों का अर्थात् वनस्पतियों का पोषण करता हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/015_013.mp3"},
  {id: "BG_15.14", label: "BG 15.14", ref: "15.14", chapter: 15, verse: 14, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अहं वैश्वानरो भूत्वा प्राणिनां देहमाश्रितः", snippet: "Having become the fire Vaisvanara, I abide in the bodies of living beings and, associated with the Prana and the Apana, digest the fourfold food.", sanskrit: "अहं वैश्वानरो भूत्वा प्राणिनां देहमाश्रितः ।\nप्राणापानसमायुक्तः पचाम्यन्नं चतुर्विधम् ॥", iast: "ahaṃ vaiśvānaro bhūtvā prāṇināṃ dehamāśritaḥ |\nprāṇāpānasamāyuktaḥ pacāmyannaṃ caturvidham ||", transliteration: "ahaṁ vaiśhvānaro bhūtvā prāṇināṁ deham āśhritaḥ\nprāṇāpāna-samāyuktaḥ pachāmy annaṁ chatur-vidham", translation_en: "Having become the fire Vaisvanara, I abide in the bodies of living beings and, associated with the Prana and the Apana, digest the fourfold food.", translation_hi: "मैं ही समस्त प्राणियों के देह में स्थित वैश्वानर अग्निरूप होकर प्राण और अपान से युक्त चार प्रकार के अन्न को पचाता हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/015_014.mp3"},
  {id: "BG_15.15", label: "BG 15.15", ref: "15.15", chapter: 15, verse: 15, speaker: "krishna", canonical: true, meter: "tristubh", sa: "सर्वस्य चाहं हृदि सन्निविष्टो    मत्तः स्मृतिर्ज्ञानमपोहनं च", snippet: "And I am seated in the hearts of all; from Me come memory and knowledge, as well as their absence. I am verily That which has to be known by all the Vedas; I am indeed the…", sanskrit: "सर्वस्य चाहं हृदि सन्निविष्टो    मत्तः स्मृतिर्ज्ञानमपोहनं च ।\nवेदैश्च सर्वैरहमेव वेद्यो    वेदान्तकृद्वेदविदेव चाहम् ॥", iast: "sarvasya cāhaṃ hṛdi sanniviṣṭo    mattaḥ smṛtirjñānamapohanaṃ ca |\nvedaiśca sarvairahameva vedyo    vedāntakṛdvedavideva cāham ||", transliteration: "sarvasya chāhaṁ hṛidi sanniviṣhṭo\nmattaḥ smṛitir jñānam apohanaṁ cha\nvedaiśh cha sarvair aham eva vedyo\nvedānta-kṛid veda-vid eva chāham", translation_en: "And I am seated in the hearts of all; from Me come memory and knowledge, as well as their absence. I am verily That which has to be known by all the Vedas; I am indeed the author of the Vedanta and the knower of the Vedas.", translation_hi: "मैं ही समस्त प्राणियों के हृदय में स्थित हूँ। मुझसे ही स्मृति, ज्ञान और अपोहन (उनका अभाव) होता है। समस्त वेदों के द्वारा मैं ही वेद्य (जानने योग्य) वस्तु हूँ तथा वेदान्त का और वेदों का ज्ञाता भी मैं ही हूँ।।", meter_name: "Triṣṭubh — Indravajrā", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/015_015.mp3"},
  {id: "BG_15.16", label: "BG 15.16", ref: "15.16", chapter: 15, verse: 16, speaker: "krishna", canonical: true, meter: "anustubh", sa: "द्वाविमौ पुरुषौ लोके क्षरश्चाक्षर एव च", snippet: "Two Purushas there are in this world: the perishable and the imperishable. All beings are perishable, and the Kutastha—the unchanging—is called the imperishable.", sanskrit: "द्वाविमौ पुरुषौ लोके क्षरश्चाक्षर एव च ।\nक्षरः सर्वाणि भूतानि कूटस्थोऽक्षर उच्यते ॥", iast: "dvāvimau puruṣau loke kṣaraścākṣara eva ca |\nkṣaraḥ sarvāṇi bhūtāni kūṭastho’kṣara ucyate ||", transliteration: "dvāv imau puruṣhau loke kṣharaśh chākṣhara eva cha\nkṣharaḥ sarvāṇi bhūtāni kūṭa-stho ’kṣhara uchyate", translation_en: "Two Purushas there are in this world: the perishable and the imperishable. All beings are perishable, and the Kutastha—the unchanging—is called the imperishable.", translation_hi: "इस लोक में क्षर (नश्वर) और अक्षर (अनश्वर) ये दो पुरुष हैं, समस्त भूत क्षर हैं और 'कूटस्थ' अक्षर कहलाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/015_016.mp3"},
  {id: "BG_15.17", label: "BG 15.17", ref: "15.17", chapter: 15, verse: 17, speaker: "krishna", canonical: true, meter: "anustubh", sa: "उत्तमः पुरुषस्त्वन्यः परमात्मेत्युदाहृतः", snippet: "But distinct is the Supreme Purusha, called the highest Self, indestructible and Lord, who pervades the three worlds and sustains them.", sanskrit: "उत्तमः पुरुषस्त्वन्यः परमात्मेत्युदाहृतः ।\nयो लोकत्रयमाविश्य बिभर्त्यव्यय ईश्वरः ॥", iast: "uttamaḥ puruṣastvanyaḥ paramātmetyudāhṛtaḥ |\nyo lokatrayamāviśya bibhartyavyaya īśvaraḥ ||", transliteration: "uttamaḥ puruṣhas tv anyaḥ paramātmety udāhṛitaḥ\nyo loka-trayam āviśhya bibharty avyaya īśhvaraḥ", translation_en: "But distinct is the Supreme Purusha, called the highest Self, indestructible and Lord, who pervades the three worlds and sustains them.", translation_hi: "परन्तु उत्तम पुरुष अन्य ही है, जो परमात्मा कहलाता है और जो तीनों लोकों में प्रवेश करके सबका धारण करने वाला अव्यय ईश्वर है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/015_017.mp3"},
  {id: "BG_15.18", label: "BG 15.18", ref: "15.18", chapter: 15, verse: 18, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यस्मात्क्षरमतीतोऽहमक्षरादपि चोत्तमः", snippet: "As I transcend the perishable and am even higher than the imperishable, I am declared to be the highest Purusha in the world and in the Vedas.", sanskrit: "यस्मात्क्षरमतीतोऽहमक्षरादपि चोत्तमः ।\nअतोऽस्मि लोके वेदे च प्रथितः पुरुषोत्तमः ॥", iast: "yasmātkṣaramatīto’hamakṣarādapi cottamaḥ |\nato’smi loke vede ca prathitaḥ puruṣottamaḥ ||", transliteration: "yasmāt kṣharam atīto ’ham akṣharād api chottamaḥ\nato ’smi loke vede cha prathitaḥ puruṣhottamaḥ", translation_en: "As I transcend the perishable and am even higher than the imperishable, I am declared to be the highest Purusha in the world and in the Vedas.", translation_hi: "क्योंकि मैं क्षर से अतीत हूँ और अक्षर से भी उत्तम हूँ, इसलिये लोक में और वेद में भी पुरुषोत्तम के नाम से प्रसिद्ध हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/015_018.mp3"},
  {id: "BG_15.19", label: "BG 15.19", ref: "15.19", chapter: 15, verse: 19, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यो मामेवमसम्मूढो जानाति पुरुषोत्तमम्", snippet: "He who, undeluded, knows Me as the highest Purusha, he, knowing all, worships Me with his whole being (heart), O Arjuna.", sanskrit: "यो मामेवमसम्मूढो जानाति पुरुषोत्तमम् ।\nस सर्वविद्भजति मां सर्वभावेन भारत ॥", iast: "yo māmevamasammūḍho jānāti puruṣottamam |\nsa sarvavidbhajati māṃ sarvabhāvena bhārata ||", transliteration: "yo mām evam asammūḍho jānāti puruṣhottamam\nsa sarva-vid bhajati māṁ sarva-bhāvena bhārata", translation_en: "He who, undeluded, knows Me as the highest Purusha, he, knowing all, worships Me with his whole being (heart), O Arjuna.", translation_hi: "हे भारत ! इस प्रकार, जो, संमोहरहित, पुरुष मुझ पुरुषोत्तम को जानता है, वह सर्वज्ञ होकर सम्पूर्ण भाव से अर्थात् पूर्ण हृदय से मेरी भक्ति करता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/015_019.mp3"},
  {id: "BG_15.20", label: "BG 15.20", ref: "15.20", chapter: 15, verse: 20, speaker: "krishna", canonical: true, meter: "anustubh", sa: "इति गुह्यतमं शास्त्रमिदमुक्तं मयाऽनघ", snippet: "Thus, I have imparted to you this most secret science, O sinless one; by knowing this, one becomes wise, and all their duties are accomplished, O Arjuna.", sanskrit: "इति गुह्यतमं शास्त्रमिदमुक्तं मयाऽनघ ।\nएतद्बुद्ध्वा बुद्धिमान्स्यात्कृतकृत्यश्च भारत ॥", iast: "iti guhyatamaṃ śāstramidamuktaṃ mayā’nagha |\netadbuddhvā buddhimānsyātkṛtakṛtyaśca bhārata ||", transliteration: "iti guhyatamaṁ śhāstram idam uktaṁ mayānagha\netad buddhvā buddhimān syāt kṛita-kṛityaśh cha bhārata", translation_en: "Thus, I have imparted to you this most secret science, O sinless one; by knowing this, one becomes wise, and all their duties are accomplished, O Arjuna.", translation_hi: "हे निष्पाप भारत ! इस प्रकार यह गुह्यतम शास्त्र मेरे द्वारा कहा गया, इसको जानकर मनुष्य बुद्धिमान और कृतकृत्य हो जाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/015_020.mp3"},
  {id: "BG_16.1", label: "BG 16.1", ref: "16.1", chapter: 16, verse: 1, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अभयं सत्त्वसंशुद्धिः ज्ञानयोगव्यवस्थितिः", snippet: "The Blessed Lord said: Fearlessness, purity of heart, steadfastness in knowledge and yoga, almsgiving, control of the senses, sacrifice, study of scriptures, austerity, and…", sanskrit: "अभयं सत्त्वसंशुद्धिः ज्ञानयोगव्यवस्थितिः ।\nदानं दमश्च यज्ञश्च स्वाध्यायस्तप आर्जवम् ॥", iast: "abhayaṃ sattvasaṃśuddhiḥ jñānayogavyavasthitiḥ |\ndānaṃ damaśca yajñaśca svādhyāyastapa ārjavam ||", transliteration: "abhayaṁ sattva-sanśhuddhir jñāna-yoga-vyavasthitiḥ\ndānaṁ damaśh cha yajñaśh cha svādhyāyas tapa ārjavam", translation_en: "The Blessed Lord said: Fearlessness, purity of heart, steadfastness in knowledge and yoga, almsgiving, control of the senses, sacrifice, study of scriptures, austerity, and straightforwardness.", translation_hi: "श्री भगवान् ने कहा -- अभय, अन्त:करण की शुद्धि, ज्ञानयोग में दृढ़ स्थिति, दान, दम, यज्ञ, स्वाध्याय, तप और आर्जव।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/016_001.mp3"},
  {id: "BG_16.2", label: "BG 16.2", ref: "16.2", chapter: 16, verse: 2, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अहिंसा सत्यमक्रोधस्त्यागः शान्तिरपैशुनम्", snippet: "Harmlessness, truth, absence of anger, renunciation, peacefulness, absence of crookedness, compassion for beings, non-covetousness, gentleness, modesty, and absence of fickleness.", sanskrit: "अहिंसा सत्यमक्रोधस्त्यागः शान्तिरपैशुनम् ।\nदया भूतेष्वलोलुप्त्वं मार्दवं ह्रीरचापलम् ॥", iast: "ahiṃsā satyamakrodhastyāgaḥ śāntirapaiśunam |\ndayā bhūteṣvaloluptvaṃ mārdavaṃ hrīracāpalam ||", transliteration: "ahinsā satyam akrodhas tyāgaḥ śhāntir apaiśhunam\ndayā bhūteṣhv aloluptvaṁ mārdavaṁ hrīr achāpalam", translation_en: "Harmlessness, truth, absence of anger, renunciation, peacefulness, absence of crookedness, compassion for beings, non-covetousness, gentleness, modesty, and absence of fickleness.", translation_hi: "अहिंसा, सत्य, क्रोध का अभाव, त्याग, शान्ति, अपैशुनम् (किसी की निन्दा न करना), भूतमात्र के प्रति दया, अलोलुपता , मार्दव (कोमलता), लज्जा, अचंचलता।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/016_002.mp3"},
  {id: "BG_16.3", label: "BG 16.3", ref: "16.3", chapter: 16, verse: 3, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तेजः क्षमा धृतिः शौचमद्रोहो नातिमानिता", snippet: "Vigor, forgiveness, fortitude, purity, absence of hatred, absence of pride—these belong to one born for a divine state, O Arjuna.", sanskrit: "तेजः क्षमा धृतिः शौचमद्रोहो नातिमानिता ।\nभवन्ति सम्पदं दैवीमभिजातस्य भारत ॥", iast: "tejaḥ kṣamā dhṛtiḥ śaucamadroho nātimānitā |\nbhavanti sampadaṃ daivīmabhijātasya bhārata ||", transliteration: "tejaḥ kṣhamā dhṛitiḥ śhaucham adroho nāti-mānitā\nbhavanti sampadaṁ daivīm abhijātasya bhārata", translation_en: "Vigor, forgiveness, fortitude, purity, absence of hatred, absence of pride—these belong to one born for a divine state, O Arjuna.", translation_hi: "हे भारत ! तेज, क्षमा, धैर्य, शौच (शुद्धि), अद्रोह और अतिमान (गर्व) का अभाव ये सब दैवी संपदा को प्राप्त पुरुष के लक्षण हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/016_003.mp3"},
  {id: "BG_16.4", label: "BG 16.4", ref: "16.4", chapter: 16, verse: 4, speaker: "krishna", canonical: true, meter: "anustubh", sa: "दम्भो दर्पोऽभिमानश्च क्रोधः पारुष्यमेव च", snippet: "Hypocrisy, arrogance, and self-conceit, anger, harshness, and ignorance—these belong to one who is born for a demoniacal state, O Partha.", sanskrit: "दम्भो दर्पोऽभिमानश्च क्रोधः पारुष्यमेव च ।\nअज्ञानं चाभिजातस्य पार्थ सम्पदमासुरीम् ॥", iast: "dambho darpo’bhimānaśca krodhaḥ pāruṣyameva ca |\najñānaṃ cābhijātasya pārtha sampadamāsurīm ||", transliteration: "dambho darpo ’bhimānaśh cha krodhaḥ pāruṣhyam eva cha\najñānaṁ chābhijātasya pārtha sampadam āsurīm", translation_en: "Hypocrisy, arrogance, and self-conceit, anger, harshness, and ignorance—these belong to one who is born for a demoniacal state, O Partha.", translation_hi: "हे पार्थ ! दम्भ, दर्प, अभिमान, क्रोध, कठोर वाणी (पारुष्य) और अज्ञान यह सब आसुरी सम्पदा है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/016_004.mp3"},
  {id: "BG_16.5", label: "BG 16.5", ref: "16.5", chapter: 16, verse: 5, speaker: "krishna", canonical: true, meter: "anustubh", sa: "दैवी सम्पद्विमोक्षाय निबन्धायासुरी मता", snippet: "The divine nature is deemed conducive to liberation, and the demonic to bondage. Grieve not, O Arjuna, for you are born with divine endowments.", sanskrit: "दैवी सम्पद्विमोक्षाय निबन्धायासुरी मता ।\nमा शुचः सम्पदं दैवीमभिजातोऽसि पाण्डव ॥", iast: "daivī sampadvimokṣāya nibandhāyāsurī matā |\nmā śucaḥ sampadaṃ daivīmabhijāto’si pāṇḍava ||", transliteration: "daivī sampad vimokṣhāya nibandhāyāsurī matā\nmā śhuchaḥ sampadaṁ daivīm abhijāto ’si pāṇḍava", translation_en: "The divine nature is deemed conducive to liberation, and the demonic to bondage. Grieve not, O Arjuna, for you are born with divine endowments.", translation_hi: "हे पाण्डव ! दैवी सम्पदा मोक्ष के लिए और आसुरी सम्पदा बन्धन के लिए मानी गयी है, तुम शोक मत करो, क्योंकि तुम दैवी सम्पदा को प्राप्त हुए हो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/016_005.mp3"},
  {id: "BG_16.6", label: "BG 16.6", ref: "16.6", chapter: 16, verse: 6, speaker: "krishna", canonical: true, meter: "anustubh", sa: "द्वौ भूतसर्गौ लोकेऽस्मिन् दैव आसुर एव च", snippet: "There are two types of beings in this world: the divine and the demoniacal. The divine has been described at length; hear from Me, O Arjuna, about the demoniacal.", sanskrit: "द्वौ भूतसर्गौ लोकेऽस्मिन् दैव आसुर एव च ।\nदैवो विस्तरशः प्रोक्त आसुरं पार्थ मे श्रृणु ॥", iast: "dvau bhūtasargau loke’smin daiva āsura eva ca |\ndaivo vistaraśaḥ prokta āsuraṃ pārtha me śrṛṇu ||", transliteration: "dvau bhūta-sargau loke ’smin daiva āsura eva cha\ndaivo vistaraśhaḥ prokta āsuraṁ pārtha me śhṛiṇu", translation_en: "There are two types of beings in this world: the divine and the demoniacal. The divine has been described at length; hear from Me, O Arjuna, about the demoniacal.", translation_hi: "हे पार्थ ! इस लोक में दो प्रकार की भूतिसृष्टि है, दैवी और आसुरी। उनमें देवों का स्वभाव (दैवी सम्पदा) विस्तारपूर्वक कहा गया है; अब असुरों के स्वभाव को विस्तरश: मुझसे सुनो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/016_006.mp3"},
  {id: "BG_16.7", label: "BG 16.7", ref: "16.7", chapter: 16, verse: 7, speaker: "krishna", canonical: true, meter: "anustubh", sa: "प्रवृत्तिं च निवृत्तिं च जना न विदुरासुराः", snippet: "The demoniacal do not know what to do and what to refrain from; they have neither purity, nor right conduct, nor truth.", sanskrit: "प्रवृत्तिं च निवृत्तिं च जना न विदुरासुराः ।\nन शौचं नापि चाचारो न सत्यं तेषु विद्यते ॥", iast: "pravṛttiṃ ca nivṛttiṃ ca janā na vidurāsurāḥ |\nna śaucaṃ nāpi cācāro na satyaṃ teṣu vidyate ||", transliteration: "pravṛittiṁ cha nivṛittiṁ cha janā na vidur āsurāḥ\nna śhauchaṁ nāpi chāchāro na satyaṁ teṣhu vidyate", translation_en: "The demoniacal do not know what to do and what to refrain from; they have neither purity, nor right conduct, nor truth.", translation_hi: "आसुरी स्वभाव के लोग न प्रवृत्ति को; जानते हैं और न निवृत्ति को उनमें न शुद्धि होती है, न सदाचार और न सत्य ही होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/016_007.mp3"},
  {id: "BG_16.8", label: "BG 16.8", ref: "16.8", chapter: 16, verse: 8, speaker: "krishna", canonical: true, meter: "anustubh", sa: "असत्यमप्रतिष्ठं ते जगदाहुरनीश्वरम्", snippet: "They say, \"This universe is without truth, without a moral basis, without a God, brought about by mutual union, with lust as its cause; what else?\"", sanskrit: "असत्यमप्रतिष्ठं ते जगदाहुरनीश्वरम् ।\nअपरस्परसम्भूतं किमन्यत्कामहैतुकम् ॥", iast: "asatyamapratiṣṭhaṃ te jagadāhuranīśvaram |\naparasparasambhūtaṃ kimanyatkāmahaitukam ||", transliteration: "asatyam apratiṣhṭhaṁ te jagad āhur anīśhvaram\naparaspara-sambhūtaṁ kim anyat kāma-haitukam", translation_en: "They say, \"This universe is without truth, without a moral basis, without a God, brought about by mutual union, with lust as its cause; what else?\"", translation_hi: "वे कहते हैं कि यह जगत् आश्रयरहित, असत्य और ईश्वर रहित है, यह (स्त्रीपुरुष के) परस्पर कामुक संबंध से ही उत्पन्न हुआ है, और (इसका कारण) क्या हो सकता है?", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/016_008.mp3"},
  {id: "BG_16.9", label: "BG 16.9", ref: "16.9", chapter: 16, verse: 9, speaker: "krishna", canonical: true, meter: "anustubh", sa: "एतां दृष्टिमवष्टभ्य नष्टात्मानोऽल्पबुद्धयः", snippet: "Holding this view, these ruined souls of small intellect and fierce deeds come forth as enemies of the world, intent on its destruction.", sanskrit: "एतां दृष्टिमवष्टभ्य नष्टात्मानोऽल्पबुद्धयः ।\nप्रभवन्त्युग्रकर्माणः क्षयाय जगतोऽहिताः ॥", iast: "etāṃ dṛṣṭimavaṣṭabhya naṣṭātmāno’lpabuddhayaḥ |\nprabhavantyugrakarmāṇaḥ kṣayāya jagato’hitāḥ ||", transliteration: "etāṁ dṛiṣhṭim avaṣhṭabhya naṣhṭātmāno ’lpa-buddhayaḥ\nprabhavanty ugra-karmāṇaḥ kṣhayāya jagato ’hitāḥ", translation_en: "Holding this view, these ruined souls of small intellect and fierce deeds come forth as enemies of the world, intent on its destruction.", translation_hi: "इस दृष्टि का अवलम्बन करके नष्टस्वभाव के अल्प बुद्धि वाले, घोर कर्म करने वाले लोग जगत् के शत्रु (अहित चाहने वाले) के रूप में उसका नाश करने के लिए उत्पन्न होते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/016_009.mp3"},
  {id: "BG_16.10", label: "BG 16.10", ref: "16.10", chapter: 16, verse: 10, speaker: "krishna", canonical: true, meter: "anustubh", sa: "काममाश्रित्य दुष्पूरं दम्भमानमदान्विताः", snippet: "Filled with insatiable desires, full of hypocrisy, pride, and arrogance, holding evil ideas due to delusion, they work with impure intentions.", sanskrit: "काममाश्रित्य दुष्पूरं दम्भमानमदान्विताः ।\nमोहाद्गृहीत्वासद्ग्राहान्प्रवर्तन्तेऽशुचिव्रताः ॥", iast: "kāmamāśritya duṣpūraṃ dambhamānamadānvitāḥ |\nmohādgṛhītvāsadgrāhānpravartante’śucivratāḥ ||", transliteration: "kāmam āśhritya duṣhpūraṁ dambha-māna-madānvitāḥ\nmohād gṛihītvāsad-grāhān pravartante ’śhuchi-vratāḥ", translation_en: "Filled with insatiable desires, full of hypocrisy, pride, and arrogance, holding evil ideas due to delusion, they work with impure intentions.", translation_hi: "दम्भ, मान और मद से युक्त कभी न पूर्ण होने वाली कामनाओं का आश्रय लिये, मोहवश मिथ्या धारणाओं को ग्रहण करके ये अशुद्ध संकल्पों के लोग जगत् में कार्य करते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/016_010.mp3"},
  {id: "BG_16.11", label: "BG 16.11", ref: "16.11", chapter: 16, verse: 11, speaker: "krishna", canonical: true, meter: "anustubh", sa: "चिन्तामपरिमेयां च प्रलयान्तामुपाश्रिताः", snippet: "Giving themselves over to immeasurable cares that end only with death, regarding the gratification of lust as their highest aim, and feeling sure that that is all.", sanskrit: "चिन्तामपरिमेयां च प्रलयान्तामुपाश्रिताः ।\nकामोपभोगपरमा एतावदिति निश्चिताः ॥", iast: "cintāmaparimeyāṃ ca pralayāntāmupāśritāḥ |\nkāmopabhogaparamā etāvaditi niścitāḥ ||", transliteration: "chintām aparimeyāṁ cha pralayāntām upāśhritāḥ\nkāmopabhoga-paramā etāvad iti niśhchitāḥ", translation_en: "Giving themselves over to immeasurable cares that end only with death, regarding the gratification of lust as their highest aim, and feeling sure that that is all.", translation_hi: "मरणपर्यन्त रहने वाली अपरिमित चिन्ताओं से ग्रस्त और विषयोपभोग को ही परम लक्ष्य मानने वाले ये आसुरी लोग इस निश्चित मत के होते हैं कि \"इतना ही (सत्य, आनन्द) है\"।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/016_011.mp3"},
  {id: "BG_16.12", label: "BG 16.12", ref: "16.12", chapter: 16, verse: 12, speaker: "krishna", canonical: true, meter: "anustubh", sa: "आशापाशशतैर्बद्धाः कामक्रोधपरायणाः", snippet: "Bound by a hundred ties of hope, given over to lust and anger, they strive to obtain hoards of wealth by unlawful means for sensual enjoyment.", sanskrit: "आशापाशशतैर्बद्धाः कामक्रोधपरायणाः ।\nईहन्ते कामभोगार्थमन्यायेनार्थसञ्चयान् ॥", iast: "āśāpāśaśatairbaddhāḥ kāmakrodhaparāyaṇāḥ |\nīhante kāmabhogārthamanyāyenārthasañcayān ||", transliteration: "āśhā-pāśha-śhatair baddhāḥ kāma-krodha-parāyaṇāḥ\nīhante kāma-bhogārtham anyāyenārtha-sañchayān", translation_en: "Bound by a hundred ties of hope, given over to lust and anger, they strive to obtain hoards of wealth by unlawful means for sensual enjoyment.", translation_hi: "सैकड़ों आशापाशों से बन्धे हुये, काम और क्रोध के वश में ये लोग विषयभोगों की पूर्ति के लिये अन्यायपूर्वक धन का संग्रह करने के लिये चेष्टा करते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/016_012.mp3"},
  {id: "BG_16.13", label: "BG 16.13", ref: "16.13", chapter: 16, verse: 13, speaker: "krishna", canonical: true, meter: "anustubh", sa: "इदमद्य मया लब्धमिमं प्राप्स्ये मनोरथम्", snippet: "\"I have gained this today; I will fulfill this desire of mine; this is mine, and this wealth will be mine in the future.\"", sanskrit: "इदमद्य मया लब्धमिमं प्राप्स्ये मनोरथम् ।\nइदमस्तीदमपि मे भविष्यति पुनर्धनम् ॥", iast: "idamadya mayā labdhamimaṃ prāpsye manoratham |\nidamastīdamapi me bhaviṣyati punardhanam ||", transliteration: "idam adya mayā labdham imaṁ prāpsye manoratham\nidam astīdam api me bhaviṣhyati punar dhanam", translation_en: "\"I have gained this today; I will fulfill this desire of mine; this is mine, and this wealth will be mine in the future.\"", translation_hi: "मैंने आज यह पाया है और इस मनोरथ को भी प्राप्त करूंगा, मेरे पास यह इतना धन है और इससे भी अधिक धन भविष्य में होगा।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/016_013.mp3"},
  {id: "BG_16.14", label: "BG 16.14", ref: "16.14", chapter: 16, verse: 14, speaker: "krishna", canonical: true, meter: "anustubh", sa: "असौ मया हतः शत्रुर्हनिष्ये चापरानपि", snippet: "\"I have slain that enemy, and I shall slay others too. I am the Lord; I enjoy, I am perfect, powerful, and happy.\"", sanskrit: "असौ मया हतः शत्रुर्हनिष्ये चापरानपि ।\nईश्वरोऽहमहं भोगी सिद्धोऽहं बलवान्सुखी ॥", iast: "asau mayā hataḥ śatrurhaniṣye cāparānapi |\nīśvaro’hamahaṃ bhogī siddho’haṃ balavānsukhī ||", transliteration: "asau mayā hataḥ śhatrur haniṣhye chāparān api\nīśhvaro ’ham ahaṁ bhogī siddho ’haṁ balavān sukhī", translation_en: "\"I have slain that enemy, and I shall slay others too. I am the Lord; I enjoy, I am perfect, powerful, and happy.\"", translation_hi: "\"यह शत्रु मेरे द्वारा मारा गया है और दूसरे शत्रुओं को भी मैं मारूंगा\", \"मैं ईश्वर हूँ और भोगी हूँ\", \"मैं सिद्ध पुरुष हूँ\", \"मैं बलवान और सुखी हूँ\",।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/016_014.mp3"},
  {id: "BG_16.15", label: "BG 16.15", ref: "16.15", chapter: 16, verse: 15, speaker: "krishna", canonical: true, meter: "anustubh", sa: "आढ्योऽभिजनवानस्मि कोऽन्योऽस्ति सदृशो मया", snippet: "\"I am wealthy and born into a noble family. Who is my equal? I shall perform sacrifices, give charity, and rejoice,\" thus deluded by ignorance.", sanskrit: "आढ्योऽभिजनवानस्मि कोऽन्योऽस्ति सदृशो मया ।\nयक्ष्ये दास्यामि मोदिष्य इत्यज्ञानविमोहिताः ॥", iast: "āḍhyo’bhijanavānasmi ko’nyo’sti sadṛśo mayā |\nyakṣye dāsyāmi modiṣya ityajñānavimohitāḥ ||", transliteration: "āḍhyo ’bhijanavān asmi ko ’nyo ’sti sadṛiśho mayā\nyakṣhye dāsyāmi modiṣhya ity ajñāna-vimohitāḥ\naneka-chitta-vibhrāntā moha-jāla-samāvṛitāḥ\nprasaktāḥ kāma-bhogeṣhu patanti narake ’śhuchau", translation_en: "\"I am wealthy and born into a noble family. Who is my equal? I shall perform sacrifices, give charity, and rejoice,\" thus deluded by ignorance.", translation_hi: "\"मैं धनवान् और श्रेष्ठकुल में जन्मा हूँ। मेरे समान दूसरा कौन है?\",'मैं यज्ञ करूंगा', 'मैं दान दूँगा', 'मैं मौज करूँगा' - इस प्रकार के अज्ञान से वे मोहित होते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/016_015.mp3"},
  {id: "BG_16.16", label: "BG 16.16", ref: "16.16", chapter: 16, verse: 16, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अनेकचित्तविभ्रान्ता मोहजालसमावृताः", snippet: "Bewildered by many fancies, entangled in the snare of delusion, addicted to the gratification of lust, they fall into a foul hell.", sanskrit: "अनेकचित्तविभ्रान्ता मोहजालसमावृताः ।\nप्रसक्ताः कामभोगेषु पतन्ति नरकेऽशुचौ ॥", iast: "anekacittavibhrāntā mohajālasamāvṛtāḥ |\nprasaktāḥ kāmabhogeṣu patanti narake’śucau ||", transliteration: "aneka-citta-vibhrāntā    moha-jāla-samāvṛtāḥ prasaktāḥ   kāma-bhogeṣu    patanti narake  'śucau", translation_en: "Bewildered by many fancies, entangled in the snare of delusion, addicted to the gratification of lust, they fall into a foul hell.", translation_hi: "अनेक प्रकार से भ्रमित चित्त वाले, मोह जाल में फँसे तथा विषयभोगों में आसक्त ये लोग घोर, अपवित्र नरक में गिरते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/016_016.mp3"},
  {id: "BG_16.17", label: "BG 16.17", ref: "16.17", chapter: 16, verse: 17, speaker: "krishna", canonical: true, meter: "anustubh", sa: "आत्मसम्भाविताः स्तब्धा धनमानमदान्विताः", snippet: "Self-conceited, stubborn, filled with pride and intoxication of wealth, they perform sacrifices in name only for ostentation, contrary to scriptural ordinances.", sanskrit: "आत्मसम्भाविताः स्तब्धा धनमानमदान्विताः ।\nयजन्ते नामयज्ञैस्ते दम्भेनाविधिपूर्वकम् ॥", iast: "ātmasambhāvitāḥ stabdhā dhanamānamadānvitāḥ |\nyajante nāmayajñaiste dambhenāvidhipūrvakam ||", transliteration: "ātma-sambhāvitāḥ stabdhā dhana-māna-madānvitāḥ\nyajante nāma-yajñais te dambhenāvidhi-pūrvakam", translation_en: "Self-conceited, stubborn, filled with pride and intoxication of wealth, they perform sacrifices in name only for ostentation, contrary to scriptural ordinances.", translation_hi: "अपने आप को ही श्रेष्ठ मानने वाले, स्तब्ध (गर्वयुक्त), धन और मान के मद से युक्त लोग शास्त्रविधि से रहित केवल नाममात्र के यज्ञों द्वारा दम्भपूर्वक यजन करते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/016_017.mp3"},
  {id: "BG_16.18", label: "BG 16.18", ref: "16.18", chapter: 16, verse: 18, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अहङ्कारं बलं दर्पं कामं क्रोधं च संश्रिताः", snippet: "Given over to egoism, power, haughtiness, lust, and anger, these malicious people hate Me in their own bodies and in the bodies of others.", sanskrit: "अहङ्कारं बलं दर्पं कामं क्रोधं च संश्रिताः ।\nमामात्मपरदेहेषु प्रद्विषन्तोऽभ्यसूयकाः ॥", iast: "ahaṅkāraṃ balaṃ darpaṃ kāmaṃ krodhaṃ ca saṃśritāḥ |\nmāmātmaparadeheṣu pradviṣanto’bhyasūyakāḥ ||", transliteration: "ahankāraṁ balaṁ darpaṁ kāmaṁ krodhaṁ cha sanśhritāḥ\nmām ātma-para-deheṣhu pradviṣhanto ’bhyasūyakāḥ", translation_en: "Given over to egoism, power, haughtiness, lust, and anger, these malicious people hate Me in their own bodies and in the bodies of others.", translation_hi: "अहंकार, बल, दर्प, काम और क्रोध के वशीभूत हुए परनिन्दा करने वाले ये लोग अपने और दूसरों के शरीर में स्थित मुझ (परमात्मा) से द्वेष करने वाले होते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/016_018.mp3"},
  {id: "BG_16.19", label: "BG 16.19", ref: "16.19", chapter: 16, verse: 19, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तानहं द्विषतः क्रूरान्संसारेषु नराधमान्", snippet: "Those cruel haters, the worst among men in the world, I hurl those evil-doers into the wombs of demons only.", sanskrit: "तानहं द्विषतः क्रूरान्संसारेषु नराधमान् ।\nक्षिपाम्यजस्रमशुभानासुरीष्वेव योनिषु ॥", iast: "tānahaṃ dviṣataḥ krūrānsaṃsāreṣu narādhamān |\nkṣipāmyajasramaśubhānāsurīṣveva yoniṣu ||", transliteration: "tān ahaṁ dviṣhataḥ krūrān sansāreṣhu narādhamān\nkṣhipāmy ajasram aśhubhān āsurīṣhv eva yoniṣhu", translation_en: "Those cruel haters, the worst among men in the world, I hurl those evil-doers into the wombs of demons only.", translation_hi: "ऐसे उन द्वेष करने वाले,  क्रूरकर्मी और नराधमों को मैं संसार में बारम्बार (अजस्रम्) आसुरी योनियों में ही गिराता हूँ अर्थात् उत्पन्न करता हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/016_019.mp3"},
  {id: "BG_16.20", label: "BG 16.20", ref: "16.20", chapter: 16, verse: 20, speaker: "krishna", canonical: true, meter: "anustubh", sa: "असुरीं योनिमापन्ना मूढा जन्मनि जन्मनि", snippet: "Entering into demoniacal wombs and deluded, birth after birth, they do not attain Me, thus falling, O Arjuna, into a condition still lower than that.", sanskrit: "असुरीं योनिमापन्ना मूढा जन्मनि जन्मनि ।\nमामप्राप्यैव कौन्तेय ततो यान्त्यधमां गतिम् ॥", iast: "asurīṃ yonimāpannā mūḍhā janmani janmani |\nmāmaprāpyaiva kaunteya tato yāntyadhamāṃ gatim ||", transliteration: "āsurīṁ yonim āpannā mūḍhā janmani janmani\nmām aprāpyaiva kaunteya tato yānty adhamāṁ gatim", translation_en: "Entering into demoniacal wombs and deluded, birth after birth, they do not attain Me, thus falling, O Arjuna, into a condition still lower than that.", translation_hi: "हे कौन्तेय ! वे मूढ़ पुरुष जन्मजन्मान्तर में आसुरी योनि को प्राप्त होते हैं और ( इस प्रकार) मुझे प्राप्त न होकर अधम गति को प्राप्त होते है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/016_020.mp3"},
  {id: "BG_16.21", label: "BG 16.21", ref: "16.21", chapter: 16, verse: 21, speaker: "krishna", canonical: true, meter: "anustubh", sa: "त्रिविधं नरकस्येदं द्वारं नाशनमात्मनः", snippet: "There are three gates to this hell, destructive of the self: lust, anger, and greed; therefore, one should abandon these three.", sanskrit: "त्रिविधं नरकस्येदं द्वारं नाशनमात्मनः ।\nकामः क्रोधस्तथा लोभस्तस्मादेतत्त्रयं त्यजेत् ॥", iast: "trividhaṃ narakasyedaṃ dvāraṃ nāśanamātmanaḥ |\nkāmaḥ krodhastathā lobhastasmādetattrayaṃ tyajet ||", transliteration: "tri-vidhaṁ narakasyedaṁ dvāraṁ nāśhanam ātmanaḥ\nkāmaḥ krodhas tathā lobhas tasmād etat trayaṁ tyajet", translation_en: "There are three gates to this hell, destructive of the self: lust, anger, and greed; therefore, one should abandon these three.", translation_hi: "काम, क्रोध और लोभ ये आत्मनाश के त्रिविध द्वार हैं, इसलिए इन तीनों को त्याग देना चाहिए।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/016_021.mp3"},
  {id: "BG_16.22", label: "BG 16.22", ref: "16.22", chapter: 16, verse: 22, speaker: "krishna", canonical: true, meter: "anustubh", sa: "एतैर्विमुक्तः कौन्तेय तमोद्वारैस्त्रिभिर्नरः", snippet: "A person who is liberated from these three gates of darkness, O Arjuna, practices what is beneficial for them and thus goes to the Supreme Goal.", sanskrit: "एतैर्विमुक्तः कौन्तेय तमोद्वारैस्त्रिभिर्नरः ।\nआचरत्यात्मनः श्रेयस्ततो याति परां गतिम् ॥", iast: "etairvimuktaḥ kaunteya tamodvāraistribhirnaraḥ |\nācaratyātmanaḥ śreyastato yāti parāṃ gatim ||", transliteration: "etair vimuktaḥ kaunteya tamo-dvārais tribhir naraḥ\nācharaty ātmanaḥ śhreyas tato yāti parāṁ gatim", translation_en: "A person who is liberated from these three gates of darkness, O Arjuna, practices what is beneficial for them and thus goes to the Supreme Goal.", translation_hi: "हे कौन्तेय ! नरक के इन तीनों द्वारों से विमुक्त पुरुष अपने कल्याण के साधन का आचरण करता है और इस प्रकार परा गति को प्राप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/016_022.mp3"},
  {id: "BG_16.23", label: "BG 16.23", ref: "16.23", chapter: 16, verse: 23, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यः शास्त्रविधिमुत्सृज्य वर्तते कामकारतः", snippet: "He who, having cast aside the ordinances of the scriptures, acts under the impulse of desire, does not attain perfection, nor happiness, nor the Supreme Goal.", sanskrit: "यः शास्त्रविधिमुत्सृज्य वर्तते कामकारतः ।\nन स सिद्धिमवाप्नोति न सुखं न परां गतिम् ॥", iast: "yaḥ śāstravidhimutsṛjya vartate kāmakārataḥ |\nna sa siddhimavāpnoti na sukhaṃ na parāṃ gatim ||", transliteration: "yaḥ śhāstra-vidhim utsṛijya vartate kāma-kārataḥ\nna sa siddhim avāpnoti na sukhaṁ na parāṁ gatim", translation_en: "He who, having cast aside the ordinances of the scriptures, acts under the impulse of desire, does not attain perfection, nor happiness, nor the Supreme Goal.", translation_hi: "जो पुरुष शास्त्रविधि को त्यागकर अपनी कामना से प्रेरित होकर ही कार्य करता है, वह न पूर्णत्व की सिद्धि प्राप्त करता है, न सुख और न परा गति।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/016_023.mp3"},
  {id: "BG_16.24", label: "BG 16.24", ref: "16.24", chapter: 16, verse: 24, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तस्माच्छास्त्रं प्रमाणं ते कार्याकार्यव्यवस्थितौ", snippet: "Therefore, let the scripture be thy authority in determining what ought to be done and what ought not to be done. Having known what is said in the ordinance of the scriptures,…", sanskrit: "तस्माच्छास्त्रं प्रमाणं ते कार्याकार्यव्यवस्थितौ ।\nज्ञात्वा शास्त्रविधानोक्तं कर्म कर्तुमिहार्हसि ॥", iast: "tasmācchāstraṃ pramāṇaṃ te kāryākāryavyavasthitau |\njñātvā śāstravidhānoktaṃ karma kartumihārhasi ||", transliteration: "tasmāch chhāstraṁ pramāṇaṁ te kāryākārya-vyavasthitau\njñātvā śhāstra-vidhānoktaṁ karma kartum ihārhasi", translation_en: "Therefore, let the scripture be thy authority in determining what ought to be done and what ought not to be done. Having known what is said in the ordinance of the scriptures, thou shouldst act in this world.", translation_hi: "इसलिए तुम्हारे लिए कर्तव्य और अकर्तव्य की व्यवस्था (निर्णय) में शास्त्र ही प्रमाण है शास्त्रोक्त विधान को जानकर तुम्हें अपने कर्म करने चाहिए।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/016_024.mp3"},
  {id: "BG_17.1", label: "BG 17.1", ref: "17.1", chapter: 17, verse: 1, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "ये शास्त्रविधिमुत्सृज्य यजन्ते श्रद्धयाऽन्विताः", snippet: "Arjuna said, \"What is the condition of those who, disregarding the injunctions of the scriptures, perform sacrifice with faith—is it Sattva, Rajas, or Tamas, O Krishna?\"", sanskrit: "ये शास्त्रविधिमुत्सृज्य यजन्ते श्रद्धयाऽन्विताः ।\nतेषां निष्ठा तु का कृष्ण सत्त्वमाहो रजस्तमः ॥", iast: "ye śāstravidhimutsṛjya yajante śraddhayā’nvitāḥ |\nteṣāṃ niṣṭhā tu kā kṛṣṇa sattvamāho rajastamaḥ ||", transliteration: "ye śhāstra-vidhim utsṛijya yajante śhraddhayānvitāḥ\nteṣhāṁ niṣhṭhā tu kā kṛiṣhṇa sattvam āho rajas tamaḥ", translation_en: "Arjuna said, \"What is the condition of those who, disregarding the injunctions of the scriptures, perform sacrifice with faith—is it Sattva, Rajas, or Tamas, O Krishna?\"", translation_hi: "अर्जुन ने कहा -- हे कृष्ण ! जो लोग शास्त्रविधि को त्यागकर (केवल) श्रद्धा युक्त यज्ञ (पूजा) करते हैं, उनकी स्थिति (निष्ठा) कौन सी है ?क्या वह सात्त्विक है अथवा राजसिक या तामसिक ?", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_001.mp3"},
  {id: "BG_17.2", label: "BG 17.2", ref: "17.2", chapter: 17, verse: 2, speaker: "krishna", canonical: true, meter: "anustubh", sa: "त्रिविधा भवति श्रद्धा देहिनां सा स्वभावजा", snippet: "The Blessed Lord said, \"There are threefold faiths inherent in the nature of the embodied: the sattvic (pure), the rajasic (passionate), and the tamasic (dark). Hear of them.\"", sanskrit: "त्रिविधा भवति श्रद्धा देहिनां सा स्वभावजा ।\nसात्त्विकी राजसी चैव तामसी चेति तां श्रृणु ॥", iast: "trividhā bhavati śraddhā dehināṃ sā svabhāvajā |\nsāttvikī rājasī caiva tāmasī ceti tāṃ śrṛṇu ||", transliteration: "tri-vidhā bhavati śhraddhā dehināṁ sā svabhāva-jā\nsāttvikī rājasī chaiva tāmasī cheti tāṁ śhṛiṇu", translation_en: "The Blessed Lord said, \"There are threefold faiths inherent in the nature of the embodied: the sattvic (pure), the rajasic (passionate), and the tamasic (dark). Hear of them.\"", translation_hi: "श्री भगवान् ने कहा -- देहधारियों (मनुष्यों) की वह स्वाभाविक (ज्ञानरहित) श्रद्धा तीन प्रकार की - सात्त्विक, राजसिक और तामसिक - होती हैं, उसे तुम मुझसे सुनो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_002.mp3"},
  {id: "BG_17.3", label: "BG 17.3", ref: "17.3", chapter: 17, verse: 3, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सत्त्वानुरूपा सर्वस्य श्रद्धा भवति भारत", snippet: "The faith of each is in accordance with their nature, O Arjuna. People consist of their faith; as a person's faith is, so are they.", sanskrit: "सत्त्वानुरूपा सर्वस्य श्रद्धा भवति भारत ।\nश्रद्धामयोऽयं पुरुषो यो यच्छ्रद्धः स एव सः ॥", iast: "sattvānurūpā sarvasya śraddhā bhavati bhārata |\nśraddhāmayo’yaṃ puruṣo yo yacchraddhaḥ sa eva saḥ ||", transliteration: "sattvānurūpā sarvasya śhraddhā bhavati bhārata\nśhraddhā-mayo ‘yaṁ puruṣho yo yach-chhraddhaḥ sa eva saḥ", translation_en: "The faith of each is in accordance with their nature, O Arjuna. People consist of their faith; as a person's faith is, so are they.", translation_hi: "हे भारत सभी मनुष्यों की श्रद्धा उनके सत्त्व (स्वभाव, संस्कार) के अनुरूप होती है। यह पुरुष श्रद्धामय है, इसलिए जो पुरुष जिस श्रद्धा वाला है वह स्वयं भी वही है अर्थात् जैसी जिसकी श्रद्धा वैसा ही उसका स्वरूप होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_003.mp3"},
  {id: "BG_17.4", label: "BG 17.4", ref: "17.4", chapter: 17, verse: 4, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यजन्ते सात्त्विका देवान्यक्षरक्षांसि राजसाः", snippet: "The sattvic, or pure, men worship the gods; the rajasic, or passionate, worship the yakshas and rakshasas; the others, the tamasic or deluded people, worship ghosts and hosts…", sanskrit: "यजन्ते सात्त्विका देवान्यक्षरक्षांसि राजसाः ।\nप्रेतान्भूतगणांश्चान्ये यजन्ते तामसा जनाः ॥", iast: "yajante sāttvikā devānyakṣarakṣāṃsi rājasāḥ |\npretānbhūtagaṇāṃścānye yajante tāmasā janāḥ ||", transliteration: "yajante sāttvikā devān yakṣha-rakṣhānsi rājasāḥ\npretān bhūta-gaṇānśh chānye yajante tāmasā janāḥ", translation_en: "The sattvic, or pure, men worship the gods; the rajasic, or passionate, worship the yakshas and rakshasas; the others, the tamasic or deluded people, worship ghosts and hosts of nature-spirits.", translation_hi: "सात्त्विक पुरुष देवताओं को पूजते हैं और राजस लोग यक्ष और राक्षसों को, तथा अन्य तामसी जन प्रेत और भूतगणों को पूजते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_004.mp3"},
  {id: "BG_17.5", label: "BG 17.5", ref: "17.5", chapter: 17, verse: 5, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अशास्त्रविहितं घोरं तप्यन्ते ये तपो जनाः", snippet: "Those men who practice terrific austerities not prescribed by the scriptures, given to hypocrisy and egoism, driven by the force of lust and attachment.", sanskrit: "अशास्त्रविहितं घोरं तप्यन्ते ये तपो जनाः ।\nदम्भाहङ्कारसंयुक्ताः कामरागबलान्विताः ॥", iast: "aśāstravihitaṃ ghoraṃ tapyante ye tapo janāḥ |\ndambhāhaṅkārasaṃyuktāḥ kāmarāgabalānvitāḥ ||", transliteration: "aśhāstra-vihitaṁ ghoraṁ tapyante ye tapo janāḥ\ndambhāhankāra-sanyuktāḥ kāma-rāga-balānvitāḥ", translation_en: "Those men who practice terrific austerities not prescribed by the scriptures, given to hypocrisy and egoism, driven by the force of lust and attachment.", translation_hi: "जो लोग शास्त्रविधि से रहित घोर तप करते हैं तथा दम्भ, अहंकार, काम और राग से भी युक्त होते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_005.mp3"}
] AS row
MERGE (n:Verse {id: row.id}) SET n += row;

UNWIND [
  {id: "BG_17.6", label: "BG 17.6", ref: "17.6", chapter: 17, verse: 6, speaker: "krishna", canonical: true, meter: "anustubh", sa: "कर्षयन्तः शरीरस्थं भूतग्राममचेतसः", snippet: "Know thou these to be of demonical resolves, senselessly torturing all the elements in the body and Me who dwell in the body.", sanskrit: "कर्षयन्तः शरीरस्थं भूतग्राममचेतसः ।\nमां चैवान्तःशरीरस्थं तान्विद्ध्यासुरनिश्चयान् ॥", iast: "karṣayantaḥ śarīrasthaṃ bhūtagrāmamacetasaḥ |\nmāṃ caivāntaḥśarīrasthaṃ tānviddhyāsuraniścayān ||", transliteration: "karṣhayantaḥ śharīra-sthaṁ bhūta-grāmam achetasaḥ\nmāṁ chaivāntaḥ śharīra-sthaṁ tān viddhy āsura-niśhchayān", translation_en: "Know thou these to be of demonical resolves, senselessly torturing all the elements in the body and Me who dwell in the body.", translation_hi: "और शरीरस्थ भूतसमुदाय को तथा मुझ अन्तर्यामी को भी कृश करने वाले अर्थात् कष्ट पहुँचाने वाले जो अविवेकी लोग हैं, उन्हें तुम आसुरी निश्चय वाले जानो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_006.mp3"},
  {id: "BG_17.7", label: "BG 17.7", ref: "17.7", chapter: 17, verse: 7, speaker: "krishna", canonical: true, meter: "anustubh", sa: "आहारस्त्वपि सर्वस्य त्रिविधो भवति प्रियः", snippet: "The food that is dear to each is threefold, as well as sacrifice, austerity, and almsgiving. Hear the distinction of these.", sanskrit: "आहारस्त्वपि सर्वस्य त्रिविधो भवति प्रियः ।\nयज्ञस्तपस्तथा दानं तेषां भेदमिमं श्रृणु ॥", iast: "āhārastvapi sarvasya trividho bhavati priyaḥ |\nyajñastapastathā dānaṃ teṣāṃ bhedamimaṃ śrṛṇu ||", transliteration: "āhāras tv api sarvasya tri-vidho bhavati priyaḥ\nyajñas tapas tathā dānaṁ teṣhāṁ bhedam imaṁ śhṛiṇu", translation_en: "The food that is dear to each is threefold, as well as sacrifice, austerity, and almsgiving. Hear the distinction of these.", translation_hi: "(अपनीअपनी प्रकृति के अनुसार) सब का प्रिय भोजन भी तीन प्रकार का होता है? उसी प्रकार यज्ञ? तप और दान भी तीन प्रकार के होते हैं? उनके भेद को तुम मुझसे सुनो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_007.mp3"},
  {id: "BG_17.8", label: "BG 17.8", ref: "17.8", chapter: 17, verse: 8, speaker: "krishna", canonical: true, meter: "anustubh", sa: "आयुःसत्त्वबलारोग्यसुखप्रीतिविवर्धनाः", snippet: "The foods that increase life, purity, strength, health, joy, and cheerfulness (good appetite), which are savory, oily, substantial, and agreeable, are dear to the Sattvic…", sanskrit: "आयुःसत्त्वबलारोग्यसुखप्रीतिविवर्धनाः ।\nरस्याः स्निग्धाः स्थिरा हृद्या आहाराः सात्त्विकप्रियाः ॥", iast: "āyuḥsattvabalārogyasukhaprītivivardhanāḥ |\nrasyāḥ snigdhāḥ sthirā hṛdyā āhārāḥ sāttvikapriyāḥ ||", transliteration: "āyuḥ-sattva-balārogya-sukha-prīti-vivardhanāḥ\nrasyāḥ snigdhāḥ sthirā hṛidyā āhārāḥ sāttvika-priyāḥ", translation_en: "The foods that increase life, purity, strength, health, joy, and cheerfulness (good appetite), which are savory, oily, substantial, and agreeable, are dear to the Sattvic (pure) people.", translation_hi: "आयु, सत्त्व (शुद्धि), बल, आरोग्य, सुख और प्रीति को प्रवृद्ध करने वाले एवं रसयुक्त, स्निग्ध ( घी आदि की चिकनाई से युक्त) स्थिर तथा मन को प्रसन्न करने वाले आहार अर्थात् भोज्य पदार्थ सात्त्विक पुरुषों को प्रिय होते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_008.mp3"},
  {id: "BG_17.9", label: "BG 17.9", ref: "17.9", chapter: 17, verse: 9, speaker: "krishna", canonical: true, meter: "anustubh", sa: "कट्वम्ललवणात्युष्णतीक्ष्णरूक्षविदाहिनः", snippet: "The foods that are bitter, sour, salty, overly hot, pungent, dry, and burning are liked by the Rajasic and are productive of pain, grief, and disease.", sanskrit: "कट्वम्ललवणात्युष्णतीक्ष्णरूक्षविदाहिनः ।\nआहारा राजसस्येष्टा दुःखशोकामयप्रदाः ॥", iast: "kaṭvamlalavaṇātyuṣṇatīkṣṇarūkṣavidāhinaḥ |\nāhārā rājasasyeṣṭā duḥkhaśokāmayapradāḥ ||", transliteration: "kaṭv-amla-lavaṇāty-uṣhṇa- tīkṣhṇa-rūkṣha-vidāhinaḥ\nāhārā rājasasyeṣhṭā duḥkha-śhokāmaya-pradāḥ", translation_en: "The foods that are bitter, sour, salty, overly hot, pungent, dry, and burning are liked by the Rajasic and are productive of pain, grief, and disease.", translation_hi: "कड़वे, खट्टे, लवणयुक्त, अति उष्ण, तीक्ष्ण (तीखे, मिर्च युक्त), रूखे. दाहकारक, दु:ख, शोक और रोग उत्पन्न कारक भोज्य पदार्थ राजस पुरुष को प्रिय होते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_009.mp3"},
  {id: "BG_17.10", label: "BG 17.10", ref: "17.10", chapter: 17, verse: 10, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यातयामं गतरसं पूति पर्युषितं च यत्", snippet: "That which is stale, tasteless, putrid, rotten, rejected, and impure is the food liked by the Tamasic.", sanskrit: "यातयामं गतरसं पूति पर्युषितं च यत् ।\nउच्छिष्टमपि चामेध्यं भोजनं तामसप्रियम् ॥", iast: "yātayāmaṃ gatarasaṃ pūti paryuṣitaṃ ca yat |\nucchiṣṭamapi cāmedhyaṃ bhojanaṃ tāmasapriyam ||", transliteration: "yāta-yāmaṁ gata-rasaṁ pūti paryuṣhitaṁ cha yat\nuchchhiṣhṭam api chāmedhyaṁ bhojanaṁ tāmasa-priyam", translation_en: "That which is stale, tasteless, putrid, rotten, rejected, and impure is the food liked by the Tamasic.", translation_hi: "अर्धपक्व, रसरहित, दुर्गन्धयुक्त, बासी, उच्छिष्ट तथा अपवित्र (अमेध्य) अन्न तामस जनों को प्रिय होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_010.mp3"},
  {id: "BG_17.11", label: "BG 17.11", ref: "17.11", chapter: 17, verse: 11, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अफलाकाङ्क्षिभिर्यज्ञो विधिदृष्टो य इज्यते", snippet: "That sacrifice which is offered by men without desire for reward, as enjoined by the ordinance (scripture), with a firm faith that doing so is their duty, is Sattvic or pure.", sanskrit: "अफलाकाङ्क्षिभिर्यज्ञो विधिदृष्टो य इज्यते ।\nयष्टव्यमेवेति मनः समाधाय स सात्त्विकः ॥", iast: "aphalākāṅkṣibhiryajño vidhidṛṣṭo ya ijyate |\nyaṣṭavyameveti manaḥ samādhāya sa sāttvikaḥ ||", transliteration: "aphalākāṅkṣhibhir yajño vidhi-driṣhṭo ya ijyate\nyaṣhṭavyam eveti manaḥ samādhāya sa sāttvikaḥ", translation_en: "That sacrifice which is offered by men without desire for reward, as enjoined by the ordinance (scripture), with a firm faith that doing so is their duty, is Sattvic or pure.", translation_hi: "जो यज्ञ शास्त्रविधि से नियन्त्रित किया हुआ तथा जिसे \"यह मेरा कर्तव्य है\" ऐसा मन का समाधान (निश्चय) कर फल की आकांक्षा नहीं रखने वाले लोगों के द्वारा किया जाता है, वह यज्ञ सात्त्विक है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_011.mp3"},
  {id: "BG_17.12", label: "BG 17.12", ref: "17.12", chapter: 17, verse: 12, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अभिसंधाय तु फलं दम्भार्थमपि चैव यत्", snippet: "The sacrifice that is offered, O Arjuna, seeking a reward and for show, know that to be a Rajasic Yajna.", sanskrit: "अभिसंधाय तु फलं दम्भार्थमपि चैव यत् ।\nइज्यते भरतश्रेष्ठ तं यज्ञं विद्धि राजसम् ॥", iast: "abhisaṃdhāya tu phalaṃ dambhārthamapi caiva yat |\nijyate bharataśreṣṭha taṃ yajñaṃ viddhi rājasam ||", transliteration: "abhisandhāya tu phalaṁ dambhārtham api chaiva yat\nijyate bharata-śhreṣhṭha taṁ yajñaṁ viddhi rājasam", translation_en: "The sacrifice that is offered, O Arjuna, seeking a reward and for show, know that to be a Rajasic Yajna.", translation_hi: "हे भरतश्रेष्ठ अर्जुन ! जो यज्ञ दम्भ के लिए तथा फल की आकांक्षा रख कर किया जाता है, उस यज्ञ को तुम राजस समझो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_012.mp3"},
  {id: "BG_17.13", label: "BG 17.13", ref: "17.13", chapter: 17, verse: 13, speaker: "krishna", canonical: true, meter: "anustubh", sa: "विधिहीनमसृष्टान्नं मन्त्रहीनमदक्षिणम्", snippet: "They declare that sacrifice to be Tamasic which is contrary to the ordinances of the scriptures, in which no food is distributed, and which is devoid of mantras, gifts, and faith.", sanskrit: "विधिहीनमसृष्टान्नं मन्त्रहीनमदक्षिणम् ।\nश्रद्धाविरहितं यज्ञं तामसं परिचक्षते ॥", iast: "vidhihīnamasṛṣṭānnaṃ mantrahīnamadakṣiṇam |\nśraddhāvirahitaṃ yajñaṃ tāmasaṃ paricakṣate ||", transliteration: "vidhi-hīnam asṛiṣhṭānnaṁ mantra-hīnam adakṣhiṇam\nśhraddhā-virahitaṁ yajñaṁ tāmasaṁ parichakṣhate", translation_en: "They declare that sacrifice to be Tamasic which is contrary to the ordinances of the scriptures, in which no food is distributed, and which is devoid of mantras, gifts, and faith.", translation_hi: "शास्त्रविधि से रहित, अन्नदान से रहित, बिना मन्त्रों, बिना दक्षिणा और बिना श्रद्धा के किये हुए यज्ञ को तामस यज्ञ कहते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_013.mp3"},
  {id: "BG_17.14", label: "BG 17.14", ref: "17.14", chapter: 17, verse: 14, speaker: "krishna", canonical: true, meter: "anustubh", sa: "देवद्विजगुरुप्राज्ञपूजनं शौचमार्जवम्", snippet: "Worship of the gods, the twice-born, the teachers, and the wise; purity, straightforwardness, celibacy, and non-injury are all called the austerities of the body.", sanskrit: "देवद्विजगुरुप्राज्ञपूजनं शौचमार्जवम् ।\nब्रह्मचर्यमहिंसा च शारीरं तप उच्यते ॥", iast: "devadvijaguruprājñapūjanaṃ śaucamārjavam |\nbrahmacaryamahiṃsā ca śārīraṃ tapa ucyate ||", transliteration: "deva-dwija-guru-prājña- pūjanaṁ śhaucham ārjavam\nbrahmacharyam ahinsā cha śhārīraṁ tapa uchyate", translation_en: "Worship of the gods, the twice-born, the teachers, and the wise; purity, straightforwardness, celibacy, and non-injury are all called the austerities of the body.", translation_hi: "देव, द्विज (ब्राह्मण), गुरु और ज्ञानी जनों का पूजन, शौच, आर्जव (सरलता), ब्रह्मचर्य और अहिंसा, यह शरीर संबंधी तप कहा जाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_014.mp3"},
  {id: "BG_17.15", label: "BG 17.15", ref: "17.15", chapter: 17, verse: 15, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अनुद्वेगकरं वाक्यं सत्यं प्रियहितं च यत्", snippet: "Speech that causes no excitement, is truthful, pleasant, and beneficial; the practice of studying the Vedas is called austerity of speech.", sanskrit: "अनुद्वेगकरं वाक्यं सत्यं प्रियहितं च यत् ।\nस्वाध्यायाभ्यसनं चैव वाङ्मयं तप उच्यते ॥", iast: "anudvegakaraṃ vākyaṃ satyaṃ priyahitaṃ ca yat |\nsvādhyāyābhyasanaṃ caiva vāṅmayaṃ tapa ucyate ||", transliteration: "anudvega-karaṁ vākyaṁ satyaṁ priya-hitaṁ cha yat\nsvādhyāyābhyasanaṁ chaiva vāṅ-mayaṁ tapa uchyate", translation_en: "Speech that causes no excitement, is truthful, pleasant, and beneficial; the practice of studying the Vedas is called austerity of speech.", translation_hi: "जो वाक्य (भाषण) उद्वेग उत्पन्न करने वाला नहीं है, जो प्रिय, हितकारक और सत्य है तथा वेदों का स्वाध्याय अभ्यास वाङ्मय (वाणी का) तप कहलाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_015.mp3"},
  {id: "BG_17.16", label: "BG 17.16", ref: "17.16", chapter: 17, verse: 16, speaker: "krishna", canonical: true, meter: "anustubh", sa: "मनःप्रसादः सौम्यत्वं मौनमात्मविनिग्रहः", snippet: "Serenity of mind, good-heartedness, self-control, and purity of nature—this is called mental austerity.", sanskrit: "मनःप्रसादः सौम्यत्वं मौनमात्मविनिग्रहः ।\nभावसंशुद्धिरित्येतत्तपो मानसमुच्यते ॥", iast: "manaḥprasādaḥ saumyatvaṃ maunamātmavinigrahaḥ |\nbhāvasaṃśuddhirityetattapo mānasamucyate ||", transliteration: "manaḥ-prasādaḥ saumyatvaṁ maunam ātma-vinigrahaḥ\nbhāva-sanśhuddhir ity etat tapo mānasam uchyate", translation_en: "Serenity of mind, good-heartedness, self-control, and purity of nature—this is called mental austerity.", translation_hi: "मन की प्रसन्नता, सौम्यभाव, मौन आत्मसंयम और अन्त:करण की शुद्धि यह सब मानस तप कहलाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_016.mp3"},
  {id: "BG_17.17", label: "BG 17.17", ref: "17.17", chapter: 17, verse: 17, speaker: "krishna", canonical: true, meter: "anustubh", sa: "श्रद्धया परया तप्तं तपस्तत्ति्रविधं नरैः", snippet: "This threefold austerity, practiced by steadfast men, with the utmost faith, desiring no reward, is called Sattvic.", sanskrit: "श्रद्धया परया तप्तं तपस्तत्ति्रविधं नरैः ।\nअफलाकाङ्क्षिभिर्युक्तैः सात्त्विकं परिचक्षते ॥", iast: "śraddhayā parayā taptaṃ tapastattiravidhaṃ naraiḥ |\naphalākāṅkṣibhiryuktaiḥ sāttvikaṃ paricakṣate ||", transliteration: "śhraddhayā parayā taptaṁ tapas tat tri-vidhaṁ naraiḥ\naphalākāṅkṣhibhir yuktaiḥ sāttvikaṁ parichakṣhate", translation_en: "This threefold austerity, practiced by steadfast men, with the utmost faith, desiring no reward, is called Sattvic.", translation_hi: "फल की आकांक्षा न रखने वाले युक्त पुरुषों के द्वारा परम श्रद्धा से किये गये उस पूर्वोक्त त्रिविध तप को सात्त्विक कहते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_017.mp3"},
  {id: "BG_17.18", label: "BG 17.18", ref: "17.18", chapter: 17, verse: 18, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सत्कारमानपूजार्थं तपो दम्भेन चैव यत्", snippet: "The austerity that is practiced with the aim of gaining good reception, honor, and worship, and with hypocrisy, is said to be Rajasic, unstable, and transient.", sanskrit: "सत्कारमानपूजार्थं तपो दम्भेन चैव यत् ।\nक्रियते तदिह प्रोक्तं राजसं चलमध्रुवम् ॥", iast: "satkāramānapūjārthaṃ tapo dambhena caiva yat |\nkriyate tadiha proktaṃ rājasaṃ calamadhruvam ||", transliteration: "satkāra-māna-pūjārthaṁ tapo dambhena chaiva yat\nkriyate tad iha proktaṁ rājasaṁ chalam adhruvam", translation_en: "The austerity that is practiced with the aim of gaining good reception, honor, and worship, and with hypocrisy, is said to be Rajasic, unstable, and transient.", translation_hi: "जो तप सत्कार, मान और पूजा के लिए अथवा केवल दम्भ (पाखण्ड) से ही किया जाता है, वह अनिश्चित और क्षणिक तप यहाँ राजस कहा गया है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_018.mp3"},
  {id: "BG_17.19", label: "BG 17.19", ref: "17.19", chapter: 17, verse: 19, speaker: "krishna", canonical: true, meter: "anustubh", sa: "मूढग्राहेणात्मनो यत्पीडया क्रियते तपः", snippet: "That austerity which is practised out of a foolish notion, with self-torture, or for the purpose of destroying another, is declared to be of the Tamasic nature.", sanskrit: "मूढग्राहेणात्मनो यत्पीडया क्रियते तपः ।\nपरस्योत्सादनार्थं वा तत्तामसमुदाहृतम् ॥", iast: "mūḍhagrāheṇātmano yatpīḍayā kriyate tapaḥ |\nparasyotsādanārthaṃ vā tattāmasamudāhṛtam ||", transliteration: "mūḍha-grāheṇātmano yat pīḍayā kriyate tapaḥ\nparasyotsādanārthaṁ vā tat tāmasam udāhṛitam", translation_en: "That austerity which is practised out of a foolish notion, with self-torture, or for the purpose of destroying another, is declared to be of the Tamasic nature.", translation_hi: "जो तप मूढ़तापूर्वक स्वयं को पीड़ित करते हुए अथवा अन्य लोगों के नाश के लिए किया जाता है, वह तप तामस कहा गया है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_019.mp3"},
  {id: "BG_17.20", label: "BG 17.20", ref: "17.20", chapter: 17, verse: 20, speaker: "krishna", canonical: true, meter: "anustubh", sa: "दातव्यमिति यद्दानं दीयतेऽनुपकारिणे", snippet: "That gift which is given to one who does nothing in return, knowing it to be a duty to give in a suitable place and time to a worthy person, is held to be Sattvic.", sanskrit: "दातव्यमिति यद्दानं दीयतेऽनुपकारिणे ।\nदेशे काले च पात्रे च तद्दानं सात्त्विकं स्मृतम् ॥", iast: "dātavyamiti yaddānaṃ dīyate’nupakāriṇe |\ndeśe kāle ca pātre ca taddānaṃ sāttvikaṃ smṛtam ||", transliteration: "dātavyam iti yad dānaṁ dīyate ‘nupakāriṇe\ndeśhe kāle cha pātre cha tad dānaṁ sāttvikaṁ smṛitam", translation_en: "That gift which is given to one who does nothing in return, knowing it to be a duty to give in a suitable place and time to a worthy person, is held to be Sattvic.", translation_hi: "\"दान देना ही कर्तव्य है\" - इस भाव से जो दान योग्य देश, काल को देखकर ऐसे (योग्य) पात्र (व्यक्ति) को दिया जाता है, जिससे प्रत्युपकार की अपेक्षा नहीं होती है, वह दान सात्त्विक माना गया है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_020.mp3"},
  {id: "BG_17.21", label: "BG 17.21", ref: "17.21", chapter: 17, verse: 21, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यत्तु प्रत्युपकारार्थं फलमुद्दिश्य वा पुनः", snippet: "And, that gift which is given with the intention of receiving something in return, or expecting a reward, or begrudgingly, is considered to be Rajasic.", sanskrit: "यत्तु प्रत्युपकारार्थं फलमुद्दिश्य वा पुनः ।\nदीयते च परिक्लिष्टं तद्दानं राजसं स्मृतम् ॥", iast: "yattu pratyupakārārthaṃ phalamuddiśya vā punaḥ |\ndīyate ca parikliṣṭaṃ taddānaṃ rājasaṃ smṛtam ||", transliteration: "yat tu pratyupakārārthaṁ phalam uddiśhya vā punaḥ\ndīyate cha parikliṣhṭaṁ tad dānaṁ rājasaṁ smṛitam", translation_en: "And, that gift which is given with the intention of receiving something in return, or expecting a reward, or begrudgingly, is considered to be Rajasic.", translation_hi: "और जो दान क्लेशपूर्वक तथा प्रत्युपकार के उद्देश्य से अथवा फल की कामना रखकर दिया जाता हैं, वह दान राजस माना गया है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_021.mp3"},
  {id: "BG_17.22", label: "BG 17.22", ref: "17.22", chapter: 17, verse: 22, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अदेशकाले यद्दानमपात्रेभ्यश्च दीयते", snippet: "The gift that is given in the wrong place and at the wrong time, to unworthy persons, without respect or with insult, is declared to be of a Tamasic nature.", sanskrit: "अदेशकाले यद्दानमपात्रेभ्यश्च दीयते ।\nअसत्कृतमवज्ञातं तत्तामसमुदाहृतम् ॥", iast: "adeśakāle yaddānamapātrebhyaśca dīyate |\nasatkṛtamavajñātaṃ tattāmasamudāhṛtam ||", transliteration: "adeśha-kāle yad dānam apātrebhyaśh cha dīyate\nasat-kṛitam avajñātaṁ tat tāmasam udāhṛitam", translation_en: "The gift that is given in the wrong place and at the wrong time, to unworthy persons, without respect or with insult, is declared to be of a Tamasic nature.", translation_hi: "जो दान बिना सत्कार किये, अथवा तिरस्कारपूर्वक, अयोग्य देशकाल में, कुपात्रों के लिए दिया जाता है, वह दान तामस माना गया है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_022.mp3"},
  {id: "BG_17.23", label: "BG 17.23", ref: "17.23", chapter: 17, verse: 23, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तत्सदिति निर्देशो ब्रह्मणस्त्रिविधः स्मृतः", snippet: "\"Om Tat Sat\": This has been declared to be the triple designation of Brahman. By that, the Brahmanas, the Vedas, and the sacrifices were created formerly.", sanskrit: "तत्सदिति निर्देशो ब्रह्मणस्त्रिविधः स्मृतः ।\nब्राह्मणास्तेन वेदाश्च यज्ञाश्च विहिताः पुरा ॥", iast: "tatsaditi nirdeśo brahmaṇastrividhaḥ smṛtaḥ |\nbrāhmaṇāstena vedāśca yajñāśca vihitāḥ purā ||", transliteration: "oṁ tat sad iti nirdeśho brahmaṇas tri-vidhaḥ smṛitaḥ\nbrāhmaṇās tena vedāśh cha yajñāśh cha vihitāḥ purā", translation_en: "\"Om Tat Sat\": This has been declared to be the triple designation of Brahman. By that, the Brahmanas, the Vedas, and the sacrifices were created formerly.", translation_hi: "'ऊँ, तत् सत्' ऐसा यह ब्रह्म का त्रिविध निर्देश (नाम) कहा गया है; उसी से आदिकाल में (पुरा) ब्राहम्ण, वेद और यज्ञ निर्मित हुए हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_023.mp3"},
  {id: "BG_17.24", label: "BG 17.24", ref: "17.24", chapter: 17, verse: 24, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तस्मादोमित्युदाहृत्य यज्ञदानतपःक्रियाः", snippet: "Therefore, with the utterance of \"Om,\" the acts of sacrifice, gift, and austerity, as enjoined in the scriptures, are always begun by the students of Brahman.", sanskrit: "तस्मादोमित्युदाहृत्य यज्ञदानतपःक्रियाः ।\nप्रवर्तन्ते विधानोक्ताः सततं ब्रह्मवादिनाम् ॥", iast: "tasmādomityudāhṛtya yajñadānatapaḥkriyāḥ |\npravartante vidhānoktāḥ satataṃ brahmavādinām ||", transliteration: "tasmād oṁ ity udāhṛitya yajña-dāna-tapaḥ-kriyāḥ\npravartante vidhānoktāḥ satataṁ brahma-vādinām", translation_en: "Therefore, with the utterance of \"Om,\" the acts of sacrifice, gift, and austerity, as enjoined in the scriptures, are always begun by the students of Brahman.", translation_hi: "इसलिए, ब्रह्मवादियों की शास्त्र प्रतिपादित यज्ञ, दान और तप की क्रियायें सदैव ओंकार के उच्चारण के साथ प्रारम्भ होती हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_024.mp3"},
  {id: "BG_17.25", label: "BG 17.25", ref: "17.25", chapter: 17, verse: 25, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तदित्यनभिसन्धाय फलं यज्ञतपःक्रियाः", snippet: "Uttering \"Tat,\" without aiming for the fruits, are the acts of sacrifice, austerity, and the various acts of gifts performed by those seeking liberation.", sanskrit: "तदित्यनभिसन्धाय फलं यज्ञतपःक्रियाः ।\nदानक्रियाश्च विविधाः क्रियन्ते मोक्षकाङ्क्षि ॥", iast: "tadityanabhisandhāya phalaṃ yajñatapaḥkriyāḥ |\ndānakriyāśca vividhāḥ kriyante mokṣakāṅkṣi ||", transliteration: "tad ity anabhisandhāya phalaṁ yajña-tapaḥ-kriyāḥ\ndāna-kriyāśh cha vividhāḥ kriyante mokṣha-kāṅkṣhibhiḥ", translation_en: "Uttering \"Tat,\" without aiming for the fruits, are the acts of sacrifice, austerity, and the various acts of gifts performed by those seeking liberation.", translation_hi: "'तत्' शब्द का उच्चारण कर, फल की इच्छा नहीं रखते हुए, मुमुक्षुजन यज्ञ, तप, दान आदि विविध कर्म करते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_025.mp3"},
  {id: "BG_17.26", label: "BG 17.26", ref: "17.26", chapter: 17, verse: 26, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सद्भावे साधुभावे च सदित्येतत्प्रयुज्यते", snippet: "The word \"Sat\" is used to refer to reality and goodness; likewise, O Arjuna, the word \"Sat\" is used to refer to an auspicious act.", sanskrit: "सद्भावे साधुभावे च सदित्येतत्प्रयुज्यते ।\nप्रशस्ते कर्मणि तथा सच्छब्दः पार्थ युज्यते ॥", iast: "sadbhāve sādhubhāve ca sadityetatprayujyate |\npraśaste karmaṇi tathā sacchabdaḥ pārtha yujyate ||", transliteration: "sad-bhāve sādhu-bhāve cha sad ity etat prayujyate\npraśhaste karmaṇi tathā sach-chhabdaḥ pārtha yujyate", translation_en: "The word \"Sat\" is used to refer to reality and goodness; likewise, O Arjuna, the word \"Sat\" is used to refer to an auspicious act.", translation_hi: "हे पार्थ ! सत्य भाव व साधुभाव में 'सत्' शब्द का प्रयोग किया जाता है, और प्रशस्त (श्रेष्ठ, शुभ) कर्म में 'सत्' शब्द प्रयुक्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_026.mp3"},
  {id: "BG_17.27", label: "BG 17.27", ref: "17.27", chapter: 17, verse: 27, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यज्ञे तपसि दाने च स्थितिः सदिति चोच्यते", snippet: "Steadfastness in sacrifice, austerity, and gift is also called 'Sat', and action in connection with these, or for the sake of the Supreme, is also called 'Sat'.", sanskrit: "यज्ञे तपसि दाने च स्थितिः सदिति चोच्यते ।\nकर्म चैव तदर्थीयं सदित्येवाभिधीयते ॥", iast: "yajñe tapasi dāne ca sthitiḥ saditi cocyate |\nkarma caiva tadarthīyaṃ sadityevābhidhīyate ||", transliteration: "yajñe tapasi dāne cha sthitiḥ sad iti chochyate\nkarma chaiva tad-arthīyaṁ sad ity evābhidhīyate", translation_en: "Steadfastness in sacrifice, austerity, and gift is also called 'Sat', and action in connection with these, or for the sake of the Supreme, is also called 'Sat'.", translation_hi: "यज्ञ, तप और दान में दृढ़ स्थिति भी सत् कही जाती है, और उस (परमात्मा) के लिए किया गया कर्म भी सत् ही कहलाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_027.mp3"},
  {id: "BG_17.28", label: "BG 17.28", ref: "17.28", chapter: 17, verse: 28, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अश्रद्धया हुतं दत्तं तपस्तप्तं कृतं च यत्", snippet: "Whatever is sacrificed, given, or performed, and whatever austerity is practiced without faith, it is called 'Asat', O Arjuna; it is of no value here or hereafter (after death).", sanskrit: "अश्रद्धया हुतं दत्तं तपस्तप्तं कृतं च यत् ।\nअसदित्युच्यते पार्थ न च तत्प्रेत्य नो इह ॥", iast: "aśraddhayā hutaṃ dattaṃ tapastaptaṃ kṛtaṃ ca yat |\nasadityucyate pārtha na ca tatpretya no iha ||", transliteration: "aśhraddhayā hutaṁ dattaṁ tapas taptaṁ kṛitaṁ cha yat\nasad ity uchyate pārtha na cha tat pretya no iha", translation_en: "Whatever is sacrificed, given, or performed, and whatever austerity is practiced without faith, it is called 'Asat', O Arjuna; it is of no value here or hereafter (after death).", translation_hi: "हे पार्थ ! जो यज्ञ, दान, तप और कर्म अश्रद्धापूर्वक किया जाता है, वह 'असत्' कहा जाता है; वह न इस लोक में (इह) और न मरण के पश्चात् (उस लोक में) लाभदायक होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/017_028.mp3"},
  {id: "BG_18.1", label: "BG 18.1", ref: "18.1", chapter: 18, verse: 1, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "संन्यासस्य महाबाहो तत्त्वमिच्छामि वेदितुम्", snippet: "Arjuna said, \"O mighty-armed Hrishikesa, I desire to know the essence or truth of renunciation and abandonment severally, O slayer of Kesi.\"", sanskrit: "संन्यासस्य महाबाहो तत्त्वमिच्छामि वेदितुम् ।\nत्यागस्य च हृषीकेश पृथक्केशिनिषूदन ॥", iast: "saṃnyāsasya mahābāho tattvamicchāmi veditum |\ntyāgasya ca hṛṣīkeśa pṛthakkeśiniṣūdana ||", transliteration: "sannyāsasya mahā-bāho tattvam ichchhāmi veditum\ntyāgasya cha hṛiṣhīkeśha pṛithak keśhi-niṣhūdana", translation_en: "Arjuna said, \"O mighty-armed Hrishikesa, I desire to know the essence or truth of renunciation and abandonment severally, O slayer of Kesi.\"", translation_hi: "अर्जुन ने कहा -- हे महाबाहो ! हे हृषीकेश ! हे केशनिषूदन ! मैं संन्यास और त्याग के तत्त्व को पृथक्-पृथक् जानना चाहता हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_001.mp3"},
  {id: "BG_18.2", label: "BG 18.2", ref: "18.2", chapter: 18, verse: 2, speaker: "krishna", canonical: true, meter: "anustubh", sa: "काम्यानां कर्मणां न्यासं संन्यासं कवयो विदुः", snippet: "The Blessed Lord said, \"The sages understand sannyasa to be the renunciation of action with desire; the wise declare the abandonment of the fruits of all actions to be tyaga.\"", sanskrit: "काम्यानां कर्मणां न्यासं संन्यासं कवयो विदुः ।\nसर्वकर्मफलत्यागं प्राहुस्त्यागं विचक्षणाः ॥", iast: "kāmyānāṃ karmaṇāṃ nyāsaṃ saṃnyāsaṃ kavayo viduḥ |\nsarvakarmaphalatyāgaṃ prāhustyāgaṃ vicakṣaṇāḥ ||", transliteration: "kāmyānāṁ karmaṇāṁ nyāsaṁ sannyāsaṁ kavayo viduḥ\nsarva-karma-phala-tyāgaṁ prāhus tyāgaṁ vichakṣhaṇāḥ", translation_en: "The Blessed Lord said, \"The sages understand sannyasa to be the renunciation of action with desire; the wise declare the abandonment of the fruits of all actions to be tyaga.\"", translation_hi: "श्रीभगवान् ने कहा -- (कुछ) कवि (पण्डित) जन काम्य कर्मों के त्याग को \"संन्यास\" समझते हैं और विचारशील जन समस्त कर्मों के फलों के त्याग को \"त्याग\" कहते हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_002.mp3"},
  {id: "BG_18.3", label: "BG 18.3", ref: "18.3", chapter: 18, verse: 3, speaker: "krishna", canonical: true, meter: "anustubh", sa: "त्याज्यं दोषवदित्येके कर्म प्राहुर्मनीषिणः", snippet: "Some philosophers declare that actions should be abandoned as evil; while others declare that acts of sacrifice, gift, and austerity should not be relinquished.", sanskrit: "त्याज्यं दोषवदित्येके कर्म प्राहुर्मनीषिणः ।\nयज्ञदानतपःकर्म न त्याज्यमिति चापरे ॥", iast: "tyājyaṃ doṣavadityeke karma prāhurmanīṣiṇaḥ |\nyajñadānatapaḥkarma na tyājyamiti cāpare ||", transliteration: "tyājyaṁ doṣha-vad ity eke karma prāhur manīṣhiṇaḥ\nyajña-dāna-tapaḥ-karma na tyājyam iti chāpare", translation_en: "Some philosophers declare that actions should be abandoned as evil; while others declare that acts of sacrifice, gift, and austerity should not be relinquished.", translation_hi: "कुछ मनीषी जन कहते हैं कि समस्त कर्म दोषयुक्त होने के कारण त्याज्य हैं; और अन्य जन कहते हैं कि यज्ञ, दान और तपरूप कर्म त्याज्य नहीं हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_003.mp3"},
  {id: "BG_18.4", label: "BG 18.4", ref: "18.4", chapter: 18, verse: 4, speaker: "krishna", canonical: true, meter: "anustubh", sa: "निश्चयं श्रृणु मे तत्र त्यागे भरतसत्तम", snippet: "Hear from Me the conclusion or the final truth about this abandonment, O best of the Bharatas; abandonment, indeed, O best of men, has been declared to be of three kinds.", sanskrit: "निश्चयं श्रृणु मे तत्र त्यागे भरतसत्तम ।\nत्यागो हि पुरुषव्याघ्र त्रिविधः संप्रकीर्तितः ॥", iast: "niścayaṃ śrṛṇu me tatra tyāge bharatasattama |\ntyāgo hi puruṣavyāghra trividhaḥ saṃprakīrtitaḥ ||", transliteration: "niśhchayaṁ śhṛiṇu me tatra tyāge bharata-sattama\ntyāgo hi puruṣha-vyāghra tri-vidhaḥ samprakīrtitaḥ", translation_en: "Hear from Me the conclusion or the final truth about this abandonment, O best of the Bharatas; abandonment, indeed, O best of men, has been declared to be of three kinds.", translation_hi: "हे भरतसत्तम ! उस त्याग के विषय में तुम मेरे निर्णय को सुनो। हे पुरुष श्रेष्ठ ! वह त्याग तीन प्रकार का कहा गया है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_004.mp3"},
  {id: "BG_18.5", label: "BG 18.5", ref: "18.5", chapter: 18, verse: 5, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यज्ञदानतपःकर्म न त्याज्यं कार्यमेव तत्", snippet: "Acts of sacrifice, gift, and austerity should not be abandoned, but should be performed; for sacrifice, gift, and austerity are the purifiers of the wise.", sanskrit: "यज्ञदानतपःकर्म न त्याज्यं कार्यमेव तत् ।\nयज्ञो दानं तपश्चैव पावनानि मनीषिणाम् ॥", iast: "yajñadānatapaḥkarma na tyājyaṃ kāryameva tat |\nyajño dānaṃ tapaścaiva pāvanāni manīṣiṇām ||", transliteration: "yajña-dāna-tapaḥ-karma na tyājyaṁ kāryam eva tat\nyajño dānaṁ tapaśh chaiva pāvanāni manīṣhiṇām", translation_en: "Acts of sacrifice, gift, and austerity should not be abandoned, but should be performed; for sacrifice, gift, and austerity are the purifiers of the wise.", translation_hi: "यज्ञ, दान और तपरूप कर्म त्याज्य नहीं है, किन्तु वह नि:सन्देह कर्तव्य है; यज्ञ, दान और तप ये मनीषियों (साधकों) को पवित्र करने वाले हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_005.mp3"},
  {id: "BG_18.6", label: "BG 18.6", ref: "18.6", chapter: 18, verse: 6, speaker: "krishna", canonical: true, meter: "anustubh", sa: "एतान्यपि तु कर्माणि सङ्गं त्यक्त्वा फलानि च", snippet: "But even these actions should be performed, leaving aside attachment and the desire for rewards, O Arjuna; this is my certain and most assured conviction.", sanskrit: "एतान्यपि तु कर्माणि सङ्गं त्यक्त्वा फलानि च ।\nकर्तव्यानीति मे पार्थ निश्चितं मतमुत्तमम् ॥", iast: "etānyapi tu karmāṇi saṅgaṃ tyaktvā phalāni ca |\nkartavyānīti me pārtha niścitaṃ matamuttamam ||", transliteration: "etāny api tu karmāṇi saṅgaṁ tyaktvā phalāni cha\nkartavyānīti me pārtha niśhchitaṁ matam uttamam", translation_en: "But even these actions should be performed, leaving aside attachment and the desire for rewards, O Arjuna; this is my certain and most assured conviction.", translation_hi: "हे पार्थ ! इन कर्मों को भी, फल और आसक्ति को त्यागकर करना चाहिए, यह मेरा निश्चय किया हुआ उत्तम मत है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_006.mp3"},
  {id: "BG_18.7", label: "BG 18.7", ref: "18.7", chapter: 18, verse: 7, speaker: "krishna", canonical: true, meter: "anustubh", sa: "नियतस्य तु संन्यासः कर्मणो नोपपद्यते", snippet: "Verily, the renunciation of obligatory action is not proper; the abandonment of the same out of delusion is declared to be Tamasic.", sanskrit: "नियतस्य तु संन्यासः कर्मणो नोपपद्यते ।\nमोहात्तस्य परित्यागस्तामसः परिकीर्तितः ॥", iast: "niyatasya tu saṃnyāsaḥ karmaṇo nopapadyate |\nmohāttasya parityāgastāmasaḥ parikīrtitaḥ ||", transliteration: "niyatasya tu sannyāsaḥ karmaṇo nopapadyate\nmohāt tasya parityāgas tāmasaḥ parikīrtitaḥ", translation_en: "Verily, the renunciation of obligatory action is not proper; the abandonment of the same out of delusion is declared to be Tamasic.", translation_hi: "नियत कर्म का त्याग उचित नहीं है; मोहवश उसका त्याग करना \"तामस त्याग\" कहा गया है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_007.mp3"},
  {id: "BG_18.8", label: "BG 18.8", ref: "18.8", chapter: 18, verse: 8, speaker: "krishna", canonical: true, meter: "anustubh", sa: "दुःखमित्येव यत्कर्म कायक्लेशभयात्त्यजेत्", snippet: "He who abandons action out of fear of bodily trouble (because it is painful), does not obtain the merit of renunciation by performing such Rajasic renunciation.", sanskrit: "दुःखमित्येव यत्कर्म कायक्लेशभयात्त्यजेत् ।\nस कृत्वा राजसं त्यागं नैव त्यागफलं लभेत् ॥", iast: "duḥkhamityeva yatkarma kāyakleśabhayāttyajet |\nsa kṛtvā rājasaṃ tyāgaṃ naiva tyāgaphalaṃ labhet ||", transliteration: "duḥkham ity eva yat karma kāya-kleśha-bhayāt tyajet\nsa kṛitvā rājasaṁ tyāgaṁ naiva tyāga-phalaṁ labhet", translation_en: "He who abandons action out of fear of bodily trouble (because it is painful), does not obtain the merit of renunciation by performing such Rajasic renunciation.", translation_hi: "जो मनुष्य, कर्म को दु:ख समझकर शारीरिक कष्ट के भय से त्याग देता है, वह पुरुष उस राजसिक त्याग को करके कदापि त्याग के फल को प्राप्त नहीं होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_008.mp3"},
  {id: "BG_18.9", label: "BG 18.9", ref: "18.9", chapter: 18, verse: 9, speaker: "krishna", canonical: true, meter: "anustubh", sa: "कार्यमित्येव यत्कर्म नियतं क्रियतेऽर्जुन", snippet: "Whatever obligatory action is done, O Arjuna, merely because it ought to be done, abandoning attachment and also the desire for reward, that renunciation is regarded as sattvic…", sanskrit: "कार्यमित्येव यत्कर्म नियतं क्रियतेऽर्जुन ।\nसङ्गं त्यक्त्वा फलं चैव स त्यागः सात्त्विको मतः ॥", iast: "kāryamityeva yatkarma niyataṃ kriyate’rjuna |\nsaṅgaṃ tyaktvā phalaṃ caiva sa tyāgaḥ sāttviko mataḥ ||", transliteration: "kāryam ity eva yat karma niyataṁ kriyate ‘rjuna\nsaṅgaṁ tyaktvā phalaṁ chaiva sa tyāgaḥ sāttviko mataḥ", translation_en: "Whatever obligatory action is done, O Arjuna, merely because it ought to be done, abandoning attachment and also the desire for reward, that renunciation is regarded as sattvic (pure).", translation_hi: "हे अर्जुन ! \"कर्म करना कर्तव्य है\" ऐसा समझकर जो नियत कर्म आसक्ति और फल को त्यागकर किया जाता है, वही सात्त्विक त्याग माना गया है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_009.mp3"},
  {id: "BG_18.10", label: "BG 18.10", ref: "18.10", chapter: 18, verse: 10, speaker: "krishna", canonical: true, meter: "anustubh", sa: "न द्वेष्ट्यकुशलं कर्म कुशले नानुषज्जते", snippet: "The man of renunciation, pervaded by purity, intelligent, and with his doubts cut asunder, does not hate an unpleasant task nor is he attached to a pleasant one.", sanskrit: "न द्वेष्ट्यकुशलं कर्म कुशले नानुषज्जते ।\nत्यागी सत्त्वसमाविष्टो मेधावी छिन्नसंशयः ॥", iast: "na dveṣṭyakuśalaṃ karma kuśale nānuṣajjate |\ntyāgī sattvasamāviṣṭo medhāvī chinnasaṃśayaḥ ||", transliteration: "na dveṣhṭy akuśhalaṁ karma kuśhale nānuṣhajjate\ntyāgī sattva-samāviṣhṭo medhāvī chhinna-sanśhayaḥ", translation_en: "The man of renunciation, pervaded by purity, intelligent, and with his doubts cut asunder, does not hate an unpleasant task nor is he attached to a pleasant one.", translation_hi: "जो पुरुष अकुशल (अशुभ) कर्म से द्वेष नहीं करता और कुशल (शुभ) कर्म में आसक्त नहीं होता, वह सत्त्वगुण से सम्पन्न पुरुष संशयरहित, मेधावी (ज्ञानी) और त्यागी है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_010.mp3"},
  {id: "BG_18.11", label: "BG 18.11", ref: "18.11", chapter: 18, verse: 11, speaker: "krishna", canonical: true, meter: "anustubh", sa: "न हि देहभृता शक्यं त्यक्तुं कर्माण्यशेषतः", snippet: "Indeed, it is not possible for an embodied being to completely abandon actions; however, he who relinquishes the rewards of actions is truly called a man of renunciation.", sanskrit: "न हि देहभृता शक्यं त्यक्तुं कर्माण्यशेषतः ।\nयस्तु कर्मफलत्यागी स त्यागीत्यभिधीयते ॥", iast: "na hi dehabhṛtā śakyaṃ tyaktuṃ karmāṇyaśeṣataḥ |\nyastu karmaphalatyāgī sa tyāgītyabhidhīyate ||", transliteration: "na hi deha-bhṛitā śhakyaṁ tyaktuṁ karmāṇy aśheṣhataḥ\nyas tu karma-phala-tyāgī sa tyāgīty abhidhīyate", translation_en: "Indeed, it is not possible for an embodied being to completely abandon actions; however, he who relinquishes the rewards of actions is truly called a man of renunciation.", translation_hi: "क्योंकि देहधारी पुरुष के द्वारा अशेष कर्मों का त्याग संभव नहीं है, इसलिए जो कर्मफल त्यागी है, वही पुरुष त्यागी कहा जाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_011.mp3"},
  {id: "BG_18.12", label: "BG 18.12", ref: "18.12", chapter: 18, verse: 12, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अनिष्टमिष्टं मिश्रं च त्रिविधं कर्मणः फलम्", snippet: "The threefold fruit of action (evil, good, and mixed) accrues after death to those who do not abandon it, but never to those who do.", sanskrit: "अनिष्टमिष्टं मिश्रं च त्रिविधं कर्मणः फलम् ।\nभवत्यत्यागिनां प्रेत्य न तु संन्यासिनां क्वचित् ॥", iast: "aniṣṭamiṣṭaṃ miśraṃ ca trividhaṃ karmaṇaḥ phalam |\nbhavatyatyāgināṃ pretya na tu saṃnyāsināṃ kvacit ||", transliteration: "aniṣhṭam iṣhṭaṁ miśhraṁ cha tri-vidhaṁ karmaṇaḥ phalam\nbhavaty atyāgināṁ pretya na tu sannyāsināṁ kvachit", translation_en: "The threefold fruit of action (evil, good, and mixed) accrues after death to those who do not abandon it, but never to those who do.", translation_hi: "कर्मों के शुभ, अशुभ और मिश्र ये त्रिविध फल केवल अत्यागी जनों को मरण के पश्चात् भी प्राप्त होते हैं; परन्तु संन्यासी पुरुषों को कदापि नहीं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_012.mp3"},
  {id: "BG_18.13", label: "BG 18.13", ref: "18.13", chapter: 18, verse: 13, speaker: "krishna", canonical: true, meter: "anustubh", sa: "पञ्चैतानि महाबाहो कारणानि निबोध मे", snippet: "Learn from Me, O mighty-armed Arjuna, these five causes, as declared in the Sankhya system, for the accomplishment of all actions.", sanskrit: "पञ्चैतानि महाबाहो कारणानि निबोध मे ।\nसांख्ये कृतान्ते प्रोक्तानि सिद्धये सर्वकर्मणाम् ॥", iast: "pañcaitāni mahābāho kāraṇāni nibodha me |\nsāṃkhye kṛtānte proktāni siddhaye sarvakarmaṇām ||", transliteration: "pañchaitāni mahā-bāho kāraṇāni nibodha me\nsānkhye kṛitānte proktāni siddhaye sarva-karmaṇām", translation_en: "Learn from Me, O mighty-armed Arjuna, these five causes, as declared in the Sankhya system, for the accomplishment of all actions.", translation_hi: "हे महाबाहो ! समस्त कर्मों की सिद्धि के लिए ये पांच कारण सांख्य सिद्धांत में कहे गये हैं, जिनको तुम मुझसे भलीभांति जानो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_013.mp3"},
  {id: "BG_18.14", label: "BG 18.14", ref: "18.14", chapter: 18, verse: 14, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अधिष्ठानं तथा कर्ता करणं च पृथग्विधम्", snippet: "The body, the doer, the various senses, the different functions of various kinds, and the presiding deity—the fifth.", sanskrit: "अधिष्ठानं तथा कर्ता करणं च पृथग्विधम् ।\nविविधाश्च पृथक्चेष्टा दैवं चैवात्र पञ्चमम् ॥", iast: "adhiṣṭhānaṃ tathā kartā karaṇaṃ ca pṛthagvidham |\nvividhāśca pṛthakceṣṭā daivaṃ caivātra pañcamam ||", transliteration: "adhiṣhṭhānaṁ tathā kartā karaṇaṁ cha pṛithag-vidham\nvividhāśh cha pṛithak cheṣhṭā daivaṁ chaivātra pañchamam", translation_en: "The body, the doer, the various senses, the different functions of various kinds, and the presiding deity—the fifth.", translation_hi: "अधिष्ठान (शरीर), कर्ता ,विविध करण (इन्द्रियादि) ,विविध और पृथक्-पृथक् चेष्टाएं तथा पाँचवा हेतु दैव है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_014.mp3"},
  {id: "BG_18.15", label: "BG 18.15", ref: "18.15", chapter: 18, verse: 15, speaker: "krishna", canonical: true, meter: "anustubh", sa: "शरीरवाङ्मनोभिर्यत्कर्म प्रारभते नरः", snippet: "Whatever action a person performs with their body, speech, and mind, whether right or wrong, these five are its causes.", sanskrit: "शरीरवाङ्मनोभिर्यत्कर्म प्रारभते नरः ।\nन्याय्यं वा विपरीतं वा पञ्चैते तस्य हेतवः ॥", iast: "śarīravāṅmanobhiryatkarma prārabhate naraḥ |\nnyāyyaṃ vā viparītaṃ vā pañcaite tasya hetavaḥ ||", transliteration: "śharīra-vāṅ-manobhir yat karma prārabhate naraḥ\nnyāyyaṁ vā viparītaṁ vā pañchaite tasya hetavaḥ", translation_en: "Whatever action a person performs with their body, speech, and mind, whether right or wrong, these five are its causes.", translation_hi: "मनुष्य अपने शरीर, वाणी और मन से जो कोई न्याय्य (उचित) या विपरीत (अनुचित) कर्म करता है, उसके ये पाँच कारण ही हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_015.mp3"},
  {id: "BG_18.16", label: "BG 18.16", ref: "18.16", chapter: 18, verse: 16, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तत्रैवं सति कर्तारमात्मानं केवलं तु यः", snippet: "Now, such being the case, verily he who, owing to an untrained understanding, looks upon his Self, which is isolated, as the agent, he of perverted intelligence does not see.", sanskrit: "तत्रैवं सति कर्तारमात्मानं केवलं तु यः ।\nपश्यत्यकृतबुद्धित्वान्न स पश्यति दुर्मतिः ॥", iast: "tatraivaṃ sati kartāramātmānaṃ kevalaṃ tu yaḥ |\npaśyatyakṛtabuddhitvānna sa paśyati durmatiḥ ||", transliteration: "tatraivaṁ sati kartāram ātmānaṁ kevalaṁ tu yaḥ\npaśhyaty akṛita-buddhitvān na sa paśhyati durmatiḥ", translation_en: "Now, such being the case, verily he who, owing to an untrained understanding, looks upon his Self, which is isolated, as the agent, he of perverted intelligence does not see.", translation_hi: "अब इस स्थिति में जो पुरुष असंस्कृत बुद्धि होने के कारण, केवल शुद्ध आत्मा को कर्ता समझता हैं, वह दुर्मति पुरुष (यथार्थ) नहीं देखता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_016.mp3"},
  {id: "BG_18.17", label: "BG 18.17", ref: "18.17", chapter: 18, verse: 17, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यस्य नाहंकृतो भावो बुद्धिर्यस्य न लिप्यते", snippet: "He who is free from the egoistic notion, whose intelligence is not tainted by good or evil, though he slays these people, he does not slay, nor is he bound by the action.", sanskrit: "यस्य नाहंकृतो भावो बुद्धिर्यस्य न लिप्यते ।\nहत्वापि स इमाँल्लोकान्न हन्ति न निबध्यते ॥", iast: "yasya nāhaṃkṛto bhāvo buddhiryasya na lipyate |\nhatvāpi sa imām̐llokānna hanti na nibadhyate ||", transliteration: "yasya nāhankṛito bhāvo buddhir yasya na lipyate\nhatvā ‘pi sa imāl lokān na hanti na nibadhyate", translation_en: "He who is free from the egoistic notion, whose intelligence is not tainted by good or evil, though he slays these people, he does not slay, nor is he bound by the action.", translation_hi: "जिस पुरुष में अहंकार का भाव नहीं है और बुद्धि किसी (गुण दोष) से लिप्त नहीं होती, वह पुरुष इन सब लोकों को मारकर भी वास्तव में न मरता है और न (पाप से) बँधता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_017.mp3"},
  {id: "BG_18.18", label: "BG 18.18", ref: "18.18", chapter: 18, verse: 18, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ज्ञानं ज्ञेयं परिज्ञाता त्रिविधा कर्मचोदना", snippet: "Knowledge, the knowable, and the knower form the threefold impulse for action; the organ, the action, and the agent form the threefold basis of action.", sanskrit: "ज्ञानं ज्ञेयं परिज्ञाता त्रिविधा कर्मचोदना ।\nकरणं कर्म कर्तेति त्रिविधः कर्मसंग्रहः ॥", iast: "jñānaṃ jñeyaṃ parijñātā trividhā karmacodanā |\nkaraṇaṃ karma karteti trividhaḥ karmasaṃgrahaḥ ||", transliteration: "jñānaṁ jñeyaṁ parijñātā tri-vidhā karma-chodanā\nkaraṇaṁ karma karteti tri-vidhaḥ karma-saṅgrahaḥ", translation_en: "Knowledge, the knowable, and the knower form the threefold impulse for action; the organ, the action, and the agent form the threefold basis of action.", translation_hi: "ज्ञान, ज्ञेय और परिज्ञाता ये त्रिविध कर्म प्रेरक हैं, और, करण, कर्म. कर्ता ये त्रिविध कर्म संग्रह हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_018.mp3"},
  {id: "BG_18.19", label: "BG 18.19", ref: "18.19", chapter: 18, verse: 19, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ज्ञानं कर्म च कर्ता च त्रिधैव गुणभेदतः", snippet: "Knowledge, action, and actor are declared in the science of the Gunas (Sankhya philosophy) to be of three kinds only, according to the distinction of the Gunas. Of these, hear…", sanskrit: "ज्ञानं कर्म च कर्ता च त्रिधैव गुणभेदतः ।\nप्रोच्यते गुणसंख्याने यथावच्छृणु तान्यपि ॥", iast: "jñānaṃ karma ca kartā ca tridhaiva guṇabhedataḥ |\nprocyate guṇasaṃkhyāne yathāvacchṛṇu tānyapi ||", transliteration: "jñānaṁ karma cha kartā cha tridhaiva guṇa-bhedataḥ\nprochyate guṇa-saṅkhyāne yathāvach chhṛiṇu tāny api", translation_en: "Knowledge, action, and actor are declared in the science of the Gunas (Sankhya philosophy) to be of three kinds only, according to the distinction of the Gunas. Of these, hear duly.", translation_hi: "ज्ञान, कर्म और कर्ता भी गुणों के भेद से सांख्यशास्त्र (गुणसंख्याने) में त्रिविध ही कहे गये हैं; उनको भी तुम मुझ से यथावत् श्रवण करो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_019.mp3"},
  {id: "BG_18.20", label: "BG 18.20", ref: "18.20", chapter: 18, verse: 20, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सर्वभूतेषु येनैकं भावमव्ययमीक्षते", snippet: "That by which one sees the indestructible Reality in all beings, not separate in any of them—know that knowledge to be Sattvic.", sanskrit: "सर्वभूतेषु येनैकं भावमव्ययमीक्षते ।\nअविभक्तं विभक्तेषु तज्ज्ञानं विद्धि सात्त्विकम् ॥", iast: "sarvabhūteṣu yenaikaṃ bhāvamavyayamīkṣate |\navibhaktaṃ vibhakteṣu tajjñānaṃ viddhi sāttvikam ||", transliteration: "sarva-bhūteṣhu yenaikaṁ bhāvam avyayam īkṣhate\navibhaktaṁ vibhakteṣhu taj jñānaṁ viddhi sāttvikam", translation_en: "That by which one sees the indestructible Reality in all beings, not separate in any of them—know that knowledge to be Sattvic.", translation_hi: "जिस ज्ञान से मनुष्य, विभक्त रूप में स्थित समस्त भूतों में एक अविभक्त और अविनाशी (अव्यय) स्वरूप को देखता है, उस ज्ञान को तुम सात्त्विक जानो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_020.mp3"},
  {id: "BG_18.21", label: "BG 18.21", ref: "18.21", chapter: 18, verse: 21, speaker: "krishna", canonical: true, meter: "anustubh", sa: "पृथक्त्वेन तु यज्ज्ञानं नानाभावान्पृथग्विधान्", snippet: "But that knowledge which sees in all beings various entities of distinct kinds as being distinct from one another, know thou that knowledge to be Rajasic.", sanskrit: "पृथक्त्वेन तु यज्ज्ञानं नानाभावान्पृथग्विधान् ।\nवेत्ति सर्वेषु भूतेषु तज्ज्ञानं विद्धि राजसम् ॥", iast: "pṛthaktvena tu yajjñānaṃ nānābhāvānpṛthagvidhān |\nvetti sarveṣu bhūteṣu tajjñānaṃ viddhi rājasam ||", transliteration: "pṛithaktvena tu yaj jñānaṁ nānā-bhāvān pṛithag-vidhān\nvetti sarveṣhu bhūteṣhu taj jñānaṁ viddhi rājasam", translation_en: "But that knowledge which sees in all beings various entities of distinct kinds as being distinct from one another, know thou that knowledge to be Rajasic.", translation_hi: "जिस ज्ञान के द्वारा मनुष्य समस्त भूतों में नाना भावों को पृथक्-पृथक् जानता है, उस ज्ञान को तुम राजस जानो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_021.mp3"},
  {id: "BG_18.22", label: "BG 18.22", ref: "18.22", chapter: 18, verse: 22, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यत्तु कृत्स्नवदेकस्मिन्कार्ये सक्तमहैतुकम्", snippet: "But that which clings to one single effect as if it were the whole, without reason, without any foundation in Truth, and is trivial—that is declared to be Tamasic.", sanskrit: "यत्तु कृत्स्नवदेकस्मिन्कार्ये सक्तमहैतुकम् ।\nअतत्त्वार्थवदल्पं च तत्तामसमुदाहृतम् ॥", iast: "yattu kṛtsnavadekasminkārye saktamahaitukam |\natattvārthavadalpaṃ ca tattāmasamudāhṛtam ||", transliteration: "yat tu kṛitsna-vad ekasmin kārye saktam ahaitukam\natattvārtha-vad alpaṁ cha tat tāmasam udāhṛitam", translation_en: "But that which clings to one single effect as if it were the whole, without reason, without any foundation in Truth, and is trivial—that is declared to be Tamasic.", translation_hi: "और जिस ज्ञान के द्वारा मनुष्य एक कार्य (शरीर) में ही आसक्त हो जाता है, मानो वह (कार्य ही) पूर्ण वस्तु हो तथा जो (ज्ञान) हेतुरहित (अयुक्तिक), तत्त्वार्थ से रहित तथा संकुचित (अल्प) है, वह (ज्ञान) तामस है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_022.mp3"},
  {id: "BG_18.23", label: "BG 18.23", ref: "18.23", chapter: 18, verse: 23, speaker: "krishna", canonical: true, meter: "anustubh", sa: "नियतं सङ्गरहितमरागद्वेषतः कृतम्", snippet: "An action that is ordained, free from attachment, done without love or hatred, and without desire for reward is declared to be Sattvic.", sanskrit: "नियतं सङ्गरहितमरागद्वेषतः कृतम् ।\nअफलप्रेप्सुना कर्म यत्तत्सात्त्विकमुच्यते ॥", iast: "niyataṃ saṅgarahitamarāgadveṣataḥ kṛtam |\naphalaprepsunā karma yattatsāttvikamucyate ||", transliteration: "niyataṁ saṅga-rahitam arāga-dveṣhataḥ kṛitam\naphala-prepsunā karma yat tat sāttvikam uchyate", translation_en: "An action that is ordained, free from attachment, done without love or hatred, and without desire for reward is declared to be Sattvic.", translation_hi: "जो कर्म (शास्त्रविधि से) नियत और संगरहित है, तथा फल को न चाहने वाले पुरुष के द्वारा बिना किसी राग द्वेष के किया गया है, वह (कर्म) सात्त्विक कहा जाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_023.mp3"},
  {id: "BG_18.24", label: "BG 18.24", ref: "18.24", chapter: 18, verse: 24, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यत्तु कामेप्सुना कर्म साहङ्कारेण वा पुनः", snippet: "But that action which is done by one longing for the fulfillment of desires or gain with egotism or with much effort is declared to be Rajasic (passionate).", sanskrit: "यत्तु कामेप्सुना कर्म साहङ्कारेण वा पुनः ।\nक्रियते बहुलायासं तद्राजसमुदाहृतम् ॥", iast: "yattu kāmepsunā karma sāhaṅkāreṇa vā punaḥ |\nkriyate bahulāyāsaṃ tadrājasamudāhṛtam ||", transliteration: "yat tu kāmepsunā karma sāhankāreṇa vā punaḥ\nkriyate bahulāyāsaṁ tad rājasam udāhṛitam", translation_en: "But that action which is done by one longing for the fulfillment of desires or gain with egotism or with much effort is declared to be Rajasic (passionate).", translation_hi: "और जो कर्म बहुत परिश्रम से युक्त है तथा फल की कामना वाले, अहंकारयुक्त पुरुष के द्वारा किया जाता है, वह कर्म राजस कहा गया है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_024.mp3"},
  {id: "BG_18.25", label: "BG 18.25", ref: "18.25", chapter: 18, verse: 25, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अनुबन्धं क्षयं हिंसामनपेक्ष्य च पौरुषम्", snippet: "That action which is undertaken from delusion, without regard for the consequences, loss, injury, and one's own ability, is declared to be Tamasic (dark).", sanskrit: "अनुबन्धं क्षयं हिंसामनपेक्ष्य च पौरुषम् ।\nमोहादारभ्यते कर्म यत्तत्तामसमुच्यते ॥", iast: "anubandhaṃ kṣayaṃ hiṃsāmanapekṣya ca pauruṣam |\nmohādārabhyate karma yattattāmasamucyate ||", transliteration: "anubandhaṁ kṣhayaṁ hinsām anapekṣhya cha pauruṣham\nmohād ārabhyate karma yat tat tāmasam uchyate", translation_en: "That action which is undertaken from delusion, without regard for the consequences, loss, injury, and one's own ability, is declared to be Tamasic (dark).", translation_hi: "जो कर्म परिणाम, हानि, हिंसा और सार्मथ्य (पौरुषम्) का विचार न करके केवल मोहवश आरम्भ किया जाता है, वह कर्म तामस कहलाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_025.mp3"},
  {id: "BG_18.26", label: "BG 18.26", ref: "18.26", chapter: 18, verse: 26, speaker: "krishna", canonical: true, meter: "anustubh", sa: "मुक्तसङ्गोऽनहंवादी धृत्युत्साहसमन्वितः", snippet: "An agent who is free from attachment, non-egoistic, endowed with firmness and enthusiasm, and unaffected by success or failure, is considered to be of a Sattvic (pure) nature.", sanskrit: "मुक्तसङ्गोऽनहंवादी धृत्युत्साहसमन्वितः ।\nसिद्ध्यसिद्ध्योर्निर्विकारः कर्ता सात्त्विक उच्यते ॥", iast: "muktasaṅgo’nahaṃvādī dhṛtyutsāhasamanvitaḥ |\nsiddhyasiddhyornirvikāraḥ kartā sāttvika ucyate ||", transliteration: "mukta-saṅgo ‘nahaṁ-vādī dhṛity-utsāha-samanvitaḥ\nsiddhy-asiddhyor nirvikāraḥ kartā sāttvika uchyate", translation_en: "An agent who is free from attachment, non-egoistic, endowed with firmness and enthusiasm, and unaffected by success or failure, is considered to be of a Sattvic (pure) nature.", translation_hi: "जो कर्ता संगरहित, अहंमन्यता से रहित, धैर्य और उत्साह से युक्त एवं कार्य की सिद्धि (सफलता) और असिद्धि (विफलता) में निर्विकार रहता है, वह कर्ता सात्त्विक कहा जाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_026.mp3"},
  {id: "BG_18.27", label: "BG 18.27", ref: "18.27", chapter: 18, verse: 27, speaker: "krishna", canonical: true, meter: "anustubh", sa: "रागी कर्मफलप्रेप्सुर्लुब्धो हिंसात्मकोऽशुचिः", snippet: "Passionate, desiring to obtain the reward of their actions, greedy, cruel, impure, moved by joy and sorrow, such an agent is said to be Rajasic.", sanskrit: "रागी कर्मफलप्रेप्सुर्लुब्धो हिंसात्मकोऽशुचिः ।\nहर्षशोकान्वितः कर्ता राजसः परिकीर्तितः ॥", iast: "rāgī karmaphalaprepsurlubdho hiṃsātmako’śuciḥ |\nharṣaśokānvitaḥ kartā rājasaḥ parikīrtitaḥ ||", transliteration: "rāgī karma-phala-prepsur lubdho hinsātmako ‘śhuchiḥ\nharṣha-śhokānvitaḥ kartā rājasaḥ parikīrtitaḥ", translation_en: "Passionate, desiring to obtain the reward of their actions, greedy, cruel, impure, moved by joy and sorrow, such an agent is said to be Rajasic.", translation_hi: "रागी, कर्मफल का इच्छुक, लोभी, हिंसक स्वभाव वाला, अशुद्ध और हर्षशोक से युक्त कर्ता राजस कहलाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_027.mp3"},
  {id: "BG_18.28", label: "BG 18.28", ref: "18.28", chapter: 18, verse: 28, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अयुक्तः प्राकृतः स्तब्धः शठो नैष्कृतिकोऽलसः", snippet: "Unsteady, vulgar, inflexible, deceitful, malicious, lazy, despondent, and procrastinating—such an agent is called Tamasic.", sanskrit: "अयुक्तः प्राकृतः स्तब्धः शठो नैष्कृतिकोऽलसः ।\nविषादी दीर्घसूत्री च कर्ता तामस उच्यते ॥", iast: "ayuktaḥ prākṛtaḥ stabdhaḥ śaṭho naiṣkṛtiko’lasaḥ |\nviṣādī dīrghasūtrī ca kartā tāmasa ucyate ||", transliteration: "ayuktaḥ prākṛitaḥ stabdhaḥ śhaṭho naiṣhkṛitiko ‘lasaḥ\nviṣhādī dīrgha-sūtrī cha kartā tāmasa uchyate", translation_en: "Unsteady, vulgar, inflexible, deceitful, malicious, lazy, despondent, and procrastinating—such an agent is called Tamasic.", translation_hi: "अयुक्त, प्राकृत, स्तब्ध, शठ, नैष्कृतिक, आलसी, विषादी और दीर्घसूत्री कर्ता तामस कहा जाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_028.mp3"},
  {id: "BG_18.29", label: "BG 18.29", ref: "18.29", chapter: 18, verse: 29, speaker: "krishna", canonical: true, meter: "anustubh", sa: "बुद्धेर्भेदं धृतेश्चैव गुणतस्त्रिविधं श्रृणु", snippet: "Hear thou the threefold division of intellect and firmness, according to the Gunas, as I declare them fully and distinctly, O Arjuna.", sanskrit: "बुद्धेर्भेदं धृतेश्चैव गुणतस्त्रिविधं श्रृणु ।\nप्रोच्यमानमशेषेण पृथक्त्वेन धनञ्जय ॥", iast: "buddherbhedaṃ dhṛteścaiva guṇatastrividhaṃ śrṛṇu |\nprocyamānamaśeṣeṇa pṛthaktvena dhanañjaya ||", transliteration: "buddher bhedaṁ dhṛiteśh chaiva guṇatas tri-vidhaṁ śhṛiṇu\nprochyamānam aśheṣheṇa pṛithaktvena dhanañjaya", translation_en: "Hear thou the threefold division of intellect and firmness, according to the Gunas, as I declare them fully and distinctly, O Arjuna.", translation_hi: "हे धनंजय ! मेरे द्वारा अशेषत: और पृथकत: कहे जाने वाले, गुणों के कारण उत्पन्न हुए बुद्धि और धृति के त्रिविध भेद को सुनो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_029.mp3"},
  {id: "BG_18.30", label: "BG 18.30", ref: "18.30", chapter: 18, verse: 30, speaker: "krishna", canonical: true, meter: "anustubh", sa: "प्रवृत्तिं च निवृत्तिं च कार्याकार्ये भयाभये", snippet: "The intellect which knows the path of work and renunciation, what should be done and what should not be done, fear and fearlessness, bondage and liberation—that intellect is…", sanskrit: "प्रवृत्तिं च निवृत्तिं च कार्याकार्ये भयाभये ।\nबन्धं मोक्षं च या वेत्ति बुद्धिः सा पार्थ सात्त्विकी ॥", iast: "pravṛttiṃ ca nivṛttiṃ ca kāryākārye bhayābhaye |\nbandhaṃ mokṣaṃ ca yā vetti buddhiḥ sā pārtha sāttvikī ||", transliteration: "pravṛittiṁ cha nivṛittiṁ cha kāryākārye bhayābhaye\nbandhaṁ mokṣhaṁ cha yā vetti buddhiḥ sā pārtha sāttvikī", translation_en: "The intellect which knows the path of work and renunciation, what should be done and what should not be done, fear and fearlessness, bondage and liberation—that intellect is Sattvic (pure), O Arjuna.", translation_hi: "हे पार्थ ! जो बुद्धि प्रवृत्ति और निवृत्ति, कार्य और अकार्य, भय और अभय तथा बन्ध और मोक्ष को तत्त्वत जानती है, वह बुद्धि सात्विकी है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_030.mp3"},
  {id: "BG_18.31", label: "BG 18.31", ref: "18.31", chapter: 18, verse: 31, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यया धर्ममधर्मं च कार्यं चाकार्यमेव च", snippet: "That by which one wrongly understands dharma and adharma, and also what ought to be done and what ought not to be done—that intellect, O Arjuna, is rajasic (passionate).", sanskrit: "यया धर्ममधर्मं च कार्यं चाकार्यमेव च ।\nअयथावत्प्रजानाति बुद्धिः सा पार्थ राजसी ॥", iast: "yayā dharmamadharmaṃ ca kāryaṃ cākāryameva ca |\nayathāvatprajānāti buddhiḥ sā pārtha rājasī ||", transliteration: "yayā dharmam adharmaṁ cha kāryaṁ chākāryam eva cha\nayathāvat prajānāti buddhiḥ sā pārtha rājasī", translation_en: "That by which one wrongly understands dharma and adharma, and also what ought to be done and what ought not to be done—that intellect, O Arjuna, is rajasic (passionate).", translation_hi: "हे पार्थ ! जिस बुद्धि के द्वारा मनुष्य धर्म और अधर्म को तथा कर्तव्य और अकर्तव्य को यथावत् नहीं जानता है, वह बुद्धि राजसी है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_031.mp3"},
  {id: "BG_18.32", label: "BG 18.32", ref: "18.32", chapter: 18, verse: 32, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अधर्मं धर्ममिति या मन्यते तमसाऽऽवृता", snippet: "That intellect, O Arjuna, which is enveloped in darkness and sees Adharma as Dharma and all things perverted, is Tamasic (dark).", sanskrit: "अधर्मं धर्ममिति या मन्यते तमसाऽऽवृता ।\nसर्वार्थान्विपरीतांश्च बुद्धिः सा पार्थ तामसी ॥", iast: "adharmaṃ dharmamiti yā manyate tamasā’’vṛtā |\nsarvārthānviparītāṃśca buddhiḥ sā pārtha tāmasī ||", transliteration: "adharmaṁ dharmam iti yā manyate tamasāvṛitā\nsarvārthān viparītānśh cha buddhiḥ sā pārtha tāmasī", translation_en: "That intellect, O Arjuna, which is enveloped in darkness and sees Adharma as Dharma and all things perverted, is Tamasic (dark).", translation_hi: "हे पार्थ ! तमस् (अज्ञान अन्ध:कार) से आवृत जो बुद्धि अधर्म को ही धर्म मानती है और सभी पदार्थों को विपरीत रूप से जानती है, वह बुद्धि तामसी है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_032.mp3"},
  {id: "BG_18.33", label: "BG 18.33", ref: "18.33", chapter: 18, verse: 33, speaker: "krishna", canonical: true, meter: "anustubh", sa: "धृत्या यया धारयते मनःप्राणेन्द्रियक्रियाः", snippet: "The unwavering firmness, through which Yoga restrains the functions of the mind, life-force, and senses—that firmness, O Arjuna, is Sattvic (pure).", sanskrit: "धृत्या यया धारयते मनःप्राणेन्द्रियक्रियाः ।\nयोगेनाव्यभिचारिण्या धृतिः सा पार्थ सात्त्विकी ॥", iast: "dhṛtyā yayā dhārayate manaḥprāṇendriyakriyāḥ |\nyogenāvyabhicāriṇyā dhṛtiḥ sā pārtha sāttvikī ||", transliteration: "dhṛityā yayā dhārayate manaḥ-prāṇendriya-kriyāḥ\nyogenāvyabhichāriṇyā dhṛitiḥ sā pārtha sāttvikī", translation_en: "The unwavering firmness, through which Yoga restrains the functions of the mind, life-force, and senses—that firmness, O Arjuna, is Sattvic (pure).", translation_hi: "सात्त्विकी है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_033.mp3"},
  {id: "BG_18.34", label: "BG 18.34", ref: "18.34", chapter: 18, verse: 34, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यया तु धर्मकामार्थान् धृत्या धारयतेऽर्जुन", snippet: "But that, O Arjuna, by which one holds fast to Dharma (duty), enjoyment of pleasures, and earning of wealth, on account of attachment and desire for reward—that firmness, O…", sanskrit: "यया तु धर्मकामार्थान् धृत्या धारयतेऽर्जुन ।\nप्रसङ्गेन फलाकाङ्क्षी धृतिः सा पार्थ राजसी ॥", iast: "yayā tu dharmakāmārthān dhṛtyā dhārayate’rjuna |\nprasaṅgena phalākāṅkṣī dhṛtiḥ sā pārtha rājasī ||", transliteration: "yayā tu dharma-kāmārthān dhṛityā dhārayate ‘rjuna\nprasaṅgena phalākāṅkṣhī dhṛitiḥ sā pārtha rājasī", translation_en: "But that, O Arjuna, by which one holds fast to Dharma (duty), enjoyment of pleasures, and earning of wealth, on account of attachment and desire for reward—that firmness, O Arjuna, is Rajasic (passionate).", translation_hi: "हे पृथापुत्र अर्जुन ! कर्मफल का इच्छुक पुरुष अति आसक्ति (प्रसंग) से जिस धृति के द्वारा धर्म, अर्थ और काम (इन तीन पुरुषार्थों) को धारण करता है, वह धृति राजसी है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_034.mp3"},
  {id: "BG_18.35", label: "BG 18.35", ref: "18.35", chapter: 18, verse: 35, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यया स्वप्नं भयं शोकं विषादं मदमेव च", snippet: "That firmness, O Arjuna, by which a stupid man does not abandon sleep, fear, grief, despair, and conceit, is Tamasic.", sanskrit: "यया स्वप्नं भयं शोकं विषादं मदमेव च ।\nन विमुञ्चति दुर्मेधा धृतिः सा पार्थ तामसी ॥", iast: "yayā svapnaṃ bhayaṃ śokaṃ viṣādaṃ madameva ca |\nna vimuñcati durmedhā dhṛtiḥ sā pārtha tāmasī ||", transliteration: "yayā svapnaṁ bhayaṁ śhokaṁ viṣhādaṁ madam eva cha\nna vimuñchati durmedhā dhṛitiḥ sā pārtha tāmasī", translation_en: "That firmness, O Arjuna, by which a stupid man does not abandon sleep, fear, grief, despair, and conceit, is Tamasic.", translation_hi: "हो पार्थ ! दुर्बुद्धि पुरुष जिस धारणा के द्वारा, स्वप्न, भय, शोक, विषाद और मद को नहीं त्यागता है, वह धृति तामसी है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_035.mp3"},
  {id: "BG_18.36", label: "BG 18.36", ref: "18.36", chapter: 18, verse: 36, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सुखं त्विदानीं त्रिविधं श्रृणु मे भरतर्षभ", snippet: "And now, O Arjuna, hear from Me of the threefold pleasure, in which one rejoices through practice and surely comes to the end of pain.", sanskrit: "सुखं त्विदानीं त्रिविधं श्रृणु मे भरतर्षभ ।\nअभ्यासाद्रमते यत्र दुःखान्तं च निगच्छति ॥", iast: "sukhaṃ tvidānīṃ trividhaṃ śrṛṇu me bharatarṣabha |\nabhyāsādramate yatra duḥkhāntaṃ ca nigacchati ||", transliteration: "sukhaṁ tv idānīṁ tri-vidhaṁ śhṛiṇu me bharatarṣhabha\nabhyāsād ramate yatra duḥkhāntaṁ cha nigachchhati\nyat tad agre viṣham iva pariṇāme ‘mṛitopamam\ntat sukhaṁ sāttvikaṁ proktam ātma-buddhi-prasāda-jam", translation_en: "And now, O Arjuna, hear from Me of the threefold pleasure, in which one rejoices through practice and surely comes to the end of pain.", translation_hi: "हे भरतश्रेष्ठ ! अब तुम त्रिविध सुख को मुझसे सुनो, जिसमें (साधक पुरुष) अभ्यास से रमता है और दु:खों के अन्त को प्राप्त होता है (जहाँ उसके दु:खों का अन्त हो जाता है।)।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_036.mp3"},
  {id: "BG_18.37", label: "BG 18.37", ref: "18.37", chapter: 18, verse: 37, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यत्तदग्रे विषमिव परिणामेऽमृतोपमम्", snippet: "That which is like poison at first but in the end like nectar—that happiness is declared to be sattvic, born of the purity of one's own mind due to self-realization.", sanskrit: "यत्तदग्रे विषमिव परिणामेऽमृतोपमम् ।\nतत्सुखं सात्त्विकं प्रोक्तमात्मबुद्धिप्रसादजम् ॥", iast: "yattadagre viṣamiva pariṇāme’mṛtopamam |\ntatsukhaṃ sāttvikaṃ proktamātmabuddhiprasādajam ||", transliteration: "yat  tad agre    viṣam   iva pariṇāme    'mṛtopamam  tat sukhaṁ  sāttvikaṁ   proktam ātma-buddhi-prasāda-jam", translation_en: "That which is like poison at first but in the end like nectar—that happiness is declared to be sattvic, born of the purity of one's own mind due to self-realization.", translation_hi: "जो सुख प्रथम (प्रारम्भ में) विष के समान (भासता) है, परन्तु परिणाम में अमृत के समान है, वह आत्मबुद्धि के प्रसाद से उत्पन्न सुख सात्त्विक कहा गया है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_037.mp3"},
  {id: "BG_18.38", label: "BG 18.38", ref: "18.38", chapter: 18, verse: 38, speaker: "krishna", canonical: true, meter: "anustubh", sa: "विषयेन्द्रियसंयोगाद्यत्तदग्रेऽमृतोपमम्", snippet: "That happiness which arises from the contact of the senses with the objects, which is initially like nectar but eventually like poison, is said to be Rajasic.", sanskrit: "विषयेन्द्रियसंयोगाद्यत्तदग्रेऽमृतोपमम् ।\nपरिणामे विषमिव तत्सुखं राजसं स्मृतम् ॥", iast: "viṣayendriyasaṃyogādyattadagre’mṛtopamam |\npariṇāme viṣamiva tatsukhaṃ rājasaṃ smṛtam ||", transliteration: "viṣhayendriya-sanyogād yat tad agre ’mṛitopamam\npariṇāme viṣham iva tat sukhaṁ rājasaṁ smṛitam", translation_en: "That happiness which arises from the contact of the senses with the objects, which is initially like nectar but eventually like poison, is said to be Rajasic.", translation_hi: "जो सुख विषयों और इन्द्रियों के संयोग से उत्पन्न होता है, वह प्रथम तो अमृत के समान, परन्तु परिणाम में विष तुल्य होता है, वह सुख राजस कहा गया है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_038.mp3"},
  {id: "BG_18.39", label: "BG 18.39", ref: "18.39", chapter: 18, verse: 39, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यदग्रे चानुबन्धे च सुखं मोहनमात्मनः", snippet: "That happiness which at first, as well as in the end, deludes the self, and which arises from sleep, indolence, and heedlessness—that is declared to be Tamasic.", sanskrit: "यदग्रे चानुबन्धे च सुखं मोहनमात्मनः ।\nनिद्रालस्यप्रमादोत्थं तत्तामसमुदाहृतम् ॥", iast: "yadagre cānubandhe ca sukhaṃ mohanamātmanaḥ |\nnidrālasyapramādotthaṃ tattāmasamudāhṛtam ||", transliteration: "yad agre chānubandhe cha sukhaṁ mohanam ātmanaḥ\nnidrālasya-pramādotthaṁ tat tāmasam udāhṛitam", translation_en: "That happiness which at first, as well as in the end, deludes the self, and which arises from sleep, indolence, and heedlessness—that is declared to be Tamasic.", translation_hi: "जो सुख प्रारम्भ में और परिणाम (अनुबन्ध) में भी आत्मा (मनुष्य) को मोहित करने वाला होता है, वह निद्रा, आलस्य और प्रमाद से उत्पन्न सुख तामस कहा जाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_039.mp3"},
  {id: "BG_18.40", label: "BG 18.40", ref: "18.40", chapter: 18, verse: 40, speaker: "krishna", canonical: true, meter: "anustubh", sa: "न तदस्ति पृथिव्यां वा दिवि देवेषु वा पुनः", snippet: "There is no being on earth or in heaven among the gods that is liberated from the three qualities born of Nature.", sanskrit: "न तदस्ति पृथिव्यां वा दिवि देवेषु वा पुनः ।\nसत्त्वं प्रकृतिजैर्मुक्तं यदेभिः स्यात्ति्रभिर्गुणैः ॥", iast: "na tadasti pṛthivyāṃ vā divi deveṣu vā punaḥ |\nsattvaṃ prakṛtijairmuktaṃ yadebhiḥ syāttirabhirguṇaiḥ ||", transliteration: "na tad asti pṛithivyāṁ vā divi deveṣhu vā punaḥ\nsattvaṁ prakṛiti-jair muktaṁ yad ebhiḥ syāt tribhir guṇaiḥ", translation_en: "There is no being on earth or in heaven among the gods that is liberated from the three qualities born of Nature.", translation_hi: "पृथ्वी पर अथवा स्वर्ग के देवताओं में ऐसा कोई प्राणी (सत्त्वं अर्थात् विद्यमान वस्तु) नहीं है जो प्रकृति से उत्पन्न इन तीन गुणों से मुक्त (रहित) हो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_040.mp3"},
  {id: "BG_18.41", label: "BG 18.41", ref: "18.41", chapter: 18, verse: 41, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ब्राह्मणक्षत्रियविशां शूद्राणां च परंतप", snippet: "Of Brahmanas, Kshatriyas, Vaisyas, and Sudras, O Arjuna, the duties are distributed according to the qualities born of their own nature.", sanskrit: "ब्राह्मणक्षत्रियविशां शूद्राणां च परंतप ।\nकर्माणि प्रविभक्तानि स्वभावप्रभवैर्गुणैः ॥", iast: "brāhmaṇakṣatriyaviśāṃ śūdrāṇāṃ ca paraṃtapa |\nkarmāṇi pravibhaktāni svabhāvaprabhavairguṇaiḥ ||", transliteration: "brāhmaṇa-kṣhatriya-viśhāṁ śhūdrāṇāṁ cha parantapa\nkarmāṇi pravibhaktāni svabhāva-prabhavair guṇaiḥ", translation_en: "Of Brahmanas, Kshatriyas, Vaisyas, and Sudras, O Arjuna, the duties are distributed according to the qualities born of their own nature.", translation_hi: "हे परन्तप!  ब्राह्मणों, क्षत्रियों, वैश्यों और शूद्रों के कर्म, स्वभाव से उत्पन्न गुणों के अनुसार विभक्त किये गये हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_041.mp3"},
  {id: "BG_18.42", label: "BG 18.42", ref: "18.42", chapter: 18, verse: 42, speaker: "krishna", canonical: true, meter: "anustubh", sa: "शमो दमस्तपः शौचं क्षान्तिरार्जवमेव च", snippet: "Serenity, self-restraint, austerity, purity, forgiveness, and uprightness, as well as knowledge, realization, and belief in God, are the duties of Brahmanas, born of their own…", sanskrit: "शमो दमस्तपः शौचं क्षान्तिरार्जवमेव च ।\nज्ञानं विज्ञानमास्तिक्यं ब्रह्मकर्म स्वभावजम् ॥", iast: "śamo damastapaḥ śaucaṃ kṣāntirārjavameva ca |\njñānaṃ vijñānamāstikyaṃ brahmakarma svabhāvajam ||", transliteration: "śhamo damas tapaḥ śhauchaṁ kṣhāntir ārjavam eva cha\njñānaṁ vijñānam āstikyaṁ brahma-karma svabhāva-jam", translation_en: "Serenity, self-restraint, austerity, purity, forgiveness, and uprightness, as well as knowledge, realization, and belief in God, are the duties of Brahmanas, born of their own nature.", translation_hi: "शम, दम, तप, शौच, क्षान्ति, आर्जव, ज्ञान, विज्ञान और आस्तिक्य - ये ब्राह्मण के स्वाभाविक कर्म हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_042.mp3"},
  {id: "BG_18.43", label: "BG 18.43", ref: "18.43", chapter: 18, verse: 43, speaker: "krishna", canonical: true, meter: "anustubh", sa: "शौर्यं तेजो धृतिर्दाक्ष्यं युद्धे चाप्यपलायनम्", snippet: "Prowess, splendor, firmness, dexterity, and not fleeing from battle, generosity, and lordliness are the duties of the Kshatriyas, born of their own nature.", sanskrit: "शौर्यं तेजो धृतिर्दाक्ष्यं युद्धे चाप्यपलायनम् ।\nदानमीश्वरभावश्च क्षात्रं कर्म स्वभावजम् ॥", iast: "śauryaṃ tejo dhṛtirdākṣyaṃ yuddhe cāpyapalāyanam |\ndānamīśvarabhāvaśca kṣātraṃ karma svabhāvajam ||", transliteration: "śhauryaṁ tejo dhṛitir dākṣhyaṁ yuddhe chāpy apalāyanam\ndānam īśhvara-bhāvaśh cha kṣhātraṁ karma svabhāva-jam", translation_en: "Prowess, splendor, firmness, dexterity, and not fleeing from battle, generosity, and lordliness are the duties of the Kshatriyas, born of their own nature.", translation_hi: "शौर्य, तेज, धृति, दाक्ष्य (दक्षता), युद्ध से पलायन न करना, दान और ईश्वर भाव (स्वामी भाव) - ये सब क्षत्रिय के स्वाभाविक कर्म हैं।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_043.mp3"},
  {id: "BG_18.44", label: "BG 18.44", ref: "18.44", chapter: 18, verse: 44, speaker: "krishna", canonical: true, meter: "anustubh", sa: "कृषिगौरक्ष्यवाणिज्यं वैश्यकर्म स्वभावजम्", snippet: "Agriculture, cattle-rearing, and trade are the duties of the Vaisya (merchant), born of their own nature; and service is the duty of the Sudra (servant-class), born of their…", sanskrit: "कृषिगौरक्ष्यवाणिज्यं वैश्यकर्म स्वभावजम् ।\nपरिचर्यात्मकं कर्म शूद्रस्यापि स्वभावजम् ॥", iast: "kṛṣigaurakṣyavāṇijyaṃ vaiśyakarma svabhāvajam |\nparicaryātmakaṃ karma śūdrasyāpi svabhāvajam ||", transliteration: "kṛiṣhi-gau-rakṣhya-vāṇijyaṁ vaiśhya-karma svabhāva-jam\nparicharyātmakaṁ karma śhūdrasyāpi svabhāva-jam", translation_en: "Agriculture, cattle-rearing, and trade are the duties of the Vaisya (merchant), born of their own nature; and service is the duty of the Sudra (servant-class), born of their own nature.", translation_hi: "कृषि, गौपालन तथा वाणिज्य - ये वैश्य के स्वाभाविक कर्म हैं, और शूद्र का स्वाभाविक कर्म है परिचर्या अर्थात् सेवा करना।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_044.mp3"},
  {id: "BG_18.45", label: "BG 18.45", ref: "18.45", chapter: 18, verse: 45, speaker: "krishna", canonical: true, meter: "anustubh", sa: "स्वे स्वे कर्मण्यभिरतः संसिद्धिं लभते नरः", snippet: "Each person devoted to their own duty attains perfection. How they attain perfection while being engaged in their own duty, hear now.", sanskrit: "स्वे स्वे कर्मण्यभिरतः संसिद्धिं लभते नरः ।\nस्वकर्मनिरतः सिद्धिं यथा विन्दति तच्छृणु ॥", iast: "sve sve karmaṇyabhirataḥ saṃsiddhiṃ labhate naraḥ |\nsvakarmanirataḥ siddhiṃ yathā vindati tacchṛṇu ||", transliteration: "sve sve karmaṇy abhirataḥ sansiddhiṁ labhate naraḥ\nsva-karma-nirataḥ siddhiṁ yathā vindati tach chhṛiṇu", translation_en: "Each person devoted to their own duty attains perfection. How they attain perfection while being engaged in their own duty, hear now.", translation_hi: "अपने-अपने स्वाभाविक कर्म में अभिरत मनुष्य संसिद्धि को प्राप्त कर लेता है। स्वकर्म में रत मनुष्य किस प्रकार सिद्धि प्राप्त करता है, उसे तुम सुनो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_045.mp3"},
  {id: "BG_18.46", label: "BG 18.46", ref: "18.46", chapter: 18, verse: 46, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यतः प्रवृत्तिर्भूतानां येन सर्वमिदं ततम्", snippet: "He from whom all the beings have evolved and by whom all this is pervaded, worshipping Him with his own duty, one attains perfection.", sanskrit: "यतः प्रवृत्तिर्भूतानां येन सर्वमिदं ततम् ।\nस्वकर्मणा तमभ्यर्च्य सिद्धिं विन्दति मानवः ॥", iast: "yataḥ pravṛttirbhūtānāṃ yena sarvamidaṃ tatam |\nsvakarmaṇā tamabhyarcya siddhiṃ vindati mānavaḥ ||", transliteration: "yataḥ pravṛittir bhūtānāṁ yena sarvam idaṁ tatam\nsva-karmaṇā tam abhyarchya siddhiṁ vindati mānavaḥ", translation_en: "He from whom all the beings have evolved and by whom all this is pervaded, worshipping Him with his own duty, one attains perfection.", translation_hi: "जिस (परमात्मा) से भूतमात्र की प्रवृत्ति अर्थात् उत्पत्ति हुई है और जिससे यह सम्पूर्ण जगत् व्याप्त है, उस (परमात्मा) की स्वकर्म द्वारा पूजा करके मनुष्य सिद्धि को प्राप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_046.mp3"},
  {id: "BG_18.47", label: "BG 18.47", ref: "18.47", chapter: 18, verse: 47, speaker: "krishna", canonical: true, meter: "anustubh", sa: "श्रेयान्स्वधर्मो विगुणः परधर्मात्स्वनुष्ठितात्", snippet: "Better is one's own duty, even if it is destitute of merits, than the duty of another well performed. He who does the duty ordained by his own nature incurs no sin.", sanskrit: "श्रेयान्स्वधर्मो विगुणः परधर्मात्स्वनुष्ठितात् ।\nस्वभावनियतं कर्म कुर्वन्नाप्नोति किल्बिषम् ॥", iast: "śreyānsvadharmo viguṇaḥ paradharmātsvanuṣṭhitāt |\nsvabhāvaniyataṃ karma kurvannāpnoti kilbiṣam ||", transliteration: "śhreyān swa-dharmo viguṇaḥ para-dharmāt sv-anuṣhṭhitāt\nsvabhāva-niyataṁ karma kurvan nāpnoti kilbiṣham", translation_en: "Better is one's own duty, even if it is destitute of merits, than the duty of another well performed. He who does the duty ordained by his own nature incurs no sin.", translation_hi: "सम्यक् अनुष्ठित परधर्म की अपेक्षा गुणरहित स्वधर्म श्रेष्ठ है। (क्योंकि) स्वभाव से नियत किये गये कर्म को करते हुए मनुष्य पाप को नहीं प्राप्त करता।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_047.mp3"},
  {id: "BG_18.48", label: "BG 18.48", ref: "18.48", chapter: 18, verse: 48, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सहजं कर्म कौन्तेय सदोषमपि न त्यजेत्", snippet: "One should not, O Arjuna, abandon the duty to which one is born, though it may be faulty; for, all undertakings are enveloped by evil, just as fire is by smoke.", sanskrit: "सहजं कर्म कौन्तेय सदोषमपि न त्यजेत् ।\nसर्वारम्भा हि दोषेण धूमेनाग्निरिवावृताः ॥", iast: "sahajaṃ karma kaunteya sadoṣamapi na tyajet |\nsarvārambhā hi doṣeṇa dhūmenāgnirivāvṛtāḥ ||", transliteration: "saha-jaṁ karma kaunteya sa-doṣham api na tyajet\nsarvārambhā hi doṣheṇa dhūmenāgnir ivāvṛitāḥ", translation_en: "One should not, O Arjuna, abandon the duty to which one is born, though it may be faulty; for, all undertakings are enveloped by evil, just as fire is by smoke.", translation_hi: "हे कौन्तेय ! दोषयुक्त होने पर भी सहज कर्म को नहीं त्यागना चाहिए; क्योंकि सभी कर्म दोष से आवृत होते है, जैसे धुयें से अग्नि।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_048.mp3"},
  {id: "BG_18.49", label: "BG 18.49", ref: "18.49", chapter: 18, verse: 49, speaker: "krishna", canonical: true, meter: "anustubh", sa: "असक्तबुद्धिः सर्वत्र जितात्मा विगतस्पृहः", snippet: "He whose intellect is unattached everywhere, who has subdued his self, from whom desire has fled, he attains the supreme state of freedom from action through renunciation.", sanskrit: "असक्तबुद्धिः सर्वत्र जितात्मा विगतस्पृहः ।\nनैष्कर्म्यसिद्धिं परमां संन्यासेनाधिगच्छति ॥", iast: "asaktabuddhiḥ sarvatra jitātmā vigataspṛhaḥ |\nnaiṣkarmyasiddhiṃ paramāṃ saṃnyāsenādhigacchati ||", transliteration: "asakta-buddhiḥ sarvatra jitātmā vigata-spṛihaḥ\nnaiṣhkarmya-siddhiṁ paramāṁ sannyāsenādhigachchhati", translation_en: "He whose intellect is unattached everywhere, who has subdued his self, from whom desire has fled, he attains the supreme state of freedom from action through renunciation.", translation_hi: "सर्वत्र आसक्ति रहित बुद्धि वाला वह पुरुष जो स्पृहारहित तथा जितात्मा है, संन्यास के द्वारा परम नैर्ष्कम्य सिद्धि को प्राप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_049.mp3"},
  {id: "BG_18.50", label: "BG 18.50", ref: "18.50", chapter: 18, verse: 50, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सिद्धिं प्राप्तो यथा ब्रह्म तथाप्नोति निबोध मे", snippet: "Learn from Me, O Arjuna, in brief how one who has attained perfection reaches Brahman—the Eternal, that supreme state of knowledge.", sanskrit: "सिद्धिं प्राप्तो यथा ब्रह्म तथाप्नोति निबोध मे ।\nसमासेनैव कौन्तेय निष्ठा ज्ञानस्य या परा ॥", iast: "siddhiṃ prāpto yathā brahma tathāpnoti nibodha me |\nsamāsenaiva kaunteya niṣṭhā jñānasya yā parā ||", transliteration: "siddhiṁ prāpto yathā brahma tathāpnoti nibodha me\nsamāsenaiva kaunteya niṣhṭhā jñānasya yā parā", translation_en: "Learn from Me, O Arjuna, in brief how one who has attained perfection reaches Brahman—the Eternal, that supreme state of knowledge.", translation_hi: "सिद्धि को प्राप्त पुरुष किस प्रकार ब्रह्म को प्राप्त होता है, तथा ज्ञान की परा निष्ठा को भी तुम मुझसे संक्षेप में जानो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_050.mp3"},
  {id: "BG_18.51", label: "BG 18.51", ref: "18.51", chapter: 18, verse: 51, speaker: "krishna", canonical: true, meter: "anustubh", sa: "बुद्ध्या विशुद्धया युक्तो धृत्याऽऽत्मानं नियम्य च", snippet: "Endowed with a pure intellect, controlling the self through firmness, relinquishing sound and other objects and abandoning attraction and hatred.", sanskrit: "बुद्ध्या विशुद्धया युक्तो धृत्याऽऽत्मानं नियम्य च ।\nशब्दादीन् विषयांस्त्यक्त्वा रागद्वेषौ व्युदस्य च ॥", iast: "buddhyā viśuddhayā yukto dhṛtyā’’tmānaṃ niyamya ca |\nśabdādīn viṣayāṃstyaktvā rāgadveṣau vyudasya ca ||", transliteration: "buddhyā viśhuddhayā yukto dhṛityātmānaṁ niyamya cha\nśhabdādīn viṣhayāns tyaktvā rāga-dveṣhau vyudasya cha", translation_en: "Endowed with a pure intellect, controlling the self through firmness, relinquishing sound and other objects and abandoning attraction and hatred.", translation_hi: "विशुद्ध बुद्धि से युक्त, धृति से आत्मसंयम कर, शब्दादि विषयों को त्याग कर और राग-द्वेष का परित्याग कर....৷৷৷৷।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_051.mp3"},
  {id: "BG_18.52", label: "BG 18.52", ref: "18.52", chapter: 18, verse: 52, speaker: "krishna", canonical: true, meter: "anustubh", sa: "विविक्तसेवी लघ्वाशी यतवाक्कायमानसः", snippet: "Dwelling in solitude, eating sparingly, with speech, body, and mind subdued, always engaged in meditation and concentration, and resorting to dispassion.", sanskrit: "विविक्तसेवी लघ्वाशी यतवाक्कायमानसः ।\nध्यानयोगपरो नित्यं वैराग्यं समुपाश्रितः ॥", iast: "viviktasevī laghvāśī yatavākkāyamānasaḥ |\ndhyānayogaparo nityaṃ vairāgyaṃ samupāśritaḥ ||", transliteration: "vivikta-sevī laghv-āśhī yata-vāk-kāya-mānasaḥ\ndhyāna-yoga-paro nityaṁ vairāgyaṁ samupāśhritaḥ", translation_en: "Dwelling in solitude, eating sparingly, with speech, body, and mind subdued, always engaged in meditation and concentration, and resorting to dispassion.", translation_hi: "विविक्त सेवी, लघ्वाशी (मिताहारी) जिसने अपने शरीर, वाणी और मन को संयत किया है, ध्यानयोग के अभ्यास में सदैव तत्पर तथा वैराग्य पर समाश्रित।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_052.mp3"},
  {id: "BG_18.53", label: "BG 18.53", ref: "18.53", chapter: 18, verse: 53, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अहङ्कारं बलं दर्पं कामं क्रोधं परिग्रहम्", snippet: "Having abandoned egoism, strength, arrogance, desire, anger, and covetousness, and being free from the notion of 'mine' and peaceful, he is fit for becoming Brahman.", sanskrit: "अहङ्कारं बलं दर्पं कामं क्रोधं परिग्रहम् ।\nविमुच्य निर्ममः शान्तो ब्रह्मभूयाय कल्पते ॥", iast: "ahaṅkāraṃ balaṃ darpaṃ kāmaṃ krodhaṃ parigraham |\nvimucya nirmamaḥ śānto brahmabhūyāya kalpate ||", transliteration: "ahankāraṁ balaṁ darpaṁ kāmaṁ krodhaṁ parigraham\nvimuchya nirmamaḥ śhānto brahma-bhūyāya kalpate", translation_en: "Having abandoned egoism, strength, arrogance, desire, anger, and covetousness, and being free from the notion of 'mine' and peaceful, he is fit for becoming Brahman.", translation_hi: "अहंकार, बल, दर्प, काम, क्रोध और परिग्रह को त्याग कर ममत्वभाव से रहित और शान्त पुरुष ब्रह्म प्राप्ति के योग्य बन जाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_053.mp3"},
  {id: "BG_18.54", label: "BG 18.54", ref: "18.54", chapter: 18, verse: 54, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ब्रह्मभूतः प्रसन्नात्मा न शोचति न काङ्क्षति", snippet: "Becoming Brahman, serene in the Self, he neither grieves nor desires; he is the same to all beings, and obtains supreme devotion to Me.", sanskrit: "ब्रह्मभूतः प्रसन्नात्मा न शोचति न काङ्क्षति ।\nसमः सर्वेषु भूतेषु मद्भक्तिं लभते पराम् ॥", iast: "brahmabhūtaḥ prasannātmā na śocati na kāṅkṣati |\nsamaḥ sarveṣu bhūteṣu madbhaktiṃ labhate parām ||", transliteration: "brahma-bhūtaḥ prasannātmā na śhochati na kāṅkṣhati\nsamaḥ sarveṣhu bhūteṣhu mad-bhaktiṁ labhate parām", translation_en: "Becoming Brahman, serene in the Self, he neither grieves nor desires; he is the same to all beings, and obtains supreme devotion to Me.", translation_hi: "ब्रह्मभूत (जो साधक ब्रह्म बन गया है), प्रसन्न मन वाला पुरुष न इच्छा करता है और न शोक, समस्त भूतों के प्रति सम होकर वह मेरी परा भक्ति को प्राप्त करता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_054.mp3"},
  {id: "BG_18.55", label: "BG 18.55", ref: "18.55", chapter: 18, verse: 55, speaker: "krishna", canonical: true, meter: "anustubh", sa: "भक्त्या मामभिजानाति यावान्यश्चास्मि तत्त्वतः", snippet: "By devotion, he knows Me in truth, who and what I am; then, having known Me in truth, he immediately enters into the Supreme.", sanskrit: "भक्त्या मामभिजानाति यावान्यश्चास्मि तत्त्वतः ।\nततो मां तत्त्वतो ज्ञात्वा विशते तदनन्तरम् ॥", iast: "bhaktyā māmabhijānāti yāvānyaścāsmi tattvataḥ |\ntato māṃ tattvato jñātvā viśate tadanantaram ||", transliteration: "bhaktyā mām abhijānāti yāvān yaśh chāsmi tattvataḥ\ntato māṁ tattvato jñātvā viśhate tad-anantaram", translation_en: "By devotion, he knows Me in truth, who and what I am; then, having known Me in truth, he immediately enters into the Supreme.", translation_hi: "(उस परा) भक्ति के द्वारा मुझे वह तत्त्वत: जानता है कि मैं कितना (व्यापक) हूँ तथा मैं क्या हूँ। (इस प्रकार) तत्त्वत: जानने के पश्चात् तत्काल ही वह मुझमें प्रवेश कर जाता है, अर्थात् मत्स्वरूप बन जाता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_055.mp3"},
  {id: "BG_18.56", label: "BG 18.56", ref: "18.56", chapter: 18, verse: 56, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सर्वकर्माण्यपि सदा कुर्वाणो मद्व्यपाश्रयः", snippet: "Having taken refuge in Me and doing all actions, by My grace he obtains the eternal, indestructible state of being.", sanskrit: "सर्वकर्माण्यपि सदा कुर्वाणो मद्व्यपाश्रयः ।\nमत्प्रसादादवाप्नोति शाश्वतं पदमव्ययम् ॥", iast: "sarvakarmāṇyapi sadā kurvāṇo madvyapāśrayaḥ |\nmatprasādādavāpnoti śāśvataṃ padamavyayam ||", transliteration: "sarva-karmāṇy api sadā kurvāṇo mad-vyapāśhrayaḥ\nmat-prasādād avāpnoti śhāśhvataṁ padam avyayam", translation_en: "Having taken refuge in Me and doing all actions, by My grace he obtains the eternal, indestructible state of being.", translation_hi: "जो पुरुष मदाश्रित होकर सदैव समस्त कर्मों को करता है, वह मेरे प्रसाद (अनुग्रह) से शाश्वत, अव्यय पद को प्राप्त कर लेता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_056.mp3"},
  {id: "BG_18.57", label: "BG 18.57", ref: "18.57", chapter: 18, verse: 57, speaker: "krishna", canonical: true, meter: "anustubh", sa: "चेतसा सर्वकर्माणि मयि संन्यस्य मत्परः", snippet: "Mentally renouncing all actions in Me, having Me as the highest goal, and resorting to the yoga of discrimination, do thou ever fix thy mind on Me.", sanskrit: "चेतसा सर्वकर्माणि मयि संन्यस्य मत्परः ।\nबुद्धियोगमुपाश्रित्य मच्चित्तः सततं भव ॥", iast: "cetasā sarvakarmāṇi mayi saṃnyasya matparaḥ |\nbuddhiyogamupāśritya maccittaḥ satataṃ bhava ||", transliteration: "chetasā sarva-karmāṇi mayi sannyasya mat-paraḥ\nbuddhi-yogam upāśhritya mach-chittaḥ satataṁ bhava", translation_en: "Mentally renouncing all actions in Me, having Me as the highest goal, and resorting to the yoga of discrimination, do thou ever fix thy mind on Me.", translation_hi: "मन से समस्त कर्मों का संन्यास मुझमें करके मत्परायण होकर बुद्धियोग का आश्रय लेकर तुम सतत मच्चित्त बनो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_057.mp3"},
  {id: "BG_18.58", label: "BG 18.58", ref: "18.58", chapter: 18, verse: 58, speaker: "krishna", canonical: true, meter: "anustubh", sa: "मच्चित्तः सर्वदुर्गाणि मत्प्रसादात्तरिष्यसि", snippet: "Fixing your mind on Me, you shall, by My grace, overcome all obstacles; but if you will not hear Me due to egoism, you shall perish.", sanskrit: "मच्चित्तः सर्वदुर्गाणि मत्प्रसादात्तरिष्यसि ।\nअथ चेत्त्वमहङ्कारान्न श्रोष्यसि विनङ्क्ष्यसि ॥", iast: "maccittaḥ sarvadurgāṇi matprasādāttariṣyasi |\natha cettvamahaṅkārānna śroṣyasi vinaṅkṣyasi ||", transliteration: "mach-chittaḥ sarva-durgāṇi mat-prasādāt tariṣhyasi\natha chet tvam ahankārān na śhroṣhyasi vinaṅkṣhyasi", translation_en: "Fixing your mind on Me, you shall, by My grace, overcome all obstacles; but if you will not hear Me due to egoism, you shall perish.", translation_hi: "मच्चित्त होकर तुम मेरी कृपा से समस्त कठिनाइयों (सर्वदुर्गाणि) को पार कर जाओगे; और यदि अहंकारवश (इस उपदेश को) नहीं सुनोगे, तो तुम नष्ट हो जाओगे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_058.mp3"},
  {id: "BG_18.59", label: "BG 18.59", ref: "18.59", chapter: 18, verse: 59, speaker: "krishna", canonical: true, meter: "anustubh", sa: "यदहङ्कारमाश्रित्य न योत्स्य इति मन्यसे", snippet: "If, filled with egoism, thou thinkest, \"I will not fight,\" then thy resolve is vain; nature will compel thee.", sanskrit: "यदहङ्कारमाश्रित्य न योत्स्य इति मन्यसे ।\nमिथ्यैष व्यवसायस्ते प्रकृतिस्त्वां नियोक्ष्यति ॥", iast: "yadahaṅkāramāśritya na yotsya iti manyase |\nmithyaiṣa vyavasāyaste prakṛtistvāṃ niyokṣyati ||", transliteration: "yad ahankāram āśhritya na yotsya iti manyase\nmithyaiṣha vyavasāyas te prakṛitis tvāṁ niyokṣhyati", translation_en: "If, filled with egoism, thou thinkest, \"I will not fight,\" then thy resolve is vain; nature will compel thee.", translation_hi: "और अहंकारवश तुम जो यह सोच रहे हो, \"मैं युद्ध नहीं करूंगा\", यह तुम्हारा निश्चय मिथ्या है, (क्योंकि) प्रकृति (तुम्हारा स्वभाव) ही तुम्हें (बलात् कर्म में) प्रवृत्त करेगी।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_059.mp3"},
  {id: "BG_18.60", label: "BG 18.60", ref: "18.60", chapter: 18, verse: 60, speaker: "krishna", canonical: true, meter: "anustubh", sa: "स्वभावजेन कौन्तेय निबद्धः स्वेन कर्मणा", snippet: "O Arjuna, bound by your own Karma (action) born of your own nature, that which from delusion you wish not to do, even that you shall do helplessly.", sanskrit: "स्वभावजेन कौन्तेय निबद्धः स्वेन कर्मणा ।\nकर्तुं नेच्छसि यन्मोहात्करिष्यस्यवशोऽपि तत् ॥", iast: "svabhāvajena kaunteya nibaddhaḥ svena karmaṇā |\nkartuṃ necchasi yanmohātkariṣyasyavaśo’pi tat ||", transliteration: "swbhāva-jena kaunteya nibaddhaḥ svena karmaṇā\nkartuṁ nechchhasi yan mohāt kariṣhyasy avaśho ’pi tat", translation_en: "O Arjuna, bound by your own Karma (action) born of your own nature, that which from delusion you wish not to do, even that you shall do helplessly.", translation_hi: "हे कौन्तेय ! तुम अपने स्वाभाविक कर्मों से बंधे हो, (अत:) मोहवशात् जिस कर्म को तुम करना नहीं चाहते हो, वही तुम विवश होकर करोगे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_060.mp3"},
  {id: "BG_18.61", label: "BG 18.61", ref: "18.61", chapter: 18, verse: 61, speaker: "krishna", canonical: true, meter: "anustubh", sa: "ईश्वरः सर्वभूतानां हृद्देशेऽर्जुन तिष्ठति", snippet: "The Lord dwells in the hearts of all beings, O Arjuna, causing all beings, by His illusory power, to revolve as if mounted on a machine.", sanskrit: "ईश्वरः सर्वभूतानां हृद्देशेऽर्जुन तिष्ठति ।\nभ्रामयन्सर्वभूतानि यन्त्रारूढानि मायया ॥", iast: "īśvaraḥ sarvabhūtānāṃ hṛddeśe’rjuna tiṣṭhati |\nbhrāmayansarvabhūtāni yantrārūḍhāni māyayā ||", transliteration: "īśhvaraḥ sarva-bhūtānāṁ hṛid-deśhe ‘rjuna tiṣhṭhati\nbhrāmayan sarva-bhūtāni yantrārūḍhāni māyayā", translation_en: "The Lord dwells in the hearts of all beings, O Arjuna, causing all beings, by His illusory power, to revolve as if mounted on a machine.", translation_hi: "हे अर्जुन (मानों किसी) यन्त्र पर आरूढ़ समस्त भूतों को ईश्वर अपनी माया से घुमाता हुआ (भ्रामयन्) भूतमात्र के हृदय में स्थित रहता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_061.mp3"},
  {id: "BG_18.62", label: "BG 18.62", ref: "18.62", chapter: 18, verse: 62, speaker: "krishna", canonical: true, meter: "anustubh", sa: "तमेव शरणं गच्छ सर्वभावेन भारत", snippet: "Fly to Him for refuge with all your being, O Arjuna; by His grace you will obtain supreme peace and the eternal abode.", sanskrit: "तमेव शरणं गच्छ सर्वभावेन भारत ।\nतत्प्रसादात्परां शान्तिं स्थानं प्राप्स्यसि शाश्वतम् ॥", iast: "tameva śaraṇaṃ gaccha sarvabhāvena bhārata |\ntatprasādātparāṃ śāntiṃ sthānaṃ prāpsyasi śāśvatam ||", transliteration: "tam eva śharaṇaṁ gachchha sarva-bhāvena bhārata\ntat-prasādāt parāṁ śhāntiṁ sthānaṁ prāpsyasi śhāśhvatam", translation_en: "Fly to Him for refuge with all your being, O Arjuna; by His grace you will obtain supreme peace and the eternal abode.", translation_hi: "हे भारत ! तुम सम्पूर्ण भाव से उसी (ईश्वर) की शरण में जाओ। उसके प्रसाद से तुम परम शान्ति और शाश्वत स्थान को प्राप्त करोगे।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_062.mp3"},
  {id: "BG_18.63", label: "BG 18.63", ref: "18.63", chapter: 18, verse: 63, speaker: "krishna", canonical: true, meter: "anustubh", sa: "इति ते ज्ञानमाख्यातं गुह्याद्गुह्यतरं मया", snippet: "Thus, wisdom more secret than secrecy itself has been declared to you by me. Reflect on it fully, then act as you wish.", sanskrit: "इति ते ज्ञानमाख्यातं गुह्याद्गुह्यतरं मया ।\nविमृश्यैतदशेषेण यथेच्छसि तथा कुरु ॥", iast: "iti te jñānamākhyātaṃ guhyādguhyataraṃ mayā |\nvimṛśyaitadaśeṣeṇa yathecchasi tathā kuru ||", transliteration: "iti te jñānam ākhyātaṁ guhyād guhyataraṁ mayā\nvimṛiśhyaitad aśheṣheṇa yathechchhasi tathā kuru", translation_en: "Thus, wisdom more secret than secrecy itself has been declared to you by me. Reflect on it fully, then act as you wish.", translation_hi: "इस प्रकार समस्त गोपनीयों से अधिक गुह्य ज्ञान मैंने तुमसे कहा; इस पर पूर्ण विचार (विमृश्य) करने के पश्चात् तुम्हारी जैसी इच्छा हो, वैसा तुम करो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_063.mp3"},
  {id: "BG_18.64", label: "BG 18.64", ref: "18.64", chapter: 18, verse: 64, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सर्वगुह्यतमं भूयः श्रृणु मे परमं वचः", snippet: "Hear again My supreme word, most secret of all; for you are dearly beloved of Me, I will tell you what is good.", sanskrit: "सर्वगुह्यतमं भूयः श्रृणु मे परमं वचः ।\nइष्टोऽसि मे दृढमिति ततो वक्ष्यामि ते हितम् ॥", iast: "sarvaguhyatamaṃ bhūyaḥ śrṛṇu me paramaṃ vacaḥ |\niṣṭo’si me dṛḍhamiti tato vakṣyāmi te hitam ||", transliteration: "sarva-guhyatamaṁ bhūyaḥ śhṛiṇu me paramaṁ vachaḥ\niṣhṭo ‘si me dṛiḍham iti tato vakṣhyāmi te hitam", translation_en: "Hear again My supreme word, most secret of all; for you are dearly beloved of Me, I will tell you what is good.", translation_hi: "पुन: एक बार तुम मुझसे समस्त गुह्यों में गुह्यतम परम वचन (उपदेश) को सुनो। तुम मुझे अतिशय प्रिय हो, इसलिए मैं तुम्हें तुम्हारे हित की बात कहूंगा।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_064.mp3"},
  {id: "BG_18.65", label: "BG 18.65", ref: "18.65", chapter: 18, verse: 65, speaker: "krishna", canonical: true, meter: "anustubh", sa: "मन्मना भव मद्भक्तो मद्याजी मां नमस्कुरु", snippet: "Fix your mind on Me, be devoted to Me, sacrifice to Me, bow down to Me. You will come to Me; I truly promise you this, for you are dear to Me.", sanskrit: "मन्मना भव मद्भक्तो मद्याजी मां नमस्कुरु ।\nमामेवैष्यसि सत्यं ते प्रतिजाने प्रियोऽसि मे ॥", iast: "manmanā bhava madbhakto madyājī māṃ namaskuru |\nmāmevaiṣyasi satyaṃ te pratijāne priyo’si me ||", transliteration: "man-manā bhava mad-bhakto mad-yājī māṁ namaskuru\nmām evaiṣhyasi satyaṁ te pratijāne priyo ‘si me", translation_en: "Fix your mind on Me, be devoted to Me, sacrifice to Me, bow down to Me. You will come to Me; I truly promise you this, for you are dear to Me.", translation_hi: "तुम मच्चित, मद्भक्त और मेरे पूजक (मद्याजी) बनो और मुझे नमस्कार करो; (इस प्रकार) तुम मुझे ही प्राप्त होगे; यह मैं तुम्हे सत्य वचन देता हूँ,(क्योंकि) तुम मेरे प्रिय हो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_065.mp3"},
  {id: "BG_18.66", label: "BG 18.66", ref: "18.66", chapter: 18, verse: 66, speaker: "krishna", canonical: true, meter: "anustubh", sa: "सर्वधर्मान्परित्यज्य मामेकं शरणं व्रज", snippet: "Abandon all duties and take refuge in Me alone; I will liberate you from all sins; do not grieve.", sanskrit: "सर्वधर्मान्परित्यज्य मामेकं शरणं व्रज ।\nअहं त्वा सर्वपापेभ्यो मोक्षयिष्यामि मा शुचः ॥", iast: "sarvadharmānparityajya māmekaṃ śaraṇaṃ vraja |\nahaṃ tvā sarvapāpebhyo mokṣayiṣyāmi mā śucaḥ ||", transliteration: "sarva-dharmān parityajya mām ekaṁ śharaṇaṁ vraja\nahaṁ tvāṁ sarva-pāpebhyo mokṣhayiṣhyāmi mā śhuchaḥ", translation_en: "Abandon all duties and take refuge in Me alone; I will liberate you from all sins; do not grieve.", translation_hi: "सब धर्मों का परित्याग करके तुम एक मेरी ही शरण में आओ, मैं तुम्हें समस्त पापों से मुक्त कर दूँगा, तुम शोक मत करो।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_066.mp3"},
  {id: "BG_18.67", label: "BG 18.67", ref: "18.67", chapter: 18, verse: 67, speaker: "krishna", canonical: true, meter: "anustubh", sa: "इदं ते नातपस्काय नाभक्ताय कदाचन", snippet: "Never speak this to one who is devoid of austerities or devotion, who does not render service, who does not desire to listen, or who cavils at Me.", sanskrit: "इदं ते नातपस्काय नाभक्ताय कदाचन ।\nन चाशुश्रूषवे वाच्यं न च मां योऽभ्यसूयति ॥", iast: "idaṃ te nātapaskāya nābhaktāya kadācana |\nna cāśuśrūṣave vācyaṃ na ca māṃ yo’bhyasūyati ||", transliteration: "idaṁ te nātapaskyāya nābhaktāya kadāchana\nna chāśhuśhruṣhave vāchyaṁ na cha māṁ yo ‘bhyasūtayi", translation_en: "Never speak this to one who is devoid of austerities or devotion, who does not render service, who does not desire to listen, or who cavils at Me.", translation_hi: "यह ज्ञान ऐसे पुरुष से नहीं कहना चाहिए, जो अतपस्क (तपरहित) है, और न उसे जो अभक्त है; उसे भी नहीं जो अशुश्रुषु (सेवा में अतत्पर) है और उस पुरुष से भी नहीं कहना चाहिए, जो मुझ (ईश्वर) से असूया करता है, अर्थात् मुझ में दोष देखता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_067.mp3"},
  {id: "BG_18.68", label: "BG 18.68", ref: "18.68", chapter: 18, verse: 68, speaker: "krishna", canonical: true, meter: "anustubh", sa: "य इमं परमं गुह्यं मद्भक्तेष्वभिधास्यति", snippet: "He who, with supreme devotion to Me, teaches this supreme secret to My devotees, shall undoubtedly come to Me.", sanskrit: "य इमं परमं गुह्यं मद्भक्तेष्वभिधास्यति ।\nभक्तिं मयि परां कृत्वा मामेवैष्यत्यसंशयः ॥", iast: "ya imaṃ paramaṃ guhyaṃ madbhakteṣvabhidhāsyati |\nbhaktiṃ mayi parāṃ kṛtvā māmevaiṣyatyasaṃśayaḥ ||", transliteration: "ya idaṁ paramaṁ guhyaṁ mad-bhakteṣhv abhidhāsyati\nbhaktiṁ mayi parāṁ kṛitvā mām evaiṣhyaty asanśhayaḥ", translation_en: "He who, with supreme devotion to Me, teaches this supreme secret to My devotees, shall undoubtedly come to Me.", translation_hi: "जो पुरुष मुझसे परम प्रेम (परा भक्ति) करके इस परम गुह्य ज्ञान का उपदेश मेरे भक्तों को देता है, वह नि:सन्देह मुझे ही प्राप्त होता है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_068.mp3"},
  {id: "BG_18.69", label: "BG 18.69", ref: "18.69", chapter: 18, verse: 69, speaker: "krishna", canonical: true, meter: "anustubh", sa: "न च तस्मान्मनुष्येषु कश्चिन्मे प्रियकृत्तमः", snippet: "There is no one among men who does service dearer to Me, nor shall there be anyone on earth dearer to Me than him.", sanskrit: "न च तस्मान्मनुष्येषु कश्चिन्मे प्रियकृत्तमः ।\nभविता न च मे तस्मादन्यः प्रियतरो भुवि ॥", iast: "na ca tasmānmanuṣyeṣu kaścinme priyakṛttamaḥ |\nbhavitā na ca me tasmādanyaḥ priyataro bhuvi ||", transliteration: "na cha tasmān manuṣhyeṣhu kaśhchin me priya-kṛittamaḥ\nbhavitā na cha me tasmād anyaḥ priyataro bhuvi", translation_en: "There is no one among men who does service dearer to Me, nor shall there be anyone on earth dearer to Me than him.", translation_hi: "न तो उससे बढ़कर मेरा अतिशय प्रिय कार्य करने वाला मनुष्यों में कोई है और न उससे बढ़कर मेरा प्रिय इस पृथ्वी पर दूसरा कोई होगा।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_069.mp3"},
  {id: "BG_18.70", label: "BG 18.70", ref: "18.70", chapter: 18, verse: 70, speaker: "krishna", canonical: true, meter: "anustubh", sa: "अध्येष्यते च य इमं धर्म्यं संवादमावयोः", snippet: "And he who studies this sacred dialogue of ours, by him I shall have been worshipped through the sacrifice of wisdom; such is my conviction.", sanskrit: "अध्येष्यते च य इमं धर्म्यं संवादमावयोः ।\nज्ञानयज्ञेन तेनाहमिष्टः स्यामिति मे मतिः ॥", iast: "adhyeṣyate ca ya imaṃ dharmyaṃ saṃvādamāvayoḥ |\njñānayajñena tenāhamiṣṭaḥ syāmiti me matiḥ ||", transliteration: "adhyeṣhyate cha ya imaṁ dharmyaṁ saṁvādam āvayoḥ\njñāna-yajñena tenāham iṣhṭaḥ syām iti me matiḥ", translation_en: "And he who studies this sacred dialogue of ours, by him I shall have been worshipped through the sacrifice of wisdom; such is my conviction.", translation_hi: "जो पुरुष, हम दोनों के इस धर्ममय संवाद का पठन करेगा, उसके द्वारा मैं ज्ञानयज्ञ से पूजित होऊँगा - ऐसा मेरा मत है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_070.mp3"},
  {id: "BG_18.71", label: "BG 18.71", ref: "18.71", chapter: 18, verse: 71, speaker: "krishna", canonical: true, meter: "anustubh", sa: "श्रद्धावाननसूयश्च श्रृणुयादपि यो नरः", snippet: "Also, the man who hears this, full of faith and free from malice, shall attain to the happy worlds of those of righteous deeds, and be liberated.", sanskrit: "श्रद्धावाननसूयश्च श्रृणुयादपि यो नरः ।\nसोऽपि मुक्तः शुभाँल्लोकान्प्राप्नुयात्पुण्यकर्मणाम् ॥", iast: "śraddhāvānanasūyaśca śrṛṇuyādapi yo naraḥ |\nso’pi muktaḥ śubhām̐llokānprāpnuyātpuṇyakarmaṇām ||", transliteration: "śhraddhāvān anasūyaśh cha śhṛiṇuyād api yo naraḥ\nso ‘pi muktaḥ śhubhāl lokān prāpnuyāt puṇya-karmaṇām", translation_en: "Also, the man who hears this, full of faith and free from malice, shall attain to the happy worlds of those of righteous deeds, and be liberated.", translation_hi: "तथा जो श्रद्धावान् और अनसुयु (दोषदृष्टि रहित) पुरुष इसका श्रवणमात्र भी करेगा, वह भी (पापों से) मुक्त होकर पुण्यकर्मियों के शुभ (श्रेष्ठ) लोकों को प्राप्त कर लेगा।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_071.mp3"},
  {id: "BG_18.72", label: "BG 18.72", ref: "18.72", chapter: 18, verse: 72, speaker: "krishna", canonical: true, meter: "anustubh", sa: "कच्चिदेतच्छ्रुतं पार्थ त्वयैकाग्रेण चेतसा", snippet: "Has this been heard, O Arjuna, with one-pointed focus? Has the delusion of your ignorance been destroyed, O Dhananjaya?", sanskrit: "कच्चिदेतच्छ्रुतं पार्थ त्वयैकाग्रेण चेतसा ।\nकच्चिदज्ञानसंमोहः प्रनष्टस्ते धनञ्जय ॥", iast: "kaccidetacchrutaṃ pārtha tvayaikāgreṇa cetasā |\nkaccidajñānasaṃmohaḥ pranaṣṭaste dhanañjaya ||", transliteration: "kachchid etach chhrutaṁ pārtha tvayaikāgreṇa chetasā\nkachchid ajñāna-sammohaḥ pranaṣhṭas te dhanañjaya", translation_en: "Has this been heard, O Arjuna, with one-pointed focus? Has the delusion of your ignorance been destroyed, O Dhananjaya?", translation_hi: "हे पार्थ ! क्या इसे (मेरे उपदेश को) तुमने एकाग्रचित्त होकर श्रवण किया ? और हे धनञ्जय ! क्या तुम्हारा अज्ञान जनित संमोह पूर्णतया नष्ट हुआ ?", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_072.mp3"},
  {id: "BG_18.73", label: "BG 18.73", ref: "18.73", chapter: 18, verse: 73, speaker: "arjuna", canonical: true, meter: "anustubh", sa: "नष्टो मोहः स्मृतिर्लब्धा त्वत्प्रसादान्मयाच्युत", snippet: "Arjuna said, \"My delusion has been destroyed, for I have gained my knowledge (memory) through Your grace, O Krishna. I am now free from doubts. I will act according to Your word.\"", sanskrit: "नष्टो मोहः स्मृतिर्लब्धा त्वत्प्रसादान्मयाच्युत ।\nस्थितोऽस्मि गतसन्देहः करिष्ये वचनं तव ॥", iast: "naṣṭo mohaḥ smṛtirlabdhā tvatprasādānmayācyuta |\nsthito’smi gatasandehaḥ kariṣye vacanaṃ tava ||", transliteration: "naṣhṭo mohaḥ smṛitir labdhā tvat-prasādān mayāchyuta\nsthito ‘smi gata-sandehaḥ kariṣhye vachanaṁ tava", translation_en: "Arjuna said, \"My delusion has been destroyed, for I have gained my knowledge (memory) through Your grace, O Krishna. I am now free from doubts. I will act according to Your word.\"", translation_hi: "अर्जुन ने कहा -- हे अच्युत ! आपके कृपाप्रसाद से मेरा मोह नष्ट हो गया है, और मुझे स्मृति (ज्ञान) प्राप्त हो गयी है? अब मैं संशयरहित हो गया हूँ और मैं आपके वचन (आज्ञा) का पालन करूँगा।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_073.mp3"},
  {id: "BG_18.74", label: "BG 18.74", ref: "18.74", chapter: 18, verse: 74, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "इत्यहं वासुदेवस्य पार्थस्य च महात्मनः", snippet: "Sanjaya said, Thus, I have heard this wonderful dialogue between Krishna and the high-souled Arjuna, which causes one's hair to stand on end.", sanskrit: "इत्यहं वासुदेवस्य पार्थस्य च महात्मनः ।\nसंवादमिममश्रौषमद्भुतं रोमहर्षणम् ॥", iast: "ityahaṃ vāsudevasya pārthasya ca mahātmanaḥ |\nsaṃvādamimamaśrauṣamadbhutaṃ romaharṣaṇam ||", transliteration: "ity ahaṁ vāsudevasya pārthasya cha mahātmanaḥ\nsaṁvādam imam aśhrauṣham adbhutaṁ roma-harṣhaṇam", translation_en: "Sanjaya said, Thus, I have heard this wonderful dialogue between Krishna and the high-souled Arjuna, which causes one's hair to stand on end.", translation_hi: "संजय ने कहा -- इस प्रकार मैंने भगवान् वासुदेव और महात्मा अर्जुन के इस अद्भुत और रोमान्चक संवाद का वर्णन किया।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_074.mp3"},
  {id: "BG_18.75", label: "BG 18.75", ref: "18.75", chapter: 18, verse: 75, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "व्यासप्रसादाच्छ्रुतवानेतद्गुह्यमहं परम्", snippet: "Through the grace of Vyasa, I have heard this supreme and most secret Yoga, directly from Krishna, the Lord of Yoga, Himself declaring it.", sanskrit: "व्यासप्रसादाच्छ्रुतवानेतद्गुह्यमहं परम् ।\nयोगं योगेश्वरात्कृष्णात्साक्षात्कथयतः स्वयम् ॥", iast: "vyāsaprasādācchrutavānetadguhyamahaṃ param |\nyogaṃ yogeśvarātkṛṣṇātsākṣātkathayataḥ svayam ||", transliteration: "vyāsa-prasādāch chhrutavān etad guhyam ahaṁ param\nyogaṁ yogeśhvarāt kṛiṣhṇāt sākṣhāt kathayataḥ svayam", translation_en: "Through the grace of Vyasa, I have heard this supreme and most secret Yoga, directly from Krishna, the Lord of Yoga, Himself declaring it.", translation_hi: "व्यास जी की कृपा से मैंने इस परम् गुह्य योग को साक्षात् कहते हुए स्वयं योगोश्वर श्रीकृष्ण भगवान् से सुना।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_075.mp3"},
  {id: "BG_18.76", label: "BG 18.76", ref: "18.76", chapter: 18, verse: 76, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "राजन्संस्मृत्य संस्मृत्य संवादमिममद्भुतम्", snippet: "O King, remembering this wonderful and holy dialogue between Krishna and Arjuna, I continually rejoice.", sanskrit: "राजन्संस्मृत्य संस्मृत्य संवादमिममद्भुतम् ।\nकेशवार्जुनयोः पुण्यं हृष्यामि च मुहुर्मुहुः ॥", iast: "rājansaṃsmṛtya saṃsmṛtya saṃvādamimamadbhutam |\nkeśavārjunayoḥ puṇyaṃ hṛṣyāmi ca muhurmuhuḥ ||", transliteration: "rājan sansmṛitya sansmṛitya saṁvādam imam adbhutam\nkeśhavārjunayoḥ puṇyaṁ hṛiṣhyāmi cha muhur muhuḥ", translation_en: "O King, remembering this wonderful and holy dialogue between Krishna and Arjuna, I continually rejoice.", translation_hi: "हे राजन् ! भगवान् केशव और अर्जुन के इस अद्भुत और पुण्य (पवित्र) संवाद को स्मरण करके मैं बारम्बार हर्षित होता हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_076.mp3"},
  {id: "BG_18.77", label: "BG 18.77", ref: "18.77", chapter: 18, verse: 77, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "तच्च संस्मृत्य संस्मृत्य रूपमत्यद्भुतं हरेः", snippet: "And, remembering again and again that most wonderful form of Hari, I am filled with great wonder, O King; and I rejoice again and again.", sanskrit: "तच्च संस्मृत्य संस्मृत्य रूपमत्यद्भुतं हरेः ।\nविस्मयो मे महान् राजन् हृष्यामि च पुनः पुनः ॥", iast: "tacca saṃsmṛtya saṃsmṛtya rūpamatyadbhutaṃ hareḥ |\nvismayo me mahān rājan hṛṣyāmi ca punaḥ punaḥ ||", transliteration: "tach cha sansmṛitya saṁsmṛitya rūpam aty-adbhutaṁ hareḥ\nvismayo ye mahān rājan hṛiṣhyāmi cha punaḥ punaḥ", translation_en: "And, remembering again and again that most wonderful form of Hari, I am filled with great wonder, O King; and I rejoice again and again.", translation_hi: "हे राजन ! श्री हरि के अति अद्भुत रूप को भी पुन: पुन: स्मरण करके मुझे महान् विस्मय होता है और मैं बारम्बार हर्षित हो रहा हूँ।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_077.mp3"},
  {id: "BG_18.78", label: "BG 18.78", ref: "18.78", chapter: 18, verse: 78, speaker: "sanjaya", canonical: true, meter: "anustubh", sa: "यत्र योगेश्वरः कृष्णो यत्र पार्थो धनुर्धरः", snippet: "Wherever Krishna, the Lord of Yoga, is; and wherever Arjuna, the wielder of the bow, is; there is prosperity, victory, happiness, and a firm policy; this is my conviction.", sanskrit: "यत्र योगेश्वरः कृष्णो यत्र पार्थो धनुर्धरः ।\nतत्र श्रीर्विजयो भूतिर्ध्रुवा नीतिर्मतिर्मम ॥", iast: "yatra yogeśvaraḥ kṛṣṇo yatra pārtho dhanurdharaḥ |\ntatra śrīrvijayo bhūtirdhruvā nītirmatirmama ||", transliteration: "yatra yogeśhvaraḥ kṛiṣhṇo yatra pārtho dhanur-dharaḥ\ntatra śhrīr vijayo bhūtir dhruvā nītir matir mama", translation_en: "Wherever Krishna, the Lord of Yoga, is; and wherever Arjuna, the wielder of the bow, is; there is prosperity, victory, happiness, and a firm policy; this is my conviction.", translation_hi: "जहाँ योगेश्वर श्रीकृष्ण हैं और जहाँ धनुर्धारी अर्जुन है वहीं पर श्री, विजय, विभूति और ध्रुव नीति है, ऐसा मेरा मत है।।", meter_name: "Anuṣṭubh (Śloka)", audio_url: "https://www.holy-bhagavad-gita.org/media/audios/018_078.mp3"}
] AS row
MERGE (n:Verse {id: row.id}) SET n += row;

UNWIND [
  {id: "concept:dharma", label: "Dharma", sa: "धर्म", iast: "dharma", en: "Righteous Order & Duty", category: "ethics", desc: "The sustaining law of things — cosmic order, moral rightness and one's rightful duty. The Gita opens on the 'field of dharma' (1.1) and closes with the call to go beyond all formulations of it in surrender (18.66)."},
  {id: "concept:svadharma", label: "Svadharma", sa: "स्वधर्म", iast: "svadharma", en: "One's Own Dharma", category: "ethics", desc: "The duty that arises from one's own nature and station. 'Better one's own dharma, though imperfect, than the dharma of another well performed' (3.35, 18.47)."},
  {id: "concept:lokasangraha", label: "Lokasaṅgraha", sa: "लोकसंग्रह", iast: "lokasaṅgraha", en: "Welfare & Holding-Together of the World", category: "ethics", desc: "Acting for the cohesion and uplift of society. The wise act without attachment to set an example: 'whatever the great do, others follow' (3.21)."},
  {id: "concept:ahimsa", label: "Ahiṃsā", sa: "अहिंसा", iast: "ahiṃsā", en: "Non-Violence", category: "ethics", desc: "Non-injury in thought, word and deed, listed among the divine qualities (16.2) and the austerities of the body (17.14)."},
  {id: "concept:satya", label: "Satya", sa: "सत्य", iast: "satya", en: "Truthfulness", category: "ethics", desc: "Truth in speech and being; speech that is true, pleasing and beneficial is the austerity of speech (17.15)."},
  {id: "concept:daivi-sampat", label: "Daivī sampat", sa: "दैवी सम्पत्", iast: "daivī sampat", en: "Divine Endowments", category: "ethics", desc: "The twenty-six qualities that lead to liberation — fearlessness, purity, charity, self-control, compassion, humility and more (16.1–3)."},
  {id: "concept:asuri-sampat", label: "Āsurī sampat", sa: "आसुरी सम्पत्", iast: "āsurī sampat", en: "Demonic Endowments", category: "ethics", desc: "Hypocrisy, arrogance, conceit, anger, harshness and ignorance — the qualities that bind (16.4), whose inner monologue is dissected in 16.13–16."},
  {id: "concept:varna", label: "Varṇa", sa: "वर्ण", iast: "varṇa", en: "Social Order by Guṇa & Karma", category: "ethics", desc: "The fourfold order 'created according to the division of guṇa and karma' (4.13) — qualities and work, which the Gita describes in terms of inner nature (18.41–44)."},
  {id: "concept:karma", label: "Karma", sa: "कर्म", iast: "karma", en: "Action", category: "action", desc: "Action, and the moral law of action. 'Karma is the creative force that brings beings into existence' (8.3); its course is 'unfathomable' (4.17)."},
  {id: "concept:akarma", label: "Akarma", sa: "अकर्म", iast: "akarma", en: "Inaction-in-Action", category: "action", desc: "The subtle teaching that the wise 'see inaction in action and action in inaction' (4.18) — freedom is not abstention but non-doership."},
  {id: "concept:nishkama-karma", label: "Niṣkāma karma", sa: "निष्काम कर्म", iast: "niṣkāma karma", en: "Desireless Action", category: "action", desc: "Action performed as duty without craving for its fruit: 'Your right is to action alone, never to its fruits' (2.47). The heart of Karma Yoga."},
  {id: "concept:karma-yoga", label: "Karmayoga", sa: "कर्मयोग", iast: "karmayoga", en: "Yoga of Action", category: "action", desc: "Union through selfless, skilful action offered to the Divine — 'yoga is skill in action' (2.50). Krishna's answer to Arjuna's wish to escape the battlefield."},
  {id: "concept:tyaga", label: "Tyāga", sa: "त्याग", iast: "tyāga", en: "Renunciation of Fruits", category: "action", desc: "Relinquishing the fruit of action while still acting — distinguished from saṃnyāsa (giving up action) in 18.2, and declared the true renunciation (18.11)."},
  {id: "concept:sannyasa", label: "Saṃnyāsa", sa: "संन्यास", iast: "saṃnyāsa", en: "Renunciation", category: "action", desc: "Formal renunciation of action. The Gita reinterprets it inwardly: the true saṃnyāsī neither hates nor desires (5.3) and performs duty without depending on its fruit (6.1)."},
  {id: "concept:yajna", label: "Yajña", sa: "यज्ञ", iast: "yajña", en: "Sacrifice & Offering", category: "action", desc: "Action as offering. 'Work done as yajña does not bind' (3.9); Chapter 4 widens yajña to knowledge, breath, study and self-restraint, culminating in 'brahmārpaṇam' (4.24)."},
  {id: "concept:dana", label: "Dāna", sa: "दान", iast: "dāna", en: "Charity", category: "action", desc: "Giving — sattvic when given as duty, at the right place and time, to a worthy recipient, expecting nothing in return (17.20)."},
  {id: "concept:tapas", label: "Tapas", sa: "तपस्", iast: "tapas", en: "Austerity", category: "practice", desc: "Disciplined heat of effort — austerity of body, speech and mind (17.14–16), sattvic when undertaken with faith and without desire for reward."},
  {id: "concept:jnana", label: "Jñāna", sa: "ज्ञान", iast: "jñāna", en: "Liberating Knowledge", category: "knowledge", desc: "Direct, liberating knowledge of reality. 'There is no purifier in this world like knowledge' (4.38); its marks are humility, non-violence, patience and the rest (13.8–12)."},
  {id: "concept:vijnana", label: "Vijñāna", sa: "विज्ञान", iast: "vijñāna", en: "Realised Wisdom", category: "knowledge", desc: "Knowledge made experiential — jñāna together with vijñāna, 'knowing which nothing more remains to be known' (7.2, 9.1)."},
  {id: "concept:ajnana", label: "Ajñāna", sa: "अज्ञान", iast: "ajñāna", en: "Ignorance", category: "knowledge", desc: "The veil over knowledge that deludes beings (5.15). 'The ignorant, the faithless and the doubting soul perish' (4.40)."},
  {id: "concept:jnana-yoga", label: "Jñānayoga", sa: "ज्ञानयोग", iast: "jñānayoga", en: "Yoga of Knowledge", category: "knowledge", desc: "The contemplative path of discrimination between the Self and not-Self — one of the 'two paths' Krishna described of old (3.3)."},
  {id: "concept:sankhya", label: "Sāṃkhya", sa: "सांख्य", iast: "sāṃkhya", en: "Discriminative Insight", category: "knowledge", desc: "The analytical understanding of Self and matter that Krishna teaches first (2.11–30) before turning to the yoga of action (2.39)."},
  {id: "concept:sthitaprajna", label: "Sthitaprajña", sa: "स्थितप्रज्ञ", iast: "sthitaprajña", en: "One of Steady Wisdom", category: "knowledge", desc: "The person whose wisdom is established — content in the Self, unshaken by sorrow, free of craving, fear and anger. Portrayed in eighteen verses (2.55–72) answering Arjuna's question (2.54)."},
  {id: "concept:gunatita", label: "Guṇātīta", sa: "गुणातीत", iast: "guṇātīta", en: "Transcender of the Guṇas", category: "knowledge", desc: "One who has gone beyond sattva, rajas and tamas — the same in pleasure and pain, praise and blame, honour and dishonour (14.22–26)."},
  {id: "concept:kshetra", label: "Kṣetra-kṣetrajña", sa: "क्षेत्र-क्षेत्रज्ञ", iast: "kṣetra-kṣetrajña", en: "The Field & Its Knower", category: "knowledge", desc: "The body-mind is the 'field'; the conscious witness who knows it is the 'knower of the field' (13.2–3) — the analytical heart of Chapter 13."},
  {id: "concept:bhakti", label: "Bhakti", sa: "भक्ति", iast: "bhakti", en: "Devotion", category: "devotion", desc: "Loving devotion to the Divine. 'Whoever offers me with love a leaf, a flower, a fruit or water — that I accept' (9.26); the beloved devotee is described in 12.13–20."},
  {id: "concept:bhakti-yoga", label: "Bhaktiyoga", sa: "भक्तियोग", iast: "bhaktiyoga", en: "Yoga of Devotion", category: "devotion", desc: "Union through unwavering love — the theme of Chapter 12, where Krishna names those 'ever-united, endowed with supreme faith' as the most perfect in yoga (12.2)."},
  {id: "concept:ananya-bhakti", label: "Ananya bhakti", sa: "अनन्य भक्ति", iast: "ananya bhakti", en: "Undivided Devotion", category: "devotion", desc: "Devotion with no other refuge. 'To those who worship me with undivided minds, I carry what they lack and preserve what they have' (9.22)."},
  {id: "concept:sharanagati", label: "Śaraṇāgati", sa: "शरणागति", iast: "śaraṇāgati", en: "Surrender & Refuge", category: "devotion", desc: "Taking refuge in the Divine. Arjuna begins as a disciple who has 'surrendered' (2.7); Krishna's final word is 'abandoning all dharmas, take refuge in me alone' (18.66)."},
  {id: "concept:anugraha", label: "Anugraha", sa: "अनुग्रह", iast: "anugraha", en: "Divine Grace", category: "devotion", desc: "The Divine's compassionate grace that dispels darkness from within (10.11) and by which the devotee attains the eternal abode (18.56)."},
  {id: "concept:smarana", label: "Smaraṇa", sa: "स्मरण", iast: "smaraṇa", en: "Remembrance", category: "devotion", desc: "Constant remembrance, especially at life's end: 'whatever state one remembers on leaving the body, to that one goes' (8.6). 'Remember me and fight' (8.7)."},
  {id: "concept:om", label: "Oṃ", sa: "ॐ", iast: "oṃ", en: "The Sacred Syllable", category: "devotion", desc: "The one-syllabled Brahman (8.13), 'praṇava in all the Vedas' (7.8) — and the opening of 'oṃ tat sat', the threefold designation of the Absolute (17.23)."},
  {id: "concept:yoga", label: "Yoga", sa: "योग", iast: "yoga", en: "Union & Discipline", category: "practice", desc: "Defined three ways: 'evenness of mind is yoga' (2.48), 'yoga is skill in action' (2.50), and 'the severance of union with sorrow' (6.23)."},
  {id: "concept:dhyana", label: "Dhyāna", sa: "ध्यान", iast: "dhyāna", en: "Meditation", category: "practice", desc: "Meditative absorption. Chapter 6 gives the method — a clean seat, steady posture, gaze fixed, mind on the Self — 'like a lamp in a windless place' (6.19)."},
  {id: "concept:abhyasa", label: "Abhyāsa", sa: "अभ्यास", iast: "abhyāsa", en: "Persistent Practice", category: "practice", desc: "Repeated, patient effort. With vairāgya it is Krishna's answer to the restless mind: 'it is restrained by practice and dispassion' (6.35)."},
  {id: "concept:vairagya", label: "Vairāgya", sa: "वैराग्य", iast: "vairāgya", en: "Dispassion", category: "practice", desc: "Freedom from the colouring of desire — the twin of abhyāsa (6.35) and the 'firm sword of detachment' that fells the aśvattha tree of saṃsāra (15.3)."},
  {id: "concept:indriya-nigraha", label: "Indriyanigraha", sa: "इन्द्रियनिग्रह", iast: "indriyanigraha", en: "Mastery of the Senses", category: "practice", desc: "Withdrawing the senses from their objects 'as the tortoise withdraws its limbs' (2.58). The senses are powerful, but the self-controlled attain peace (2.61, 2.64)."},
  {id: "concept:yukta", label: "Yuktāhāravihāra", sa: "युक्ताहारविहार", iast: "yuktāhāravihāra", en: "Balance & Moderation", category: "practice", desc: "'Yoga is not for one who eats too much or too little, sleeps too much or too little' — moderation in food, recreation, work and rest makes yoga the destroyer of sorrow (6.16–17)."},
  {id: "concept:prana", label: "Prāṇa", sa: "प्राण", iast: "prāṇa", en: "Vital Breath", category: "practice", desc: "The life-breath offered in prāṇāyāma (4.29), balanced between the nostrils in meditation (5.27) and drawn between the brows at the moment of death (8.10)."},
  {id: "concept:samatva", label: "Samatva", sa: "समत्व", iast: "samatva", en: "Equanimity (Yoga of Evenness)", category: "practice", desc: "Sameness of mind in success and failure, pleasure and pain, friend and foe. 'Evenness of mind is called yoga' (2.48)."},
  {id: "concept:shraddha-traya", label: "Śraddhātraya", sa: "श्रद्धात्रय", iast: "śraddhātraya", en: "Threefold Faith", category: "practice", desc: "Faith shaped by one's guṇas — 'a person is made of faith; as one's faith is, so is one' (17.3). Chapter 17 classifies worship, food, sacrifice, austerity and charity by sattva, rajas and tamas."},
  {id: "concept:atman", label: "Ātman", sa: "आत्मन्", iast: "ātman", en: "The Self", category: "metaphysics", desc: "The undying Self: 'It is not born, nor does it ever die… unborn, eternal, ancient, it is not slain when the body is slain' (2.20). Weapons cannot cut it, fire cannot burn it (2.23)."},
  {id: "concept:brahman", label: "Brahman", sa: "ब्रह्मन्", iast: "brahman", en: "The Absolute", category: "metaphysics", desc: "The imperishable supreme reality (8.3) — 'beginningless, neither being nor non-being' (13.13). Offering, oblation and fire are all Brahman (4.24)."},
  {id: "concept:paramatman", label: "Paramātman", sa: "परमात्मन्", iast: "paramātman", en: "The Supreme Self", category: "metaphysics", desc: "The supreme Self seated in the body as witness, permitter, supporter and enjoyer (13.23), indwelling all beings 'in the region of the heart' (18.61)."},
  {id: "concept:purushottama", label: "Puruṣottama", sa: "पुरुषोत्तम", iast: "puruṣottama", en: "The Supreme Person", category: "metaphysics", desc: "Beyond the perishable and even the imperishable is the Supreme Person, celebrated in the world and the Veda as Puruṣottama (15.16–18)."},
  {id: "concept:ishvara", label: "Īśvara", sa: "ईश्वर", iast: "īśvara", en: "The Lord", category: "metaphysics", desc: "The Lord who dwells in the hearts of all beings, turning them as if mounted on a machine by māyā (18.61)."},
  {id: "concept:avatara", label: "Avatāra", sa: "अवतार", iast: "avatāra", en: "Divine Descent", category: "metaphysics", desc: "'Whenever dharma declines and adharma rises, I manifest myself… to protect the good, destroy evil and re-establish dharma, I come into being age after age' (4.7–8)."},
  {id: "concept:maya", label: "Māyā", sa: "माया", iast: "māyā", en: "Divine Power of Appearance", category: "metaphysics", desc: "The Lord's power composed of the guṇas, 'hard to cross'; only those who take refuge in him pass beyond it (7.14)."},
  {id: "concept:prakriti", label: "Prakṛti", sa: "प्रकृति", iast: "prakṛti", en: "Primordial Nature", category: "metaphysics", desc: "Nature, eightfold in its lower form (7.4) and the source of all transformations and guṇas (13.20). 'All actions are performed by the guṇas of prakṛti' (3.27)."},
  {id: "concept:purusha", label: "Puruṣa", sa: "पुरुष", iast: "puruṣa", en: "Conscious Spirit", category: "metaphysics", desc: "The conscious principle that, seated in prakṛti, experiences the guṇas (13.22) — beginningless, like prakṛti itself (13.20)."},
  {id: "concept:akshara", label: "Akṣara", sa: "अक्षर", iast: "akṣara", en: "The Imperishable", category: "metaphysics", desc: "That which does not decay — the supreme Brahman (8.3), the unmanifest beyond the unmanifest, 'the highest goal' (8.21)."},
  {id: "concept:adhyatma", label: "Adhyātma", sa: "अध्यात्म", iast: "adhyātma", en: "The Inner Self-Nature", category: "metaphysics", desc: "One's own essential nature — named in Krishna's reply to Arjuna's seven questions at the opening of Chapter 8 (8.3)."},
  {id: "concept:vishvarupa", label: "Viśvarūpa", sa: "विश्वरूप", iast: "viśvarūpa", en: "The Cosmic Form", category: "metaphysics", desc: "The universal form revealed to Arjuna with divine sight (11.8) — 'as if a thousand suns blazed forth at once' (11.12), and as Time the world-destroyer (11.32)."},
  {id: "concept:vibhuti", label: "Vibhūti", sa: "विभूति", iast: "vibhūti", en: "Divine Manifestations", category: "metaphysics", desc: "The glories of the Divine in the world: 'whatever is glorious, prosperous or powerful, know that to spring from a spark of my splendour' (10.41)."},
  {id: "concept:kala", label: "Kāla", sa: "काल", iast: "kāla", en: "Time", category: "metaphysics", desc: "'I am Time, the mighty destroyer of the worlds' (11.32) — and among measurers, Krishna is time itself (10.30, 10.33)."},
  {id: "concept:gunas", label: "Triguṇa", sa: "त्रिगुण", iast: "triguṇa", en: "The Three Qualities", category: "cosmology", desc: "Sattva, rajas and tamas — the three strands of nature that bind the embodied Self (14.5). 'Be free of the three guṇas, O Arjuna' (2.45)."},
  {id: "concept:sattva", label: "Sattva", sa: "सत्त्व", iast: "sattva", en: "Luminosity & Harmony", category: "cosmology", desc: "The guṇa of light, health and knowledge; it binds through attachment to happiness and knowledge (14.6)."},
  {id: "concept:rajas", label: "Rajas", sa: "रजस्", iast: "rajas", en: "Passion & Activity", category: "cosmology", desc: "The guṇa of passion, born of craving and attachment; it binds through attachment to action (14.7). Kāma and krodha are 'born of rajas' (3.37)."},
  {id: "concept:tamas", label: "Tamas", sa: "तमस्", iast: "tamas", en: "Inertia & Darkness", category: "cosmology", desc: "The guṇa of inertia born of ignorance, deluding all embodied beings; it binds through heedlessness, indolence and sleep (14.8)."},
  {id: "concept:samsara", label: "Saṃsāra", sa: "संसार", iast: "saṃsāra", en: "Cycle of Birth & Death", category: "cosmology", desc: "The ocean of death-bound existence from which Krishna 'swiftly lifts' those whose minds are fixed on him (12.7); the inverted aśvattha tree of Chapter 15."},
  {id: "concept:punarjanma", label: "Punarjanma", sa: "पुनर्जन्म", iast: "punarjanma", en: "Rebirth", category: "cosmology", desc: "'As a person casts off worn-out garments and puts on new ones, so the embodied Self casts off worn-out bodies and enters new ones' (2.22)."},
  {id: "concept:moksha", label: "Mokṣa", sa: "मोक्ष", iast: "mokṣa", en: "Liberation", category: "cosmology", desc: "Release from bondage and rebirth. 'I shall liberate you from all sins; do not grieve' (18.66)."},
  {id: "concept:nirvana", label: "Nirvāṇa", sa: "निर्वाण", iast: "nirvāṇa", en: "Extinction in the Absolute", category: "cosmology", desc: "Brahma-nirvāṇa — the peace of the Absolute attained by the one free from desire (2.72), self-delighted and illumined within (5.24–26)."},
  {id: "concept:vedas", label: "Veda", sa: "वेद", iast: "veda", en: "The Vedas & Scripture", category: "cosmology", desc: "Revealed scripture — honoured, yet relativised: for the knower of Brahman the Vedas are 'like a pond when there is a flood everywhere' (2.46). 'I am that which is to be known by all the Vedas' (15.15)."},
  {id: "concept:manas", label: "Manas", sa: "मनस्", iast: "manas", en: "The Mind", category: "psychology", desc: "The mind — 'restless, turbulent, powerful and obstinate', as hard to control as the wind (6.34), yet the Self's best friend once conquered (6.6)."},
  {id: "concept:buddhi", label: "Buddhi", sa: "बुद्धि", iast: "buddhi", en: "Discerning Intellect", category: "psychology", desc: "The faculty of discernment. A resolute buddhi is single-pointed (2.41); its sattvic form knows what is to be done and what not (18.30)."},
  {id: "concept:svabhava", label: "Svabhāva", sa: "स्वभाव", iast: "svabhāva", en: "Inherent Nature", category: "psychology", desc: "Each being's innate nature, from which its duties arise. 'Beings follow their nature — what can repression accomplish?' (3.33)."}
] AS row
MERGE (n:SanskritConcept {id: row.id}) SET n += row;

UNWIND [
  {id: "emotion:vishada", label: "Viṣāda", sa: "विषाद", iast: "viṣāda", en: "Despair", valence: "afflictive", guna: "tamas", desc: "The collapse of will that gives Chapter 1 its name — Arjuna sinks down in his chariot, bow slipping from his hand (1.47).", modern: "Depressive collapse, hopelessness, learned helplessness", lexicon: ["depressed", "depression", "hopeless", "despair", "empty", "numb", "worthless", "no point", "give up", "can't go on", "pointless", "meaningless", "broken", "low", "miserable", "down"]},
  {id: "emotion:shoka", label: "Śoka", sa: "शोक", iast: "śoka", en: "Grief & Sorrow", valence: "afflictive", guna: "tamas", desc: "Sorrow over loss. Krishna's first words: 'You grieve for those who should not be grieved for… the wise grieve neither for the living nor the dead' (2.11).", modern: "Grief, bereavement, mourning", lexicon: ["grief", "grieving", "loss", "lost my", "mourning", "bereavement", "died", "death of", "passed away", "miss him", "miss her", "miss them", "funeral", "heartbroken", "gone forever", "widow"]},
  {id: "emotion:moha", label: "Moha", sa: "मोह", iast: "moha", en: "Delusion & Confusion", valence: "afflictive", guna: "tamas", desc: "Clouded understanding about what is right. Arjuna's 'mind is confused about dharma' (2.7); his last words are 'my delusion is destroyed' (18.73).", modern: "Confusion, cognitive fog, moral confusion", lexicon: ["confused", "confusion", "don't know what to do", "unclear", "torn", "which path", "can't decide", "what is right", "mixed up", "conflicted", "foggy", "feel lost"]},
  {id: "emotion:bhaya", label: "Bhaya", sa: "भय", iast: "bhaya", en: "Fear & Anxiety", valence: "afflictive", guna: "tamas", desc: "Fear for oneself and one's world. Even Arjuna, beholding the cosmic form, confesses 'my mind is shaken with fear' (11.45).", modern: "Anxiety, panic, dread, insecurity", lexicon: ["afraid", "fear", "scared", "anxious", "anxiety", "panic", "nervous", "worried", "dread", "terrified", "insecure", "phobia", "frightened", "uneasy", "on edge"]},
  {id: "emotion:chinta", label: "Cintā", sa: "चिन्ता", iast: "cintā", en: "Worry & Outcome-Fixation", valence: "afflictive", guna: "rajas", desc: "Endless anxious calculation about results — the 'immeasurable worry, ending only at death' of those driven by desire (16.11).", modern: "Rumination, outcome anxiety, perfectionism", lexicon: ["overthinking", "worry", "worried about results", "stressed", "stress", "ruminating", "can't stop thinking", "what if", "outcome", "results", "expectations", "pressure", "perfect", "grades", "exam", "performance", "deadline", "promotion"]},
  {id: "emotion:krodha", label: "Krodha", sa: "क्रोध", iast: "krodha", en: "Anger", valence: "afflictive", guna: "rajas", desc: "Desire thwarted becomes anger; 'from anger comes delusion' (2.63). Anger is one of the three gates to self-ruin (16.21).", modern: "Anger, rage, irritability, hostility", lexicon: ["angry", "anger", "rage", "furious", "irritated", "frustrated", "resentful", "mad at", "annoyed", "snapped", "yelled", "temper", "livid", "fuming"]},
  {id: "emotion:kama", label: "Kāma", sa: "काम", iast: "kāma", en: "Craving & Compulsion", valence: "afflictive", guna: "rajas", desc: "Insatiable desire, 'the great devourer, the enemy here' (3.37) that veils wisdom like smoke veils fire (3.38).", modern: "Craving, compulsion, addiction, lust", lexicon: ["craving", "crave", "desire", "obsessed", "obsession", "lust", "addicted", "addiction", "urge", "temptation", "can't stop scrolling", "binge", "scrolling", "gambling", "porn", "compulsive", "hooked"]},
  {id: "emotion:lobha", label: "Lobha", sa: "लोभ", iast: "lobha", en: "Greed", valence: "afflictive", guna: "rajas", desc: "Grasping for more. Arjuna sees the Kauravas' 'minds overpowered by greed' (1.38); greed is the third gate of ruin (16.21).", modern: "Greed, materialism, scarcity mindset", lexicon: ["greed", "greedy", "more money", "never enough", "wealth", "rich", "possessions", "materialistic", "jealous of their money", "status", "luxury"]},
  {id: "emotion:ahamkara", label: "Ahaṅkāra", sa: "अहङ्कार", iast: "ahaṅkāra", en: "Ego & Doership", valence: "afflictive", guna: "rajas", desc: "The 'I-maker' that claims doership: 'deluded by ego, one thinks I am the doer' (3.27).", modern: "Ego-identification, pride, entitlement", lexicon: ["ego", "pride", "proud", "arrogant", "superior", "better than", "entitled", "credit", "recognition", "deserve", "humiliated", "my reputation", "respect me"]},
  {id: "emotion:dambha", label: "Dambha", sa: "दम्भ", iast: "dambha", en: "Arrogance & Pretence", valence: "afflictive", guna: "rajas", desc: "'Hypocrisy, arrogance, conceit, anger, harshness and ignorance' mark the demonic endowment (16.4).", modern: "Image management, impostorish performance, vanity", lexicon: ["fake", "pretend", "pretending", "image", "impress", "show off", "hypocrite", "mask", "facade", "social media", "likes", "looking good"]},
  {id: "emotion:dvesha", label: "Dveṣa", sa: "द्वेष", iast: "dveṣa", en: "Aversion & Hatred", valence: "afflictive", guna: "rajas", desc: "Recoil and hatred — the twin of attachment (3.34). The beloved devotee is 'without hatred for any being' (12.13).", modern: "Hatred, resentment, bitterness, grudge", lexicon: ["hate", "hatred", "can't stand", "disgust", "resent", "toxic", "enemy", "grudge", "bitter", "bitterness", "revenge", "betrayed", "unfair", "they wronged me"]},
  {id: "emotion:sanga", label: "Saṅga", sa: "सङ्ग", iast: "saṅga", en: "Attachment", valence: "afflictive", guna: "rajas", desc: "Clinging to people, things and outcomes. 'Brooding on objects, attachment is born' (2.62) — the first link of the cascade.", modern: "Attachment, dependency, clinging", lexicon: ["attached", "attachment", "clingy", "can't let go", "possessive", "need them", "holding on", "dependent", "breakup", "my ex", "obsessing over", "codependent"]},
  {id: "emotion:vishaya-dhyana", label: "Viṣaya-dhyāna", sa: "विषयध्यान", iast: "viṣaya-dhyāna", en: "Brooding on Sense-Objects", valence: "afflictive", guna: "rajas", desc: "Dwelling on objects of the senses — the seed of the 2.62 cascade: 'when a person dwells on objects, attachment to them is born'.", modern: "Rumination, fantasising, compulsive thinking", lexicon: ["keep thinking about", "fantasize", "fantasise", "can't stop imagining", "daydream", "replay", "scrolling", "fixated"]},
  {id: "emotion:sammoha", label: "Sammoha", sa: "सम्मोह", iast: "sammoha", en: "Bewilderment", valence: "afflictive", guna: "tamas", desc: "'From anger arises bewilderment' (2.63) — the clouding that follows rage.", modern: "Emotional flooding, loss of perspective", lexicon: ["lost control", "flooded", "couldn't think straight", "blinded", "saw red"]},
  {id: "emotion:smriti-vibhrama", label: "Smṛti-vibhrama", sa: "स्मृतिविभ्रम", iast: "smṛti-vibhrama", en: "Loss of Bearings", valence: "afflictive", guna: "tamas", desc: "'From bewilderment, confusion of memory' (2.63) — one forgets what one knows and who one is; restored in 18.73 ('smṛtir labdhā').", modern: "Dissociation from values, forgetting lessons", lexicon: ["forgot who i am", "lost myself", "not myself", "forgot my values"]},
  {id: "emotion:buddhi-nasha", label: "Buddhi-nāśa", sa: "बुद्धिनाश", iast: "buddhi-nāśa", en: "Collapse of Discernment", valence: "afflictive", guna: "tamas", desc: "'From confusion of memory, the loss of reason' (2.63) — the discriminating intellect itself is destroyed.", modern: "Impaired judgement, impulsive self-sabotage", lexicon: ["bad decisions", "self-sabotage", "regret what i did", "impulsive"]},
  {id: "emotion:pranasha", label: "Praṇāśa", sa: "प्रणाश", iast: "praṇāśa", en: "Self-Ruin", valence: "afflictive", guna: "tamas", desc: "'From the loss of reason, one perishes' (2.63). Desire, anger and greed are 'the threefold gate of hell, destructive of the self' (16.21).", modern: "Downward spiral, burnout of the self", lexicon: ["destroying myself", "spiral", "ruin", "ruined", "falling apart", "rock bottom"]},
  {id: "emotion:samshaya", label: "Saṃśaya", sa: "संशय", iast: "saṃśaya", en: "Doubt", valence: "afflictive", guna: "tamas", desc: "Corrosive doubt: 'for the doubting soul there is neither this world nor the next, nor happiness' (4.40).", modern: "Self-doubt, imposter feelings, indecision", lexicon: ["doubt", "unsure", "not good enough", "imposter", "impostor", "fraud", "self-doubt", "second-guess", "no confidence", "don't believe in myself", "insecure about my ability"]},
  {id: "emotion:klaibya", label: "Klaibya", sa: "क्लैब्य", iast: "klaibya", en: "Faint-heartedness", valence: "afflictive", guna: "tamas", desc: "'Yield not to unmanliness… cast off this petty weakness of heart and arise' (2.3) — Krishna's first rousing call.", modern: "Overwhelm, freeze response, avoidance", lexicon: ["weak", "overwhelmed", "can't do this", "quit", "quitting", "coward", "paralysed", "paralyzed", "frozen", "avoid", "running away", "escape", "too much"]},
  {id: "emotion:chanchalata", label: "Cāñcalya", sa: "चाञ्चल्य", iast: "cāñcalya", en: "Restless Mind", valence: "afflictive", guna: "rajas", desc: "'The mind is restless, turbulent, strong and obstinate; I think it as hard to control as the wind' (6.34).", modern: "Distractibility, racing thoughts, inattention", lexicon: ["restless", "distracted", "can't focus", "scattered", "racing thoughts", "monkey mind", "procrastinate", "procrastination", "attention", "can't concentrate", "mind wanders", "adhd"]},
  {id: "emotion:pramada", label: "Pramāda", sa: "प्रमाद", iast: "pramāda", en: "Lethargy & Negligence", valence: "afflictive", guna: "tamas", desc: "Heedlessness, indolence and sleep — the binding marks of tamas (14.8), whose happiness 'deludes the self from beginning to end' (18.39).", modern: "Burnout-fatigue, apathy, avoidance", lexicon: ["lazy", "lethargic", "unmotivated", "tired", "exhausted", "burnout", "burned out", "burnt out", "no energy", "sleep all day", "can't get up", "drained", "apathy", "fatigue"]},
  {id: "emotion:dukha", label: "Duḥkha", sa: "दुःख", iast: "duḥkha", en: "Suffering", valence: "afflictive", guna: "rajas", desc: "Pain in all its forms. Yoga is 'the severance of union with sorrow' (6.23); pleasures born of contact are 'wombs of sorrow' (5.22).", modern: "Pain, suffering, chronic distress", lexicon: ["pain", "suffering", "hurt", "agony", "misery", "chronic", "illness", "sick", "ache", "trauma"]},
  {id: "emotion:shanti", label: "Śānti", sa: "शान्ति", iast: "śānti", en: "Inner Peace", valence: "healing", guna: "sattva", desc: "Peace that comes not from fulfilling desires but from their quieting: 'as rivers enter the full ocean… that person attains peace' (2.70).", modern: "Calm, settledness, inner peace", lexicon: ["peace", "calm", "peaceful", "settled", "serene", "quiet mind"]},
  {id: "emotion:abhaya", label: "Abhaya", sa: "अभय", iast: "abhaya", en: "Fearlessness", valence: "healing", guna: "sattva", desc: "First of the divine endowments (16.1). Krishna's closing assurance 'do not grieve' (18.66) is the seal of fearlessness.", modern: "Courage, psychological safety", lexicon: ["courage", "brave", "fearless", "confident"]},
  {id: "emotion:shraddha", label: "Śraddhā", sa: "श्रद्धा", iast: "śraddhā", en: "Faith & Trust", valence: "healing", guna: "sattva", desc: "'The one with faith attains knowledge… and soon attains supreme peace' (4.39). A person is 'made of faith' (17.3).", modern: "Trust, conviction, hope", lexicon: ["faith", "trust", "believe", "hope", "god", "pray", "prayer", "spiritual"]},
  {id: "emotion:karuna", label: "Karuṇā", sa: "करुणा", iast: "karuṇā", en: "Compassion", valence: "healing", guna: "sattva", desc: "Friendliness and compassion for all beings (12.13), mercy (16.2). Distinct from Arjuna's sentimental pity (kṛpā, 1.28; 2.1), which Krishna does not endorse.", modern: "Compassion, kindness, self-compassion", lexicon: ["compassion", "kindness", "kind", "empathy", "forgive myself", "self-compassion", "care for others"]},
  {id: "emotion:santosha", label: "Santoṣa", sa: "सन्तोष", iast: "santoṣa", en: "Contentment", valence: "healing", guna: "sattva", desc: "'When one is satisfied in the Self by the Self alone' (2.55); 'content with whatever comes unbidden' (4.22); 'ever content' (12.14).", modern: "Contentment, gratitude, sufficiency", lexicon: ["content", "grateful", "gratitude", "enough", "satisfied", "thankful"]},
  {id: "emotion:prasada", label: "Prasāda", sa: "प्रसाद", iast: "prasāda", en: "Serenity & Clarity", valence: "healing", guna: "sattva", desc: "Clear tranquillity of mind: 'in serenity all sorrows come to an end, and the intellect of the serene soon becomes steady' (2.65).", modern: "Clarity, lucidity, emotional balance", lexicon: ["clarity", "clear", "lucid", "balanced", "grounded"]},
  {id: "emotion:dhriti", label: "Dhṛti", sa: "धृति", iast: "dhṛti", en: "Fortitude & Resolve", valence: "healing", guna: "sattva", desc: "Steadfastness that holds mind, breath and senses on course (18.33); the sattvic doer is 'endowed with fortitude and enthusiasm' (18.26).", modern: "Resilience, grit, perseverance", lexicon: ["resilience", "resilient", "persevere", "keep going", "determination", "grit", "discipline", "push through"]},
  {id: "emotion:sukha", label: "Sukha", sa: "सुख", iast: "sukha", en: "True Happiness", valence: "healing", guna: "sattva", desc: "Sattvic happiness is 'like poison at first but nectar in the end' (18.37); the yogi touches 'boundless bliss' (6.21, 6.28).", modern: "Wellbeing, flourishing, deep joy", lexicon: ["happy", "happiness", "joy", "bliss", "fulfilled", "flourishing"]},
  {id: "emotion:kshama", label: "Kṣamā", sa: "क्षमा", iast: "kṣamā", en: "Forgiveness & Patience", valence: "healing", guna: "sattva", desc: "Forbearance — named among Krishna's own glories (10.34), the divine endowments (16.3) and the marks of the beloved devotee ('kṣamī', 12.13).", modern: "Forgiveness, patience, forbearance", lexicon: ["forgive", "forgiveness", "patience", "patient", "let it go", "move on"]},
  {id: "emotion:maitri", label: "Maitrī", sa: "मैत्री", iast: "maitrī", en: "Friendliness", valence: "healing", guna: "sattva", desc: "Goodwill toward all: Krishna is 'the friend of all beings' (5.29); the devotee is 'friendly and compassionate' (12.13).", modern: "Warmth, connection, goodwill", lexicon: ["friend", "friendship", "connection", "belong", "community", "lonely", "alone", "isolated"]},
  {id: "emotion:utsaha", label: "Utsāha", sa: "उत्साह", iast: "utsāha", en: "Enthusiasm & Zeal", valence: "healing", guna: "sattva", desc: "Energetic zeal free of ego — the sattvic doer is 'endowed with fortitude and enthusiasm, unmoved by success or failure' (18.26).", modern: "Motivation, intrinsic drive", lexicon: ["motivated", "motivation", "enthusiasm", "energy", "drive", "passion for", "inspired"]}
] AS row
MERGE (n:Emotion {id: row.id}) SET n += row;

UNWIND [
  {id: "dilemma:duty-vs-attachment", label: "Duty vs. Personal Attachment", sa: "धर्मसङ्कट", desc: "When what is right collides with the people you love — Arjuna's own crisis on the battlefield.", keywords: ["family", "duty", "loyalty", "betray", "relatives", "parents", "obligation", "torn between", "responsibility", "love vs", "conflict of interest", "hurt someone i love"]},
  {id: "dilemma:outcome-anxiety", label: "Fear of Failure & Outcome Anxiety", sa: "फलचिन्ता", desc: "Paralysis from fixating on results — exams, careers, launches, verdicts.", keywords: ["fail", "failure", "results", "exam", "interview", "performance", "outcome", "pressure", "expectations", "success", "what if i fail", "rejection", "deadline", "test"]},
  {id: "dilemma:burnout", label: "Burnout & Exhaustion", sa: "श्रान्ति", desc: "Running on empty — overwork, depletion, the loss of meaning in effort.", keywords: ["burnout", "burned out", "exhausted", "tired", "overworked", "no energy", "drained", "can't keep up", "too much work", "overwhelmed", "fatigue", "hustle"]},
  {id: "dilemma:bereavement", label: "Loss & Bereavement", sa: "शोक", desc: "The death of someone dear — and the question of what, if anything, survives.", keywords: ["died", "death", "passed away", "lost my", "grief", "funeral", "miss", "mourning", "terminal", "cancer", "gone"]},
  {id: "dilemma:self-doubt", label: "Imposter Syndrome & Self-Doubt", sa: "आत्मसंशय", desc: "Feeling inadequate, a fraud, unworthy of one's role — the voice that says 'not me'.", keywords: ["imposter", "impostor", "not good enough", "fraud", "self-doubt", "insecure", "inadequate", "unworthy", "don't deserve", "everyone is better", "confidence", "comparing myself"]},
  {id: "dilemma:toxic-people", label: "Dealing with Toxic or Unjust People", sa: "दुर्जनसङ्ग", desc: "Living or working with those who harm, manipulate or wrong you.", keywords: ["toxic", "boss", "manipulative", "narcissist", "abusive", "bully", "unfair", "injustice", "wronged", "enemy", "betrayed", "hostile", "harassment"]},
  {id: "dilemma:restless-mind", label: "Mastering a Restless Mind", sa: "मनोनिग्रह", desc: "Distraction, racing thoughts and the struggle to focus or meditate.", keywords: ["restless", "focus", "distracted", "concentrate", "meditation", "racing thoughts", "monkey mind", "phone", "procrastinate", "attention", "can't sit still", "overthinking"]},
  {id: "dilemma:leadership-ethics", label: "Moral Ambiguity in Leadership", sa: "नेतृधर्म", desc: "Hard calls with no clean option, when others look to you for the example.", keywords: ["leader", "leadership", "manager", "team", "decision", "ethics", "integrity", "responsibility", "set an example", "ceo", "founder", "politics", "power"]},
  {id: "dilemma:life-purpose", label: "Finding Life Purpose (Svadharma)", sa: "स्वधर्मान्वेषण", desc: "What am I meant to do? The search for vocation, calling and alignment.", keywords: ["purpose", "meaning", "calling", "career", "passion", "what should i do with my life", "feel lost", "no direction", "vocation", "path", "change career", "quarter life"]},
  {id: "dilemma:anger", label: "Anger & Reactivity", sa: "क्रोधनिग्रह", desc: "Rage, irritability, saying and doing what you later regret.", keywords: ["anger", "angry", "rage", "temper", "irritable", "snapped", "shouted", "reactive", "fight", "argument", "road rage"]},
  {id: "dilemma:addiction", label: "Addiction, Cravings & Compulsive Habits", sa: "विषयासक्ति", desc: "Substances, screens, food, gambling — the pull that overrides intention.", keywords: ["addiction", "addicted", "craving", "alcohol", "drinking", "smoking", "porn", "gambling", "binge", "phone", "social media", "relapse", "sober", "habit", "compulsive"]},
  {id: "dilemma:envy-comparison", label: "Comparison, Envy & Social Status", sa: "मात्सर्य", desc: "Measuring your life against others' — and the restlessness it breeds.", keywords: ["envy", "jealous", "jealousy", "comparison", "comparing", "status", "instagram", "they have", "better life", "success of others", "peers", "fomo"]},
  {id: "dilemma:guilt", label: "Guilt, Shame & Self-Blame", sa: "पापबोध", desc: "Carrying past wrongs — and wondering whether redemption is possible.", keywords: ["guilt", "guilty", "shame", "ashamed", "regret", "mistake", "sin", "sinner", "forgive me", "i hurt", "past", "unforgivable", "blame myself"]},
  {id: "dilemma:fear-of-death", label: "Fear of Death & Mortality", sa: "मृत्युभय", desc: "Anxiety about dying, illness, ageing — one's own or a loved one's.", keywords: ["death", "dying", "mortality", "afraid to die", "illness", "diagnosis", "old age", "ageing", "aging", "end of life", "afterlife"]},
  {id: "dilemma:loneliness", label: "Loneliness & Feeling Abandoned", sa: "एकाकित्व", desc: "Isolation, abandonment, the sense that no one is with you.", keywords: ["lonely", "alone", "loneliness", "isolated", "abandoned", "no friends", "nobody cares", "left me", "single", "no one understands"]},
  {id: "dilemma:decision-paralysis", label: "Decision Paralysis & Confusion", sa: "किंकर्तव्यविमूढता", desc: "Stuck between options; afraid to choose wrong; asking others to decide.", keywords: ["decide", "decision", "choose", "choice", "stuck", "indecisive", "options", "crossroads", "which one", "should i", "can't make up my mind"]},
  {id: "dilemma:pride-after-success", label: "Pride & Ego after Success", sa: "विजयमद", desc: "When achievement inflates the sense of 'I did this' — and isolates.", keywords: ["pride", "arrogant", "ego", "success went to my head", "credit", "promotion", "fame", "recognition", "achievement", "better than others"]},
  {id: "dilemma:instant-gratification", label: "Pleasure vs. Long-term Good", sa: "श्रेय-प्रेय", desc: "Choosing what feels good now over what is good in the end.", keywords: ["instant", "pleasure", "temptation", "short term", "long term", "discipline", "procrastinate", "fun now", "regret later", "willpower"]},
  {id: "dilemma:work-life-balance", label: "Work-Life Balance", sa: "युक्तचेष्टा", desc: "Overcommitment, neglect of body and relationships, or the opposite — avoidance.", keywords: ["work life balance", "overtime", "no time", "family time", "sleep", "health", "balance", "busy", "workaholic", "rest"]},
  {id: "dilemma:criticism-praise", label: "Coping with Criticism & Praise", sa: "निन्दास्तुति", desc: "Being shaken by feedback, reviews, public opinion — or needing applause.", keywords: ["criticism", "criticized", "criticised", "feedback", "praise", "reviews", "judged", "what people think", "reputation", "insulted", "humiliated", "trolled", "approval"]},
  {id: "dilemma:faith-crisis", label: "Spiritual Doubt & Crisis of Faith", sa: "श्रद्धासङ्कट", desc: "Losing faith, wondering if the path is real, if effort counts, if anyone listens.", keywords: ["faith", "god", "does god exist", "spiritual", "religion", "pray", "prayers unanswered", "doubt god", "meaningless", "atheist", "lost faith", "spiritual path"]},
  {id: "dilemma:setbacks", label: "Starting Over after Setbacks", sa: "पुनरारम्भ", desc: "Failed attempts, relapses, broken streaks — and the courage to begin again.", keywords: ["start over", "setback", "relapse", "failed again", "second chance", "fresh start", "rebuild", "comeback", "gave up before", "try again"]}
] AS row
MERGE (n:LifeDilemma {id: row.id}) SET n += row;

UNWIND [
  {s: "CH_1", t: "CH_2"},
  {s: "CH_2", t: "CH_3"},
