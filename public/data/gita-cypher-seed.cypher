UNWIND [
  {s: "BG_1.28", t: "dilemma:duty-vs-attachment", why: "Arjuna, seeing his kin arrayed for battle, is overcome."},
  {s: "BG_1.31", t: "dilemma:duty-vs-attachment", why: "Attachment makes him see only bad omens and no good in victory."},
  {s: "BG_2.7", t: "dilemma:duty-vs-attachment", why: "He admits his mind is confused about dharma and asks to be taught."},
  {s: "BG_2.31", t: "dilemma:duty-vs-attachment", why: "Krishna: considering your own dharma, you should not waver."},
  {s: "BG_2.38", t: "dilemma:duty-vs-attachment", why: "Treat pleasure and pain, gain and loss alike — then act."},
  {s: "BG_3.35", t: "dilemma:duty-vs-attachment", why: "Better one's own dharma imperfectly done than another's done well."},
  {s: "BG_18.47", t: "dilemma:duty-vs-attachment", why: "Doing the duty born of one's nature, one incurs no fault."},
  {s: "BG_18.66", t: "dilemma:duty-vs-attachment", why: "Beyond every rule, take refuge — and do not grieve."},
  {s: "BG_2.47", t: "dilemma:outcome-anxiety", why: "Your right is to the action alone, never to its fruits."},
  {s: "BG_2.48", t: "dilemma:outcome-anxiety", why: "Act established in yoga — even-minded in success and failure."},
  {s: "BG_2.50", t: "dilemma:outcome-anxiety", why: "Yoga is skill in action; the wise leave behind both good and bad results."},
  {s: "BG_4.20", t: "dilemma:outcome-anxiety", why: "Abandoning attachment to fruits, ever content, one does nothing even while acting."},
  {s: "BG_5.12", t: "dilemma:outcome-anxiety", why: "The yogi who gives up the fruit attains lasting peace."},
  {s: "BG_18.11", t: "dilemma:outcome-anxiety", why: "One who relinquishes the fruits of action is the true renunciant."},
  {s: "BG_12.12", t: "dilemma:outcome-anxiety", why: "Renouncing the fruits of action brings peace immediately."},
  {s: "BG_6.16", t: "dilemma:burnout", why: "Yoga is not for those who eat or sleep too much or too little."},
  {s: "BG_6.17", t: "dilemma:burnout", why: "Moderation in food, recreation, work and rest makes yoga the destroyer of sorrow."},
  {s: "BG_2.40", t: "dilemma:burnout", why: "On this path no effort is wasted; even a little protects from great fear."},
  {s: "BG_3.8", t: "dilemma:burnout", why: "Do your work — action is better than inaction; even the body needs action."},
  {s: "BG_18.26", t: "dilemma:burnout", why: "The sattvic doer is steady and enthusiastic, unmoved by success or failure."},
  {s: "BG_3.30", t: "dilemma:burnout", why: "Offer all actions to me, free from hope and 'mine', the fever gone — and act."},
  {s: "BG_5.29", t: "dilemma:burnout", why: "Knowing me as the friend of all beings, one attains peace."},
  {s: "BG_2.11", t: "dilemma:bereavement", why: "The wise grieve neither for the living nor for the dead."},
  {s: "BG_2.12", t: "dilemma:bereavement", why: "Never was there a time when I, you or these kings did not exist — nor will we cease to be."},
  {s: "BG_2.13", t: "dilemma:bereavement", why: "As the embodied passes through childhood, youth and age, so it passes to another body."},
  {s: "BG_2.20", t: "dilemma:bereavement", why: "The Self is not born, nor does it die; it is not slain when the body is slain."},
  {s: "BG_2.22", t: "dilemma:bereavement", why: "As one casts off worn-out clothes, the Self casts off worn-out bodies."},
  {s: "BG_2.27", t: "dilemma:bereavement", why: "For the born, death is certain; for the dead, birth is certain — do not grieve over the inevitable."},
  {s: "BG_2.28", t: "dilemma:bereavement", why: "Beings are unmanifest in their beginning and end, manifest only in between."},
  {s: "BG_2.3", t: "dilemma:self-doubt", why: "Yield not to this weakness of heart — it does not become you. Arise!"},
  {s: "BG_6.5", t: "dilemma:self-doubt", why: "Lift yourself by your own Self; do not degrade yourself."},
  {s: "BG_6.6", t: "dilemma:self-doubt", why: "For one who has conquered the mind, the mind is the best of friends."},
  {s: "BG_4.40", t: "dilemma:self-doubt", why: "The doubting soul finds no happiness — here or hereafter."},
  {s: "BG_4.42", t: "dilemma:self-doubt", why: "Cut the doubt born of ignorance with the sword of knowledge, and arise."},
  {s: "BG_10.41", t: "dilemma:self-doubt", why: "Whatever is glorious or powerful springs from a spark of my splendour."},
  {s: "BG_18.78", t: "dilemma:self-doubt", why: "Where there is Krishna and Arjuna, there is fortune, victory and steady wisdom."},
  {s: "BG_16.4", t: "dilemma:toxic-people", why: "Hypocrisy, arrogance, anger and harshness mark the demonic nature — recognise it."},
  {s: "BG_12.13", t: "dilemma:toxic-people", why: "The beloved devotee bears no hatred toward any being."},
  {s: "BG_12.18", t: "dilemma:toxic-people", why: "Alike to friend and foe, in honour and dishonour."},
  {s: "BG_6.9", t: "dilemma:toxic-people", why: "Equal-minded toward well-wishers, enemies, the righteous and the sinful."},
  {s: "BG_5.18", t: "dilemma:toxic-people", why: "The wise see with equal vision a scholar, a cow, an elephant and a dog."},
  {s: "BG_2.31", t: "dilemma:toxic-people", why: "Yet there is nothing higher for a warrior than a righteous fight — dharma may demand a stand."},
  {s: "BG_4.8", t: "dilemma:toxic-people", why: "The Divine itself acts to protect the good and check wrongdoing."},
  {s: "BG_6.34", t: "dilemma:restless-mind", why: "The mind is restless, turbulent, powerful — as hard to hold as the wind."},
  {s: "BG_6.35", t: "dilemma:restless-mind", why: "It is restrained by practice and dispassion."},
  {s: "BG_6.26", t: "dilemma:restless-mind", why: "Whenever the wandering mind strays, bring it back under the Self's control."},
  {s: "BG_6.19", t: "dilemma:restless-mind", why: "Like a lamp in a windless place that does not flicker."},
  {s: "BG_6.5", t: "dilemma:restless-mind", why: "The mind can be one's friend or one's enemy."},
  {s: "BG_2.60", t: "dilemma:restless-mind", why: "The turbulent senses carry away even the mind of a striving wise person."},
  {s: "BG_2.67", t: "dilemma:restless-mind", why: "A mind that follows the wandering senses is carried off like a boat by the wind."},
  {s: "BG_3.21", t: "dilemma:leadership-ethics", why: "Whatever the great do, others follow; the standard they set, the world pursues."},
  {s: "BG_3.20", t: "dilemma:leadership-ethics", why: "Act with the welfare of the world in view."},
  {s: "BG_3.25", t: "dilemma:leadership-ethics", why: "As the ignorant act from attachment, the wise act unattached for the world's good."},
  {s: "BG_18.43", t: "dilemma:leadership-ethics", why: "Valour, vigour, steadiness, resourcefulness, generosity and leadership — the warrior's nature."},
  {s: "BG_2.33", t: "dilemma:leadership-ethics", why: "To abandon a righteous duty is to incur fault and lose honour."},
  {s: "BG_18.63", t: "dilemma:leadership-ethics", why: "Reflect on this fully — then do as you choose."},
  {s: "BG_4.17", t: "dilemma:leadership-ethics", why: "The nature of action, inaction and wrong action is hard to fathom."},
  {s: "BG_3.35", t: "dilemma:life-purpose", why: "Better one's own dharma, though imperfect, than another's well performed."},
  {s: "BG_18.45", t: "dilemma:life-purpose", why: "Devoted to one's own work, one attains perfection."},
  {s: "BG_18.46", t: "dilemma:life-purpose", why: "Worship the source of all beings through your own work."},
  {s: "BG_18.47", t: "dilemma:life-purpose", why: "Duty born of one's nature incurs no fault."},
  {s: "BG_18.48", t: "dilemma:life-purpose", why: "Do not abandon your natural work even if flawed — all undertakings are veiled by flaws, as fire by smoke."},
  {s: "BG_3.33", t: "dilemma:life-purpose", why: "Even the wise act according to their own nature."},
  {s: "BG_2.31", t: "dilemma:life-purpose", why: "Look to your own dharma and do not waver."},
  {s: "BG_2.62", t: "dilemma:anger", why: "Dwelling on objects breeds attachment; from attachment, desire; from desire, anger."},
  {s: "BG_2.63", t: "dilemma:anger", why: "From anger, delusion; from delusion, loss of memory; then the ruin of reason."},
  {s: "BG_3.37", t: "dilemma:anger", why: "It is desire, it is anger — born of rajas, the great enemy."},
  {s: "BG_5.23", t: "dilemma:anger", why: "One who can withstand the surge of desire and anger here, before leaving the body, is happy."},
  {s: "BG_5.26", t: "dilemma:anger", why: "For those free from desire and anger, the peace of Brahman is near."},
  {s: "BG_16.21", t: "dilemma:anger", why: "Desire, anger and greed — the threefold gate to ruin; abandon them."},
  {s: "BG_12.13", t: "dilemma:anger", why: "Free from hatred, friendly and forgiving."},
  {s: "BG_2.58", t: "dilemma:addiction", why: "Withdraw the senses from their objects as a tortoise draws in its limbs."},
  {s: "BG_2.59", t: "dilemma:addiction", why: "Objects fall away from the abstinent, but the taste remains — it too goes when the Supreme is seen."},
  {s: "BG_2.62", t: "dilemma:addiction", why: "Brooding on objects gives birth to attachment and desire."},
  {s: "BG_3.39", t: "dilemma:addiction", why: "Wisdom is veiled by this insatiable fire of desire."},
  {s: "BG_3.41", t: "dilemma:addiction", why: "Master the senses first, and slay this destroyer of knowledge."},
  {s: "BG_3.43", t: "dilemma:addiction", why: "Steady the mind by the Self and conquer this enemy so hard to subdue."},
  {s: "BG_5.22", t: "dilemma:addiction", why: "Pleasures born of contact are wombs of sorrow; the wise do not delight in them."},
  {s: "BG_6.17", t: "dilemma:addiction", why: "Balance in food and recreation dissolves sorrow."},
  {s: "BG_3.35", t: "dilemma:envy-comparison", why: "Better your own path imperfectly walked than another's perfectly."},
  {s: "BG_12.13", t: "dilemma:envy-comparison", why: "Free from 'I' and 'mine', without hatred."},
  {s: "BG_12.15", t: "dilemma:envy-comparison", why: "One who neither disturbs the world nor is disturbed by it, free from envy and fear, is dear to me."},
  {s: "BG_4.22", t: "dilemma:envy-comparison", why: "Content with what comes unbidden, beyond dualities and free from envy."},
  {s: "BG_2.57", t: "dilemma:envy-comparison", why: "Neither rejoicing in good fortune nor hating ill — such wisdom is steady."},
  {s: "BG_18.71", t: "dilemma:envy-comparison", why: "One who listens with faith and without envy is freed."},
  {s: "BG_4.36", t: "dilemma:guilt", why: "Even if you are the most sinful of sinners, you will cross all evil by the raft of knowledge."},
  {s: "BG_4.37", t: "dilemma:guilt", why: "As fire turns wood to ash, the fire of knowledge turns all karma to ash."},
  {s: "BG_9.30", t: "dilemma:guilt", why: "Even one of very bad conduct who worships with undivided devotion is to be regarded as righteous."},
  {s: "BG_9.31", t: "dilemma:guilt", why: "Soon they become righteous and attain lasting peace — my devotee never perishes."},
  {s: "BG_18.66", t: "dilemma:guilt", why: "I will release you from all sins; do not grieve."},
  {s: "BG_6.40", t: "dilemma:guilt", why: "No one who does good ever comes to a bad end."},
  {s: "BG_2.20", t: "dilemma:fear-of-death", why: "The Self is never born and never dies."},
  {s: "BG_2.22", t: "dilemma:fear-of-death", why: "Like changing worn-out garments."},
  {s: "BG_2.27", t: "dilemma:fear-of-death", why: "Death is certain for the born — so grieve not over the inevitable."},
  {s: "BG_8.5", t: "dilemma:fear-of-death", why: "Whoever leaves the body remembering me attains my being."},
  {s: "BG_8.6", t: "dilemma:fear-of-death", why: "Whatever one remembers at the end, to that one goes."},
  {s: "BG_2.13", t: "dilemma:fear-of-death", why: "Childhood, youth, old age — and another body; the steady are not deluded."},
  {s: "BG_15.7", t: "dilemma:fear-of-death", why: "An eternal fragment of me becomes the living being in the world."},
  {s: "BG_9.29", t: "dilemma:loneliness", why: "I am the same to all beings; those who worship me with love are in me and I in them."},
  {s: "BG_9.18", t: "dilemma:loneliness", why: "I am the goal, the support, the lord, the witness, the abode, the refuge, the friend."},
  {s: "BG_6.30", t: "dilemma:loneliness", why: "One who sees me everywhere and everything in me — I am never lost to them, nor they to me."},
  {s: "BG_18.61", t: "dilemma:loneliness", why: "The Lord dwells in the heart of every being."},
  {s: "BG_10.20", t: "dilemma:loneliness", why: "I am the Self seated in the hearts of all beings."},
  {s: "BG_5.29", t: "dilemma:loneliness", why: "Knowing me as the friend of all beings, one attains peace."},
  {s: "BG_9.22", t: "dilemma:loneliness", why: "To those who think of me alone, I bring what they lack and preserve what they have."},
  {s: "BG_2.7", t: "dilemma:decision-paralysis", why: "I am confused about my duty — tell me decisively what is good for me."},
  {s: "BG_3.2", t: "dilemma:decision-paralysis", why: "Your seemingly mixed words confuse me — tell me the one way."},
  {s: "BG_5.1", t: "dilemma:decision-paralysis", why: "You praise renunciation and also yoga — tell me which is better."},
  {s: "BG_2.41", t: "dilemma:decision-paralysis", why: "The resolute intellect is one-pointed; the irresolute is many-branched and endless."},
  {s: "BG_18.30", t: "dilemma:decision-paralysis", why: "Sattvic buddhi knows what to do and what to avoid, what to fear and what not."},
  {s: "BG_18.63", t: "dilemma:decision-paralysis", why: "Reflect fully, then act as you wish."},
  {s: "BG_18.73", t: "dilemma:decision-paralysis", why: "My delusion is gone; I stand firm, my doubts dispelled; I will act on your word."},
  {s: "BG_3.27", t: "dilemma:pride-after-success", why: "All actions are done by the guṇas of nature; deluded by ego, one thinks 'I am the doer'."},
  {s: "BG_5.8", t: "dilemma:pride-after-success", why: "The knower of truth thinks 'I do nothing at all'."},
  {s: "BG_13.8", t: "dilemma:pride-after-success", why: "Humility, unpretentiousness, non-violence — these are called knowledge."},
  {s: "BG_16.13", t: "dilemma:pride-after-success", why: "'This I have gained today, this desire I shall fulfil' — the deluded monologue."},
  {s: "BG_18.17", t: "dilemma:pride-after-success", why: "One free from the sense of doership, whose intellect is untainted, is not bound."},
  {s: "BG_18.58", t: "dilemma:pride-after-success", why: "Through my grace you will cross all obstacles; but out of ego, you will perish."},
  {s: "BG_18.37", t: "dilemma:instant-gratification", why: "Sattvic happiness is like poison at first, nectar in the end."},
  {s: "BG_18.38", t: "dilemma:instant-gratification", why: "Rajasic pleasure is nectar at first, poison in the end."},
  {s: "BG_18.39", t: "dilemma:instant-gratification", why: "Tamasic happiness deludes from beginning to end."},
  {s: "BG_5.22", t: "dilemma:instant-gratification", why: "Pleasures born of contact have a beginning and an end; the wise do not delight in them."},
  {s: "BG_2.14", t: "dilemma:instant-gratification", why: "Contacts of the senses come and go — endure them."},
  {s: "BG_6.5", t: "dilemma:instant-gratification", why: "Lift yourself by the Self."},
  {s: "BG_6.16", t: "dilemma:work-life-balance", why: "Neither too much nor too little — of food, sleep or effort."},
  {s: "BG_6.17", t: "dilemma:work-life-balance", why: "Regulated food, recreation, effort, sleep and waking destroy sorrow."},
  {s: "BG_3.8", t: "dilemma:work-life-balance", why: "Perform your prescribed work; even maintaining the body requires action."},
  {s: "BG_2.48", t: "dilemma:work-life-balance", why: "Perform action in yoga, abandoning attachment."},
  {s: "BG_18.48", t: "dilemma:work-life-balance", why: "Do not abandon your natural work even if imperfect."},
  {s: "BG_12.18", t: "dilemma:criticism-praise", why: "The same in honour and dishonour, heat and cold, pleasure and pain."},
  {s: "BG_12.19", t: "dilemma:criticism-praise", why: "Equal in blame and praise, silent, content with anything."},
  {s: "BG_14.24", t: "dilemma:criticism-praise", why: "The same toward the dear and the unpleasant, steady, alike in blame and self-praise."},
  {s: "BG_14.25", t: "dilemma:criticism-praise", why: "Equal in honour and dishonour, toward friend and foe."},
  {s: "BG_2.38", t: "dilemma:criticism-praise", why: "Treat pleasure and pain, gain and loss, victory and defeat alike."},
  {s: "BG_6.7", t: "dilemma:criticism-praise", why: "The self-mastered is serene in cold and heat, pleasure and pain, honour and dishonour."},
  {s: "BG_2.57", t: "dilemma:criticism-praise", why: "Without attachment anywhere, neither rejoicing nor hating."},
  {s: "BG_6.37", t: "dilemma:faith-crisis", why: "What happens to one who has faith but whose mind strays from yoga?"},
  {s: "BG_6.40", t: "dilemma:faith-crisis", why: "Neither here nor hereafter is such a one destroyed — no doer of good comes to grief."},
  {s: "BG_4.40", t: "dilemma:faith-crisis", why: "The doubting soul finds no happiness."},
  {s: "BG_7.21", t: "dilemma:faith-crisis", why: "Whatever form a devotee seeks to worship with faith, I make that faith steady."},
  {s: "BG_9.3", t: "dilemma:faith-crisis", why: "Those without faith in this dharma return to the path of death and rebirth."},
  {s: "BG_17.3", t: "dilemma:faith-crisis", why: "Faith conforms to one's nature; a person is made of faith."},
  {s: "BG_18.65", t: "dilemma:faith-crisis", why: "Fix your mind on me, be devoted to me — you will come to me; I promise, for you are dear to me."},
  {s: "BG_2.40", t: "dilemma:setbacks", why: "No effort on this path is ever lost; no obstacle prevails."},
  {s: "BG_6.40", t: "dilemma:setbacks", why: "The doer of good never comes to grief."},
  {s: "BG_6.41", t: "dilemma:setbacks", why: "The one who falls from yoga is reborn in a pure and prosperous home."},
  {s: "BG_6.43", t: "dilemma:setbacks", why: "There they regain the wisdom of their former life and strive again."},
  {s: "BG_6.45", t: "dilemma:setbacks", why: "Striving with diligence, perfected through many lives, they reach the highest goal."},
  {s: "BG_6.5", t: "dilemma:setbacks", why: "Raise yourself by yourself."},
  {s: "BG_2.3", t: "dilemma:setbacks", why: "Shake off this petty weakness of heart and arise."}
] AS row
MATCH (a:Verse {id: row.s}), (b:LifeDilemma {id: row.t})
MERGE (a)-[r:ADDRESSES_DILEMMA]->(b) SET r += row { .*, s: null, t: null };

