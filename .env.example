# ─────────────────────────────────────────────────────────────────────────────
#  GitaViswa — Agni-Kunda engine settings
#  Copy to `.env.local` (git-ignored). Every key is OPTIONAL: with no keys at all
#  the knowledge graph, Sutra Tracer, reader, audio, search and Manas-Darpan all
#  work offline. Keys only unlock LLM answers in Partha-Sarathi and on-demand
#  regional translations. Keys typed into the in-app settings modal are written
#  here automatically when the app runs locally.
# ─────────────────────────────────────────────────────────────────────────────

# Which provider Partha-Sarathi uses by default: groq | openrouter | xai | openai | ollama
LLM_PROVIDER=

# Google Gemini — https://aistudio.google.com/api-keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter — https://openrouter.ai/keys (free models end in `:free`)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# xAI Grok — https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-2-latest

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Local Ollama (free & offline) — https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Optional Neo4j target for one-click sync (or import public/data/gita-cypher-seed.cypher)
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Allow the settings API to write `.env.local` outside `next dev` (only from localhost).
GITAVISWA_ALLOW_ENV_WRITE=false

# The keys above serve only this computer (requests to localhost). On a public deployment, visitors bring their own.
# Set to true only if you deliberately want every visitor to use, and spend, the keys configured on the server.
GITAVISWA_SHARE_SERVER_KEYS=false

# Public address of the deployed site (e.g. https://gitaviswa.example). Makes link previews (og:image) absolute.
NEXT_PUBLIC_SITE_URL=
