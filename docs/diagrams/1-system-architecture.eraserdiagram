Open sources [icon: globe, color: gray] {
  Gita dataset [icon: book-open, label: "gita/gita · text, translations, commentaries"]
  Vedic scriptures [icon: book, label: "vedicscriptures · classical commentaries in English and Hindi"]
  Chapter audio [icon: headphones, label: "archive.org · chapter recitations"]
  Verse audio [icon: headphones, label: "holy-bhagavad-gita.org · per-verse chant"]
}

Build time [icon: terminal, color: orange] {
  Resilient fetch [icon: download, label: "Resilient fetch · mirrors · 16 ranged streams · cache"]
  Graph compiler [icon: cpu, label: "Graph compiler · clean · IAST · chandas · speakers · ontology"]
  Curated layers [icon: edit-3, label: "Curated layers · dialogues · causal chains · sutra threads · antidotes"]
  Integrity gate [icon: shield, label: "Integrity gate · 84 textual anchors · no dangling edges"]
  Precompute [icon: grid, label: "3D layout precompute"]
  Embeddings [icon: layers, label: "MiniLM sentence vectors (optional)"]
}

Vercel [icon: cloud, color: gray] {
  CDN [icon: globe, color: green] {
    Static data [icon: file-text, label: "verses · graph · layout · 701 commentary files"]
    App shell [icon: package, label: "Next.js app shell"]
  }
  Functions [icon: server, color: purple] {
    Chat relay [icon: message-circle, label: "/api/chat · streams the answer"]
    Graph API [icon: share-2, label: "/api/graphrag · keyless retrieval"]
    Settings API [icon: settings, label: "/api/settings · models and test"]
